# pas utilise

# file: species_general_additive_law.foc
# species: partially_ordered_additive_monoid
# property: inf_idempotent / __lemma_1_1

;       (* to be proved *)
; (Is_true ((abst_equal x (abst_inf x (abst_plus x abst_zero ) ) ))
; )
; By
;   abst_add_keeps_inf: (x: abst_T) (y: abst_T) (Is_true
;   ((abst_order_inf  x (abst_plus  x y))) )
; By def abst_order_inf:= [x: abst_T][y: abst_T](abst_equal  x (abst_inf  x y))
; (* Qed *).

$sig abst_equal ("zenon_U" "zenon_U") "bool"

$def "d" (abst_order_inf x y) (abst_equal x (abst_inf x y))

$hyp "abst_add_keeps_inf"
(A. ((x) (A. ((y)
     (Is_true (abst_order_inf x (abst_plus x y)))))))

$goal (Is_true (abst_equal x (abst_inf x (abst_plus x abst_zero))))

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     have z_Ha:"(\\A x:(\\A y:Is_true(abst_order_inf(x, abst_plus(x, y)))))" (is "\\A x : ?z_hi(x)")
     using abst_add_keeps_inf by blast
     assume z_Hb:"(~Is_true(abst_equal(x, abst_inf(x, abst_plus(x, abst_zero)))))" (is "~?z_hj")
     have z_Hc: "?z_hi(x)" (is "\\A x : ?z_ho(x)")
     by (rule zenon_all_0 [of "?z_hi" "x", OF z_Ha])
     have z_Hp: "?z_ho(abst_zero)" (is "?z_hp")
     by (rule zenon_all_0 [of "?z_ho" "abst_zero", OF z_Hc])
     have z_Hj_z_Hp: "?z_hj == ?z_hp" (is "_ == _")
     by (unfold d)
     have z_Hj: "?z_hj"
     by (unfold z_Hj_z_Hp, fact z_Hp)
     show FALSE
     by (rule notE [OF z_Hb z_Hj])
    qed
---*)
