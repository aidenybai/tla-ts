features:
  - zenon-test
outcome: unsat
---*)
;  Copyright 2006 INRIA
;  $Id: test43.znn,v 1.6 2011-12-28 16:43:33 doligez Exp $

; file: species_general_set.foc
; species: lattice
; property: order_inf_is_transitive / __goal_7

;     (* to be proved *)
; (Is_true ((abst_order_inf x z ))
; )
; By
;   abst_equal_transitive: (x: abst_T) (y: abst_T) (z: abst_T)
;   ((Is_true ((abst_equal  x y)) ))-> 
;     ((Is_true ((abst_equal  y z)) ))-> 
;       (Is_true ((abst_equal  x z)) )
;   abst_inf_is_associative: (x: abst_T) (y: abst_T) (z: abst_T) (Is_true
;   ((abst_equal  (abst_inf  (abst_inf  x y) z) (abst_inf  x (abst_inf  y z))))
;   ) __lemma_1_2: (Is_true
;   ((abst_equal (abst_inf (abst_inf x y ) z ) (abst_inf x z ) )) )
;   __lemma_1_1: (Is_true ((abst_equal x (abst_inf x (abst_inf y z ) ) )) )
; By def abst_order_inf:= [x: abst_T][y: abst_T](abst_equal  x (abst_inf  x y))
; (* Qed *).

$sig abst_T () "Type"
$sig abst_equal ("abst_T" "abst_T") "bool"
$sig abst_inf ("abst_T" "abst_T") "abst_T"

$def "d" (abst_order_inf x y) (abst_equal x (abst_inf x y))

$hyp "abst_equal_transitive"
   (A. ((x "abst_T") (A. ((y "abst_T") (A. ((z "abst_T")
     (=> (Is_true (abst_equal x y))
         (=> (Is_true (abst_equal y z))
             (Is_true (abst_equal x z))))))))))

$hyp "abst_equal_symmetric"
   (A. ((x "abst_T") (A. ((y "abst_T")
     (=> (Is_true (abst_equal x y)) (Is_true (abst_equal y x)))))))

$hyp "abst_inf_is_associative"
   (A. ((x "abst_T") (A. ((y "abst_T") (A. ((z "abst_T")
     (Is_true (abst_equal (abst_inf (abst_inf x y) z)
                          (abst_inf x (abst_inf y z))))))))))

$sig x () "abst_T"
$sig y () "abst_T"
$sig z () "abst_T"

$hyp "__lemma_1_2"
(Is_true (abst_equal (abst_inf (abst_inf x y) z) (abst_inf x z)))

$hyp "__lemma_1_1"
(Is_true (abst_equal x (abst_inf x (abst_inf y z))))

$goal
(Is_true (abst_order_inf x z))

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     have z_Hd:"Is_true(abst_equal(abst_inf(abst_inf(x, y), z), abst_inf(x, z)))" (is "?z_hd")
     using __lemma_1_2 by blast
     have z_Hb:"(\\A x:(\\A y:(Is_true(abst_equal(x, y))=>Is_true(abst_equal(y, x)))))" (is "\\A x : ?z_ht(x)")
     using abst_equal_symmetric by blast
     have z_Hc:"(\\A x:(\\A y:(\\A z:Is_true(abst_equal(abst_inf(abst_inf(x, y), z), abst_inf(x, abst_inf(y, z)))))))" (is "\\A x : ?z_hba(x)")
     using abst_inf_is_associative by blast
     have z_Ha:"(\\A x:(\\A y:(\\A z:(Is_true(abst_equal(x, y))=>(Is_true(abst_equal(y, z))=>Is_true(abst_equal(x, z)))))))" (is "\\A x : ?z_hbj(x)")
     using abst_equal_transitive by blast
     have z_He:"Is_true(abst_equal(x, abst_inf(x, abst_inf(y, z))))" (is "?z_he")
     using __lemma_1_1 by blast
     assume z_Hf:"(~Is_true(abst_order_inf(x, z)))" (is "~?z_hbl")
     have z_Hbn_z_Hf: "(~Is_true(abst_equal(x, abst_inf(x, z)))) == (~?z_hbl)" (is "?z_hbn == ?z_hf")
     by (unfold d)
     have z_Hbn: "?z_hbn" (is "~?z_hbo")
     by (unfold z_Hbn_z_Hf, fact z_Hf)
     have z_Hbb: "?z_hbj(x)" (is "\\A x : ?z_hbq(x)")
     by (rule zenon_all_0 [of "?z_hbj" "x", OF z_Ha])
     have z_Hbr: "?z_hbq(abst_inf(x, abst_inf(y, z)))" (is "\\A x : ?z_hbs(x)")
     by (rule zenon_all_0 [of "?z_hbq" "abst_inf(x, abst_inf(y, z))", OF z_Hbb])
     have z_Hbt: "?z_hbs(abst_inf(x, z))" (is "_=>?z_hbu")
     by (rule zenon_all_0 [of "?z_hbs" "abst_inf(x, z)", OF z_Hbr])
     show FALSE
     proof (rule zenon_imply [OF z_Hbt])
      assume z_Hbv:"(~?z_he)"
      show FALSE
      by (rule notE [OF z_Hbv z_He])
     next
      assume z_Hbu:"?z_hbu" (is "?z_hbw=>_")
      show FALSE
      proof (rule zenon_imply [OF z_Hbu])
       assume z_Hbx:"(~?z_hbw)"
       have z_Hby: "?z_hbj(abst_inf(x, abst_inf(y, z)))" (is "\\A x : ?z_hbz(x)")
       by (rule zenon_all_0 [of "?z_hbj" "abst_inf(x, abst_inf(y, z))", OF z_Ha])
       have z_Hca: "?z_hbz(abst_inf(abst_inf(x, y), z))" (is "\\A x : ?z_hcb(x)")
       by (rule zenon_all_0 [of "?z_hbz" "abst_inf(abst_inf(x, y), z)", OF z_Hby])
       have z_Hcc: "?z_hcb(abst_inf(x, z))" (is "?z_hcd=>?z_hce")
       by (rule zenon_all_0 [of "?z_hcb" "abst_inf(x, z)", OF z_Hca])
       show FALSE
       proof (rule zenon_imply [OF z_Hcc])
        assume z_Hcf:"(~?z_hcd)"
        have z_Hu: "?z_hba(x)" (is "\\A x : ?z_hcg(x)")
        by (rule zenon_all_0 [of "?z_hba" "x", OF z_Hc])
        have z_Hv: "?z_hcg(y)" (is "\\A x : ?z_hch(x)")
        by (rule zenon_all_0 [of "?z_hcg" "y", OF z_Hu])
        have z_Hw: "?z_hch(z)" (is "?z_hw")
        by (rule zenon_all_0 [of "?z_hch" "z", OF z_Hv])
        have z_Hci: "?z_ht(abst_inf(abst_inf(x, y), z))" (is "\\A x : ?z_hcj(x)")
        by (rule zenon_all_0 [of "?z_ht" "abst_inf(abst_inf(x, y), z)", OF z_Hb])
        have z_Hck: "?z_hcj(abst_inf(x, abst_inf(y, z)))"
        by (rule zenon_all_0 [of "?z_hcj" "abst_inf(x, abst_inf(y, z))", OF z_Hci])
        show FALSE
        proof (rule zenon_imply [OF z_Hck])
         assume z_Hcl:"(~?z_hw)"
         show FALSE
         by (rule notE [OF z_Hcl z_Hw])
        next
         assume z_Hcd:"?z_hcd"
         show FALSE
         by (rule notE [OF z_Hcf z_Hcd])
        qed
       next
        assume z_Hce:"?z_hce"
        show FALSE
        proof (rule zenon_imply [OF z_Hce])
         assume z_Hcm:"(~?z_hd)"
         show FALSE
         by (rule notE [OF z_Hcm z_Hd])
        next
         assume z_Hbw:"?z_hbw"
