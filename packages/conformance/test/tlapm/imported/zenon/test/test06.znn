         show FALSE
         proof (rule zenon_imply [OF z_Hbm])
          assume z_Hbn:"(~?z_hbf)"
          have z_Hbo: "(~?z_hbh)"
          by (rule zenon_notor_0 [OF z_Hbn])
          show FALSE
          by (rule notE [OF z_Hbo z_Hbh])
         next
          assume z_Hbk:"?z_hbk"
          show FALSE
          by (rule notE [OF z_Hbl z_Hbk])
         qed
        next
         assume z_Hbo:"(~?z_hbh)"
         show FALSE
         by (rule notE [OF z_Hbo z_Hbh])
        qed
       next
        assume z_Hbi:"?z_hbi"
        have z_Hbp: "~?z_hz((CHOOSE X:P(X)))"
        by (rule zenon_notex_0 [of "?z_hz" "(CHOOSE X:P(X))", OF z_He])
        show FALSE
        proof (rule zenon_notand [OF z_Hbp])
         assume z_Hbg:"(~?z_hbc)"
         show FALSE
         by (rule notE [OF z_Hbg z_Hbc])
        next
         assume z_Hbq:"(~?z_hbi)"
         show FALSE
         by (rule notE [OF z_Hbq z_Hbi])
        qed
       qed
      qed
     next
      assume z_Hj:"?z_hj" (is "\\E x : ?z_hbr(x)")
      have z_Hbs: "?z_hbr((CHOOSE Y:Q(Y)))" (is "?z_hbs")
      by (rule zenon_ex_choose_0 [of "?z_hbr", OF z_Hj])
      have z_Hbu: "~?z_hu((CHOOSE Y:Q(Y)))" (is "~(?z_hbv&_)")
      by (rule zenon_notex_0 [of "?z_hu" "(CHOOSE Y:Q(Y))", OF z_Ha])
      show FALSE
      proof (rule zenon_notand [OF z_Hbu])
       assume z_Hbw:"(~?z_hbv)"
       have z_Hbx: "?z_hr((CHOOSE Y:Q(Y)))" (is "?z_hby=>_")
       by (rule zenon_all_0 [of "?z_hr" "(CHOOSE Y:Q(Y))", OF z_Hd])
       show FALSE
       proof (rule zenon_imply [OF z_Hbx])
        assume z_Hbz:"(~?z_hby)" (is "~(_|?z_hca)")
        have z_Hcb: "(~?z_hbs)"
        by (rule zenon_notor_0 [OF z_Hbz])
