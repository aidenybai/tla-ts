;$hyp (A. ((A B C) (=> (/\ (= A B) (big_f C A)) (big_f C B))))

;; zenon can't prove it any more :-(
$hyp "h00" F.

$hyp "h" (E. ((Z W) (A. ((X Y)
  (<=> (big_f X Y)
       (/\ (= X Z)
           (= Y W)))))))
$goal
(E. ((W) (A. ((Y)
  (<=> (E. ((Z) (A. ((X) (<=> (big_f X Y) (= X Z))))))
       (= Y W))))))

