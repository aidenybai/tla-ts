(*---
description: Zenon's own test zenon/test/test32.znn, which Zenon must prove.
ref: zenon/test/test32.znn
features:
  - zenon-test
outcome: unsat
---*)
;  Copyright 2006 INRIA
;  $Id: test32.znn,v 1.6 2011-12-28 16:43:33 doligez Exp $

# file: species_general_set.foc
# species: lattice
# property: order_inf_is_reflexive

#    (* to be proved *)
#(x: abst_T) (Is_true ((abst_order_inf  x x))
#)
#By
#  abst_equal_reflexive: (x: abst_T) (Is_true ((abst_equal  x x)) )
#  abst_inf_idempotent: (x: abst_T) (y: abst_T)
#  ((Is_true ((abst_equal  x y)) ))-> 
#    (Is_true ((abst_equal  x (abst_inf  x y))) )
#By def abst_order_inf:= [x: abst_T][y: abst_T](abst_equal  x (abst_inf  x y))
#(* Qed *).

$sig abst_T () "Type"
$sig abst_equal ("abst_T" "abst_T") "bool"
$sig abst_inf ("abst_T" "abst_T") "abst_T"

$def "d1" (abst_order_inf x y) (abst_equal x (abst_inf x y))

$hyp "h1" (A. ((x "abst_T") (Is_true (abst_equal x x))))

$hyp "h2" (A. ((x "abst_T") (A. ((y "abst_T")
     (=> (Is_true (abst_equal x y))
         (Is_true (abst_equal x (abst_inf x y))))))))

$goal (A. ((x "abst_T") (Is_true (abst_order_inf x x))))

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     have z_Ha:"(\\A x:Is_true(abst_equal(x, x)))" (is "\\A x : ?z_hg(x)")
     using h1 by blast
     have z_Hb:"(\\A x:(\\A y:(Is_true(abst_equal(x, y))=>Is_true(abst_equal(x, abst_inf(x, y))))))" (is "\\A x : ?z_hp(x)")
     using h2 by blast
     assume z_Hc:"(~(\\A x:Is_true(abst_order_inf(x, x))))" (is "~(\\A x : ?z_ht(x))")
     have z_Hu: "(\\E x:(~Is_true(abst_order_inf(x, x))))" (is "\\E x : ?z_hw(x)")
     by (rule zenon_notallex_0 [of "?z_ht", OF z_Hc])
     have z_Hx: "?z_hw((CHOOSE x:(~Is_true(abst_order_inf(x, x)))))" (is "~?z_hz")
     by (rule zenon_ex_choose_0 [of "?z_hw", OF z_Hu])
     have z_Hba_z_Hx: "(~Is_true(abst_equal((CHOOSE x:(~Is_true(abst_order_inf(x, x)))), abst_inf((CHOOSE x:(~Is_true(abst_order_inf(x, x)))), (CHOOSE x:(~Is_true(abst_order_inf(x, x)))))))) == (~?z_hz)" (is "?z_hba == ?z_hx")
     by (unfold d1)
     have z_Hba: "?z_hba" (is "~?z_hbb")
     by (unfold z_Hba_z_Hx, fact z_Hx)
     have z_Hbe: "?z_hp((CHOOSE x:(~Is_true(abst_order_inf(x, x)))))" (is "\\A x : ?z_hbf(x)")
     by (rule zenon_all_0 [of "?z_hp" "(CHOOSE x:(~Is_true(abst_order_inf(x, x))))", OF z_Hb])
     have z_Hbg: "?z_hbf((CHOOSE x:(~Is_true(abst_order_inf(x, x)))))" (is "?z_hbh=>_")
     by (rule zenon_all_0 [of "?z_hbf" "(CHOOSE x:(~Is_true(abst_order_inf(x, x))))", OF z_Hbe])
     show FALSE
     proof (rule zenon_imply [OF z_Hbg])
      assume z_Hbi:"(~?z_hbh)"
      have z_Hbh: "?z_hg((CHOOSE x:(~Is_true(abst_order_inf(x, x)))))"
      by (rule zenon_all_0 [of "?z_hg" "(CHOOSE x:(~Is_true(abst_order_inf(x, x))))", OF z_Ha])
      show FALSE
      by (rule notE [OF z_Hbi z_Hbh])
     next
      assume z_Hbb:"?z_hbb"
      show FALSE
      by (rule notE [OF z_Hba z_Hbb])
     qed
    qed
---*)
