     have z_Hcf: "?z_hce(abst_inf((CHOOSE x:(~(\\A y:Is_true(abst_equal(abst_plus(x, y), abst_plus(abst_inf(x, y), abst_sup(x, y))))))), (CHOOSE y:(~Is_true(abst_equal(abst_plus((CHOOSE x:(~(\\A y:Is_true(abst_equal(abst_plus(x, y), abst_plus(abst_inf(x, y), abst_sup(x, y))))))), y), abst_plus(abst_inf((CHOOSE x:(~(\\A y:Is_true(abst_equal(abst_plus(x, y), abst_plus(abst_inf(x, y), abst_sup(x, y))))))), y), abst_sup((CHOOSE x:(~(\\A y:Is_true(abst_equal(abst_plus(x, y), abst_plus(abst_inf(x, y), abst_sup(x, y))))))), y))))))))" (is "\\A x : ?z_hcg(x)")
