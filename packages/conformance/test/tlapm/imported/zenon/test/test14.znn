      by (rule zenon_all_0 [of "?z_hgp" "(CHOOSE y:(~(\\A z:(reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), y)=>(reachable(y, z)=>reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), z))))))", OF z_Hgo])
      have z_Hgs: "?z_hgr((CHOOSE z:(~(?z_hgg=>(reachable((CHOOSE y:(~(\\A z:(reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), y)=>(reachable(y, z)=>reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), z)))))), z)=>reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), z))))))" (is "?z_hgt=>_")
      by (rule zenon_all_0 [of "?z_hgr" "(CHOOSE z:(~(?z_hgg=>(reachable((CHOOSE y:(~(\\A z:(reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), y)=>(reachable(y, z)=>reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), z)))))), z)=>reachable((CHOOSE x:(~(\\A y:(\\A z:(reachable(x, y)=>(reachable(y, z)=>reachable(x, z))))))), z)))))", OF z_Hgq])
      show FALSE
      proof (rule zenon_imply [OF z_Hgs])
       assume z_Hgu:"(~?z_hgt)"
       show FALSE
       proof (rule zenon_notand [OF z_Hgu])
        assume z_Hgv:"(~?z_hgg)"
        show FALSE
        by (rule notE [OF z_Hgv z_Hgg])
       next
        assume z_Hgw:"(~?z_hgl)"
        show FALSE
        by (rule notE [OF z_Hgw z_Hgl])
       qed
      next
       assume z_Hgn:"?z_hgn"
       show FALSE
       by (rule notE [OF z_Hgm z_Hgn])
      qed
     qed
    qed
---*)
