# File : SYN549+1
# Status : theorem
# Rating : 0.00
$hyp "reflexivity_of_reachable" (A. ((X) (reachable X X)))
$hyp "transitivity_of_reachable" (A. ((X) (A. ((Y) (A. ((Z) (=> (/\ (reachable X Y) (reachable Y Z)) (reachable X Z))))))))
