(*---
description: Zenon's own test zenon/test/test42.znn, which Zenon must prove.
ref: zenon/test/test42.znn
features:
  - zenon-test
outcome: unsat
---*)
;  Copyright 2006 INRIA
;  $Id: test42.znn,v 1.6 2011-12-28 16:43:33 doligez Exp $

; file: species_general_set.foc
; species: lattice
; property: order_inf_is_transitive / __lemma_1_2

;     (* to be proved *)
; (Is_true ((abst_equal (abst_inf (abst_inf x y ) z ) (abst_inf x z ) ))
; )
; By
;   abst_equal_symmetric: (x: abst_T) (y: abst_T)
;   ((Is_true ((abst_equal  x y)) ))-> 
;     (Is_true ((abst_equal  y x)) ) abst_equal_transitive: (x: abst_T)
;   (y: abst_T) (z: abst_T)
;   ((Is_true ((abst_equal  x y)) ))-> 
;     ((Is_true ((abst_equal  y z)) ))-> 
;       (Is_true ((abst_equal  x z)) )
;   abst_inf_congruence: (x: abst_T) (y: abst_T) (z: abst_T)
;   ((Is_true ((abst_equal  x y)) ))-> 
;     (and (Is_true ((abst_equal  (abst_inf  x z) (abst_inf  y z))) ) (Is_true
;     ((abst_equal  (abst_inf  z x) (abst_inf  z y))) ))
;   H1_1_1: (Is_true ((abst_order_inf x y )) )
; By def abst_order_inf:= [x: abst_T][y: abst_T](abst_equal  x (abst_inf  x y))
; (* Qed *).

$sig abst_T () "Type"
$sig abst_equal ("abst_T" "abst_T") "bool"
$sig abst_inf ("abst_T" "abst_T") "abst_T"

$def "d" (abst_order_inf x y) (abst_equal x (abst_inf x y))

$hyp "abst_equal_symmetric" (A. ((x "abst_T") (A. ((y "abst_T")
     (=> (Is_true (abst_equal x y)) (Is_true (abst_equal y x)))))))

$hyp "abst_equal_transitive"
  (A. ((x "abst_T") (A. ((y "abst_T") (A. ((z "abst_T")
     (=> (Is_true (abst_equal x y))
         (=> (Is_true (abst_equal y z))
             (Is_true (abst_equal x z))))))))))

$hyp "abst_inf_congruence"
(A. ((x "abst_T") (A. ((y "abst_T") (A. ((z "abst_T")
  (=> (Is_true (abst_equal x y))
      (/\ (Is_true (abst_equal (abst_inf x z) (abst_inf y z)))
          (Is_true (abst_equal (abst_inf z x) (abst_inf z y)))))))))))

$sig x () "abst_T"
$sig y () "abst_T"
$sig z () "abst_T"

$hyp "H1_1_1"
(Is_true (abst_order_inf x y))

$goal
(Is_true (abst_equal (abst_inf (abst_inf x y) z) (abst_inf x z)))

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     have z_Hd:"Is_true(abst_order_inf(x, y))" (is "?z_hd")
     using H1_1_1 by blast
     have z_Ha:"(\\A x:(\\A y:(Is_true(abst_equal(x, y))=>Is_true(abst_equal(y, x)))))" (is "\\A x : ?z_ho(x)")
     using abst_equal_symmetric by blast
     have z_Hc:"(\\A x:(\\A y:(\\A z:(Is_true(abst_equal(x, y))=>(Is_true(abst_equal(abst_inf(x, z), abst_inf(y, z)))&Is_true(abst_equal(abst_inf(z, x), abst_inf(z, y))))))))" (is "\\A x : ?z_hbc(x)")
     using abst_inf_congruence by blast
     assume z_He:"(~Is_true(abst_equal(abst_inf(abst_inf(x, y), z), abst_inf(x, z))))" (is "~?z_hbd")
     have z_Hbh_z_Hd: "Is_true(abst_equal(x, abst_inf(x, y))) == ?z_hd" (is "?z_hbh == _")
     by (unfold d)
     have z_Hbh: "?z_hbh"
     by (unfold z_Hbh_z_Hd, fact z_Hd)
     have z_Hbj: "?z_hbc(abst_inf(x, y))" (is "\\A x : ?z_hbk(x)")
     by (rule zenon_all_0 [of "?z_hbc" "abst_inf(x, y)", OF z_Hc])
     have z_Hbl: "?z_hbk(x)" (is "\\A x : ?z_hbm(x)")
     by (rule zenon_all_0 [of "?z_hbk" "x", OF z_Hbj])
     have z_Hbn: "?z_hbm(z)" (is "?z_hbo=>?z_hbp")
     by (rule zenon_all_0 [of "?z_hbm" "z", OF z_Hbl])
     show FALSE
     proof (rule zenon_imply [OF z_Hbn])
      assume z_Hbq:"(~?z_hbo)"
      have z_Hi: "?z_ho(x)" (is "\\A x : ?z_hbr(x)")
      by (rule zenon_all_0 [of "?z_ho" "x", OF z_Ha])
      have z_Hbs: "?z_hbr(abst_inf(x, y))"
      by (rule zenon_all_0 [of "?z_hbr" "abst_inf(x, y)", OF z_Hi])
      show FALSE
      proof (rule zenon_imply [OF z_Hbs])
       assume z_Hbt:"(~?z_hbh)"
       show FALSE
       by (rule notE [OF z_Hbt z_Hbh])
      next
       assume z_Hbo:"?z_hbo"
       show FALSE
       by (rule notE [OF z_Hbq z_Hbo])
      qed
     next
      assume z_Hbp:"?z_hbp" (is "_&?z_hbu")
      have z_Hbd: "?z_hbd"
      by (rule zenon_and_0 [OF z_Hbp])
      show FALSE
      by (rule notE [OF z_He z_Hbd])
     qed
    qed
---*)
