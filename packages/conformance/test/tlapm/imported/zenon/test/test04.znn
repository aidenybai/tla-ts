         by (rule zenon_L6_ [OF z_He z_Hl z_Hde])
        qed
       qed
      qed
     next
      assume z_Heo:"?z_heo" (is "?z_hbp<=>?z_hep")
      assume z_Hew:"(~?z_heq)" (is "~(?z_he<=>?z_hbh)")
      show FALSE
      proof (rule zenon_equiv [OF z_Heo])
       assume z_Hbo:"(~?z_hbp)" (is "~(\\E x : ?z_hbw(x))")
       assume z_Hev:"(~?z_hep)" (is "~(?z_hs<=>?z_hdd)")
       show FALSE
       proof (rule zenon_notequiv [OF z_Hev])
        assume z_Hr:"(~?z_hs)" (is "~(\\E x : ?z_hw(x))")
        assume z_Hdd:"?z_hdd"
        show FALSE
        proof (rule zenon_notequiv [OF z_Hew])
         assume z_Hd:"(~?z_he)" (is "~(\\E x : ?z_hv(x))")
         assume z_Hbh:"?z_hbh" (is "?z_hbi<=>?z_hbl")
         show FALSE
         by (rule zenon_L2_ [OF z_Hbh z_Hbo])
        next
         assume z_He:"?z_he" (is "\\E x : ?z_hv(x)")
         assume z_Hdr:"(~?z_hbh)" (is "~(?z_hbi<=>?z_hbl)")
         show FALSE
         by (rule zenon_L5_ [OF z_He z_Hr z_Hdd])
        qed
       next
        assume z_Hs:"?z_hs" (is "\\E x : ?z_hw(x)")
        assume z_Hes:"(~?z_hdd)"
        have z_Hde: "?z_hw((CHOOSE U:big_q(U)))" (is "?z_hde")
        by (rule zenon_ex_choose_0 [of "?z_hw", OF z_Hs])
        have z_Het: "(\\E W:(~big_q(W)))" (is "\\E x : ?z_heu(x)")
        by (rule zenon_notallex_0 [of "?z_hw", OF z_Hes])
        have z_Hl: "?z_heu((CHOOSE W:(~big_q(W))))" (is "~?z_hm")
        by (rule zenon_ex_choose_0 [of "?z_heu", OF z_Het])
        show FALSE
        proof (rule zenon_notequiv [OF z_Hew])
         assume z_Hd:"(~?z_he)" (is "~(\\E x : ?z_hv(x))")
         assume z_Hbh:"?z_hbh" (is "?z_hbi<=>?z_hbl")
         show FALSE
         by (rule zenon_L2_ [OF z_Hbh z_Hbo])
        next
         assume z_He:"?z_he" (is "\\E x : ?z_hv(x)")
         assume z_Hdr:"(~?z_hbh)" (is "~(?z_hbi<=>?z_hbl)")
         show FALSE
         by (rule zenon_L6_ [OF z_He z_Hl z_Hde])
        qed
       qed
      next
       assume z_Hbp:"?z_hbp" (is "\\E x : ?z_hbw(x)")
       assume z_Hep:"?z_hep" (is "?z_hs<=>?z_hdd")
       have z_Ha: "?z_hbw((CHOOSE X:(\\A Y:(big_p(X)<=>big_p(Y)))))" (is "\\A x : ?z_hdv(x)")
       by (rule zenon_ex_choose_0 [of "?z_hbw", OF z_Hbp])
       show FALSE
       proof (rule zenon_equiv [OF z_Hep])
        assume z_Hr:"(~?z_hs)" (is "~(\\E x : ?z_hw(x))")
        assume z_Hes:"(~?z_hdd)"
        have z_Het: "(\\E W:(~big_q(W)))" (is "\\E x : ?z_heu(x)")
        by (rule zenon_notallex_0 [of "?z_hw", OF z_Hes])
        have z_Hl: "?z_heu((CHOOSE W:(~big_q(W))))" (is "~?z_hm")
        by (rule zenon_ex_choose_0 [of "?z_heu", OF z_Het])
        show FALSE
        proof (rule zenon_notequiv [OF z_Hew])
         assume z_Hd:"(~?z_he)" (is "~(\\E x : ?z_hv(x))")
         assume z_Hbh:"?z_hbh" (is "?z_hbi<=>?z_hbl")
         show FALSE
         by (rule zenon_L1_ [OF z_Hd z_Hl z_Hr])
        next
         assume z_He:"?z_he" (is "\\E x : ?z_hv(x)")
         assume z_Hdr:"(~?z_hbh)" (is "~(?z_hbi<=>?z_hbl)")
         show FALSE
         by (rule zenon_L4_ [OF z_Hdr z_Ha])
        qed
       next
        assume z_Hs:"?z_hs" (is "\\E x : ?z_hw(x)")
        assume z_Hdd:"?z_hdd"
        have z_Hde: "?z_hw((CHOOSE U:big_q(U)))" (is "?z_hde")
        by (rule zenon_ex_choose_0 [of "?z_hw", OF z_Hs])
        show FALSE
        proof (rule zenon_notequiv [OF z_Hew])
         assume z_Hd:"(~?z_he)" (is "~(\\E x : ?z_hv(x))")
         assume z_Hbh:"?z_hbh" (is "?z_hbi<=>?z_hbl")
         show FALSE
         by (rule zenon_L3_ [OF z_Hd z_Hdd z_Hde])
        next
         assume z_He:"?z_he" (is "\\E x : ?z_hv(x)")
         assume z_Hdr:"(~?z_hbh)" (is "~(?z_hbi<=>?z_hbl)")
         show FALSE
         by (rule zenon_L4_ [OF z_Hdr z_Ha])
        qed
       qed
      qed
     qed
    qed
---*)
