;; obligation #1
$goal (=> (/\ (= a_CONSTANTunde_xunde_a a_CONSTANTunde_yunde_a)
(= a_CONSTANTunde_yunde_a a_CONSTANTunde_zunde_a)) (= a_CONSTANTunde_xunde_a
a_CONSTANTunde_zunde_a))

(*--- recorded
all:
  exit: 0
