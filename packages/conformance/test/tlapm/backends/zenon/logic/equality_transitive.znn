    proof (rule zenon_nnpp)
     assume z_Ha:"(~(((a_CONSTANTunde_xunde_a=a_CONSTANTunde_yunde_a)&(a_CONSTANTunde_yunde_a=a_CONSTANTunde_zunde_a))=>(a_CONSTANTunde_xunde_a=a_CONSTANTunde_zunde_a)))" (is "~(?z_hc=>?z_hi)")
     have z_Hc: "?z_hc" (is "?z_hd&?z_hg")
