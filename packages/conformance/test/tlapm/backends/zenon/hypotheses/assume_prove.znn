     have z_Hl_z_Hh: "(\\A x:((x \\in a_CONSTANTunde_Sunde_a)=>(x \\in a_CONSTANTunde_Tunde_a))) == ?z_hh" (is "?z_hl == _")
     by (unfold bAll_def)
     have z_Hl: "?z_hl" (is "\\A x : ?z_ho(x)")
