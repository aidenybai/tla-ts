;; obligation #1
$hyp "a_CONSTANTunde_xunde_a_in" (TLA.in a_CONSTANTunde_xunde_a a_CONSTANTunde_Sunde_a)
$hyp "v'7" (TLA.subseteq a_CONSTANTunde_Sunde_a
a_CONSTANTunde_Tunde_a)
$goal (TLA.in a_CONSTANTunde_xunde_a
a_CONSTANTunde_Tunde_a)

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     have z_Hb:"(a_CONSTANTunde_Sunde_a \\subseteq a_CONSTANTunde_Tunde_a)" (is "?z_hb")
