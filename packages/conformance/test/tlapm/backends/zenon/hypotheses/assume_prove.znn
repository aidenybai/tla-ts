     using a_CONSTANTunde_xunde_a_in by blast
     assume z_Hc:"(~(a_CONSTANTunde_xunde_a \\in a_CONSTANTunde_Tunde_a))" (is "~?z_hg")
     have z_Hh_z_Hb: "bAll(a_CONSTANTunde_Sunde_a, (\<lambda>x. (x \\in a_CONSTANTunde_Tunde_a))) == ?z_hb" (is "?z_hh == _")
