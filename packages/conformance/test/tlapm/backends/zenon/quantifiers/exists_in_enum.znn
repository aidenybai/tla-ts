      assume z_Hba:"((CHOOSE x:((x \\in {a_CONSTANTunde_xunde_a, a_CONSTANTunde_yunde_a})&a_CONSTANTunde_Punde_a(x)))=a_CONSTANTunde_xunde_a)" (is "?z_hw=_")
