     have z_Hv: "?z_hs((CHOOSE zenon_Vh:(~(a_CONSTANTunde_Punde_a(zenon_Vh)<=>a_CONSTANTunde_Qunde_a(zenon_Vh)))))" (is "~(?z_hx<=>?z_hy)")
