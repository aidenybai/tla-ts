;; obligation #1
$goal (=> (A. ((a_CONSTANTunde_aunde_a) (<=> (a_CONSTANTunde_Punde_a a_CONSTANTunde_aunde_a)
(a_CONSTANTunde_Qunde_a a_CONSTANTunde_aunde_a))))
(= (t. ((a_CONSTANTunde_aunde_a) (a_CONSTANTunde_Punde_a a_CONSTANTunde_aunde_a)))
(t. ((a_CONSTANTunde_aunde_a) (a_CONSTANTunde_Qunde_a a_CONSTANTunde_aunde_a)))))

