(= (TLA.fapply (TLA.except a_CONSTANTunde_funde_a a_CONSTANTunde_xunde_a a_CONSTANTunde_yunde_a) a_CONSTANTunde_xunde_a)
a_CONSTANTunde_yunde_a))

