;; obligation #1
$goal (=> (= a_CONSTANTunde_xunde_a a_CONSTANTunde_yunde_a)
(= (TLA.record "a" a_CONSTANTunde_xunde_a)
(TLA.record "a" a_CONSTANTunde_yunde_a)))

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     assume z_Ha:"(~((a_CONSTANTunde_xunde_a=a_CONSTANTunde_yunde_a)=>((''a'' :> (a_CONSTANTunde_xunde_a))=(''a'' :> (a_CONSTANTunde_yunde_a)))))" (is "~(?z_hc=>?z_hf)")
     have z_Hc: "?z_hc"
     by (rule zenon_notimply_0 [OF z_Ha])
     have z_Hj: "((''a'' :> (a_CONSTANTunde_xunde_a))~=(''a'' :> (a_CONSTANTunde_yunde_a)))" (is "?z_hg~=?z_hi")
     by (rule zenon_notimply_1 [OF z_Ha])
     sorry
    qed
---*)
