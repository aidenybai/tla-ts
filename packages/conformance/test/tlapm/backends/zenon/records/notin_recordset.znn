(*---
description: Zenon proves a record constructor is in its record set with notin_recordset.
ref: zenon/ext_tla.ml#newnodes_prop
outcome: unsat
---*)
;; obligation #1
$goal (=> (/\ (TLA.in a_CONSTANTunde_xunde_a a_CONSTANTunde_Sunde_a)
(TLA.in a_CONSTANTunde_yunde_a a_CONSTANTunde_Tunde_a))
(TLA.in (TLA.record "a" a_CONSTANTunde_xunde_a "b" a_CONSTANTunde_yunde_a)
(TLA.recordset "a" a_CONSTANTunde_Sunde_a "b" a_CONSTANTunde_Tunde_a)))

(*--- recorded
all:
  exit: 0
  transcript: |-
    unsat
    proof (rule zenon_nnpp)
     assume z_Ha:"(~(((a_CONSTANTunde_xunde_a \\in a_CONSTANTunde_Sunde_a)&(a_CONSTANTunde_yunde_a \\in a_CONSTANTunde_Tunde_a))=>((''a'' :> (a_CONSTANTunde_xunde_a) @@ ''b'' :> (a_CONSTANTunde_yunde_a)) \\in [''a'' : (a_CONSTANTunde_Sunde_a), ''b'' : (a_CONSTANTunde_Tunde_a)])))" (is "~(?z_hc=>?z_hj)")
     have z_Hc: "?z_hc" (is "?z_hd&?z_hg")
     by (rule zenon_notimply_0 [OF z_Ha])
     have z_Ho: "(~?z_hj)"
     by (rule zenon_notimply_1 [OF z_Ha])
     have z_Hd: "?z_hd"
     by (rule zenon_and_0 [OF z_Hc])
     have z_Hg: "?z_hg"
     by (rule zenon_and_1 [OF z_Hc])
     let ?z_hk = "(''a'' :> (a_CONSTANTunde_xunde_a) @@ ''b'' :> (a_CONSTANTunde_yunde_a))"
     have z_Hp: "isAFcn(?z_hk)" (is "?z_hp")
     proof (rule zenon_nnpp)
      assume z_Hq: "(~?z_hp)"
      show FALSE using z_Hq by auto
     qed
     have z_Hr: "(DOMAIN(?z_hk)={''a'', ''b''})" (is "?z_hs=?z_ht")
     proof (rule zenon_nnpp)
      assume z_Hu: "(?z_hs~=?z_ht)"
      have z_Hr: "(?z_hs=?z_ht)"
      by auto
      have z_Hv: "(?z_ht~=?z_ht)"
      by (rule subst [where P="(\<lambda>zenon_Vs. (zenon_Vs~=?z_ht))", OF z_Hr z_Hu])
      show FALSE
      by (rule zenon_noteq [OF z_Hv])
     qed
     have z_Hz: "((?z_hk[''a'']) \\in a_CONSTANTunde_Sunde_a)" (is "?z_hz")
     proof (rule zenon_nnpp)
      assume z_Hbb: "(~?z_hz)"
      have z_Hbc: "((''a'' \\in ?z_hs)&((?z_hk[''a''])=a_CONSTANTunde_xunde_a))" (is "?z_hbd&?z_hbe")
      by ((rule zenon_recfield_1)+, rule zenon_recfield_2b)
      have z_Hbe: "?z_hbe" (is "?z_hba=_")
      by (rule conjD2 [OF z_Hbc])
      have z_Hbf: "(~?z_hd)"
      by (rule subst [where P="(\<lambda>zenon_Vq. (~(zenon_Vq \\in a_CONSTANTunde_Sunde_a)))", OF z_Hbe z_Hbb])
      show FALSE
      by (rule notE [OF z_Hbf z_Hd])
     qed
     have z_Hbk: "((?z_hk[''b'']) \\in a_CONSTANTunde_Tunde_a)" (is "?z_hbk")
     proof (rule zenon_nnpp)
      assume z_Hbm: "(~?z_hbk)"
      have z_Hbn: "((''b'' \\in ?z_hs)&((?z_hk[''b''])=a_CONSTANTunde_yunde_a))" (is "?z_hbo&?z_hbp")
      by (rule zenon_recfield_2, ((rule zenon_recfield_3)+)?, rule zenon_recfield_3b, auto)
      have z_Hbp: "?z_hbp" (is "?z_hbl=_")
      by (rule conjD2 [OF z_Hbn])
      have z_Hbq: "(~?z_hg)"
      by (rule subst [where P="(\<lambda>zenon_Vm. (~(zenon_Vm \\in a_CONSTANTunde_Tunde_a)))", OF z_Hbp z_Hbm])
      show FALSE
      by (rule notE [OF z_Hbq z_Hg])
     qed
     show FALSE by (rule notE [OF z_Ho],
                    rule zenon_inrecordsetI2 [OF z_Hp z_Hr z_Hz z_Hbk ])
    qed
---*)
