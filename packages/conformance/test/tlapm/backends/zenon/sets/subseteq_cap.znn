(*---
description: >-
  Zenon proves U \subseteq S \cap T from both inclusions, but its not_subseteq_cap rule builds ~(U
  \subseteq T) for both branches where the lemma in Zenon.thy needs ~(U \subseteq S) and ~(U
  \subseteq T), so Isabelle can't check the proof. The bug is in zenon/ext_tla.ml#newnodes_prop,
  which uses e3 for both hypotheses of subseteq_cap and not_subseteq_cap.
ref: zenon/ext_tla.ml#newnodes_prop
outcome: unsat
features:
  - tlapm-bug
correct:
  all:
    exit: 0
    transcript: |-
      unsat
      proof (rule zenon_nnpp)
       assume z_Ha:"(~(((a_CONSTANTunde_Uunde_a \\subseteq a_CONSTANTunde_Sunde_a)&(a_CONSTANTunde_Uunde_a \\subseteq a_CONSTANTunde_Tunde_a))=>(a_CONSTANTunde_Uunde_a \\subseteq (a_CONSTANTunde_Sunde_a \\cap a_CONSTANTunde_Tunde_a))))" (is "~(?z_hc=>?z_hi)")
       have z_Hc: "?z_hc" (is "?z_hd&?z_hg")
       by (rule zenon_notimply_0 [OF z_Ha])
       have z_Hk: "(~?z_hi)"
       by (rule zenon_notimply_1 [OF z_Ha])
       have z_Hd: "?z_hd"
       by (rule zenon_and_0 [OF z_Hc])
       have z_Hg: "?z_hg"
       by (rule zenon_and_1 [OF z_Hc])
       show FALSE
       proof (rule zenon_not_subseteq_cap [of , OF z_Hk])
        assume z_Hl:"(~?z_hd)"
        show FALSE
        by (rule notE [OF z_Hl z_Hd])
       next
        assume z_Hm:"(~?z_hg)"
        show FALSE
        by (rule notE [OF z_Hm z_Hg])
       qed
      qed
---*)
;; obligation #1
$goal (=> (/\ (TLA.subseteq a_CONSTANTunde_Uunde_a a_CONSTANTunde_Sunde_a)
(TLA.subseteq a_CONSTANTunde_Uunde_a a_CONSTANTunde_Tunde_a))
(TLA.subseteq a_CONSTANTunde_Uunde_a (TLA.cap a_CONSTANTunde_Sunde_a
a_CONSTANTunde_Tunde_a)))

