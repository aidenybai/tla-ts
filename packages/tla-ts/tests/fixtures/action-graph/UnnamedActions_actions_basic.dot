digraph ActionGraph {
nodesep=0.35;
subgraph cluster_legend {
label = "Coverage";
node [shape=point] {
d0 [style = invis];
d1 [style = invis];
p0 [style = invis];
p0 [style = invis];
}
d0 -> d1 [label=unseen, color="green", style=dotted]
p0 -> p1 [label=seen]
}
0 [shape=box,label="Init",style = filled]
1 [shape=box,label="<Action line 6, col 17 to line 6, col 21 of module UnnamedActions>"]
2 [shape=box,label="Next"]
3 [shape=box,label="<Action line 6, col 38 to line 6, col 62 of module UnnamedActions>"]
0 -> 1[color="green",style=dotted];
0 -> 2[color="green",style=dotted];
0 -> 3[color="green",style=dotted];
1 -> 1[color="green",style=dotted];
1 -> 2[penwidth=0.17];
1 -> 3[penwidth=0.17];
2 -> 1[color="green",style=dotted];
2 -> 2[penwidth=0.29];
2 -> 3[penwidth=0.23];
3 -> 1[color="green",style=dotted];
3 -> 2[penwidth=0.25];
3 -> 3[penwidth=0.2];
}