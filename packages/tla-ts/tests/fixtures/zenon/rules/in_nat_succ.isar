(* PROOF-FOUND *)
(* BEGIN-PROOF *)
proof (rule zenon_nnpp)
 assume z_Ha:"(~(2 \\in Nat))" (is "~?z_hb")
 have z_He: "(~(1 \\in Nat))" (is "~?z_hf")
 by (rule zenon_in_nat_succ_0 [of "1", OF z_Ha])
 have z_Hh: "(~(0 \\in Nat))" (is "~?z_hi")
 by (rule zenon_in_nat_succ_0 [of "0", OF z_He])
 show FALSE
 by (rule zenon_in_nat_0 [of , OF z_Hh])
qed
(* END-PROOF *)
