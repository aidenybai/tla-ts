(* PROOF-FOUND *)
(* BEGIN-PROOF *)
proof (rule zenon_nnpp)
 have z_Ha:"P((p|q))" (is "?z_ha")
 using h by blast
 have z_Hb:"p"
 using n by blast
 assume z_Hc:"(~P(TRUE))" (is "~?z_hf")
 show FALSE
 proof (rule zenon_boolcase_or [of "(\<lambda>zenon_Vh. P(zenon_Vh))" "p" "q", OF z_Ha])
  assume z_Hk:"((p|q)=TRUE)" (is "?z_hd=?z_hg")
  assume z_Hf:"?z_hf"
  show FALSE
  by (rule notE [OF z_Hc z_Hf])
 next
  assume z_Hl:"((p|q)=FALSE)" (is "?z_hd=?z_hm")
  assume z_Hn:"P(?z_hm)" (is "?z_hn")
  have z_Ho: "(~?z_hd)"
  by (rule zenon_eq_x_false_0 [of "?z_hd", OF z_Hl])
  have z_Hp: "(~p)"
  by (rule zenon_notor_0 [OF z_Ho])
  show FALSE
  by (rule notE [OF z_Hp z_Hb])
 qed
qed
(* END-PROOF *)
