(* PROOF-FOUND *)
(* BEGIN-PROOF *)
proof (rule zenon_nnpp)
 assume z_Ha:"(~(c \\in addElt(b, addElt(c, s))))" (is "~?z_hb")
 have z_Hh: "(~(c \\in addElt(c, s)))" (is "~?z_hi")
 by (rule zenon_notin_addElt_1 [of "c" "b" "addElt(c, s)", OF z_Ha])
 have z_Hj: "(c~=c)"
 by (rule zenon_notin_addElt_0 [of "c" "c" "s", OF z_Hh])
 show FALSE
 by (rule zenon_noteq [OF z_Hj])
qed
(* END-PROOF *)
