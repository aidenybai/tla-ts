  by (rule zenon_and_1 [OF z_Hbf])
  have z_Hbk: "?z_hbk" (is "_=?z_hbm")
  by (rule zenon_and_0 [OF z_Hbj])
  have z_Hbo: "?z_hbo" (is "?z_hbp&?z_hbw")
  by (rule zenon_and_1 [OF z_Hbj])
