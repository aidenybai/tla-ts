    show FALSE
    proof (rule zenon_notand [OF z_Hdn])
     assume z_Hci:"?z_hci"
     show FALSE
     by (rule notE [OF z_Hci z_Hbg])
    next
     assume z_Hdo:"(~?z_hbj)" (is "~(_&?z_hbo)")
     show FALSE
     proof (rule zenon_notand [OF z_Hdo])
      assume z_Hck:"?z_hck"
      show FALSE
      by (rule notE [OF z_Hck z_Hbk])
     next
      assume z_Hdp:"(~?z_hbo)"
      show FALSE
      proof (rule zenon_notand [OF z_Hdp])
       assume z_Hcm:"?z_hcm"
       show FALSE
       by (rule notE [OF z_Hcm z_Hbp])
      next
       assume z_Hcn:"?z_hcn"
