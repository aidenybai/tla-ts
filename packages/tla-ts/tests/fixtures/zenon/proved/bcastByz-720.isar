(* PROOF-FOUND *)
(* BEGIN-PROOF *)
proof (rule zenon_nnpp)
 assume z_Hk:"(~((((a_VARIABLEunde_pcunde_a[a_CONSTANTunde_iunde_a]) \\in {''V0'', ''V1''})&(((a_CONSTANTunde_Nunde_a +  -.((2 * a_CONSTANTunde_Tunde_a))) <= a_CONSTANTunde_Cardinalityunde_a((a_VARIABLEunde_rcvdunde_hash_primea[a_CONSTANTunde_iunde_a])))&((a_CONSTANTunde_Cardinalityunde_a((a_VARIABLEunde_rcvdunde_hash_primea[a_CONSTANTunde_iunde_a])) < (a_CONSTANTunde_Nunde_a +  -.(a_CONSTANTunde_Tunde_a)))&((a_VARIABLEunde_pcunde_hash_primea=except(a_VARIABLEunde_pcunde_a, a_CONSTANTunde_iunde_a, ''SE''))&((a_VARIABLEunde_sentunde_hash_primea=(a_VARIABLEunde_sentunde_a \\cup {<<a_CONSTANTunde_iunde_a, ''ECHO''>>}))&((a_VARIABLEunde_Corrunde_hash_primea=a_VARIABLEunde_Corrunde_a)&(a_VARIABLEunde_Faultyunde_hash_primea=a_VARIABLEunde_Faultyunde_a)))))))~=((~((a_VARIABLEunde_pcunde_a[a_CONSTANTunde_iunde_a]) \\in {''V0'', ''V1''}))|((~((a_CONSTANTunde_Nunde_a +  -.((2 * a_CONSTANTunde_Tunde_a))) <= a_CONSTANTunde_Cardinalityunde_a((a_VARIABLEunde_rcvdunde_hash_primea[a_CONSTANTunde_iunde_a]))))|((~(a_CONSTANTunde_Cardinalityunde_a((a_VARIABLEunde_rcvdunde_hash_primea[a_CONSTANTunde_iunde_a])) < (a_CONSTANTunde_Nunde_a +  -.(a_CONSTANTunde_Tunde_a))))|((a_VARIABLEunde_pcunde_hash_primea~=except(a_VARIABLEunde_pcunde_a, a_CONSTANTunde_iunde_a, ''SE''))|((a_VARIABLEunde_sentunde_hash_primea~=(a_VARIABLEunde_sentunde_a \\cup {<<a_CONSTANTunde_iunde_a, ''ECHO''>>}))|(~((a_VARIABLEunde_Corrunde_hash_primea=a_VARIABLEunde_Corrunde_a)&(a_VARIABLEunde_Faultyunde_hash_primea=a_VARIABLEunde_Faultyunde_a))))))))))" (is "~~?z_hco")
 have z_Hco: "?z_hco" (is "?z_hm=?z_hcd")
 by (rule zenon_notnot_0 [OF z_Hk])
 show FALSE
 proof (rule zenon_boolcase_and [of "(\<lambda>zenon_Vt. (zenon_Vt=?z_hcd))" "((a_VARIABLEunde_pcunde_a[a_CONSTANTunde_iunde_a]) \\in {''V0'', ''V1''})" "(((a_CONSTANTunde_Nunde_a +  -.((2 * a_CONSTANTunde_Tunde_a))) <= a_CONSTANTunde_Cardinalityunde_a((a_VARIABLEunde_rcvdunde_hash_primea[a_CONSTANTunde_iunde_a])))&((a_CONSTANTunde_Cardinalityunde_a((a_VARIABLEunde_rcvdunde_hash_primea[a_CONSTANTunde_iunde_a])) < (a_CONSTANTunde_Nunde_a +  -.(a_CONSTANTunde_Tunde_a)))&((a_VARIABLEunde_pcunde_hash_primea=except(a_VARIABLEunde_pcunde_a, a_CONSTANTunde_iunde_a, ''SE''))&((a_VARIABLEunde_sentunde_hash_primea=(a_VARIABLEunde_sentunde_a \\cup {<<a_CONSTANTunde_iunde_a, ''ECHO''>>}))&((a_VARIABLEunde_Corrunde_hash_primea=a_VARIABLEunde_Corrunde_a)&(a_VARIABLEunde_Faultyunde_hash_primea=a_VARIABLEunde_Faultyunde_a))))))", OF z_Hco])
  assume z_Hcs:"(?z_hm=TRUE)" (is "_=?z_hct")
  assume z_Hcu:"(?z_hct=?z_hcd)"
  have z_Hm: "?z_hm" (is "?z_hn&?z_hu")
  by (rule zenon_eq_x_true_0 [of "?z_hm", OF z_Hcs])
  have z_Hn: "?z_hn"
  by (rule zenon_and_0 [OF z_Hm])
  have z_Hu: "?z_hu" (is "?z_hv&?z_hbf")
  by (rule zenon_and_1 [OF z_Hm])
  have z_Hv: "?z_hv"
  by (rule zenon_and_0 [OF z_Hu])
  have z_Hbf: "?z_hbf" (is "?z_hbg&?z_hbj")
  by (rule zenon_and_1 [OF z_Hu])
