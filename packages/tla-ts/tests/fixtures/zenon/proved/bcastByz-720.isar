        by (rule notE [OF z_Hcv z_Hbx])
       next
        assume z_Hcw:"(a_VARIABLEunde_Faultyunde_hash_primea~=a_VARIABLEunde_Faultyunde_a)"
        show FALSE
        by (rule notE [OF z_Hcw z_Hca])
       qed
      qed
     qed
    qed
   qed
  qed
 next
  assume z_Hcx:"(?z_hm=FALSE)" (is "_=?z_hcy")
  assume z_Hcz:"(?z_hcy=?z_hcd)"
  have z_Hda: "(~?z_hm)" (is "~(?z_hn&?z_hu)")
  by (rule zenon_eq_x_false_0 [of "?z_hm", OF z_Hcx])
  have z_Hdb: "(~?z_hcd)" (is "~(?z_hce|?z_hcf)")
  by (rule zenon_eq_false_x_0 [of "?z_hcd", OF z_Hcz])
  have z_Hdc: "(~?z_hce)"
  by (rule zenon_notor_0 [OF z_Hdb])
  have z_Hdd: "(~?z_hcf)" (is "~(?z_hcg|?z_hch)")
  by (rule zenon_notor_1 [OF z_Hdb])
  have z_Hde: "(~?z_hcg)" (is "~~?z_hv")
  by (rule zenon_notor_0 [OF z_Hdd])
  have z_Hdf: "(~?z_hch)" (is "~(?z_hci|?z_hcj)")
  by (rule zenon_notor_1 [OF z_Hdd])
  have z_Hdg: "(~?z_hci)" (is "~~?z_hbg")
  by (rule zenon_notor_0 [OF z_Hdf])
  have z_Hdh: "(~?z_hcj)" (is "~(?z_hck|?z_hcl)")
  by (rule zenon_notor_1 [OF z_Hdf])
  have z_Hdi: "(~?z_hck)" (is "~~?z_hbk")
  by (rule zenon_notor_0 [OF z_Hdh])
  have z_Hdj: "(~?z_hcl)" (is "~(?z_hcm|?z_hcn)")
  by (rule zenon_notor_1 [OF z_Hdh])
  have z_Hdk: "(~?z_hcm)" (is "~~?z_hbp")
  by (rule zenon_notor_0 [OF z_Hdj])
  have z_Hdl: "(~?z_hcn)" (is "~~?z_hbw")
  by (rule zenon_notor_1 [OF z_Hdj])
  have z_Hbw: "?z_hbw" (is "?z_hbx&?z_hca")
  by (rule zenon_notnot_0 [OF z_Hdl])
  have z_Hbx: "?z_hbx"
  by (rule zenon_and_0 [OF z_Hbw])
  have z_Hca: "?z_hca"
  by (rule zenon_and_1 [OF z_Hbw])
  have z_Hbp: "?z_hbp" (is "_=?z_hbr")
  by (rule zenon_notnot_0 [OF z_Hdk])
  have z_Hbk: "?z_hbk" (is "_=?z_hbm")
  by (rule zenon_notnot_0 [OF z_Hdi])
  have z_Hbg: "?z_hbg"
  by (rule zenon_notnot_0 [OF z_Hdg])
  have z_Hv: "?z_hv"
  by (rule zenon_notnot_0 [OF z_Hde])
  have z_Hn: "?z_hn"
