  have z_Hbx: "?z_hbx"
  by (rule zenon_and_0 [OF z_Hbw])
  have z_Hca: "?z_hca"
  by (rule zenon_and_1 [OF z_Hbw])
  have z_Hcd: "?z_hcd" (is "?z_hce|?z_hcf")
  by (rule zenon_eq_true_x_0 [of "?z_hcd", OF z_Hcu])
  show FALSE
  proof (rule zenon_or [OF z_Hcd])
   assume z_Hce:"?z_hce"
   show FALSE
   by (rule notE [OF z_Hce z_Hn])
  next
   assume z_Hcf:"?z_hcf" (is "?z_hcg|?z_hch")
