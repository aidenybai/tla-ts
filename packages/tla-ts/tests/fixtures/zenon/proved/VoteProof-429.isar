           by (rule subst [where P="(\<lambda>zenon_Vug. (?z_hdd=zenon_Vug))", OF z_Hcu], fact z_Hdz)
           thus "(?z_hdd=?z_hbo)" .
          qed
         qed
         have z_Hfd: "(?z_hbo=?z_hdd)"
         by (rule subst [where P="(\<lambda>zenon_Vcq. (zenon_Vcq=?z_hdd))", OF z_Hfg], fact z_Hff)
         thus "(?z_hbo=?z_hdd)" .
        qed
       next
        assume z_Hfo:"(?z_hdd~=?z_hdd)"
        show FALSE
        by (rule zenon_noteq [OF z_Hfo])
       qed
      qed
      have z_Hdk: "?z_hdk"
      by (rule subst [where P="(\<lambda>zenon_Vfa. (zenon_Vfa \\in a_h813b6a))", OF z_Hfd], fact z_Hbv)
      thus "?z_hdk" .
     qed
    next
     assume z_Hfp:"((CHOOSE zenon_Vna:(~((zenon_Vna \\in a_h813b6a)<=>(zenon_Vna \\in ?z_hdj)))) \\in {})" (is "?z_hfp")
     show FALSE
     by (rule zenon_in_emptyset [of "(CHOOSE zenon_Vna:(~((zenon_Vna \\in a_h813b6a)<=>(zenon_Vna \\in ?z_hdj))))", OF z_Hfp])
    qed
   next
    assume z_Hdk:"?z_hdk"
    assume z_Hdb:"(~?z_hdc)"
    show FALSE
    by (rule zenon_L6_ [OF z_Hdb z_Hdk z_Hj z_Hby z_Hbv z_Hdl])
   qed
  qed
 qed
qed
(* END-PROOF *)
