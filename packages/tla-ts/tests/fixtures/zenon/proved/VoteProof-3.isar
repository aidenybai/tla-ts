   have z_Hev: "(TRUE=?z_hem)" (is "?z_hew=_")
   by (rule zenon_trueistrue_0 [of "(\<lambda>zenon_Vhd. (zenon_Vhd=?z_hem))" "?z_hel", OF z_Her z_Hel])
   have z_Hem: "?z_hem"
   by (rule zenon_eq_true_x_0 [of "?z_hem", OF z_Hev])
   show FALSE
   by (rule notE [OF z_Heu z_Hem])
  qed
 qed
qed
(* END-PROOF *)
