TimeLimits == <<23, 59, 59, 999, 999, 999>>
TemporalClasses ==
  {"temporalDate", "temporalDateTime", "temporalMonthDay", "temporalTime", "temporalYearMonth", "temporalZonedDateTime"}
DurationFieldKeys ==
  <<SV("years"), SV("months"), SV("weeks"), SV("days"), SV("hours"), SV("minutes"), SV("seconds"),
    SV("milliseconds"), SV("microseconds"), SV("nanoseconds")>>
ZeroDurationFields == [i \in 1..10 |-> TI(0)]
TwoPow32 == BigIntOf(FALSE, BNPow2(32))
ZeroDateDuration == <<TI(0), TI(0), TI(0), TI(0)>>
DurationFieldOrder == <<4, 5, 9, 8, 6, 2, 10, 7, 3, 1>>
DurationDesignators == <<89, 77, 87, 68, 72, 77>>
TimeFieldKeys ==
  <<SV("hour"), SV("minute"), SV("second"), SV("millisecond"), SV("microsecond"), SV("nanosecond")>>
NoRelativeTo == [plain |-> Empty, zoned |-> Empty]

\* ECMAScript language values (§6.1). A JS string is a sequence of UTF-16 code units, a Number is
\* the record that ESNumber defines, and an object or symbol is an index into the state.
Bool(b) == IF b THEN True ELSE False
Str(units) == [type |-> "string", value |-> units]
Num(n) == [type |-> "number", value |-> n]
IntV(n) == Num(NumFromInt(n))
BigInt(b) == [type |-> "bigint", value |-> b]
Obj(id) == [type |-> "object", id |-> id]
Sym(id) == [type |-> "symbol", id |-> id]
IsObject(v) == v.type = "object"
IsString(v) == v.type = "string"
IsNumber(v) == v.type = "number"
IsSymbol(v) == v.type = "symbol"
IsBigInt(v) == v.type = "bigint"
IsBoolean(v) == v.type = "boolean"
IsNullish(v) == v.type \in {"undefined", "null"}
IsPropertyKey(v) == v.type \in {"string", "symbol"}
SV(text) == Str(N(text))
\* Completion records (§6.2.4) and the result of an operation that changes the state: the new
\* state s and the completion c.
Completion(type, value, target) == [type |-> type, value |-> value, target |-> target]
NormalCompletion(v) == Completion("normal", v, Empty)
ThrowCompletion(v) == Completion("throw", v, Empty)
Ok(s, v) == [s |-> s, c |-> NormalCompletion(v)]
Abrupt(s, c) == [s |-> s, c |-> c]
ThrowValue(s, v) == [s |-> s, c |-> ThrowCompletion(v)]
IsAbrupt(r) == r.c.type # "normal"
Val(r) == r.c.value
UpdateEmpty(c, v) ==
  IF c.value # Empty THEN c ELSE [c EXCEPT !.value = v]
\* A generator or async function suspends at a yield or await with a completion of type
\* "suspend": its value is the value yielded or awaited, its target is "yield" or "await", and
\* frames is the rest of the body's evaluation, innermost first. Each evaluation step whose name
\* ends in Then takes the result of the evaluation it waits on as its last parameter. The build
\* makes every such step pass a suspension on with a frame of its other parameters, and
\* generates ResumeFrame, which runs a frame's step on the result the body resumes with.
Suspend(s, target, v) == [s |-> s, c |-> [type |-> "suspend", value |-> v, target |-> target, frames |-> <<>>]]
IsSuspended(r) == r.c.type = "suspend"
Pass(r, step, args) == [r EXCEPT !.c.frames = Append(@, [step |-> step, args |-> args])]
\* Resumes a suspended evaluation from its frames with the completion r of the yield or await.
ResumeFrames(frames, r) ==
  IF frames = <<>> \/ IsSuspended(r) THEN
    IF IsSuspended(r) THEN [r EXCEPT !.c.frames = @ \o frames] ELSE r
  ELSE ResumeFrames(Tail(frames), ResumeFrame(Head(frames), r))
\* Well-known symbols (§6.1.5.1), which the realm allocates first.
\* Sequence helpers.
Range(seq) == {seq[i] : i \in DOMAIN seq}
Last(seq) == seq[Len(seq)]
IndexOf(seq, x) ==
  LET found == {i \in DOMAIN seq : seq[i] = x}
  IN IF found = {} THEN 0 ELSE CHOOSE i \in found : \A j \in found : i <= j
Remove(seq, x) == SelectSeq(seq, LAMBDA y : y # x)
Concat(seqs) == FoldLeftSeq(seqs)
FoldLeftSeq(seqs) == IF seqs = <<>> THEN <<>> ELSE Head(seqs) \o FoldLeftSeq(Tail(seqs))
Repeat(x, n) == [i \in 1..n |-> x]
\* A heap of records, indexed from 1, in pages of HeapPageSize. Changing a record copies its page and
\* the list of pages, about n / HeapPageSize + HeapPageSize entries, rather than all n.
HeapGet(h, i) == h.pages[(i - 1) \div HeapPageSize + 1][((i - 1) % HeapPageSize) + 1]
HeapSet(h, i, x) == [h EXCEPT !.pages[(i - 1) \div HeapPageSize + 1][((i - 1) % HeapPageSize) + 1] = x]
HeapAppend(h, x) ==
  [size |-> h.size + 1,
   pages |-> IF h.size % HeapPageSize = 0 THEN Append(h.pages, <<x>>) ELSE [h.pages EXCEPT ![Len(h.pages)] = Append(@, x)]]
\* h with only its first n records.
HeapTruncate(h, n) ==
  LET count == (n + HeapPageSize - 1) \div HeapPageSize
      pages == SubSeq(h.pages, 1, count)
  IN [size |-> n, pages |-> IF n % HeapPageSize = 0 THEN pages ELSE [pages EXCEPT ![count] = SubSeq(@, 1, n % HeapPageSize)]]
\* h with the records of seq from index i on appended.
HeapAppendFrom(h, seq, i) == IF i > Len(seq) THEN h ELSE HeapAppendFrom(HeapAppend(h, seq[i]), seq, i + 1)
HeapOf(seq) == HeapAppendFrom([size |-> 0, pages |-> <<>>], seq, 1)
\* BigInts (§6.1.6.2) as [neg, mag] with mag a BigNat. Zero is never negative, so = is
\* equality.
BigIntOf(neg, mag) == [neg |-> neg /\ mag # <<>>, mag |-> mag]
BigIntFromInt(n) == BigIntOf(n < 0, BNFromInt(IF n < 0 THEN -n ELSE n))
BigIntIsZero(a) == a.mag = <<>>
BigIntEqual(a, b) == a = b
BigIntNeg(a) == BigIntOf(~a.neg, a.mag)
BigIntAdd(a, b) ==
  IF a.neg = b.neg THEN BigIntOf(a.neg, BNAdd(a.mag, b.mag))
  ELSE IF BNCompare(a.mag, b.mag) >= 0 THEN BigIntOf(a.neg, BNSub(a.mag, b.mag))
  ELSE BigIntOf(b.neg, BNSub(b.mag, a.mag))
BigIntSub(a, b) == BigIntAdd(a, BigIntNeg(b))
BigIntMul(a, b) == BigIntOf(a.neg # b.neg, BNMul(a.mag, b.mag))
BigIntDiv(a, b) == BigIntOf(a.neg # b.neg, BNDivMod(a.mag, b.mag)[1])
BigIntRem(a, b) == BigIntOf(a.neg, BNDivMod(a.mag, b.mag)[2])
BigIntLess(a, b) ==
  IF a.neg # b.neg THEN a.neg
  ELSE IF a.neg THEN BNCompare(b.mag, a.mag) < 0
  ELSE BNCompare(a.mag, b.mag) < 0
BigIntBitNot(a) == BigIntSub(BigIntNeg(a), BigIntFromInt(1))
\* a · 2^k for an integer k, rounding toward negative infinity.
BigIntShift(a, k) ==
  IF k >= 0 THEN BigIntOf(a.neg, BNShiftLeft(a.mag, k))
  ELSE IF ~a.neg THEN BigIntOf(FALSE, BNShiftRight(a.mag, -k))
  ELSE BigIntOf(TRUE, BNAdd(BNShiftRight(BNSub(a.mag, <<1>>), -k), <<1>>))
\* Bitwise operators on two's complement (§6.1.6.2.17 to §6.1.6.2.19), limb by limb.
SmallBitwise(op, x, y, bit) ==
  IF bit = 32768 THEN 0
  ELSE LET bx == (x \div bit) % 2
           by == (y \div bit) % 2
           b == CASE op = "&" -> bx * by
                  [] op = "|" -> IF bx + by > 0 THEN 1 ELSE 0
                  [] op = "^" -> (bx + by) % 2
       IN b * bit + SmallBitwise(op, x, y, bit * 2)
TwosComplement(a, width) == IF a.neg THEN BNSub(BNPow2(width), a.mag) ELSE a.mag
BigIntBitwise(a, op, b) ==
  LET width == 15 * (IntegerMax(BNBitLength(a.mag), BNBitLength(b.mag)) \div 15 + 1)
      limbs == width \div 15
      x == TwosComplement(a, width)
      y == TwosComplement(b, width)
      r == BNNorm([i \in 1..limbs |-> SmallBitwise(op, BNLimb(x, i), BNLimb(y, i), 1)])
  IN IF BNTestBit(r, width - 1) THEN BigIntOf(TRUE, BNSub(BNPow2(width), r)) ELSE BigIntOf(FALSE, r)
IntegerMax(x, y) == IF x > y THEN x ELSE y
\* The BigInt operators of ApplyStringOrNumericBinaryOperator, with their RangeErrors.
BigIntOperationResult(s, a, op, b) ==
  CASE op \in {"/", "%"} /\ BigIntIsZero(b) -> ThrowError(s, "RangeError")
    [] op = "**" /\ b.neg -> ThrowError(s, "RangeError")
    [] op = "**" ->
         IF BigIntIsZero(b) THEN Ok(s, BigInt(BigIntFromInt(1)))
         ELSE IF a.mag \in {<<>>, <<1>>} THEN Ok(s, BigInt(BigIntOf(a.neg /\ BNIsOdd(b.mag), a.mag)))
         ELSE IF ~BNFits(b.mag) \/ BNToInt(b.mag) > 1000000 THEN ThrowError(s, "RangeError")
         ELSE Ok(s, BigInt(BigIntOf(a.neg /\ BNIsOdd(b.mag), BNPow(a.mag, BNToInt(b.mag)))))
    [] op = ">>>" -> ThrowTypeError(s)
    [] op \in {"<<", ">>"} ->
         IF ~BNFits(b.mag) THEN
           IF (op = "<<") = ~b.neg THEN ThrowError(s, "RangeError")
           ELSE Ok(s, BigInt(IF a.neg THEN BigIntFromInt(-1) ELSE BigIntZero))
         ELSE LET k == IF b.neg THEN -BNToInt(b.mag) ELSE BNToInt(b.mag) IN
              Ok(s, BigInt(BigIntShift(a, IF op = "<<" THEN k ELSE -k)))
    [] OTHER ->
         Ok(s, BigInt(CASE op = "*" -> BigIntMul(a, b)
                        [] op = "/" -> BigIntDiv(a, b)
                        [] op = "%" -> BigIntRem(a, b)
                        [] op = "+" -> BigIntAdd(a, b)
                        [] op = "-" -> BigIntSub(a, b)
                        [] op \in {"&", "|", "^"} -> BigIntBitwise(a, op, b)))
\* BigInt::toString (§6.1.6.2.23) in a radix from 2 to 36.
BigIntToString(a, radix) ==
  IF BigIntIsZero(a) THEN <<48>>
  ELSE (IF a.neg THEN <<45>> ELSE <<>>) \o BigNatDigits(a.mag, radix, <<>>)
BigNatDigits(m, radix, acc) ==
  IF m = <<>> THEN acc
  ELSE LET qr == BNDivModSmall(m, radix)
           d == qr[2]
       IN BigNatDigits(qr[1], radix, <<IF d < 10 THEN 48 + d ELSE 87 + d>> \o acc)
\* StringToBigInt (§7.1.14): a BigInt value, or Undefined when the string isn't an integer.
StringToBigInt(units) ==
  LET trimmed == TrimWhiteSpace(units) IN
  IF trimmed = <<>> THEN BigInt(BigIntZero)
  ELSE IF Len(trimmed) > 2 /\ trimmed[1] = 48 /\ trimmed[2] \in {66, 98, 79, 111, 88, 120}
  THEN LET radix == CASE trimmed[2] \in {66, 98} -> 2 [] trimmed[2] \in {79, 111} -> 8 [] OTHER -> 16
           m == DigitsToBigNat(SubSeq(trimmed, 3, Len(trimmed)), radix, <<>>)
       IN IF m = Empty THEN Undefined ELSE BigInt(BigIntOf(FALSE, m))
  ELSE LET neg == trimmed[1] = 45
           digits == IF trimmed[1] \in {43, 45} THEN Tail(trimmed) ELSE trimmed
           m == IF digits = <<>> THEN Empty ELSE DigitsToBigNat(digits, 10, <<>>)
       IN IF m = Empty THEN Undefined ELSE BigInt(BigIntOf(neg, m))
DigitsToBigNat(digits, radix, acc) ==
  IF digits = <<>> THEN acc
  ELSE LET c == Head(digits)
           d == CASE c >= 48 /\ c <= 57 -> c - 48
                  [] c >= 97 /\ c <= 122 -> c - 87
                  [] c >= 65 /\ c <= 90 -> c - 55
                  [] OTHER -> 99
       IN IF d >= radix THEN Empty
          ELSE DigitsToBigNat(Tail(digits), radix, BNAdd(BNMulSmall(acc, radix), BNFromInt(d)))
\* Trims StrWhiteSpaceChar from both ends.
TrimWhiteSpace(units) ==
  LET start == NumTrimStart(units, 1)
      end == NumTrimEnd(units, Len(units))
  IN IF start > end THEN <<>> ELSE SubSeq(units, start, end)
\* The BigInt an integral finite Number denotes.
IntegralNumberToBigInt(x) ==
  CASE x.k = "int" -> BigIntFromInt(x.i)
    [] x.k = "nzero" -> BigIntZero
    [] OTHER -> BigIntOf(x.neg, BNShiftLeft(x.m, x.e))
BigIntEqualsNumber(a, x) ==
  NumIsFinite(x) /\ NumIsIntegral(x) /\ IntegralNumberToBigInt(x) = a
\* a < x and x < a for a BigInt a and a Number x: True, False, or Undefined.
BigIntLessNumber(a, x) ==
  CASE x.k = "nan" -> Undefined
    [] x.k = "inf" -> Bool(~x.neg)
    [] OTHER -> Bool(BigIntLess(a, IntegralNumberToBigInt(MathCeil(x))))
NumberLessBigInt(x, a) ==
  CASE x.k = "nan" -> Undefined
    [] x.k = "inf" -> Bool(x.neg)
    [] OTHER -> Bool(BigIntLess(IntegralNumberToBigInt(MathFloor(x)), a))
\* Adapters over ESNumber for the evaluator.
NumLess(x, y) == ~NumIsNaN(x) /\ ~NumIsNaN(y) /\ NumLessThan(x, y)
NumLessResult(x, y) == IF NumIsNaN(x) \/ NumIsNaN(y) THEN Undefined ELSE Bool(NumLessThan(x, y))
\* Objects (§6.1.7, §10.1). The state's objs holds each object as a record:
\*   proto  the [[Prototype]], an object value or Null
\*   ext    [[Extensible]]
\*   props  the property descriptors by key, in buckets (see PropBucket)
\*   keys   the keys in NamedBucket, in the order they were added
\*   class  what kind of object it is, which picks its internal methods
\*   slots  its other internal slots, by class
\* A descriptor always has all six fields, each a value or Absent (§6.2.6).
O(s, v) == HeapGet(s.objs, v.id)
SetO(s, v, o) == [s EXCEPT !.objs = HeapSet(@, v.id, o)]
DataDesc(v, w, e, c) ==
  [value |-> v, writable |-> Bool(w), get |-> Absent, set |-> Absent,
   enumerable |-> Bool(e), configurable |-> Bool(c)]
AccessorDesc(g, st, e, c) ==
  [value |-> Absent, writable |-> Absent, get |-> g, set |-> st,
   enumerable |-> Bool(e), configurable |-> Bool(c)]
IsAccessorDescriptor(d) == d.get # Absent \/ d.set # Absent
IsDataDescriptor(d) == d.value # Absent \/ d.writable # Absent
IsGenericDescriptor(d) == ~IsAccessorDescriptor(d) /\ ~IsDataDescriptor(d)
Truthy(b) == b = True
MakeObject(proto, class, slots) ==
  [proto |-> proto, ext |-> TRUE, props |-> <<>>, keys |-> <<>>, class |-> class, slots |-> slots,
   privs |-> <<>>]
\* Allocates an object, and returns the new state and the object.
Alloc(s, o) == [s |-> [s EXCEPT !.objs = HeapAppend(@, o), !.envsHeld = s.envs.size], v |-> Obj(s.objs.size + 1)]
\* props maps a bucket to a function from key to descriptor. An array index i is in bucket
\* i \div 100, which its digits but the last two give, and every other key in NamedBucket, so that
\* adding a property copies its bucket and the list of buckets rather than every property.
UnitsValue(units) == IF units = <<>> THEN 0 ELSE UnitsValue(SubSeq(units, 1, Len(units) - 1)) * 10 + units[Len(units)] - 48
PropBucket(k) ==
  CASE ~IsArrayIndex(k) -> NamedBucket
    [] Len(k.value) <= 2 -> 0
    [] OTHER -> UnitsValue(SubSeq(k.value, 1, Len(k.value) - 2))
HasProp(o, k) == PropBucket(k) \in DOMAIN o.props /\ k \in DOMAIN o.props[PropBucket(k)]
\* An object with the given own data properties, each <<key, value>>, writable, enumerable, and
\* configurable.
WithDataProps(o, pairs) ==
  IF pairs = <<>> THEN o
  ELSE WithDataProps(PutProp(o, Head(pairs)[1], DataDesc(Head(pairs)[2], TRUE, TRUE, TRUE)), Tail(pairs))
\* Writes a descriptor for a key, keeping the order the keys were first added in.
PutProp(o, k, d) ==
  LET b == PropBucket(k)
      keys == IF b = NamedBucket THEN Append(o.keys, k) ELSE o.keys
  IN CASE b \notin DOMAIN o.props -> [o EXCEPT !.props = (b :> (k :> d)) @@ @, !.keys = keys]
       [] k \notin DOMAIN o.props[b] -> [o EXCEPT !.props[b] = (k :> d) @@ @, !.keys = keys]
       [] OTHER -> [o EXCEPT !.props[b][k] = d]
DropProp(o, k) ==
  IF ~HasProp(o, k) THEN o
  ELSE LET b == PropBucket(k) IN
       [o EXCEPT !.props[b] = [x \in DOMAIN @ \ {k} |-> @[x]],
                 !.keys = IF b = NamedBucket THEN Remove(@, k) ELSE @]
\* Array indices (§6.1.7): canonical decimal strings of integers below 2^32 - 1.
IsDigit(u) == u >= 48 /\ u <= 57
DigitsBelow(units, limit) ==
  Len(units) < Len(limit) \/
  (Len(units) = Len(limit) /\ LexLess(units, limit))
LexLess(a, b) ==
  IF a = <<>> THEN b # <<>>
  ELSE IF b = <<>> THEN FALSE
  ELSE IF Head(a) # Head(b) THEN Head(a) < Head(b) ELSE LexLess(Tail(a), Tail(b))
IsArrayIndexUnits(units) ==
  /\ units # <<>>
  /\ \A i \in DOMAIN units : IsDigit(units[i])
  /\ (units = <<48>> \/ units[1] # 48)
  /\ DigitsBelow(units, N("4294967295"))
IsArrayIndex(k) == IsString(k) /\ IsArrayIndexUnits(k.value)
\* The order of OrdinaryOwnPropertyKeys: indices ascending, then strings, then symbols, each in the
\* order added.
IndexLess(a, b) == DigitsBelow(a.value, b.value)
SortInts(set) ==
  IF set = {} THEN <<>>
  ELSE LET least == CHOOSE x \in set : \A y \in set : x <= y IN <<least>> \o SortInts(set \ {least})
\* The indices of bucket b in ascending order, as the hundred keys it may hold.
BucketIndexKeys(bucket, b) ==
  LET prefix == IF b = 0 THEN <<>> ELSE NumToString(NumFromInt(b))
      candidates == [i \in 1..100 |-> Str(IF b = 0 /\ i <= 10 THEN <<47 + i>>
                                           ELSE prefix \o <<48 + ((i - 1) \div 10), 48 + ((i - 1) % 10)>>)]
  IN SelectSeq(candidates, LAMBDA k : k \in DOMAIN bucket)
OwnIndexKeys(o) == ConcatMap(SortInts(DOMAIN o.props \ {NamedBucket}), LAMBDA b : BucketIndexKeys(o.props[b], b))
OwnKeysOf(o) == OwnIndexKeys(o) \o SelectSeq(o.keys, IsString) \o SelectSeq(o.keys, IsSymbol)
\* Ordinary internal methods (§10.1).
OrdinaryGetOwnProperty(o, k) == IF HasProp(o, k) THEN o.props[PropBucket(k)][k] ELSE Absent
\* ValidateAndApplyPropertyDescriptor (§10.1.6.3), on the object record o with the current
\* descriptor of k, returning [ok, o].
ValidateAndApply(o, k, extensible, d, current) ==
  IF current = Absent THEN
    IF ~extensible THEN [ok |-> FALSE, o |-> o]
    ELSE [ok |-> TRUE, o |->
           PutProp(o, k,
             IF IsAccessorDescriptor(d)
             THEN AccessorDesc(IF d.get = Absent THEN Undefined ELSE d.get,
                               IF d.set = Absent THEN Undefined ELSE d.set,
                               Truthy(d.enumerable), Truthy(d.configurable))
             ELSE DataDesc(IF d.value = Absent THEN Undefined ELSE d.value,
                           Truthy(d.writable), Truthy(d.enumerable), Truthy(d.configurable)))]
  ELSE IF IsGenericDescriptor(d) /\ d.enumerable = Absent /\ d.configurable = Absent
    THEN [ok |-> TRUE, o |-> o]
  ELSE IF current.configurable = False /\
          (d.configurable = True \/
           (d.enumerable # Absent /\ d.enumerable # current.enumerable) \/
           (~IsGenericDescriptor(d) /\ IsAccessorDescriptor(d) # IsAccessorDescriptor(current)) \/
           (IsAccessorDescriptor(current) /\
              ((d.get # Absent /\ ~SameValue(d.get, current.get)) \/
               (d.set # Absent /\ ~SameValue(d.set, current.set)))) \/
           (IsDataDescriptor(current) /\ current.writable = False /\
              (d.writable = True \/ (d.value # Absent /\ ~SameValue(d.value, current.value)))))
    THEN [ok |-> FALSE, o |-> o]
  ELSE
    LET base ==
          IF IsDataDescriptor(current) /\ IsAccessorDescriptor(d)
          THEN AccessorDesc(Undefined, Undefined, Truthy(current.enumerable), Truthy(current.configurable))
          ELSE IF IsAccessorDescriptor(current) /\ IsDataDescriptor(d)
          THEN DataDesc(Undefined, FALSE, Truthy(current.enumerable), Truthy(current.configurable))
          ELSE current
        merged ==
          [f \in DOMAIN base |-> IF d[f] # Absent THEN d[f] ELSE base[f]]
    IN [ok |-> TRUE, o |-> PutProp(o, k, merged)]
OrdinaryDefineOwnProperty(s, v, k, d) ==
  LET o == O(s, v)
      r == ValidateAndApply(o, k, o.ext, d, OrdinaryGetOwnProperty(o, k))
  IN Ok(SetO(s, v, r.o), Bool(r.ok))
\* The exotic objects' internal methods, chosen by class. Each returns a result [s, c].
GetPrototypeOf(s, v) ==
  IF O(s, v).class = "proxy" THEN ProxyGetPrototypeOf(s, v) ELSE Ok(s, O(s, v).proto)
SetPrototypeOf(s, v, proto) ==
  LET o == O(s, v) IN
  IF o.class = "proxy" THEN ProxySetPrototypeOf(s, v, proto)
  ELSE IF SameValue(proto, o.proto) THEN Ok(s, True)
  ELSE IF ~o.ext \/ o.class = "immutableProto" THEN Ok(s, False)
  ELSE IF PrototypeChainHas(s, proto, v) THEN Ok(s, False)
  ELSE Ok(SetO(s, v, [o EXCEPT !.proto = proto]), True)
\* Whether setting v's prototype to proto would make a cycle (§10.1.2.1 step 8).
PrototypeChainHas(s, p, v) ==
  IF p = Null THEN FALSE
  ELSE IF SameValue(p, v) THEN TRUE
  ELSE IF O(s, p).class = "proxy" THEN FALSE
  ELSE PrototypeChainHas(s, O(s, p).proto, v)
IsExtensible(s, v) ==
  IF O(s, v).class = "proxy" THEN ProxyIsExtensible(s, v) ELSE Ok(s, Bool(O(s, v).ext))
PreventExtensions(s, v) ==
  LET o == O(s, v) IN
  IF o.class = "proxy" THEN ProxyPreventExtensions(s, v)
  ELSE IF o.class = "typedArray" /\ ~IsFixedLengthTypedArray(s, v) THEN Ok(s, False)
  ELSE Ok(SetO(s, v, [o EXCEPT !.ext = FALSE]), True)
GetOwnProperty(s, v, k) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxyGetOwnProperty(s, v, k)
    [] o.class = "string" -> Ok(s, StringGetOwnProperty(o, k))
    [] o.class = "arguments" -> Ok(s, ArgumentsGetOwnProperty(s, v, k))
    [] o.class = "typedArray" /\ IsTypedArrayKey(k) -> Ok(s, TypedArrayGetOwnProperty(s, v, k))
    [] o.class = "namespace" -> NamespaceGetOwnProperty(s, v, k)
    [] OTHER -> Ok(s, OrdinaryGetOwnProperty(o, k))
DefineOwnProperty(s, v, k, d) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxyDefineOwnProperty(s, v, k, d)
    [] o.class = "array" -> ArrayDefineOwnProperty(s, v, k, d)
    [] o.class = "string" -> StringDefineOwnProperty(s, v, k, d)
    [] o.class = "arguments" -> ArgumentsDefineOwnProperty(s, v, k, d)
    [] o.class = "typedArray" /\ IsTypedArrayKey(k) -> TypedArrayDefineOwnProperty(s, v, k, d)
    [] o.class = "namespace" -> NamespaceDefineOwnProperty(s, v, k, d)
    [] OTHER -> OrdinaryDefineOwnProperty(s, v, k, d)
HasProperty(s, v, k) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxyHasProperty(s, v, k)
    [] o.class = "typedArray" /\ IsTypedArrayKey(k) -> Ok(s, Bool(IsValidIntegerIndex(s, v, CanonicalIndex(k))))
    [] o.class = "namespace" /\ ~IsSymbolLikeNamespaceKey(s, v, k) -> NamespaceHasProperty(s, v, k)
    [] OTHER -> OrdinaryHasProperty(s, v, k)
OrdinaryHasProperty(s, v, k) ==
  LET r == GetOwnProperty(s, v, k) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) # Absent THEN Ok(r.s, True)
  ELSE LET p == GetPrototypeOf(r.s, v) IN
       IF IsAbrupt(p) THEN p
       ELSE IF Val(p) = Null THEN Ok(p.s, False)
       ELSE HasProperty(p.s, Val(p), k)
GetV(s, v, k, receiver) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxyGet(s, v, k, receiver)
    [] o.class = "arguments" -> ArgumentsGet(s, v, k, receiver)
    [] o.class = "typedArray" /\ IsTypedArrayKey(k) -> Ok(s, TypedArrayGetElement(s, v, CanonicalIndex(k)))
    [] o.class = "namespace" /\ ~IsSymbolLikeNamespaceKey(s, v, k) -> NamespaceGet(s, v, k)
    [] OTHER -> OrdinaryGet(s, v, k, receiver)
OrdinaryGet(s, v, k, receiver) ==
  LET r == GetOwnProperty(s, v, k) IN
  IF IsAbrupt(r) THEN r
  ELSE LET d == Val(r) IN
  IF d = Absent THEN
    LET p == GetPrototypeOf(r.s, v) IN
    IF IsAbrupt(p) THEN p
    ELSE IF Val(p) = Null THEN Ok(p.s, Undefined)
    ELSE GetV(p.s, Val(p), k, receiver)
  ELSE IF IsDataDescriptor(d) THEN Ok(r.s, d.value)
  ELSE IF d.get = Undefined THEN Ok(r.s, Undefined)
  ELSE Call(r.s, d.get, receiver, <<>>)
SetV(s, v, k, value, receiver) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxySet(s, v, k, value, receiver)
    [] o.class = "arguments" -> ArgumentsSet(s, v, k, value, receiver)
    [] o.class = "typedArray" /\ IsTypedArrayKey(k) -> TypedArraySet(s, v, k, value, receiver)
    [] o.class = "namespace" -> Ok(s, False)
    [] OTHER -> OrdinarySet(s, v, k, value, receiver)
OrdinarySet(s, v, k, value, receiver) ==
  LET r == GetOwnProperty(s, v, k) IN
  IF IsAbrupt(r) THEN r ELSE OrdinarySetWithOwnDescriptor(r.s, v, k, value, receiver, Val(r))
OrdinarySetWithOwnDescriptor(s, v, k, value, receiver, own) ==
  IF own = Absent THEN
    LET p == GetPrototypeOf(s, v) IN
    IF IsAbrupt(p) THEN p
    ELSE IF Val(p) # Null THEN SetV(p.s, Val(p), k, value, receiver)
    ELSE OrdinarySetWithOwnDescriptor(p.s, v, k, value, receiver,
                                      DataDesc(Undefined, TRUE, TRUE, TRUE))
  ELSE IF IsDataDescriptor(own) THEN
    IF own.writable = False THEN Ok(s, False)
    ELSE IF ~IsObject(receiver) THEN Ok(s, False)
    ELSE LET er == GetOwnProperty(s, receiver, k) IN
         IF IsAbrupt(er) THEN er
         ELSE LET existing == Val(er) IN
         IF existing # Absent THEN
           IF IsAccessorDescriptor(existing) \/ existing.writable = False THEN Ok(er.s, False)
           ELSE DefineOwnProperty(er.s, receiver, k, [EmptyDesc EXCEPT !.value = value])
         ELSE CreateDataProperty(er.s, receiver, k, value)
  ELSE IF own.set = Undefined THEN Ok(s, False)
  ELSE LET c == Call(s, own.set, receiver, <<value>>) IN
       IF IsAbrupt(c) THEN c ELSE Ok(c.s, True)
Delete(s, v, k) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxyDelete(s, v, k)
    [] o.class = "arguments" -> ArgumentsDelete(s, v, k)
    [] o.class = "typedArray" /\ IsTypedArrayKey(k) ->
         Ok(s, Bool(~IsValidIntegerIndex(s, v, CanonicalIndex(k))))
    [] o.class = "namespace" /\ ~IsSymbolLikeNamespaceKey(s, v, k) -> NamespaceDelete(s, v, k)
    [] OTHER -> OrdinaryDelete(s, v, k)
OrdinaryDelete(s, v, k) ==
  LET r == GetOwnProperty(s, v, k) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = Absent THEN Ok(r.s, True)
  ELSE IF Val(r).configurable = True THEN Ok(SetO(r.s, v, DropProp(O(r.s, v), k)), True)
  ELSE Ok(r.s, False)
OwnPropertyKeys(s, v) ==
  LET o == O(s, v) IN
  CASE o.class = "proxy" -> ProxyOwnPropertyKeys(s, v)
    [] o.class = "string" -> Ok(s, StringOwnPropertyKeys(o))
    [] o.class = "typedArray" -> Ok(s, TypedArrayOwnPropertyKeys(s, v))
    [] o.class = "namespace" -> NamespaceOwnPropertyKeys(s, v)
    [] OTHER -> Ok(s, OwnKeysOf(o))
\* Array exotic objects (§10.4.2).
ArrayDefineOwnProperty(s, v, k, d) ==
  IF k = SV("length") THEN ArraySetLength(s, v, d)
  ELSE IF IsArrayIndex(k) THEN
    LET o == O(s, v)
        lengthDesc == OrdinaryGetOwnProperty(o, SV("length"))
        index == StrToNum(k.value)
        length == lengthDesc.value.value
    IN IF ~NumLess(index, length) /\ lengthDesc.writable = False THEN Ok(s, False)
       ELSE LET r == OrdinaryDefineOwnProperty(s, v, k, d) IN
       IF Val(r) = False THEN r
       ELSE IF ~NumLess(index, length)
       THEN Ok(SetO(r.s, v, [O(r.s, v) EXCEPT !.props[NamedBucket][SV("length")].value =
                               Num(NumAdd(index, NumFromInt(1)))]), True)
       ELSE r
  ELSE OrdinaryDefineOwnProperty(s, v, k, d)
\* ArraySetLength (§10.4.2.4).
ArraySetLength(s, v, d) ==
  IF d.value = Absent THEN OrdinaryDefineOwnProperty(s, v, SV("length"), d)
  ELSE
    LET u == ToUint32(s, d.value) IN
    IF IsAbrupt(u) THEN u ELSE
    LET n == ToNumber(u.s, d.value) IN
    IF IsAbrupt(n) THEN n ELSE
    IF ~NumSameValueZero(Val(u).value, Val(n).value) THEN ThrowError(n.s, "RangeError")
    ELSE
      LET s2 == n.s
          newLen == Val(u).value
          o == O(s2, v)
          oldDesc == OrdinaryGetOwnProperty(o, SV("length"))
          oldLen == oldDesc.value.value
          newDesc == [d EXCEPT !.value = Num(newLen)]
      IN IF ~NumLess(newLen, oldLen) THEN OrdinaryDefineOwnProperty(s2, v, SV("length"), newDesc)
         ELSE IF oldDesc.writable = False THEN Ok(s2, False)
         ELSE
           LET newWritable == newDesc.writable # False
               defined == OrdinaryDefineOwnProperty(s2, v, SV("length"),
                                                    IF newWritable THEN newDesc ELSE [newDesc EXCEPT !.writable = True])
           IN IF Val(defined) = False THEN defined
              ELSE
                LET defO == O(defined.s, v)
                    \* Delete indices from the end down to newLen, stopping at a non-configurable one.
                    indices == SelectSeq(OwnIndexKeys(defO), LAMBDA k : ~NumLess(StrToNum(k.value), newLen))
                    cut == ArrayDeleteDown(defO, indices, Len(indices))
                    finalLen == IF cut.stopped = Absent THEN newLen
                                ELSE NumAdd(StrToNum(cut.stopped.value), NumFromInt(1))
                    finalO == [cut.o EXCEPT !.props[NamedBucket][SV("length")].value = Num(finalLen),
                                            !.props[NamedBucket][SV("length")].writable = Bool(newWritable)]
                IN Ok(SetO(defined.s, v, finalO), Bool(cut.stopped = Absent))
ArrayDeleteDown(o, indices, i) ==
  IF i = 0 THEN [o |-> o, stopped |-> Absent]
  ELSE LET k == indices[i] IN
       IF OrdinaryGetOwnProperty(o, k).configurable = False THEN [o |-> o, stopped |-> k]
       ELSE ArrayDeleteDown(DropProp(o, k), indices, i - 1)
\* String exotic objects (§10.4.3).
StringGetOwnProperty(o, k) ==
  LET own == OrdinaryGetOwnProperty(o, k) IN
  IF own # Absent THEN own ELSE StringGetOwnIndex(o, k)
StringGetOwnIndex(o, k) ==
  IF ~IsString(k) \/ ~IsCanonicalIntegerUnits(k.value) THEN Absent
  ELSE LET index == StrToNum(k.value) IN
       IF NumLess(index, NumFromInt(Len(o.slots.data))) /\ ~NumLess(index, NumFromInt(0)) /\
          index # NegZero
       THEN DataDesc(Str(<<o.slots.data[NumToSmallInt(index) + 1]>>), FALSE, TRUE, FALSE)
       ELSE Absent
\* CanonicalNumericIndexString for the integers a string index can be.
IsCanonicalIntegerUnits(units) ==
  /\ units # <<>>
  /\ \A i \in DOMAIN units : IsDigit(units[i])
  /\ (units = <<48>> \/ units[1] # 48)
StringDefineOwnProperty(s, v, k, d) ==
  LET current == StringGetOwnIndex(O(s, v), k) IN
  IF current # Absent
  THEN Ok(s, Bool(ValidateAndApply(O(s, v), k, FALSE, d, current).ok))
  ELSE OrdinaryDefineOwnProperty(s, v, k, d)
StringOwnPropertyKeys(o) ==
  LET n == Len(o.slots.data)
      indices == [i \in 1..n |-> Str(NumToString(NumFromInt(i - 1)))]
      own == OwnKeysOf(o)
  IN indices \o SelectSeq(own, LAMBDA k : ~(IsArrayIndex(k) /\ IndexLess(k, Str(NumToString(NumFromInt(n))))))
\* Abstract operations (§7). Each that can run user code returns a result [s, c].
\* Throws a new error of a native error type, such as "TypeError".
ThrowError(s, kind) ==
  LET a == Alloc(s, MakeObject(Obj(s.realm[kind \o "Prototype"]), "error", [data |-> Empty])) IN
  ThrowValue(a.s, a.v)
ThrowTypeError(s) == ThrowError(s, "TypeError")
Intrinsic(s, name) == Obj(s.realm[name])
\* Type conversion (§7.1).
ToPrimitive(s, v, hint) ==
  IF ~IsObject(v) THEN Ok(s, v)
  ELSE
    LET m == GetMethod(s, v, SymToPrimitive) IN
    IF IsAbrupt(m) THEN m
    ELSE IF Val(m) # Undefined THEN
      LET r == Call(m.s, Val(m), v, <<CASE hint = "none" -> SV("default") [] hint = "string" -> SV("string") [] OTHER -> SV("number")>>) IN
      IF IsAbrupt(r) THEN r
      ELSE IF IsObject(Val(r)) THEN ThrowTypeError(r.s)
      ELSE r
    ELSE OrdinaryToPrimitive(m.s, v, IF hint = "string" THEN "string" ELSE "number")
OrdinaryToPrimitive(s, v, hint) ==
  LET names == IF hint = "string" THEN <<SV("toString"), SV("valueOf")>>
               ELSE <<SV("valueOf"), SV("toString")>>
  IN TryPrimitiveMethods(s, v, names)
TryPrimitiveMethods(s, v, names) ==
  IF names = <<>> THEN ThrowTypeError(s)
  ELSE LET m == Get(s, v, Head(names)) IN
       IF IsAbrupt(m) THEN m
       ELSE IF IsCallable(m.s, Val(m)) THEN
         LET r == Call(m.s, Val(m), v, <<>>) IN
         IF IsAbrupt(r) THEN r
         ELSE IF ~IsObject(Val(r)) THEN r
         ELSE TryPrimitiveMethods(r.s, v, Tail(names))
       ELSE TryPrimitiveMethods(m.s, v, Tail(names))
ToBooleanValue(v) ==
  CASE v.type = "undefined" -> FALSE
    [] v.type = "null" -> FALSE
    [] v.type = "boolean" -> v.value
    [] v.type = "number" -> ~(v.value \in {PosZero, NegZero, NaN})
    [] v.type = "string" -> v.value # <<>>
    [] v.type = "bigint" -> ~BigIntIsZero(v.value)
    [] OTHER -> ~IsHTMLDDA(v)
ToBoolean(v) == Bool(ToBooleanValue(v))
\* Whether v is the test262 host's $262.IsHTMLDDA, the only object with an [[IsHTMLDDA]] slot (§B.3.6).
IsHTMLDDA(v) == v = Obj(IntrinsicIndex["IsHTMLDDA"])
\* ToNumber of a primitive that isn't a symbol or a BigInt, which can't throw.
PrimitiveToNumber(v) ==
  CASE v.type = "number" -> v
    [] v.type = "undefined" -> Num(NaN)
    [] v.type = "null" -> Num(PosZero)
    [] v.type = "boolean" -> IntV(IF v.value THEN 1 ELSE 0)
    [] v.type = "string" -> Num(StrToNum(v.value))
ToNumeric(s, v) ==
  LET p == ToPrimitive(s, v, "number") IN
  IF IsAbrupt(p) THEN p
  ELSE IF IsBigInt(Val(p)) THEN p
  ELSE ToNumber(p.s, Val(p))
ToNumber(s, v) ==
  CASE v.type \in {"number", "undefined", "null", "boolean", "string"} -> Ok(s, PrimitiveToNumber(v))
    [] v.type \in {"symbol", "bigint"} -> ThrowTypeError(s)
    [] OTHER ->
         LET p == ToPrimitive(s, v, "number") IN
         IF IsAbrupt(p) THEN p ELSE ToNumber(p.s, Val(p))
ToIntegerOrInfinity(s, v) ==
  LET n == ToNumber(s, v) IN
  IF IsAbrupt(n) THEN n ELSE Ok(n.s, Num(NumToIntegerOrInfinity(Val(n).value)))
ToInt32(s, v) ==
  LET n == ToNumber(s, v) IN IF IsAbrupt(n) THEN n ELSE Ok(n.s, IntV(NumToInt32(Val(n).value)))
ToUint32(s, v) ==
  LET n == ToNumber(s, v) IN IF IsAbrupt(n) THEN n ELSE Ok(n.s, Num(NumToUint32(Val(n).value)))
ToStr(s, v) ==
  CASE v.type = "string" -> Ok(s, v)
    [] v.type = "symbol" -> ThrowTypeError(s)
    [] v.type = "object" ->
         LET p == ToPrimitive(s, v, "string") IN
         IF IsAbrupt(p) THEN p ELSE ToStr(p.s, Val(p))
    [] OTHER -> Ok(s, Str(PrimitiveToUnits(v)))
\* ToString of a primitive that isn't a symbol.
PrimitiveToUnits(v) ==
  CASE v.type = "undefined" -> N("undefined")
    [] v.type = "null" -> N("null")
    [] v.type = "boolean" -> IF v.value THEN N("true") ELSE N("false")
    [] v.type = "number" -> NumToString(v.value)
    [] v.type = "bigint" -> BigIntToString(v.value, 10)
    [] v.type = "string" -> v.value
ToObject(s, v) ==
  CASE v.type \in {"undefined", "null"} -> ThrowTypeError(s)
    [] v.type = "object" -> Ok(s, v)
    [] v.type = "boolean" -> AllocWrapper(s, v, "BooleanPrototype", "boolean")
    [] v.type = "number" -> AllocWrapper(s, v, "NumberPrototype", "number")
    [] v.type = "bigint" -> AllocWrapper(s, v, "BigIntPrototype", "bigint")
    [] v.type = "symbol" -> AllocWrapper(s, v, "SymbolPrototype", "symbol")
    [] v.type = "string" -> StringCreate(s, v, Intrinsic(s, "StringPrototype"))
AllocWrapper(s, v, proto, class) ==
  LET a == Alloc(s, MakeObject(Intrinsic(s, proto), class, [data |-> v])) IN Ok(a.s, a.v)
\* StringCreate (§10.4.3.4).
StringCreate(s, v, proto) ==
  LET o == PutProp(MakeObject(proto, "string", [data |-> v.value]), SV("length"),
                   DataDesc(IntV(Len(v.value)), FALSE, FALSE, FALSE))
      a == Alloc(s, o)
  IN Ok(a.s, a.v)
ToPropertyKey(s, v) ==
  LET p == ToPrimitive(s, v, "string") IN
  IF IsAbrupt(p) THEN p
  ELSE IF IsSymbol(Val(p)) THEN p
  ELSE ToStr(p.s, Val(p))
ToLength(s, v) ==
  LET n == ToIntegerOrInfinity(s, v) IN
  IF IsAbrupt(n) THEN n ELSE Ok(n.s, Num(NumClampLength(Val(n).value)))
\* ToIndex (§7.1.22).
ToIndex(s, v) ==
  IF v = Undefined THEN Ok(s, IntV(0))
  ELSE LET n == ToIntegerOrInfinity(s, v) IN
       IF IsAbrupt(n) THEN n
       ELSE IF NumLess(Val(n).value, PosZero) \/ NumLess(MaxSafeInteger, Val(n).value)
       THEN ThrowError(n.s, "RangeError")
       ELSE n
\* ToAbsoluteIndex: an integer, +∞, or -∞, counted from length when negative.
ToAbsoluteIndex(s, v, length) ==
  LET n == ToIntegerOrInfinity(s, v) IN
  IF IsAbrupt(n) THEN n
  ELSE LET x == Val(n).value IN Ok(n.s, IF NumIsFinite(x) /\ x.neg THEN NumAdd(NumFromInt(length), x) ELSE x)
\* ToClampedIndex: ToAbsoluteIndex clamped to 0..length, as a TLA+ integer.
ToClampedIndex(s, v, length) ==
  LET i == ToAbsoluteIndex(s, v, length) IN
  IF IsAbrupt(i) THEN i
  ELSE Ok(i.s, IF NumLess(Val(i), PosZero) THEN 0
               ELSE IF NumLess(NumFromInt(length), Val(i)) THEN length ELSE NumToSmallInt(Val(i)))
\* CanonicalNumericIndexString (§7.1.21): the Number a string names, or Undefined.
CanonicalNumericIndexString(units) ==
  IF units = N("-0") THEN Num(NegZero)
  ELSE LET n == StrToNum(units) IN
       IF NumToString(n) = units THEN Num(n) ELSE Undefined
\* Testing and comparison (§7.2).
RequireObjectCoercible(s, v) == IF IsNullish(v) THEN ThrowTypeError(s) ELSE Ok(s, v)
IsCallable(s, v) == IsObject(v) /\ O(s, v).class \in CallableClasses /\ IsCallableObject(O(s, v))
IsCallableObject(o) == o.class # "proxy" \/ o.slots.callable
IsConstructor(s, v) ==
  IsObject(v) /\ O(s, v).class \in CallableClasses /\ O(s, v).slots.constructor
IsArray(s, v) ==
  IF ~IsObject(v) THEN Ok(s, False)
  ELSE IF O(s, v).class = "array" THEN Ok(s, True)
  ELSE IF O(s, v).class = "proxy" THEN
    IF O(s, v).slots.handler = Null THEN ThrowTypeError(s)
    ELSE IsArray(s, O(s, v).slots.target)
  ELSE Ok(s, False)
IsRegExp(s, v) ==
  IF ~IsObject(v) THEN Ok(s, False)
  ELSE LET m == Get(s, v, SymMatch) IN
       IF IsAbrupt(m) THEN m
       ELSE IF Val(m) # Undefined THEN Ok(m.s, ToBoolean(Val(m)))
       ELSE Ok(m.s, Bool(O(m.s, v).class = "regexp"))
SameValue(x, y) ==
  IF x.type # y.type THEN FALSE
  ELSE IF x.type = "number" THEN x.value = y.value
  ELSE x = y
SameValueZero(x, y) ==
  IF x.type = "number" /\ y.type = "number" THEN NumSameValueZero(x.value, y.value)
  ELSE SameValue(x, y)
IsStrictlyEqual(x, y) ==
  IF x.type # y.type THEN FALSE
  ELSE IF x.type = "number" THEN NumEqual(x.value, y.value)
  ELSE x = y
\* IsLooselyEqual (§7.2.14).
IsLooselyEqual(s, x, y) ==
  IF x.type = y.type THEN Ok(s, Bool(IsStrictlyEqual(x, y)))
  ELSE IF IsNullish(x) /\ IsNullish(y) THEN Ok(s, True)
  ELSE IF (IsHTMLDDA(x) /\ IsNullish(y)) \/ (IsNullish(x) /\ IsHTMLDDA(y)) THEN Ok(s, True)
  ELSE IF IsNumber(x) /\ IsString(y) THEN Ok(s, Bool(NumEqual(x.value, StrToNum(y.value))))
  ELSE IF IsString(x) /\ IsNumber(y) THEN Ok(s, Bool(NumEqual(StrToNum(x.value), y.value)))
  ELSE IF IsBigInt(x) /\ IsString(y) THEN
    LET n == StringToBigInt(y.value) IN
    Ok(s, Bool(n # Undefined /\ BigIntEqual(x.value, n.value)))
  ELSE IF IsString(x) /\ IsBigInt(y) THEN IsLooselyEqual(s, y, x)
  ELSE IF IsBoolean(x) THEN IsLooselyEqual(s, IntV(IF x.value THEN 1 ELSE 0), y)
  ELSE IF IsBoolean(y) THEN IsLooselyEqual(s, x, IntV(IF y.value THEN 1 ELSE 0))
  ELSE IF x.type \in {"string", "number", "bigint", "symbol"} /\ IsObject(y) THEN
    LET p == ToPrimitive(s, y, "none") IN
    IF IsAbrupt(p) THEN p ELSE IsLooselyEqual(p.s, x, Val(p))
  ELSE IF IsObject(x) /\ y.type \in {"string", "number", "bigint", "symbol"} THEN
    LET p == ToPrimitive(s, x, "none") IN
    IF IsAbrupt(p) THEN p ELSE IsLooselyEqual(p.s, Val(p), y)
  ELSE IF IsBigInt(x) /\ IsNumber(y) THEN Ok(s, Bool(BigIntEqualsNumber(x.value, y.value)))
  ELSE IF IsNumber(x) /\ IsBigInt(y) THEN Ok(s, Bool(BigIntEqualsNumber(y.value, x.value)))
  ELSE Ok(s, False)
\* IsLessThan (§7.2.13) on primitives px and py: True, False, or Undefined.
IsLessThanPrimitive(px, py) ==
  IF IsString(px) /\ IsString(py) THEN Bool(CodeUnitLess(px.value, py.value))
  ELSE IF IsBigInt(px) /\ IsString(py) THEN
    LET ny == StringToBigInt(py.value) IN
    IF ny = Undefined THEN Undefined ELSE Bool(BigIntLess(px.value, ny.value))
  ELSE IF IsString(px) /\ IsBigInt(py) THEN
    LET nx == StringToBigInt(px.value) IN
    IF nx = Undefined THEN Undefined ELSE Bool(BigIntLess(nx.value, py.value))
  ELSE
    LET nx == IF IsBigInt(px) THEN px ELSE PrimitiveToNumber(px)
        ny == IF IsBigInt(py) THEN py ELSE PrimitiveToNumber(py)
    IN IF IsNumber(nx) /\ IsNumber(ny) THEN NumLessResult(nx.value, ny.value)
       ELSE IF IsBigInt(nx) /\ IsBigInt(ny) THEN Bool(BigIntLess(nx.value, ny.value))
       ELSE IF IsBigInt(nx) THEN BigIntLessNumber(nx.value, ny.value)
       ELSE NumberLessBigInt(nx.value, ny.value)
IsLessThan(s, x, y, leftFirst) ==
  LET first == ToPrimitive(s, IF leftFirst THEN x ELSE y, "number") IN
  IF IsAbrupt(first) THEN first ELSE
  LET second == ToPrimitive(first.s, IF leftFirst THEN y ELSE x, "number") IN
  IF IsAbrupt(second) THEN second ELSE
  LET px == IF leftFirst THEN Val(first) ELSE Val(second)
      py == IF leftFirst THEN Val(second) ELSE Val(first)
  IN IF (IsSymbol(px) \/ IsSymbol(py)) THEN ThrowTypeError(second.s)
     ELSE Ok(second.s, IsLessThanPrimitive(px, py))
CodeUnitLess(a, b) == LexLess(a, b)
\* Operations on objects (§7.3).
Get(s, v, k) == GetV(s, v, k, v)
\* GetV (§7.3.3) on any value, which reads a primitive's property from its prototype.
GetValueProperty(s, v, k) ==
  IF IsObject(v) THEN GetV(s, v, k, v)
  ELSE LET o == ToObject(s, v) IN
       IF IsAbrupt(o) THEN o ELSE GetV(o.s, Val(o), k, v)
GetMethod(s, v, k) ==
  LET f == GetValueProperty(s, v, k) IN
  IF IsAbrupt(f) THEN f
  ELSE IF IsNullish(Val(f)) THEN Ok(f.s, Undefined)
  ELSE IF ~IsCallable(f.s, Val(f)) THEN ThrowTypeError(f.s)
  ELSE f
Set(s, v, k, value, throw) ==
  LET r == SetV(s, v, k, value, v) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = False /\ throw THEN ThrowTypeError(r.s)
  ELSE Ok(r.s, Undefined)
CreateDataProperty(s, v, k, value) ==
  DefineOwnProperty(s, v, k, DataDesc(value, TRUE, TRUE, TRUE))
CreateDataPropertyOrThrow(s, v, k, value) ==
  LET r == CreateDataProperty(s, v, k, value) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = False THEN ThrowTypeError(r.s)
  ELSE Ok(r.s, True)
\* CreateNonEnumerableDataPropertyOrThrow (§7.3.8).
CreateMethodProperty(s, v, k, value) ==
  DefinePropertyOrThrow(s, v, k, DataDesc(value, TRUE, FALSE, TRUE))
DefinePropertyOrThrow(s, v, k, d) ==
  LET r == DefineOwnProperty(s, v, k, d) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = False THEN ThrowTypeError(r.s)
  ELSE Ok(r.s, True)
DeletePropertyOrThrow(s, v, k) ==
  LET r == Delete(s, v, k) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = False THEN ThrowTypeError(r.s)
  ELSE Ok(r.s, True)
HasOwnProperty(s, v, k) ==
  LET r == GetOwnProperty(s, v, k) IN
  IF IsAbrupt(r) THEN r ELSE Ok(r.s, Bool(Val(r) # Absent))
\* Call (§7.3.14) and Construct (§7.3.15).
Call(s, f, this, args) ==
  IF ~IsCallable(s, f) THEN ThrowTypeError(s)
  ELSE CallObject(s, f, this, args)
Construct(s, f, args, newTarget) == ConstructObject(s, f, args, newTarget)
\* SetIntegrityLevel (§7.3.16) and TestIntegrityLevel (§7.3.17).
SetIntegrityLevel(s, v, level) ==
  LET p == PreventExtensions(s, v) IN
  IF IsAbrupt(p) THEN p
  ELSE IF Val(p) = False THEN Ok(p.s, False)
  ELSE LET ks == OwnPropertyKeys(p.s, v) IN
  IF IsAbrupt(ks) THEN ks
  ELSE LET r == SetIntegrityKeys(ks.s, v, Val(ks), level) IN
       IF IsAbrupt(r) THEN r ELSE Ok(r.s, True)
SetIntegrityKeys(s, v, ks, level) ==
  IF ks = <<>> THEN Ok(s, True)
  ELSE LET k == Head(ks)
           r == IF level = "sealed"
                THEN DefinePropertyOrThrow(s, v, k, [EmptyDesc EXCEPT !.configurable = False])
                ELSE LET cur == GetOwnProperty(s, v, k) IN
                     IF IsAbrupt(cur) THEN cur
                     ELSE IF Val(cur) = Absent THEN Ok(cur.s, True)
                     ELSE DefinePropertyOrThrow(cur.s, v, k,
                            IF IsAccessorDescriptor(Val(cur))
                            THEN [EmptyDesc EXCEPT !.configurable = False]
                            ELSE [EmptyDesc EXCEPT !.configurable = False, !.writable = False])
       IN IF IsAbrupt(r) THEN r ELSE SetIntegrityKeys(r.s, v, Tail(ks), level)
TestIntegrityLevel(s, v, level) ==
  LET e == IsExtensible(s, v) IN
  IF IsAbrupt(e) THEN e
  ELSE IF Val(e) = True THEN Ok(e.s, False)
  ELSE LET ks == OwnPropertyKeys(e.s, v) IN
  IF IsAbrupt(ks) THEN ks ELSE TestIntegrityKeys(ks.s, v, Val(ks), level)
TestIntegrityKeys(s, v, ks, level) ==
  IF ks = <<>> THEN Ok(s, True)
  ELSE LET cur == GetOwnProperty(s, v, Head(ks)) IN
       IF IsAbrupt(cur) THEN cur
       ELSE LET d == Val(cur) IN
       IF d # Absent /\ (d.configurable = True \/
                          (level = "frozen" /\ IsDataDescriptor(d) /\ d.writable = True))
       THEN Ok(cur.s, False)
       ELSE TestIntegrityKeys(cur.s, v, Tail(ks), level)
\* CreateArrayFromList (§7.3.18).
CreateArrayFromList(s, values) ==
  LET a == ArrayCreate(s, 0, Intrinsic(s, "ArrayPrototype")) IN
  LET o == O(a.s, Val(a)) IN
  Ok(SetO(a.s, Val(a),
          [AddIndexProps(o, values, 1) EXCEPT !.props[NamedBucket][SV("length")].value = IntV(Len(values))]),
     Val(a))
AddIndexProps(o, values, i) ==
  IF i > Len(values) THEN o
  ELSE AddIndexProps(PutProp(o, Str(NumToString(NumFromInt(i - 1))),
                             DataDesc(values[i], TRUE, TRUE, TRUE)), values, i + 1)
\* ArrayCreate (§10.4.2.2) with a length that fits a TLA+ integer.
ArrayCreate(s, length, proto) ==
  LET o == PutProp(MakeObject(proto, "array", [none |-> TRUE]), SV("length"),
                   DataDesc(IntV(length), TRUE, FALSE, FALSE))
      a == Alloc(s, o)
  IN Ok(a.s, a.v)
\* LengthOfArrayLike (§7.3.19).
LengthOfArrayLike(s, v) ==
  LET l == Get(s, v, SV("length")) IN
  IF IsAbrupt(l) THEN l ELSE ToLength(l.s, Val(l))
\* CreateListFromArrayLike (§7.3.20).
CreateListFromArrayLike(s, v, types) ==
  IF ~IsObject(v) THEN ThrowTypeError(s)
  ELSE LET l == LengthOfArrayLike(s, v) IN
  IF IsAbrupt(l) THEN l
  ELSE IF NumLess(NumFromInt(10000000), Val(l).value) THEN ThrowError(l.s, "RangeError")
  ELSE ListFromArrayLike(l.s, v, NumToSmallInt(Val(l).value), 0, <<>>, types)
ListFromArrayLike(s, v, n, i, acc, types) ==
  IF i = n THEN Ok(s, acc)
  ELSE LET e == Get(s, v, Str(NumToString(NumFromInt(i)))) IN
       IF IsAbrupt(e) THEN e
       ELSE IF types = "property-key" /\ ~IsPropertyKey(Val(e)) THEN ThrowTypeError(e.s)
       ELSE ListFromArrayLike(e.s, v, n, i + 1, Append(acc, Val(e)), types)
\* Invoke (§7.3.21).
Invoke(s, v, k, args) ==
  LET f == GetValueProperty(s, v, k) IN
  IF IsAbrupt(f) THEN f ELSE Call(f.s, Val(f), v, args)
\* OrdinaryHasInstance (§7.3.22).
OrdinaryHasInstance(s, c, v) ==
  IF ~IsCallable(s, c) THEN Ok(s, False)
  ELSE IF O(s, c).class = "bound" THEN InstanceofOperator(s, v, O(s, c).slots.target)
  ELSE IF ~IsObject(v) THEN Ok(s, False)
  ELSE LET p == Get(s, c, SV("prototype")) IN
  IF IsAbrupt(p) THEN p
  ELSE IF ~IsObject(Val(p)) THEN ThrowTypeError(p.s)
  ELSE PrototypeWalk(p.s, v, Val(p))
PrototypeWalk(s, v, proto) ==
  LET r == GetPrototypeOf(s, v) IN
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = Null THEN Ok(r.s, False)
  ELSE IF SameValue(Val(r), proto) THEN Ok(r.s, True)
  ELSE PrototypeWalk(r.s, Val(r), proto)
\* SpeciesConstructor (§7.3.23).
SpeciesConstructor(s, v, default) ==
  LET c == Get(s, v, SV("constructor")) IN
  IF IsAbrupt(c) THEN c
  ELSE IF Val(c) = Undefined THEN Ok(c.s, default)
  ELSE IF ~IsObject(Val(c)) THEN ThrowTypeError(c.s)
  ELSE LET sp == Get(c.s, Val(c), SymSpecies) IN
  IF IsAbrupt(sp) THEN sp
  ELSE IF IsNullish(Val(sp)) THEN Ok(sp.s, default)
  ELSE IF IsConstructor(sp.s, Val(sp)) THEN sp
  ELSE ThrowTypeError(sp.s)
\* EnumerableOwnProperties (§7.3.24) with kind "key", "value", or "key+value".
EnumerableOwnProperties(s, v, kind) ==
  LET ks == OwnPropertyKeys(s, v) IN
  IF IsAbrupt(ks) THEN ks ELSE EnumerableOwnKeys(ks.s, v, SelectSeq(Val(ks), IsString), kind, <<>>)
EnumerableOwnKeys(s, v, ks, kind, acc) ==
  IF ks = <<>> THEN Ok(s, acc)
  ELSE LET k == Head(ks)
           d == GetOwnProperty(s, v, k)
       IN IF IsAbrupt(d) THEN d
          ELSE IF Val(d) = Absent \/ Val(d).enumerable # True
          THEN EnumerableOwnKeys(d.s, v, Tail(ks), kind, acc)
          ELSE IF kind = "key" THEN EnumerableOwnKeys(d.s, v, Tail(ks), kind, Append(acc, k))
          ELSE LET value == Get(d.s, v, k) IN
          IF IsAbrupt(value) THEN value
          ELSE IF kind = "value" THEN EnumerableOwnKeys(value.s, v, Tail(ks), kind, Append(acc, Val(value)))
          ELSE IF kind = "pair" THEN EnumerableOwnKeys(value.s, v, Tail(ks), kind, Append(acc, <<k, Val(value)>>))
          ELSE LET entry == CreateArrayFromList(value.s, <<k, Val(value)>>) IN
               EnumerableOwnKeys(entry.s, v, Tail(ks), kind, Append(acc, Val(entry)))
\* GetFunctionRealm (§7.3.25): the index of the realm of function object f.
GetFunctionRealm(s, f) ==
  LET o == O(s, f) IN
  CASE o.class \in {"builtin", "function", "wrapped"} -> Ok(s, o.slots.realm)
    [] o.class = "bound" -> GetFunctionRealm(s, o.slots.target)
    [] o.class = "proxy" -> IF o.slots.handler = Null THEN ThrowTypeError(s) ELSE GetFunctionRealm(s, o.slots.target)
    [] OTHER -> Ok(s, s.realmId)
\* GetPrototypeFromConstructor (§10.1.14).
GetPrototypeFromConstructor(s, c, default) ==
  LET p == Get(s, c, SV("prototype")) IN
  IF IsAbrupt(p) THEN p
  ELSE IF IsObject(Val(p)) THEN p
  ELSE LET realm == GetFunctionRealm(p.s, c) IN
       IF IsAbrupt(realm) THEN realm ELSE Ok(realm.s, Obj(realm.s.realms[Val(realm)].intrinsics[default]))
\* OrdinaryCreateFromConstructor (§10.1.13).
OrdinaryCreateFromConstructor(s, c, default, class, slots) ==
  LET p == GetPrototypeFromConstructor(s, c, default) IN
  IF IsAbrupt(p) THEN p
  ELSE LET a == Alloc(p.s, MakeObject(Val(p), class, slots)) IN Ok(a.s, a.v)
OrdinaryObjectCreate(s, proto) ==
  LET a == Alloc(s, MakeObject(proto, "ordinary", [none |-> TRUE])) IN Ok(a.s, a.v)
\* ToPropertyDescriptor (§6.2.6.5) and FromPropertyDescriptor (§6.2.6.4).
ToPropertyDescriptor(s, v) ==
  IF ~IsObject(v) THEN ThrowTypeError(s)
  ELSE LET r == ReadDescriptorFields(s, v, <<"enumerable", "configurable", "value", "writable", "get", "set">>, EmptyDesc) IN
  IF IsAbrupt(r) THEN r
  ELSE LET d == Val(r) IN
  IF (d.get # Absent /\ d.get # Undefined /\ ~IsCallable(r.s, d.get)) \/
     (d.set # Absent /\ d.set # Undefined /\ ~IsCallable(r.s, d.set))
  THEN ThrowTypeError(r.s)
  ELSE IF (d.get # Absent \/ d.set # Absent) /\ (d.value # Absent \/ d.writable # Absent)
  THEN ThrowTypeError(r.s)
  ELSE r
ReadDescriptorFields(s, v, fields, d) ==
  IF fields = <<>> THEN Ok(s, d)
  ELSE LET f == Head(fields)
           h == HasProperty(s, v, DescriptorKey(f))
       IN IF IsAbrupt(h) THEN h
          ELSE IF Val(h) = False THEN ReadDescriptorFields(h.s, v, Tail(fields), d)
          ELSE LET g == Get(h.s, v, DescriptorKey(f)) IN
          IF IsAbrupt(g) THEN g
          ELSE ReadDescriptorFields(g.s, v, Tail(fields),
                 [d EXCEPT ![f] = IF f \in {"enumerable", "configurable", "writable"}
                                  THEN ToBoolean(Val(g)) ELSE Val(g)])
\* The property key of a descriptor field.
DescriptorKey(f) ==
  CASE f = "value" -> SV("value") [] f = "writable" -> SV("writable") [] f = "get" -> SV("get")
    [] f = "set" -> SV("set") [] f = "enumerable" -> SV("enumerable") [] f = "configurable" -> SV("configurable")
FromPropertyDescriptor(s, d) ==
  IF d = Absent THEN Ok(s, Undefined)
  ELSE
    LET fields == SelectSeq(<<"value", "writable", "get", "set", "enumerable", "configurable">>,
                            LAMBDA f : d[f] # Absent)
        o == OrdinaryObjectCreate(s, Intrinsic(s, "ObjectPrototype"))
    IN Ok(SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), [i \in DOMAIN fields |-> <<DescriptorKey(fields[i]), d[fields[i]]>>])),
          Val(o))
\* CompletePropertyDescriptor (§6.2.6.6).
CompletePropertyDescriptor(d) ==
  IF IsGenericDescriptor(d) \/ IsDataDescriptor(d)
  THEN [d EXCEPT !.value = IF @ = Absent THEN Undefined ELSE @,
                 !.writable = IF @ = Absent THEN False ELSE @,
                 !.enumerable = IF @ = Absent THEN False ELSE @,
                 !.configurable = IF @ = Absent THEN False ELSE @]
  ELSE [d EXCEPT !.get = IF @ = Absent THEN Undefined ELSE @,
                 !.set = IF @ = Absent THEN Undefined ELSE @,
                 !.enumerable = IF @ = Absent THEN False ELSE @,
                 !.configurable = IF @ = Absent THEN False ELSE @]
\* Environment records (§9.1). The state's envs holds each as a record with kind "declarative",
\* "catch" (a catch clause's declarative environment), "function", "module", "object", or "global", and outer, the index of the outer environment or 0.
\* A declarative environment's b maps each name to [value, mutable, init, strict, deletable].
\* A function environment adds this, thisStatus, fn, and newTarget. An object environment has obj
\* and withEnv. A global environment has objRec and declRec, the indices of its parts. A module environment adds module, the index of its module, and its import bindings
\* hold [type |-> "import", module, name], the module and the name of the binding they read.
E(s, e) == HeapGet(s.envs, e)
SetE(s, e, env) == [s EXCEPT !.envs = HeapSet(@, e, env)]
\* The heap never collects, so a call frees the environments it made when it returns, unless
\* something other than the evaluation may refer to one. envsHeld counts the environments, from
\* the first, that may be: HoldEnvs holds them all whenever an object is allocated, which covers
\* closures, arguments objects, and await reactions, and whenever a realm, a module, a suspended
\* body's frames, a hoisted function, or a disposable resource records an environment.
HoldEnvs(s) == [s EXCEPT !.envsHeld = s.envs.size]
FreeEnvs(size, r) ==
  IF r.s.envsHeld > size \/ r.s.envs.size = size THEN r ELSE [r EXCEPT !.s.envs = HeapTruncate(@, size)]
AllocEnv(s, env) == [s |-> [s EXCEPT !.envs = HeapAppend(@, env)], e |-> s.envs.size + 1]
NewDeclarativeEnvironment(s, outer) ==
  AllocEnv(s, [kind |-> "declarative", outer |-> outer, b |-> <<>>])
NewCatchEnvironment(s, outer) == AllocEnv(s, [kind |-> "catch", outer |-> outer, b |-> <<>>])
NewObjectEnvironment(s, obj, withEnv, outer) ==
  AllocEnv(s, [kind |-> "object", outer |-> outer, obj |-> obj, withEnv |-> withEnv])
NewFunctionEnvironment(s, f, newTarget) ==
  LET fo == O(s, f) IN
  AllocEnv(s, [kind |-> "function", outer |-> fo.slots.env, b |-> <<>>,
               this |-> Undefined,
               thisStatus |-> IF fo.slots.thisMode = "lexical" THEN "lexical" ELSE "uninitialized",
               fn |-> f, newTarget |-> newTarget])
NewModuleEnvironment(s, outer, m) ==
  LET a == AllocEnv(s, [kind |-> "module", outer |-> outer, b |-> <<>>, module |-> m]) IN [a EXCEPT !.s = HoldEnvs(@)]
\* CreateImportBinding (§9.1.1.5.5).
CreateImportBinding(s, e, name, m, bindingName) ==
  SetE(s, e, [E(s, e) EXCEPT !.b = (name :> Binding([type |-> "import", module |-> m, name |-> bindingName], FALSE, TRUE, TRUE, FALSE)) @@ @])
Binding(value, mutable, init, strict, deletable) ==
  [value |-> value, mutable |-> mutable, init |-> init, strict |-> strict, deletable |-> deletable]
IsDeclarativeKind(kind) == kind \in {"declarative", "catch", "function", "module"}
\* HasBinding (§9.1.1.*.1).
HasBinding(s, e, name) ==
  LET env == E(s, e) IN
  CASE IsDeclarativeKind(env.kind) -> Ok(s, Bool(name \in DOMAIN env.b))
    [] env.kind = "object" ->
         LET h == HasProperty(s, env.obj, Str(name)) IN
         IF IsAbrupt(h) \/ Val(h) = False \/ ~env.withEnv THEN h
         ELSE LET u == Get(h.s, env.obj, SymUnscopables) IN
         IF IsAbrupt(u) THEN u
         ELSE IF ~IsObject(Val(u)) THEN Ok(u.s, True)
         ELSE LET blocked == Get(u.s, Val(u), Str(name)) IN
              IF IsAbrupt(blocked) THEN blocked ELSE Ok(blocked.s, Bool(~ToBooleanValue(Val(blocked))))
    [] env.kind = "global" ->
         IF name \in DOMAIN E(s, env.declRec).b THEN Ok(s, True)
         ELSE HasBinding(s, env.objRec, name)
CreateMutableBinding(s, e, name, deletable) ==
  LET env == E(s, e) IN
  CASE IsDeclarativeKind(env.kind) ->
         Ok(SetE(s, e, [env EXCEPT !.b = (name :> Binding(Undefined, TRUE, FALSE, FALSE, deletable)) @@ @]), Empty)
    [] env.kind = "object" ->
         LET r == DefinePropertyOrThrow(s, env.obj, Str(name), DataDesc(Undefined, TRUE, TRUE, deletable)) IN
         IF IsAbrupt(r) THEN r ELSE Ok(r.s, Empty)
    [] env.kind = "global" ->
         IF name \in DOMAIN E(s, env.declRec).b THEN ThrowTypeError(s)
         ELSE CreateMutableBinding(s, env.declRec, name, deletable)
CreateImmutableBinding(s, e, name, strict) ==
  LET env == E(s, e)
      target == IF env.kind = "global" THEN env.declRec ELSE e
  IN IF env.kind = "global" /\ name \in DOMAIN E(s, env.declRec).b THEN ThrowTypeError(s)
     ELSE Ok(SetE(s, target, [E(s, target) EXCEPT !.b = (name :> Binding(Undefined, FALSE, FALSE, strict, FALSE)) @@ @]), Empty)
InitializeBinding(s, e, name, value) ==
  LET env == E(s, e) IN
  CASE IsDeclarativeKind(env.kind) ->
         Ok(SetE(s, e, [env EXCEPT !.b[name].value = value, !.b[name].init = TRUE]), Empty)
    [] env.kind = "object" -> SetMutableBinding(s, e, name, value, FALSE)
    [] env.kind = "global" ->
         IF name \in DOMAIN E(s, env.declRec).b THEN InitializeBinding(s, env.declRec, name, value)
         ELSE InitializeBinding(s, env.objRec, name, value)
SetMutableBinding(s, e, name, value, strict) ==
  LET env == E(s, e) IN
  CASE IsDeclarativeKind(env.kind) ->
         IF name \notin DOMAIN env.b THEN
           IF strict THEN ThrowError(s, "ReferenceError")
           ELSE LET c == CreateMutableBinding(s, e, name, TRUE) IN
                InitializeBinding(c.s, e, name, value)
         ELSE LET bind == env.b[name] IN
         IF ~bind.init THEN ThrowError(s, "ReferenceError")
         ELSE IF bind.mutable THEN Ok(SetE(s, e, [env EXCEPT !.b[name].value = value]), Empty)
         ELSE IF strict \/ bind.strict THEN ThrowTypeError(s)
         ELSE Ok(s, Empty)
    [] env.kind = "object" ->
         LET h == HasProperty(s, env.obj, Str(name)) IN
         IF IsAbrupt(h) THEN h
         ELSE IF Val(h) = False /\ strict THEN ThrowError(h.s, "ReferenceError")
         ELSE LET r == Set(h.s, env.obj, Str(name), value, strict) IN
              IF IsAbrupt(r) THEN r ELSE Ok(r.s, Empty)
    [] env.kind = "global" ->
         IF name \in DOMAIN E(s, env.declRec).b THEN SetMutableBinding(s, env.declRec, name, value, strict)
         ELSE SetMutableBinding(s, env.objRec, name, value, strict)
GetBindingValue(s, e, name, strict) ==
  LET env == E(s, e) IN
  CASE env.kind = "module" /\ env.b[name].value.type = "import" ->
         LET target == env.b[name].value IN
         IF ModuleAt(s, target.module).env = 0 THEN ThrowError(s, "ReferenceError")
         ELSE GetBindingValue(s, ModuleAt(s, target.module).env, target.name, TRUE)
    [] IsDeclarativeKind(env.kind) ->
         IF ~env.b[name].init THEN ThrowError(s, "ReferenceError") ELSE Ok(s, env.b[name].value)
    [] env.kind = "object" ->
         LET h == HasProperty(s, env.obj, Str(name)) IN
         IF IsAbrupt(h) THEN h
         ELSE IF Val(h) = False THEN
           IF strict THEN ThrowError(h.s, "ReferenceError") ELSE Ok(h.s, Undefined)
         ELSE Get(h.s, env.obj, Str(name))
    [] env.kind = "global" ->
         IF name \in DOMAIN E(s, env.declRec).b THEN GetBindingValue(s, env.declRec, name, strict)
         ELSE GetBindingValue(s, env.objRec, name, strict)
DeleteBinding(s, e, name) ==
  LET env == E(s, e) IN
  CASE IsDeclarativeKind(env.kind) ->
         IF ~env.b[name].deletable THEN Ok(s, False)
         ELSE Ok(SetE(s, e, [env EXCEPT !.b = [n \in DOMAIN @ \ {name} |-> @[n]]]), True)
    [] env.kind = "object" -> Delete(s, env.obj, Str(name))
    [] env.kind = "global" ->
         IF name \in DOMAIN E(s, env.declRec).b THEN DeleteBinding(s, env.declRec, name)
         ELSE LET h == HasOwnProperty(s, E(s, env.objRec).obj, Str(name)) IN
         IF IsAbrupt(h) THEN h
         ELSE IF Val(h) = False THEN Ok(h.s, True)
         ELSE DeleteBinding(h.s, env.objRec, name)
HasThisBinding(s, e) ==
  LET env == E(s, e) IN
  CASE env.kind = "function" -> env.thisStatus # "lexical"
    [] env.kind \in {"global", "module"} -> TRUE
    [] OTHER -> FALSE
HasSuperBinding(s, e) ==
  LET env == E(s, e) IN
  env.kind = "function" /\ env.thisStatus # "lexical" /\ O(s, env.fn).slots.home # Undefined
GetThisBinding(s, e) ==
  LET env == E(s, e) IN
  CASE env.kind = "function" ->
         IF env.thisStatus = "uninitialized" THEN ThrowError(s, "ReferenceError") ELSE Ok(s, env.this)
    [] env.kind = "global" -> Ok(s, env.this)
    [] env.kind = "module" -> Ok(s, Undefined)
BindThisValue(s, e, v) ==
  LET env == E(s, e) IN
  IF env.thisStatus = "initialized" THEN ThrowError(s, "ReferenceError")
  ELSE Ok(SetE(s, e, [env EXCEPT !.this = v, !.thisStatus = "initialized"]), v)
GetSuperBase(s, e) ==
  LET home == O(s, E(s, e).fn).slots.home IN
  IF home = Undefined THEN Ok(s, Undefined) ELSE GetPrototypeOf(s, home)
\* The global environment's own operations (§9.1.1.4).
HasLexicalDeclaration(s, e, name) == name \in DOMAIN E(s, E(s, e).declRec).b
HasRestrictedGlobalProperty(s, e, name) ==
  LET d == GetOwnProperty(s, E(s, E(s, e).objRec).obj, Str(name)) IN
  IF IsAbrupt(d) THEN d
  ELSE IF Val(d) = Absent THEN Ok(d.s, False)
  ELSE Ok(d.s, Bool(Val(d).configurable = False))
CanDeclareGlobalVar(s, e, name) ==
  LET g == E(s, E(s, e).objRec).obj
      h == HasOwnProperty(s, g, Str(name))
  IN IF IsAbrupt(h) THEN h
     ELSE IF Val(h) = True THEN Ok(h.s, True)
     ELSE IsExtensible(h.s, g)
CanDeclareGlobalFunction(s, e, name) ==
  LET g == E(s, E(s, e).objRec).obj
      d == GetOwnProperty(s, g, Str(name))
  IN IF IsAbrupt(d) THEN d
     ELSE IF Val(d) = Absent THEN IsExtensible(d.s, g)
     ELSE IF Val(d).configurable = True THEN Ok(d.s, True)
     ELSE Ok(d.s, Bool(IsDataDescriptor(Val(d)) /\ Val(d).writable = True /\ Val(d).enumerable = True))
CreateGlobalVarBinding(s, e, name, deletable) ==
  LET env == E(s, e)
      g == E(s, env.objRec).obj
      h == HasOwnProperty(s, g, Str(name))
  IN IF IsAbrupt(h) THEN h ELSE
     LET ex == IsExtensible(h.s, g) IN
     IF IsAbrupt(ex) THEN ex ELSE
     IF Val(h) = False /\ Val(ex) = True
     THEN LET m == CreateMutableBinding(ex.s, env.objRec, name, deletable) IN
          IF IsAbrupt(m) THEN m ELSE InitializeBinding(m.s, env.objRec, name, Undefined)
     ELSE Ok(ex.s, Empty)
CreateGlobalFunctionBinding(s, e, name, value, deletable) ==
  LET env == E(s, e)
      g == E(s, env.objRec).obj
      d == GetOwnProperty(s, g, Str(name))
  IN IF IsAbrupt(d) THEN d ELSE
     LET desc == IF Val(d) = Absent \/ Val(d).configurable = True
                 THEN DataDesc(value, TRUE, TRUE, deletable)
                 ELSE [EmptyDesc EXCEPT !.value = value]
         r == DefinePropertyOrThrow(d.s, g, Str(name), desc)
     IN IF IsAbrupt(r) THEN r ELSE
        LET w == Set(r.s, g, Str(name), value, FALSE) IN
        IF IsAbrupt(w) THEN w ELSE Ok(w.s, Empty)
\* GetIdentifierReference (§9.1.2.1): a Reference Record for name, resolved from environment e.
Reference(base, name, strict, this) ==
  [type |-> "reference", base |-> base, name |-> name, strict |-> strict, this |-> this]
EnvBase(e) == [type |-> "env", env |-> e]
GetIdentifierReference(s, e, name, strict) ==
  IF e = 0 THEN Ok(s, Reference(Unresolvable, Str(name), strict, Empty))
  ELSE LET h == HasBinding(s, e, name) IN
       IF IsAbrupt(h) THEN h
       ELSE IF Val(h) = True THEN Ok(h.s, Reference(EnvBase(e), Str(name), strict, Empty))
       ELSE GetIdentifierReference(h.s, E(h.s, e).outer, name, strict)
ResolveBinding(s, ctx, name, strict) == GetIdentifierReference(s, ctx.lex, name, strict)
\* GetThisEnvironment (§9.4.3).
GetThisEnvironment(s, e) ==
  IF HasThisBinding(s, e) THEN e ELSE GetThisEnvironment(s, E(s, e).outer)
ResolveThisBinding(s, ctx) == GetThisBinding(s, GetThisEnvironment(s, ctx.lex))
GetNewTarget(s, ctx) == E(s, GetThisEnvironment(s, ctx.lex)).newTarget
\* Reference Records (§6.2.5).
IsPropertyReference(ref) == ref.base.type \notin {"env", "unresolvable"}
IsUnresolvableReference(ref) == ref.base.type = "unresolvable"
GetThisValue(ref) == IF ref.this = Empty THEN ref.base ELSE ref.this
GetValue(s, v) ==
  IF v.type # "reference" THEN Ok(s, v)
  ELSE IF IsUnresolvableReference(v) THEN ThrowError(s, "ReferenceError")
  ELSE IF IsPropertyReference(v) THEN
    LET base == ToObject(s, v.base) IN
    IF IsAbrupt(base) THEN base
    ELSE IF v.name.type = "private" THEN PrivateGet(base.s, Val(base), v.name)
    ELSE LET k == IF IsPropertyKey(v.name) THEN Ok(base.s, v.name) ELSE ToPropertyKey(base.s, v.name) IN
         IF IsAbrupt(k) THEN k ELSE GetV(k.s, Val(base), Val(k), GetThisValue(v))
  ELSE GetBindingValue(s, v.base.env, v.name.value, v.strict)
\* Step 3.c of GetValue, which stores the property key it converts in the reference, for an
\* operator that puts a value to the reference after getting it. A nullish base throws first.
ToKeyedReference(s, v) ==
  IF v.type # "reference" \/ ~IsPropertyReference(v) \/ IsNullish(v.base) \/ v.name.type = "private" \/
     IsPropertyKey(v.name)
  THEN Ok(s, v)
  ELSE LET k == ToPropertyKey(s, v.name) IN IF IsAbrupt(k) THEN k ELSE Ok(k.s, [v EXCEPT !.name = Val(k)])
PutValue(s, v, w) ==
  IF v.type # "reference" THEN ThrowError(s, "ReferenceError")
  ELSE IF IsUnresolvableReference(v) THEN
    IF v.strict THEN ThrowError(s, "ReferenceError")
    ELSE LET g == E(s, s.globalEnv)
             r == Set(s, E(s, g.objRec).obj, v.name, w, FALSE)
         IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Empty)
  ELSE IF IsPropertyReference(v) THEN
    LET base == ToObject(s, v.base) IN
    IF IsAbrupt(base) THEN base
    ELSE IF v.name.type = "private" THEN PrivateSet(base.s, Val(base), v.name, w)
    ELSE LET k == IF IsPropertyKey(v.name) THEN Ok(base.s, v.name) ELSE ToPropertyKey(base.s, v.name) IN
    IF IsAbrupt(k) THEN k ELSE
    LET r == SetV(k.s, Val(base), Val(k), w, GetThisValue(v)) IN
    IF IsAbrupt(r) THEN r
    ELSE IF Val(r) = False /\ v.strict THEN ThrowTypeError(r.s)
    ELSE Ok(r.s, Empty)
  ELSE SetMutableBinding(s, v.base.env, v.name.value, w, v.strict)
InitializeReferencedBinding(s, v, w) == InitializeBinding(s, v.base.env, v.name.value, w)
\* Function objects (§10.2, §10.3, §10.4.1). An ECMAScript function object has class "function"
\* and slots:
\*   kind        "normal", "generator", "async", or "asyncGenerator"
\*   params      its formal parameters, a sequence of nodes
\*   body        the body node
\*   env, priv   the environment and private environment it closes over
\*   thisMode    "lexical", "strict", or "global"
\*   strict      whether its code is strict
\*   home        its [[HomeObject]], or Undefined
\*   ctorKind    "base" or "derived"
\*   classCtor   whether it is a class constructor
\*   constructor whether it has [[Construct]]
\*   fields, privateMethods, initializers, initializerName, sourceText
\* A built-in function object has class "builtin" and slots [id, constructor, data].
\* The execution context that evaluation passes down: the lexical, variable, and private
\* environments, the active function or Null, and the generator whose body runs or Null.
Context(lex, var, priv, fn) == [lex |-> lex, var |-> var, priv |-> priv, fn |-> fn, gen |-> Null]
WithLex(ctx, e) == [ctx EXCEPT !.lex = e]
FunctionSlots(kind, params, body, env, priv, thisMode, strict, sourceText, realm) ==
  [realm |-> realm, kind |-> kind, params |-> params, body |-> body, env |-> env, priv |-> priv,
   thisMode |-> thisMode, strict |-> strict, home |-> Undefined, ctorKind |-> "base",
   classCtor |-> FALSE, constructor |-> FALSE, fields |-> <<>>, privateMethods |-> <<>>, initializers |-> Empty,
   initializerName |-> Empty, sourceText |-> sourceText]
\* OrdinaryFunctionCreate (§10.2.3), returning [s, v].
OrdinaryFunctionCreate(s, proto, sourceText, params, body, isLexicalThis, env, priv) ==
  LET strict == body.strict
      thisMode == IF isLexicalThis THEN "lexical" ELSE IF strict THEN "strict" ELSE "global"
      kind == CASE body.type = "GeneratorBody" -> "generator"
                [] body.type = "AsyncGeneratorBody" -> "asyncGenerator"
                [] body.type \in {"AsyncBody", "AsyncConciseBody"} -> "async"
                [] OTHER -> "normal"
      o == PutProp(MakeObject(proto, "function",
                              FunctionSlots(kind, params, body, env, priv, thisMode, strict, sourceText, s.realmId)),
                   SV("length"), DataDesc(IntV(ExpectedArgumentCount(params)), FALSE, FALSE, TRUE))
  IN Alloc(s, o)
\* MakeConstructor (§10.2.5), with a prototype object or Empty to make one.
MakeConstructor(s, f, writable, prototype) ==
  LET s1 == SetO(s, f, [O(s, f) EXCEPT !.slots.constructor = TRUE])
      p == IF prototype = Empty
           THEN LET a == Alloc(s1, MakeObject(Intrinsic(s1, "ObjectPrototype"), "ordinary", [none |-> TRUE]))
                IN [s |-> SetO(a.s, a.v, PutProp(O(a.s, a.v), SV("constructor"), DataDesc(f, writable, FALSE, TRUE))),
                    v |-> a.v]
           ELSE [s |-> s1, v |-> prototype]
  IN SetO(p.s, f, PutProp(O(p.s, f), SV("prototype"), DataDesc(p.v, writable, FALSE, FALSE)))
MakeClassConstructor(s, f) == SetO(s, f, [O(s, f) EXCEPT !.slots.classCtor = TRUE])
MakeMethod(s, f, home) == SetO(s, f, [O(s, f) EXCEPT !.slots.home = home])
\* SetFunctionName (§10.2.9) with a prefix such as "get", or <<>> for none.
FunctionNameUnits(s, name) ==
  CASE name.type = "symbol" ->
         IF s.syms[name.id] = Undefined THEN <<>> ELSE <<91>> \o s.syms[name.id].value \o <<93>>
    [] name.type = "private" -> name.description
    [] OTHER -> name.value
SetFunctionName(s, f, name, prefix) ==
  LET units == FunctionNameUnits(s, name)
      full == IF prefix = <<>> THEN units ELSE prefix \o <<32>> \o units
  IN SetO(s, f, PutProp(O(s, f), SV("name"), DataDesc(Str(full), FALSE, FALSE, TRUE)))
SetFunctionLength(s, f, length) ==
  SetO(s, f, PutProp(O(s, f), SV("length"), DataDesc(IntV(length), FALSE, FALSE, TRUE)))
\* [[Call]] and [[Construct]] by class.
\* A built-in or ECMAScript function runs in its realm, and its caller's realm is current again
\* when it returns.
CallObject(s, f, this, args) ==
  LET o == O(s, f) IN
  CASE o.class = "builtin" -> InCallerRealm(s, CallBuiltin(EnterRealm(PushCaller(s, f, args), o.slots.realm), f, o.slots.id, this, args, Undefined))
    [] o.class = "bound" -> Call(s, o.slots.target, o.slots.this, o.slots.args \o args)
    [] o.class = "proxy" -> ProxyCall(s, f, this, args)
    [] o.class = "wrapped" -> InCallerRealm(s, OrdinaryWrappedFunctionCall(EnterRealm(s, o.slots.realm), f, this, args))
    [] OTHER -> InCallerRealm(s, OrdinaryCall(EnterRealm(PushCaller(s, f, args), o.slots.realm), f, this, args))
\* Returns to the caller's realm and active calls after a call that started in state caller.
InCallerRealm(caller, r) == [r EXCEPT !.s = [EnterRealm(r.s, caller.realmId) EXCEPT !.callers = caller.callers]]
\* The active calls of built-in and ECMAScript functions, innermost first, for the caller and
\* arguments properties of non-strict functions.
PushCaller(s, f, args) == [s EXCEPT !.callers = [f |-> f, args |-> args, next |-> s.callers]]
ConstructObject(s, f, args, newTarget) ==
  LET o == O(s, f) IN
  CASE o.class = "builtin" -> InCallerRealm(s, CallBuiltin(EnterRealm(PushCaller(s, f, args), o.slots.realm), f, o.slots.id, Undefined, args, newTarget))
    [] o.class = "bound" ->
         Construct(s, o.slots.target, o.slots.args \o args,
                   IF SameValue(f, newTarget) THEN o.slots.target ELSE newTarget)
    [] o.class = "proxy" -> ProxyConstruct(s, f, args, newTarget)
    [] OTHER -> InCallerRealm(s, OrdinaryConstruct(PushCaller(s, f, args), f, args, newTarget))
\* PrepareForOrdinaryCall (§10.2.1.1), returning [s, ctx].
PrepareForOrdinaryCall(s, f, newTarget) ==
  LET env == NewFunctionEnvironment(s, f, newTarget)
  IN [s |-> env.s, ctx |-> Context(env.e, env.e, O(s, f).slots.priv, f)]
\* OrdinaryCallBindThis (§10.2.1.2).
OrdinaryCallBindThis(s, f, ctx, this) ==
  LET mode == O(s, f).slots.thisMode IN
  IF mode = "lexical" THEN Ok(s, Undefined)
  ELSE IF mode = "strict" THEN BindThisValue(s, ctx.lex, this)
  ELSE IF IsNullish(this)
  THEN BindThisValue(s, ctx.lex, E(s, s.globalEnv).this)
  ELSE LET t == ToObject(s, this) IN
       IF IsAbrupt(t) THEN t ELSE BindThisValue(t.s, ctx.lex, Val(t))
\* [[Call]] of an ECMAScript function object (§10.2.1).
OrdinaryCall(s, f, this, args) == FreeEnvs(s.envs.size, TailCallFrom(OrdinaryCallRun(s, f, this, args), 0))
OrdinaryCallRun(s, f, this, args) ==
  IF O(s, f).slots.classCtor THEN ThrowTypeError(s)
  ELSE
    LET p == PrepareForOrdinaryCall(s, f, Undefined)
        b == OrdinaryCallBindThis(p.s, f, p.ctx, this)
    IN IF IsAbrupt(b) THEN b
       ELSE LET r == OrdinaryCallEvaluateBody(b.s, f, p.ctx, args) IN
       IF r.c.type = "return" THEN Ok(r.s, r.c.value)
       ELSE IF IsAbrupt(r) THEN r
       ELSE Ok(r.s, Undefined)
\* [[Construct]] of an ECMAScript function object (§10.2.2).
OrdinaryConstruct(s, f, args, newTarget) ==
  LET kind == O(s, f).slots.ctorKind
      this == IF kind = "base"
              THEN OrdinaryCreateFromConstructor(s, newTarget, "ObjectPrototype", "ordinary", [none |-> TRUE])
              ELSE Ok(s, Empty)
  IN IF IsAbrupt(this) THEN this ELSE
     LET p == PrepareForOrdinaryCall(EnterRealm(this.s, O(s, f).slots.realm), f, newTarget)
         b == IF kind = "base" THEN OrdinaryCallBindThis(p.s, f, p.ctx, Val(this)) ELSE Ok(p.s, Empty)
     IN IF IsAbrupt(b) THEN InCallerRealm(s, b) ELSE
        LET i == IF kind = "base" THEN InitializeInstanceElements(b.s, Val(this), f) ELSE Ok(b.s, Empty) IN
        IF IsAbrupt(i) THEN InCallerRealm(s, i) ELSE
        \* The steps after the body run in the caller's realm, as the callee's context is gone.
        LET r == InCallerRealm(s, TailCallReturn(OrdinaryCallEvaluateBody(i.s, f, p.ctx, args))) IN
        IF r.c.type = "return" THEN
          IF IsObject(r.c.value) THEN Ok(r.s, r.c.value)
          ELSE IF kind = "base" THEN Ok(r.s, Val(this))
          ELSE IF r.c.value # Undefined THEN ThrowTypeError(r.s)
          ELSE GetThisBinding(r.s, p.ctx.lex)
        ELSE IF IsAbrupt(r) THEN r
        ELSE IF kind = "base" THEN Ok(r.s, Val(this))
        ELSE GetThisBinding(r.s, p.ctx.lex)
\* The tail calls (§15.10.3) a call's body made in its place, while r is one, doubling the calls
\* each level of TailCallRun makes so that the depth of the evaluation grows only with their log.
TailCallStep(r) ==
  LET t == r.c.value
      s == IF r.s.callers = Null THEN r.s ELSE [r.s EXCEPT !.callers.f = t.f, !.callers.args = t.args]
  IN IF O(s, t.f).class = "function"
     THEN InCallerRealm(s, OrdinaryCallRun(EnterRealm(s, O(s, t.f).slots.realm), t.f, t.this, t.args))
     ELSE Call(s, t.f, t.this, t.args)
TailCallRun(r, k) == IF k = 0 THEN TailCallStep(r) ELSE TailCallRunThen(k, TailCallRun(r, k - 1))
TailCallRunThen(k, r) ==
  IF IsSuspended(r) THEN Pass(r, "TailCallRunThen", <<k>>) ELSE IF r.c.type = "tailcall" THEN TailCallRun(r, k - 1) ELSE r
TailCallFrom(r, k) == IF r.c.type = "tailcall" THEN TailCallFrom(TailCallRun(r, k), k + 1) ELSE r
\* A constructor body's tail call, as the return completion of its result.
TailCallReturn(r) ==
  IF r.c.type # "tailcall" THEN r ELSE
  LET v == TailCallFrom(r, 0) IN IF IsAbrupt(v) THEN v ELSE Abrupt(v.s, Completion("return", Val(v), Empty))
\* OrdinaryCallEvaluateBody (§10.2.1.4) and EvaluateBody (§10.2.1.3 and the bodies' rules).
OrdinaryCallEvaluateBody(s, f, ctx, args) ==
  LET fo == O(s, f)
      body == fo.slots.body
  IN CASE fo.slots.kind = "normal" ->
            LET i == FunctionDeclarationInstantiation(s, f, ctx, args) IN
            IF IsAbrupt(i) THEN i
            ELSE IF body.type = "FunctionBody" THEN EvaluateDisposing(i.s, Val(i), body.FunctionStatementList)
            ELSE IF body.type = "ClassFieldInitializer" THEN EvaluateFieldInitializer(i.s, Val(i), f, body)
            ELSE IF body.type = "ClassStaticBlockBody" THEN EvaluateDisposing(i.s, Val(i), body.ClassStaticBlockStatementList)
            ELSE LET e == EvaluateValue(i.s, Val(i), ConciseExpression(body)) IN
                 IF IsAbrupt(e) THEN e ELSE Abrupt(e.s, Completion("return", Val(e), Empty))
       [] fo.slots.kind = "generator" -> EvaluateGeneratorBody(s, f, ctx, args)
       [] fo.slots.kind = "async" -> EvaluateAsyncFunctionBody(s, f, ctx, args)
       [] fo.slots.kind = "asyncGenerator" -> EvaluateAsyncGeneratorBody(s, f, ctx, args)
ConciseExpression(body) ==
  IF body.type = "ExpressionBody" THEN body.AssignmentExpression
  ELSE IF "ExpressionBody" \in DOMAIN body THEN body.ExpressionBody.AssignmentExpression
  ELSE body.AsyncConciseBody
\* The statements a function body runs, for the instantiation algorithms.
BodyCode(body) ==
  CASE body.type \in {"FunctionBody", "GeneratorBody", "AsyncBody", "AsyncGeneratorBody"} -> body
    [] body.type = "ClassStaticBlockBody" -> body
    [] OTHER -> [type |-> "FunctionBody", FunctionStatementList |-> <<>>, mayUseArguments |-> TRUE, strict |-> body.strict]
\* FunctionDeclarationInstantiation (§10.2.11), returning the context the body runs in.
FunctionDeclarationInstantiation(s, f, ctx, args) ==
  LET fo == O(s, f)
      code == BodyCode(fo.slots.body)
      strict == fo.slots.strict
      formals == fo.slots.params
      parameterNames == BoundNamesList(formals)
      hasDuplicates == Cardinality(Range(parameterNames)) < Len(parameterNames)
      simple == IsSimpleParameterList(formals)
      hasExpressions == ContainsExpressionList(formals)
      varNames == VarDeclaredNames(code)
      varDeclarations == VarScopedDeclarations(code)
      lexicalNames == LexicallyDeclaredNames(code)
      functionsToInitialize == FunctionsToInitialize(varDeclarations)
      functionNames == MapSeq(functionsToInitialize, LAMBDA d : BoundNames(d)[1])
      \* code.mayUseArguments, which the parser adds, is FALSE when neither the parameters nor the
      \* body name arguments or call eval. No code can then reach the arguments object, and a heap
      \* that never frees would keep it.
      argumentsNeeded ==
        /\ fo.slots.thisMode # "lexical"
        /\ code.mayUseArguments
        /\ N("arguments") \notin Range(parameterNames)
        /\ (hasExpressions \/ (N("arguments") \notin Range(functionNames) /\
                                 N("arguments") \notin Range(lexicalNames)))
      \* Step 19: sloppy parameter expressions get their own environment, so the bindings a direct
      \* eval in them creates stay outside the one that holds the parameters.
      paramEnv == IF strict \/ ~hasExpressions THEN [s |-> s, e |-> ctx.lex] ELSE NewDeclarativeEnvironment(s, ctx.lex)
      env == paramEnv.e
      \* Step 20: parameter bindings.
      s1 == CreateBindings(paramEnv.s, env, parameterNames, strict, hasDuplicates)
      \* Step 22: the arguments object.
      a == IF ~argumentsNeeded THEN [s |-> s1, v |-> Empty]
           ELSE IF strict \/ ~simple THEN CreateUnmappedArgumentsObject(s1, args)
           ELSE CreateMappedArgumentsObject(s1, f, formals, args, env)
      s2 == IF ~argumentsNeeded THEN a.s
            ELSE LET cb == IF strict THEN CreateImmutableBinding(a.s, env, N("arguments"), FALSE)
                           ELSE CreateMutableBinding(a.s, env, N("arguments"), FALSE)
                 IN InitializeBinding(cb.s, env, N("arguments"), a.v).s
      parameterBindings == IF argumentsNeeded THEN Append(parameterNames, N("arguments")) ELSE parameterNames
      \* Steps 24-26: bind the parameters to the arguments.
      bound == IteratorBindingInitializationList(s2, [ctx EXCEPT !.lex = env], formals, ListIterator(args),
                                                 IF hasDuplicates THEN NoEnv ELSE env)
  IN IF IsAbrupt(bound) THEN bound ELSE
     LET s3 == bound.s
         \* Steps 27-28: var bindings, in a separate environment when parameters have expressions.
         varEnvResult ==
           IF ~hasExpressions
           THEN [s |-> CreateVarBindings(s3, env, SelectSeq(Dedupe(varNames), LAMBDA n : n \notin Range(parameterBindings)), env, FALSE, {}),
                 e |-> env]
           ELSE LET ve == NewDeclarativeEnvironment(s3, env)
                IN [s |-> CreateVarBindings(ve.s, ve.e, Dedupe(varNames), env,
                                            TRUE, Range(parameterBindings) \ Range(functionNames)),
                    e |-> ve.e]
         varEnv == varEnvResult.e
         \* Step 32.a (§B.3.2.1): sloppy code hoists block functions not named by a parameter. Earlier
         \* editions added "arguments" to the parameter names when the function needs an arguments
         \* object, so a block function named arguments is not hoisted. Test262 and engines keep that, and so
         \* does this, by checking the parameter bindings.
         hoisted == IF strict THEN <<>>
                    ELSE SelectSeq(HoistableFunctions(code), LAMBDA d : d.BindingIdentifier.name \notin Range(parameterBindings))
         hoistedNames == SelectSeq(Dedupe(MapSeq(hoisted, LAMBDA d : d.BindingIdentifier.name)),
                                   LAMBDA name : name \notin Range(varNames) \cup Range(parameterBindings) \cup {N("arguments")})
         hoistedBound == CreateVarBindings(varEnvResult.s, varEnv, hoistedNames, varEnv, FALSE, {})
         s4 == IF hoisted = <<>> THEN hoistedBound
               ELSE HoldEnvs([hoistedBound EXCEPT !.hoisted = @ \cup {<<varEnv, hoisted[i].site>> : i \in DOMAIN hoisted}])
         \* Steps 30-31: the lexical environment.
         lexEnvResult == IF ~strict THEN NewDeclarativeEnvironment(s4, varEnv) ELSE [s |-> s4, e |-> varEnv]
         lexEnv == lexEnvResult.e
         s5 == CreateLexicalBindings(lexEnvResult.s, lexEnv, LexicallyScopedDeclarations(code))
         bodyCtx == [ctx EXCEPT !.lex = lexEnv, !.var = varEnv]
         \* Step 36: initialize the functions.
         s6 == InitializeFunctions(s5, bodyCtx, varEnv, functionsToInitialize)
     IN Ok(s6, bodyCtx)
Dedupe(seq) ==
  IF seq = <<>> THEN <<>>
  ELSE LET rest == Dedupe(Tail(seq)) IN
       IF Head(seq) \in Range(rest) THEN <<Head(seq)>> \o Remove(rest, Head(seq)) ELSE <<Head(seq)>> \o rest
\* The function declarations among a body's var scoped declarations, the last of each name, in
\* the order of the last ones reversed, as step 15 of §10.2.11 lists them.
FunctionsToInitialize(decls) ==
  LET fns == SelectSeq(decls, LAMBDA d : d.type \in FunctionDeclarationTypes)
  IN PickLastFunctions(fns, Len(fns), {}, <<>>)
PickLastFunctions(fns, i, seen, acc) ==
  IF i = 0 THEN acc
  ELSE LET d == fns[i]
           name == BoundNames(d)[1]
       IN IF name \in seen THEN PickLastFunctions(fns, i - 1, seen, acc)
          ELSE PickLastFunctions(fns, i - 1, seen \cup {name}, <<d>> \o acc)
\* Step 20 of §10.2.11: a mutable binding for each parameter name, initialized to undefined
\* when the names repeat.
CreateBindings(s, env, names, strict, hasDuplicates) ==
  IF names = <<>> THEN s
  ELSE LET name == Head(names)
           s1 == IF name \in DOMAIN E(s, env).b THEN s
                 ELSE LET c == CreateMutableBinding(s, env, name, FALSE) IN
                      IF hasDuplicates THEN InitializeBinding(c.s, env, name, Undefined).s ELSE c.s
       IN CreateBindings(s1, env, Tail(names), strict, hasDuplicates)
\* Steps 27-28 of §10.2.11: var bindings initialized to undefined, or, when the parameters have
\* expressions, to the parameter's value for names in copied.
CreateVarBindings(s, varEnv, names, paramEnv, copy, copied) ==
  IF names = <<>> THEN s
  ELSE LET name == Head(names)
           c == CreateMutableBinding(s, varEnv, name, FALSE)
           init == IF copy /\ name \in copied THEN Val(GetBindingValue(c.s, paramEnv, name, FALSE)) ELSE Undefined
       IN CreateVarBindings(InitializeBinding(c.s, varEnv, name, init).s, varEnv, Tail(names),
                            paramEnv, copy, copied)
\* Step 34 of §10.2.11 and the like: uninitialized bindings for lexical declarations.
CreateLexicalBindings(s, env, decls) ==
  IF decls = <<>> THEN s
  ELSE LET d == Head(decls)
           names == BoundNames(d)
       IN CreateLexicalBindings(CreateLexicalNames(s, env, names, IsConstantDeclaration(d)), env, Tail(decls))
CreateLexicalNames(s, env, names, isConst) ==
  IF names = <<>> THEN s
  ELSE LET c == IF isConst THEN CreateImmutableBinding(s, env, Head(names), TRUE)
                ELSE CreateMutableBinding(s, env, Head(names), FALSE)
       IN CreateLexicalNames(c.s, env, Tail(names), isConst)
\* Step 36 of §10.2.11: each function declaration's object, bound in the var environment.
InitializeFunctions(s, ctx, varEnv, fns) ==
  IF fns = <<>> THEN s
  ELSE LET d == Head(fns)
           fo == InstantiateFunctionObject(s, ctx, d)
       IN InitializeFunctions(SetMutableBinding(fo.s, varEnv, BoundNames(d)[1], Val(fo), FALSE).s,
                              ctx, varEnv, Tail(fns))
\* A List iterator over arguments (CreateListIteratorRecord), which runs no user code.
ListIterator(list) == [kind |-> "list", list |-> list, done |-> FALSE]
\* CreateUnmappedArgumentsObject (§10.4.4.6), returning [s, v].
CreateUnmappedArgumentsObject(s, args) ==
  LET base == MakeObject(Intrinsic(s, "ObjectPrototype"), "ordinary", [argumentsData |-> TRUE])
      withLength == PutProp(base, SV("length"), DataDesc(IntV(Len(args)), TRUE, FALSE, TRUE))
      withArgs == AddIndexProps(withLength, args, 1)
      withIterator == PutProp(withArgs, SymIterator,
                              DataDesc(Intrinsic(s, "ArrayProto_values"), TRUE, FALSE, TRUE))
      throwerDesc == AccessorDesc(Intrinsic(s, "ThrowTypeError"), Intrinsic(s, "ThrowTypeError"), FALSE, FALSE)
      withCallee == PutProp(withIterator, SV("callee"), throwerDesc)
  IN Alloc(s, withCallee)
\* CreateMappedArgumentsObject (§10.4.4.7): an arguments exotic object whose slots map maps each
\* index key to the name of the parameter it aliases in env.
CreateMappedArgumentsObject(s, f, formals, args, env) ==
  LET names == BoundNamesList(formals)
      base == MakeObject(Intrinsic(s, "ObjectPrototype"), "arguments", [map |-> <<>>, env |-> env])
      withArgs == AddIndexProps(base, args, 1)
      withLength == PutProp(withArgs, SV("length"), DataDesc(IntV(Len(args)), TRUE, FALSE, TRUE))
      \* The last parameter of each name maps, for indices below the number of arguments.
      mapped == {i \in 1..Len(names) : i <= Len(args) /\ \A j \in (i + 1)..Len(names) : names[j] # names[i]}
      map == [k \in {Str(NumToString(NumFromInt(i - 1))) : i \in mapped} |->
                names[NumToSmallInt(StrToNum(k.value)) + 1]]
      withMap == [withLength EXCEPT !.slots.map = map]
      withIterator == PutProp(withMap, SymIterator,
                              DataDesc(Intrinsic(s, "ArrayProto_values"), TRUE, FALSE, TRUE))
      withCallee == PutProp(withIterator, SV("callee"), DataDesc(f, TRUE, FALSE, TRUE))
  IN Alloc(s, withCallee)
\* Arguments exotic objects (§10.4.4).
IsMapped(o, k) == k \in DOMAIN o.slots.map
ArgumentsGetOwnProperty(s, v, k) ==
  LET o == O(s, v)
      d == OrdinaryGetOwnProperty(o, k)
  IN IF d = Absent THEN Absent
     ELSE IF IsMapped(o, k)
     THEN [d EXCEPT !.value = E(s, o.slots.env).b[o.slots.map[k]].value]
     ELSE d
ArgumentsDefineOwnProperty(s, v, k, d) ==
  LET o == O(s, v)
      isMapped == IsMapped(o, k)
      newArgDesc ==
        IF isMapped /\ IsDataDescriptor(d) /\ d.value = Absent /\ d.writable = False
        THEN [d EXCEPT !.value = E(s, o.slots.env).b[o.slots.map[k]].value]
        ELSE d
      r == OrdinaryDefineOwnProperty(s, v, k, newArgDesc)
  IN IF Val(r) = False THEN r
     ELSE IF ~isMapped THEN r
     ELSE IF IsAccessorDescriptor(d)
     THEN Ok(SetO(r.s, v, [O(r.s, v) EXCEPT !.slots.map = [x \in DOMAIN @ \ {k} |-> @[x]]]), True)
     ELSE LET s1 == IF d.value # Absent
                    THEN SetE(r.s, o.slots.env, [E(r.s, o.slots.env) EXCEPT !.b[o.slots.map[k]].value = d.value])
                    ELSE r.s
          IN IF d.writable = False
             THEN Ok(SetO(s1, v, [O(s1, v) EXCEPT !.slots.map = [x \in DOMAIN @ \ {k} |-> @[x]]]), True)
             ELSE Ok(s1, True)
ArgumentsGet(s, v, k, receiver) ==
  LET o == O(s, v) IN
  IF IsMapped(o, k) /\ HasProp(o, k)
  THEN Ok(s, E(s, o.slots.env).b[o.slots.map[k]].value)
  ELSE OrdinaryGet(s, v, k, receiver)
ArgumentsSet(s, v, k, value, receiver) ==
  LET o == O(s, v)
      isMapped == SameValue(v, receiver) /\ IsMapped(o, k)
      s1 == IF isMapped
            THEN SetE(s, o.slots.env, [E(s, o.slots.env) EXCEPT !.b[o.slots.map[k]].value = value])
            ELSE s
  IN OrdinarySet(s1, v, k, value, receiver)
ArgumentsDelete(s, v, k) ==
  LET o == O(s, v)
      r == OrdinaryDelete(s, v, k)
  IN IF Val(r) = True /\ IsMapped(o, k)
     THEN Ok(SetO(r.s, v, [O(r.s, v) EXCEPT !.slots.map = [x \in DOMAIN @ \ {k} |-> @[x]]]), True)
     ELSE r
\* BoundFunctionCreate (§10.4.1.3).
BoundFunctionCreate(s, target, this, args) ==
  LET p == GetPrototypeOf(s, target) IN
  IF IsAbrupt(p) THEN p
  ELSE LET a == Alloc(p.s, MakeObject(Val(p), "bound",
                       [target |-> target, this |-> this, args |-> args,
                        constructor |-> IsConstructor(p.s, target)]))
       IN Ok(a.s, a.v)
\* CreateBuiltinFunction (§10.3.4) for a built-in identified by id, with length and name.
BuiltinObject(proto, id, length, name, isConstructor, data, realm) ==
  PutProp(PutProp(MakeObject(proto, "builtin", [id |-> id, constructor |-> isConstructor, data |-> data, realm |-> realm,
                                                initialName |-> name]),
                  SV("length"), DataDesc(IntV(length), FALSE, FALSE, TRUE)),
          SV("name"), DataDesc(Str(name), FALSE, FALSE, TRUE))
CreateBuiltinFunction(s, id, length, name, data) ==
  LET a == Alloc(s, BuiltinObject(Intrinsic(s, "FunctionPrototype"), id, length, name, FALSE, data, s.realmId))
  IN Ok(a.s, a.v)
\* Static semantics (§8) over engine262's parse nodes. A missing child is None, and a list of
\* nodes is a sequence. Names are sequences of code units.
Has(x) == x # None
List(x) == IF x = None THEN <<>> ELSE x
BoundNames(n) ==
  CASE n.type = "BindingIdentifier" -> <<n.name>>
    [] n.type \in {"LexicalDeclaration", "UsingDeclaration", "AwaitUsingDeclaration"} -> BoundNamesList(n.BindingList)
    [] n.type \in {"LexicalBinding", "VariableDeclaration", "ForBinding", "BindingRestElement"} ->
         IF Has(n.BindingIdentifier) THEN BoundNames(n.BindingIdentifier) ELSE BoundNames(n.BindingPattern)
    [] n.type = "VariableStatement" -> BoundNamesList(n.VariableDeclarationList)
    [] n.type = "ForDeclaration" -> BoundNames(n.ForBinding)
    [] n.type \in FunctionDeclarationTypes \cup {"ClassDeclaration"} ->
         IF Has(n.BindingIdentifier) THEN BoundNames(n.BindingIdentifier) ELSE <<N("*default*")>>
    [] n.type = "SingleNameBinding" -> BoundNames(n.BindingIdentifier)
    \* The ExportDeclaration that LexicallyScopedDeclarations gives for export default with an
    \* expression.
    [] n.type = "ExportDeclaration" -> <<N("*default*")>>
    [] n.type = "BindingRestProperty" -> BoundNames(n.BindingIdentifier)
    [] n.type = "BindingElement" -> BoundNames(n.BindingPattern)
    [] n.type = "BindingProperty" -> BoundNames(n.BindingElement)
    [] n.type = "ObjectBindingPattern" ->
         BoundNamesList(n.BindingPropertyList) \o
         (IF Has(n.BindingRestProperty) THEN BoundNames(n.BindingRestProperty) ELSE <<>>)
    [] n.type = "ArrayBindingPattern" ->
         BoundNamesList(n.BindingElementList) \o
         (IF Has(n.BindingRestElement) THEN BoundNames(n.BindingRestElement) ELSE <<>>)
    [] OTHER -> <<>>
BoundNamesList(list) == ConcatMap(List(list), BoundNames)
VarDeclaredNames(n) ==
  CASE n.type = "VariableStatement" -> BoundNamesList(n.VariableDeclarationList)
    [] n.type = "VariableDeclaration" -> BoundNames(n)
    [] n.type = "IfStatement" ->
         VarDeclaredNames(n.Statement_a) \o (IF Has(n.Statement_b) THEN VarDeclaredNames(n.Statement_b) ELSE <<>>)
    [] n.type = "Block" -> VarDeclaredNamesList(n.StatementList)
    [] n.type \in {"WhileStatement", "DoWhileStatement", "WithStatement"} -> VarDeclaredNames(n.Statement)
    [] n.type = "ForStatement" ->
         VarDeclaredNamesList(n.VariableDeclarationList) \o VarDeclaredNames(n.Statement)
    [] n.type \in {"ForInStatement", "ForOfStatement", "ForAwaitStatement"} ->
         (IF Has(n.ForBinding) THEN BoundNames(n.ForBinding) ELSE <<>>) \o VarDeclaredNames(n.Statement)
    [] n.type = "SwitchStatement" -> VarDeclaredNames(n.CaseBlock)
    [] n.type = "CaseBlock" ->
         VarDeclaredNamesList(n.CaseClauses_a) \o
         (IF Has(n.DefaultClause) THEN VarDeclaredNames(n.DefaultClause) ELSE <<>>) \o
         VarDeclaredNamesList(n.CaseClauses_b)
    [] n.type \in {"CaseClause", "DefaultClause"} -> VarDeclaredNamesList(n.StatementList)
    [] n.type = "LabelledStatement" -> VarDeclaredNames(n.LabelledItem)
    [] n.type = "TryStatement" ->
         VarDeclaredNames(n.Block) \o
         (IF Has(n.Catch) THEN VarDeclaredNames(n.Catch) ELSE <<>>) \o
         (IF Has(n.Finally) THEN VarDeclaredNames(n.Finally) ELSE <<>>)
    [] n.type = "Catch" -> VarDeclaredNames(n.Block)
    [] n.type = "Script" -> IF Has(n.ScriptBody) THEN VarDeclaredNames(n.ScriptBody) ELSE <<>>
    [] n.type = "ScriptBody" -> TopLevelVarDeclaredNamesList(n.StatementList)
    [] n.type \in {"FunctionBody", "GeneratorBody", "AsyncBody", "AsyncGeneratorBody"} ->
         TopLevelVarDeclaredNamesList(n.FunctionStatementList)
    [] n.type = "ClassStaticBlockBody" -> TopLevelVarDeclaredNamesList(n.ClassStaticBlockStatementList)
    [] n.type = "ExportDeclaration" ->
         IF Has(n.VariableStatement) THEN BoundNames(n.VariableStatement) ELSE <<>>
    [] OTHER -> <<>>
VarDeclaredNamesList(list) == ConcatMap(List(list), VarDeclaredNames)
TopLevelVarDeclaredNames(n) ==
  CASE n.type \in LexicalDeclarationTypes -> <<>>
    [] n.type \in FunctionDeclarationTypes -> BoundNames(n)
    [] n.type = "LabelledStatement" -> TopLevelVarDeclaredNames(n.LabelledItem)
    [] OTHER -> VarDeclaredNames(n)
TopLevelVarDeclaredNamesList(list) == ConcatMap(List(list), TopLevelVarDeclaredNames)
VarScopedDeclarations(n) ==
  CASE n.type = "VariableStatement" -> VarScopedDeclarationsList(n.VariableDeclarationList)
    [] n.type = "VariableDeclaration" -> <<n>>
    [] n.type = "Block" -> VarScopedDeclarationsList(n.StatementList)
    [] n.type = "IfStatement" ->
         VarScopedDeclarations(n.Statement_a) \o
         (IF Has(n.Statement_b) THEN VarScopedDeclarations(n.Statement_b) ELSE <<>>)
    [] n.type \in {"WhileStatement", "DoWhileStatement", "WithStatement"} -> VarScopedDeclarations(n.Statement)
    [] n.type = "ForStatement" ->
         VarScopedDeclarationsList(n.VariableDeclarationList) \o VarScopedDeclarations(n.Statement)
    [] n.type \in {"ForInStatement", "ForOfStatement", "ForAwaitStatement"} ->
         (IF Has(n.ForBinding) THEN <<n.ForBinding>> ELSE <<>>) \o VarScopedDeclarations(n.Statement)
    [] n.type = "SwitchStatement" -> VarScopedDeclarations(n.CaseBlock)
    [] n.type = "CaseBlock" ->
         VarScopedDeclarationsList(n.CaseClauses_a) \o
         (IF Has(n.DefaultClause) THEN VarScopedDeclarations(n.DefaultClause) ELSE <<>>) \o
         VarScopedDeclarationsList(n.CaseClauses_b)
    [] n.type \in {"CaseClause", "DefaultClause"} -> VarScopedDeclarationsList(n.StatementList)
    [] n.type = "LabelledStatement" -> VarScopedDeclarations(n.LabelledItem)
    [] n.type = "TryStatement" ->
         VarScopedDeclarations(n.Block) \o
         (IF Has(n.Catch) THEN VarScopedDeclarations(n.Catch) ELSE <<>>) \o
         (IF Has(n.Finally) THEN VarScopedDeclarations(n.Finally) ELSE <<>>)
    [] n.type = "Catch" -> VarScopedDeclarations(n.Block)
    [] n.type = "ExportDeclaration" ->
         IF Has(n.VariableStatement) THEN VarScopedDeclarations(n.VariableStatement) ELSE <<>>
    [] n.type = "Script" -> IF Has(n.ScriptBody) THEN VarScopedDeclarations(n.ScriptBody) ELSE <<>>
    [] n.type = "ScriptBody" -> TopLevelVarScopedDeclarationsList(n.StatementList)
    [] n.type = "Module" -> IF Has(n.ModuleBody) THEN VarScopedDeclarations(n.ModuleBody) ELSE <<>>
    [] n.type = "ModuleBody" -> VarScopedDeclarationsList(n.ModuleItemList)
    [] n.type \in {"FunctionBody", "GeneratorBody", "AsyncBody", "AsyncGeneratorBody"} ->
         TopLevelVarScopedDeclarationsList(n.FunctionStatementList)
    [] n.type = "ClassStaticBlockBody" -> TopLevelVarScopedDeclarationsList(n.ClassStaticBlockStatementList)
    [] OTHER -> <<>>
VarScopedDeclarationsList(list) == ConcatMap(List(list), VarScopedDeclarations)
\* §B.3.2: the FunctionDeclarations directly in a Block, CaseClause, or DefaultClause of a script or
\* function body that a var statement with their name could replace without an early error, so no
\* scope around them in the body declares the name lexically.
HoistableFunctions(code) ==
  LET list == CASE code.type = "Script" -> IF Has(code.ScriptBody) THEN List(code.ScriptBody.StatementList) ELSE <<>>
                [] OTHER -> List(code.FunctionStatementList)
      blocked == Range(LexicallyDeclaredNames(code))
  IN ConcatMap(list, LAMBDA item : HoistableIn(item, blocked))
\* The hoistable functions in statement n, around which the scopes declare the names blocked.
HoistableIn(n, blocked) ==
  CASE n.type = "Block" -> HoistableInList(List(n.StatementList), blocked)
    [] n.type = "IfStatement" ->
         HoistableIn(n.Statement_a, blocked) \o (IF Has(n.Statement_b) THEN HoistableIn(n.Statement_b, blocked) ELSE <<>>)
    [] n.type \in {"WhileStatement", "DoWhileStatement", "WithStatement"} -> HoistableIn(n.Statement, blocked)
    [] n.type = "LabelledStatement" -> HoistableIn(n.LabelledItem, blocked)
    [] n.type = "ForStatement" ->
         HoistableIn(n.Statement, IF Has(n.LexicalDeclaration) THEN blocked \cup Range(BoundNames(n.LexicalDeclaration)) ELSE blocked)
    [] n.type \in {"ForInStatement", "ForOfStatement", "ForAwaitStatement"} ->
         HoistableIn(n.Statement, IF Has(n.ForDeclaration) THEN blocked \cup Range(BoundNames(n.ForDeclaration)) ELSE blocked)
    [] n.type = "SwitchStatement" ->
         HoistableInList(ConcatMap(List(n.CaseBlock.CaseClauses_a) \o
                                   (IF Has(n.CaseBlock.DefaultClause) THEN <<n.CaseBlock.DefaultClause>> ELSE <<>>) \o
                                   List(n.CaseBlock.CaseClauses_b), LAMBDA clause : List(clause.StatementList)), blocked)
    [] n.type = "TryStatement" ->
         HoistableIn(n.Block, blocked) \o
         (IF Has(n.Catch) THEN HoistableIn(n.Catch, blocked) ELSE <<>>) \o
         (IF Has(n.Finally) THEN HoistableIn(n.Finally, blocked) ELSE <<>>)
    \* §B.3.4: a var may repeat a catch parameter that is a lone identifier.
    [] n.type = "Catch" ->
         HoistableIn(n.Block, IF Has(n.CatchParameter) /\ n.CatchParameter.type # "BindingIdentifier"
                              THEN blocked \cup Range(BoundNames(n.CatchParameter)) ELSE blocked)
    [] OTHER -> <<>>
\* The hoistable functions in a block's statements: those whose name nothing else in the block or
\* around it declares lexically, and those deeper in.
HoistableInList(items, blocked) ==
  LET names == ConcatMap(LexicallyScopedDeclarationsList(items), BoundNames)
  IN ConcatMap(items, LAMBDA item :
       IF item.type # "FunctionDeclaration" THEN HoistableIn(item, blocked \cup Range(names))
       ELSE IF item.BindingIdentifier.name \notin blocked /\
               Len(SelectSeq(names, LAMBDA name : name = item.BindingIdentifier.name)) = 1
       THEN <<item>> ELSE <<>>)
TopLevelVarScopedDeclarations(n) ==
  CASE n.type \in LexicalDeclarationTypes -> <<>>
    [] n.type \in FunctionDeclarationTypes -> <<n>>
    [] n.type = "LabelledStatement" -> TopLevelVarScopedDeclarations(n.LabelledItem)
    [] OTHER -> VarScopedDeclarations(n)
TopLevelVarScopedDeclarationsList(list) == ConcatMap(List(list), TopLevelVarScopedDeclarations)
LexicallyScopedDeclarations(n) ==
  CASE n.type = "LabelledStatement" -> LexicallyScopedDeclarations(n.LabelledItem)
    [] n.type = "Script" -> IF Has(n.ScriptBody) THEN LexicallyScopedDeclarations(n.ScriptBody) ELSE <<>>
    [] n.type = "ScriptBody" -> TopLevelLexicallyScopedDeclarationsList(n.StatementList)
    [] n.type = "Module" -> IF Has(n.ModuleBody) THEN LexicallyScopedDeclarations(n.ModuleBody) ELSE <<>>
    [] n.type = "ModuleBody" -> LexicallyScopedDeclarationsList(n.ModuleItemList)
    [] n.type \in {"FunctionBody", "GeneratorBody", "AsyncBody", "AsyncGeneratorBody"} ->
         TopLevelLexicallyScopedDeclarationsList(n.FunctionStatementList)
    [] n.type = "ClassStaticBlockBody" ->
         TopLevelLexicallyScopedDeclarationsList(n.ClassStaticBlockStatementList)
    [] n.type = "ImportDeclaration" -> <<>>
    [] n.type \in LexicalDeclarationTypes \cup FunctionDeclarationTypes -> <<n>>
    [] n.type = "CaseBlock" ->
         LexicallyScopedDeclarationsList(n.CaseClauses_a) \o
         (IF Has(n.DefaultClause) THEN LexicallyScopedDeclarations(n.DefaultClause) ELSE <<>>) \o
         LexicallyScopedDeclarationsList(n.CaseClauses_b)
    [] n.type \in {"CaseClause", "DefaultClause"} -> LexicallyScopedDeclarationsList(n.StatementList)
    [] n.type = "ExportDeclaration" ->
         CASE Has(n.Declaration) -> <<n.Declaration>>
           [] Has(n.HoistableDeclaration) -> <<n.HoistableDeclaration>>
           [] Has(n.ClassDeclaration) -> <<n.ClassDeclaration>>
           [] Has(n.AssignmentExpression) -> <<n>>
           [] OTHER -> <<>>
    [] OTHER -> <<>>
LexicallyScopedDeclarationsList(list) == ConcatMap(List(list), LexicallyScopedDeclarations)
TopLevelLexicallyScopedDeclarations(n) ==
  IF n.type \in LexicalDeclarationTypes THEN <<n>>
  ELSE IF n.type = "LabelledStatement" THEN <<>>
  ELSE <<>>
TopLevelLexicallyScopedDeclarationsList(list) == ConcatMap(List(list), TopLevelLexicallyScopedDeclarations)
TopLevelLexicallyDeclaredNames(n) == IF n.type \in LexicalDeclarationTypes THEN BoundNames(n) ELSE <<>>
TopLevelLexicallyDeclaredNamesList(list) == ConcatMap(List(list), TopLevelLexicallyDeclaredNames)
LexicallyDeclaredNames(n) ==
  CASE n.type = "Script" -> IF Has(n.ScriptBody) THEN LexicallyDeclaredNames(n.ScriptBody) ELSE <<>>
    [] n.type = "ScriptBody" -> TopLevelLexicallyDeclaredNamesList(n.StatementList)
    [] n.type \in {"FunctionBody", "GeneratorBody", "AsyncBody", "AsyncGeneratorBody"} ->
         TopLevelLexicallyDeclaredNamesList(n.FunctionStatementList)
    [] n.type = "ClassStaticBlockBody" -> TopLevelLexicallyDeclaredNamesList(n.ClassStaticBlockStatementList)
    [] OTHER -> <<>>
\* The lexically scoped declarations directly in a block or a case block.
BlockDeclarations(list) == LexicallyScopedDeclarationsList(list)
IsConstantDeclaration(n) ==
  (n.type = "LexicalDeclaration" /\ n.LetOrConst = "const") \/
  n.type \in {"UsingDeclaration", "AwaitUsingDeclaration"} \/
  (n.type = "ForDeclaration" /\ (n.production # "LetOrConst" \/ n.LetOrConst = "const"))
IsSimpleParameterList(list) ==
  \A i \in DOMAIN list : list[i].type = "SingleNameBinding" /\ ~Has(list[i].Initializer)
HasInitializer(n) == "Initializer" \in DOMAIN n /\ Has(n.Initializer)
ContainsExpression(n) ==
  CASE n.type = "SingleNameBinding" -> Has(n.Initializer)
    [] n.type = "BindingElement" -> ContainsExpression(n.BindingPattern) \/ Has(n.Initializer)
    [] n.type = "ObjectBindingPattern" ->
         ContainsExpressionList(n.BindingPropertyList) \/
         (Has(n.BindingRestProperty) /\ ContainsExpression(n.BindingRestProperty))
    [] n.type = "BindingProperty" ->
         (Has(n.PropertyName) /\ n.PropertyName.type = "PropertyName") \/
         ContainsExpression(n.BindingElement)
    [] n.type \in {"BindingRestProperty", "BindingRestElement"} ->
         ~Has(n.BindingIdentifier) /\ ContainsExpression(n.BindingPattern)
    [] n.type = "ArrayBindingPattern" ->
         ContainsExpressionList(n.BindingElementList) \/
         (Has(n.BindingRestElement) /\ ContainsExpression(n.BindingRestElement))
    [] OTHER -> FALSE
ContainsExpressionList(list) == \E i \in DOMAIN List(list) : ContainsExpression(list[i])
ExpectedArgumentCount(list) ==
  LET firstDefault == {i \in DOMAIN list : list[i].type = "BindingRestElement" \/ HasInitializer(list[i])}
  IN IF firstDefault = {} THEN Len(list) ELSE (CHOOSE i \in firstDefault : \A j \in firstDefault : i <= j) - 1
IsFunctionDefinition(n) ==
  IF n.type = "ParenthesizedExpression" THEN IsFunctionDefinition(n.Expression)
  ELSE n.type \in {"FunctionExpression", "GeneratorExpression", "AsyncGeneratorExpression",
                   "AsyncFunctionExpression", "ClassExpression", "ArrowFunction", "AsyncArrowFunction"}
HasName(n) ==
  IF n.type = "ParenthesizedExpression" THEN HasName(n.Expression)
  ELSE n.type \notin {"ArrowFunction", "AsyncArrowFunction"} /\ Has(n.BindingIdentifier)
IsAnonymousFunctionDefinition(n) == IsFunctionDefinition(n) /\ ~HasName(n)
IsIdentifierRef(n) == n.type = "IdentifierReference"
\* PropName (§8.6.5) of a property name node, or Empty when it is computed.
PropName(n) ==
  CASE n.type = "IdentifierName" -> n.name
    [] n.type = "StringLiteral" -> n.value
    [] n.type = "NumericLiteral" -> NumToString(n.value)
    [] OTHER -> Empty
\* Evaluation of expressions (§13). Evaluate returns a value or a Reference Record, and
\* EvaluateValue applies GetValue. Each step that waits on an evaluation is an operator whose name
\* ends in Then, so a yield or await inside can suspend and resume (see Suspend).
EvaluateValue(s, ctx, n) == GetValueThen(Evaluate(s, ctx, n))
GetValueThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "GetValueThen", <<>>) ELSE IF IsAbrupt(r) THEN r ELSE GetValue(r.s, Val(r))
Evaluate(s, ctx, n) ==
  CASE n.type = "NullLiteral" -> Ok(s, Null)
    [] n.type = "BooleanLiteral" -> Ok(s, Bool(n.value))
    [] n.type = "NumericLiteral" -> Ok(s, n.value)
    [] n.type = "StringLiteral" -> Ok(s, Str(n.value))
    [] n.type = "IdentifierReference" -> ResolveBinding(s, ctx, n.name, n.strict)
    [] n.type = "ThisExpression" -> ResolveThisBinding(s, ctx)
    [] n.type = "ParenthesizedExpression" -> Evaluate(s, ctx, n.Expression)
    [] n.type = "ArrayLiteral" -> EvaluateArrayLiteral(s, ctx, n)
    [] n.type = "ObjectLiteral" -> EvaluateObjectLiteral(s, ctx, n)
    [] n.type = "TemplateLiteral" -> TemplateConcat(s, ctx, n.TemplateCookedList, n.ExpressionList, n.TemplateCookedList[1])
    [] n.type = "RegularExpressionLiteral" -> RegExpCreateLiteral(s, n)
    [] n.type \in {"FunctionExpression", "GeneratorExpression", "AsyncFunctionExpression",
                   "AsyncGeneratorExpression"} -> InstantiateFunctionExpression(s, ctx, n, Empty)
    [] n.type \in {"ArrowFunction", "AsyncArrowFunction"} -> InstantiateArrowFunctionExpression(s, ctx, n, Empty)
    [] n.type = "ClassExpression" -> EvaluateClassExpression(s, ctx, n, Empty)
    [] n.type = "MemberExpression" -> MemberBaseThen(ctx, n, EvaluateValue(s, ctx, n.MemberExpression))
    [] n.type = "SuperProperty" -> EvaluateSuperProperty(s, ctx, n)
    [] n.type = "CallExpression" -> CallCalleeThen(ctx, n, Evaluate(s, ctx, n.CallExpression))
    [] n.type = "SuperCall" -> EvaluateSuperCall(s, ctx, n)
    [] n.type = "NewExpression" -> NewCalleeThen(ctx, n, EvaluateValue(s, ctx, n.MemberExpression))
    [] n.type = "OptionalExpression" -> OptionalBaseThen(ctx, n, Evaluate(s, ctx, n.MemberExpression))
    [] n.type = "TaggedTemplateExpression" -> EvaluateTaggedTemplate(s, ctx, n)
    [] n.type = "NewTarget" -> Ok(s, GetNewTarget(s, ctx))
    [] n.type = "ImportMeta" -> EvaluateImportMeta(s, ctx, n)
    [] n.type = "ImportCall" -> EvaluateImportCall(s, ctx, n)
    [] n.type = "UpdateExpression" ->
         UpdateThen(n, Evaluate(s, ctx, IF Has(n.LeftHandSideExpression) THEN n.LeftHandSideExpression ELSE n.UnaryExpression))
    [] n.type = "UnaryExpression" -> EvaluateUnaryExpression(s, ctx, n)
    [] n.type = "ExponentiationExpression" ->
         BinaryLeftThen(ctx, "**", n.ExponentiationExpression, EvaluateValue(s, ctx, n.UpdateExpression))
    [] n.type = "MultiplicativeExpression" ->
         BinaryLeftThen(ctx, n.MultiplicativeOperator, n.ExponentiationExpression,
                        EvaluateValue(s, ctx, n.MultiplicativeExpression))
    [] n.type = "AdditiveExpression" ->
         BinaryLeftThen(ctx, n.operator, n.MultiplicativeExpression, EvaluateValue(s, ctx, n.AdditiveExpression))
    [] n.type = "ShiftExpression" ->
         BinaryLeftThen(ctx, n.operator, n.AdditiveExpression, EvaluateValue(s, ctx, n.ShiftExpression))
    [] n.type \in {"BitwiseANDExpression", "BitwiseXORExpression", "BitwiseORExpression"} ->
         BinaryLeftThen(ctx, n.operator, n.B, EvaluateValue(s, ctx, n.A))
    [] n.type = "RelationalExpression" ->
         IF Has(n.PrivateIdentifier) THEN PrivateInThen(ctx, n, EvaluateValue(s, ctx, n.ShiftExpression))
         ELSE RelationalLeftThen(ctx, n, EvaluateValue(s, ctx, n.RelationalExpression))
    [] n.type = "EqualityExpression" -> EqualityLeftThen(ctx, n, EvaluateValue(s, ctx, n.EqualityExpression))
    [] n.type = "LogicalANDExpression" ->
         LogicalThen(ctx, "&&", n.BitwiseORExpression, EvaluateValue(s, ctx, n.LogicalANDExpression))
    [] n.type = "LogicalORExpression" ->
         LogicalThen(ctx, "||", n.LogicalANDExpression, EvaluateValue(s, ctx, n.LogicalORExpression))
    [] n.type = "CoalesceExpression" ->
         LogicalThen(ctx, "??", n.BitwiseORExpression, EvaluateValue(s, ctx, n.CoalesceExpressionHead))
    [] n.type = "ConditionalExpression" -> ConditionalThen(ctx, n, EvaluateValue(s, ctx, n.ShortCircuitExpression))
    [] n.type = "AssignmentExpression" -> EvaluateAssignment(s, ctx, n)
    [] n.type = "CommaOperator" ->
         CommaThen(ctx, Tail(n.ExpressionList), EvaluateValue(s, ctx, Head(n.ExpressionList)))
    [] n.type = "YieldExpression" -> EvaluateYield(s, ctx, n)
    [] n.type = "AwaitExpression" -> AwaitThen(EvaluateValue(s, ctx, n.UnaryExpression))
    [] OTHER -> EvaluateStatement(s, ctx, n)
\* Binary logical operators (§13.13.1) return the left value when it decides the result.
LogicalThen(ctx, op, right, r) ==
  IF IsSuspended(r) THEN Pass(r, "LogicalThen", <<ctx, op, right>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF (CASE op = "&&" -> ~ToBooleanValue(Val(r))
             [] op = "||" -> ToBooleanValue(Val(r))
             [] op = "??" -> ~IsNullish(Val(r)))
  THEN r
  ELSE EvaluateValue(r.s, ctx, right)
\* The conditional operator (§13.14.1).
ConditionalThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "ConditionalThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE EvaluateValue(r.s, ctx, IF ToBooleanValue(Val(r)) THEN n.AssignmentExpression_a ELSE n.AssignmentExpression_b)
\* The comma operator (§13.16.1), with the expressions left after the one r evaluated.
CommaThen(ctx, rest, r) ==
  IF IsSuspended(r) THEN Pass(r, "CommaThen", <<ctx, rest>>) ELSE
  IF IsAbrupt(r) \/ rest = <<>> THEN r ELSE CommaThen(ctx, Tail(rest), EvaluateValue(r.s, ctx, Head(rest)))
\* NamedEvaluation (§8.4.5) of an anonymous function definition, or plain evaluation.
EvaluateNamed(s, ctx, n, name) ==
  IF IsAnonymousFunctionDefinition(n) THEN NamedEvaluation(s, ctx, n, name)
  ELSE EvaluateValue(s, ctx, n)
NamedEvaluation(s, ctx, n, name) ==
  CASE n.type = "ParenthesizedExpression" -> NamedEvaluation(s, ctx, n.Expression, name)
    [] n.type \in {"FunctionExpression", "GeneratorExpression", "AsyncFunctionExpression",
                   "AsyncGeneratorExpression"} -> InstantiateFunctionExpression(s, ctx, n, name)
    [] n.type \in {"ArrowFunction", "AsyncArrowFunction"} -> InstantiateArrowFunctionExpression(s, ctx, n, name)
    [] n.type = "ClassExpression" -> EvaluateClassExpression(s, ctx, n, name)
\* Array initializers (§13.2.4).
EvaluateArrayLiteral(s, ctx, n) ==
  LET a == ArrayCreate(s, 0, Intrinsic(s, "ArrayPrototype")) IN
  ArrayLiteralThen(Val(a), ArrayAccumulation(a.s, ctx, Val(a), n.ElementList, 0))
ArrayLiteralThen(array, r) ==
  IF IsSuspended(r) THEN Pass(r, "ArrayLiteralThen", <<array>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE Ok(SetO(r.s, array, [O(r.s, array) EXCEPT !.props[NamedBucket][SV("length")].value = IntV(Val(r))]), array)
\* ArrayAccumulation (§13.2.4.1), returning the next index.
ArrayAccumulation(s, ctx, array, list, index) ==
  IF list = <<>> THEN Ok(s, index)
  ELSE LET e == Head(list) IN
  CASE e.type = "Elision" -> ArrayAccumulation(s, ctx, array, Tail(list), index + 1)
    [] e.type = "SpreadElement" ->
         ArraySpreadThen(ctx, array, Tail(list), index, EvaluateValue(s, ctx, e.AssignmentExpression))
    [] OTHER -> ArrayElementThen(ctx, array, Tail(list), index, EvaluateValue(s, ctx, e))
ArraySpreadThen(ctx, array, rest, index, r) ==
  IF IsSuspended(r) THEN Pass(r, "ArraySpreadThen", <<ctx, array, rest, index>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET it == GetIterator(r.s, Val(r), "sync") IN
  IF IsAbrupt(it) THEN it ELSE
  LET spread == SpreadIntoArray(it.s, array, Val(it), index) IN
  IF IsAbrupt(spread) THEN spread ELSE ArrayAccumulation(spread.s, ctx, array, rest, Val(spread))
ArrayElementThen(ctx, array, rest, index, r) ==
  IF IsSuspended(r) THEN Pass(r, "ArrayElementThen", <<ctx, array, rest, index>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET c == CreateDataPropertyOrThrow(r.s, array, Str(NumToString(NumFromInt(index))), Val(r)) IN
  IF IsAbrupt(c) THEN c ELSE ArrayAccumulation(c.s, ctx, array, rest, index + 1)
SpreadIntoArray(s, array, it, index) ==
  LET next == IteratorStepValue(s, it) IN
  IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN Ok(next.s, index)
  ELSE LET c == CreateDataPropertyOrThrow(next.s, array, Str(NumToString(NumFromInt(index))), Val(next).value) IN
       IF IsAbrupt(c) THEN c ELSE SpreadIntoArray(c.s, array, Val(next).iterator, index + 1)
\* Object initializers (§13.2.5).
EvaluateObjectLiteral(s, ctx, n) ==
  LET o == OrdinaryObjectCreate(s, Intrinsic(s, "ObjectPrototype")) IN
  ResultThen(Val(o), PropertyDefinitionEvaluationList(o.s, ctx, Val(o), n.PropertyDefinitionList))
\* Continues with v once r completes normally.
ResultThen(v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ResultThen", <<v>>) ELSE IF IsAbrupt(r) THEN r ELSE Ok(r.s, v)
PropertyDefinitionEvaluationList(s, ctx, obj, list) ==
  IF list = <<>> THEN Ok(s, Empty)
  ELSE PropertyListThen(ctx, obj, Tail(list), PropertyDefinitionEvaluation(s, ctx, obj, Head(list)))
PropertyListThen(ctx, obj, rest, r) ==
  IF IsSuspended(r) THEN Pass(r, "PropertyListThen", <<ctx, obj, rest>>) ELSE
  IF IsAbrupt(r) THEN r ELSE PropertyDefinitionEvaluationList(r.s, ctx, obj, rest)
\* The property key a property name node gives (§13.2.5.4 Evaluation of PropertyName).
EvaluatePropertyKey(s, ctx, n) ==
  CASE n.type = "IdentifierName" -> Ok(s, Str(n.name))
    [] n.type = "StringLiteral" -> Ok(s, Str(n.value))
    [] n.type = "NumericLiteral" -> Ok(s, Str(PrimitiveToUnits(n.value)))
    [] n.type = "PrivateIdentifier" -> Ok(s, ResolvePrivateIdentifier(s, ctx, n.name))
    [] n.type = "PropertyName" -> ToPropertyKeyThen(EvaluateValue(s, ctx, n.ComputedPropertyName))
ToPropertyKeyThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "ToPropertyKeyThen", <<>>) ELSE IF IsAbrupt(r) THEN r ELSE ToPropertyKey(r.s, Val(r))
PropertyDefinitionEvaluation(s, ctx, obj, n) ==
  CASE n.type = "IdentifierReference" -> CreateDataThen(obj, Str(n.name), EvaluateValue(s, ctx, n))
    [] n.type = "PropertyDefinition" /\ ~Has(n.PropertyName) ->
         CopyDataThen(obj, EvaluateValue(s, ctx, n.AssignmentExpression))
    [] n.type = "PropertyDefinition" -> PropertyKeyThen(ctx, obj, n, EvaluatePropertyKey(s, ctx, n.PropertyName))
    [] n.type = "CoverInitializedName" -> ThrowError(s, "SyntaxError")
    [] OTHER -> MethodDefinitionEvaluation(s, ctx, obj, n, TRUE)
CreateDataThen(obj, key, r) ==
  IF IsSuspended(r) THEN Pass(r, "CreateDataThen", <<obj, key>>) ELSE IF IsAbrupt(r) THEN r ELSE CreateDataPropertyOrThrow(r.s, obj, key, Val(r))
CopyDataThen(obj, r) ==
  IF IsSuspended(r) THEN Pass(r, "CopyDataThen", <<obj>>) ELSE IF IsAbrupt(r) THEN r ELSE CopyDataProperties(r.s, obj, Val(r), <<>>)
PropertyKeyThen(ctx, obj, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "PropertyKeyThen", <<ctx, obj, n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET isProto == n.PropertyName.type \in {"IdentifierName", "StringLiteral"} /\ PropName(n.PropertyName) = N("__proto__") IN
  IF isProto THEN ProtoSetterThen(obj, EvaluateValue(r.s, ctx, n.AssignmentExpression))
  ELSE CreateDataThen(obj, Val(r),
                      IF IsAnonymousFunctionDefinition(n.AssignmentExpression)
                      THEN NamedEvaluation(r.s, ctx, n.AssignmentExpression, Val(r))
                      ELSE EvaluateValue(r.s, ctx, n.AssignmentExpression))
ProtoSetterThen(obj, r) ==
  IF IsSuspended(r) THEN Pass(r, "ProtoSetterThen", <<obj>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF IsObject(Val(r)) \/ Val(r) = Null THEN LET p == SetPrototypeOf(r.s, obj, Val(r)) IN Ok(p.s, Empty)
  ELSE Ok(r.s, Empty)
\* CopyDataProperties (§7.3.25).
CopyDataProperties(s, target, source, excluded) ==
  IF IsNullish(source) THEN Ok(s, target)
  ELSE LET from == ToObject(s, source) IN
  IF IsAbrupt(from) THEN from ELSE
  LET ks == OwnPropertyKeys(from.s, Val(from)) IN
  IF IsAbrupt(ks) THEN ks ELSE CopyDataKeys(ks.s, target, Val(from), Val(ks), excluded)
CopyDataKeys(s, target, from, ks, excluded) ==
  IF ks = <<>> THEN Ok(s, target)
  ELSE LET k == Head(ks) IN
  IF \E i \in DOMAIN excluded : SameValue(excluded[i], k) THEN CopyDataKeys(s, target, from, Tail(ks), excluded)
  ELSE LET d == GetOwnProperty(s, from, k) IN
  IF IsAbrupt(d) THEN d
  ELSE IF Val(d) = Absent \/ Val(d).enumerable # True THEN CopyDataKeys(d.s, target, from, Tail(ks), excluded)
  ELSE LET v == Get(d.s, from, k) IN
  IF IsAbrupt(v) THEN v ELSE
  LET c == CreateDataPropertyOrThrow(v.s, target, k, Val(v)) IN
  IF IsAbrupt(c) THEN c ELSE CopyDataKeys(c.s, target, from, Tail(ks), excluded)
\* Template literals (§13.2.8): the cooked strings and expressions left, and the text so far.
TemplateConcat(s, ctx, strings, exprs, acc) ==
  IF exprs = <<>> THEN Ok(s, Str(acc))
  ELSE TemplateThen(ctx, strings, exprs, acc, EvaluateValue(s, ctx, Head(exprs)))
TemplateThen(ctx, strings, exprs, acc, r) ==
  IF IsSuspended(r) THEN Pass(r, "TemplateThen", <<ctx, strings, exprs, acc>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET t == ToStr(r.s, Val(r)) IN
  IF IsAbrupt(t) THEN t
  ELSE TemplateConcat(t.s, ctx, Tail(strings), Tail(exprs), acc \o Val(t).value \o strings[2])
\* Property accessors (§13.3.2).
MemberBaseThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "MemberBaseThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF Has(n.IdentifierName) THEN Ok(r.s, Reference(Val(r), Str(n.IdentifierName.name), n.strict, Empty))
  ELSE IF Has(n.PrivateIdentifier) THEN
    Ok(r.s, Reference(Val(r), ResolvePrivateIdentifier(r.s, ctx, n.PrivateIdentifier.name), TRUE, Empty))
  ELSE MemberKeyThen(Val(r), n.strict, EvaluateValue(r.s, ctx, n.Expression))
MemberKeyThen(base, strict, r) ==
  IF IsSuspended(r) THEN Pass(r, "MemberKeyThen", <<base, strict>>) ELSE IF IsAbrupt(r) THEN r ELSE Ok(r.s, Reference(base, Val(r), strict, Empty))
\* The super keyword (§13.3.7).
EvaluateSuperProperty(s, ctx, n) ==
  LET env == GetThisEnvironment(s, ctx.lex)
      actualThis == GetThisBinding(s, env)
  IN IF IsAbrupt(actualThis) THEN actualThis
     ELSE SuperKeyThen(env, Val(actualThis), n.strict,
                       IF Has(n.IdentifierName) THEN Ok(actualThis.s, Str(n.IdentifierName.name))
                       ELSE EvaluateValue(actualThis.s, ctx, n.Expression))
SuperKeyThen(env, actualThis, strict, r) ==
  IF IsSuspended(r) THEN Pass(r, "SuperKeyThen", <<env, actualThis, strict>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET base == GetSuperBase(r.s, env) IN
  IF IsAbrupt(base) THEN base ELSE Ok(base.s, Reference(Val(base), Val(r), strict, actualThis))
\* Function calls (§13.3.6), after evaluating the callee to the reference r.
CallCalleeThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "CallCalleeThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET f == GetValue(r.s, Val(r)) IN
  IF IsAbrupt(f) THEN f
     ELSE IF Val(r).type = "reference" /\ ~IsPropertyReference(Val(r)) /\ Val(r).name = SV("eval") /\
             SameValue(Val(f), Intrinsic(f.s, "eval"))
     THEN DirectEvalThen(ctx, n.strict, ArgumentListEvaluation(f.s, ctx, n.Arguments))
     ELSE EvaluateCall(f.s, ctx, Val(f), Val(r), n.Arguments, n.isTail)
DirectEvalThen(ctx, strict, r) ==
  IF IsSuspended(r) THEN Pass(r, "DirectEvalThen", <<ctx, strict>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r) = <<>> THEN Ok(r.s, Undefined)
  ELSE PerformEval(r.s, ctx, Val(r)[1], strict, TRUE)
\* EvaluateCall (§13.3.6.2).
EvaluateCall(s, ctx, f, ref, arguments, isTail) ==
  CallArgumentsThen(f, CallThisValue(s, ref), isTail, ArgumentListEvaluation(s, ctx, arguments))
\* Steps 1-2 of EvaluateCall: the this value of a call through ref.
CallThisValue(s, ref) ==
  IF ref.type # "reference" THEN Undefined
  ELSE IF IsPropertyReference(ref) THEN GetThisValue(ref)
  ELSE IF E(s, ref.base.env).kind = "object" /\ E(s, ref.base.env).withEnv THEN E(s, ref.base.env).obj
  ELSE Undefined
\* Step 6 of EvaluateCall: a call in tail position (§15.10) returns to the caller's [[Call]], which
\* makes it in place of the finished call, so tail calls run in constant space.
CallArgumentsThen(f, this, isTail, r) ==
  IF IsSuspended(r) THEN Pass(r, "CallArgumentsThen", <<f, this, isTail>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsCallable(r.s, f) THEN ThrowTypeError(r.s)
  ELSE IF isTail THEN Abrupt(r.s, Completion("tailcall", [f |-> f, this |-> this, args |-> Val(r)], Empty))
  ELSE Call(r.s, f, this, Val(r))
\* ArgumentListEvaluation (§13.3.8.1).
ArgumentListEvaluation(s, ctx, list) == ArgumentsAccumulate(s, ctx, list, <<>>)
ArgumentsAccumulate(s, ctx, list, acc) ==
  IF list = <<>> THEN Ok(s, acc)
  ELSE IF Head(list).type = "AssignmentRestElement"
  THEN ArgumentSpreadThen(ctx, Tail(list), acc, EvaluateValue(s, ctx, Head(list).AssignmentExpression))
  ELSE ArgumentThen(ctx, Tail(list), acc, EvaluateValue(s, ctx, Head(list)))
ArgumentSpreadThen(ctx, rest, acc, r) ==
  IF IsSuspended(r) THEN Pass(r, "ArgumentSpreadThen", <<ctx, rest, acc>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET it == GetIterator(r.s, Val(r), "sync") IN
  IF IsAbrupt(it) THEN it ELSE
  LET values == IteratorToList(it.s, Val(it), <<>>) IN
  IF IsAbrupt(values) THEN values ELSE ArgumentsAccumulate(values.s, ctx, rest, acc \o Val(values))
ArgumentThen(ctx, rest, acc, r) ==
  IF IsSuspended(r) THEN Pass(r, "ArgumentThen", <<ctx, rest, acc>>) ELSE
  IF IsAbrupt(r) THEN r ELSE ArgumentsAccumulate(r.s, ctx, rest, Append(acc, Val(r)))
\* Tagged templates (§13.3.11): the tag called with the template object and the substitutions.
EvaluateTaggedTemplate(s, ctx, n) == TagThen(ctx, n.TemplateLiteral, n.isTail, Evaluate(s, ctx, n.MemberExpression))
TagThen(ctx, template, isTail, r) ==
  IF IsSuspended(r) THEN Pass(r, "TagThen", <<ctx, template, isTail>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET f == GetValue(r.s, Val(r)) IN IF IsAbrupt(f) THEN f ELSE
  LET object == GetTemplateObject(f.s, <<TemplateParse(f.s, ctx.lex), template.site>>, template) IN
  CallArgumentsThen(Val(f), CallThisValue(object.s, Val(r)), isTail,
                    ArgumentsAccumulate(object.s, ctx, template.ExpressionList, <<Val(object)>>))
\* GetTemplateObject (§13.2.8.4): the frozen array of cooked strings with its frozen raw array, one
\* per template site, which the state's templates holds by key: the parse's number and the site's.
\* The host parses each eval source once, but each eval is a new parse, so its environment
\* numbers the parse for the code in it; the script's parse is 0.
TemplateParse(s, e) ==
  LET env == E(s, e) IN
  IF "parse" \in DOMAIN env THEN env.parse ELSE IF env.kind = "global" THEN 0 ELSE TemplateParse(s, env.outer)
GetTemplateObject(s, key, template) ==
  IF key \in DOMAIN s.templates THEN Ok(s, s.templates[key]) ELSE
  LET cooked == CreateArrayFromList(s, [i \in DOMAIN template.TemplateCookedList |->
                  IF template.TemplateCookedList[i] = None THEN Undefined ELSE Str(template.TemplateCookedList[i])])
      raw == CreateArrayFromList(cooked.s, [i \in DOMAIN template.TemplateRawList |-> Str(template.TemplateRawList[i])])
      rawFrozen == SetIntegrityLevel(raw.s, Val(raw), "frozen")
      withRaw == DefinePropertyOrThrow(rawFrozen.s, Val(cooked), SV("raw"), DataDesc(Val(raw), FALSE, FALSE, FALSE))
      frozen == SetIntegrityLevel(withRaw.s, Val(cooked), "frozen")
  IN Ok([frozen.s EXCEPT !.templates = (key :> Val(cooked)) @@ @], Val(cooked))
\* The new operator (§13.3.5).
NewCalleeThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "NewCalleeThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE NewArgumentsThen(Val(r), IF Has(n.Arguments) THEN ArgumentListEvaluation(r.s, ctx, n.Arguments) ELSE Ok(r.s, <<>>))
NewArgumentsThen(constructor, r) ==
  IF IsSuspended(r) THEN Pass(r, "NewArgumentsThen", <<constructor>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsConstructor(r.s, constructor) THEN ThrowTypeError(r.s)
  ELSE Construct(r.s, constructor, Val(r), constructor)
\* Optional chains (§13.3.9).
OptionalBaseThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "OptionalBaseThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET v == GetValue(r.s, Val(r)) IN
  IF IsAbrupt(v) THEN v
  ELSE IF IsNullish(Val(v)) THEN Ok(v.s, Undefined)
  ELSE ChainEvaluation(v.s, ctx, n.OptionalChain, Val(v), Val(r))
ChainEvaluation(s, ctx, chain, base, baseRef) ==
  IF Has(chain.OptionalChain)
  THEN ChainInnerThen(ctx, chain, ChainEvaluation(s, ctx, chain.OptionalChain, base, baseRef))
  ELSE ChainStep(s, ctx, chain, base, baseRef)
ChainInnerThen(ctx, chain, r) ==
  IF IsSuspended(r) THEN Pass(r, "ChainInnerThen", <<ctx, chain>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET v == GetValue(r.s, Val(r)) IN
  IF IsAbrupt(v) THEN v ELSE ChainStep(v.s, ctx, chain, Val(v), Val(r))
ChainStep(s, ctx, chain, value, ref) ==
  CASE "Arguments" \in DOMAIN chain /\ chain.Arguments # None -> EvaluateCall(s, ctx, value, ref, chain.Arguments, FALSE)
    [] "IdentifierName" \in DOMAIN chain /\ chain.IdentifierName # None ->
         Ok(s, Reference(value, Str(chain.IdentifierName.name), chain.strict, Empty))
    [] "PrivateIdentifier" \in DOMAIN chain /\ chain.PrivateIdentifier # None ->
         Ok(s, Reference(value, ResolvePrivateIdentifier(s, ctx, chain.PrivateIdentifier.name), TRUE, Empty))
    [] OTHER -> MemberKeyThen(value, chain.strict, EvaluateValue(s, ctx, chain.Expression))
\* Postfix and prefix increment and decrement (§13.4), after evaluating the target to r.
UpdateThen(n, r) ==
  IF IsSuspended(r) THEN Pass(r, "UpdateThen", <<n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  IF Val(r).type # "reference" THEN ThrowError(r.s, "ReferenceError") ELSE
  LET ref == ToKeyedReference(r.s, Val(r)) IN
  IF IsAbrupt(ref) THEN ref ELSE
  LET old == GetValue(ref.s, Val(ref)) IN
  IF IsAbrupt(old) THEN old ELSE
  LET num == ToNumeric(old.s, Val(old)) IN
  IF IsAbrupt(num) THEN num ELSE
  LET v == Val(num)
      new == IF IsNumber(v)
             THEN Num(IF n.operator = "++" THEN NumAdd(v.value, NumFromInt(1)) ELSE NumSub(v.value, NumFromInt(1)))
             ELSE BigInt(IF n.operator = "++" THEN BigIntAdd(v.value, BigIntFromInt(1)) ELSE BigIntSub(v.value, BigIntFromInt(1)))
      p == PutValue(num.s, Val(ref), new)
  IN IF IsAbrupt(p) THEN p ELSE Ok(p.s, IF Has(n.LeftHandSideExpression) THEN v ELSE new)
\* Unary operators (§13.5).
EvaluateUnaryExpression(s, ctx, n) ==
  CASE n.operator = "delete" -> DeleteThen(Evaluate(s, ctx, n.UnaryExpression))
    [] n.operator = "typeof" -> TypeofThen(Evaluate(s, ctx, n.UnaryExpression))
    [] OTHER -> UnaryThen(n.operator, EvaluateValue(s, ctx, n.UnaryExpression))
UnaryThen(op, r) ==
  IF IsSuspended(r) THEN Pass(r, "UnaryThen", <<op>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  CASE op = "void" -> Ok(r.s, Undefined)
    [] op = "!" -> Ok(r.s, Bool(~ToBooleanValue(Val(r))))
    [] op = "+" -> ToNumber(r.s, Val(r))
    [] OTHER ->
         LET num == ToNumeric(r.s, Val(r)) IN
         IF IsAbrupt(num) THEN num
         ELSE IF IsNumber(Val(num))
         THEN Ok(num.s, Num(IF op = "-" THEN NumNeg(Val(num).value) ELSE NumBitNot(Val(num).value)))
         ELSE Ok(num.s, BigInt(IF op = "-" THEN BigIntNeg(Val(num).value) ELSE BigIntBitNot(Val(num).value)))
\* The typeof operator (§13.5.3.1).
TypeofThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "TypeofThen", <<>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF Val(r).type = "reference" /\ IsUnresolvableReference(Val(r)) THEN Ok(r.s, SV("undefined"))
  ELSE LET v == GetValue(r.s, Val(r)) IN
       IF IsAbrupt(v) THEN v ELSE Ok(v.s, Str(TypeOf(v.s, Val(v))))
TypeOf(s, v) ==
  CASE v.type = "undefined" -> N("undefined")
    [] v.type = "null" -> N("object")
    [] v.type = "boolean" -> N("boolean")
    [] v.type = "number" -> N("number")
    [] v.type = "string" -> N("string")
    [] v.type = "symbol" -> N("symbol")
    [] v.type = "bigint" -> N("bigint")
    [] OTHER -> IF IsHTMLDDA(v) THEN N("undefined")
                ELSE IF IsCallable(s, v) THEN N("function") ELSE N("object")
\* The delete operator (§13.5.1.2).
DeleteThen(ref) ==
  IF IsSuspended(ref) THEN Pass(ref, "DeleteThen", <<>>) ELSE
  IF IsAbrupt(ref) THEN ref
  ELSE LET r == Val(ref) IN
  IF r.type # "reference" THEN Ok(ref.s, True)
  ELSE IF IsUnresolvableReference(r) THEN Ok(ref.s, True)
  ELSE IF IsPropertyReference(r) THEN
    IF r.this # Empty THEN ThrowError(ref.s, "ReferenceError")
    ELSE LET base == ToObject(ref.s, r.base) IN
    IF IsAbrupt(base) THEN base ELSE
    LET k == IF IsPropertyKey(r.name) THEN Ok(base.s, r.name) ELSE ToPropertyKey(base.s, r.name) IN
    IF IsAbrupt(k) THEN k ELSE
    LET d == Delete(k.s, Val(base), Val(k)) IN
    IF IsAbrupt(d) THEN d
    ELSE IF Val(d) = False /\ r.strict THEN ThrowTypeError(d.s)
    ELSE d
  ELSE DeleteBinding(ref.s, r.base.env, r.name.value)
\* Binary operators, after evaluating both operands (§13.15.3).
BinaryLeftThen(ctx, op, right, r) ==
  IF IsSuspended(r) THEN Pass(r, "BinaryLeftThen", <<ctx, op, right>>) ELSE
  IF IsAbrupt(r) THEN r ELSE BinaryRightThen(Val(r), op, EvaluateValue(r.s, ctx, right))
BinaryRightThen(lval, op, r) ==
  IF IsSuspended(r) THEN Pass(r, "BinaryRightThen", <<lval, op>>) ELSE
  IF IsAbrupt(r) THEN r ELSE ApplyStringOrNumericBinaryOperator(r.s, lval, op, Val(r))
ApplyStringOrNumericBinaryOperator(s, lval, op, rval) ==
  IF op = "+" THEN
    LET lp == ToPrimitive(s, lval, "none") IN
    IF IsAbrupt(lp) THEN lp ELSE
    LET rp == ToPrimitive(lp.s, rval, "none") IN
    IF IsAbrupt(rp) THEN rp ELSE
    IF IsString(Val(lp)) \/ IsString(Val(rp)) THEN
      LET ls == ToStr(rp.s, Val(lp)) IN
      IF IsAbrupt(ls) THEN ls ELSE
      LET rs == ToStr(ls.s, Val(rp)) IN
      IF IsAbrupt(rs) THEN rs ELSE Ok(rs.s, Str(Val(ls).value \o Val(rs).value))
    ELSE NumericBinary(rp.s, Val(lp), op, Val(rp))
  ELSE NumericBinary(s, lval, op, rval)
NumericBinary(s, lval, op, rval) ==
  LET ln == ToNumeric(s, lval) IN
  IF IsAbrupt(ln) THEN ln ELSE
  LET rn == ToNumeric(ln.s, rval) IN
  IF IsAbrupt(rn) THEN rn ELSE
  LET a == Val(ln)
      b == Val(rn)
  IN IF a.type # b.type THEN ThrowTypeError(rn.s)
     ELSE IF IsNumber(a) THEN Ok(rn.s, Num(NumberOperation(a.value, op, b.value)))
     ELSE BigIntOperationResult(rn.s, a.value, op, b.value)
NumberOperation(a, op, b) ==
  CASE op = "**" -> NumExp(a, b)
    [] op = "*" -> NumMul(a, b)
    [] op = "/" -> NumDiv(a, b)
    [] op = "%" -> NumRem(a, b)
    [] op = "+" -> NumAdd(a, b)
    [] op = "-" -> NumSub(a, b)
    [] op = "<<" -> NumShl(a, b)
    [] op = ">>" -> NumShr(a, b)
    [] op = ">>>" -> NumUShr(a, b)
    [] op = "&" -> NumAnd(a, b)
    [] op = "^" -> NumXor(a, b)
    [] op = "|" -> NumOr(a, b)
\* Relational operators (§13.10).
PrivateInThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "PrivateInThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE Ok(r.s, Bool(PrivateElementFind(r.s, Val(r), ResolvePrivateIdentifier(r.s, ctx, n.PrivateIdentifier.name)) # Empty))
RelationalLeftThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "RelationalLeftThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE RelationalRightThen(Val(r), n.operator, EvaluateValue(r.s, ctx, n.ShiftExpression))
RelationalRightThen(lv, op, r) ==
  IF IsSuspended(r) THEN Pass(r, "RelationalRightThen", <<lv, op>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET rv == Val(r)
      s1 == r.s
  IN CASE op = "<" ->
            LET c == IsLessThan(s1, lv, rv, TRUE) IN
            IF IsAbrupt(c) THEN c ELSE Ok(c.s, IF Val(c) = Undefined THEN False ELSE Val(c))
       [] op = ">" ->
            LET c == IsLessThan(s1, rv, lv, FALSE) IN
            IF IsAbrupt(c) THEN c ELSE Ok(c.s, IF Val(c) = Undefined THEN False ELSE Val(c))
       [] op = "<=" ->
            LET c == IsLessThan(s1, rv, lv, FALSE) IN
            IF IsAbrupt(c) THEN c ELSE Ok(c.s, Bool(Val(c) = False))
       [] op = ">=" ->
            LET c == IsLessThan(s1, lv, rv, TRUE) IN
            IF IsAbrupt(c) THEN c ELSE Ok(c.s, Bool(Val(c) = False))
       [] op = "instanceof" -> InstanceofOperator(s1, lv, rv)
       [] op = "in" ->
            IF ~IsObject(rv) THEN ThrowTypeError(s1)
            ELSE LET k == ToPropertyKey(s1, lv) IN
                 IF IsAbrupt(k) THEN k ELSE HasProperty(k.s, rv, Val(k))
\* InstanceofOperator (§13.10.2).
InstanceofOperator(s, v, target) ==
  IF ~IsObject(target) THEN ThrowTypeError(s)
  ELSE LET h == GetMethod(s, target, SymHasInstance) IN
  IF IsAbrupt(h) THEN h
  ELSE IF Val(h) # Undefined THEN
    LET r == Call(h.s, Val(h), target, <<v>>) IN
    IF IsAbrupt(r) THEN r ELSE Ok(r.s, ToBoolean(Val(r)))
  ELSE IF ~IsCallable(h.s, target) THEN ThrowTypeError(h.s)
  ELSE OrdinaryHasInstance(h.s, target, v)
\* Equality operators (§13.11).
EqualityLeftThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "EqualityLeftThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE EqualityRightThen(Val(r), n.operator, EvaluateValue(r.s, ctx, n.RelationalExpression))
EqualityRightThen(lv, op, r) ==
  IF IsSuspended(r) THEN Pass(r, "EqualityRightThen", <<lv, op>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  CASE op = "===" -> Ok(r.s, Bool(IsStrictlyEqual(lv, Val(r))))
    [] op = "!==" -> Ok(r.s, Bool(~IsStrictlyEqual(lv, Val(r))))
    [] op = "==" -> IsLooselyEqual(r.s, lv, Val(r))
    [] op = "!=" ->
         LET e == IsLooselyEqual(r.s, lv, Val(r)) IN
         IF IsAbrupt(e) THEN e ELSE Ok(e.s, Bool(Val(e) = False))
\* Assignment operators (§13.15.2).
EvaluateAssignment(s, ctx, n) ==
  IF n.AssignmentOperator = "=" /\ IsAssignmentPattern(n.LeftHandSideExpression)
  THEN DestructuringValueThen(ctx, n.LeftHandSideExpression, EvaluateValue(s, ctx, n.AssignmentExpression))
  ELSE AssignmentTargetThen(ctx, n, Evaluate(s, ctx, n.LeftHandSideExpression))
DestructuringValueThen(ctx, pattern, r) ==
  IF IsSuspended(r) THEN Pass(r, "DestructuringValueThen", <<ctx, pattern>>) ELSE
  IF IsAbrupt(r) THEN r ELSE ResultThen(Val(r), DestructuringAssignmentEvaluation(r.s, ctx, pattern, Val(r)))
\* The value of the right side, as NamedEvaluation gives it to an anonymous function assigned to a
\* name.
EvaluateAssigned(s, ctx, n) ==
  IF IsAnonymousFunctionDefinition(n.AssignmentExpression) /\ IsIdentifierRef(n.LeftHandSideExpression)
  THEN NamedEvaluation(s, ctx, n.AssignmentExpression, Str(n.LeftHandSideExpression.name))
  ELSE EvaluateValue(s, ctx, n.AssignmentExpression)
\* A call is a web-compat target (§13.15.1): it is evaluated, then throws before the right side runs.
AssignmentTargetThen(ctx, n, target) ==
  IF IsSuspended(target) THEN Pass(target, "AssignmentTargetThen", <<ctx, n>>) ELSE
  IF IsAbrupt(target) THEN target ELSE
  IF Val(target).type # "reference" THEN ThrowError(target.s, "ReferenceError") ELSE
  LET op == n.AssignmentOperator IN
  IF op = "=" THEN PutValueThen(Val(target), EvaluateAssigned(target.s, ctx, n)) ELSE
  LET ref == ToKeyedReference(target.s, Val(target)) IN
  IF IsAbrupt(ref) THEN ref ELSE
  LET old == GetValue(ref.s, Val(ref)) IN
  IF IsAbrupt(old) THEN old
  ELSE IF op \in {"&&=", "||=", "??="} THEN
    IF (CASE op = "&&=" -> ~ToBooleanValue(Val(old))
          [] op = "||=" -> ToBooleanValue(Val(old))
          [] op = "??=" -> ~IsNullish(Val(old)))
    THEN old
    ELSE PutValueThen(Val(ref), EvaluateAssigned(old.s, ctx, n))
  ELSE CompoundThen(Val(ref), Val(old), SubSeq(op, 1, Len(op) - 1), EvaluateValue(old.s, ctx, n.AssignmentExpression))
\* Assigns the value r gives to the reference, which is the assignment's value.
PutValueThen(ref, r) ==
  IF IsSuspended(r) THEN Pass(r, "PutValueThen", <<ref>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET p == PutValue(r.s, ref, Val(r)) IN
  IF IsAbrupt(p) THEN p ELSE Ok(p.s, Val(r))
CompoundThen(ref, old, op, r) ==
  IF IsSuspended(r) THEN Pass(r, "CompoundThen", <<ref, old, op>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET result == ApplyStringOrNumericBinaryOperator(r.s, old, op, Val(r)) IN
  IF IsAbrupt(result) THEN result ELSE PutValueThen(ref, result)
\* Evaluation of statements (§14). A statement's completion value may be Empty.
EvaluateStatementList(s, ctx, list) == StatementListFrom(s, ctx, List(list), Empty)
StatementListFrom(s, ctx, list, last) ==
  IF list = <<>> THEN Ok(s, last) ELSE StatementThen(ctx, Tail(list), last, EvaluateStatement(s, ctx, Head(list)))
StatementThen(ctx, rest, last, r) ==
  IF IsSuspended(r) THEN Pass(r, "StatementThen", <<ctx, rest, last>>) ELSE
  IF IsAbrupt(r) THEN Abrupt(r.s, UpdateEmpty(r.c, last))
  ELSE StatementListFrom(r.s, ctx, rest, IF Val(r) = Empty THEN last ELSE Val(r))
\* The completion r with an Empty value replaced by v.
UpdateEmptyThen(v, r) ==
  IF IsSuspended(r) THEN Pass(r, "UpdateEmptyThen", <<v>>) ELSE Abrupt(r.s, UpdateEmpty(r.c, v))
EvaluateStatement(s, ctx, n) ==
  CASE n.type = "ExpressionStatement" -> EvaluateValue(s, ctx, n.Expression)
    [] n.type = "VariableStatement" -> ResultThen(Empty, EvaluateVariableDeclarationList(s, ctx, n.VariableDeclarationList))
    [] n.type \in LexicalDeclarationTypes \ {"ClassDeclaration"} ->
         ResultThen(Empty, EvaluateBindingList(s, ctx, DeclarationKind(n), n.BindingList))
    [] n.type \in FunctionDeclarationTypes ->
         IF n.type = "FunctionDeclaration" /\ <<ctx.var, n.site>> \in s.hoisted
         THEN HoistedFunctionEvaluation(s, ctx, n.BindingIdentifier.name)
         ELSE Ok(s, Empty)
    [] n.type = "ClassDeclaration" -> ResultThen(Empty, BindingClassDeclarationEvaluation(s, ctx, n, DecoratorsOf(n)))
    [] n.type = "ImportDeclaration" -> Ok(s, Empty)
    [] n.type = "ExportDeclaration" -> EvaluateExportDeclaration(s, ctx, n)
    [] n.type \in {"EmptyStatement", "DebuggerStatement"} -> Ok(s, Empty)
    [] n.type = "Block" -> EvaluateBlock(s, ctx, n.StatementList)
    [] n.type = "IfStatement" -> IfThen(ctx, n, EvaluateValue(s, ctx, n.Expression))
    [] n.type \in BreakableStatementTypes \cup {"LabelledStatement"} -> LabelledEvaluation(s, ctx, n, {})
    [] n.type = "ContinueStatement" ->
         Abrupt(s, Completion("continue", Empty, IF Has(n.LabelIdentifier) THEN n.LabelIdentifier.name ELSE Empty))
    [] n.type = "BreakStatement" ->
         Abrupt(s, Completion("break", Empty, IF Has(n.LabelIdentifier) THEN n.LabelIdentifier.name ELSE Empty))
    [] n.type = "ReturnStatement" ->
         IF ~Has(n.Expression) THEN Abrupt(s, Completion("return", Undefined, Empty))
         ELSE ReturnThen(ctx, EvaluateValue(s, ctx, n.Expression))
    [] n.type = "ThrowStatement" -> ThrowThen(EvaluateValue(s, ctx, n.Expression))
    [] n.type = "WithStatement" -> WithThen(ctx, n, EvaluateValue(s, ctx, n.Expression))
    [] n.type = "TryStatement" -> TryBlockThen(ctx, n, EvaluateBlock(s, ctx, n.Block.StatementList))
    [] OTHER -> Evaluate(s, ctx, n)
\* §B.3.2.1: a block's function declaration that the instantiation of its var scope hoisted sets
\* the var binding to the block's function.
HoistedFunctionEvaluation(s, ctx, name) ==
  LET set == SetMutableBinding(s, ctx.var, name, Val(GetBindingValue(s, ctx.lex, name, FALSE)), FALSE) IN
  IF IsAbrupt(set) THEN set ELSE Ok(set.s, Empty)
\* The kind of the running function, or "script" outside any function.
FunctionKindOf(s, ctx) == IF ctx.fn = Null THEN "script" ELSE O(s, ctx.fn).slots.kind
\* The if statement (§14.6.2).
IfThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "IfThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ToBooleanValue(Val(r)) THEN UpdateEmptyThen(Undefined, EvaluateStatement(r.s, ctx, n.Statement_a))
  ELSE IF Has(n.Statement_b) THEN UpdateEmptyThen(Undefined, EvaluateStatement(r.s, ctx, n.Statement_b))
  ELSE Ok(r.s, Undefined)
\* The return statement (§14.10.1). An async generator awaits the value it returns.
ReturnThen(ctx, r) ==
  IF IsSuspended(r) THEN Pass(r, "ReturnThen", <<ctx>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF FunctionKindOf(r.s, ctx) = "asyncGenerator" THEN ReturnValueThen(Await(r.s, Val(r)))
  ELSE ReturnValueThen(r)
ReturnValueThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "ReturnValueThen", <<>>) ELSE IF IsAbrupt(r) THEN r ELSE Abrupt(r.s, Completion("return", Val(r), Empty))
ThrowThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "ThrowThen", <<>>) ELSE IF IsAbrupt(r) THEN r ELSE ThrowValue(r.s, Val(r))
\* The with statement (§14.11.2).
WithThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "WithThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET o == ToObject(r.s, Val(r)) IN
  IF IsAbrupt(o) THEN o ELSE
  LET env == NewObjectEnvironment(o.s, Val(o), TRUE, ctx.lex) IN
  UpdateEmptyThen(Undefined, EvaluateStatement(env.s, WithLex(ctx, env.e), n.Statement))
\* Variable statements (§14.3.2.1).
EvaluateVariableDeclarationList(s, ctx, list) ==
  IF list = <<>> THEN Ok(s, Empty)
  ELSE VariableListThen(ctx, Tail(list), VariableDeclaration(s, ctx, Head(list)))
VariableListThen(ctx, rest, r) ==
  IF IsSuspended(r) THEN Pass(r, "VariableListThen", <<ctx, rest>>) ELSE IF IsAbrupt(r) THEN r ELSE EvaluateVariableDeclarationList(r.s, ctx, rest)
VariableDeclaration(s, ctx, d) ==
  IF ~Has(d.Initializer) THEN Ok(s, Empty)
  ELSE IF Has(d.BindingIdentifier) THEN
    LET name == d.BindingIdentifier.name
        lhs == ResolveBinding(s, ctx, name, d.strict)
    IN IF IsAbrupt(lhs) THEN lhs ELSE PutValueThen(Val(lhs), EvaluateNamed(lhs.s, ctx, d.Initializer, Str(name)))
  ELSE PatternInitializerThen(ctx, d.BindingPattern, NoEnv, EvaluateValue(s, ctx, d.Initializer))
PatternInitializerThen(ctx, pattern, env, r) ==
  IF IsSuspended(r) THEN Pass(r, "PatternInitializerThen", <<ctx, pattern, env>>) ELSE
  IF IsAbrupt(r) THEN r ELSE BindingInitialization(r.s, ctx, pattern, Val(r), env)
\* Let, const, using, and await using declarations (§14.3.1.2), whose bindings add resources of
\* the kind.
EvaluateBindingList(s, ctx, kind, list) ==
  IF list = <<>> THEN Ok(s, Empty)
  ELSE BindingListThen(ctx, kind, Tail(list), LexicalBinding(s, ctx, kind, Head(list)))
BindingListThen(ctx, kind, rest, r) ==
  IF IsSuspended(r) THEN Pass(r, "BindingListThen", <<ctx, kind, rest>>) ELSE IF IsAbrupt(r) THEN r ELSE EvaluateBindingList(r.s, ctx, kind, rest)
LexicalBinding(s, ctx, kind, b) ==
  IF Has(b.BindingIdentifier) THEN
    LET name == b.BindingIdentifier.name
        lhs == ResolveBinding(s, ctx, name, b.strict)
    IN IF IsAbrupt(lhs) THEN lhs
       ELSE IF ~Has(b.Initializer) THEN InitializeReferencedBinding(lhs.s, Val(lhs), Undefined)
       ELSE InitializeThen(kind, Val(lhs), EvaluateNamed(lhs.s, ctx, b.Initializer, Str(name)))
  ELSE PatternInitializerThen(ctx, b.BindingPattern, ctx.lex, EvaluateValue(s, ctx, b.Initializer))
InitializeThen(kind, ref, r) ==
  IF IsSuspended(r) THEN Pass(r, "InitializeThen", <<kind, ref>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET added == AddDisposableResource(r.s, ref.base.env, Val(r), kind) IN
  IF IsAbrupt(added) THEN added ELSE InitializeReferencedBinding(added.s, ref, Val(r))
\* Blocks (§14.2.2).
EvaluateBlock(s, ctx, list) ==
  IF List(list) = <<>> THEN Ok(s, Empty)
  ELSE LET env == NewDeclarativeEnvironment(s, ctx.lex)
           blockCtx == WithLex(ctx, env.e)
       IN EvaluateDisposing(BlockDeclarationInstantiation(env.s, blockCtx, list, env.e), blockCtx, list)
\* BlockDeclarationInstantiation (§14.2.3) with the web-compatible function semantics of §B.3.2.6.
BlockDeclarationInstantiation(s, ctx, list, env) ==
  BlockDeclare(s, ctx, BlockDeclarations(list), env)
BlockDeclare(s, ctx, decls, env) ==
  IF decls = <<>> THEN s
  ELSE LET d == Head(decls)
           s1 == BlockBindNames(s, env, BoundNames(d), IsConstantDeclaration(d))
           s2 == IF d.type \in FunctionDeclarationTypes THEN
                   LET name == BoundNames(d)[1]
                       fo == InstantiateFunctionObject(s1, ctx, d)
                   IN IF E(fo.s, env).b[name].init
                      THEN SetMutableBinding(fo.s, env, name, Val(fo), FALSE).s
                      ELSE InitializeBinding(fo.s, env, name, Val(fo)).s
                 ELSE s1
       IN BlockDeclare(s2, ctx, Tail(decls), env)
BlockBindNames(s, env, names, isConst) ==
  IF names = <<>> THEN s
  ELSE LET name == Head(names)
           s1 == IF isConst THEN CreateImmutableBinding(s, env, name, TRUE).s
                 ELSE IF name \in DOMAIN E(s, env).b THEN s
                 ELSE CreateMutableBinding(s, env, name, FALSE).s
       IN BlockBindNames(s1, env, Tail(names), isConst)
\* LabelledEvaluation (§14.13.4, §14.7.1.2).
LabelledEvaluation(s, ctx, n, labels) ==
  IF n.type = "LabelledStatement" THEN
    LET label == n.LabelIdentifier.name
        item == n.LabelledItem
    IN LabelThen(label, IF item.type \in BreakableStatementTypes \cup {"LabelledStatement"}
                        THEN LabelledEvaluation(s, ctx, item, labels \cup {label})
                        ELSE EvaluateStatement(s, ctx, item))
  ELSE BreakTargetThen(IF n.type = "SwitchStatement" THEN SwitchThen(ctx, n.CaseBlock, EvaluateValue(s, ctx, n.Expression))
                       ELSE IterationEvaluation(s, ctx, n, labels))
LabelThen(label, r) ==
  IF IsSuspended(r) THEN Pass(r, "LabelThen", <<label>>) ELSE IF r.c.type = "break" /\ r.c.target = label THEN Ok(r.s, r.c.value) ELSE r
BreakTargetThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "BreakTargetThen", <<>>) ELSE
  IF r.c.type = "break" /\ r.c.target = Empty THEN Ok(r.s, IF r.c.value = Empty THEN Undefined ELSE r.c.value) ELSE r
\* LoopContinues (§14.7.1.1).
LoopContinues(c, labels) ==
  \/ c.type = "normal"
  \/ c.type = "continue" /\ (c.target = Empty \/ c.target \in labels)
NextIterationValue(c, v) == IF c.value # Empty THEN c.value ELSE v
\* The end of a loop iteration whose body completed with r: the completion the loop ends with,
\* or Empty to go on.
IterationEnd(r, labels, v) == IF LoopContinues(r.c, labels) THEN Empty ELSE Abrupt(r.s, UpdateEmpty(r.c, v))
IterationEvaluation(s, ctx, n, labels) ==
  CASE n.type = "DoWhileStatement" -> LoopFrom(s, ctx, [kind |-> "doWhile", n |-> n, labels |-> labels], Undefined, 0)
    [] n.type = "WhileStatement" -> LoopFrom(s, ctx, [kind |-> "while", n |-> n, labels |-> labels], Undefined, 0)
    [] n.type = "ForStatement" -> EvaluateFor(s, ctx, n, labels)
    [] n.type = "ForInStatement" ->
         LET init == ForInInitializer(s, ctx, n) IN
         IF IsAbrupt(init) THEN init ELSE ForInOf(init.s, ctx, n, n.Expression, "enumerate", "sync", labels)
    [] n.type = "ForOfStatement" -> ForInOf(s, ctx, n, n.AssignmentExpression, "iterate", "sync", labels)
    [] n.type = "ForAwaitStatement" -> ForInOf(s, ctx, n, n.AssignmentExpression, "async-iterate", "async", labels)
\* A loop runs one iteration at a time, and an iteration that goes on ends with an "iterate"
\* completion that carries the context and value of the next. LoopRun runs at most 2^k iterations
\* nested k deep, and LoopFrom runs 2^k more after each 2^k, so a loop of n iterations nests
\* about log n deep rather than n, and holds as few states.
Iterate(s, ctx, v) == [s |-> s, c |-> Completion("iterate", v, Empty), ctx |-> ctx]
LoopIteration(s, ctx, loop, v) ==
  CASE loop.kind = "while" -> WhileLoop(s, ctx, loop.n, loop.labels, v)
    [] loop.kind = "doWhile" -> DoWhileLoop(s, ctx, loop.n, loop.labels, v)
    [] loop.kind = "for" -> ForBodyLoop(s, ctx, loop, v)
    [] OTHER -> ForInOfBody(s, ctx, loop, loop.it, v)
LoopRun(s, ctx, loop, v, k) ==
  IF k = 0 THEN LoopIteration(s, ctx, loop, v) ELSE LoopRunThen(loop, k, LoopRun(s, ctx, loop, v, k - 1))
LoopRunThen(loop, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "LoopRunThen", <<loop, k>>) ELSE IF r.c.type = "iterate" THEN LoopRun(r.s, r.ctx, loop, Val(r), k - 1) ELSE r
LoopFrom(s, ctx, loop, v, k) == LoopFromThen(loop, k, LoopRun(s, ctx, loop, v, k))
LoopFromThen(loop, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "LoopFromThen", <<loop, k>>) ELSE IF r.c.type = "iterate" THEN LoopFrom(r.s, r.ctx, loop, Val(r), k + 1) ELSE r
\* The do-while statement (§14.7.2.2).
DoWhileLoop(s, ctx, n, labels, v) == DoWhileBodyThen(ctx, n, labels, v, EvaluateStatement(s, ctx, n.Statement))
DoWhileBodyThen(ctx, n, labels, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "DoWhileBodyThen", <<ctx, n, labels, v>>) ELSE
  IF IterationEnd(r, labels, v) # Empty THEN IterationEnd(r, labels, v)
  ELSE DoWhileTestThen(ctx, n, labels, NextIterationValue(r.c, v), EvaluateValue(r.s, ctx, n.Expression))
DoWhileTestThen(ctx, n, labels, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "DoWhileTestThen", <<ctx, n, labels, v>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, v)
  ELSE Iterate(r.s, ctx, v)
\* The while statement (§14.7.3.2).
WhileLoop(s, ctx, n, labels, v) == WhileTestThen(ctx, n, labels, v, EvaluateValue(s, ctx, n.Expression))
WhileTestThen(ctx, n, labels, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "WhileTestThen", <<ctx, n, labels, v>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, v)
  ELSE WhileBodyThen(ctx, n, labels, v, EvaluateStatement(r.s, ctx, n.Statement))
WhileBodyThen(ctx, n, labels, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "WhileBodyThen", <<ctx, n, labels, v>>) ELSE
  IF IterationEnd(r, labels, v) # Empty THEN IterationEnd(r, labels, v)
  ELSE Iterate(r.s, ctx, NextIterationValue(r.c, v))
\* The for statement (§14.7.4.2). engine262 names the test and increment Expression_a and
\* Expression_b when the statement declares variables. A loop is [test, increment, stmt, lets,
\* labels], with lets the names each iteration copies.
EvaluateFor(s, ctx, n, labels) ==
  IF Has(n.LexicalDeclaration) THEN
    LET decl == n.LexicalDeclaration
        isConst == IsConstantDeclaration(decl)
        names == BoundNames(decl)
        env == NewDeclarativeEnvironment(s, ctx.lex)
        loopCtx == WithLex(ctx, env.e)
        r == ForDeclarationThen(loopCtx,
                                [kind |-> "for", test |-> n.Expression_a, increment |-> n.Expression_b, stmt |-> n.Statement,
                                 lets |-> IF isConst THEN <<>> ELSE names, labels |-> labels],
                                EvaluateStatement(BlockBindNames(env.s, env.e, names, isConst), loopCtx, decl))
    IN IF DeclarationKind(decl) = "normal" THEN r ELSE DisposeThen(env.e, r)
  ELSE IF Has(n.VariableDeclarationList) THEN
    ForDeclarationThen(ctx, [kind |-> "for", test |-> n.Expression_a, increment |-> n.Expression_b, stmt |-> n.Statement,
                             lets |-> <<>>, labels |-> labels],
                       EvaluateVariableDeclarationList(s, ctx, n.VariableDeclarationList))
  ELSE
    ForDeclarationThen(ctx, [kind |-> "for", test |-> n.Expression_b, increment |-> n.Expression_c, stmt |-> n.Statement,
                             lets |-> <<>>, labels |-> labels],
                       IF Has(n.Expression_a) THEN EvaluateValue(s, ctx, n.Expression_a) ELSE Ok(s, Empty))
ForDeclarationThen(ctx, loop, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForDeclarationThen", <<ctx, loop>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET p == CreatePerIterationEnvironment(r.s, ctx, loop.lets) IN
  IF IsAbrupt(p) THEN p ELSE LoopFrom(p.s, Val(p), loop, Undefined, 0)
\* ForBodyEvaluation (§14.7.4.3).
ForBodyLoop(s, ctx, loop, v) ==
  ForTestThen(ctx, loop, v, IF Has(loop.test) THEN EvaluateValue(s, ctx, loop.test) ELSE Ok(s, True))
ForTestThen(ctx, loop, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForTestThen", <<ctx, loop, v>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, v)
  ELSE ForBodyThen(ctx, loop, v, EvaluateStatement(r.s, ctx, loop.stmt))
ForBodyThen(ctx, loop, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForBodyThen", <<ctx, loop, v>>) ELSE
  IF IterationEnd(r, loop.labels, v) # Empty THEN IterationEnd(r, loop.labels, v) ELSE
  LET p == CreatePerIterationEnvironment(r.s, ctx, loop.lets) IN
  IF IsAbrupt(p) THEN p
  ELSE ForIncrementThen(Val(p), loop, NextIterationValue(r.c, v),
                        IF Has(loop.increment) THEN EvaluateValue(p.s, Val(p), loop.increment) ELSE Ok(p.s, Empty))
ForIncrementThen(ctx, loop, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForIncrementThen", <<ctx, loop, v>>) ELSE IF IsAbrupt(r) THEN r ELSE Iterate(r.s, ctx, v)
\* CreatePerIterationEnvironment (§14.7.4.4), returning the context for the next iteration.
CreatePerIterationEnvironment(s, ctx, lets) ==
  IF lets = <<>> THEN Ok(s, ctx)
  ELSE LET last == ctx.lex
           env == NewDeclarativeEnvironment(s, E(s, last).outer)
       IN CopyPerIterationBindings(env.s, ctx, last, env.e, lets)
CopyPerIterationBindings(s, ctx, last, env, lets) ==
  IF lets = <<>> THEN Ok(s, WithLex(ctx, env))
  ELSE LET name == Head(lets)
           v == GetBindingValue(s, last, name, TRUE)
       IN IF IsAbrupt(v) THEN v
          ELSE LET c == CreateMutableBinding(v.s, env, name, FALSE) IN
               CopyPerIterationBindings(InitializeBinding(c.s, env, name, Val(v)).s, ctx, last, env, Tail(lets))
\* In sloppy code, for (var x = init in ...) puts init's value in x before the head runs (§B.3.5).
ForInInitializer(s, ctx, n) ==
  IF Has(n.ForBinding) /\ "Initializer" \in DOMAIN n.ForBinding /\ Has(n.ForBinding.Initializer) THEN
    LET name == n.ForBinding.BindingIdentifier.name
        init == n.ForBinding.Initializer
        lhs == ResolveBinding(s, ctx, name, n.ForBinding.strict)
    IN IF IsAbrupt(lhs) THEN lhs
       ELSE PutValueThen(Val(lhs), IF IsAnonymousFunctionDefinition(init) THEN NamedEvaluation(lhs.s, ctx, init, Str(name))
                                   ELSE EvaluateValue(lhs.s, ctx, init))
  ELSE Ok(s, Empty)
\* The left side of a for-in, for-of, or for-await statement and how it binds.
ForLhs(n) ==
  CASE Has(n.LeftHandSideExpression) -> [node |-> n.LeftHandSideExpression, kind |-> "assignment"]
    [] Has(n.ForBinding) -> [node |-> n.ForBinding, kind |-> "varBinding"]
    [] OTHER -> [node |-> n.ForDeclaration, kind |-> "lexicalBinding"]
\* ForIn/OfHeadEvaluation (§14.7.5.6) followed by ForIn/OfBodyEvaluation (§14.7.5.7). A loop is
\* [lhs, stmt, iterationKind, iteratorKind, labels].
ForInOf(s, ctx, n, expr, iterationKind, iteratorKind, labels) ==
  LET lhs == ForLhs(n)
      tdz == IF lhs.kind = "lexicalBinding" THEN BoundNames(lhs.node) ELSE <<>>
      headEnv == IF tdz = <<>> THEN [s |-> s, e |-> ctx.lex]
                 ELSE LET env == NewDeclarativeEnvironment(s, ctx.lex)
                      IN [s |-> BlockBindNames(env.s, env.e, tdz, FALSE), e |-> env.e]
  IN ForInOfHeadThen(ctx, [kind |-> "forInOf", it |-> Empty, lhs |-> lhs, stmt |-> n.Statement, iterationKind |-> iterationKind,
                           iteratorKind |-> iteratorKind, labels |-> labels],
                     EvaluateValue(headEnv.s, WithLex(ctx, headEnv.e), expr))
ForInOfHeadThen(ctx, loop, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForInOfHeadThen", <<ctx, loop>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF loop.iterationKind = "enumerate" THEN
    IF IsNullish(Val(r)) THEN Ok(r.s, Undefined)
    ELSE LET o == ToObject(r.s, Val(r))
             it == CreateForInIterator(o.s, Val(o))
         IN LoopFrom(it.s, ctx, [loop EXCEPT !.it = Val(it)], Undefined, 0)
  ELSE LET it == GetIterator(r.s, Val(r), IF loop.iterationKind = "async-iterate" THEN "async" ELSE "sync") IN
       IF IsAbrupt(it) THEN it ELSE LoopFrom(it.s, ctx, [loop EXCEPT !.it = Val(it)], Undefined, 0)
ForInOfBody(s, ctx, loop, it, v) ==
  LET called == Call(s, it.next, it.iterator, <<>>) IN
  ForInOfNextThen(ctx, loop, it, v,
                  IF IsAbrupt(called) \/ loop.iteratorKind = "sync" THEN called ELSE Await(called.s, Val(called)))
ForInOfNextThen(ctx, loop, it, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForInOfNextThen", <<ctx, loop, it, v>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE LET done == IteratorComplete(r.s, Val(r)) IN
  IF IsAbrupt(done) THEN done
  ELSE IF Val(done) THEN Ok(done.s, v)
  ELSE LET value == Get(done.s, Val(r), SV("value")) IN
  IF IsAbrupt(value) THEN value
  ELSE ForInOfBindThen(ctx, loop, it, v, ForInOfBind(value.s, ctx, loop.lhs, Val(value)))
ForInOfBindThen(ctx, loop, it, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForInOfBindThen", <<ctx, loop, it, v>>) ELSE
  IF IsAbrupt(r) THEN ForInOfClose(loop, it, r) ELSE
  LET body == EvaluateStatement(r.s, Val(r), loop.stmt) IN
  ForInOfStatementThen(ctx, loop, it, v,
                       IF loop.lhs.kind = "lexicalBinding" /\ DeclarationKind(loop.lhs.node) # "normal"
                       THEN DisposeThen(Val(r).lex, body) ELSE body)
ForInOfStatementThen(ctx, loop, it, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "ForInOfStatementThen", <<ctx, loop, it, v>>) ELSE
  IF IterationEnd(r, loop.labels, v) # Empty THEN ForInOfClose(loop, it, IterationEnd(r, loop.labels, v))
  ELSE Iterate(r.s, ctx, NextIterationValue(r.c, v))
ForInOfClose(loop, it, r) ==
  CASE loop.iterationKind = "enumerate" -> r
    [] loop.iteratorKind = "async" -> AsyncIteratorClose(r.s, it, r.c)
    [] OTHER -> IteratorClose(r.s, it, r.c)
\* Binds one value to the left side of a for-in or for-of statement, returning the context the
\* body runs in.
ForInOfBind(s, ctx, lhs, value) ==
  LET node == lhs.node IN
  CASE lhs.kind = "assignment" ->
         ResultThen(ctx, IF IsAssignmentPattern(node) THEN DestructuringAssignmentEvaluation(s, ctx, node, value)
                         ELSE AssignToThen(value, Evaluate(s, ctx, node)))
    [] lhs.kind = "varBinding" ->
         ResultThen(ctx, IF Has(node.BindingPattern) THEN BindingInitialization(s, ctx, node.BindingPattern, value, NoEnv)
                         ELSE AssignToThen(value, ResolveBinding(s, ctx, node.BindingIdentifier.name, node.strict)))
    [] OTHER ->
         LET env == NewDeclarativeEnvironment(s, ctx.lex)
             iterCtx == WithLex(ctx, env.e)
             s1 == BlockBindNames(env.s, env.e, BoundNames(node), IsConstantDeclaration(node))
             binding == node.ForBinding
             added == AddDisposableResource(s1, env.e, value, DeclarationKind(node))
         IN ResultThen(iterCtx, CASE Has(binding.BindingPattern) ->
                                       BindingInitialization(s1, iterCtx, binding.BindingPattern, value, env.e)
                                  [] IsAbrupt(added) -> added
                                  [] OTHER -> InitializeBinding(added.s, env.e, binding.BindingIdentifier.name, value))
AssignToThen(value, r) ==
  IF IsSuspended(r) THEN Pass(r, "AssignToThen", <<value>>) ELSE IF IsAbrupt(r) THEN r ELSE PutValue(r.s, Val(r), value)
\* The switch statement (§14.12).
SwitchThen(ctx, block, r) ==
  IF IsSuspended(r) THEN Pass(r, "SwitchThen", <<ctx, block>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET env == NewDeclarativeEnvironment(r.s, ctx.lex)
      blockCtx == WithLex(ctx, env.e)
      s1 == BlockDeclare(env.s, blockCtx, LexicallyScopedDeclarations(block), env.e)
  IN CaseSearch(s1, blockCtx, [block |-> block, input |-> Val(r), inB |-> FALSE], List(block.CaseClauses_a), Undefined)
\* CaseBlockEvaluation (§14.12.2): searches the clauses before the default clause, then those
\* after it (inB), for one whose selector equals the input. From the clause that matches, or the
\* default clause when none does, it runs every clause in source order.
CaseSearch(s, ctx, switch, clauses, v) ==
  IF clauses # <<>> THEN CaseSelectorThen(ctx, switch, clauses, v, EvaluateValue(s, ctx, Head(clauses).Expression))
  ELSE IF ~Has(switch.block.DefaultClause) THEN Ok(s, v)
  ELSE IF ~switch.inB THEN CaseSearch(s, ctx, [switch EXCEPT !.inB = TRUE], List(switch.block.CaseClauses_b), v)
  ELSE CaseRun(s, ctx, <<switch.block.DefaultClause>> \o List(switch.block.CaseClauses_b), v)
CaseSelectorThen(ctx, switch, clauses, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "CaseSelectorThen", <<ctx, switch, clauses, v>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsStrictlyEqual(switch.input, Val(r)) THEN CaseSearch(r.s, ctx, switch, Tail(clauses), v)
  ELSE IF switch.inB \/ ~Has(switch.block.DefaultClause) THEN CaseRun(r.s, ctx, clauses, v)
  ELSE CaseRun(r.s, ctx, clauses \o <<switch.block.DefaultClause>> \o List(switch.block.CaseClauses_b), v)
CaseRun(s, ctx, clauses, v) ==
  IF clauses = <<>> THEN Ok(s, v)
  ELSE CaseClauseThen(ctx, Tail(clauses), v, EvaluateStatementList(s, ctx, Head(clauses).StatementList))
CaseClauseThen(ctx, rest, v, r) ==
  IF IsSuspended(r) THEN Pass(r, "CaseClauseThen", <<ctx, rest, v>>) ELSE
  IF IsAbrupt(r) THEN Abrupt(r.s, UpdateEmpty(r.c, v)) ELSE CaseRun(r.s, ctx, rest, NextIterationValue(r.c, v))
\* The try statement (§14.15).
TryBlockThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "TryBlockThen", <<ctx, n>>) ELSE
  IF Has(n.Catch) /\ r.c.type = "throw" THEN TryCatchThen(ctx, n, CatchClauseEvaluation(r.s, ctx, n.Catch, r.c.value))
  ELSE TryCatchThen(ctx, n, r)
TryCatchThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "TryCatchThen", <<ctx, n>>) ELSE
  IF ~Has(n.Finally) THEN UpdateEmptyThen(Undefined, r)
  ELSE TryFinallyThen(r.c, EvaluateBlock(r.s, ctx, n.Finally.StatementList))
TryFinallyThen(c, r) ==
  IF IsSuspended(r) THEN Pass(r, "TryFinallyThen", <<c>>) ELSE IF IsAbrupt(r) THEN UpdateEmptyThen(Undefined, r) ELSE Abrupt(r.s, UpdateEmpty(c, Undefined))
\* CatchClauseEvaluation (§14.15.2).
CatchClauseEvaluation(s, ctx, n, thrown) ==
  IF ~Has(n.CatchParameter) THEN EvaluateBlock(s, ctx, n.Block.StatementList)
  ELSE
    LET param == n.CatchParameter
        env == NewCatchEnvironment(s, ctx.lex)
        catchCtx == WithLex(ctx, env.e)
        s1 == BlockBindNames(env.s, env.e, BoundNames(param), FALSE)
    IN CatchBindThen(catchCtx, n, IF param.type = "BindingIdentifier"
                                  THEN InitializeBinding(s1, env.e, param.name, thrown)
                                  ELSE BindingInitialization(s1, catchCtx, param, thrown, env.e))
CatchBindThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "CatchBindThen", <<ctx, n>>) ELSE IF IsAbrupt(r) THEN r ELSE EvaluateBlock(r.s, ctx, n.Block.StatementList)
\* Iterators (§7.4). An Iterator Record is [kind |-> "js", iterator, next, done], or a List
\* iterator [kind |-> "list", list, done] that runs no user code.
JsIterator(iterator, next) == [kind |-> "js", iterator |-> iterator, next |-> next, done |-> FALSE]
Done(it) == [it EXCEPT !.done = TRUE]
\* GetIterator (§7.4.4).
GetIterator(s, v, kind) ==
  IF kind = "async" THEN
    LET m == GetMethod(s, v, SymAsyncIterator) IN
    IF IsAbrupt(m) THEN m
    ELSE IF Val(m) # Undefined THEN GetIteratorFromMethod(m.s, v, Val(m))
    ELSE LET sm == GetMethod(m.s, v, SymIterator) IN
         IF IsAbrupt(sm) THEN sm
         ELSE IF Val(sm) = Undefined THEN ThrowTypeError(sm.s)
         ELSE LET it == GetIteratorFromMethod(sm.s, v, Val(sm)) IN
              IF IsAbrupt(it) THEN it ELSE CreateAsyncFromSyncIterator(it.s, Val(it))
  ELSE
    LET m == GetMethod(s, v, SymIterator) IN
    IF IsAbrupt(m) THEN m
    ELSE IF Val(m) = Undefined THEN ThrowTypeError(m.s)
    ELSE GetIteratorFromMethod(m.s, v, Val(m))
\* GetIteratorFromMethod (§7.4.3).
GetIteratorFromMethod(s, v, method) ==
  LET it == Call(s, method, v, <<>>) IN
  IF IsAbrupt(it) THEN it
  ELSE IF ~IsObject(Val(it)) THEN ThrowTypeError(it.s)
  ELSE LET next == Get(it.s, Val(it), SV("next")) IN
       IF IsAbrupt(next) THEN next ELSE Ok(next.s, JsIterator(Val(it), Val(next)))
\* IteratorNext (§7.4.6).
IteratorNext(s, it, args) ==
  LET r == Call(s, it.next, it.iterator, args) IN
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE r
\* IteratorComplete (§7.4.7), as a TLA+ Boolean.
IteratorComplete(s, r) ==
  LET d == Get(s, r, SV("done")) IN
  IF IsAbrupt(d) THEN d ELSE Ok(d.s, ToBooleanValue(Val(d)))
\* IteratorStepValue (§7.4.10), returning [done, value, iterator] with the updated record. When it
\* is abrupt, the iterator is done. When next is %ArrayIteratorPrototype%.next, its result object
\* is never allocated, since no code can observe it, and a heap that never frees would keep it.
IteratorStepValue(s, it) ==
  IF it.kind = "list" THEN
    IF it.list = <<>> THEN Ok(s, [done |-> TRUE, value |-> Undefined, iterator |-> Done(it)])
    ELSE Ok(s, [done |-> FALSE, value |-> Head(it.list), iterator |-> [it EXCEPT !.list = Tail(@)]])
  ELSE IF IsObject(it.next) /\ O(s, it.next).class = "builtin" /\ O(s, it.next).slots.id = <<"ArrayIterator", "next">> THEN
    LET r == InCallerRealm(s, ArrayIteratorResume(EnterRealm(s, O(s, it.next).slots.realm), it.iterator)) IN
    IF IsAbrupt(r) THEN r
    ELSE IF Val(r).done THEN Ok(r.s, [done |-> TRUE, value |-> Undefined, iterator |-> Done(it)])
    ELSE Ok(r.s, [done |-> FALSE, value |-> Val(r).value, iterator |-> it])
  ELSE
    LET r == IteratorNext(s, it, <<>>) IN
    IF IsAbrupt(r) THEN r ELSE
    LET d == IteratorComplete(r.s, Val(r)) IN
    IF IsAbrupt(d) THEN d
    ELSE IF Val(d) THEN Ok(d.s, [done |-> TRUE, value |-> Undefined, iterator |-> Done(it)])
    ELSE LET v == Get(d.s, Val(r), SV("value")) IN
         IF IsAbrupt(v) THEN v ELSE Ok(v.s, [done |-> FALSE, value |-> Val(v), iterator |-> it])
\* IteratorClose (§7.4.11), returning the completion to continue with.
IteratorClose(s, it, completion) ==
  IF it.kind = "list" THEN Abrupt(s, completion)
  ELSE
    LET m == GetMethod(s, it.iterator, SV("return"))
        inner == IF IsAbrupt(m) \/ Val(m) = Undefined THEN m ELSE Call(m.s, Val(m), it.iterator, <<>>)
    IN IF ~IsAbrupt(m) /\ Val(m) = Undefined THEN Abrupt(m.s, completion)
       ELSE IF completion.type = "throw" THEN Abrupt(inner.s, completion)
       ELSE IF IsAbrupt(inner) THEN inner
       ELSE IF ~IsObject(Val(inner)) THEN ThrowTypeError(inner.s)
       ELSE Abrupt(inner.s, completion)
\* AsyncIteratorClose (§7.4.13).
AsyncIteratorClose(s, it, completion) ==
  LET m == GetMethod(s, it.iterator, SV("return")) IN
  IF ~IsAbrupt(m) /\ Val(m) = Undefined THEN Abrupt(m.s, completion)
  ELSE LET called == IF IsAbrupt(m) THEN m ELSE Call(m.s, Val(m), it.iterator, <<>>) IN
       AsyncCloseThen(completion, IF IsAbrupt(called) THEN called ELSE Await(called.s, Val(called)))
AsyncCloseThen(completion, r) ==
  IF IsSuspended(r) THEN Pass(r, "AsyncCloseThen", <<completion>>) ELSE
  IF completion.type = "throw" THEN Abrupt(r.s, completion)
  ELSE IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE Abrupt(r.s, completion)
\* IteratorToList (§7.4.14), appending to acc. IteratorListRun takes at most
\* 2^k steps nested k deep, so a long iterator needs no frame per element.
IteratorListStep(s, it, acc) ==
  LET next == IteratorStepValue(s, it) IN
  CASE IsAbrupt(next) -> next
    [] Val(next).done -> Ok(next.s, acc)
    [] OTHER -> [s |-> next.s, c |-> Completion("iterate", Append(acc, Val(next).value), Empty), it |-> Val(next).iterator]
IteratorListRun(s, it, acc, k) ==
  IF k = 0 THEN IteratorListStep(s, it, acc)
  ELSE IteratorListRunThen(k, IteratorListRun(s, it, acc, k - 1))
IteratorListRunThen(k, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorListRunThen", <<k>>) ELSE IF r.c.type = "iterate" THEN IteratorListRun(r.s, r.it, Val(r), k - 1) ELSE r
IteratorListFrom(s, it, acc, k) == IteratorListFromThen(k, IteratorListRun(s, it, acc, k))
IteratorListFromThen(k, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorListFromThen", <<k>>) ELSE IF r.c.type = "iterate" THEN IteratorListFrom(r.s, r.it, Val(r), k + 1) ELSE r
IteratorToList(s, it, acc) == IteratorListFrom(s, it, acc, 0)
\* CreateIterResultObject (§7.4.15).
CreateIterResultObject(s, value, done) ==
  LET o == OrdinaryObjectCreate(s, Intrinsic(s, "ObjectPrototype")) IN
  Ok(SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), <<<<SV("value"), value>>, <<SV("done"), Bool(done)>>>>)), Val(o))
\* CreateForInIterator (§14.7.5.10.1).
CreateForInIterator(s, obj) ==
  LET a == Alloc(s, MakeObject(Intrinsic(s, "ForInIteratorPrototype"), "forInIterator",
                               [object |-> obj, visited |-> FALSE, visitedKeys |-> <<>>, remaining |-> <<>>]))
  IN Ok(a.s, JsIterator(a.v, Intrinsic(a.s, "ForInIteratorPrototype_next")))
\* InitializeBoundName (§8.6.3): initializes the binding in env, or assigns it when env is
\* NoEnv.
InitializeBoundName(s, ctx, name, value, env, strict) ==
  IF env # NoEnv THEN InitializeBinding(s, env, name, value)
  ELSE LET lhs == ResolveBinding(s, ctx, name, strict) IN
       IF IsAbrupt(lhs) THEN lhs ELSE PutValue(lhs.s, Val(lhs), value)
\* ResolveBinding of a name in env, or in the running context when env is Undefined.
ResolveBindingIn(s, ctx, name, env, strict) ==
  IF env = NoEnv THEN ResolveBinding(s, ctx, name, strict)
  ELSE GetIdentifierReference(s, env, name, strict)
\* Assigns or initializes a reference, as the binding operations do at their end.
BindReference(s, ref, value, env) ==
  IF env = NoEnv THEN PutValue(s, ref, value) ELSE InitializeReferencedBinding(s, ref, value)
\* Evaluates an initializer for a binding target named name, applying NamedEvaluation when the
\* target is a single name.
EvaluateInitializer(s, ctx, init, name) ==
  IF name # Empty THEN EvaluateNamed(s, ctx, init, Str(name)) ELSE EvaluateValue(s, ctx, init)
\* BindingInitialization (§8.6.2).
BindingInitialization(s, ctx, n, value, env) ==
  CASE n.type = "BindingIdentifier" -> InitializeBoundName(s, ctx, n.name, value, env, n.strict)
    [] n.type = "ObjectBindingPattern" ->
         LET c == RequireObjectCoercible(s, value) IN
         IF IsAbrupt(c) THEN c
         ELSE ObjectBindingThen(ctx, n, value, env, PropertyBindingInitialization(c.s, ctx, List(n.BindingPropertyList), value, env, <<>>))
    [] n.type = "ArrayBindingPattern" ->
         LET it == GetIterator(s, value, "sync") IN
         IF IsAbrupt(it) THEN it
         ELSE IteratorEndThen(IteratorBindingInitializationList(it.s, ctx, ArrayBindingElements(n), Val(it), env))
ObjectBindingThen(ctx, n, value, env, r) ==
  IF IsSuspended(r) THEN Pass(r, "ObjectBindingThen", <<ctx, n, value, env>>) ELSE
  IF IsAbrupt(r) \/ ~Has(n.BindingRestProperty) THEN r
  ELSE RestPropertyBinding(r.s, ctx, n.BindingRestProperty, value, env, Val(r))
\* Closes the iterator a list of elements left undone, after r [s, c, it].
IteratorEndThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorEndThen", <<>>) ELSE IF r.it.done THEN [s |-> r.s, c |-> r.c] ELSE IteratorClose(r.s, r.it, r.c)
ArrayBindingElements(n) ==
  List(n.BindingElementList) \o (IF Has(n.BindingRestElement) THEN <<n.BindingRestElement>> ELSE <<>>)
\* PropertyBindingInitialization (§14.3.3.1), returning the property keys it bound.
PropertyBindingInitialization(s, ctx, props, value, env, keys) ==
  IF props = <<>> THEN Ok(s, keys)
  ELSE PropertyBindingKeyThen(ctx, props, value, env, keys,
                              IF Head(props).type = "SingleNameBinding" THEN Ok(s, Str(Head(props).BindingIdentifier.name))
                              ELSE EvaluatePropertyKey(s, ctx, Head(props).PropertyName))
PropertyBindingKeyThen(ctx, props, value, env, keys, r) ==
  IF IsSuspended(r) THEN Pass(r, "PropertyBindingKeyThen", <<ctx, props, value, env, keys>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET p == Head(props) IN
  PropertyBindingNextThen(ctx, Tail(props), value, env, Append(keys, Val(r)),
                          KeyedBindingInitialization(r.s, ctx, IF p.type = "SingleNameBinding" THEN p ELSE p.BindingElement,
                                                     value, env, Val(r)))
PropertyBindingNextThen(ctx, rest, value, env, keys, r) ==
  IF IsSuspended(r) THEN Pass(r, "PropertyBindingNextThen", <<ctx, rest, value, env, keys>>) ELSE
  IF IsAbrupt(r) THEN r ELSE PropertyBindingInitialization(r.s, ctx, rest, value, env, keys)
\* KeyedBindingInitialization (§14.3.3.3).
KeyedBindingInitialization(s, ctx, n, value, env, key) ==
  IF n.type = "SingleNameBinding" THEN
    LET name == n.BindingIdentifier.name
        lhs == ResolveBindingIn(s, ctx, name, env, n.strict)
    IN IF IsAbrupt(lhs) THEN lhs ELSE
       LET v == GetValueProperty(lhs.s, value, key) IN
       IF IsAbrupt(v) THEN v
       ELSE BindReferenceThen(Val(lhs), env, IF Has(n.Initializer) /\ Val(v) = Undefined
                                             THEN EvaluateInitializer(v.s, ctx, n.Initializer, name) ELSE v)
  ELSE
    LET v == GetValueProperty(s, value, key) IN
    IF IsAbrupt(v) THEN v
    ELSE PatternInitializerThen(ctx, n.BindingPattern, env, IF Has(n.Initializer) /\ Val(v) = Undefined
                                                           THEN EvaluateValue(v.s, ctx, n.Initializer) ELSE v)
BindReferenceThen(ref, env, r) ==
  IF IsSuspended(r) THEN Pass(r, "BindReferenceThen", <<ref, env>>) ELSE IF IsAbrupt(r) THEN r ELSE BindReference(r.s, ref, Val(r), env)
\* RestBindingInitialization (§14.3.3.2).
RestPropertyBinding(s, ctx, n, value, env, excluded) ==
  LET lhs == ResolveBindingIn(s, ctx, n.BindingIdentifier.name, env, n.strict) IN
  IF IsAbrupt(lhs) THEN lhs ELSE
  LET o == OrdinaryObjectCreate(lhs.s, Intrinsic(lhs.s, "ObjectPrototype")) IN
  LET c == CopyDataProperties(o.s, Val(o), value, excluded) IN
  IF IsAbrupt(c) THEN c ELSE BindReference(c.s, Val(lhs), Val(o), env)
\* IteratorBindingInitialization (§8.6.4) of a list of elements or formal parameters. Returns
\* [s, c, it] with the iterator record after the elements consume it.
IteratorBindingInitializationList(s, ctx, list, it, env) ==
  IF list = <<>> THEN [s |-> s, c |-> NormalCompletion(Empty), it |-> it]
  ELSE IteratorBindingListThen(ctx, Tail(list), env, IteratorBindingElement(s, ctx, Head(list), it, env))
IteratorBindingListThen(ctx, rest, env, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorBindingListThen", <<ctx, rest, env>>) ELSE
  IF IsAbrupt(r) THEN r ELSE IteratorBindingInitializationList(r.s, ctx, rest, r.it, env)
\* The next value from an iterator for a binding element: [s, c, it] with c's value the value or
\* Undefined once the iterator is done.
IteratorNextForBinding(s, it) ==
  IF it.done THEN [s |-> s, c |-> NormalCompletion(Undefined), it |-> it]
  ELSE LET next == IteratorStepValue(s, it) IN
       IF IsAbrupt(next) THEN [s |-> next.s, c |-> next.c, it |-> Done(it)]
       ELSE [s |-> next.s, c |-> NormalCompletion(Val(next).value), it |-> Val(next).iterator]
WithIt(r, it) == [s |-> r.s, c |-> r.c, it |-> it]
WithItThen(it, r) ==
  IF IsSuspended(r) THEN Pass(r, "WithItThen", <<it>>) ELSE WithIt(r, it)
IteratorBindingElement(s, ctx, n, it, env) ==
  CASE n.type = "Elision" ->
         LET next == IteratorNextForBinding(s, it) IN
         IF IsAbrupt(next) THEN next ELSE WithIt(Ok(next.s, Empty), next.it)
    [] n.type = "SingleNameBinding" ->
         LET name == n.BindingIdentifier.name
             lhs == ResolveBindingIn(s, ctx, name, env, n.strict)
         IN IF IsAbrupt(lhs) THEN WithIt(lhs, it) ELSE
            LET next == IteratorNextForBinding(lhs.s, it) IN
            IF IsAbrupt(next) THEN next
            ELSE IteratorBindThen(Val(lhs), env, next.it,
                                  IF Has(n.Initializer) /\ Val(next) = Undefined
                                  THEN EvaluateInitializer(next.s, ctx, n.Initializer, name) ELSE next)
    [] n.type = "BindingElement" ->
         LET next == IteratorNextForBinding(s, it) IN
         IF IsAbrupt(next) THEN next
         ELSE IteratorPatternThen(ctx, n.BindingPattern, env, next.it,
                                  IF Has(n.Initializer) /\ Val(next) = Undefined
                                  THEN EvaluateValue(next.s, ctx, n.Initializer) ELSE next)
    [] n.type = "BindingRestElement" ->
         LET lhs == IF Has(n.BindingIdentifier)
                    THEN ResolveBindingIn(s, ctx, n.BindingIdentifier.name, env, n.strict)
                    ELSE Ok(s, Empty)
         IN IF IsAbrupt(lhs) THEN WithIt(lhs, it) ELSE
            LET a == ArrayCreate(lhs.s, 0, Intrinsic(lhs.s, "ArrayPrototype"))
                rest == CollectRest(a.s, Val(a), it, 0)
            IN IF IsAbrupt(rest) THEN rest
               ELSE IF Has(n.BindingIdentifier) THEN WithIt(BindReference(rest.s, Val(lhs), Val(a), env), rest.it)
               ELSE WithItThen(rest.it, BindingInitialization(rest.s, ctx, n.BindingPattern, Val(a), env))
IteratorBindThen(ref, env, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorBindThen", <<ref, env, it>>) ELSE
  IF IsAbrupt(r) THEN WithIt(r, it) ELSE WithIt(BindReference(r.s, ref, Val(r), env), it)
IteratorPatternThen(ctx, pattern, env, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorPatternThen", <<ctx, pattern, env, it>>) ELSE
  IF IsAbrupt(r) THEN WithIt(r, it) ELSE WithItThen(it, BindingInitialization(r.s, ctx, pattern, Val(r), env))
\* Steps of BindingRestElement that fill the array a with the iterator's remaining values.
CollectRest(s, a, it, i) ==
  IF it.done THEN [s |-> s, c |-> NormalCompletion(a), it |-> it]
  ELSE LET next == IteratorStepValue(s, it) IN
       IF IsAbrupt(next) THEN [s |-> next.s, c |-> next.c, it |-> Done(it)]
       ELSE IF Val(next).done THEN [s |-> next.s, c |-> NormalCompletion(a), it |-> Val(next).iterator]
       ELSE LET c == CreateDataPropertyOrThrow(next.s, a, Str(NumToString(NumFromInt(i))), Val(next).value) IN
            CollectRest(c.s, a, Val(next).iterator, i + 1)
\* DestructuringAssignmentEvaluation (§13.15.5.2) of a pattern the host refined.
IsAssignmentPattern(n) == n.type \in {"ObjectAssignmentPattern", "ArrayAssignmentPattern"}
DestructuringAssignmentEvaluation(s, ctx, n, value) ==
  IF n.type = "ObjectAssignmentPattern" THEN
    LET c == RequireObjectCoercible(s, value) IN
    IF IsAbrupt(c) THEN c
    ELSE ObjectDestructuringThen(ctx, n, value, PropertyDestructuring(c.s, ctx, List(n.AssignmentPropertyList), value, <<>>))
  ELSE
    LET it == GetIterator(s, value, "sync") IN
    IF IsAbrupt(it) THEN it
    ELSE IteratorEndThen(IteratorDestructuringList(it.s, ctx, List(n.AssignmentElementList) \o
                           (IF Has(n.AssignmentRestElement) THEN <<n.AssignmentRestElement>> ELSE <<>>), Val(it)))
ObjectDestructuringThen(ctx, n, value, r) ==
  IF IsSuspended(r) THEN Pass(r, "ObjectDestructuringThen", <<ctx, n, value>>) ELSE
  IF IsAbrupt(r) \/ ~Has(n.AssignmentRestProperty) THEN r
  ELSE RestDestructuringThen(value, Val(r), Evaluate(r.s, ctx, n.AssignmentRestProperty.DestructuringAssignmentTarget))
RestDestructuringThen(value, keys, r) ==
  IF IsSuspended(r) THEN Pass(r, "RestDestructuringThen", <<value, keys>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET o == OrdinaryObjectCreate(r.s, Intrinsic(r.s, "ObjectPrototype"))
      copied == CopyDataProperties(o.s, Val(o), value, keys)
  IN IF IsAbrupt(copied) THEN copied ELSE PutValue(copied.s, Val(r), Val(o))
\* PropertyDestructuringAssignmentEvaluation (§13.15.5.3), returning the keys it read.
PropertyDestructuring(s, ctx, props, value, keys) ==
  IF props = <<>> THEN Ok(s, keys)
  ELSE LET p == Head(props) IN
  IF Has(p.IdentifierReference) THEN
    LET name == p.IdentifierReference.name
        lref == ResolveBinding(s, ctx, name, p.IdentifierReference.strict)
    IN IF IsAbrupt(lref) THEN lref ELSE
       LET v == GetValueProperty(lref.s, value, Str(name)) IN
       IF IsAbrupt(v) THEN v
       ELSE PropertyDestructuringNextThen(ctx, Tail(props), value, Append(keys, Str(name)),
              PutValueThen(Val(lref), IF Has(p.Initializer) /\ Val(v) = Undefined
                                      THEN EvaluateInitializer(v.s, ctx, p.Initializer, name) ELSE v))
  ELSE PropertyDestructuringKeyThen(ctx, props, value, keys, EvaluatePropertyKey(s, ctx, p.PropertyName))
PropertyDestructuringKeyThen(ctx, props, value, keys, r) ==
  IF IsSuspended(r) THEN Pass(r, "PropertyDestructuringKeyThen", <<ctx, props, value, keys>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE PropertyDestructuringNextThen(ctx, Tail(props), value, Append(keys, Val(r)),
                                     KeyedDestructuring(r.s, ctx, Head(props).AssignmentElement, value, Val(r)))
PropertyDestructuringNextThen(ctx, rest, value, keys, r) ==
  IF IsSuspended(r) THEN Pass(r, "PropertyDestructuringNextThen", <<ctx, rest, value, keys>>) ELSE
  IF IsAbrupt(r) THEN r ELSE PropertyDestructuring(r.s, ctx, rest, value, keys)
\* The name an initializer's anonymous function gets from a destructuring target, or Empty.
TargetName(target) == IF IsIdentifierRef(target) THEN target.name ELSE Empty
\* The reference a destructuring target evaluates to, or Empty for a nested pattern.
EvaluateTarget(s, ctx, target) == IF IsAssignmentPattern(target) THEN Ok(s, Empty) ELSE Evaluate(s, ctx, target)
\* KeyedDestructuringAssignmentEvaluation (§13.15.5.6).
KeyedDestructuring(s, ctx, n, value, key) ==
  KeyedTargetThen(ctx, n, value, key, EvaluateTarget(s, ctx, n.DestructuringAssignmentTarget))
KeyedTargetThen(ctx, n, value, key, r) ==
  IF IsSuspended(r) THEN Pass(r, "KeyedTargetThen", <<ctx, n, value, key>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET target == n.DestructuringAssignmentTarget
      v == GetValueProperty(r.s, value, key)
  IN IF IsAbrupt(v) THEN v
     ELSE AssignTargetThen(ctx, target, Val(r), IF Has(n.Initializer) /\ Val(v) = Undefined
                                               THEN EvaluateInitializer(v.s, ctx, n.Initializer, TargetName(target)) ELSE v)
\* Assigns the value r gives to a destructuring target, through its reference or as a pattern.
AssignTargetThen(ctx, target, ref, r) ==
  IF IsSuspended(r) THEN Pass(r, "AssignTargetThen", <<ctx, target, ref>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF IsAssignmentPattern(target) THEN DestructuringAssignmentEvaluation(r.s, ctx, target, Val(r))
  ELSE PutValue(r.s, ref, Val(r))
\* IteratorDestructuringAssignmentEvaluation (§13.15.5.5), returning [s, c, it].
IteratorDestructuringList(s, ctx, list, it) ==
  IF list = <<>> THEN [s |-> s, c |-> NormalCompletion(Empty), it |-> it]
  ELSE IteratorDestructuringListThen(ctx, Tail(list), IteratorDestructuringElement(s, ctx, Head(list), it))
IteratorDestructuringListThen(ctx, rest, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorDestructuringListThen", <<ctx, rest>>) ELSE
  IF IsAbrupt(r) THEN r ELSE IteratorDestructuringList(r.s, ctx, rest, r.it)
IteratorDestructuringElement(s, ctx, n, it) ==
  CASE n.type = "Elision" ->
         LET next == IteratorNextForBinding(s, it) IN
         IF IsAbrupt(next) THEN next ELSE WithIt(Ok(next.s, Empty), next.it)
    [] n.type = "AssignmentElement" -> IteratorTargetThen(ctx, n, it, EvaluateTarget(s, ctx, n.DestructuringAssignmentTarget))
    [] OTHER -> IteratorRestTargetThen(ctx, n, it, EvaluateTarget(s, ctx, n.AssignmentExpression))
IteratorTargetThen(ctx, n, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorTargetThen", <<ctx, n, it>>) ELSE
  IF IsAbrupt(r) THEN WithIt(r, it) ELSE
  LET target == n.DestructuringAssignmentTarget
      next == IteratorNextForBinding(r.s, it)
  IN IF IsAbrupt(next) THEN next
     ELSE IteratorAssignThen(ctx, target, Val(r), next.it,
                             IF Has(n.Initializer) /\ Val(next) = Undefined
                             THEN EvaluateInitializer(next.s, ctx, n.Initializer, TargetName(target)) ELSE next)
IteratorAssignThen(ctx, target, ref, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorAssignThen", <<ctx, target, ref, it>>) ELSE
  IF IsAbrupt(r) THEN WithIt(r, it) ELSE WithItThen(it, AssignTargetThen(ctx, target, ref, r))
IteratorRestTargetThen(ctx, n, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "IteratorRestTargetThen", <<ctx, n, it>>) ELSE
  IF IsAbrupt(r) THEN WithIt(r, it) ELSE
  LET a == ArrayCreate(r.s, 0, Intrinsic(r.s, "ArrayPrototype"))
      rest == CollectRest(a.s, Val(a), it, 0)
  IN IF IsAbrupt(rest) THEN rest
     ELSE WithItThen(rest.it, AssignTargetThen(ctx, n.AssignmentExpression, Val(r), Ok(rest.s, Val(a))))
\* Instantiating function objects (§15.2 to §15.6, §15.8, §15.9).
FunctionBodyOf(n) ==
  CASE n.type \in {"FunctionDeclaration", "FunctionExpression"} -> n.FunctionBody
    [] n.type \in {"GeneratorDeclaration", "GeneratorExpression"} -> n.GeneratorBody
    [] n.type \in {"AsyncFunctionDeclaration", "AsyncFunctionExpression"} -> n.AsyncBody
    [] n.type \in {"AsyncGeneratorDeclaration", "AsyncGeneratorExpression"} -> n.AsyncGeneratorBody
FunctionPrototypeFor(type) ==
  CASE type \in {"FunctionDeclaration", "FunctionExpression", "ArrowFunction", "MethodDefinition"} -> "FunctionPrototype"
    [] type \in {"GeneratorDeclaration", "GeneratorExpression", "GeneratorMethod"} -> "GeneratorFunctionPrototype"
    [] type \in {"AsyncFunctionDeclaration", "AsyncFunctionExpression", "AsyncArrowFunction", "AsyncMethod"} ->
         "AsyncFunctionPrototype"
    [] type \in {"AsyncGeneratorDeclaration", "AsyncGeneratorExpression", "AsyncGeneratorMethod"} ->
         "AsyncGeneratorFunctionPrototype"
\* Gives a new function object its prototype property: a constructor's for ordinary functions,
\* and a fresh generator prototype object for generator functions. A non-strict ordinary function
\* also gets caller and arguments accessors, the extension engines make and §17.1 allows.
GiveFunctionPrototype(s, type, f) ==
  CASE type \in {"FunctionDeclaration", "FunctionExpression"} ->
         LET s1 == MakeConstructor(s, f, TRUE, Empty) IN
         IF O(s1, f).slots.strict THEN s1
         ELSE SetO(s1, f, PutProp(PutProp(O(s1, f), SV("arguments"), AccessorDesc(Intrinsic(s1, "FunctionArguments"), Undefined, FALSE, FALSE)),
                                  SV("caller"), AccessorDesc(Intrinsic(s1, "FunctionCaller"), Undefined, FALSE, FALSE)))
    [] type \in {"GeneratorDeclaration", "GeneratorExpression", "GeneratorMethod",
                 "AsyncGeneratorDeclaration", "AsyncGeneratorExpression", "AsyncGeneratorMethod"} ->
         LET protoName == IF type \in {"GeneratorDeclaration", "GeneratorExpression", "GeneratorMethod"}
                          THEN "GeneratorPrototype" ELSE "AsyncGeneratorPrototype"
             p == OrdinaryObjectCreate(s, Intrinsic(s, protoName))
         IN SetO(p.s, f, PutProp(O(p.s, f), SV("prototype"), DataDesc(Val(p), TRUE, FALSE, FALSE)))
    [] OTHER -> s
\* InstantiateFunctionObject (§15.2.4 and its generator and async counterparts).
InstantiateFunctionObject(s, ctx, n) ==
  LET name == IF Has(n.BindingIdentifier) THEN n.BindingIdentifier.name ELSE N("default")
      f == OrdinaryFunctionCreate(s, Intrinsic(s, FunctionPrototypeFor(n.type)), n.sourceText,
                                  n.FormalParameters, FunctionBodyOf(n), FALSE, ctx.lex, ctx.priv)
      s1 == SetFunctionName(f.s, f.v, Str(name), <<>>)
  IN Ok(GiveFunctionPrototype(s1, n.type, f.v), f.v)
\* InstantiateOrdinaryFunctionExpression (§15.2.5) and the like. name is the name NamedEvaluation
\* gives, or Empty.
InstantiateFunctionExpression(s, ctx, n, name) ==
  IF Has(n.BindingIdentifier) THEN
    LET funcName == n.BindingIdentifier.name
        env == NewDeclarativeEnvironment(s, ctx.lex)
        s1 == CreateImmutableBinding(env.s, env.e, funcName, FALSE).s
        f == OrdinaryFunctionCreate(s1, Intrinsic(s1, FunctionPrototypeFor(n.type)), n.sourceText,
                                    n.FormalParameters, FunctionBodyOf(n), FALSE, env.e, ctx.priv)
        s2 == GiveFunctionPrototype(SetFunctionName(f.s, f.v, Str(funcName), <<>>), n.type, f.v)
    IN Ok(InitializeBinding(s2, env.e, funcName, f.v).s, f.v)
  ELSE
    LET f == OrdinaryFunctionCreate(s, Intrinsic(s, FunctionPrototypeFor(n.type)), n.sourceText,
                                    n.FormalParameters, FunctionBodyOf(n), FALSE, ctx.lex, ctx.priv)
        s1 == SetFunctionName(f.s, f.v, IF name = Empty THEN EmptyStr ELSE name, <<>>)
    IN Ok(GiveFunctionPrototype(s1, n.type, f.v), f.v)
\* InstantiateArrowFunctionExpression (§15.3.4) and its async counterpart (§15.9.4).
InstantiateArrowFunctionExpression(s, ctx, n, name) ==
  LET body == IF n.type = "ArrowFunction" THEN n.ConciseBody ELSE n.AsyncConciseBody
      f == OrdinaryFunctionCreate(s, Intrinsic(s, FunctionPrototypeFor(n.type)), n.sourceText,
                                  n.ArrowParameters, body, TRUE, ctx.lex, ctx.priv)
  IN Ok(SetFunctionName(f.s, f.v, IF name = Empty THEN EmptyStr ELSE name, <<>>), f.v)
\* Method definitions (§15.4). A method's kind: "method", "get", or "set".
MethodKind(n) ==
  IF n.type # "MethodDefinition" THEN "method"
  ELSE IF Has(n.PropertySetParameterList) THEN "set"
  ELSE IF Has(n.UniqueFormalParameters) THEN "method"
  ELSE "get"
MethodBody(n) ==
  CASE n.type = "MethodDefinition" -> n.FunctionBody
    [] n.type = "GeneratorMethod" -> n.GeneratorBody
    [] n.type = "AsyncMethod" -> n.AsyncBody
    [] n.type = "AsyncGeneratorMethod" -> n.AsyncGeneratorBody
MethodParams(n) ==
  CASE MethodKind(n) = "set" -> n.PropertySetParameterList
    [] MethodKind(n) = "get" -> <<>>
    [] OTHER -> n.UniqueFormalParameters
\* DefineMethod (§15.4.4), returning [key, closure] with the method's home object.
DefineMethod(s, ctx, n, obj, proto) == DefineMethodThen(ctx, n, obj, proto, EvaluatePropertyKey(s, ctx, n.ClassElementName))
DefineMethodThen(ctx, n, obj, proto, r) ==
  IF IsSuspended(r) THEN Pass(r, "DefineMethodThen", <<ctx, n, obj, proto>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET f == OrdinaryFunctionCreate(r.s, IF proto = Empty THEN Intrinsic(r.s, FunctionPrototypeFor(n.type)) ELSE proto,
                                  n.sourceText, MethodParams(n), MethodBody(n), FALSE, ctx.lex, ctx.priv)
  IN Ok(MakeMethod(f.s, f.v, obj), [key |-> Val(r), closure |-> f.v])
\* A Private Element (§6.2.10): [key, kind, value, get, set] with kind "field", "method", or
\* "accessor".
PrivateElement(key, kind, value, get, set) == [key |-> key, kind |-> kind, value |-> value, get |-> get, set |-> set]
\* DefineMethodProperty (§10.2.8), returning a Private Element for a private key or Empty.
DefineMethodProperty(s, obj, key, closure, enumerable) ==
  IF key.type = "private" THEN Ok(s, PrivateElement(key, "method", closure, Undefined, Undefined))
  ELSE LET d == DefinePropertyOrThrow(s, obj, key, DataDesc(closure, TRUE, enumerable, TRUE)) IN
       IF IsAbrupt(d) THEN d ELSE Ok(d.s, Empty)
\* MethodDefinitionEvaluation (§15.4.5 and its generator and async counterparts).
MethodDefinitionEvaluation(s, ctx, obj, n, enumerable) ==
  MethodDefinitionThen(obj, n, enumerable, DefineMethod(s, ctx, n, obj, Empty))
MethodDefinitionThen(obj, n, enumerable, m) ==
  IF IsSuspended(m) THEN Pass(m, "MethodDefinitionThen", <<obj, n, enumerable>>) ELSE
  IF IsAbrupt(m) THEN m ELSE
  LET kind == MethodKind(n)
      key == Val(m).key
      f == Val(m).closure
  IN IF kind = "method" THEN
          LET s1 == GiveFunctionPrototype(SetFunctionName(m.s, f, key, <<>>), n.type, f) IN
          DefineMethodProperty(s1, obj, key, f, enumerable)
        ELSE
          LET s1 == SetFunctionName(m.s, f, key, IF kind = "get" THEN N("get") ELSE N("set")) IN
          IF key.type = "private" THEN
            Ok(s1, IF kind = "get" THEN PrivateElement(key, "accessor", Undefined, f, Undefined)
                   ELSE PrivateElement(key, "accessor", Undefined, Undefined, f))
          ELSE
            LET d == DefinePropertyOrThrow(s1, obj, key,
                       IF kind = "get" THEN AccessorDesc(f, Absent, enumerable, TRUE)
                       ELSE AccessorDesc(Absent, f, enumerable, TRUE))
            IN IF IsAbrupt(d) THEN d ELSE Ok(d.s, Empty)
\* Private environments (§9.2) are values: [outer, names] with names from a private identifier's
\* name to its Private Name. A Private Name is [type |-> "private", id, description].
NewPrivateEnvironment(s, outer, names) ==
  LET ids == [i \in 1..Len(names) |-> s.privateCount + i]
      distinct == Dedupe(names)
  IN [s |-> [s EXCEPT !.privateCount = @ + Len(distinct)],
      env |-> [outer |-> outer,
               names |-> [name \in Range(distinct) |->
                            [type |-> "private", id |-> s.privateCount + IndexOf(distinct, name),
                             description |-> <<35>> \o name]]]]
ResolvePrivateIdentifier(s, ctx, name) == ResolvePrivateIn(ctx.priv, name)
ResolvePrivateIn(env, name) ==
  IF name \in DOMAIN env.names THEN env.names[name] ELSE ResolvePrivateIn(env.outer, name)
\* Private element operations (§7.3.26 to §7.3.32).
PrivateElementFind(s, o, p) ==
  LET elements == O(s, o).privs
      found == {i \in DOMAIN elements : elements[i].key.id = p.id}
  IN IF found = {} THEN Empty ELSE elements[CHOOSE i \in found : TRUE]
\* PrivateFieldAdd and PrivateMethodOrAccessorAdd, which throw on a non-extensible
\* object as engine262 does for the nonextensible-applies-to-private proposal.
PrivateFieldAdd(s, o, p, value) == PrivateElementAdd(s, o, PrivateElement(p, "field", value, Undefined, Undefined))
PrivateMethodOrAccessorAdd(s, o, method) == PrivateElementAdd(s, o, method)
PrivateElementAdd(s, o, element) ==
  LET extensible == IsExtensible(s, o) IN
  CASE IsAbrupt(extensible) -> extensible
    [] Val(extensible) = False \/ PrivateElementFind(extensible.s, o, element.key) # Empty -> ThrowTypeError(extensible.s)
    [] OTHER -> Ok(SetO(extensible.s, o, [O(extensible.s, o) EXCEPT !.privs = Append(@, element)]), Empty)
PrivateGet(s, o, p) ==
  LET entry == PrivateElementFind(s, o, p) IN
  CASE entry = Empty -> ThrowTypeError(s)
    [] entry.kind \in {"field", "method"} -> Ok(s, entry.value)
    [] entry.get = Undefined -> ThrowTypeError(s)
    [] OTHER -> Call(s, entry.get, o, <<>>)
PrivateSet(s, o, p, value) ==
  LET entry == PrivateElementFind(s, o, p)
      elements == O(s, o).privs
  IN CASE entry = Empty -> ThrowTypeError(s)
       [] entry.kind = "field" ->
            LET i == CHOOSE j \in DOMAIN elements : elements[j].key.id = p.id IN
            Ok(SetO(s, o, [O(s, o) EXCEPT !.privs[i].value = value]), Empty)
       [] entry.kind = "method" -> ThrowTypeError(s)
       [] entry.set = Undefined -> ThrowTypeError(s)
       [] OTHER -> LET c == Call(s, entry.set, o, <<value>>) IN IF IsAbrupt(c) THEN c ELSE Ok(c.s, Empty)
\* InitializeFieldOrAccessor of the decorators proposal, for a field or auto-accessor element: its
\* own initializer and then each one its decorators returned give the value of the field, or of the
\* accessor's storage, and then the initializers its decorators added run.
InitializeFieldOrAccessor(s, receiver, e) ==
  LET v == FieldInitializersThen(receiver, e.initializers,
                                 IF e.init = Empty THEN Ok(s, Undefined) ELSE Call(s, e.init, receiver, <<>>))
      name == IF e.kind = "accessor" THEN e.storage ELSE e.key
  IN IF IsAbrupt(v) THEN v ELSE
     LET added == IF name.type = "private" THEN PrivateFieldAdd(v.s, receiver, name, Val(v))
                  ELSE CreateDataPropertyOrThrow(v.s, receiver, name, Val(v))
     IN IF IsAbrupt(added) THEN added ELSE CallInitializers(added.s, receiver, InitializerList(added.s, e.extra))
FieldInitializersThen(receiver, initializers, r) ==
  IF IsSuspended(r) THEN Pass(r, "FieldInitializersThen", <<receiver, initializers>>) ELSE
  IF IsAbrupt(r) \/ initializers = <<>> THEN r
  ELSE FieldInitializersThen(receiver, Tail(initializers), Call(r.s, Head(initializers), receiver, <<Val(r)>>))
\* A list addInitializer appends to is an object no code can reach, or Empty for one nothing can
\* append to.
NewInitializerList(s, isNeeded) ==
  IF ~isNeeded THEN [s |-> s, v |-> Empty] ELSE Alloc(s, MakeObject(Null, "ordinary", [initializers |-> <<>>]))
InitializerList(s, list) == IF list = Empty THEN <<>> ELSE O(s, list).slots.initializers
CallInitializers(s, receiver, fns) ==
  IF fns = <<>> THEN Ok(s, Empty)
  ELSE LET c == Call(s, Head(fns), receiver, <<>>) IN IF IsAbrupt(c) THEN c ELSE CallInitializers(c.s, receiver, Tail(fns))
\* InitializeInstanceElements (§7.3.34) of the decorators proposal.
InitializeInstanceElements(s, o, constructor) ==
  LET slots == O(s, constructor).slots
      m == AddPrivateMethods(s, o, IF "privateMethods" \in DOMAIN slots THEN slots.privateMethods ELSE <<>>)
      i == CallInitializers(m.s, o, IF "initializers" \in DOMAIN slots THEN InitializerList(m.s, slots.initializers) ELSE <<>>)
  IN CASE IsAbrupt(m) -> m
       [] IsAbrupt(i) -> i
       [] OTHER -> InitializeFields(i.s, o, IF "fields" \in DOMAIN slots THEN slots.fields ELSE <<>>)
AddPrivateMethods(s, o, methods) ==
  IF methods = <<>> THEN Ok(s, Empty)
  ELSE LET r == PrivateMethodOrAccessorAdd(s, o, Head(methods)) IN
       IF IsAbrupt(r) THEN r ELSE AddPrivateMethods(r.s, o, Tail(methods))
InitializeFields(s, o, fields) ==
  IF fields = <<>> THEN Ok(s, Empty)
  ELSE LET r == InitializeFieldOrAccessor(s, o, Head(fields)) IN
       IF IsAbrupt(r) THEN r ELSE InitializeFields(r.s, o, Tail(fields))
\* The body a class field initializer function runs (§15.7.10).
EvaluateFieldInitializer(s, ctx, f, body) ==
  LET name == O(s, f).slots.initializerName
      v == IF IsAnonymousFunctionDefinition(body.Initializer)
           THEN NamedEvaluation(s, ctx, body.Initializer, name)
           ELSE EvaluateValue(s, ctx, body.Initializer)
  IN IF IsAbrupt(v) THEN v ELSE Abrupt(v.s, Completion("return", Val(v), Empty))
\* Static semantics of class bodies (§15.7.3).
ClassElements(tail) == List(tail.ClassBody)
IsStaticElement(e) == e.static = TRUE
IsConstructorMethod(e) ==
  /\ e.type = "MethodDefinition"
  /\ ~IsStaticElement(e)
  /\ e.ClassElementName.type \in {"IdentifierName", "StringLiteral"}
  /\ PropName(e.ClassElementName) = N("constructor")
ConstructorMethodOf(tail) ==
  LET found == {i \in DOMAIN ClassElements(tail) : IsConstructorMethod(ClassElements(tail)[i])}
  IN IF found = {} THEN Empty ELSE ClassElements(tail)[CHOOSE i \in found : TRUE]
NonConstructorElements(tail) == SelectSeq(ClassElements(tail), LAMBDA e : ~IsConstructorMethod(e))
PrivateBoundIdentifiers(tail) ==
  LET elements == SelectSeq(ClassElements(tail),
                            LAMBDA e : e.type # "ClassStaticBlock" /\ e.ClassElementName.type = "PrivateIdentifier")
  IN [i \in DOMAIN elements |-> elements[i].ClassElementName.name]
DecoratorsOf(n) == IF "Decorators" \in DOMAIN n /\ Has(n.Decorators) THEN n.Decorators ELSE <<>>
\* ClassDefinitionEvaluation (§15.7.14) with the decorators proposal. classBinding is a name or
\* Empty, className is the property key or Private Name for SetFunctionName, and decorators are the
\* class's Decorator nodes, which are evaluated first.
ClassDefinitionEvaluation(s, ctx, tail, classBinding, className, sourceText, decorators) ==
  LET d == DecoratorListEvaluation(s, ctx, decorators)
      env == NewDeclarativeEnvironment(d.s, ctx.lex)
      s1 == IF classBinding = Empty THEN env.s ELSE CreateImmutableBinding(env.s, env.e, classBinding, TRUE).s
      priv == NewPrivateEnvironment(s1, ctx.priv, PrivateBoundIdentifiers(tail))
  IN IF IsAbrupt(d) THEN d
     ELSE ClassHeritageThen([ctx |-> [ctx EXCEPT !.lex = env.e, !.priv = priv.env], tail |-> tail, binding |-> classBinding,
                             name |-> className, sourceText |-> sourceText, decorators |-> Val(d)],
                            IF Has(tail.ClassHeritage) THEN EvaluateValue(priv.s, WithLex(ctx, env.e), tail.ClassHeritage)
                            ELSE Ok(priv.s, Empty))
\* Steps 8-25 of ClassDefinitionEvaluation, for a class [ctx, tail, binding, name, sourceText,
\* decorators] whose heritage evaluated to r.
ClassHeritageThen(class, r) ==
  IF IsSuspended(r) THEN Pass(r, "ClassHeritageThen", <<class>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET tail == class.tail
      parents ==
        IF ~Has(tail.ClassHeritage)
        THEN Ok(r.s, [proto |-> Intrinsic(r.s, "ObjectPrototype"), ctor |-> Intrinsic(r.s, "FunctionPrototype")])
        ELSE IF Val(r) = Null
        THEN Ok(r.s, [proto |-> Null, ctor |-> Intrinsic(r.s, "FunctionPrototype")])
        ELSE IF ~IsConstructor(r.s, Val(r)) THEN ThrowTypeError(r.s)
        ELSE LET p == Get(r.s, Val(r), SV("prototype")) IN
             IF IsAbrupt(p) THEN p
             ELSE IF ~IsObject(Val(p)) /\ Val(p) # Null THEN ThrowTypeError(p.s)
             ELSE Ok(p.s, [proto |-> Val(p), ctor |-> Val(r)])
  IN IF IsAbrupt(parents) THEN parents ELSE
     LET proto == OrdinaryObjectCreate(parents.s, Val(parents).proto)
         constructor == ConstructorMethodOf(tail)
         made ==
           IF constructor = Empty THEN
             LET a == Alloc(proto.s, BuiltinObject(Val(parents).ctor, <<"Class", "default">>, 0,
                                                   FunctionNameUnits(proto.s, class.name), TRUE, Empty, proto.s.realmId))
             IN Ok(a.s, a.v)
           ELSE
             LET m == DefineMethod(proto.s, class.ctx, constructor, Val(proto), Val(parents).ctor) IN
             IF IsAbrupt(m) THEN m
             ELSE Ok(SetFunctionName(MakeClassConstructor(m.s, Val(m).closure), Val(m).closure, class.name, <<>>),
                     Val(m).closure)
     IN IF IsAbrupt(made) THEN made ELSE
        LET F == Val(made)
            s2 == MakeConstructor(made.s, F, FALSE, Val(proto))
            s3 == SetO(s2, F, [O(s2, F) EXCEPT !.slots = [ctorKind |-> IF Has(tail.ClassHeritage) THEN "derived" ELSE "base",
                                                                 sourceText |-> class.sourceText] @@ @])
            s4 == CreateMethodProperty(s3, Val(proto), SV("constructor"), F).s
        IN ClassElementsThen(class, F, Val(proto),
                             ClassElementsEvaluation(s4, class.ctx, NonConstructorElements(tail), Val(proto), F,
                                                     [instance |-> <<>>, static |-> <<>>]))
\* Steps 26-33 of ClassDefinitionEvaluation, once the elements evaluated to r, their records
\* [instance, static]. The decorators of methods, then of fields, then of the class are applied,
\* and the class decorators' result is the class.
ClassElementsThen(class, F, proto, r) ==
  IF IsSuspended(r) THEN Pass(r, "ClassElementsThen", <<class, F, proto>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET els == Val(r)
      isDecorated == \E e \in Range(els.instance \o els.static) : e.kind # "staticBlock" /\ e.decorators # <<>>
      instanceExtra == NewInitializerList(r.s, isDecorated)
      staticExtra == NewInitializerList(instanceExtra.s, isDecorated)
      staticMethods == DecorateElements(staticExtra.s, F, els.static, staticExtra.v, TRUE, FALSE, <<>>)
      instanceMethods == DecorateElements(staticMethods.s, proto, els.instance, instanceExtra.v, FALSE, FALSE, <<>>)
      statics == DecorateElements(instanceMethods.s, F, Val(staticMethods), Empty, TRUE, TRUE, <<>>)
      instances == DecorateElements(statics.s, proto, Val(instanceMethods), Empty, FALSE, TRUE, <<>>)
  IN CASE IsAbrupt(staticMethods) -> staticMethods
       [] IsAbrupt(instanceMethods) -> instanceMethods
       [] IsAbrupt(statics) -> statics
       [] IsAbrupt(instances) -> instances
       [] OTHER ->
  LET s1 == SetO(instances.s, F, [O(instances.s, F) EXCEPT
                   !.slots = [privateMethods |-> PrivateMethodsOf(Val(instances), <<>>),
                              fields |-> SelectSeq(Val(instances), LAMBDA e : e.kind \in {"field", "accessor"}),
                              initializers |-> instanceExtra.v] @@ @])
      m == AddPrivateMethods(s1, F, PrivateMethodsOf(Val(statics), <<>>))
      classExtra == NewInitializerList(m.s, class.decorators # <<>>)
      decorated == ApplyClassDecorators(classExtra.s, F, class.decorators, class.name, classExtra.v)
  IN CASE IsAbrupt(m) -> m
       [] IsAbrupt(decorated) -> decorated
       [] OTHER ->
  LET C == Val(decorated)
      s2 == IF class.binding = Empty THEN decorated.s ELSE InitializeBinding(decorated.s, class.ctx.lex, class.binding, C).s
      i == CallInitializers(s2, C, InitializerList(s2, staticExtra.v))
      st == StaticElementsEvaluation(i.s, C, Val(statics))
      c == CallInitializers(st.s, C, InitializerList(st.s, classExtra.v))
  IN CASE IsAbrupt(i) -> i
       [] IsAbrupt(st) -> st
       [] IsAbrupt(c) -> c
       [] OTHER -> Ok(c.s, C)
\* Step 25 of ClassDefinitionEvaluation: each element's evaluation, sorted into its list.
ClassElementsEvaluation(s, ctx, elements, proto, F, acc) ==
  IF elements = <<>> THEN Ok(s, acc)
  ELSE ClassElementThen(ctx, elements, proto, F, acc,
                        ClassElementEvaluation(s, ctx, Head(elements), IF IsStaticElement(Head(elements)) THEN F ELSE proto))
ClassElementThen(ctx, elements, proto, F, acc, r) ==
  IF IsSuspended(r) THEN Pass(r, "ClassElementThen", <<ctx, elements, proto, F, acc>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE ClassElementsEvaluation(r.s, ctx, Tail(elements), proto, F,
                               IF IsStaticElement(Head(elements)) THEN [acc EXCEPT !.static = Append(@, Val(r))]
                               ELSE [acc EXCEPT !.instance = Append(@, Val(r))])
\* A ClassElementDefinition Record of the decorators proposal: kind "method", "getter", "setter",
\* "field", or "accessor", the key, the method, getter, or setter, an auto-accessor's storage, a
\* field's own initializer or Empty and the initializers its decorators returned, the list of
\* initializers its decorators add, and its Decorator Definition Records.
ElementRecord(kind, key) ==
  [kind |-> kind, key |-> key, value |-> Undefined, get |-> Undefined, set |-> Undefined, storage |-> Empty,
   init |-> Empty, initializers |-> <<>>, extra |-> Empty, decorators |-> <<>>]
\* ClassElementEvaluation (§15.7.13) of the decorators proposal: an element's ClassElementDefinition
\* Record, after its decorators are evaluated, or a static block [kind |-> "staticBlock", body].
ClassElementEvaluation(s, ctx, e, home) ==
  IF e.type = "ClassStaticBlock" THEN
    LET f == OrdinaryFunctionCreate(s, Intrinsic(s, "FunctionPrototype"), <<>>, <<>>, e.ClassStaticBlockBody,
                                    FALSE, ctx.lex, ctx.priv)
    IN Ok(MakeMethod(f.s, f.v, home), [kind |-> "staticBlock", body |-> f.v])
  ELSE LET d == DecoratorListEvaluation(s, ctx, DecoratorsOf(e))
           r == IF IsAbrupt(d) THEN d
                ELSE IF e.type = "FieldDefinition" THEN FieldKeyThen(ctx, e, home, EvaluatePropertyKey(d.s, ctx, e.ClassElementName))
                ELSE MethodElementThen(e, DefineMethod(d.s, ctx, e, home, Empty))
       IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, [Val(r) EXCEPT !.decorators = Val(d)])
MethodElementThen(n, m) ==
  IF IsSuspended(m) THEN Pass(m, "MethodElementThen", <<n>>) ELSE
  IF IsAbrupt(m) THEN m ELSE
  LET kind == MethodKind(n)
      key == Val(m).key
      f == Val(m).closure
  IN IF kind = "method" THEN
       Ok(GiveFunctionPrototype(SetFunctionName(m.s, f, key, <<>>), n.type, f), [ElementRecord("method", key) EXCEPT !.value = f])
     ELSE Ok(SetFunctionName(m.s, f, key, IF kind = "get" THEN N("get") ELSE N("set")),
             IF kind = "get" THEN [ElementRecord("getter", key) EXCEPT !.get = f]
             ELSE [ElementRecord("setter", key) EXCEPT !.set = f])
\* ClassFieldDefinitionEvaluation (§15.7.10) of the decorators proposal. An auto-accessor keeps its
\* value in a new Private Name, which its getter and setter read and write.
FieldKeyThen(ctx, e, home, r) ==
  IF IsSuspended(r) THEN Pass(r, "FieldKeyThen", <<ctx, e, home>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET key == Val(r)
      init == IF ~Has(e.Initializer) THEN [s |-> r.s, v |-> Empty]
              ELSE LET body == [type |-> "ClassFieldInitializer", Initializer |-> e.Initializer, strict |-> TRUE]
                       f == OrdinaryFunctionCreate(r.s, Intrinsic(r.s, "FunctionPrototype"), <<>>, <<>>, body, FALSE,
                                                   ctx.lex, ctx.priv)
                       s1 == MakeMethod(f.s, f.v, home)
                   IN [s |-> SetO(s1, f.v, [O(s1, f.v) EXCEPT !.slots.initializerName = key]), v |-> f.v]
  IN IF ~e.accessor THEN Ok(init.s, [ElementRecord("field", key) EXCEPT !.init = init.v]) ELSE
     LET storage == [type |-> "private", id |-> init.s.privateCount + 1,
                     description |-> FunctionNameUnits(init.s, key) \o N(" accessor storage")]
         s2 == [init.s EXCEPT !.privateCount = @ + 1]
         get == CreateBuiltinFunction(s2, <<"Class", "autoAccessorGet">>, 0, N("get ") \o FunctionNameUnits(s2, key), storage)
         set == CreateBuiltinFunction(get.s, <<"Class", "autoAccessorSet">>, 1, N("set ") \o FunctionNameUnits(s2, key), storage)
     IN Ok(set.s, [ElementRecord("accessor", key) EXCEPT !.init = init.v, !.get = Val(get), !.set = Val(set),
                                                         !.storage = storage])
\* Applies the decorators of the methods, getters, setters, and auto-accessors among elements and
\* defines them on home when isFields is FALSE, or those of the fields when it is TRUE, giving the
\* records with what the decorators returned. extra is the list a method's decorators add to.
DecorateElements(s, home, elements, extra, isStatic, isFields, acc) ==
  IF elements = <<>> THEN Ok(s, acc) ELSE
  LET e == Head(elements)
      r == CASE e.kind = "staticBlock" \/ (e.kind = "field") # isFields -> Ok(s, e)
             [] isFields -> ApplyElementDecorators(s, e, Empty, isStatic)
             [] OTHER -> DefineElementThen(home, ApplyElementDecorators(s, e, extra, isStatic))
  IN IF IsAbrupt(r) THEN r ELSE DecorateElements(r.s, home, Tail(elements), extra, isStatic, isFields, Append(acc, Val(r)))
\* DefineMethodProperty of the decorators proposal.
DefineElementThen(home, r) ==
  IF IsSuspended(r) THEN Pass(r, "DefineElementThen", <<home>>) ELSE
  IF IsAbrupt(r) \/ Val(r).key.type = "private" THEN r ELSE
  LET e == Val(r)
      d == DefinePropertyOrThrow(r.s, home, e.key,
             CASE e.kind = "method" -> DataDesc(e.value, TRUE, FALSE, TRUE)
               [] e.kind = "getter" -> AccessorDesc(e.get, Absent, FALSE, TRUE)
               [] e.kind = "setter" -> AccessorDesc(Absent, e.set, FALSE, TRUE)
               [] OTHER -> AccessorDesc(e.get, e.set, FALSE, TRUE))
  IN IF IsAbrupt(d) THEN d ELSE Ok(d.s, e)
\* The private methods and accessors among elements, a getter and setter of one name combined
\* (InitializePrivateMethods of the decorators proposal).
PrivateMethodsOf(elements, acc) ==
  IF elements = <<>> THEN acc ELSE
  LET e == Head(elements) IN
  PrivateMethodsOf(Tail(elements),
    CASE e.kind \in {"staticBlock", "field"} -> acc
      [] e.key.type # "private" -> acc
      [] e.kind = "method" -> Append(acc, PrivateElement(e.key, "method", e.value, Undefined, Undefined))
      [] e.kind = "accessor" -> Append(acc, PrivateElement(e.key, "accessor", Undefined, e.get, e.set))
      [] OTHER -> AddPrivateMethod(acc, PrivateElement(e.key, "accessor", Undefined, e.get, e.set)))
\* Adds a private method to a container, combining a getter and setter of the same name.
AddPrivateMethod(container, m) ==
  LET found == {i \in DOMAIN container : container[i].key.id = m.key.id} IN
  IF found = {} THEN Append(container, m)
  ELSE LET i == CHOOSE j \in found : TRUE
           existing == container[i]
       IN [container EXCEPT ![i] =
             IF m.get = Undefined THEN PrivateElement(m.key, "accessor", Undefined, existing.get, m.set)
             ELSE PrivateElement(m.key, "accessor", Undefined, m.get, existing.set)]
\* Steps 31-32 of ClassDefinitionEvaluation: the static fields, auto-accessors, and blocks.
StaticElementsEvaluation(s, F, elements) ==
  IF elements = <<>> THEN Ok(s, Empty)
  ELSE LET e == Head(elements)
           r == CASE e.kind \in {"field", "accessor"} -> InitializeFieldOrAccessor(s, F, e)
                  [] e.kind = "staticBlock" -> Call(s, e.body, F, <<>>)
                  [] OTHER -> Ok(s, Empty)
       IN IF IsAbrupt(r) THEN r ELSE StaticElementsEvaluation(r.s, F, Tail(elements))
\* DecoratorListEvaluation of the decorators proposal: a Decorator Definition Record
\* [decorator, receiver] for each node, the last first. The receiver is the this value a call
\* through the decorator's reference would have, where engine262 passes the decorator itself.
DecoratorListEvaluation(s, ctx, nodes) ==
  IF nodes = <<>> THEN Ok(s, <<>>) ELSE
  LET n == Head(nodes)
      ref == Evaluate(s, ctx, CASE Has(n.MemberExpression) -> n.MemberExpression
                                [] Has(n.CallExpression) -> n.CallExpression
                                [] OTHER -> n.ParenthesizedExpression)
      v == GetValue(ref.s, Val(ref))
      rest == DecoratorListEvaluation(v.s, ctx, Tail(nodes))
  IN CASE IsAbrupt(ref) -> ref
       [] IsAbrupt(v) -> v
       [] IsAbrupt(rest) -> rest
       [] OTHER -> Ok(rest.s, Val(rest) \o <<[decorator |-> Val(v), receiver |-> CallThisValue(v.s, Val(ref))]>>)
\* CreateDecoratorContextObject, returning [s, v, add] with add its addInitializer function, which
\* appends to list until the decorator returns.
DecoratorContext(s, kind, key, list, isStatic) ==
  LET add == CreateBuiltinFunction(s, <<"Class", "addInitializer">>, 1, N("addInitializer"), [list |-> list, isFinished |-> FALSE])
      access == IF kind = "class" THEN [s |-> add.s, v |-> Empty] ELSE DecoratorAccess(add.s, kind, key)
      o == OrdinaryObjectCreate(access.s, Intrinsic(access.s, "ObjectPrototype"))
      kindName == CASE kind = "class" -> SV("class") [] kind = "method" -> SV("method") [] kind = "getter" -> SV("getter")
                    [] kind = "setter" -> SV("setter") [] kind = "field" -> SV("field") [] kind = "accessor" -> SV("accessor")
      props == IF kind = "class" THEN <<<<SV("kind"), kindName>>, <<SV("name"), key>>, <<SV("addInitializer"), Val(add)>>>>
               ELSE <<<<SV("kind"), kindName>>, <<SV("access"), access.v>>, <<SV("static"), Bool(isStatic)>>,
                      <<SV("private"), Bool(key.type = "private")>>,
                      <<SV("name"), IF key.type = "private" THEN Str(key.description) ELSE key>>,
                      <<SV("addInitializer"), Val(add)>>>>
  IN [s |-> SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), props)), v |-> Val(o), add |-> Val(add)]
\* CreateDecoratorAccessObject.
DecoratorAccess(s, kind, key) ==
  LET get == CreateBuiltinFunction(s, <<"Class", "accessGet">>, 1, <<>>, key)
      set == CreateBuiltinFunction(get.s, <<"Class", "accessSet">>, 2, <<>>, key)
      has == CreateBuiltinFunction(set.s, <<"Class", "accessHas">>, 1, N("has"), key)
      o == OrdinaryObjectCreate(has.s, Intrinsic(has.s, "ObjectPrototype"))
      props == (IF kind \in {"field", "method", "accessor", "getter"} THEN <<<<SV("get"), Val(get)>>>> ELSE <<>>) \o
               (IF kind \in {"field", "accessor", "setter"} THEN <<<<SV("set"), Val(set)>>>> ELSE <<>>) \o
               <<<<SV("has"), Val(has)>>>>
  IN [s |-> SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), props)), v |-> Val(o)]
FinishDecoration(s, add) == SetO(s, add, [O(s, add) EXCEPT !.slots.data.isFinished = TRUE])
\* ApplyDecoratorsToElementDefinition: each decorator in turn is called with the element's value
\* and a context, and what it returns replaces the value or adds an initializer. A field's or
\* auto-accessor's decorators add to its own list, and a method's to extra.
ApplyElementDecorators(s, e, extra, isStatic) ==
  IF e.decorators = <<>> THEN Ok(s, e) ELSE
  LET list == IF e.kind \in {"field", "accessor"} THEN NewInitializerList(s, TRUE) ELSE [s |-> s, v |-> extra]
  IN ElementDecoratorsFrom(list.s, [e EXCEPT !.decorators = <<>>, !.extra = IF e.kind \in {"field", "accessor"} THEN list.v ELSE @],
                           e.decorators, list.v, isStatic)
ElementDecoratorsFrom(s, e, decorators, list, isStatic) ==
  IF decorators = <<>> THEN Ok(s, e) ELSE
  LET context == DecoratorContext(s, e.kind, e.key, list, isStatic)
      pair == IF e.kind # "accessor" THEN [s |-> context.s, v |-> Empty]
              ELSE LET o == OrdinaryObjectCreate(context.s, Intrinsic(context.s, "ObjectPrototype")) IN
                   [s |-> SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), <<<<SV("get"), e.get>>, <<SV("set"), e.set>>>>)), v |-> Val(o)]
      value == CASE e.kind = "method" -> e.value [] e.kind = "getter" -> e.get [] e.kind = "setter" -> e.set
                 [] e.kind = "accessor" -> pair.v [] OTHER -> Undefined
      r == Call(pair.s, Head(decorators).decorator, Head(decorators).receiver, <<value, context.v>>)
      updated == DecoratedElement(FinishDecoration(r.s, context.add), e, Val(r))
  IN CASE IsAbrupt(r) -> r
       [] IsAbrupt(updated) -> updated
       [] OTHER -> ElementDecoratorsFrom(updated.s, Val(updated), Tail(decorators), list, isStatic)
\* The element with what one of its decorators returned, v.
DecoratedElement(s, e, v) ==
  CASE e.kind = "accessor" /\ IsObject(v) -> DecoratedAccessor(s, e, v)
    [] v = Undefined -> Ok(s, e)
    [] e.kind = "accessor" \/ ~IsCallable(s, v) -> ThrowTypeError(s)
    [] e.kind = "field" -> Ok(s, [e EXCEPT !.initializers = <<v>> \o @])
    [] e.kind = "getter" -> Ok(s, [e EXCEPT !.get = v])
    [] e.kind = "setter" -> Ok(s, [e EXCEPT !.set = v])
    [] OTHER -> Ok(s, [e EXCEPT !.value = v])
DecoratedAccessor(s, e, v) ==
  LET get == Get(s, v, SV("get"))
      set == Get(get.s, v, SV("set"))
      init == Get(set.s, v, SV("init"))
  IN CASE IsAbrupt(get) -> get
       [] ~IsCallable(get.s, Val(get)) /\ Val(get) # Undefined -> ThrowTypeError(get.s)
       [] IsAbrupt(set) -> set
       [] ~IsCallable(set.s, Val(set)) /\ Val(set) # Undefined -> ThrowTypeError(set.s)
       [] IsAbrupt(init) -> init
       [] ~IsCallable(init.s, Val(init)) /\ Val(init) # Undefined -> ThrowTypeError(init.s)
       [] OTHER -> Ok(init.s, [e EXCEPT !.get = IF Val(get) = Undefined THEN @ ELSE Val(get),
                                        !.set = IF Val(set) = Undefined THEN @ ELSE Val(set),
                                        !.initializers = IF Val(init) = Undefined THEN @ ELSE <<Val(init)>> \o @])
\* ApplyDecoratorsToClassDefinition: each class decorator in turn may replace the class.
ApplyClassDecorators(s, F, decorators, name, list) ==
  IF decorators = <<>> THEN Ok(s, F) ELSE
  LET context == DecoratorContext(s, "class", name, list, FALSE)
      r == Call(context.s, Head(decorators).decorator, Head(decorators).receiver, <<F, context.v>>)
      s1 == FinishDecoration(r.s, context.add)
  IN CASE IsAbrupt(r) -> r
       [] Val(r) = Undefined -> ApplyClassDecorators(s1, F, Tail(decorators), name, list)
       [] IsCallable(s1, Val(r)) -> ApplyClassDecorators(s1, Val(r), Tail(decorators), name, list)
       [] OTHER -> ThrowTypeError(s1)
\* The built-in functions decorators reach: addInitializer, the access object's get, set, and has,
\* and an auto-accessor's getter and setter.
DecoratorBuiltin(s, f, m, this, args) ==
  LET data == O(s, f).slots.data
      obj == Arg(args, 1)
  IN CASE m = "addInitializer" /\ (data.isFinished \/ ~IsCallable(s, obj)) -> ThrowTypeError(s)
       [] m = "addInitializer" ->
            Ok(SetO(s, data.list, [O(s, data.list) EXCEPT !.slots.initializers = Append(@, obj)]), Undefined)
       [] m \in {"accessGet", "accessSet", "accessHas"} /\ ~IsObject(obj) -> ThrowTypeError(s)
       [] m = "accessGet" -> IF data.type = "private" THEN PrivateGet(s, obj, data) ELSE Get(s, obj, data)
       [] m = "accessSet" ->
            LET r == IF data.type = "private" THEN PrivateSet(s, obj, data, Arg(args, 2)) ELSE Set(s, obj, data, Arg(args, 2), TRUE)
            IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Undefined)
       [] m = "accessHas" ->
            IF data.type = "private" THEN Ok(s, Bool(PrivateElementFind(s, obj, data) # Empty)) ELSE HasProperty(s, obj, data)
       [] ~IsObject(this) -> ThrowTypeError(s)
       [] m = "autoAccessorGet" -> PrivateGet(s, this, data)
       [] OTHER -> LET r == PrivateSet(s, this, data, obj) IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Undefined)
\* BindingClassDeclarationEvaluation (§15.7.15).
\* decorators are the class's Decorator nodes, which an export declaration may hold in its place.
BindingClassDeclarationEvaluation(s, ctx, n, decorators) ==
  IF Has(n.BindingIdentifier) THEN
    ClassBindingThen(ctx, n.BindingIdentifier.name,
                     ClassDefinitionEvaluation(s, ctx, n.ClassTail, n.BindingIdentifier.name, Str(n.BindingIdentifier.name),
                                               n.sourceText, decorators))
  ELSE ClassDefinitionEvaluation(s, ctx, n.ClassTail, Empty, SV("default"), n.sourceText, decorators)
ClassBindingThen(ctx, name, r) ==
  IF IsSuspended(r) THEN Pass(r, "ClassBindingThen", <<ctx, name>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET b == InitializeBinding(r.s, ctx.lex, name, Val(r)) IN
  IF IsAbrupt(b) THEN b ELSE Ok(b.s, Val(r))
\* ClassExpression evaluation (§15.7.16).
EvaluateClassExpression(s, ctx, n, name) ==
  IF Has(n.BindingIdentifier) THEN
    ClassDefinitionEvaluation(s, ctx, n.ClassTail, n.BindingIdentifier.name, Str(n.BindingIdentifier.name), n.sourceText,
                              DecoratorsOf(n))
  ELSE ClassDefinitionEvaluation(s, ctx, n.ClassTail, Empty, IF name = Empty THEN EmptyStr ELSE name, n.sourceText,
                                 DecoratorsOf(n))
\* The default constructor (step 14.a of ClassDefinitionEvaluation).
DefaultConstructorCall(s, f, args, newTarget) ==
  IF newTarget = Undefined THEN ThrowTypeError(s)
  ELSE LET result ==
             IF O(s, f).slots.ctorKind = "derived" THEN
               LET func == O(s, f).proto IN
               IF ~IsConstructor(s, func) THEN ThrowTypeError(s) ELSE Construct(s, func, args, newTarget)
             ELSE OrdinaryCreateFromConstructor(s, newTarget, "ObjectPrototype", "ordinary", [none |-> TRUE])
       IN IF IsAbrupt(result) THEN result ELSE
          LET i == InitializeInstanceElements(result.s, Val(result), f) IN
          IF IsAbrupt(i) THEN i ELSE Ok(i.s, Val(result))
\* The super keyword (§13.3.7.1).
EvaluateSuperCall(s, ctx, n) ==
  LET thisEnv == GetThisEnvironment(s, ctx.lex)
      newTarget == E(s, thisEnv).newTarget
      func == O(s, E(s, thisEnv).fn).proto
  IN SuperCallThen(thisEnv, func, newTarget, ArgumentListEvaluation(s, ctx, n.Arguments))
SuperCallThen(thisEnv, func, newTarget, args) ==
  IF IsSuspended(args) THEN Pass(args, "SuperCallThen", <<thisEnv, func, newTarget>>) ELSE
  IF IsAbrupt(args) THEN args
  ELSE IF ~IsConstructor(args.s, func) THEN ThrowTypeError(args.s)
  ELSE LET result == Construct(args.s, func, Val(args), newTarget) IN
     IF IsAbrupt(result) THEN result ELSE
     LET b == BindThisValue(result.s, thisEnv, Val(result)) IN
     IF IsAbrupt(b) THEN b ELSE
     LET i == InitializeInstanceElements(b.s, Val(result), E(b.s, thisEnv).fn) IN
     IF IsAbrupt(i) THEN i ELSE Ok(i.s, Val(result))
\* The realm (§9.3). The state is a record:
\*   objs          the objects, a heap (HeapGet) by index
\*   envs          the environment records, a heap by index
\*   syms          each symbol's [[Description]], a string value or Undefined
\*   realm         the index of each intrinsic object of the current realm, by name
\*   globalEnv     the index of the current realm's global environment
\*   realmId       the index of the current realm in realms
\*   realms        each realm's [intrinsics, globalEnv], the first the one the host starts with
\*   privateCount  the number of Private Names made so far
\*   symbolRegistry  the GlobalSymbolRegistry of Symbol.for (§20.4.2.2)
\*   jobs          the pending jobs, as [kind, ...] records
\*   out           the lines print wrote
\* CreateRealm allocates the intrinsics in the order of Intrinsics, so the index of each is its
\* position there. A built-in function's id is <<family, name>>.
\* An intrinsic object: its name, its prototype's name or "" for null, its class, and slots. A
\* built-in function has a length and a name.
IntrinsicObject(name, proto, class, slots) ==
  [name |-> name, proto |-> proto, class |-> class, slots |-> slots, length |-> -1, fname |-> <<>>]
IntrinsicFunction(name, proto, id, length, fname, isConstructor) ==
  [name |-> name, proto |-> proto, class |-> "builtin",
   slots |-> [id |-> id, constructor |-> isConstructor, data |-> Empty, realm |-> 1, initialName |-> fname],
   length |-> length, fname |-> fname]
\* The intrinsic objects of realm number realm, with a built-in function's length and name, for
\* objects allocated after the first offset.
IntrinsicObjects(offset, realm) ==
  [i \in DOMAIN Intrinsics |->
     LET d == Intrinsics[i]
         base == MakeObject(IF d.proto = "" THEN Null ELSE Obj(offset + IntrinsicIndex[d.proto]), d.class,
                            IF d.class = "builtin" THEN [d.slots EXCEPT !.realm = realm] ELSE d.slots)
         \* %ThrowTypeError% (§10.2.4.1) is frozen.
         isFrozen == d.name = "ThrowTypeError"
     IN IF d.length < 0 THEN base
        ELSE [PutProp(PutProp(base, SV("length"), DataDesc(IntV(d.length), FALSE, FALSE, ~isFrozen)),
                      SV("name"), DataDesc(Str(d.fname), FALSE, FALSE, ~isFrozen))
              EXCEPT !.ext = ~isFrozen]]
\* Properties of the intrinsics, each one of
\*   [t |-> "m", o, k, id, len]          a built-in method, or with t "mfixed" a read-only one
\*   [t |-> "g", o, k, get, set]         an accessor of built-ins, set "" for none
\*   [t |-> "l", o, k, to, w, e, c]      an intrinsic as a data property
\*   [t |-> "v", o, k, v, w, e, c]       a value as a data property
\*   [t |-> "thrower", o, k]              an accessor whose get and set are %ThrowTypeError%
\* with o the intrinsic's name and k the key.
M(o, k, family, name, len) == [t |-> "m", o |-> o, k |-> k, id |-> <<family, name>>, len |-> len]
G(o, k, family, get, set) == [t |-> "g", o |-> o, k |-> k, get |-> <<family, get>>, set |-> <<family, set>>]
L(o, k, to, w, e, c) == [t |-> "l", o |-> o, k |-> k, to |-> to, w |-> w, e |-> e, c |-> c]
V(o, k, v, w, e, c) == [t |-> "v", o |-> o, k |-> k, v |-> v, w |-> w, e |-> e, c |-> c]
Ctor(o, p) == << L(o, SV("prototype"), p, FALSE, FALSE, FALSE), L(p, SV("constructor"), o, TRUE, FALSE, TRUE) >>
Thrower(o, k) == [t |-> "thrower", o |-> o, k |-> k]
GlobalLink(name, units) == L("GlobalObject", Str(units), name, TRUE, FALSE, TRUE)
\* The symbols the realm starts with: the well-known symbols, by description.
\* A built-in function object for a property, named by its key.
BuiltinForKey(s, id, len, k, prefix) ==
  LET units == FunctionNameUnits(s, k)
  IN Alloc(s, BuiltinObject(Intrinsic(s, "FunctionPrototype"), id, len,
                            IF prefix = <<>> THEN units ELSE prefix \o <<32>> \o units, FALSE, Empty, s.realmId))
AddRealmProperty(s, p) ==
  LET owner == Intrinsic(s, p.o) IN
  CASE p.t \in {"m", "mfixed"} ->
         LET f == BuiltinForKey(s, p.id, p.len, p.k, <<>>) IN
         SetO(f.s, owner, PutProp(O(f.s, owner), p.k, DataDesc(f.v, p.t = "m", FALSE, p.t = "m")))
    [] p.t = "g" ->
         LET g == BuiltinForKey(s, p.get, 0, p.k, N("get"))
             st == IF p.set[2] = "" THEN [s |-> g.s, v |-> Undefined] ELSE BuiltinForKey(g.s, p.set, 1, p.k, N("set"))
         IN SetO(st.s, owner, PutProp(O(st.s, owner), p.k, AccessorDesc(g.v, st.v, FALSE, TRUE)))
    [] p.t = "l" -> SetO(s, owner, PutProp(O(s, owner), p.k, DataDesc(Intrinsic(s, p.to), p.w, p.e, p.c)))
    [] p.t = "v" -> SetO(s, owner, PutProp(O(s, owner), p.k, DataDesc(p.v, p.w, p.e, p.c)))
    [] p.t = "thrower" ->
         SetO(s, owner, PutProp(O(s, owner), p.k,
              AccessorDesc(Intrinsic(s, "ThrowTypeError"), Intrinsic(s, "ThrowTypeError"), FALSE, TRUE)))
AddRealmProperties(s, ps) ==
  IF ps = <<>> THEN s ELSE AddRealmProperties(AddRealmProperty(s, Head(ps)), Tail(ps))
\* The environments of a realm whose intrinsics follow the first offset objects, for environments
\* allocated after the first envOffset: the global object's, the global declarative one, and the
\* global environment, last.
GlobalEnvironments(offset, envOffset) ==
  << [kind |-> "object", outer |-> 0, obj |-> Obj(offset + IntrinsicIndex["GlobalObject"]), withEnv |-> FALSE],
     [kind |-> "declarative", outer |-> 0, b |-> <<>>],
     [kind |-> "global", outer |-> 0, objRec |-> envOffset + 1, declRec |-> envOffset + 2,
      this |-> Obj(offset + IntrinsicIndex["GlobalObject"])] >>
\* Makes realm id the current one, as running code of a function of that realm does.
EnterRealm(s, id) ==
  IF id = s.realmId THEN s
  ELSE [s EXCEPT !.realmId = id, !.realm = s.realms[id].intrinsics, !.globalEnv = s.realms[id].globalEnv]
\* CreateRealm (§9.3.1), SetRealmGlobalObject, and SetDefaultGlobalBindings (§9.3.3) together, for
\* $262.createRealm: allocates a realm's intrinsics and environments after the state's, and
\* returns the realm's $262.
CreateRealm(s) ==
  LET offset == s.objs.size
      id == Len(s.realms) + 1
      intrinsics == [name \in DOMAIN IntrinsicIndex |-> offset + IntrinsicIndex[name]]
      s0 == HoldEnvs([s EXCEPT !.objs = HeapAppendFrom(@, IntrinsicObjects(offset, id), 1),
                               !.envs = HeapAppendFrom(@, GlobalEnvironments(offset, s.envs.size), 1),
                               !.realms = Append(@, [intrinsics |-> intrinsics, globalEnv |-> s.envs.size + 3])])
  IN Ok(EnterRealm(AddRealmProperties(EnterRealm(s0, id), RealmProperties), s.realmId), Obj(intrinsics["Host262"]))
\* The realm the host starts with. Its environments are the first three.
\* The context that script code of the current realm runs in, outside any private environment.
ScriptContext(s) == Context(s.globalEnv, s.globalEnv, NoPrivateEnvironment, Null)
\* The core built-in functions (§19 to §23).
Arg(args, i) == IF i <= Len(args) THEN args[i] ELSE Undefined
Rest(args, i) == IF i > Len(args) THEN <<>> ELSE SubSeq(args, i, Len(args))
Index(i) == Str(NumToString(i))
\* Function (§20.2).
FunctionBuiltin(s, f, m, this, args, nt) ==
  CASE m = "prototype" -> Ok(s, Undefined)
    [] m = "constructor" -> CreateDynamicFunction(s, f, nt, "normal", args)
    [] m = "throwTypeError" -> ThrowTypeError(s)
    [] m = "call" -> IF ~IsCallable(s, this) THEN ThrowTypeError(s) ELSE Call(s, this, Arg(args, 1), Rest(args, 2))
    [] m = "apply" ->
         IF ~IsCallable(s, this) THEN ThrowTypeError(s)
         ELSE IF IsNullish(Arg(args, 2)) THEN Call(s, this, Arg(args, 1), <<>>)
         ELSE LET l == CreateListFromArrayLike(s, Arg(args, 2), "all") IN
              IF IsAbrupt(l) THEN l ELSE Call(l.s, this, Arg(args, 1), Val(l))
    [] m = "bind" -> FunctionBind(s, this, Arg(args, 1), Rest(args, 2))
    [] m = "toString" ->
         IF ~IsCallable(s, this) THEN ThrowTypeError(s)
         ELSE LET slots == O(s, this).slots IN
              IF "sourceText" \in DOMAIN slots THEN Ok(s, Str(slots.sourceText))
              ELSE Ok(s, Str(N("function ") \o (IF "initialName" \in DOMAIN slots THEN NativeFunctionName(slots.initialName) ELSE <<>>)
                             \o N("() { [native code] }")))
    [] m = "hasInstance" -> OrdinaryHasInstance(s, this, Arg(args, 1))
    [] m \in {"caller", "arguments"} ->
         IF ~IsSloppyFunction(s, this) THEN ThrowTypeError(s) ELSE FunctionCallFrom(s, this, m, s.callers)
\* A built-in function's initial name as NativeFunction's accessor and PropertyName: as a computed
\* name holding a string literal when it isn't an identifier or a computed name, as for RegExp's
\* "get $&".
NativeFunctionName(name) ==
  LET accessor == IF Len(name) > 4 /\ SubSeq(name, 1, 4) \in {N("get "), N("set ")} THEN 4 ELSE 0
      key == SubSeq(name, accessor + 1, Len(name))
  IN IF key = <<>> \/ key[1] = 91 \/ \A i \in DOMAIN key : IsAsciiIdentifierUnit(key[i]) THEN name
     ELSE SubSeq(name, 1, accessor) \o N("[\"") \o key \o N("\"]")
IsAsciiIdentifierUnit(c) == c = 36 \/ c = 95 \/ (c >= 48 /\ c <= 57) \/ (c >= 65 /\ c <= 90) \/ (c >= 97 /\ c <= 122)
\* The function that made the innermost active call of f, when it is non-strict, and otherwise null;
\* or a fresh arguments object of that call's arguments, or null when f is not active.
IsSloppyFunction(s, f) == IsObject(f) /\ O(s, f).class = "function" /\ ~O(s, f).slots.strict
FunctionCallFrom(s, f, m, frame) ==
  CASE frame = Null -> Ok(s, Null)
    [] frame.f # f -> FunctionCallFrom(s, f, m, frame.next)
    [] m = "arguments" -> LET a == CreateUnmappedArgumentsObject(s, frame.args) IN Ok(a.s, a.v)
    [] frame.next # Null /\ IsSloppyFunction(s, frame.next.f) -> Ok(s, frame.next.f)
    [] OTHER -> Ok(s, Null)
\* Function.prototype.bind (§20.2.3.2).
FunctionBind(s, target, this, args) ==
  IF ~IsCallable(s, target) THEN ThrowTypeError(s)
  ELSE LET F == BoundFunctionCreate(s, target, this, args) IN IF IsAbrupt(F) THEN F
  ELSE CopyNameAndLength(F.s, Val(F), target, N("bound"), Len(args))
\* CopyNameAndLength (§10.2.10), with prefix <<>> for none: F's length and name from target's.
CopyNameAndLength(s, F, target, prefix, argCount) ==
  LET has == HasOwnProperty(s, target, SV("length")) IN IF IsAbrupt(has) THEN has ELSE
  LET len == IF Val(has) = False THEN Ok(has.s, PosZero)
             ELSE LET l == Get(has.s, target, SV("length")) IN
                  IF IsAbrupt(l) \/ ~IsNumber(Val(l)) THEN [s |-> l.s, c |-> IF IsAbrupt(l) THEN l.c ELSE NormalCompletion(PosZero)]
                  ELSE LET x == Val(l).value IN
                       IF x = PosInf THEN Ok(l.s, PosInf)
                       ELSE IF x = NegInf THEN Ok(l.s, PosZero)
                       ELSE LET n == NumSub(NumToIntegerOrInfinity(x), NumFromInt(argCount)) IN
                            Ok(l.s, IF NumLess(n, PosZero) THEN PosZero ELSE NumAdd(n, PosZero))
  IN IF IsAbrupt(len) THEN len ELSE
     LET s1 == SetO(len.s, F, PutProp(O(len.s, F), SV("length"), DataDesc(Num(Val(len)), FALSE, FALSE, TRUE)))
         name == Get(s1, target, SV("name"))
     IN IF IsAbrupt(name) THEN name
        ELSE Ok(SetFunctionName(name.s, F, IF IsString(Val(name)) THEN Val(name) ELSE EmptyStr, prefix), F)
\* A relative index argument (as Array.prototype.slice reads start and end), clamped to 0..len.
RelativeIndex(s, v, len, default) ==
  IF v = Undefined THEN Ok(s, default)
  ELSE LET n == ToIntegerOrInfinity(s, v) IN IF IsAbrupt(n) THEN n ELSE
       LET x == Val(n).value IN
       Ok(n.s, CASE x = NegInf -> PosZero
                 [] NumLess(x, PosZero) -> (LET k == NumAdd(len, x) IN IF NumLess(k, PosZero) THEN PosZero ELSE k)
                 [] NumLess(len, x) -> len
                 [] OTHER -> NumAdd(x, PosZero))
\* %ForInIteratorPrototype%.next (§14.7.5.10.2.1).
ForInIteratorNext(s, this) ==
  LET slots == O(s, this).slots IN
  IF slots.object = Null THEN CreateIterResultObject(s, Undefined, TRUE)
  ELSE LET loaded ==
             IF slots.visited THEN Ok(s, slots.remaining)
             ELSE LET ks == OwnPropertyKeys(s, slots.object) IN
                  IF IsAbrupt(ks) THEN ks ELSE Ok(ks.s, SelectSeq(Val(ks), IsString))
       IN IF IsAbrupt(loaded) THEN loaded
          ELSE ForInRemaining(loaded.s, this, slots.object, Val(loaded), slots.visitedKeys)
ForInRemaining(s, this, object, remaining, visitedKeys) ==
  IF remaining = <<>> THEN
    LET p == GetPrototypeOf(s, object) IN IF IsAbrupt(p) THEN p ELSE
    LET s1 == SetO(p.s, this, [O(p.s, this) EXCEPT !.slots.object = Val(p), !.slots.visited = FALSE,
                                                   !.slots.remaining = <<>>, !.slots.visitedKeys = visitedKeys])
    IN ForInIteratorNext(s1, this)
  ELSE LET r == Head(remaining) IN
  IF r \in Range(visitedKeys) THEN ForInRemaining(s, this, object, Tail(remaining), visitedKeys)
  ELSE LET d == GetOwnProperty(s, object, r) IN IF IsAbrupt(d) THEN d
  ELSE IF Val(d) = Absent THEN ForInRemaining(d.s, this, object, Tail(remaining), visitedKeys)
  ELSE IF Val(d).enumerable # True THEN ForInRemaining(d.s, this, object, Tail(remaining), Append(visitedKeys, r))
  ELSE CreateIterResultObject(SetO(d.s, this, [O(d.s, this) EXCEPT !.slots.visited = TRUE, !.slots.remaining = Tail(remaining),
                                                                   !.slots.visitedKeys = Append(visitedKeys, r)]), r, FALSE)
\* Functions of the global object and the test262 host.
GlobalBuiltin(s, f, m, this, args, nt) ==
  CASE m = "print" ->
         LET str == ToStr(s, Arg(args, 1)) IN IF IsAbrupt(str) THEN str
         ELSE Ok([str.s EXCEPT !.out = Append(@, Val(str).value)], Undefined)
    [] m = "gc" -> Ok(s, Undefined)
    \* $262.IsHTMLDDA, which returns null when called with no arguments or "".
    [] m = "IsHTMLDDA" -> Ok(s, Null)
    [] m = "evalScript" -> EvalScript(s, Arg(args, 1))
    [] m = "eval" -> PerformEval(s, ScriptContext(s), Arg(args, 1), FALSE, FALSE)
    [] m = "createRealm" -> CreateRealm(s)
    [] OTHER -> Unsupported(s, N("Unsupported: $262 host function"))
IteratorBuiltin(s, f, m, this, args, nt) == Ok(s, this)
ForInIteratorBuiltin(s, f, m, this, args, nt) == ForInIteratorNext(s, this)
ClassBuiltin(s, f, m, this, args, nt) ==
  IF m = "default" THEN DefaultConstructorCall(s, f, args, nt) ELSE DecoratorBuiltin(s, f, m, this, args)
\* Number (§21.1), Math (§21.3), and the global functions on numbers and URIs (§19.2).
\* Number (§21.1).
ThisNumberValue(s, v) ==
  IF IsNumber(v) THEN Ok(s, v)
  ELSE IF IsObject(v) /\ O(s, v).class = "number" THEN Ok(s, O(s, v).slots.data)
  ELSE ThrowTypeError(s)
BigIntToNumber(b) == NumFromBigNat(b.neg, b.mag, 0)
\* Whether an integral Number n lies in low..high.
IsInRange(n, low, high) == ~NumLess(n, NumFromInt(low)) /\ ~NumLess(NumFromInt(high), n)
NumberBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1) IN
  CASE m = "constructor" ->
         \* §21.1.1.1
         LET n == IF args = <<>> THEN Ok(s, IntV(0))
                  ELSE LET p == ToNumeric(s, a1) IN
                       IF IsAbrupt(p) THEN p ELSE IF IsBigInt(Val(p)) THEN Ok(p.s, Num(BigIntToNumber(Val(p).value))) ELSE p
         IN IF IsAbrupt(n) \/ nt = Undefined THEN n
            ELSE OrdinaryCreateFromConstructor(n.s, nt, "NumberPrototype", "number", [data |-> Val(n)])
    \* §21.1.2.2 to §21.1.2.5
    [] m = "isFinite" -> Ok(s, Bool(IsNumber(a1) /\ NumIsFinite(a1.value)))
    [] m = "isInteger" -> Ok(s, Bool(IsNumber(a1) /\ NumIsFinite(a1.value) /\ NumIsIntegral(a1.value)))
    [] m = "isNaN" -> Ok(s, Bool(IsNumber(a1) /\ NumIsNaN(a1.value)))
    [] m = "isSafeInteger" ->
         Ok(s, Bool(IsNumber(a1) /\ NumIsFinite(a1.value) /\ NumIsIntegral(a1.value) /\
                    ~NumLess(MaxSafeInteger, NumAbs(a1.value))))
    \* §21.1.3.7
    [] m = "valueOf" -> ThisNumberValue(s, this)
    [] OTHER ->
         LET x == ThisNumberValue(s, this) IN IF IsAbrupt(x) THEN x
         ELSE NumberPrototypeMethod(x.s, Val(x).value, m, IF m = "toLocaleString" THEN <<>> ELSE args)
\* The Number.prototype methods that format the Number x.
NumberPrototypeMethod(s, x, m, args) ==
  LET a1 == Arg(args, 1)
      digits == ToIntegerOrInfinity(s, a1)
      count == NumToSmallInt(Val(digits).value)
  IN
  CASE m = "toExponential" ->
         \* §21.1.3.2
         IF IsAbrupt(digits) THEN digits
         ELSE IF ~NumIsFinite(x) THEN Ok(digits.s, Str(NumToString(x)))
         ELSE IF ~IsInRange(Val(digits).value, 0, 100) THEN ThrowError(digits.s, "RangeError")
         ELSE Ok(digits.s, Str(IF a1 = Undefined THEN NumToShortestExponential(x) ELSE NumToExponential(x, count)))
    [] m = "toFixed" ->
         \* §21.1.3.3
         IF IsAbrupt(digits) THEN digits
         ELSE IF ~IsInRange(Val(digits).value, 0, 100) THEN ThrowError(digits.s, "RangeError")
         ELSE Ok(digits.s, Str(IF NumIsFinite(x) THEN NumToFixed(x, count) ELSE NumToString(x)))
    [] m = "toPrecision" ->
         \* §21.1.3.5
         IF a1 = Undefined THEN Ok(s, Str(NumToString(x)))
         ELSE IF IsAbrupt(digits) THEN digits
         ELSE IF ~NumIsFinite(x) THEN Ok(digits.s, Str(NumToString(x)))
         ELSE IF ~IsInRange(Val(digits).value, 1, 100) THEN ThrowError(digits.s, "RangeError")
         ELSE Ok(digits.s, Str(NumToPrecision(x, count)))
    [] m \in {"toString", "toLocaleString"} ->
         \* §21.1.3.6, §21.1.3.4
         LET r == IF a1 = Undefined THEN Ok(s, IntV(10)) ELSE digits IN
         IF IsAbrupt(r) THEN r
         ELSE IF ~IsInRange(Val(r).value, 2, 36) THEN ThrowError(r.s, "RangeError")
         ELSE Ok(r.s, Str(NumToStringRadix(x, NumToSmallInt(Val(r).value))))
\* The global functions isNaN, isFinite, parseInt, and parseFloat (§19.2).
NumberGlobalBuiltin(s, f, m, this, args, nt) ==
  CASE m \in {"isNaN", "isFinite"} ->
         \* §19.2.2, §19.2.3
         LET n == ToNumber(s, Arg(args, 1)) IN IF IsAbrupt(n) THEN n
         ELSE Ok(n.s, Bool(IF m = "isNaN" THEN NumIsNaN(Val(n).value) ELSE NumIsFinite(Val(n).value)))
    [] m = "parseFloat" ->
         \* §19.2.4
         LET str == ToStr(s, Arg(args, 1)) IN IF IsAbrupt(str) THEN str
         ELSE Ok(str.s, Num(ParseFloatUnits(Val(str).value)))
    [] m = "parseInt" ->
         \* §19.2.5
         LET str == ToStr(s, Arg(args, 1)) IN IF IsAbrupt(str) THEN str ELSE
         LET radix == ToInt32(str.s, Arg(args, 2)) IN IF IsAbrupt(radix) THEN radix
         ELSE Ok(radix.s, Num(ParseIntUnits(Val(str).value, NumToInt(Val(radix).value))))
\* Math (§21.3).
ToNumberList(s, values, acc) ==
  IF values = <<>> THEN Ok(s, acc)
  ELSE LET n == ToNumber(s, Head(values)) IN
       IF IsAbrupt(n) THEN n ELSE ToNumberList(n.s, Tail(values), Append(acc, Val(n).value))
\* The Math functions of one Number (§21.3.2).
MathOf(m, x) ==
  CASE m = "abs" -> MathAbs(x)
    [] m = "acos" -> MathAcos(x)
    [] m = "acosh" -> MathAcosh(x)
    [] m = "asin" -> MathAsin(x)
    [] m = "asinh" -> MathAsinh(x)
    [] m = "atan" -> MathAtan(x)
    [] m = "atanh" -> MathAtanh(x)
    [] m = "cbrt" -> MathCbrt(x)
    [] m = "ceil" -> MathCeil(x)
    [] m = "clz32" -> MathClz32(x)
    [] m = "cos" -> MathCos(x)
    [] m = "cosh" -> MathCosh(x)
    [] m = "exp" -> MathExp(x)
    [] m = "expm1" -> MathExpm1(x)
    [] m = "f16round" -> MathF16round(x)
    [] m = "floor" -> MathFloor(x)
    [] m = "fround" -> MathFround(x)
    [] m \in {"log", "log2", "log10"} -> MathLogarithm(m, x)
    [] m = "log1p" -> MathLog1p(x)
    [] m = "round" -> MathRound(x)
    [] m = "sign" -> MathSign(x)
    [] m = "sin" -> MathSin(x)
    [] m = "sinh" -> MathSinh(x)
    [] m = "sqrt" -> MathSqrt(x)
    [] m = "tan" -> MathTan(x)
    [] m = "tanh" -> MathTanh(x)
    [] m = "trunc" -> MathTrunc(x)
MathBuiltin(s, f, m, this, args, nt) ==
  CASE m \in {"atan2", "hypot", "imul", "max", "min", "pow"} ->
         LET l == ToNumberList(s, IF m \in {"hypot", "max", "min"} THEN args ELSE <<Arg(args, 1), Arg(args, 2)>>, <<>>)
             n == Val(l)
         IN IF IsAbrupt(l) THEN l
            ELSE Ok(l.s, Num(CASE m = "atan2" -> MathAtan2(n[1], n[2])
                               [] m = "hypot" -> MathHypot(n)
                               [] m = "imul" -> MathImul(n[1], n[2])
                               [] m = "max" -> MathMax(n)
                               [] m = "min" -> MathMin(n)
                               [] m = "pow" -> NumExponentiate(n[1], n[2])))
    [] m = "random" -> MathRandom(s)
    [] m = "sumPrecise" ->
         \* §21.3.2.34
         IF IsNullish(Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET it == GetIterator(s, Arg(args, 1), "sync") IN
              IF IsAbrupt(it) THEN it ELSE SumPrecise(it.s, Val(it), "minus-zero", <<FALSE, <<>>>>)
    [] OTHER ->
         LET n == ToNumber(s, Arg(args, 1)) IN IF IsAbrupt(n) THEN n ELSE Ok(n.s, Num(MathOf(m, Val(n).value)))
\* Math.sumPrecise's loop over the iterator: state is "minus-zero", "finite", "plus-infinity",
\* "minus-infinity", or "not-a-number", and sum the signed exact sum in units of 2^-1074.
SumPrecise(s, it, state, sum) ==
  LET next == IteratorStepValue(s, it) IN
  IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN
    Ok(next.s, Num(CASE state = "not-a-number" -> NaN
                     [] state = "plus-infinity" -> PosInf
                     [] state = "minus-infinity" -> NegInf
                     [] state = "minus-zero" -> NegZero
                     [] sum[2] = <<>> -> PosZero
                     [] OTHER -> NumFromBigNat(sum[1], sum[2], -1074)))
  ELSE IF ~IsNumber(Val(next).value) THEN
    LET error == ThrowTypeError(next.s) IN IteratorClose(error.s, Val(next).iterator, error.c)
  ELSE
    LET n == Val(next).value.value
        isFinite == state \in {"minus-zero", "finite"} /\ NumIsFinite(n) /\ n # NegZero
    IN SumPrecise(next.s, Val(next).iterator,
         CASE state = "not-a-number" \/ n.k = "nan" -> "not-a-number"
           [] n = PosInf -> IF state = "minus-infinity" THEN "not-a-number" ELSE "plus-infinity"
           [] n = NegInf -> IF state = "plus-infinity" THEN "not-a-number" ELSE "minus-infinity"
           [] isFinite -> "finite"
           [] OTHER -> state,
         IF isFinite THEN SignedAdd(sum, <<n.neg, BNShiftLeft(NumMag(n), NumExponent(n) + 1074)>>) ELSE sum)
\* Math.random (§21.3.2.27) as engine262 computes it: xorshift128+ on a state that the realm
\* seeds with fmix64 of a seed and of its complement. engine262 takes the seed from the host or
\* at random; here it is 0, so runs are deterministic. Like engine262's BigInt code, the steps
\* keep every bit and only the stored state is cut to 64 bits.
BNXor(a, b) ==
  BNNorm([i \in 1..NumIntMax(Len(a), Len(b)) |-> BitwiseInt("xor", BNLimb(a, i), BNLimb(b, i))])
Fmix64(h) ==
  LET h1 == BNMul(BNXor(h, BNShiftRight(h, 33)), DigitsValue(N("FF51AFD7ED558CCD"), 1, 16, <<>>))
      h2 == BNMul(BNXor(h1, BNShiftRight(h1, 33)), DigitsValue(N("C4CEB9FE1A85EC53"), 1, 16, <<>>))
  IN BNLowBits(BNXor(h2, BNShiftRight(h2, 33)), 64)
MathRandom(s) ==
  LET math == Intrinsic(s, "Math")
      state == O(s, math).slots.randomState
      s0 == state[2]
      x1 == BNXor(state[1], BNShiftLeft(state[1], 23))
      x2 == BNXor(x1, BNShiftRight(x1, 17))
      x3 == BNXor(BNXor(x2, s0), BNShiftRight(s0, 26))
  IN Ok(SetO(s, math, [O(s, math) EXCEPT !.slots.randomState = <<s0, BNLowBits(x3, 64)>>]),
        Num(NumFromBigNat(FALSE, BNShiftRight(s0, 12), -52)))
\* URI handling (§19.2.6), and escape (§B.2.1.1) and unescape (§B.2.1.2).
URIBuiltin(s, f, m, this, args, nt) ==
  LET str == ToStr(s, Arg(args, 1)) IN
  IF IsAbrupt(str) THEN str
  ELSE CASE m = "decodeURI" -> Decode(str.s, Val(str).value, URIReserved, 1, <<>>)
         [] m = "decodeURIComponent" -> Decode(str.s, Val(str).value, {}, 1, <<>>)
         [] m = "encodeURI" -> Encode(str.s, Val(str).value, URIUnescaped \cup URIReserved, 1, <<>>)
         [] m = "encodeURIComponent" -> Encode(str.s, Val(str).value, URIUnescaped, 1, <<>>)
         [] m = "escape" -> Ok(str.s, Str(Escape(Val(str).value)))
         [] m = "unescape" -> Ok(str.s, Str(Unescape(Val(str).value, 1, <<>>)))
IsLeadSurrogate(u) == u >= 55296 /\ u <= 56319
IsTrailSurrogate(u) == u >= 56320 /\ u <= 57343
\* The octets of the UTF-8 encoding of a code point.
UTF8Encode(cp) ==
  CASE cp < 128 -> <<cp>>
    [] cp < 2048 -> <<192 + cp \div 64, 128 + (cp % 64)>>
    [] cp < 65536 -> <<224 + cp \div 4096, 128 + ((cp \div 64) % 64), 128 + (cp % 64)>>
    [] OTHER -> <<240 + cp \div 262144, 128 + ((cp \div 4096) % 64), 128 + ((cp \div 64) % 64), 128 + (cp % 64)>>
HexDigit(d) == IF d < 10 THEN 48 + d ELSE 55 + d
PercentEncode(octets) == Concat([i \in DOMAIN octets |-> <<37, HexDigit(octets[i] \div 16), HexDigit(octets[i] % 16)>>])
Escape(string) ==
  Concat([k \in DOMAIN string |->
           LET c == string[k] IN
           CASE c \in EscapeUnescaped -> <<c>>
             [] c < 256 -> <<37, HexDigit(c \div 16), HexDigit(c % 16)>>
             [] OTHER -> <<37, 117, HexDigit(c \div 4096), HexDigit((c \div 256) % 16), HexDigit((c \div 16) % 16), HexDigit(c % 16)>>])
\* unescape's loop from index k of string on, with acc the result so far: %uXXXX and %XX become the
\* code unit they spell, and a % without hex digits after it stays.
Unescape(string, k, acc) ==
  IF k > Len(string) THEN acc
  ELSE LET digits == CASE string[k] # 37 -> <<>>
                       [] k + 5 <= Len(string) /\ string[k + 1] = 117 -> SubSeq(string, k + 2, k + 5)
                       [] k + 2 <= Len(string) -> SubSeq(string, k + 1, k + 2)
                       [] OTHER -> <<>>
           value == [i \in DOMAIN digits |-> NumDigitValue(digits[i])]
       IN IF digits # <<>> /\ \A i \in DOMAIN value : value[i] < 16
          THEN Unescape(string, k + Len(digits) + (IF Len(digits) = 4 THEN 2 ELSE 1),
                        Append(acc, IF Len(digits) = 4 THEN ((value[1] * 16 + value[2]) * 16 + value[3]) * 16 + value[4]
                                    ELSE value[1] * 16 + value[2]))
          ELSE Unescape(string, k + 1, Append(acc, string[k]))
\* Encode (§19.2.6.5) from index k of string on, with acc the result so far.
Encode(s, string, unescaped, k, acc) ==
  IF k > Len(string) THEN Ok(s, Str(acc))
  ELSE LET c == string[k] IN
  IF c \in unescaped THEN Encode(s, string, unescaped, k + 1, Append(acc, c))
  ELSE IF IsTrailSurrogate(c) \/ (IsLeadSurrogate(c) /\ (k = Len(string) \/ ~IsTrailSurrogate(string[k + 1])))
  THEN ThrowError(s, "URIError")
  ELSE IF IsLeadSurrogate(c)
  THEN Encode(s, string, unescaped, k + 2,
              acc \o PercentEncode(UTF8Encode((c - 55296) * 1024 + string[k + 1] - 56320 + 65536)))
  ELSE Encode(s, string, unescaped, k + 1, acc \o PercentEncode(UTF8Encode(c)))
\* ParseHexOctet (§19.2.6.7): the octet that the two hex digits at index k of string spell, or -1.
ParseHexOctet(string, k) ==
  IF k + 1 <= Len(string) /\ NumDigitValue(string[k]) < 16 /\ NumDigitValue(string[k + 1]) < 16
  THEN NumDigitValue(string[k]) * 16 + NumDigitValue(string[k + 1])
  ELSE -1
\* The number of leading 1 bits of an octet.
LeadingOnes(b) == CASE b < 128 -> 0 [] b < 192 -> 1 [] b < 224 -> 2 [] b < 240 -> 3 [] b < 248 -> 4 [] OTHER -> 5
\* The escapes %XX of the continuation octets from index k of string on, as octets, or <<>> when
\* one is missing or not of the form 10xxxxxx.
ContinuationOctets(string, k, count) ==
  IF count = 0 THEN <<>>
  ELSE IF k > Len(string) \/ string[k] # 37 THEN <<-1>>
  ELSE LET b == ParseHexOctet(string, k + 1) IN
       IF b < 128 \/ b >= 192 THEN <<-1>> ELSE <<b>> \o ContinuationOctets(string, k + 3, count - 1)
\* The code point that n UTF-8 octets encode, starting with the lead octet b, or -1 when they
\* are an overlong form, a surrogate, or above U+10FFFF.
UTF8Decode(b, rest) ==
  LET n == Len(rest) + 1
      cp == AppendSixBits(b % (2 ^ (7 - n)), rest, 1)
  IN IF \E i \in DOMAIN rest : rest[i] < 0 THEN -1
     ELSE IF (n = 2 /\ cp < 128) \/ (n = 3 /\ cp < 2048) \/ (n = 4 /\ cp < 65536) \/ cp > 1114111 \/
             (cp >= 55296 /\ cp <= 57343)
     THEN -1 ELSE cp
AppendSixBits(value, octets, i) ==
  IF i > Len(octets) THEN value ELSE AppendSixBits(value * 64 + (octets[i] % 64), octets, i + 1)
\* Decode (§19.2.6.6) from index k of string on, with acc the result so far.
Decode(s, string, preserved, k, acc) ==
  IF k > Len(string) THEN Ok(s, Str(acc))
  ELSE IF string[k] # 37 THEN Decode(s, string, preserved, k + 1, Append(acc, string[k]))
  ELSE LET b == ParseHexOctet(string, k + 1)
           n == LeadingOnes(b)
           cp == UTF8Decode(b, ContinuationOctets(string, k + 3, n - 1))
       IN CASE b < 0 \/ n = 1 \/ n > 4 -> ThrowError(s, "URIError")
            [] n = 0 -> Decode(s, string, preserved, k + 3,
                               acc \o (IF b \in preserved THEN SubSeq(string, k, k + 2) ELSE <<b>>))
            [] cp < 0 -> ThrowError(s, "URIError")
            [] OTHER -> Decode(s, string, preserved, k + 3 * n, acc \o UTF16EncodeCodePoint(cp))
\* The JSON object (§25.5), with JSON.rawJSON and JSON.isRawJSON and the reviver's source context
\* of the JSON.parse source text access proposal, as engine262 has them.
JSONBuiltin(s, f, m, this, args, nt) ==
  CASE m = "parse" -> JSONParse(s, Arg(args, 1), Arg(args, 2))
    [] m = "stringify" -> JSONStringify(s, Arg(args, 1), Arg(args, 2), Arg(args, 3))
    [] m = "rawJSON" -> JSONRawJSON(s, Arg(args, 1))
    [] m = "isRawJSON" -> Ok(s, Bool(IsObject(Arg(args, 1)) /\ O(s, Arg(args, 1)).class = "rawJSON"))
\* JSON.parse (§25.5.1). ParseJSON checks the text against ECMA-404 and gives its parse tree, which
\* JSONEvaluate turns into a value as evaluating the text as a script would.
JSONParse(s, text, reviver) ==
  LET str == ToStr(s, text) IN IF IsAbrupt(str) THEN str ELSE
  LET tree == ParseJSON(Val(str).value) IN
  IF tree = None THEN ThrowError(str.s, "SyntaxError")
  ELSE LET result == JSONEvaluate(str.s, tree) IN
       IF ~IsCallable(result.s, reviver) THEN Ok(result.s, result.v)
       ELSE LET root == OrdinaryObjectCreate(result.s, Intrinsic(result.s, "ObjectPrototype")) IN
            LET c == CreateDataPropertyOrThrow(root.s, Val(root), EmptyStr, result.v) IN
            InternalizeJSONProperty(c.s, Val(root), EmptyStr, reviver, result.record)
\* The parse tree of a JSON text, or None. A node is a value with its source text, an array of
\* nodes, or an object of <<key, node>> members.
ParseJSON(units) ==
  LET r == JSONValue(units, JSONWhitespace(units, 1)) IN
  IF r.ok /\ r.i = Len(units) + 1 THEN r.node ELSE None
\* A parsed node, with the index after it and the whitespace that follows.
JSONNode(units, node, i) == [ok |-> TRUE, node |-> node, i |-> JSONWhitespace(units, i)]
JSONPrimitive(units, value, from, to) ==
  JSONNode(units, [type |-> "value", value |-> value, source |-> SubSeq(units, from, to - 1)], to)
JSONWhitespace(units, i) ==
  IF i <= Len(units) /\ units[i] \in {9, 10, 13, 32} THEN JSONWhitespace(units, i + 1) ELSE i
JSONHas(units, i, word) == i + Len(word) - 1 <= Len(units) /\ SubSeq(units, i, i + Len(word) - 1) = word
\* The node of the JSON value at index i.
JSONValue(units, i) ==
  IF i > Len(units) THEN JSONFail
  ELSE LET c == units[i] IN
  CASE c = 34 ->
         LET r == JSONString(units, i + 1, <<>>) IN
         IF r.ok THEN JSONPrimitive(units, Str(r.units), i, r.i) ELSE r
    [] c = 123 -> JSONObject(units, JSONWhitespace(units, i + 1), <<>>)
    [] c = 91 -> JSONArray(units, JSONWhitespace(units, i + 1), <<>>)
    [] c = 45 \/ IsDigit(c) ->
         LET end == JSONNumberEnd(units, i) IN
         IF end = 0 THEN JSONFail ELSE JSONPrimitive(units, Num(StrToNum(SubSeq(units, i, end - 1))), i, end)
    [] JSONHas(units, i, N("true")) -> JSONPrimitive(units, True, i, i + 4)
    [] JSONHas(units, i, N("false")) -> JSONPrimitive(units, False, i, i + 5)
    [] JSONHas(units, i, N("null")) -> JSONPrimitive(units, Null, i, i + 4)
    [] OTHER -> JSONFail
\* A string's code units after its opening quote at i - 1, with the index after its closing quote.
JSONString(units, i, acc) ==
  IF i > Len(units) THEN JSONFail
  ELSE LET c == units[i] IN
  CASE c = 34 -> [ok |-> TRUE, units |-> acc, i |-> i + 1]
    [] c < 32 -> JSONFail
    [] c = 92 /\ i < Len(units) ->
         LET e == units[i + 1]
             escaped == CASE e \in {34, 47, 92} -> e [] e = 98 -> 8 [] e = 102 -> 12 [] e = 110 -> 10
                          [] e = 114 -> 13 [] e = 116 -> 9 [] OTHER -> -1
         IN IF escaped >= 0 THEN JSONString(units, i + 2, Append(acc, escaped))
            ELSE IF e = 117 /\ i + 5 <= Len(units) /\ \A k \in i + 2..i + 5 : IsHexDigit(units[k])
            THEN JSONString(units, i + 6, Append(acc, ((NumDigitValue(units[i + 2]) * 16 + NumDigitValue(units[i + 3])) * 16 +
                                                       NumDigitValue(units[i + 4])) * 16 + NumDigitValue(units[i + 5])))
            ELSE JSONFail
    [] c = 92 -> JSONFail
    [] OTHER -> JSONString(units, i + 1, Append(acc, c))
IsHexDigit(c) == IsDigit(c) \/ (c >= 65 /\ c <= 70) \/ (c >= 97 /\ c <= 102)
\* The index after the number at i, or 0 when it isn't one.
JSONNumberEnd(units, i) ==
  LET At(k, set) == k <= Len(units) /\ units[k] \in set
      Digits(k) == IF At(k, 48..57) THEN JSONDigitsEnd(units, k) ELSE 0
      sign == IF At(i, {45}) THEN i + 1 ELSE i
      integer == IF At(sign, {48}) THEN sign + 1 ELSE IF At(sign, 49..57) THEN JSONDigitsEnd(units, sign) ELSE 0
      fraction == IF integer = 0 \/ ~At(integer, {46}) THEN integer ELSE Digits(integer + 1)
      exponentSign == IF At(fraction + 1, {43, 45}) THEN fraction + 2 ELSE fraction + 1
  IN IF fraction = 0 \/ ~At(fraction, {69, 101}) THEN fraction ELSE Digits(exponentSign)
JSONDigitsEnd(units, i) == IF i <= Len(units) /\ IsDigit(units[i]) THEN JSONDigitsEnd(units, i + 1) ELSE i
\* The members of an object after its opening brace, from index i.
JSONObject(units, i, members) ==
  IF i > Len(units) THEN JSONFail
  ELSE IF units[i] = 125 THEN JSONNode(units, [type |-> "object", members |-> members], i + 1)
  ELSE LET j == IF members = <<>> THEN i ELSE IF units[i] = 44 THEN JSONWhitespace(units, i + 1) ELSE 0 IN
  IF j = 0 \/ j > Len(units) \/ units[j] # 34 THEN JSONFail ELSE
  LET key == JSONString(units, j + 1, <<>>) IN IF ~key.ok THEN key ELSE
  LET colon == JSONWhitespace(units, key.i) IN
  IF colon > Len(units) \/ units[colon] # 58 THEN JSONFail ELSE
  LET value == JSONValue(units, JSONWhitespace(units, colon + 1)) IN IF ~value.ok THEN value
  ELSE JSONObject(units, value.i, Append(members, <<key.units, value.node>>))
\* The elements of an array after its opening bracket, from index i.
JSONArray(units, i, items) ==
  IF i > Len(units) THEN JSONFail
  ELSE IF units[i] = 93 THEN JSONNode(units, [type |-> "array", items |-> items], i + 1)
  ELSE LET j == IF items = <<>> THEN i ELSE IF units[i] = 44 THEN JSONWhitespace(units, i + 1) ELSE 0 IN
  IF j = 0 THEN JSONFail ELSE
  LET value == JSONValue(units, j) IN IF ~value.ok THEN value ELSE JSONArray(units, value.i, Append(items, value.node))
\* Evaluates a parse tree to [s, v, record], with the JSON Parse Record (§25.5.1.2) that
\* CreateJSONParseRecord would make for it: [value, source, elements, entries], where entries maps
\* each key to the record of its last member.
JSONEvaluate(s, tree) ==
  CASE tree.type = "value" ->
         [s |-> s, v |-> tree.value,
          record |-> [value |-> tree.value, source |-> tree.source, elements |-> <<>>, entries |-> <<>>]]
    [] tree.type = "array" ->
         LET items == JSONEvaluateItems(s, tree.items, <<>>, <<>>)
             a == CreateArrayFromList(items.s, items.values)
         IN [s |-> a.s, v |-> Val(a), record |-> [value |-> Val(a), source |-> <<>>, elements |-> items.records, entries |-> <<>>]]
    [] OTHER ->
         LET o == OrdinaryObjectCreate(s, Intrinsic(s, "ObjectPrototype"))
             members == JSONEvaluateMembers(o.s, Val(o), tree.members, <<>>)
         IN [s |-> members.s, v |-> Val(o), record |-> [value |-> Val(o), source |-> <<>>, elements |-> <<>>, entries |-> members.entries]]
JSONEvaluateItems(s, items, values, records) ==
  IF items = <<>> THEN [s |-> s, values |-> values, records |-> records]
  ELSE LET r == JSONEvaluate(s, Head(items)) IN
       JSONEvaluateItems(r.s, Tail(items), Append(values, r.v), Append(records, r.record))
JSONEvaluateMembers(s, o, members, entries) ==
  IF members = <<>> THEN [s |-> s, entries |-> entries]
  ELSE LET key == Str(Head(members)[1])
           r == JSONEvaluate(s, Head(members)[2])
           c == CreateDataProperty(r.s, o, key, r.v)
       IN JSONEvaluateMembers(c.s, o, Tail(members), (key :> r.record) @@ entries)
\* InternalizeJSONProperty (§25.5.1.3), with the parse record of the value or Absent.
InternalizeJSONProperty(s, holder, name, reviver, record) ==
  LET val == Get(s, holder, name) IN IF IsAbrupt(val) THEN val ELSE
  LET v == Val(val)
      context == OrdinaryObjectCreate(val.s, Intrinsic(val.s, "ObjectPrototype"))
      isSame == record # Absent /\ SameValue(record.value, v)
      withSource == IF isSame /\ ~IsObject(v)
                    THEN CreateDataPropertyOrThrow(context.s, Val(context), SV("source"), Str(record.source))
                    ELSE Ok(context.s, Empty)
      revived ==
        IF ~IsObject(v) THEN withSource
        ELSE LET isArray == IsArray(withSource.s, v) IN IF IsAbrupt(isArray) THEN isArray
        ELSE IF Val(isArray) = True THEN
          LET len == LengthOfArrayLike(isArray.s, v) IN IF IsAbrupt(len) THEN len
          ELSE InternalizeJSONElements(len.s, v, reviver, IF isSame THEN record.elements ELSE <<>>, Val(len).value, PosZero)
        ELSE LET keys == EnumerableOwnProperties(isArray.s, v, "key") IN IF IsAbrupt(keys) THEN keys
        ELSE InternalizeJSONKeys(keys.s, v, reviver, IF isSame THEN record.entries ELSE <<>>, Val(keys))
  IN IF IsAbrupt(revived) THEN revived ELSE Call(revived.s, reviver, holder, <<name, v, Val(context)>>)
InternalizeJSONElements(s, v, reviver, records, len, i) ==
  IF ~NumLess(i, len) THEN Ok(s, Empty)
  ELSE LET record == IF NumLess(i, NumFromInt(Len(records))) THEN records[NumToSmallInt(i) + 1] ELSE Absent
           r == InternalizeJSONReplace(s, v, Index(i), reviver, record)
       IN IF IsAbrupt(r) THEN r ELSE InternalizeJSONElements(r.s, v, reviver, records, len, NumAdd(i, OneNum))
InternalizeJSONKeys(s, v, reviver, entries, keys) ==
  IF keys = <<>> THEN Ok(s, Empty)
  ELSE LET r == InternalizeJSONReplace(s, v, Head(keys), reviver,
                                       IF Head(keys) \in DOMAIN entries THEN entries[Head(keys)] ELSE Absent)
       IN IF IsAbrupt(r) THEN r ELSE InternalizeJSONKeys(r.s, v, reviver, entries, Tail(keys))
\* Revives the property k of v, then deletes it or redefines it with the new value.
InternalizeJSONReplace(s, v, k, reviver, record) ==
  LET e == InternalizeJSONProperty(s, v, k, reviver, record) IN IF IsAbrupt(e) THEN e
  ELSE IF Val(e) = Undefined THEN Delete(e.s, v, k) ELSE CreateDataProperty(e.s, v, k, Val(e))
\* JSON.rawJSON (§25.5.3 of the proposal).
JSONRawJSON(s, text) ==
  LET str == ToStr(s, text) IN IF IsAbrupt(str) THEN str ELSE
  LET units == Val(str).value
      forbidden == {9, 10, 13, 32, 91, 123}
  IN IF units = <<>> \/ units[1] \in forbidden \/ Last(units) \in forbidden \/ ParseJSON(units) = None
     THEN ThrowError(str.s, "SyntaxError")
     ELSE LET a == Alloc(str.s, MakeObject(Null, "rawJSON", [none |-> TRUE])) IN
          LET c == CreateDataPropertyOrThrow(a.s, a.v, SV("rawJSON"), Val(str)) IN
          LET frozen == SetIntegrityLevel(c.s, a.v, "frozen") IN Ok(frozen.s, a.v)
\* JSON.stringify (§25.5.2). The serialization state is [replacer, list, gap, stack, indent], with
\* list the PropertyList or None.
JSONStringify(s, value, replacer, space) ==
  LET list ==
        IF ~IsObject(replacer) \/ IsCallable(s, replacer) THEN Ok(s, None)
        ELSE LET isArray == IsArray(s, replacer) IN IF IsAbrupt(isArray) THEN isArray
        ELSE IF Val(isArray) = False THEN Ok(isArray.s, None)
        ELSE LET len == LengthOfArrayLike(isArray.s, replacer) IN IF IsAbrupt(len) THEN len
        ELSE JSONPropertyList(len.s, replacer, Val(len).value, PosZero, <<>>)
  IN IF IsAbrupt(list) THEN list ELSE
  LET sp == IF IsObject(space) /\ O(list.s, space).class = "number" THEN ToNumber(list.s, space)
            ELSE IF IsObject(space) /\ O(list.s, space).class = "string" THEN ToStr(list.s, space)
            ELSE Ok(list.s, space)
  IN IF IsAbrupt(sp) THEN sp ELSE
  LET gap == CASE IsNumber(Val(sp)) ->
                    LET n == NumToIntegerOrInfinity(Val(sp).value) IN
                    Repeat(32, IF NumLess(n, OneNum) THEN 0 ELSE IF NumLess(NumFromInt(10), n) THEN 10 ELSE NumToSmallInt(n))
                [] IsString(Val(sp)) -> SubSeq(Val(sp).value, 1, IF Len(Val(sp).value) < 10 THEN Len(Val(sp).value) ELSE 10)
                [] OTHER -> <<>>
      wrapper == OrdinaryObjectCreate(sp.s, Intrinsic(sp.s, "ObjectPrototype"))
      c == CreateDataPropertyOrThrow(wrapper.s, Val(wrapper), EmptyStr, value)
      state == [replacer |-> IF IsCallable(s, replacer) THEN replacer ELSE Undefined,
                list |-> Val(list), gap |-> gap, stack |-> <<>>, indent |-> <<>>]
  IN SerializeJSONProperty(c.s, state, EmptyStr, Val(wrapper))
JSONPropertyList(s, replacer, len, k, list) ==
  IF ~NumLess(k, len) THEN Ok(s, list)
  ELSE LET v == Get(s, replacer, Index(k)) IN IF IsAbrupt(v) THEN v ELSE
       LET x == Val(v)
           item == CASE IsString(x) -> Ok(v.s, x)
                     [] IsNumber(x) -> Ok(v.s, Str(NumToString(x.value)))
                     [] IsObject(x) /\ O(v.s, x).class \in {"string", "number"} -> ToStr(v.s, x)
                     [] OTHER -> Ok(v.s, Undefined)
       IN IF IsAbrupt(item) THEN item
          ELSE JSONPropertyList(item.s, replacer, len, NumAdd(k, OneNum),
                                IF Val(item) = Undefined \/ Val(item) \in Range(list) THEN list ELSE Append(list, Val(item)))
\* SerializeJSONProperty (§25.5.2.2): a String value, or Undefined.
SerializeJSONProperty(s, state, key, holder) ==
  LET value == Get(s, holder, key) IN IF IsAbrupt(value) THEN value ELSE
  LET withJSON ==
        IF ~IsObject(Val(value)) /\ ~IsBigInt(Val(value)) THEN value
        ELSE LET toJSON == GetValueProperty(value.s, Val(value), SV("toJSON")) IN IF IsAbrupt(toJSON) THEN toJSON
        ELSE IF IsCallable(toJSON.s, Val(toJSON)) THEN Call(toJSON.s, Val(toJSON), Val(value), <<key>>)
        ELSE Ok(toJSON.s, Val(value))
  IN IF IsAbrupt(withJSON) THEN withJSON ELSE
  LET replaced == IF state.replacer = Undefined THEN withJSON
                  ELSE Call(withJSON.s, state.replacer, holder, <<key, Val(withJSON)>>)
  IN IF IsAbrupt(replaced) THEN replaced ELSE
  LET x == Val(replaced)
      class == IF IsObject(x) THEN O(replaced.s, x).class ELSE ""
  IN IF class = "rawJSON" THEN Get(replaced.s, x, SV("rawJSON")) ELSE
  LET unwrapped == CASE class = "number" -> ToNumber(replaced.s, x)
                     [] class = "string" -> ToStr(replaced.s, x)
                     [] class \in {"boolean", "bigint"} -> Ok(replaced.s, O(replaced.s, x).slots.data)
                     [] OTHER -> replaced
  IN IF IsAbrupt(unwrapped) THEN unwrapped ELSE
  LET v == Val(unwrapped)
      t == unwrapped.s
  IN CASE v = Null -> Ok(t, SV("null"))
       [] v = True -> Ok(t, SV("true"))
       [] v = False -> Ok(t, SV("false"))
       [] IsString(v) -> Ok(t, Str(QuoteJSONString(v.value)))
       [] IsNumber(v) -> Ok(t, IF NumIsFinite(v.value) THEN Str(NumToString(v.value)) ELSE SV("null"))
       [] IsBigInt(v) -> ThrowTypeError(t)
       [] IsObject(v) /\ ~IsCallable(t, v) ->
            LET isArray == IsArray(t, v) IN IF IsAbrupt(isArray) THEN isArray
            ELSE IF v \in Range(state.stack) THEN ThrowTypeError(isArray.s)
            ELSE LET inner == [state EXCEPT !.stack = Append(@, v), !.indent = @ \o state.gap] IN
                 IF Val(isArray) = True THEN SerializeJSONArray(isArray.s, inner, state.indent, v)
                 ELSE SerializeJSONObject(isArray.s, inner, state.indent, v)
       [] OTHER -> Ok(t, Undefined)
\* QuoteJSONString (§25.5.2.3).
QuoteJSONString(units) ==
  LET cps == StringToCodePoints(units, 0, <<>>) IN
  <<34>> \o FoldLeftSeq([i \in DOMAIN cps |->
    LET cp == cps[i] IN
    CASE cp = 8 -> <<92, 98>> [] cp = 9 -> <<92, 116>> [] cp = 10 -> <<92, 110>> [] cp = 12 -> <<92, 102>>
      [] cp = 13 -> <<92, 114>> [] cp = 34 -> <<92, 34>> [] cp = 92 -> <<92, 92>>
      [] cp < 32 \/ (cp >= 55296 /\ cp <= 57343) ->
           <<92, 117>> \o [k \in 1..4 |-> NumDigitChar((cp \div (16 ^ (4 - k))) % 16)]
      [] OTHER -> UTF16EncodeCodePoint(cp)]) \o <<34>>
\* The members or elements of an object or array, as SerializeJSONObject and SerializeJSONArray
\* (§25.5.2.5, §25.5.2.6) join them, with stepback the indent outside.
JSONJoin(state, stepback, open, close, partial) ==
  IF partial = <<>> THEN <<open, close>>
  ELSE IF state.gap = <<>> THEN <<open>> \o JoinUnits(partial, <<44>>) \o <<close>>
  ELSE <<open, 10>> \o state.indent \o JoinUnits(partial, <<44, 10>> \o state.indent) \o <<10>> \o stepback \o <<close>>
JoinUnits(parts, separator) ==
  FoldLeftSeq([i \in DOMAIN parts |-> (IF i = 1 THEN <<>> ELSE separator) \o parts[i]])
\* SerializeJSONObject (§25.5.2.5).
SerializeJSONObject(s, state, stepback, value) ==
  LET keys == IF state.list # None THEN Ok(s, state.list) ELSE EnumerableOwnProperties(s, value, "key") IN
  IF IsAbrupt(keys) THEN keys ELSE
  LET partial == SerializeJSONMembers(keys.s, state, value, Val(keys), <<>>) IN
  IF IsAbrupt(partial) THEN partial ELSE Ok(partial.s, Str(JSONJoin(state, stepback, 123, 125, Val(partial))))
SerializeJSONMembers(s, state, value, keys, partial) ==
  IF keys = <<>> THEN Ok(s, partial)
  ELSE LET str == SerializeJSONProperty(s, state, Head(keys), value) IN IF IsAbrupt(str) THEN str
       ELSE SerializeJSONMembers(str.s, state, value, Tail(keys),
              IF Val(str) = Undefined THEN partial
              ELSE Append(partial, QuoteJSONString(Head(keys).value) \o <<58>> \o
                                   (IF state.gap = <<>> THEN <<>> ELSE <<32>>) \o Val(str).value))
\* SerializeJSONArray (§25.5.2.6).
SerializeJSONArray(s, state, stepback, value) ==
  LET len == LengthOfArrayLike(s, value) IN IF IsAbrupt(len) THEN len ELSE
  LET partial == SerializeJSONElements(len.s, state, value, Val(len).value, PosZero, <<>>) IN
  IF IsAbrupt(partial) THEN partial ELSE Ok(partial.s, Str(JSONJoin(state, stepback, 91, 93, Val(partial))))
SerializeJSONElements(s, state, value, len, i, partial) ==
  IF ~NumLess(i, len) THEN Ok(s, partial)
  ELSE LET str == SerializeJSONProperty(s, state, Index(i), value) IN IF IsAbrupt(str) THEN str
       ELSE SerializeJSONElements(str.s, state, value, len, NumAdd(i, OneNum),
              Append(partial, IF Val(str) = Undefined THEN N("null") ELSE Val(str).value))
\* String objects (§22.1), String Iterator objects (§22.1.5), and the String methods of Annex B
\* (§B.2.2).
\* thisStringValue (§22.1.3.35.1).
ThisStringValue(s, v) ==
  IF IsString(v) THEN Ok(s, v)
  ELSE IF IsObject(v) /\ O(s, v).class = "string" THEN Ok(s, Str(O(s, v).slots.data))
  ELSE ThrowTypeError(s)
StringBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> StringConstructor(s, args, nt)
    [] m \in {"toString", "valueOf"} -> ThisStringValue(s, this)
    [] m = "fromCharCode" -> StringFromCharCode(s, args, <<>>)
    [] m = "fromCodePoint" -> StringFromCodePoint(s, args, <<>>)
    [] m = "raw" -> StringRaw(s, Arg(args, 1), Rest(args, 2))
    [] m \in {"match", "matchAll", "replace", "replaceAll", "search", "split"} ->
         LET o == RequireObjectCoercible(s, this) IN IF IsAbrupt(o) THEN o ELSE StringRegExpMethod(o.s, this, m, args)
    [] OTHER ->
         LET o == RequireObjectCoercible(s, this) IN IF IsAbrupt(o) THEN o ELSE
         LET str == ToStr(o.s, this) IN IF IsAbrupt(str) THEN str ELSE
         StringMethod(str.s, Val(str).value, m, args)
\* String (§22.1.1.1).
StringConstructor(s, args, nt) ==
  LET str == IF args = <<>> THEN Ok(s, EmptyStr)
             ELSE IF nt = Undefined /\ IsSymbol(args[1]) THEN Ok(s, SymbolDescriptiveString(s, args[1]))
             ELSE ToStr(s, args[1])
  IN IF IsAbrupt(str) \/ nt = Undefined THEN str
     ELSE LET p == GetPrototypeFromConstructor(str.s, nt, "StringPrototype") IN
          IF IsAbrupt(p) THEN p ELSE StringCreate(p.s, Val(str), Val(p))
\* String.fromCharCode (§22.1.2.1).
StringFromCharCode(s, args, acc) ==
  IF args = <<>> THEN Ok(s, Str(acc))
  ELSE LET n == ToNumber(s, Head(args)) IN IF IsAbrupt(n) THEN n
       ELSE StringFromCharCode(n.s, Tail(args), Append(acc, NumToUint16(Val(n).value)))
\* String.fromCodePoint (§22.1.2.2).
StringFromCodePoint(s, args, acc) ==
  IF args = <<>> THEN Ok(s, Str(acc))
  ELSE LET n == ToNumber(s, Head(args)) IN IF IsAbrupt(n) THEN n ELSE
       LET x == Val(n).value IN
       IF ~NumIsFinite(x) \/ ~NumIsIntegral(x) THEN ThrowError(n.s, "RangeError")
       ELSE IF NumLess(x, PosZero) \/ NumLess(NumFromInt(1114111), x) THEN ThrowError(n.s, "RangeError")
       ELSE StringFromCodePoint(n.s, Tail(args), acc \o UTF16EncodeCodePoint(NumToSmallInt(x)))
\* String.raw (§22.1.2.4).
StringRaw(s, template, substitutions) ==
  LET cooked == ToObject(s, template) IN IF IsAbrupt(cooked) THEN cooked ELSE
  LET rawValue == Get(cooked.s, Val(cooked), SV("raw")) IN IF IsAbrupt(rawValue) THEN rawValue ELSE
  LET literals == ToObject(rawValue.s, Val(rawValue)) IN IF IsAbrupt(literals) THEN literals ELSE
  LET count == LengthOfArrayLike(literals.s, Val(literals)) IN IF IsAbrupt(count) THEN count
  ELSE IF NumIsZero(Val(count).value) THEN Ok(count.s, EmptyStr)
  ELSE StringRawFrom(count.s, Val(literals), Val(count).value, substitutions, 0, <<>>)
StringRawFrom(s, literals, count, substitutions, i, acc) ==
  LET literal == Get(s, literals, Index(NumFromInt(i))) IN IF IsAbrupt(literal) THEN literal ELSE
  LET next == ToStr(literal.s, Val(literal)) IN IF IsAbrupt(next) THEN next ELSE
  LET result == acc \o Val(next).value IN
  IF NumFromInt(i + 1) = count THEN Ok(next.s, Str(result))
  ELSE IF i >= Len(substitutions) THEN StringRawFrom(next.s, literals, count, substitutions, i + 1, result)
  ELSE LET sub == ToStr(next.s, substitutions[i + 1]) IN IF IsAbrupt(sub) THEN sub
       ELSE StringRawFrom(sub.s, literals, count, substitutions, i + 1, result \o Val(sub).value)
\* The String.prototype methods that start with RequireObjectCoercible and ToString of the this
\* value, whose code units are units.
StringMethod(s, units, m, args) ==
  LET size == NumFromInt(Len(units))
      a1 == Arg(args, 1)
  IN
  CASE m = "at" ->
         LET p == ToIntegerOrInfinity(s, a1) IN IF IsAbrupt(p) THEN p ELSE
         LET k == IF NumLess(Val(p).value, PosZero) THEN NumAdd(size, Val(p).value) ELSE Val(p).value IN
         Ok(p.s, IF NumLess(k, PosZero) \/ ~NumLess(k, size) THEN Undefined ELSE Str(<<units[NumToSmallInt(k) + 1]>>))
    [] m \in {"charAt", "charCodeAt", "codePointAt"} ->
         LET p == ToIntegerOrInfinity(s, a1) IN IF IsAbrupt(p) THEN p ELSE
         LET x == Val(p).value IN
         IF NumLess(x, PosZero) \/ ~NumLess(x, size)
         THEN Ok(p.s, CASE m = "charAt" -> EmptyStr [] m = "charCodeAt" -> Num(NaN) [] OTHER -> Undefined)
         ELSE LET i == NumToSmallInt(x) IN
              Ok(p.s, CASE m = "charAt" -> Str(<<units[i + 1]>>)
                        [] m = "charCodeAt" -> IntV(units[i + 1])
                        [] OTHER -> IntV(CodePointAt(units, i).cp))
    [] m = "concat" -> StringConcat(s, units, args)
    [] m \in {"endsWith", "includes", "startsWith"} ->
         LET isRegExp == IsRegExp(s, a1) IN IF IsAbrupt(isRegExp) THEN isRegExp
         ELSE IF Val(isRegExp) = True THEN ThrowTypeError(isRegExp.s)
         ELSE LET search == ToStr(isRegExp.s, a1) IN IF IsAbrupt(search) THEN search ELSE
         LET p == ClampedIndex(search.s, Arg(args, 2), Len(units), IF m = "endsWith" THEN Len(units) ELSE 0) IN
         IF IsAbrupt(p) THEN p ELSE
         LET searchUnits == Val(search).value
             searchLength == Len(searchUnits)
         IN Ok(p.s, Bool(CASE m = "includes" -> StringIndexOf(units, searchUnits, Val(p)) # -1
                           [] m = "startsWith" ->
                                Val(p) + searchLength <= Len(units) /\
                                SubSeq(units, Val(p) + 1, Val(p) + searchLength) = searchUnits
                           [] OTHER ->
                                Val(p) - searchLength >= 0 /\
                                SubSeq(units, Val(p) - searchLength + 1, Val(p)) = searchUnits))
    [] m = "indexOf" ->
         LET search == ToStr(s, a1) IN IF IsAbrupt(search) THEN search ELSE
         LET p == ClampedIndex(search.s, Arg(args, 2), Len(units), 0) IN IF IsAbrupt(p) THEN p
         ELSE Ok(p.s, IntV(StringIndexOf(units, Val(search).value, Val(p))))
    [] m = "lastIndexOf" ->
         LET search == ToStr(s, a1) IN IF IsAbrupt(search) THEN search ELSE
         LET n == ToNumber(search.s, Arg(args, 2)) IN IF IsAbrupt(n) THEN n ELSE
         LET maxStart == Len(units) - Len(Val(search).value)
             x == Val(n).value
             start == CASE NumIsNaN(x) \/ NumLess(NumFromInt(maxStart), x) -> maxStart
                         [] NumLess(x, PosZero) -> 0
                         [] OTHER -> NumToSmallInt(NumToIntegerOrInfinity(x))
         IN Ok(n.s, IntV(IF maxStart < 0 THEN -1 ELSE StringLastIndexOf(units, Val(search).value, start)))
    [] m = "isWellFormed" -> Ok(s, Bool(IsStringWellFormedUnicode(units, 0)))
    [] m = "localeCompare" ->
         LET that == ToStr(s, a1) IN IF IsAbrupt(that) THEN that ELSE
         LET x == Normalize(units, "NFC")
             y == Normalize(Val(that).value, "NFC")
         IN Ok(that.s, IntV(IF x = y THEN 0 ELSE IF LexLess(x, y) THEN -1 ELSE 1))
    [] m = "normalize" ->
         LET form == IF a1 = Undefined THEN Ok(s, SV("NFC")) ELSE ToStr(s, a1) IN IF IsAbrupt(form) THEN form ELSE
         LET f == Val(form).value IN
         CASE f = N("NFC") -> Ok(form.s, Str(Normalize(units, "NFC")))
           [] f = N("NFD") -> Ok(form.s, Str(Normalize(units, "NFD")))
           [] f = N("NFKC") -> Ok(form.s, Str(Normalize(units, "NFKC")))
           [] f = N("NFKD") -> Ok(form.s, Str(Normalize(units, "NFKD")))
           [] OTHER -> ThrowError(form.s, "RangeError")
    [] m \in {"padEnd", "padStart"} -> StringPad(s, units, a1, Arg(args, 2), m = "padStart")
    [] m = "repeat" ->
         LET n == ToIntegerOrInfinity(s, a1) IN IF IsAbrupt(n) THEN n
         ELSE IF NumLess(Val(n).value, PosZero) \/ Val(n).value = PosInf THEN ThrowError(n.s, "RangeError")
         ELSE IF units = <<>> \/ NumIsZero(Val(n).value) THEN Ok(n.s, EmptyStr)
         ELSE Ok(n.s, Str(RepeatUnits(units, NumToSmallInt(Val(n).value))))
    [] m = "slice" ->
         LET st == RelativeIndex(s, a1, size, PosZero) IN IF IsAbrupt(st) THEN st ELSE
         LET en == RelativeIndex(st.s, Arg(args, 2), size, size) IN IF IsAbrupt(en) THEN en ELSE
         LET from == NumToSmallInt(Val(st))
             to == NumToSmallInt(Val(en))
         IN Ok(en.s, IF from >= to THEN EmptyStr ELSE Str(SubSeq(units, from + 1, to)))
    [] m = "substring" ->
         LET st == ClampedIndex(s, a1, Len(units), 0) IN IF IsAbrupt(st) THEN st ELSE
         LET en == ClampedIndex(st.s, Arg(args, 2), Len(units), Len(units)) IN IF IsAbrupt(en) THEN en ELSE
         LET from == IF Val(st) < Val(en) THEN Val(st) ELSE Val(en)
             to == IF Val(st) < Val(en) THEN Val(en) ELSE Val(st)
         IN Ok(en.s, Str(SubSeq(units, from + 1, to)))
    [] m = "toLowerCase" -> Ok(s, Str(ToLowercase(units)))
    [] m = "toUpperCase" -> Ok(s, Str(ToUppercase(units)))
    [] m = "toWellFormed" -> Ok(s, Str(ToWellFormed(units, 0, <<>>)))
    [] m = "trim" -> Ok(s, Str(TrimString(units, TRUE, TRUE)))
    [] m = "trimStart" -> Ok(s, Str(TrimString(units, TRUE, FALSE)))
    [] m = "trimEnd" -> Ok(s, Str(TrimString(units, FALSE, TRUE)))
    [] m = "iterator" ->
         LET a == Alloc(s, MakeObject(Intrinsic(s, "StringIteratorPrototype"), "stringIterator",
                                      [string |-> units, position |-> 0]))
         IN Ok(a.s, a.v)
    \* String.prototype.substr (§B.2.2.1).
    [] m = "substr" ->
         LET st == ToIntegerOrInfinity(s, a1) IN IF IsAbrupt(st) THEN st ELSE
         LET x == Val(st).value
             start == CASE NumLess(x, PosZero) ->
                             IF NumLess(NumAdd(size, x), PosZero) THEN 0 ELSE NumToSmallInt(NumAdd(size, x))
                        [] NumLess(size, x) -> Len(units)
                        [] OTHER -> NumToSmallInt(x)
             len == ClampedIndex(st.s, Arg(args, 2), Len(units), Len(units))
         IN IF IsAbrupt(len) THEN len
            ELSE LET end == IF start + Val(len) < Len(units) THEN start + Val(len) ELSE Len(units) IN
                 Ok(len.s, Str(SubSeq(units, start + 1, end)))
    \* The HTML methods (§B.2.2.2 to §B.2.2.14).
    [] OTHER -> CreateHTML(s, units, m, a1)
\* String.prototype.concat (§22.1.3.5).
StringConcat(s, units, args) ==
  IF args = <<>> THEN Ok(s, Str(units))
  ELSE LET next == ToStr(s, Head(args)) IN IF IsAbrupt(next) THEN next
       ELSE StringConcat(next.s, units \o Val(next).value, Tail(args))
\* An index argument clamped to 0..len as a TLA+ integer, or default when it is undefined.
ClampedIndex(s, v, len, default) ==
  IF v = Undefined THEN Ok(s, default)
  ELSE LET n == ToIntegerOrInfinity(s, v) IN IF IsAbrupt(n) THEN n ELSE
       LET x == Val(n).value IN
       Ok(n.s, IF NumLess(x, PosZero) THEN 0 ELSE IF NumLess(NumFromInt(len), x) THEN len ELSE NumToSmallInt(NumAdd(x, PosZero)))
\* StringIndexOf (§6.1.4.1): the first index at or after start where search occurs, or -1.
StringIndexOf(units, search, start) ==
  IF search = <<>> /\ start <= Len(units) THEN start
  ELSE IF start + Len(search) > Len(units) THEN -1
  ELSE IF SubSeq(units, start + 1, start + Len(search)) = search THEN start
  ELSE StringIndexOf(units, search, start + 1)
\* The last index at or before start where search occurs, or -1, as lastIndexOf searches.
StringLastIndexOf(units, search, start) ==
  IF start < 0 THEN -1
  ELSE IF SubSeq(units, start + 1, start + Len(search)) = search THEN start
  ELSE StringLastIndexOf(units, search, start - 1)
\* StringPad (§22.1.3.17.2) after ToString of the this value.
StringPad(s, units, maxLength, fillString, atStart) ==
  LET l == ToLength(s, maxLength) IN IF IsAbrupt(l) THEN l
  ELSE IF ~NumLess(NumFromInt(Len(units)), Val(l).value) THEN Ok(l.s, Str(units))
  ELSE LET filler == IF fillString = Undefined THEN Ok(l.s, SV(" ")) ELSE ToStr(l.s, fillString) IN
  IF IsAbrupt(filler) THEN filler
  ELSE IF Val(filler).value = <<>> THEN Ok(filler.s, Str(units))
  ELSE LET fillLen == NumToSmallInt(Val(l).value) - Len(units)
           fill == SubSeq(RepeatUnits(Val(filler).value, fillLen \div Len(Val(filler).value) + 1), 1, fillLen)
       IN Ok(filler.s, Str(IF atStart THEN fill \o units ELSE units \o fill))
\* The code units repeated n times.
RepeatUnits(units, n) ==
  IF n = 0 THEN <<>>
  ELSE LET half == RepeatUnits(units, n \div 2) IN half \o half \o (IF n % 2 = 1 THEN units ELSE <<>>)
\* TrimString (§22.1.3.32.1), trimming WhiteSpace and LineTerminator at the start, the end, or both.
TrimString(units, atStart, atEnd) ==
  SubSeq(units, IF atStart THEN NumTrimStart(units, 1) ELSE 1, IF atEnd THEN NumTrimEnd(units, Len(units)) ELSE Len(units))
\* Code points (§6.1.4, §11.1). CodePointAt (§11.1.4) reads the code point at the 0-based position.
CodePointAt(units, pos) ==
  LET first == units[pos + 1] IN
  IF first < 55296 \/ first > 57343 THEN [cp |-> first, count |-> 1, unpaired |-> FALSE]
  ELSE IF first > 56319 \/ pos + 1 = Len(units) THEN [cp |-> first, count |-> 1, unpaired |-> TRUE]
  ELSE LET second == units[pos + 2] IN
       IF second < 56320 \/ second > 57343 THEN [cp |-> first, count |-> 1, unpaired |-> TRUE]
       ELSE [cp |-> (first - 55296) * 1024 + second - 56320 + 65536, count |-> 2, unpaired |-> FALSE]
\* UTF16EncodeCodePoint (§11.1.1).
UTF16EncodeCodePoint(cp) ==
  IF cp < 65536 THEN <<cp>> ELSE <<(cp - 65536) \div 1024 + 55296, ((cp - 65536) % 1024) + 56320>>
\* StringToCodePoints (§11.1.5), from the 0-based position i, with lone surrogates as themselves.
StringToCodePoints(units, i, acc) ==
  IF i >= Len(units) THEN acc
  ELSE LET cp == CodePointAt(units, i) IN StringToCodePoints(units, i + cp.count, Append(acc, cp.cp))
CodePointsToUnits(cps) == FoldLeftSeq([i \in DOMAIN cps |-> UTF16EncodeCodePoint(cps[i])])
\* IsStringWellFormedUnicode (§6.1.4.2), from the 0-based position i.
IsStringWellFormedUnicode(units, i) ==
  IF i >= Len(units) THEN TRUE
  ELSE LET cp == CodePointAt(units, i) IN ~cp.unpaired /\ IsStringWellFormedUnicode(units, i + cp.count)
\* String.prototype.toWellFormed (§22.1.3.31) from the 0-based position i.
ToWellFormed(units, i, acc) ==
  IF i >= Len(units) THEN acc
  ELSE LET cp == CodePointAt(units, i) IN
       ToWellFormed(units, i + cp.count, acc \o IF cp.unpaired THEN <<65533>> ELSE UTF16EncodeCodePoint(cp.cp))
\* String.prototype.match, matchAll, replace, replaceAll, search, and split (§22.1.3.13, .14, .19,
\* .20, .23, .24), which defer to the method of an object argument's well-known symbol.
StringRegExpMethod(s, this, m, args) ==
  LET regexp == Arg(args, 1)
      symbol == CASE m = "match" -> SymMatch [] m = "matchAll" -> SymMatchAll [] m = "search" -> SymSearch
                  [] m = "split" -> SymSplit [] OTHER -> SymReplace
      checked == IF m \in {"matchAll", "replaceAll"} /\ IsObject(regexp) THEN RequireGlobalFlag(s, regexp) ELSE Ok(s, Empty)
  IN IF IsAbrupt(checked) THEN checked ELSE
     LET method == IF IsObject(regexp) THEN GetMethod(checked.s, regexp, symbol) ELSE Ok(checked.s, Undefined) IN
     IF IsAbrupt(method) THEN method
     ELSE IF Val(method) # Undefined
     THEN Call(method.s, Val(method), regexp, IF m \in {"match", "matchAll", "search"} THEN <<this>> ELSE <<this, Arg(args, 2)>>)
     ELSE LET str == ToStr(method.s, this) IN IF IsAbrupt(str) THEN str ELSE
     CASE m \in {"match", "matchAll", "search"} ->
            LET rx == RegExpCreate(str.s, regexp, IF m = "matchAll" THEN SV("g") ELSE Undefined) IN
            IF IsAbrupt(rx) THEN rx ELSE Invoke(rx.s, Val(rx), symbol, <<Val(str)>>)
       [] m = "split" -> StringSplit(str.s, Val(str).value, regexp, Arg(args, 2))
       [] OTHER -> StringReplace(str.s, Val(str).value, regexp, Arg(args, 2), m = "replaceAll")
\* The check of matchAll and replaceAll that a RegExp argument is global.
RequireGlobalFlag(s, regexp) ==
  LET isRegExp == IsRegExp(s, regexp) IN IF IsAbrupt(isRegExp) \/ Val(isRegExp) = False THEN isRegExp ELSE
  LET flags == Get(isRegExp.s, regexp, SV("flags")) IN IF IsAbrupt(flags) THEN flags ELSE
  LET coercible == RequireObjectCoercible(flags.s, Val(flags)) IN IF IsAbrupt(coercible) THEN coercible ELSE
  LET str == ToStr(coercible.s, Val(flags)) IN IF IsAbrupt(str) THEN str
  ELSE IF 103 \notin Range(Val(str).value) THEN ThrowTypeError(str.s)
  ELSE str
\* The string steps of String.prototype.replace and replaceAll.
StringReplace(s, units, searchValue, replaceValue, isAll) ==
  LET search == ToStr(s, searchValue) IN IF IsAbrupt(search) THEN search ELSE
  LET isFunctional == IsCallable(search.s, replaceValue)
      template == IF isFunctional THEN Ok(search.s, Empty) ELSE ToStr(search.s, replaceValue)
      searchUnits == Val(search).value
  IN IF IsAbrupt(template) THEN template ELSE
     LET positions == IF isAll THEN MatchPositions(units, searchUnits, StringIndexOf(units, searchUnits, 0), <<>>)
                      ELSE LET p == StringIndexOf(units, searchUnits, 0) IN IF p = -1 THEN <<>> ELSE <<p>>
     IN ReplaceAt(template.s, units, searchUnits, positions, IF isFunctional THEN replaceValue ELSE Val(template), 0, <<>>)
MatchPositions(units, search, p, acc) ==
  IF p = -1 THEN acc
  ELSE MatchPositions(units, search, StringIndexOf(units, search, p + IF search = <<>> THEN 1 ELSE Len(search)), Append(acc, p))
\* Replaces each match in positions, with the result so far acc up to endOfLastMatch.
ReplaceAt(s, units, search, positions, replaceValue, endOfLastMatch, acc) ==
  IF positions = <<>> THEN Ok(s, Str(acc \o SubSeq(units, endOfLastMatch + 1, Len(units))))
  ELSE LET p == Head(positions)
           replacement ==
             IF IsString(replaceValue)
             THEN GetSubstitution(s, search, units, p, <<>>, Undefined, replaceValue.value, <<>>)
             ELSE LET r == Call(s, replaceValue, Undefined, <<Str(search), IntV(p), Str(units)>>) IN
                  IF IsAbrupt(r) THEN r ELSE ToStr(r.s, Val(r))
       IN IF IsAbrupt(replacement) THEN replacement
          ELSE ReplaceAt(replacement.s, units, search, Tail(positions), replaceValue, p + Len(search),
                         acc \o SubSeq(units, endOfLastMatch + 1, p) \o Val(replacement).value)
\* GetSubstitution (§22.1.3.19.1) over the rest of the template, appending to acc. captures holds
\* String values or Undefined, and namedCaptures is an object or Undefined.
GetSubstitution(s, matched, str, position, captures, namedCaptures, rest, acc) ==
  IF rest = <<>> THEN Ok(s, Str(acc))
  ELSE LET Next(n, replacement) ==
             GetSubstitution(s, matched, str, position, captures, namedCaptures, SubSeq(rest, n + 1, Len(rest)), acc \o replacement)
           c == IF Len(rest) >= 2 /\ rest[1] = 36 THEN rest[2] ELSE 0
       IN CASE c = 36 -> Next(2, <<36>>)
            [] c = 96 -> Next(2, SubSeq(str, 1, position))
            [] c = 38 -> Next(2, matched)
            [] c = 39 ->
                 LET tail == position + Len(matched) IN
                 Next(2, SubSeq(str, (IF tail < Len(str) THEN tail ELSE Len(str)) + 1, Len(str)))
            [] IsDigit(c) ->
                 LET twoDigits == (c - 48) * 10 + (IF Len(rest) >= 3 /\ IsDigit(rest[3]) THEN rest[3] - 48 ELSE 0)
                     isTwo == Len(rest) >= 3 /\ IsDigit(rest[3]) /\ twoDigits <= Len(captures)
                     index == IF isTwo THEN twoDigits ELSE c - 48
                     ref == SubSeq(rest, 1, IF isTwo THEN 3 ELSE 2)
                 IN Next(Len(ref), IF index < 1 \/ index > Len(captures) THEN ref
                                   ELSE IF captures[index] = Undefined THEN <<>> ELSE captures[index].value)
            [] c = 60 ->
                 LET gtPos == StringIndexOf(rest, <<62>>, 0) IN
                 IF gtPos = -1 \/ namedCaptures = Undefined THEN Next(2, <<36, 60>>)
                 ELSE LET capture == Get(s, namedCaptures, Str(SubSeq(rest, 3, gtPos))) IN
                      IF IsAbrupt(capture) THEN capture
                      ELSE LET text == IF Val(capture) = Undefined THEN Ok(capture.s, EmptyStr) ELSE ToStr(capture.s, Val(capture)) IN
                           IF IsAbrupt(text) THEN text
                           ELSE GetSubstitution(text.s, matched, str, position, captures, namedCaptures,
                                                SubSeq(rest, gtPos + 2, Len(rest)), acc \o Val(text).value)
            [] OTHER -> Next(1, <<rest[1]>>)
\* The string steps of String.prototype.split (§22.1.3.23).
StringSplit(s, units, separator, limit) ==
  LET lim == IF limit = Undefined THEN Ok(s, Num(NumToUint32(NumFromInt(-1)))) ELSE ToUint32(s, limit) IN
  IF IsAbrupt(lim) THEN lim ELSE
  LET sep == ToStr(lim.s, separator) IN IF IsAbrupt(sep) THEN sep ELSE
  LET r == Val(sep).value
      n == Val(lim).value
  IN CASE NumIsZero(n) -> CreateArrayFromList(sep.s, <<>>)
       [] separator = Undefined -> CreateArrayFromList(sep.s, <<Str(units)>>)
       [] r = <<>> ->
            LET count == IF NumLess(n, NumFromInt(Len(units))) THEN NumToSmallInt(n) ELSE Len(units) IN
            CreateArrayFromList(sep.s, [i \in 1..count |-> Str(<<units[i]>>)])
       [] units = <<>> -> CreateArrayFromList(sep.s, <<Str(units)>>)
       [] OTHER -> CreateArrayFromList(sep.s, SplitFrom(units, r, n, 0, StringIndexOf(units, r, 0), <<>>))
SplitFrom(units, sep, lim, i, j, acc) ==
  IF j = -1 THEN Append(acc, Str(SubSeq(units, i + 1, Len(units))))
  ELSE LET substrings == Append(acc, Str(SubSeq(units, i + 1, j))) IN
       IF NumEqual(NumFromInt(Len(substrings)), lim) THEN substrings
       ELSE SplitFrom(units, sep, lim, j + Len(sep), StringIndexOf(units, sep, j + Len(sep)), substrings)
\* CreateHTML (§B.2.2.2.1) for the HTML method m, after ToString of the this value.
CreateHTML(s, units, m, value) ==
  LET tag == CASE m = "anchor" -> N("a") [] m = "big" -> N("big") [] m = "blink" -> N("blink")
               [] m = "bold" -> N("b") [] m = "fixed" -> N("tt") [] m \in {"fontcolor", "fontsize"} -> N("font")
               [] m = "italics" -> N("i") [] m = "link" -> N("a") [] m = "small" -> N("small")
               [] m = "strike" -> N("strike") [] m = "sub" -> N("sub") [] m = "sup" -> N("sup")
      attribute == CASE m = "anchor" -> N("name") [] m = "fontcolor" -> N("color") [] m = "fontsize" -> N("size")
                     [] m = "link" -> N("href") [] OTHER -> <<>>
      v == IF attribute = <<>> THEN Ok(s, EmptyStr) ELSE ToStr(s, value)
  IN IF IsAbrupt(v) THEN v
     ELSE LET escaped == FoldLeftSeq([i \in DOMAIN Val(v).value |-> IF Val(v).value[i] = 34 THEN N("&quot;") ELSE <<Val(v).value[i]>>])
              p1 == <<60>> \o tag \o (IF attribute = <<>> THEN <<>> ELSE <<32>> \o attribute \o <<61, 34>> \o escaped \o <<34>>)
          IN Ok(v.s, Str(p1 \o <<62>> \o units \o <<60, 47>> \o tag \o <<62>>))
\* %StringIteratorPrototype%.next (§22.1.5.1.1). The iterator holds the string and the 0-based
\* position of the next code point, as the closure of String.prototype[@@iterator] (§22.1.3.36) does.
StringIteratorBuiltin(s, f, m, this, args, nt) ==
  IF ~IsObject(this) \/ O(s, this).class # "stringIterator" THEN ThrowTypeError(s)
  ELSE LET slots == O(s, this).slots IN
  IF slots.position >= Len(slots.string) THEN CreateIterResultObject(s, Undefined, TRUE)
  ELSE LET next == slots.position + CodePointAt(slots.string, slots.position).count IN
       CreateIterResultObject(SetO(s, this, [O(s, this) EXCEPT !.slots.position = next]),
                              Str(SubSeq(slots.string, slots.position + 1, next)), FALSE)
\* Unicode normalization (UAX #15) into form "NFC", "NFD", "NFKC", or "NFKD", as engine262's host
\* does for String.prototype.normalize (§22.1.3.15).
Normalize(units, form) ==
  LET decomposed == CanonicalOrder(DecomposeAll(StringToCodePoints(units, 0, <<>>), form \in {"NFKC", "NFKD"}), 1, <<>>)
  IN CodePointsToUnits(IF form \in {"NFC", "NFKC"} THEN Compose(decomposed, 1, <<>>, 0, 256) ELSE decomposed)
\* The index of the last row of a sorted table whose first field is at most key, or 0.
UnicodeFloor(table, key, low, high) ==
  IF low > high THEN high
  ELSE LET mid == (low + high) \div 2 IN
       IF table[mid][1] <= key THEN UnicodeFloor(table, key, mid + 1, high) ELSE UnicodeFloor(table, key, low, mid - 1)
\* The code points a table of <<code point, code points>> maps cp to, or <<>>.
UnicodePoint(table, cp) ==
  LET i == UnicodeFloor(table, cp, 1, Len(table)) IN IF i > 0 /\ table[i][1] = cp THEN table[i][2] ELSE <<>>
\* The code points a table of runs <<first, last, step, delta>> maps cp to, or <<>>.
UnicodeRun(table, cp) ==
  LET i == UnicodeFloor(table, cp, 1, Len(table)) IN
  IF i > 0 /\ cp <= table[i][2] /\ (cp - table[i][1]) % table[i][3] = 0 THEN <<cp + table[i][4]>> ELSE <<>>
UnicodeInRanges(table, cp) ==
  LET i == UnicodeFloor(table, cp, 1, Len(table)) IN i > 0 /\ cp <= table[i][2]
UnicodeMapping(runs, special, cp) ==
  LET r == UnicodeRun(runs, cp) IN IF r # <<>> THEN r ELSE UnicodePoint(special, cp)
CombiningClass(cp) ==
  LET i == UnicodeFloor(UnicodeCombiningClasses, cp, 1, Len(UnicodeCombiningClasses)) IN
  IF i > 0 /\ cp <= UnicodeCombiningClasses[i][2] THEN UnicodeCombiningClasses[i][3] ELSE 0
\* The full decomposition of each code point, with Hangul syllables decomposed by formula.
DecomposeAll(cps, isCompatibility) ==
  FoldLeftSeq([i \in DOMAIN cps |->
    LET cp == cps[i]
        index == cp - 44032
        compatible == IF isCompatibility THEN UnicodeMapping(UnicodeCompatibilityRuns, UnicodeCompatibilitySpecial, cp) ELSE <<>>
        canonical == UnicodePoint(UnicodeCanonicalDecompositions, cp)
    IN CASE index >= 0 /\ index < 11172 ->
              <<4352 + index \div 588, 4449 + (index % 588) \div 28>> \o (IF index % 28 = 0 THEN <<>> ELSE <<4519 + (index % 28)>>)
         [] compatible # <<>> -> compatible
         [] canonical # <<>> -> canonical
         [] OTHER -> <<cp>>])
\* The canonical ordering algorithm: a stable sort of each run of nonstarters by combining class.
CanonicalOrder(cps, i, out) ==
  IF i > Len(cps) THEN out
  ELSE LET class == CombiningClass(cps[i])
           k == IF class = 0 THEN Len(out) ELSE MarkPosition(out, class, Len(out))
       IN CanonicalOrder(cps, i + 1, SubSeq(out, 1, k) \o <<cps[i]>> \o SubSeq(out, k + 1, Len(out)))
MarkPosition(out, class, k) ==
  IF k > 0 /\ CombiningClass(out[k]) > class THEN MarkPosition(out, class, k - 1) ELSE k
\* The canonical composition algorithm, with starter the index in out of the last starter or 0, and
\* lastClass the combining class of the last code point kept, or 256 before the first starter.
Compose(cps, i, out, starter, lastClass) ==
  IF i > Len(cps) THEN out
  ELSE LET cp == cps[i]
           class == CombiningClass(cp)
           composite == IF starter > 0 THEN ComposePair(out[starter], cp) ELSE 0
       IN IF composite > 0 /\ (lastClass < class \/ lastClass = 0)
          THEN Compose(cps, i + 1, [out EXCEPT ![starter] = composite], starter, lastClass)
          ELSE Compose(cps, i + 1, Append(out, cp), IF class = 0 THEN Len(out) + 1 ELSE starter, class)
\* The primary composite of a and b, or 0.
ComposePair(a, b) ==
  CASE a >= 4352 /\ a < 4371 /\ b >= 4449 /\ b < 4470 -> 44032 + ((a - 4352) * 21 + b - 4449) * 28
    [] a >= 44032 /\ a < 55204 /\ (a - 44032) % 28 = 0 /\ b > 4519 /\ b < 4547 -> a + b - 4519
    [] OTHER ->
         LET i == CompositionFloor(a, b, 1, Len(UnicodeCompositions)) IN
         IF i > 0 /\ UnicodeCompositions[i][1] = a /\ UnicodeCompositions[i][2] = b THEN UnicodeCompositions[i][3] ELSE 0
\* The index of the last row of UnicodeCompositions whose pair is at most <<a, b>>, or 0.
CompositionFloor(a, b, low, high) ==
  IF low > high THEN high
  ELSE LET mid == (low + high) \div 2
           row == UnicodeCompositions[mid]
       IN IF row[1] < a \/ (row[1] = a /\ row[2] <= b) THEN CompositionFloor(a, b, mid + 1, high)
          ELSE CompositionFloor(a, b, low, mid - 1)
\* Full case mapping, as engine262's host does for String.prototype.toLowerCase (§22.1.3.28) and
\* toUpperCase (§22.1.3.30), with the Final_Sigma condition for U+03A3.
ToLowercase(units) ==
  LET cps == StringToCodePoints(units, 0, <<>>) IN
  CodePointsToUnits(FoldLeftSeq([i \in DOMAIN cps |->
    IF cps[i] = 931 THEN <<IF IsCasedBefore(cps, i - 1) /\ ~IsCasedAfter(cps, i + 1) THEN 962 ELSE 963>>
    ELSE LET mapped == UnicodeMapping(UnicodeLowercaseRuns, UnicodeLowercaseSpecial, cps[i]) IN
         IF mapped = <<>> THEN <<cps[i]>> ELSE mapped]))
ToUppercase(units) ==
  LET cps == StringToCodePoints(units, 0, <<>>) IN
  CodePointsToUnits(FoldLeftSeq([i \in DOMAIN cps |->
    LET mapped == UnicodeMapping(UnicodeUppercaseRuns, UnicodeUppercaseSpecial, cps[i]) IN
    IF mapped = <<>> THEN <<cps[i]>> ELSE mapped]))
\* Whether a cased code point comes at or before index i, past case-ignorable ones, and at or
\* after it. A code point that is both is skipped, as the host does.
IsCasedBefore(cps, i) ==
  IF i < 1 THEN FALSE
  ELSE IF UnicodeInRanges(UnicodeCaseIgnorable, cps[i]) THEN IsCasedBefore(cps, i - 1)
  ELSE UnicodeInRanges(UnicodeCased, cps[i])
IsCasedAfter(cps, i) ==
  IF i > Len(cps) THEN FALSE
  ELSE IF UnicodeInRanges(UnicodeCaseIgnorable, cps[i]) THEN IsCasedAfter(cps, i + 1)
  ELSE UnicodeInRanges(UnicodeCased, cps[i])
\* Unicode 17 data for String.prototype.normalize, toLowerCase, and toUpperCase, which engine262
\* takes from its host. Generated by a one-off script from the host's normalize, case mapping, and
\* Unicode properties, with the combining classes and primary composites of the UCD. Each table is
\* sorted by its first field. A run <<first, last, step, delta>> maps first, first + step, ...
\* last to code point + delta.
\* Canonical_Combining_Class: <<first, last, class>> for the nonzero classes.
\* Full canonical decompositions, Hangul syllables aside: <<code point, code points>>.
\* Full compatibility decompositions to one code point, where they differ from the canonical ones.
\* Full compatibility decompositions to several code points, where they differ from the canonical ones.
\* Primary composites, Hangul aside: <<first, second, composite>>, sorted by first and second.
\* Full lowercase mappings to one code point, U+03A3 aside.
\* Full lowercase mappings to several code points.
\* Full uppercase mappings to one code point.
\* Full uppercase mappings to several code points.
\* Cased: <<first, last>>.
\* Case_Ignorable: <<first, last>>.
\* Array objects (§23.1) and Array Iterator objects (§23.1.5).
ArrayBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> ArrayConstructor(s, f, args, nt)
    [] m = "from" -> ArrayFrom(s, this, Arg(args, 1), Arg(args, 2), Arg(args, 3))
    \* Array.fromAsync (§23.1.2.2) is a built-in async function: its closure runs as an async
    \* function's body would, settling a new promise.
    [] m = "fromAsync" ->
         LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
             settled == AsyncFunctionStep(Val(cap), ArrayFromAsync(cap.s, this, Arg(args, 1), Arg(args, 2), Arg(args, 3)))
         IN Ok(settled.s, Val(cap).promise)
    [] m = "isArray" -> IsArray(s, Arg(args, 1))
    \* Array.of (§23.1.2.3).
    [] m = "of" ->
         LET len == NumFromInt(Len(args))
             a == IF IsConstructor(s, this) THEN Construct(s, this, <<Num(len)>>, this) ELSE ArrayCreateLength(s, len)
         IN IF IsAbrupt(a) THEN a ELSE
            LET filled == CreateDataProperties(a.s, Val(a), args, 0) IN IF IsAbrupt(filled) THEN filled ELSE
            SetLength(filled.s, Val(a), len, Val(a))
    \* get Array [ %Symbol.species% ] (§23.1.2.5).
    [] m = "species" -> Ok(s, this)
    \* Array.prototype.sort and toSorted check the comparator before anything else (§23.1.3.30).
    [] m \in {"sort", "toSorted"} /\ Arg(args, 1) # Undefined /\ ~IsCallable(s, Arg(args, 1)) -> ThrowTypeError(s)
    [] OTHER ->
         LET o == ToObject(s, this) IN IF IsAbrupt(o) THEN o
         ELSE IF m = "values" THEN CreateArrayIterator(o.s, Val(o), "value")
         ELSE IF m = "keys" THEN CreateArrayIterator(o.s, Val(o), "key")
         ELSE IF m = "entries" THEN CreateArrayIterator(o.s, Val(o), "key+value")
         ELSE IF m = "concat" THEN ArrayConcat(o.s, Val(o), args)
         \* Array.prototype.toString (§23.1.3.36).
         ELSE IF m = "toString" THEN
           LET join == Get(o.s, Val(o), SV("join")) IN IF IsAbrupt(join) THEN join
           ELSE IF IsCallable(join.s, Val(join)) THEN Call(join.s, Val(join), Val(o), <<>>)
           ELSE ObjectToString(join.s, Val(o))
         ELSE LET len == LengthOfArrayLike(o.s, Val(o)) IN IF IsAbrupt(len) THEN len
              ELSE ArrayMethod(len.s, Val(o), Val(len).value, m, args)
CreateDataProperties(s, a, values, i) ==
  IF values = <<>> THEN Ok(s, a)
  ELSE LET c == CreateDataPropertyOrThrow(s, a, Index(NumFromInt(i)), Head(values)) IN
       IF IsAbrupt(c) THEN c ELSE CreateDataProperties(c.s, a, Tail(values), i + 1)
\* Sets o's "length" to the Number len, then returns result.
SetLength(s, o, len, result) ==
  LET l == Set(s, o, SV("length"), Num(len), TRUE) IN IF IsAbrupt(l) THEN l ELSE Ok(l.s, result)
\* The Array constructor (§23.1.1.1).
ArrayConstructor(s, f, args, nt) ==
  LET p == GetPrototypeFromConstructor(s, IF nt = Undefined THEN f ELSE nt, "ArrayPrototype") IN
  IF IsAbrupt(p) THEN p
  ELSE IF Len(args) = 1 THEN
    LET a == ArrayCreate(p.s, 0, Val(p))
        len == args[1]
    IN IF ~IsNumber(len) THEN
         LET c == CreateDataPropertyOrThrow(a.s, Val(a), SV("0"), len) IN
         IF IsAbrupt(c) THEN c ELSE Ok(SetO(c.s, Val(a), [O(c.s, Val(a)) EXCEPT !.props[NamedBucket][SV("length")].value = IntV(1)]), Val(a))
       ELSE LET intLen == NumToUint32(len.value) IN
            IF ~NumSameValueZero(intLen, len.value) THEN ThrowError(a.s, "RangeError")
            ELSE Ok(SetO(a.s, Val(a), [O(a.s, Val(a)) EXCEPT !.props[NamedBucket][SV("length")].value = Num(intLen)]), Val(a))
  ELSE LET a == ArrayCreate(p.s, Len(args), Val(p)) IN
       CreateDataProperties(a.s, Val(a), args, 0)
\* Array.from (§23.1.2.1).
ArrayFrom(s, c, items, mapfn, thisArg) ==
  IF mapfn # Undefined /\ ~IsCallable(s, mapfn) THEN ThrowTypeError(s)
  ELSE LET usingIterator == GetMethod(s, items, SymIterator) IN
  IF IsAbrupt(usingIterator) THEN usingIterator
  ELSE IF Val(usingIterator) # Undefined THEN
    LET a == IF IsConstructor(usingIterator.s, c) THEN Construct(usingIterator.s, c, <<>>, c)
             ELSE ArrayCreate(usingIterator.s, 0, Intrinsic(usingIterator.s, "ArrayPrototype"))
    IN IF IsAbrupt(a) THEN a ELSE
       LET it == GetIteratorFromMethod(a.s, items, Val(usingIterator)) IN
       IF IsAbrupt(it) THEN it ELSE ArrayFromIterator(it.s, Val(a), Val(it), mapfn, thisArg, PosZero)
  ELSE
    LET arrayLike == ToObject(usingIterator.s, items)
        len == LengthOfArrayLike(arrayLike.s, Val(arrayLike))
    IN IF IsAbrupt(len) THEN len ELSE
       LET a == IF IsConstructor(len.s, c) THEN Construct(len.s, c, <<Val(len)>>, c)
                ELSE ArrayCreateLength(len.s, Val(len).value)
       IN IF IsAbrupt(a) THEN a ELSE
          LET r == ArrayFromArrayLike(a.s, Val(a), Val(arrayLike), PosZero, Val(len).value, mapfn, thisArg) IN
          IF IsAbrupt(r) THEN r ELSE SetLength(r.s, Val(a), Val(len).value, Val(a))
ArrayFromIterator(s, a, it, mapfn, thisArg, k) ==
  IF ~NumLess(k, MaxSafeInteger) THEN LET e == ThrowTypeError(s) IN IteratorClose(e.s, it, e.c)
  ELSE LET next == IteratorStepValue(s, it) IN IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN SetLength(next.s, a, k, a)
  ELSE LET mapped == IF mapfn = Undefined THEN Ok(next.s, Val(next).value)
                     ELSE Call(next.s, mapfn, thisArg, <<Val(next).value, Num(k)>>)
       IN IF IsAbrupt(mapped) THEN IteratorClose(mapped.s, it, mapped.c)
          ELSE LET d == CreateDataPropertyOrThrow(mapped.s, a, Index(k), Val(mapped)) IN
               IF IsAbrupt(d) THEN IteratorClose(d.s, it, d.c)
               ELSE ArrayFromIterator(d.s, a, it, mapfn, thisArg, NumAdd(k, OneNum))
ArrayFromArrayLike(s, a, arrayLike, k, len, mapfn, thisArg) ==
  IF ~NumLess(k, len) THEN Ok(s, a)
  ELSE LET v == Get(s, arrayLike, Index(k)) IN IF IsAbrupt(v) THEN v ELSE
       LET mapped == IF mapfn = Undefined THEN v ELSE Call(v.s, mapfn, thisArg, <<Val(v), Num(k)>>) IN
       IF IsAbrupt(mapped) THEN mapped ELSE
       LET d == CreateDataPropertyOrThrow(mapped.s, a, Index(k), Val(mapped)) IN
       IF IsAbrupt(d) THEN d ELSE ArrayFromArrayLike(d.s, a, arrayLike, NumAdd(k, OneNum), len, mapfn, thisArg)
\* The fromAsyncClosure of Array.fromAsync, which returns the array with a return completion.
ArrayFromAsync(s, c, items, mapper, thisArg) ==
  IF mapper # Undefined /\ ~IsCallable(s, mapper) THEN ThrowTypeError(s)
  ELSE LET usingAsync == GetMethod(s, items, SymAsyncIterator) IN
  IF IsAbrupt(usingAsync) THEN usingAsync
  ELSE LET usingSync == IF Val(usingAsync) # Undefined THEN Ok(usingAsync.s, Undefined) ELSE GetMethod(usingAsync.s, items, SymIterator) IN
  IF IsAbrupt(usingSync) THEN usingSync
  ELSE IF Val(usingAsync) # Undefined \/ Val(usingSync) # Undefined THEN
    LET it == IF Val(usingAsync) # Undefined THEN GetIteratorFromMethod(usingSync.s, items, Val(usingAsync))
              ELSE LET sync == GetIteratorFromMethod(usingSync.s, items, Val(usingSync)) IN
                   IF IsAbrupt(sync) THEN sync ELSE CreateAsyncFromSyncIterator(sync.s, Val(sync))
    IN IF IsAbrupt(it) THEN it ELSE
    LET a == IF IsConstructor(it.s, c) THEN Construct(it.s, c, <<>>, c) ELSE ArrayCreate(it.s, 0, Intrinsic(it.s, "ArrayPrototype")) IN
    IF IsAbrupt(a) THEN a
    ELSE FromAsyncIterator(a.s, [a |-> Val(a), it |-> Val(it), mapper |-> mapper, thisArg |-> thisArg], PosZero)
  ELSE
    LET arrayLike == ToObject(usingSync.s, items)
        len == LengthOfArrayLike(arrayLike.s, Val(arrayLike))
    IN IF IsAbrupt(len) THEN len ELSE
    LET a == IF IsConstructor(len.s, c) THEN Construct(len.s, c, <<Val(len)>>, c) ELSE ArrayCreateLength(len.s, Val(len).value) IN
    IF IsAbrupt(a) THEN a
    ELSE FromAsyncArrayLike(a.s, [a |-> Val(a), arrayLike |-> Val(arrayLike), len |-> Val(len).value, mapper |-> mapper, thisArg |-> thisArg], PosZero)
FromAsyncReturn(s, a, len) == LET l == SetLength(s, a, len, a) IN IF IsAbrupt(l) THEN l ELSE Abrupt(l.s, Completion("return", a, Empty))
\* The loop of the fromAsyncClosure over iterator st.it, from index k.
FromAsyncIterator(s, st, k) ==
  IF ~NumLess(k, MaxSafeInteger) THEN LET e == ThrowTypeError(s) IN AsyncIteratorClose(e.s, st.it, e.c)
  ELSE LET next == Call(s, st.it.next, st.it.iterator, <<>>) IN
       FromAsyncNextThen(st, k, IF IsAbrupt(next) THEN next ELSE Await(next.s, Val(next)))
FromAsyncNextThen(st, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "FromAsyncNextThen", <<st, k>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE LET done == IteratorComplete(r.s, Val(r)) IN IF IsAbrupt(done) THEN done
  ELSE IF Val(done) THEN FromAsyncReturn(done.s, st.a, k)
  ELSE LET v == Get(done.s, Val(r), SV("value")) IN IF IsAbrupt(v) THEN v
  ELSE IF st.mapper = Undefined THEN FromAsyncDefineThen(st, k, v)
  ELSE LET mapped == Call(v.s, st.mapper, st.thisArg, <<Val(v), Num(k)>>) IN
       IF IsAbrupt(mapped) THEN AsyncIteratorClose(mapped.s, st.it, mapped.c)
       ELSE FromAsyncMappedThen(st, k, Await(mapped.s, Val(mapped)))
FromAsyncMappedThen(st, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "FromAsyncMappedThen", <<st, k>>) ELSE IF IsAbrupt(r) THEN AsyncIteratorClose(r.s, st.it, r.c) ELSE FromAsyncDefineThen(st, k, r)
FromAsyncDefineThen(st, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "FromAsyncDefineThen", <<st, k>>) ELSE
  LET d == CreateDataPropertyOrThrow(r.s, st.a, Index(k), Val(r)) IN
  IF IsAbrupt(d) THEN AsyncIteratorClose(d.s, st.it, d.c) ELSE FromAsyncIterator(d.s, st, NumAdd(k, OneNum))
\* The loop of the fromAsyncClosure over the array-like st.arrayLike, from index k.
FromAsyncArrayLike(s, st, k) ==
  IF ~NumLess(k, st.len) THEN FromAsyncReturn(s, st.a, st.len)
  ELSE LET v == Get(s, st.arrayLike, Index(k)) IN
       FromAsyncValueThen(st, k, IF IsAbrupt(v) THEN v ELSE Await(v.s, Val(v)))
FromAsyncValueThen(st, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "FromAsyncValueThen", <<st, k>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF st.mapper = Undefined THEN FromAsyncStoreThen(st, k, r)
  ELSE LET mapped == Call(r.s, st.mapper, st.thisArg, <<Val(r), Num(k)>>) IN
       FromAsyncStoreThen(st, k, IF IsAbrupt(mapped) THEN mapped ELSE Await(mapped.s, Val(mapped)))
FromAsyncStoreThen(st, k, r) ==
  IF IsSuspended(r) THEN Pass(r, "FromAsyncStoreThen", <<st, k>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE LET d == CreateDataPropertyOrThrow(r.s, st.a, Index(k), Val(r)) IN
       IF IsAbrupt(d) THEN d ELSE FromAsyncArrayLike(d.s, st, NumAdd(k, OneNum))
\* ArraySpeciesCreate (§10.4.2.3). This port has one realm, so step 5's realm check never applies.
ArraySpeciesCreate(s, o, length) ==
  LET len == NumAdd(length, PosZero)
      isArray == IsArray(s, o)
  IN IF IsAbrupt(isArray) THEN isArray
     ELSE IF Val(isArray) = False THEN ArrayCreateLength(isArray.s, len)
     ELSE LET original == Get(isArray.s, o, SV("constructor")) IN IF IsAbrupt(original) THEN original ELSE
     \* Step 4: another realm's %Array% counts as undefined.
     LET realm == IF IsConstructor(original.s, Val(original)) THEN GetFunctionRealm(original.s, Val(original)) ELSE Ok(original.s, original.s.realmId) IN
     IF IsAbrupt(realm) THEN realm ELSE
     LET c == IF Val(realm) # realm.s.realmId /\ Val(original) = Obj(realm.s.realms[Val(realm)].intrinsics["Array"])
              THEN Ok(realm.s, Undefined) ELSE Ok(realm.s, Val(original))
         sp == IF IsObject(Val(c)) THEN Get(c.s, Val(c), SymSpecies) ELSE c
     IN IF IsAbrupt(sp) THEN sp ELSE
     LET ctor == IF IsObject(Val(c)) /\ Val(sp) = Null THEN Undefined ELSE Val(sp) IN
     IF ctor = Undefined THEN ArrayCreateLength(sp.s, len)
     ELSE IF ~IsConstructor(sp.s, ctor) THEN ThrowTypeError(sp.s)
     ELSE Construct(sp.s, ctor, <<Num(len)>>, ctor)
\* ArrayCreate (§10.4.2.2) with a Number length and %Array.prototype%.
ArrayCreateLength(s, length) ==
  IF NumLess(NumToUint32(NumFromInt(-1)), length) THEN ThrowError(s, "RangeError")
  ELSE LET a == ArrayCreate(s, 0, Intrinsic(s, "ArrayPrototype")) IN
       Ok(SetO(a.s, Val(a), [O(a.s, Val(a)) EXCEPT !.props[NamedBucket][SV("length")].value = Num(NumAdd(length, PosZero))]), Val(a))
\* Gives the fresh array a, whose length is already Len(values), the values as its elements, as
\* CreateDataPropertyOrThrow on each index would.
FillArray(s, a, values) == Ok(SetO(s, a, AddIndexProps(O(s, a), values, 1)), a)
\* Array.prototype.concat (§23.1.3.2).
ArrayConcat(s, o, args) ==
  LET a == ArraySpeciesCreate(s, o, PosZero) IN IF IsAbrupt(a) THEN a ELSE
  LET n == ConcatItems(a.s, Val(a), <<o>> \o args, PosZero) IN IF IsAbrupt(n) THEN n ELSE
  SetLength(n.s, Val(a), Val(n), Val(a))
ConcatItems(s, a, items, n) ==
  IF items = <<>> THEN Ok(s, n)
  ELSE LET e == Head(items)
           spreadable == IsConcatSpreadable(s, e)
       IN IF IsAbrupt(spreadable) THEN spreadable
          ELSE IF Val(spreadable) = True THEN
            LET len == LengthOfArrayLike(spreadable.s, e) IN IF IsAbrupt(len) THEN len
            ELSE IF NumLess(MaxSafeInteger, NumAdd(n, Val(len).value)) THEN ThrowTypeError(len.s)
            ELSE LET r == VisitPresent(len.s, e, PosZero, Val(len).value, 1, "copy", [a |-> a, shift |-> n]) IN
                 IF IsAbrupt(r) THEN r ELSE ConcatItems(r.s, a, Tail(items), NumAdd(n, Val(len).value))
          ELSE IF ~NumLess(n, MaxSafeInteger) THEN ThrowTypeError(spreadable.s)
          ELSE LET c == CreateDataPropertyOrThrow(spreadable.s, a, Index(n), e) IN
               IF IsAbrupt(c) THEN c ELSE ConcatItems(c.s, a, Tail(items), NumAdd(n, OneNum))
\* IsConcatSpreadable (§23.1.3.2.1).
IsConcatSpreadable(s, v) ==
  IF ~IsObject(v) THEN Ok(s, False)
  ELSE LET spreadable == Get(s, v, SymIsConcatSpreadable) IN
       IF IsAbrupt(spreadable) THEN spreadable
       ELSE IF Val(spreadable) # Undefined THEN Ok(spreadable.s, ToBoolean(Val(spreadable)))
       ELSE IsArray(spreadable.s, v)
\* The Array.prototype methods that read the length len of the array-like o first.
ArrayMethod(s, o, len, m, args) ==
  \* Array.prototype.at (§23.1.3.1).
  CASE m = "at" ->
         LET r == ToIntegerOrInfinity(s, Arg(args, 1)) IN IF IsAbrupt(r) THEN r ELSE
         LET k == IF NumLess(Val(r).value, PosZero) THEN NumAdd(len, Val(r).value) ELSE Val(r).value IN
         IF NumLess(k, PosZero) \/ ~NumLess(k, len) THEN Ok(r.s, Undefined) ELSE Get(r.s, o, Index(k))
    \* Array.prototype.copyWithin (§23.1.3.4).
    [] m = "copyWithin" ->
         LET to == RelativeIndex(s, Arg(args, 1), len, PosZero) IN IF IsAbrupt(to) THEN to ELSE
         LET from == RelativeIndex(to.s, Arg(args, 2), len, PosZero) IN IF IsAbrupt(from) THEN from ELSE
         LET final == RelativeIndex(from.s, Arg(args, 3), len, len) IN IF IsAbrupt(final) THEN final ELSE
         LET count == MathMin2(NumSub(Val(final), Val(from)), NumSub(len, Val(to)))
             isBackward == NumLess(Val(from), Val(to)) /\ NumLess(Val(to), NumAdd(Val(from), count))
             last == IF isBackward THEN NumSub(count, OneNum) ELSE PosZero
         IN MoveElements(final.s, o, NumAdd(Val(from), last), NumAdd(Val(to), last), count, IF isBackward THEN -1 ELSE 1)
    \* Array.prototype.every, some, and forEach (§23.1.3.6, §23.1.3.29, §23.1.3.15).
    [] m \in {"every", "some", "forEach"} ->
         IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET r == VisitPresent(s, o, PosZero, len, 1, m, [fn |-> Arg(args, 1), this |-> Arg(args, 2)]) IN
              IF IsAbrupt(r) THEN r
              ELSE Ok(r.s, CASE m = "every" -> Bool(~Val(r).stop) [] m = "some" -> Bool(Val(r).stop) [] OTHER -> Undefined)
    \* Array.prototype.fill (§23.1.3.7).
    [] m = "fill" ->
         LET k == RelativeIndex(s, Arg(args, 2), len, PosZero) IN IF IsAbrupt(k) THEN k ELSE
         LET final == RelativeIndex(k.s, Arg(args, 3), len, len) IN IF IsAbrupt(final) THEN final ELSE
         FillFrom(final.s, o, Val(k), Val(final), Arg(args, 1))
    \* Array.prototype.filter (§23.1.3.8).
    [] m = "filter" ->
         IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET a == ArraySpeciesCreate(s, o, PosZero) IN IF IsAbrupt(a) THEN a ELSE
              LET r == VisitPresent(a.s, o, PosZero, len, 1, m,
                                    [fn |-> Arg(args, 1), this |-> Arg(args, 2), a |-> Val(a), to |-> PosZero]) IN
              IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(a))
    \* Array.prototype.find, findIndex, findLast, and findLastIndex (§23.1.3.9 to §23.1.3.12).
    [] m \in {"find", "findIndex", "findLast", "findLastIndex"} ->
         LET r == FindViaPredicate(s, o, len, IF m \in {"find", "findIndex"} THEN 1 ELSE -1, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(r) THEN r ELSE Ok(r.s, IF m \in {"find", "findLast"} THEN Val(r).value ELSE Val(r).index)
    \* Array.prototype.flat (§23.1.3.13).
    [] m = "flat" ->
         LET depth == IF Arg(args, 1) = Undefined THEN Ok(s, OneNum)
                      ELSE LET n == ToIntegerOrInfinity(s, Arg(args, 1)) IN
                           IF IsAbrupt(n) THEN n ELSE Ok(n.s, MathMax2(Val(n).value, PosZero))
         IN IF IsAbrupt(depth) THEN depth ELSE
            LET a == ArraySpeciesCreate(depth.s, o, PosZero) IN IF IsAbrupt(a) THEN a ELSE
            LET r == FlattenIntoArray(a.s, Val(a), o, len, PosZero, Val(depth), Absent, Undefined) IN
            IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(a))
    \* Array.prototype.flatMap (§23.1.3.14).
    [] m = "flatMap" ->
         IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET a == ArraySpeciesCreate(s, o, PosZero) IN IF IsAbrupt(a) THEN a ELSE
              LET r == FlattenIntoArray(a.s, Val(a), o, len, PosZero, OneNum, Arg(args, 1), Arg(args, 2)) IN
              IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(a))
    \* Array.prototype.includes (§23.1.3.16).
    [] m = "includes" ->
         IF NumIsZero(len) THEN Ok(s, False)
         ELSE LET k == RelativeIndex(s, Arg(args, 2), len, PosZero) IN
              IF IsAbrupt(k) THEN k ELSE IncludesFrom(k.s, o, Val(k), len, Arg(args, 1))
    \* Array.prototype.indexOf (§23.1.3.17).
    [] m = "indexOf" ->
         IF NumIsZero(len) THEN Ok(s, IntV(-1))
         ELSE LET k == RelativeIndex(s, Arg(args, 2), len, PosZero) IN IF IsAbrupt(k) THEN k ELSE
              SearchResult(VisitPresent(k.s, o, Val(k), len, 1, "indexOf", [target |-> Arg(args, 1), found |-> Undefined]))
    \* Array.prototype.join (§23.1.3.18).
    [] m = "join" ->
         LET sep == IF Arg(args, 1) = Undefined THEN Ok(s, SV(",")) ELSE ToStr(s, Arg(args, 1)) IN
         IF IsAbrupt(sep) THEN sep ELSE JoinFrom(sep.s, o, len, PosZero, Val(sep).value, <<>>, FALSE)
    \* Array.prototype.lastIndexOf (§23.1.3.20).
    [] m = "lastIndexOf" ->
         IF NumIsZero(len) THEN Ok(s, IntV(-1))
         ELSE LET n == IF Len(args) >= 2 THEN ToIntegerOrInfinity(s, args[2]) ELSE Ok(s, Num(NumSub(len, OneNum))) IN
              IF IsAbrupt(n) THEN n ELSE
              LET k == IF NumLess(Val(n).value, PosZero) THEN NumAdd(len, Val(n).value)
                       ELSE MathMin2(Val(n).value, NumSub(len, OneNum))
              IN SearchResult(VisitPresent(n.s, o, k, NumFromInt(-1), -1, "indexOf",
                                           [target |-> Arg(args, 1), found |-> Undefined]))
    \* Array.prototype.map (§23.1.3.21).
    [] m = "map" ->
         IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET a == ArraySpeciesCreate(s, o, len) IN IF IsAbrupt(a) THEN a ELSE
              LET r == VisitPresent(a.s, o, PosZero, len, 1, m, [fn |-> Arg(args, 1), this |-> Arg(args, 2), a |-> Val(a)]) IN
              IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(a))
    \* Array.prototype.pop (§23.1.3.22).
    [] m = "pop" ->
         IF NumIsZero(len) THEN SetLength(s, o, PosZero, Undefined)
         ELSE LET newLen == NumSub(len, OneNum)
                  e == Get(s, o, Index(newLen))
              IN IF IsAbrupt(e) THEN e ELSE
                 LET d == DeletePropertyOrThrow(e.s, o, Index(newLen)) IN
                 IF IsAbrupt(d) THEN d ELSE SetLength(d.s, o, newLen, Val(e))
    \* Array.prototype.push (§23.1.3.23).
    [] m = "push" ->
         LET newLen == NumAdd(len, NumFromInt(Len(args))) IN
         IF NumLess(MaxSafeInteger, newLen) THEN ThrowTypeError(s)
         ELSE LET w == SetElements(s, o, args, len) IN IF IsAbrupt(w) THEN w ELSE SetLength(w.s, o, newLen, Num(newLen))
    \* Array.prototype.reduce and reduceRight (§23.1.3.24, §23.1.3.25).
    [] m \in {"reduce", "reduceRight"} ->
         LET dir == IF m = "reduce" THEN 1 ELSE -1
             start == IF m = "reduce" THEN PosZero ELSE NumSub(len, OneNum)
             bound == IF m = "reduce" THEN len ELSE NumFromInt(-1)
         IN IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
            ELSE IF NumIsZero(len) /\ Len(args) < 2 THEN ThrowTypeError(s)
            ELSE LET init == IF Len(args) >= 2 THEN Ok(s, [stop |-> TRUE, st |-> [acc |-> args[2], next |-> start]])
                             ELSE VisitPresent(s, o, start, bound, dir, "reduceInit", [acc |-> Undefined, next |-> start, dir |-> dir])
                 IN IF IsAbrupt(init) THEN init
                    ELSE IF ~Val(init).stop THEN ThrowTypeError(init.s)
                    ELSE LET r == VisitPresent(init.s, o, Val(init).st.next, bound, dir, m, [fn |-> Arg(args, 1), acc |-> Val(init).st.acc]) IN
                         IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(r).st.acc)
    \* Array.prototype.reverse (§23.1.3.26).
    [] m = "reverse" -> ReverseFrom(s, o, len, PosZero, MathFloor(NumDiv(len, NumFromInt(2))))
    \* Array.prototype.shift (§23.1.3.27).
    [] m = "shift" ->
         IF NumIsZero(len) THEN SetLength(s, o, PosZero, Undefined)
         ELSE LET first == Get(s, o, SV("0")) IN IF IsAbrupt(first) THEN first ELSE
              LET r == MoveElements(first.s, o, OneNum, PosZero, NumSub(len, OneNum), 1) IN IF IsAbrupt(r) THEN r ELSE
              LET d == DeletePropertyOrThrow(r.s, o, Index(NumSub(len, OneNum))) IN
              IF IsAbrupt(d) THEN d ELSE SetLength(d.s, o, NumSub(len, OneNum), Val(first))
    \* Array.prototype.slice (§23.1.3.28).
    [] m = "slice" ->
         LET k == RelativeIndex(s, Arg(args, 1), len, PosZero) IN IF IsAbrupt(k) THEN k ELSE
         LET final == RelativeIndex(k.s, Arg(args, 2), len, len) IN IF IsAbrupt(final) THEN final ELSE
         LET count == MathMax2(NumSub(Val(final), Val(k)), PosZero)
             a == ArraySpeciesCreate(final.s, o, count)
         IN IF IsAbrupt(a) THEN a ELSE
            LET r == VisitPresent(a.s, o, Val(k), Val(final), 1, "copy", [a |-> Val(a), shift |-> NumNeg(Val(k))]) IN
            IF IsAbrupt(r) THEN r ELSE SetLength(r.s, Val(a), count, Val(a))
    \* Array.prototype.sort (§23.1.3.30).
    [] m = "sort" ->
         LET sorted == SortIndexedProperties(s, o, len, Arg(args, 1), TRUE) IN IF IsAbrupt(sorted) THEN sorted ELSE
         LET w == SetElements(sorted.s, o, Val(sorted), PosZero) IN IF IsAbrupt(w) THEN w ELSE
         DeleteIndices(w.s, o, NumFromInt(Len(Val(sorted))), len, 1)
    \* Array.prototype.splice (§23.1.3.31).
    [] m = "splice" ->
         LET st == RelativeIndex(s, Arg(args, 1), len, PosZero) IN IF IsAbrupt(st) THEN st ELSE
         LET start == Val(st)
             items == Rest(args, 3)
             itemCount == NumFromInt(Len(items))
             dc == CASE Len(args) = 0 -> Ok(st.s, PosZero)
                     [] Len(args) = 1 -> Ok(st.s, NumSub(len, start))
                     [] OTHER -> LET n == ToIntegerOrInfinity(st.s, args[2]) IN
                                 IF IsAbrupt(n) THEN n ELSE Ok(n.s, NumClamp(Val(n).value, PosZero, NumSub(len, start)))
         IN IF IsAbrupt(dc) THEN dc ELSE
         LET deleteCount == Val(dc)
             newLen == NumAdd(NumSub(len, deleteCount), itemCount)
         IN IF NumLess(MaxSafeInteger, newLen) THEN ThrowTypeError(dc.s) ELSE
         LET a == ArraySpeciesCreate(dc.s, o, deleteCount) IN IF IsAbrupt(a) THEN a ELSE
         LET copied == VisitPresent(a.s, o, start, NumAdd(start, deleteCount), 1, "copy", [a |-> Val(a), shift |-> NumNeg(start)]) IN
         IF IsAbrupt(copied) THEN copied ELSE
         LET al == Set(copied.s, Val(a), SV("length"), Num(deleteCount), TRUE) IN IF IsAbrupt(al) THEN al ELSE
         LET moveCount == NumSub(NumSub(len, deleteCount), start)
             moved ==
               CASE NumLess(itemCount, deleteCount) ->
                      LET r == MoveElements(al.s, o, NumAdd(start, deleteCount), NumAdd(start, itemCount), moveCount, 1) IN
                      IF IsAbrupt(r) THEN r ELSE DeleteIndices(r.s, o, NumSub(len, OneNum), NumSub(newLen, OneNum), -1)
                 [] NumLess(deleteCount, itemCount) ->
                      MoveElements(al.s, o, NumSub(len, OneNum), NumSub(newLen, OneNum), moveCount, -1)
                 [] OTHER -> Ok(al.s, o)
         IN IF IsAbrupt(moved) THEN moved ELSE
            LET w == SetElements(moved.s, o, items, start) IN IF IsAbrupt(w) THEN w ELSE SetLength(w.s, o, newLen, Val(a))
    \* Array.prototype.toLocaleString (§23.1.3.32), with "," as the list separator.
    [] m = "toLocaleString" -> JoinFrom(s, o, len, PosZero, N(","), <<>>, TRUE)
    \* Array.prototype.toReversed (§23.1.3.33).
    [] m = "toReversed" ->
         LET a == ArrayCreateLength(s, len) IN IF IsAbrupt(a) THEN a ELSE
         LET values == ReadThrough(a.s, o, NumSub(len, OneNum), len, -1, <<>>) IN
         IF IsAbrupt(values) THEN values ELSE FillArray(values.s, Val(a), Val(values))
    \* Array.prototype.toSorted (§23.1.3.34).
    [] m = "toSorted" ->
         LET a == ArrayCreateLength(s, len) IN IF IsAbrupt(a) THEN a ELSE
         LET sorted == SortIndexedProperties(a.s, o, len, Arg(args, 1), FALSE) IN
         IF IsAbrupt(sorted) THEN sorted ELSE FillArray(sorted.s, Val(a), Val(sorted))
    \* Array.prototype.toSpliced (§23.1.3.35).
    [] m = "toSpliced" ->
         LET st == RelativeIndex(s, Arg(args, 1), len, PosZero) IN IF IsAbrupt(st) THEN st ELSE
         LET start == Val(st)
             items == Rest(args, 3)
             sc == CASE Len(args) = 0 -> Ok(st.s, PosZero)
                     [] Len(args) = 1 -> Ok(st.s, NumSub(len, start))
                     [] OTHER -> LET n == ToIntegerOrInfinity(st.s, args[2]) IN
                                 IF IsAbrupt(n) THEN n ELSE Ok(n.s, NumClamp(Val(n).value, PosZero, NumSub(len, start)))
         IN IF IsAbrupt(sc) THEN sc ELSE
         LET newLen == NumAdd(NumSub(len, Val(sc)), NumFromInt(Len(items))) IN
         IF NumLess(MaxSafeInteger, newLen) THEN ThrowTypeError(sc.s) ELSE
         LET a == ArrayCreateLength(sc.s, newLen) IN IF IsAbrupt(a) THEN a ELSE
         LET before == ReadThrough(a.s, o, PosZero, start, 1, <<>>) IN IF IsAbrupt(before) THEN before ELSE
         LET after == ReadThrough(before.s, o, NumAdd(start, Val(sc)), NumSub(NumSub(len, start), Val(sc)), 1, <<>>) IN
         IF IsAbrupt(after) THEN after ELSE FillArray(after.s, Val(a), Val(before) \o items \o Val(after))
    \* Array.prototype.unshift (§23.1.3.37).
    [] m = "unshift" ->
         LET newLen == NumAdd(len, NumFromInt(Len(args))) IN
         IF args # <<>> /\ NumLess(MaxSafeInteger, newLen) THEN ThrowTypeError(s)
         ELSE LET moved == IF args = <<>> THEN Ok(s, o) ELSE MoveElements(s, o, NumSub(len, OneNum), NumSub(newLen, OneNum), len, -1) IN
              IF IsAbrupt(moved) THEN moved ELSE
              LET w == SetElements(moved.s, o, args, PosZero) IN IF IsAbrupt(w) THEN w ELSE SetLength(w.s, o, newLen, Num(newLen))
    \* Array.prototype.with (§23.1.3.39).
    [] m = "with" ->
         LET r == ToIntegerOrInfinity(s, Arg(args, 1)) IN IF IsAbrupt(r) THEN r ELSE
         LET i == IF NumLess(Val(r).value, PosZero) THEN NumAdd(len, Val(r).value) ELSE Val(r).value IN
         IF NumLess(i, PosZero) \/ ~NumLess(i, len) THEN ThrowError(r.s, "RangeError") ELSE
         LET a == ArrayCreateLength(r.s, len) IN IF IsAbrupt(a) THEN a ELSE
         LET before == ReadThrough(a.s, o, PosZero, i, 1, <<>>) IN IF IsAbrupt(before) THEN before ELSE
         LET after == ReadThrough(before.s, o, NumAdd(i, OneNum), NumSub(NumSub(len, i), OneNum), 1, <<>>) IN
         IF IsAbrupt(after) THEN after ELSE FillArray(after.s, Val(a), Val(before) \o <<Arg(args, 2)>> \o Val(after))
\* The result of indexOf and lastIndexOf from their search.
SearchResult(r) == IF IsAbrupt(r) THEN r ELSE Ok(r.s, IF Val(r).stop THEN Val(r).st.found ELSE IntV(-1))
\* The Set of each value to the indices from k up (Array.prototype.push, splice, sort, unshift).
SetElements(s, o, values, k) ==
  IF values = <<>> THEN Ok(s, o)
  ELSE LET w == Set(s, o, Index(k), Head(values), TRUE) IN
       IF IsAbrupt(w) THEN w ELSE SetElements(w.s, o, Tail(values), NumAdd(k, OneNum))
\* The Get of count indices from k, stepping by dir, appended to acc.
ReadThrough(s, o, k, count, dir, acc) ==
  IF ~NumLess(PosZero, count) THEN Ok(s, acc)
  ELSE LET v == Get(s, o, Index(k)) IN
       IF IsAbrupt(v) THEN v ELSE ReadThrough(v.s, o, NumAdd(k, NumFromInt(dir)), NumSub(count, OneNum), dir, Append(acc, Val(v)))
FillFrom(s, o, k, final, value) ==
  IF ~NumLess(k, final) THEN Ok(s, o)
  ELSE LET w == Set(s, o, Index(k), value, TRUE) IN
       IF IsAbrupt(w) THEN w ELSE FillFrom(w.s, o, NumAdd(k, OneNum), final, value)
\* Array.prototype.includes's loop. An index no object has reads as undefined, so the loop
\* skips such indices unless it searches for undefined.
IncludesFrom(s, o, k, len, target) ==
  IF ~NumLess(k, len) THEN Ok(s, False)
  ELSE LET i == IF target = Undefined THEN k ELSE IndexCandidate(s, o, k, len, 1, FALSE) IN
  IF ~NumEqual(i, k) THEN IncludesFrom(s, o, i, len, target)
  ELSE LET v == Get(s, o, Index(k)) IN IF IsAbrupt(v) THEN v
  ELSE IF SameValueZero(target, Val(v)) THEN Ok(v.s, True)
  ELSE IncludesFrom(v.s, o, NumAdd(k, OneNum), len, target)
\* JoinIndexedProperties: the loop of Array.prototype.join, or of toLocaleString when isLocale.
JoinFrom(s, o, len, k, sep, acc, isLocale) ==
  IF ~NumLess(k, len) THEN Ok(s, Str(acc))
  ELSE LET e == Get(s, o, Index(k)) IN IF IsAbrupt(e) THEN e ELSE
       LET next == IF IsNullish(Val(e)) THEN Ok(e.s, EmptyStr)
                   ELSE IF ~isLocale THEN ToStr(e.s, Val(e))
                   ELSE LET r == Invoke(e.s, Val(e), SV("toLocaleString"), <<>>) IN IF IsAbrupt(r) THEN r ELSE ToStr(r.s, Val(r))
       IN IF IsAbrupt(next) THEN next
          ELSE JoinFrom(next.s, o, len, NumAdd(k, OneNum), sep,
                        (IF NumIsZero(k) THEN acc ELSE acc \o sep) \o Val(next).value, isLocale)
\* FindViaPredicate (§23.1.3.12.1), returning [index, value].
FindViaPredicate(s, o, len, dir, predicate, thisArg) ==
  IF ~IsCallable(s, predicate) THEN ThrowTypeError(s)
  ELSE FindFrom(s, o, IF dir = 1 THEN PosZero ELSE NumSub(len, OneNum), len, dir, predicate, thisArg)
FindFrom(s, o, k, len, dir, predicate, thisArg) ==
  IF NumLess(k, PosZero) \/ ~NumLess(k, len) THEN Ok(s, [index |-> IntV(-1), value |-> Undefined])
  ELSE LET v == Get(s, o, Index(k)) IN IF IsAbrupt(v) THEN v ELSE
       LET t == Call(v.s, predicate, thisArg, <<Val(v), Num(k), o>>) IN IF IsAbrupt(t) THEN t
       ELSE IF ToBooleanValue(Val(t)) THEN Ok(t.s, [index |-> Num(k), value |-> Val(v)])
       ELSE FindFrom(t.s, o, NumAdd(k, NumFromInt(dir)), len, dir, predicate, thisArg)
\* FlattenIntoArray (§23.1.3.13.1), with mapper Absent for none, returning the next target index.
FlattenIntoArray(s, target, source, sourceLen, start, depth, mapper, thisArg) ==
  LET r == VisitPresent(s, source, PosZero, sourceLen, 1, "flatten",
                        [target |-> target, depth |-> depth, fn |-> mapper, this |-> thisArg, index |-> start])
  IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(r).st.index)
\* Array.prototype.reverse's loop (§23.1.3.26 step 5), from lower up to middle. It skips the
\* steps where neither lower nor upper names a property, which do nothing.
ReverseFrom(s, o, len, lower, middle) ==
  IF ~NumLess(lower, middle) THEN Ok(s, o)
  ELSE
    LET upper == NumSub(NumSub(len, lower), OneNum)
        next == MathMin2(IndexCandidate(s, o, lower, middle, 1, FALSE),
                         NumSub(NumSub(len, OneNum),
                                IndexCandidate(s, o, upper, NumSub(NumSub(len, middle), OneNum), -1, FALSE)))
        lowerP == Index(lower)
        upperP == Index(upper)
    IN IF ~NumEqual(next, lower) THEN ReverseFrom(s, o, len, next, middle) ELSE
       LET lowerExists == HasProperty(s, o, lowerP) IN IF IsAbrupt(lowerExists) THEN lowerExists ELSE
       LET lowerValue == IF Val(lowerExists) = True THEN Get(lowerExists.s, o, lowerP) ELSE Ok(lowerExists.s, Undefined) IN
       IF IsAbrupt(lowerValue) THEN lowerValue ELSE
       LET upperExists == HasProperty(lowerValue.s, o, upperP) IN IF IsAbrupt(upperExists) THEN upperExists ELSE
       LET upperValue == IF Val(upperExists) = True THEN Get(upperExists.s, o, upperP) ELSE Ok(upperExists.s, Undefined) IN
       IF IsAbrupt(upperValue) THEN upperValue ELSE
       LET s1 == upperValue.s
           r == CASE Val(lowerExists) = True /\ Val(upperExists) = True ->
                       LET w == Set(s1, o, lowerP, Val(upperValue), TRUE) IN
                       IF IsAbrupt(w) THEN w ELSE Set(w.s, o, upperP, Val(lowerValue), TRUE)
                  [] Val(upperExists) = True ->
                       LET w == Set(s1, o, lowerP, Val(upperValue), TRUE) IN
                       IF IsAbrupt(w) THEN w ELSE DeletePropertyOrThrow(w.s, o, upperP)
                  [] Val(lowerExists) = True ->
                       LET d == DeletePropertyOrThrow(s1, o, lowerP) IN
                       IF IsAbrupt(d) THEN d ELSE Set(d.s, o, upperP, Val(lowerValue), TRUE)
                  [] OTHER -> Ok(s1, o)
       IN IF IsAbrupt(r) THEN r ELSE ReverseFrom(r.s, o, len, NumAdd(lower, OneNum), middle)
\* SortIndexedProperties (§23.1.3.30.1) with CompareArrayElements, skipping holes when skipHoles.
SortIndexedProperties(s, o, len, comparefn, skipHoles) ==
  LET items == IF ~skipHoles THEN ReadThrough(s, o, PosZero, len, 1, <<>>)
               ELSE LET r == VisitPresent(s, o, PosZero, len, 1, "collect", [items |-> <<>>]) IN
                    IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(r).st.items)
  IN IF IsAbrupt(items) THEN items ELSE MergeSort(items.s, Val(items), comparefn)
\* The sort itself is implementation-defined; this one is a stable merge sort.
MergeSort(s, items, comparefn) ==
  IF Len(items) <= 1 THEN Ok(s, items)
  ELSE LET half == Len(items) \div 2
           left == MergeSort(s, SubSeq(items, 1, half), comparefn)
       IN IF IsAbrupt(left) THEN left ELSE
          LET right == MergeSort(left.s, SubSeq(items, half + 1, Len(items)), comparefn) IN
          IF IsAbrupt(right) THEN right ELSE MergeSorted(right.s, Val(left), Val(right), comparefn, <<>>)
MergeSorted(s, xs, ys, comparefn, acc) ==
  IF xs = <<>> THEN Ok(s, acc \o ys)
  ELSE IF ys = <<>> THEN Ok(s, acc \o xs)
  ELSE LET c == CompareArrayElements(s, Head(ys), Head(xs), comparefn) IN
       IF IsAbrupt(c) THEN c
       ELSE IF NumLess(Val(c).value, PosZero) THEN MergeSorted(c.s, xs, Tail(ys), comparefn, Append(acc, Head(ys)))
       ELSE MergeSorted(c.s, Tail(xs), ys, comparefn, Append(acc, Head(xs)))
\* CompareArrayElements (§23.1.3.30.2).
CompareArrayElements(s, x, y, comparefn) ==
  CASE x = Undefined /\ y = Undefined -> Ok(s, IntV(0))
    [] x = Undefined -> Ok(s, IntV(1))
    [] y = Undefined -> Ok(s, IntV(-1))
    [] comparefn # Undefined ->
         LET c == Call(s, comparefn, Undefined, <<x, y>>) IN IF IsAbrupt(c) THEN c ELSE
         LET v == ToNumber(c.s, Val(c)) IN
         IF IsAbrupt(v) THEN v ELSE IF NumIsNaN(Val(v).value) THEN Ok(v.s, IntV(0)) ELSE v
    [] OTHER ->
         LET xs == ToStr(s, x) IN IF IsAbrupt(xs) THEN xs ELSE
         LET ys == ToStr(xs.s, y) IN IF IsAbrupt(ys) THEN ys ELSE
         Ok(ys.s, CASE CodeUnitLess(Val(xs).value, Val(ys).value) -> IntV(-1)
                    [] CodeUnitLess(Val(ys).value, Val(xs).value) -> IntV(1)
                    [] OTHER -> IntV(0))
\* Skipping absent indices. A loop over the indices of an array-like object, which can run up to
\* 2^53 - 1, visits only the indices that some object on its prototype chain may have as an own
\* property. That is observably the same as visiting every index: on the others HasProperty is
\* false and Get is undefined without running user code, so the step does nothing the loop can't
\* account for. IndexCandidate is the nearest such index from k toward bound (k included, bound
\* excluded) in direction dir, or bound if there is none. With own it looks at o's own properties
\* only, as DeletePropertyOrThrow does. A Proxy or another object whose properties only its
\* internal methods know makes it return k, so the loop visits k.
IndexCandidate(s, o, k, bound, dir, own) ==
  IF HasProp(O(s, o), Index(k)) THEN k
  ELSE LET objs == IF own THEN <<o>> ELSE PrototypeChainObjects(s, o) IN
       IF \E i \in DOMAIN objs : O(s, objs[i]).class \in {"proxy", "typedArray", "namespace"} THEN k
       ELSE LET c == NearestIndexIn(s, objs, k, dir, Absent) IN
            IF c # Absent /\ IndexInRange(c, bound, dir) THEN c ELSE bound
IndexInRange(k, bound, dir) == IF dir = 1 THEN NumLess(k, bound) ELSE NumLess(bound, k)
\* The objects on v's prototype chain, from v, up to the first Proxy.
PrototypeChainObjects(s, v) ==
  IF v = Null THEN <<>>
  ELSE IF O(s, v).class = "proxy" THEN <<v>>
  ELSE <<v>> \o PrototypeChainObjects(s, O(s, v).proto)
NearestIndexIn(s, objs, k, dir, best) ==
  IF objs = <<>> THEN best
  ELSE NearestIndexIn(s, Tail(objs), k, dir, NearerIndex(best, NearestOwnIndex(O(s, Head(objs)), k, dir), dir))
\* The nearest own integer key of the object record o from k in direction dir, or Absent. A
\* String exotic object also has the indices of its string.
NearestOwnIndex(o, k, dir) ==
  LET units == NearestIndexUnits(OwnIndexKeys(o) \o o.keys, NumToString(k), dir, Absent)
      size == IF o.class = "string" THEN NumFromInt(Len(o.slots.data)) ELSE PosZero
      fromString == CASE NumIsZero(size) -> Absent
                      [] NumLess(k, size) -> k
                      [] dir = 1 -> Absent
                      [] OTHER -> NumSub(size, OneNum)
  IN NearerIndex(IF units = Absent THEN Absent ELSE StrToNum(units), fromString, dir)
NearerIndex(a, b, dir) ==
  CASE a = Absent -> b
    [] b = Absent -> a
    [] OTHER -> IF (dir = 1) = NumLess(a, b) THEN a ELSE b
\* The nearest key among keys from the digits kU in direction dir, as digits, or best. Comparing
\* digits without leading zeros by length and then by code unit compares them as integers.
NearestIndexUnits(keys, kU, dir, best) ==
  IF keys = <<>> THEN best
  ELSE LET key == Head(keys)
           isNearer == /\ IsString(key)
                       /\ key.value # <<>>
                       /\ IsDigit(Head(key.value))
                       /\ IsCanonicalIntegerUnits(key.value)
                       /\ IF dir = 1 THEN ~DigitsBelow(key.value, kU) ELSE ~DigitsBelow(kU, key.value)
                       /\ \/ best = Absent
                          \/ IF dir = 1 THEN DigitsBelow(key.value, best) ELSE DigitsBelow(best, key.value)
       IN NearestIndexUnits(Tail(keys), kU, dir, IF isNearer THEN key.value ELSE best)
\* The loops that read the present indices from k toward bound in direction dir, as HasProperty
\* and then Get. Each present value goes to the step of method m, which updates the loop's state
\* st and may stop it. The result is [stop, st].
VisitPresent(s, o, k, bound, dir, m, st) ==
  IF ~IndexInRange(k, bound, dir) THEN Ok(s, [stop |-> FALSE, st |-> st])
  ELSE LET i == IndexCandidate(s, o, k, bound, dir, FALSE) IN
  IF ~NumEqual(i, k) THEN VisitPresent(s, o, i, bound, dir, m, st)
  ELSE LET pk == Index(k)
           present == HasProperty(s, o, pk)
       IN IF IsAbrupt(present) THEN present
          ELSE IF Val(present) = False THEN VisitPresent(present.s, o, NumAdd(k, NumFromInt(dir)), bound, dir, m, st)
          ELSE LET v == Get(present.s, o, pk) IN IF IsAbrupt(v) THEN v ELSE
               LET r == ArrayVisitStep(v.s, o, k, Val(v), m, st) IN
               IF IsAbrupt(r) \/ Val(r).stop THEN r
               ELSE VisitPresent(r.s, o, NumAdd(k, NumFromInt(dir)), bound, dir, m, Val(r).st)
VisitNext(s, st) == Ok(s, [stop |-> FALSE, st |-> st])
\* The step of VisitPresent for method m on the present value at index k.
ArrayVisitStep(s, o, k, value, m, st) ==
  CASE m = "copy" ->
         LET c == CreateDataPropertyOrThrow(s, st.a, Index(NumAdd(k, st.shift)), value) IN
         IF IsAbrupt(c) THEN c ELSE VisitNext(c.s, st)
    [] m = "collect" -> VisitNext(s, [st EXCEPT !.items = Append(@, value)])
    [] m = "indexOf" -> Ok(s, [stop |-> IsStrictlyEqual(st.target, value), st |-> [st EXCEPT !.found = Num(k)]])
    [] m = "reduceInit" -> Ok(s, [stop |-> TRUE, st |-> [st EXCEPT !.acc = value, !.next = NumAdd(k, NumFromInt(st.dir))]])
    [] m \in {"reduce", "reduceRight"} ->
         LET r == Call(s, st.fn, Undefined, <<st.acc, value, Num(k), o>>) IN
         IF IsAbrupt(r) THEN r ELSE VisitNext(r.s, [st EXCEPT !.acc = Val(r)])
    [] m = "flatten" ->
         LET mapped == IF st.fn = Absent THEN Ok(s, value) ELSE Call(s, st.fn, st.this, <<value, Num(k), o>>) IN
         IF IsAbrupt(mapped) THEN mapped ELSE
         LET shouldFlatten == IF NumLess(PosZero, st.depth) THEN IsArray(mapped.s, Val(mapped)) ELSE Ok(mapped.s, False) IN
         IF IsAbrupt(shouldFlatten) THEN shouldFlatten
         ELSE IF Val(shouldFlatten) = True THEN
           LET len == LengthOfArrayLike(shouldFlatten.s, Val(mapped)) IN IF IsAbrupt(len) THEN len ELSE
           LET r == FlattenIntoArray(len.s, st.target, Val(mapped), Val(len).value, st.index, NumSub(st.depth, OneNum), Absent, Undefined) IN
           IF IsAbrupt(r) THEN r ELSE VisitNext(r.s, [st EXCEPT !.index = Val(r)])
         ELSE IF ~NumLess(st.index, MaxSafeInteger) THEN ThrowTypeError(shouldFlatten.s)
         ELSE LET c == CreateDataPropertyOrThrow(shouldFlatten.s, st.target, Index(st.index), Val(mapped)) IN
              IF IsAbrupt(c) THEN c ELSE VisitNext(c.s, [st EXCEPT !.index = NumAdd(@, OneNum)])
    \* every, some, forEach, map, and filter call the callback.
    [] OTHER ->
         LET r == Call(s, st.fn, st.this, <<value, Num(k), o>>) IN
         IF IsAbrupt(r) THEN r
         ELSE CASE m = "every" -> Ok(r.s, [stop |-> ~ToBooleanValue(Val(r)), st |-> st])
                [] m = "some" -> Ok(r.s, [stop |-> ToBooleanValue(Val(r)), st |-> st])
                [] m = "forEach" -> VisitNext(r.s, st)
                [] m = "map" ->
                     LET c == CreateDataPropertyOrThrow(r.s, st.a, Index(k), Val(r)) IN
                     IF IsAbrupt(c) THEN c ELSE VisitNext(c.s, st)
                [] m = "filter" ->
                     IF ~ToBooleanValue(Val(r)) THEN VisitNext(r.s, st)
                     ELSE LET c == CreateDataPropertyOrThrow(r.s, st.a, Index(st.to), value) IN
                          IF IsAbrupt(c) THEN c ELSE VisitNext(c.s, [st EXCEPT !.to = NumAdd(@, OneNum)])
\* Moves count elements of o from index from to index to, stepping by dir, as copyWithin, shift,
\* unshift, and splice do (§23.1.3.4 step 16). It skips the steps where from names no property on
\* o's prototype chain and to names no own property of o, which do nothing.
MoveElements(s, o, from, to, count, dir) ==
  IF ~NumLess(PosZero, count) THEN Ok(s, o)
  ELSE
    LET step == NumFromInt(dir)
        skip == MathMin2(NumAbs(NumSub(IndexCandidate(s, o, from, NumAdd(from, NumMul(step, count)), dir, FALSE), from)),
                         NumAbs(NumSub(IndexCandidate(s, o, to, NumAdd(to, NumMul(step, count)), dir, TRUE), to)))
        fromKey == Index(from)
        toKey == Index(to)
    IN IF ~NumIsZero(skip)
       THEN MoveElements(s, o, NumAdd(from, NumMul(step, skip)), NumAdd(to, NumMul(step, skip)), NumSub(count, skip), dir)
       ELSE LET present == HasProperty(s, o, fromKey) IN IF IsAbrupt(present) THEN present ELSE
            LET r == IF Val(present) = True
                     THEN LET v == Get(present.s, o, fromKey) IN IF IsAbrupt(v) THEN v ELSE Set(v.s, o, toKey, Val(v), TRUE)
                     ELSE DeletePropertyOrThrow(present.s, o, toKey)
            IN IF IsAbrupt(r) THEN r ELSE MoveElements(r.s, o, NumAdd(from, step), NumAdd(to, step), NumSub(count, OneNum), dir)
\* DeletePropertyOrThrow of the indices from k toward bound, skipping those o doesn't have.
DeleteIndices(s, o, k, bound, dir) ==
  IF ~IndexInRange(k, bound, dir) THEN Ok(s, o)
  ELSE LET i == IndexCandidate(s, o, k, bound, dir, TRUE) IN
  IF ~NumEqual(i, k) THEN DeleteIndices(s, o, i, bound, dir)
  ELSE LET d == DeletePropertyOrThrow(s, o, Index(k)) IN
       IF IsAbrupt(d) THEN d ELSE DeleteIndices(d.s, o, NumAdd(k, NumFromInt(dir)), bound, dir)
\* CreateArrayIterator (§23.1.5.1). The closure's state lives in the slots: the object iterated,
\* the next index, the kind, and the generator state "suspended", "executing", or "completed".
CreateArrayIterator(s, array, kind) ==
  LET a == Alloc(s, MakeObject(Intrinsic(s, "ArrayIteratorPrototype"), "arrayIterator",
                               [iterated |-> array, next |-> PosZero, kind |-> kind, state |-> "suspended"]))
  IN Ok(a.s, a.v)
\* %ArrayIteratorPrototype%.next (§23.1.5.2.1).
ArrayIteratorNext(s, this) ==
  LET r == ArrayIteratorResume(s, this) IN
  IF IsAbrupt(r) THEN r ELSE CreateIterResultObject(r.s, Val(r).value, Val(r).done)
\* GeneratorResume of the closure, which completes when it returns or throws, as [done, value]
\* rather than the iterator result object, which IteratorStepValue need not allocate.
ArrayIteratorResume(s, this) ==
  IF ~IsObject(this) \/ O(s, this).class # "arrayIterator" THEN ThrowTypeError(s)
  ELSE LET slots == O(s, this).slots IN
  IF slots.state = "executing" THEN ThrowTypeError(s)
  ELSE IF slots.state = "completed" THEN Ok(s, [done |-> TRUE, value |-> Undefined])
  ELSE LET r == ArrayIteratorStep(SetO(s, this, [O(s, this) EXCEPT !.slots.state = "executing"]), slots)
           isDone == IsAbrupt(r) \/ Val(r) = Empty
           s1 == SetO(r.s, this, [O(r.s, this) EXCEPT !.slots.state = IF isDone THEN "completed" ELSE "suspended",
                                                     !.slots.next = IF isDone THEN @ ELSE NumAdd(@, OneNum)])
       IN IF IsAbrupt(r) THEN Abrupt(s1, r.c)
          ELSE Ok(s1, [done |-> isDone, value |-> IF isDone THEN Undefined ELSE Val(r)])
\* One run of the closure of CreateArrayIterator: the value it yields, or Empty when it returns.
ArrayIteratorStep(s, slots) ==
  LET len == IF ~IsTypedArray(s, slots.iterated) THEN LengthOfArrayLike(s, slots.iterated)
             ELSE LET bounds == ValidateTypedArrayBounds(s, slots.iterated) IN
                  IF IsAbrupt(bounds) THEN bounds ELSE Ok(bounds.s, IntV(Val(bounds)))
  IN IF IsAbrupt(len) THEN len
  ELSE IF ~NumLess(slots.next, Val(len).value) THEN Ok(len.s, Empty)
  ELSE IF slots.kind = "key" THEN Ok(len.s, Num(slots.next))
  ELSE LET v == Get(len.s, slots.iterated, Index(slots.next)) IN IF IsAbrupt(v) THEN v
  ELSE IF slots.kind = "value" THEN v
  ELSE CreateArrayFromList(v.s, <<Num(slots.next), Val(v)>>)
ArrayIteratorBuiltin(s, f, m, this, args, nt) == ArrayIteratorNext(s, this)
\* Proxy exotic objects (§10.5). A Proxy object has class "proxy" and slots:
\*   target, handler  [[ProxyTarget]] and [[ProxyHandler]], both Null once revoked
\*   callable         whether it has [[Call]], which is whether its target was callable
\*   constructor      whether it has [[Construct]]
\* ProxyCreate (§10.5.14).
ProxyCreate(s, target, handler) ==
  IF ~IsObject(target) \/ ~IsObject(handler) THEN ThrowTypeError(s)
  ELSE LET a == Alloc(s, MakeObject(Null, "proxy",
                        [target |-> target, handler |-> handler,
                         callable |-> IsCallable(s, target), constructor |-> IsConstructor(s, target)]))
       IN Ok(a.s, a.v)
\* Steps 1 to 6 of each internal method: throws if the proxy is revoked, else returns the trap of
\* the handler named name, or Undefined.
ProxyTrap(s, v, name) ==
  IF O(s, v).slots.handler = Null THEN ThrowTypeError(s)
  ELSE GetMethod(s, O(s, v).slots.handler, name)
\* IsCompatiblePropertyDescriptor (§10.1.6.2), which validates without an object to apply to.
IsCompatiblePropertyDescriptor(extensible, d, current) ==
  ValidateAndApply(MakeObject(Null, "ordinary", [none |-> TRUE]), EmptyStr, extensible, d, current).ok
\* [[GetPrototypeOf]] (§10.5.1).
ProxyGetPrototypeOf(s, v) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("getPrototypeOf"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN GetPrototypeOf(trap.s, target)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ~IsObject(Val(r)) /\ Val(r) # Null THEN ThrowTypeError(r.s)
     ELSE LET e == IsExtensible(r.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE IF Val(e) = True THEN Ok(e.s, Val(r))
     ELSE LET p == GetPrototypeOf(e.s, target) IN
     IF IsAbrupt(p) THEN p
     ELSE IF ~SameValue(Val(r), Val(p)) THEN ThrowTypeError(p.s)
     ELSE Ok(p.s, Val(r))
\* [[SetPrototypeOf]] (§10.5.2).
ProxySetPrototypeOf(s, v, proto) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("setPrototypeOf"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN SetPrototypeOf(trap.s, target, proto)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target, proto>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, False)
     ELSE LET e == IsExtensible(r.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE IF Val(e) = True THEN Ok(e.s, True)
     ELSE LET p == GetPrototypeOf(e.s, target) IN
     IF IsAbrupt(p) THEN p
     ELSE IF ~SameValue(proto, Val(p)) THEN ThrowTypeError(p.s)
     ELSE Ok(p.s, True)
\* [[IsExtensible]] (§10.5.3).
ProxyIsExtensible(s, v) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("isExtensible"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN IsExtensible(trap.s, target)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target>>) IN
     IF IsAbrupt(r) THEN r
     ELSE LET t == IsExtensible(r.s, target) IN
     IF IsAbrupt(t) THEN t
     ELSE IF ToBoolean(Val(r)) # Val(t) THEN ThrowTypeError(t.s)
     ELSE t
\* [[PreventExtensions]] (§10.5.4).
ProxyPreventExtensions(s, v) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("preventExtensions"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN PreventExtensions(trap.s, target)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, False)
     ELSE LET e == IsExtensible(r.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE IF Val(e) = True THEN ThrowTypeError(e.s)
     ELSE Ok(e.s, True)
\* [[GetOwnProperty]] (§10.5.5).
ProxyGetOwnProperty(s, v, k) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("getOwnPropertyDescriptor"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN GetOwnProperty(trap.s, target, k)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target, k>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ~IsObject(Val(r)) /\ Val(r) # Undefined THEN ThrowTypeError(r.s)
     ELSE LET td == GetOwnProperty(r.s, target, k) IN
     IF IsAbrupt(td) THEN td
     ELSE LET targetDesc == Val(td) IN
     IF Val(r) = Undefined THEN
       IF targetDesc = Absent THEN Ok(td.s, Absent)
       ELSE IF targetDesc.configurable = False THEN ThrowTypeError(td.s)
       ELSE LET e == IsExtensible(td.s, target) IN
            IF IsAbrupt(e) THEN e
            ELSE IF Val(e) = False THEN ThrowTypeError(e.s)
            ELSE Ok(e.s, Absent)
     ELSE LET e == IsExtensible(td.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE LET rd == ToPropertyDescriptor(e.s, Val(r)) IN
     IF IsAbrupt(rd) THEN rd
     ELSE LET resultDesc == CompletePropertyDescriptor(Val(rd)) IN
     IF ~IsCompatiblePropertyDescriptor(Truthy(Val(e)), resultDesc, targetDesc) THEN ThrowTypeError(rd.s)
     ELSE IF resultDesc.configurable = False /\
             (targetDesc = Absent \/ targetDesc.configurable = True \/
              (resultDesc.writable = False /\ targetDesc.writable = True))
     THEN ThrowTypeError(rd.s)
     ELSE Ok(rd.s, resultDesc)
\* [[DefineOwnProperty]] (§10.5.6).
ProxyDefineOwnProperty(s, v, k, d) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("defineProperty"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN DefineOwnProperty(trap.s, target, k, d)
     ELSE LET descObj == FromPropertyDescriptor(trap.s, d)
              r == Call(descObj.s, Val(trap), handler, <<target, k, Val(descObj)>>)
          IN IF IsAbrupt(r) THEN r
     ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, False)
     ELSE LET td == GetOwnProperty(r.s, target, k) IN
     IF IsAbrupt(td) THEN td
     ELSE LET e == IsExtensible(td.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE LET targetDesc == Val(td)
              settingConfigFalse == d.configurable = False
          IN IF targetDesc = Absent THEN
               IF Val(e) = False \/ settingConfigFalse THEN ThrowTypeError(e.s) ELSE Ok(e.s, True)
             ELSE IF ~IsCompatiblePropertyDescriptor(Truthy(Val(e)), d, targetDesc) \/
                     (settingConfigFalse /\ targetDesc.configurable = True) \/
                     (IsDataDescriptor(targetDesc) /\ targetDesc.configurable = False /\
                      targetDesc.writable = True /\ d.writable = False)
             THEN ThrowTypeError(e.s)
             ELSE Ok(e.s, True)
\* [[HasProperty]] (§10.5.7).
ProxyHasProperty(s, v, k) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("has"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN HasProperty(trap.s, target, k)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target, k>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ToBooleanValue(Val(r)) THEN Ok(r.s, True)
     ELSE LET td == GetOwnProperty(r.s, target, k) IN
     IF IsAbrupt(td) THEN td
     ELSE IF Val(td) = Absent THEN Ok(td.s, False)
     ELSE IF Val(td).configurable = False THEN ThrowTypeError(td.s)
     ELSE LET e == IsExtensible(td.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE IF Val(e) = False THEN ThrowTypeError(e.s)
     ELSE Ok(e.s, False)
\* [[Get]] (§10.5.8).
ProxyGet(s, v, k, receiver) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("get"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN GetV(trap.s, target, k, receiver)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target, k, receiver>>) IN
     IF IsAbrupt(r) THEN r
     ELSE LET td == GetOwnProperty(r.s, target, k) IN
     IF IsAbrupt(td) THEN td
     ELSE LET d == Val(td) IN
     IF d # Absent /\ d.configurable = False /\
        ((IsDataDescriptor(d) /\ d.writable = False /\ ~SameValue(Val(r), d.value)) \/
         (IsAccessorDescriptor(d) /\ d.get = Undefined /\ Val(r) # Undefined))
     THEN ThrowTypeError(td.s)
     ELSE Ok(td.s, Val(r))
\* [[Set]] (§10.5.9).
ProxySet(s, v, k, value, receiver) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("set"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN SetV(trap.s, target, k, value, receiver)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target, k, value, receiver>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, False)
     ELSE LET td == GetOwnProperty(r.s, target, k) IN
     IF IsAbrupt(td) THEN td
     ELSE LET d == Val(td) IN
     IF d # Absent /\ d.configurable = False /\
        ((IsDataDescriptor(d) /\ d.writable = False /\ ~SameValue(value, d.value)) \/
         (IsAccessorDescriptor(d) /\ d.set = Undefined))
     THEN ThrowTypeError(td.s)
     ELSE Ok(td.s, True)
\* [[Delete]] (§10.5.10).
ProxyDelete(s, v, k) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("deleteProperty"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN Delete(trap.s, target, k)
     ELSE LET r == Call(trap.s, Val(trap), handler, <<target, k>>) IN
     IF IsAbrupt(r) THEN r
     ELSE IF ~ToBooleanValue(Val(r)) THEN Ok(r.s, False)
     ELSE LET td == GetOwnProperty(r.s, target, k) IN
     IF IsAbrupt(td) THEN td
     ELSE IF Val(td) = Absent THEN Ok(td.s, True)
     ELSE IF Val(td).configurable = False THEN ThrowTypeError(td.s)
     ELSE LET e == IsExtensible(td.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE IF Val(e) = False THEN ThrowTypeError(e.s)
     ELSE Ok(e.s, True)
\* [[OwnPropertyKeys]] (§10.5.11). The trap's result and the target's keys have no duplicates, so
\* checking off each target key in turn comes to the subset tests below.
ProxyOwnPropertyKeys(s, v) ==
  LET handler == O(s, v).slots.handler
      target == O(s, v).slots.target
      trap == ProxyTrap(s, v, SV("ownKeys"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN OwnPropertyKeys(trap.s, target)
     ELSE LET array == Call(trap.s, Val(trap), handler, <<target>>) IN
     IF IsAbrupt(array) THEN array
     ELSE LET list == CreateListFromArrayLike(array.s, Val(array), "property-key") IN
     IF IsAbrupt(list) THEN list
     ELSE LET result == Val(list) IN
     IF Cardinality(Range(result)) # Len(result) THEN ThrowTypeError(list.s)
     ELSE LET e == IsExtensible(list.s, target) IN
     IF IsAbrupt(e) THEN e
     ELSE LET ks == OwnPropertyKeys(e.s, target) IN
     IF IsAbrupt(ks) THEN ks
     ELSE LET split == SplitConfigurableKeys(ks.s, target, Val(ks), <<>>, <<>>) IN
     IF IsAbrupt(split) THEN split
     ELSE LET configurable == Range(Val(split).configurable)
              nonconfigurable == Range(Val(split).nonconfigurable)
          IN IF Val(e) = True /\ nonconfigurable = {} THEN Ok(split.s, result)
             ELSE IF ~(nonconfigurable \subseteq Range(result)) THEN ThrowTypeError(split.s)
             ELSE IF Val(e) = True THEN Ok(split.s, result)
             ELSE IF ~(configurable \subseteq Range(result)) THEN ThrowTypeError(split.s)
             ELSE IF ~(Range(result) \subseteq configurable \cup nonconfigurable) THEN ThrowTypeError(split.s)
             ELSE Ok(split.s, result)
\* Steps 16 and 17 of [[OwnPropertyKeys]]: the target's keys, split by whether they are
\* configurable.
SplitConfigurableKeys(s, target, ks, configurable, nonconfigurable) ==
  IF ks = <<>> THEN Ok(s, [configurable |-> configurable, nonconfigurable |-> nonconfigurable])
  ELSE LET d == GetOwnProperty(s, target, Head(ks)) IN
       IF IsAbrupt(d) THEN d
       ELSE IF Val(d) # Absent /\ Val(d).configurable = False
       THEN SplitConfigurableKeys(d.s, target, Tail(ks), configurable, Append(nonconfigurable, Head(ks)))
       ELSE SplitConfigurableKeys(d.s, target, Tail(ks), Append(configurable, Head(ks)), nonconfigurable)
\* [[Call]] (§10.5.12).
ProxyCall(s, f, this, args) ==
  LET handler == O(s, f).slots.handler
      target == O(s, f).slots.target
      trap == ProxyTrap(s, f, SV("apply"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN Call(trap.s, target, this, args)
     ELSE LET array == CreateArrayFromList(trap.s, args) IN
          Call(array.s, Val(trap), handler, <<target, this, Val(array)>>)
\* [[Construct]] (§10.5.13).
ProxyConstruct(s, f, args, newTarget) ==
  LET handler == O(s, f).slots.handler
      target == O(s, f).slots.target
      trap == ProxyTrap(s, f, SV("construct"))
  IN IF IsAbrupt(trap) THEN trap
     ELSE IF Val(trap) = Undefined THEN Construct(trap.s, target, args, newTarget)
     ELSE LET array == CreateArrayFromList(trap.s, args)
              r == Call(array.s, Val(trap), handler, <<target, Val(array), newTarget>>)
          IN IF IsAbrupt(r) THEN r
             ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
             ELSE r
\* The Proxy constructor (§28.2). A revocation function keeps its proxy, or Null once it has
\* revoked it, in its data slot.
ProxyBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         \* Proxy (§28.2.1.1).
         IF nt = Undefined THEN ThrowTypeError(s) ELSE ProxyCreate(s, Arg(args, 1), Arg(args, 2))
    [] m = "revocable" ->
         \* Proxy.revocable (§28.2.2.1).
         LET p == ProxyCreate(s, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(p) THEN p
         ELSE LET revoker == CreateBuiltinFunction(p.s, <<"Proxy", "revoke">>, 0, <<>>, Val(p))
                  result == OrdinaryObjectCreate(revoker.s, Intrinsic(revoker.s, "ObjectPrototype"))
              IN Ok(SetO(result.s, Val(result),
                         WithDataProps(O(result.s, Val(result)),
                                       << <<SV("proxy"), Val(p)>>, <<SV("revoke"), Val(revoker)>> >>)),
                    Val(result))
    [] m = "revoke" ->
         \* Proxy revocation functions (§28.2.2.1.1).
         LET p == O(s, f).slots.data IN
         IF p = Null THEN Ok(s, Undefined)
         ELSE LET s1 == SetO(s, f, [O(s, f) EXCEPT !.slots.data = Null]) IN
              Ok(SetO(s1, p, [O(s1, p) EXCEPT !.slots.target = Null, !.slots.handler = Null]), Undefined)
\* The Reflect object (§28.1).
ReflectBuiltin(s, f, m, this, args, nt) ==
  LET target == Arg(args, 1) IN
  IF m = "apply" THEN
    \* Reflect.apply (§28.1.1).
    IF ~IsCallable(s, target) THEN ThrowTypeError(s)
    ELSE LET l == CreateListFromArrayLike(s, Arg(args, 3), "all") IN
         IF IsAbrupt(l) THEN l ELSE Call(l.s, target, Arg(args, 2), Val(l))
  ELSE IF m = "construct" THEN
    \* Reflect.construct (§28.1.2).
    LET newTarget == IF Len(args) < 3 THEN target ELSE args[3] IN
    IF ~IsConstructor(s, target) \/ ~IsConstructor(s, newTarget) THEN ThrowTypeError(s)
    ELSE LET l == CreateListFromArrayLike(s, Arg(args, 2), "all") IN
         IF IsAbrupt(l) THEN l ELSE Construct(l.s, target, Val(l), newTarget)
  ELSE IF ~IsObject(target) THEN ThrowTypeError(s)
  ELSE IF m = "getPrototypeOf" THEN GetPrototypeOf(s, target)
  ELSE IF m = "setPrototypeOf" THEN
    IF ~IsObject(Arg(args, 2)) /\ Arg(args, 2) # Null THEN ThrowTypeError(s)
    ELSE SetPrototypeOf(s, target, Arg(args, 2))
  ELSE IF m = "isExtensible" THEN IsExtensible(s, target)
  ELSE IF m = "preventExtensions" THEN PreventExtensions(s, target)
  ELSE IF m = "ownKeys" THEN
    LET ks == OwnPropertyKeys(s, target) IN IF IsAbrupt(ks) THEN ks ELSE CreateArrayFromList(ks.s, Val(ks))
  ELSE
    \* The methods that take a property key second.
    LET k == ToPropertyKey(s, Arg(args, 2)) IN
    IF IsAbrupt(k) THEN k
    ELSE CASE m = "defineProperty" ->
                LET d == ToPropertyDescriptor(k.s, Arg(args, 3)) IN
                IF IsAbrupt(d) THEN d ELSE DefineOwnProperty(d.s, target, Val(k), Val(d))
           [] m = "deleteProperty" -> Delete(k.s, target, Val(k))
           [] m = "get" -> GetV(k.s, target, Val(k), IF Len(args) < 3 THEN target ELSE args[3])
           [] m = "getOwnPropertyDescriptor" ->
                LET d == GetOwnProperty(k.s, target, Val(k)) IN
                IF IsAbrupt(d) THEN d ELSE FromPropertyDescriptor(d.s, Val(d))
           [] m = "has" -> HasProperty(k.s, target, Val(k))
           [] m = "set" -> SetV(k.s, target, Val(k), Arg(args, 3), IF Len(args) < 4 THEN target ELSE args[4])
\* Object (§20.1).
ObjectBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1)
      a2 == Arg(args, 2)
  IN
  CASE m = "constructor" ->
         IF nt # Undefined /\ ~SameValue(nt, f)
         THEN OrdinaryCreateFromConstructor(s, nt, "ObjectPrototype", "ordinary", [none |-> TRUE])
         ELSE IF IsNullish(a1) THEN OrdinaryObjectCreate(s, Intrinsic(s, "ObjectPrototype"))
         ELSE ToObject(s, a1)
    [] m = "getPrototypeOf" ->
         LET o == ToObject(s, a1) IN IF IsAbrupt(o) THEN o ELSE GetPrototypeOf(o.s, Val(o))
    [] m = "setPrototypeOf" ->
         IF IsNullish(a1) THEN ThrowTypeError(s)
         ELSE IF ~IsObject(a2) /\ a2 # Null THEN ThrowTypeError(s)
         ELSE IF ~IsObject(a1) THEN Ok(s, a1)
         ELSE LET r == SetPrototypeOf(s, a1, a2) IN
              IF IsAbrupt(r) THEN r ELSE IF Val(r) = False THEN ThrowTypeError(r.s) ELSE Ok(r.s, a1)
    [] m = "defineProperty" ->
         IF ~IsObject(a1) THEN ThrowTypeError(s)
         ELSE LET k == ToPropertyKey(s, a2) IN
         IF IsAbrupt(k) THEN k ELSE
         LET d == ToPropertyDescriptor(k.s, Arg(args, 3)) IN
         IF IsAbrupt(d) THEN d ELSE
         LET r == DefinePropertyOrThrow(d.s, a1, Val(k), Val(d)) IN
         IF IsAbrupt(r) THEN r ELSE Ok(r.s, a1)
    [] m = "defineProperties" -> IF ~IsObject(a1) THEN ThrowTypeError(s) ELSE ObjectDefineProperties(s, a1, a2)
    [] m = "getOwnPropertyDescriptor" ->
         LET o == ToObject(s, a1) IN IF IsAbrupt(o) THEN o ELSE
         LET k == ToPropertyKey(o.s, a2) IN IF IsAbrupt(k) THEN k ELSE
         LET d == GetOwnProperty(k.s, Val(o), Val(k)) IN IF IsAbrupt(d) THEN d ELSE FromPropertyDescriptor(d.s, Val(d))
    [] m = "getOwnPropertyDescriptors" ->
         \* Object.getOwnPropertyDescriptors (§20.1.2.9).
         LET o == ToObject(s, a1) IN IF IsAbrupt(o) THEN o ELSE
         LET ks == OwnPropertyKeys(o.s, Val(o)) IN IF IsAbrupt(ks) THEN ks ELSE
         LET descriptors == OrdinaryObjectCreate(ks.s, Intrinsic(ks.s, "ObjectPrototype")) IN
         AddDescriptors(descriptors.s, Val(o), Val(ks), Val(descriptors))
    [] m \in {"getOwnPropertyNames", "getOwnPropertySymbols"} ->
         LET o == ToObject(s, a1) IN IF IsAbrupt(o) THEN o ELSE
         LET ks == OwnPropertyKeys(o.s, Val(o)) IN IF IsAbrupt(ks) THEN ks ELSE
         CreateArrayFromList(ks.s, SelectSeq(Val(ks), LAMBDA k : IF m = "getOwnPropertyNames" THEN IsString(k) ELSE IsSymbol(k)))
    [] m \in {"keys", "values", "entries"} ->
         LET o == ToObject(s, a1) IN IF IsAbrupt(o) THEN o ELSE
         LET l == EnumerableOwnProperties(o.s, Val(o), CASE m = "keys" -> "key" [] m = "values" -> "value" [] OTHER -> "key+value") IN
         IF IsAbrupt(l) THEN l ELSE CreateArrayFromList(l.s, Val(l))
    [] m = "create" ->
         IF ~IsObject(a1) /\ a1 # Null THEN ThrowTypeError(s)
         ELSE LET o == OrdinaryObjectCreate(s, a1) IN
              IF a2 = Undefined THEN o ELSE ObjectDefineProperties(o.s, Val(o), a2)
    [] m = "assign" ->
         LET to == ToObject(s, a1) IN IF IsAbrupt(to) THEN to ELSE AssignSources(to.s, Val(to), Rest(args, 2))
    [] m = "fromEntries" ->
         \* Object.fromEntries (§20.1.2.7).
         LET c == RequireObjectCoercible(s, a1) IN IF IsAbrupt(c) THEN c ELSE
         LET obj == OrdinaryObjectCreate(c.s, Intrinsic(c.s, "ObjectPrototype"))
             adder == CreateBuiltinFunction(obj.s, <<"Object", "fromEntriesAdder">>, 2, <<>>, Val(obj))
         IN AddEntriesFromIterable(adder.s, Val(obj), a1, Val(adder))
    [] m = "fromEntriesAdder" ->
         LET k == ToPropertyKey(s, a1) IN IF IsAbrupt(k) THEN k ELSE
         LET c == CreateDataPropertyOrThrow(k.s, O(k.s, f).slots.data, Val(k), a2) IN
         IF IsAbrupt(c) THEN c ELSE Ok(c.s, Undefined)
    [] m = "groupBy" ->
         \* Object.groupBy (§20.1.2.12).
         LET groups == GroupBy(s, a1, a2, "property") IN IF IsAbrupt(groups) THEN groups ELSE
         LET obj == OrdinaryObjectCreate(groups.s, Null) IN
         AddGroups(obj.s, Val(obj), Val(groups))
    [] m = "hasOwn" ->
         \* Object.hasOwn (§20.1.2.13).
         LET o == ToObject(s, a1) IN IF IsAbrupt(o) THEN o ELSE
         LET k == ToPropertyKey(o.s, a2) IN IF IsAbrupt(k) THEN k ELSE HasOwnProperty(k.s, Val(o), Val(k))
    [] m = "is" -> Ok(s, Bool(SameValue(a1, a2)))
    [] m \in {"freeze", "seal", "preventExtensions"} ->
         IF ~IsObject(a1) THEN Ok(s, a1)
         ELSE LET r == IF m = "preventExtensions" THEN PreventExtensions(s, a1)
                       ELSE SetIntegrityLevel(s, a1, IF m = "freeze" THEN "frozen" ELSE "sealed")
              IN IF IsAbrupt(r) THEN r ELSE IF Val(r) = False THEN ThrowTypeError(r.s) ELSE Ok(r.s, a1)
    [] m \in {"isFrozen", "isSealed"} ->
         IF ~IsObject(a1) THEN Ok(s, True) ELSE TestIntegrityLevel(s, a1, IF m = "isFrozen" THEN "frozen" ELSE "sealed")
    [] m = "isExtensible" -> IF ~IsObject(a1) THEN Ok(s, False) ELSE IsExtensible(s, a1)
    [] m = "hasOwnProperty" ->
         LET k == ToPropertyKey(s, a1) IN IF IsAbrupt(k) THEN k ELSE
         LET o == ToObject(k.s, this) IN IF IsAbrupt(o) THEN o ELSE HasOwnProperty(o.s, Val(o), Val(k))
    [] m = "isPrototypeOf" ->
         IF ~IsObject(a1) THEN Ok(s, False)
         ELSE LET o == ToObject(s, this) IN IF IsAbrupt(o) THEN o ELSE PrototypeWalk(o.s, a1, Val(o))
    [] m = "propertyIsEnumerable" ->
         LET k == ToPropertyKey(s, a1) IN IF IsAbrupt(k) THEN k ELSE
         LET o == ToObject(k.s, this) IN IF IsAbrupt(o) THEN o ELSE
         LET d == GetOwnProperty(o.s, Val(o), Val(k)) IN
         IF IsAbrupt(d) THEN d ELSE Ok(d.s, IF Val(d) = Absent THEN False ELSE Val(d).enumerable)
    [] m = "toString" -> ObjectToString(s, this)
    [] m = "toLocaleString" -> Invoke(s, this, SV("toString"), <<>>)
    [] m = "valueOf" -> ToObject(s, this)
    [] m \in {"__defineGetter__", "__defineSetter__"} ->
         \* Object.prototype.__defineGetter__ and __defineSetter__ (§B.2.2.2, §B.2.2.3).
         LET o == ToObject(s, this) IN IF IsAbrupt(o) THEN o
         ELSE IF ~IsCallable(o.s, a2) THEN ThrowTypeError(o.s)
         ELSE LET k == ToPropertyKey(o.s, a1) IN IF IsAbrupt(k) THEN k ELSE
         LET d == IF m = "__defineGetter__"
                  THEN [EmptyDesc EXCEPT !.get = a2, !.enumerable = True, !.configurable = True]
                  ELSE [EmptyDesc EXCEPT !.set = a2, !.enumerable = True, !.configurable = True]
             r == DefinePropertyOrThrow(k.s, Val(o), Val(k), d)
         IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Undefined)
    [] m \in {"__lookupGetter__", "__lookupSetter__"} ->
         \* Object.prototype.__lookupGetter__ and __lookupSetter__ (§B.2.2.4, §B.2.2.5).
         LET o == ToObject(s, this) IN IF IsAbrupt(o) THEN o ELSE
         LET k == ToPropertyKey(o.s, a1) IN IF IsAbrupt(k) THEN k ELSE
         LookupAccessor(k.s, Val(o), Val(k), IF m = "__lookupGetter__" THEN "get" ELSE "set")
    [] m = "getProto" ->
         \* get Object.prototype.__proto__ (§B.2.2.1.1).
         LET o == ToObject(s, this) IN IF IsAbrupt(o) THEN o ELSE GetPrototypeOf(o.s, Val(o))
    [] m = "setProto" ->
         \* set Object.prototype.__proto__ (§B.2.2.1.2).
         LET c == RequireObjectCoercible(s, this) IN IF IsAbrupt(c) THEN c
         ELSE IF (~IsObject(a1) /\ a1 # Null) \/ ~IsObject(this) THEN Ok(s, Undefined)
         ELSE LET r == SetPrototypeOf(s, this, a1) IN
              IF IsAbrupt(r) THEN r ELSE IF Val(r) = False THEN ThrowTypeError(r.s) ELSE Ok(r.s, Undefined)
\* Object.prototype.toString (§20.1.3.6).
ObjectToString(s, this) ==
  IF this = Undefined THEN Ok(s, SV("[object Undefined]"))
  ELSE IF this = Null THEN Ok(s, SV("[object Null]"))
  ELSE LET o == ToObject(s, this) IN
  LET isArray == IsArray(o.s, Val(o)) IN
  IF IsAbrupt(isArray) THEN isArray ELSE
  LET class == O(o.s, Val(o)).class
      builtinTag ==
        CASE Val(isArray) = True -> N("Array")
          [] class = "arguments" \/ (class = "ordinary" /\ "argumentsData" \in DOMAIN O(o.s, Val(o)).slots) -> N("Arguments")
          [] IsCallable(o.s, Val(o)) -> N("Function")
          [] class = "error" -> N("Error")
          [] class = "boolean" -> N("Boolean")
          [] class = "number" -> N("Number")
          [] class = "string" -> N("String")
          [] class = "date" -> N("Date")
          [] class = "regexp" -> N("RegExp")
          [] OTHER -> N("Object")
      tag == Get(isArray.s, Val(o), SymToStringTag)
  IN IF IsAbrupt(tag) THEN tag
     ELSE Ok(tag.s, Str(N("[object ") \o (IF IsString(Val(tag)) THEN Val(tag).value ELSE builtinTag) \o N("]")))
\* ObjectDefineProperties (§20.1.2.3.1).
ObjectDefineProperties(s, o, properties) ==
  LET props == ToObject(s, properties) IN IF IsAbrupt(props) THEN props ELSE
  LET ks == OwnPropertyKeys(props.s, Val(props)) IN IF IsAbrupt(ks) THEN ks ELSE
  LET ds == ReadPropertyDescriptors(ks.s, Val(props), Val(ks), <<>>) IN IF IsAbrupt(ds) THEN ds ELSE
  LET r == DefineAll(ds.s, o, Val(ds)) IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, o)
ReadPropertyDescriptors(s, props, ks, acc) ==
  IF ks = <<>> THEN Ok(s, acc)
  ELSE LET d == GetOwnProperty(s, props, Head(ks)) IN IF IsAbrupt(d) THEN d
  ELSE IF Val(d) = Absent \/ Val(d).enumerable # True THEN ReadPropertyDescriptors(d.s, props, Tail(ks), acc)
  ELSE LET obj == Get(d.s, props, Head(ks)) IN IF IsAbrupt(obj) THEN obj ELSE
  LET desc == ToPropertyDescriptor(obj.s, Val(obj)) IN IF IsAbrupt(desc) THEN desc
  ELSE ReadPropertyDescriptors(desc.s, props, Tail(ks), Append(acc, <<Head(ks), Val(desc)>>))
DefineAll(s, o, pairs) ==
  IF pairs = <<>> THEN Ok(s, Empty)
  ELSE LET r == DefinePropertyOrThrow(s, o, Head(pairs)[1], Head(pairs)[2]) IN
       IF IsAbrupt(r) THEN r ELSE DefineAll(r.s, o, Tail(pairs))
\* Object.assign's loop over its sources (§20.1.2.1).
AssignSources(s, to, sources) ==
  IF sources = <<>> THEN Ok(s, to)
  ELSE IF IsNullish(Head(sources)) THEN AssignSources(s, to, Tail(sources))
  ELSE LET from == ToObject(s, Head(sources)) IN
  LET ks == OwnPropertyKeys(from.s, Val(from)) IN IF IsAbrupt(ks) THEN ks ELSE
  LET r == AssignKeys(ks.s, to, Val(from), Val(ks)) IN IF IsAbrupt(r) THEN r ELSE AssignSources(r.s, to, Tail(sources))
AssignKeys(s, to, from, ks) ==
  IF ks = <<>> THEN Ok(s, Empty)
  ELSE LET d == GetOwnProperty(s, from, Head(ks)) IN IF IsAbrupt(d) THEN d
  ELSE IF Val(d) = Absent \/ Val(d).enumerable # True THEN AssignKeys(d.s, to, from, Tail(ks))
  ELSE LET v == Get(d.s, from, Head(ks)) IN IF IsAbrupt(v) THEN v ELSE
  LET w == Set(v.s, to, Head(ks), Val(v), TRUE) IN IF IsAbrupt(w) THEN w ELSE AssignKeys(w.s, to, from, Tail(ks))
\* Object.getOwnPropertyDescriptors' loop over the keys (§20.1.2.9 step 4).
AddDescriptors(s, o, ks, descriptors) ==
  IF ks = <<>> THEN Ok(s, descriptors)
  ELSE LET d == GetOwnProperty(s, o, Head(ks)) IN IF IsAbrupt(d) THEN d
  ELSE IF Val(d) = Absent THEN AddDescriptors(d.s, o, Tail(ks), descriptors)
  ELSE LET desc == FromPropertyDescriptor(d.s, Val(d))
           c == CreateDataPropertyOrThrow(desc.s, descriptors, Head(ks), Val(desc))
       IN AddDescriptors(c.s, o, Tail(ks), descriptors)
\* Object.groupBy's loop over the groups (§20.1.2.12 step 3).
AddGroups(s, obj, groups) ==
  IF groups = <<>> THEN Ok(s, obj)
  ELSE LET elements == CreateArrayFromList(s, Head(groups).elements)
           c == CreateDataPropertyOrThrow(elements.s, obj, Head(groups).key, Val(elements))
       IN AddGroups(c.s, obj, Tail(groups))
\* The loop of __lookupGetter__ and __lookupSetter__ up the prototype chain, reading the
\* descriptor's field "get" or "set".
LookupAccessor(s, o, k, field) ==
  LET d == GetOwnProperty(s, o, k) IN
  IF IsAbrupt(d) THEN d
  ELSE IF Val(d) # Absent THEN Ok(d.s, IF IsAccessorDescriptor(Val(d)) THEN Val(d)[field] ELSE Undefined)
  ELSE LET p == GetPrototypeOf(d.s, o) IN
       IF IsAbrupt(p) THEN p
       ELSE IF Val(p) = Null THEN Ok(p.s, Undefined)
       ELSE LookupAccessor(p.s, Val(p), k, field)
\* AddEntriesFromIterable (§24.1.1.2).
AddEntriesFromIterable(s, target, iterable, adder) ==
  LET it == GetIterator(s, iterable, "sync") IN
  IF IsAbrupt(it) THEN it ELSE AddEntries(it.s, target, Val(it), adder)
AddEntries(s, target, it, adder) ==
  LET next == IteratorStepValue(s, it) IN
  IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN Ok(next.s, target)
  ELSE LET item == Val(next).value IN
  IF ~IsObject(item) THEN LET error == ThrowTypeError(next.s) IN IteratorClose(error.s, it, error.c)
  ELSE LET k == Get(next.s, item, SV("0")) IN
  IF IsAbrupt(k) THEN IteratorClose(k.s, it, k.c)
  ELSE LET v == Get(k.s, item, SV("1")) IN
  IF IsAbrupt(v) THEN IteratorClose(v.s, it, v.c)
  ELSE LET status == Call(v.s, adder, target, <<Val(k), Val(v)>>) IN
  IF IsAbrupt(status) THEN IteratorClose(status.s, it, status.c)
  ELSE AddEntries(status.s, target, it, adder)
\* Scripts (§16.1) and the test262 host.
\* GlobalDeclarationInstantiation (§16.1.7).
GlobalDeclarationInstantiation(s, ctx, script) ==
  LET env == s.globalEnv
      lexNames == LexicallyDeclaredNames(script)
      varNames == VarDeclaredNames(script)
      varDeclarations == VarScopedDeclarations(script)
      functions == FunctionsToInitialize(varDeclarations)
      functionNames == [i \in DOMAIN functions |-> BoundNames(functions[i])[1]]
      varDeclNames == Dedupe(ConcatMap(SelectSeq(varDeclarations, LAMBDA d : d.type \notin FunctionDeclarationTypes), BoundNames))
      declaredVarNames == SelectSeq(varDeclNames, LAMBDA n : n \notin Range(functionNames))
      clash == \E i \in DOMAIN lexNames : HasLexicalDeclaration(s, env, lexNames[i])
      varClash == \E i \in DOMAIN varNames : HasLexicalDeclaration(s, env, varNames[i])
  IN IF clash \/ varClash THEN ThrowError(s, "SyntaxError") ELSE
     LET restricted == AnyRestrictedGlobal(s, env, lexNames) IN IF IsAbrupt(restricted) THEN restricted
     ELSE IF Val(restricted) THEN ThrowError(restricted.s, "SyntaxError") ELSE
     LET fnCheck == CheckGlobalNames(restricted.s, env, Reverse(functionNames), TRUE) IN IF IsAbrupt(fnCheck) THEN fnCheck ELSE
     LET varCheck == CheckGlobalNames(fnCheck.s, env, declaredVarNames, FALSE) IN IF IsAbrupt(varCheck) THEN varCheck ELSE
     LET hoisted == IF Has(script.ScriptBody) /\ script.ScriptBody.strict THEN Ok(varCheck.s, Empty)
                    ELSE HoistFunctions(varCheck.s, env, env, HoistableFunctions(script),
                                        Range(functionNames) \cup Range(declaredVarNames), FALSE)
     IN IF IsAbrupt(hoisted) THEN hoisted ELSE
     LET lex == CreateGlobalLexicals(hoisted.s, env, LexicallyScopedDeclarations(script)) IN IF IsAbrupt(lex) THEN lex ELSE
     LET fns == CreateGlobalFunctions(lex.s, ctx, env, functions) IN IF IsAbrupt(fns) THEN fns ELSE
     CreateGlobalVars(fns.s, env, declaredVarNames)
Reverse(seq) == [i \in DOMAIN seq |-> seq[Len(seq) + 1 - i]]
AnyRestrictedGlobal(s, env, names) ==
  IF names = <<>> THEN Ok(s, FALSE)
  ELSE LET r == HasRestrictedGlobalProperty(s, env, Head(names)) IN
       IF IsAbrupt(r) THEN r ELSE IF Val(r) = True THEN Ok(r.s, TRUE) ELSE AnyRestrictedGlobal(r.s, env, Tail(names))
CheckGlobalNames(s, env, names, isFunction) ==
  IF names = <<>> THEN Ok(s, Empty)
  ELSE LET r == IF isFunction THEN CanDeclareGlobalFunction(s, env, Head(names)) ELSE CanDeclareGlobalVar(s, env, Head(names)) IN
       IF IsAbrupt(r) THEN r ELSE IF Val(r) = False THEN ThrowTypeError(r.s) ELSE CheckGlobalNames(r.s, env, Tail(names), isFunction)
CreateGlobalLexicals(s, env, decls) ==
  IF decls = <<>> THEN Ok(s, Empty)
  ELSE LET r == CreateGlobalLexicalNames(s, env, BoundNames(Head(decls)), IsConstantDeclaration(Head(decls))) IN
       IF IsAbrupt(r) THEN r ELSE CreateGlobalLexicals(r.s, env, Tail(decls))
CreateGlobalLexicalNames(s, env, names, isConst) ==
  IF names = <<>> THEN Ok(s, Empty)
  ELSE LET r == IF isConst THEN CreateImmutableBinding(s, env, Head(names), TRUE)
                ELSE CreateMutableBinding(s, env, Head(names), FALSE)
       IN IF IsAbrupt(r) THEN r ELSE CreateGlobalLexicalNames(r.s, env, Tail(names), isConst)
CreateGlobalFunctions(s, ctx, env, fns) ==
  IF fns = <<>> THEN Ok(s, Empty)
  ELSE LET fo == InstantiateFunctionObject(s, ctx, Head(fns))
           r == CreateGlobalFunctionBinding(fo.s, env, BoundNames(Head(fns))[1], Val(fo), FALSE)
       IN IF IsAbrupt(r) THEN r ELSE CreateGlobalFunctions(r.s, ctx, env, Tail(fns))
CreateGlobalVars(s, env, names) ==
  IF names = <<>> THEN Ok(s, Empty)
  ELSE LET r == CreateGlobalVarBinding(s, env, Head(names), FALSE) IN
       IF IsAbrupt(r) THEN r ELSE CreateGlobalVars(r.s, env, Tail(names))
\* Step 12 of GlobalDeclarationInstantiation and step 13 of EvalDeclarationInstantiation (§B.3.2.2,
\* §B.3.2.3): var bindings for the block functions fns that sloppy code hoists, which eval makes
\* deletable. A binding between the code's lexical environment lex and its var environment keeps a
\* function from hoisting, as does a global lexical one, and declared holds the names already bound.
HoistFunctions(s, lex, varEnv, fns, declared, deletable) ==
  IF fns = <<>> THEN Ok(s, Empty) ELSE
  LET name == Head(fns).BindingIdentifier.name
      isGlobal == E(s, varEnv).kind = "global"
      exists == EvalVarClash(s, lex, varEnv, <<name>>)
  IN IF IsAbrupt(exists) THEN exists
     ELSE IF Val(exists) \/ (isGlobal /\ HasLexicalDeclaration(exists.s, varEnv, name))
     THEN HoistFunctions(exists.s, lex, varEnv, Tail(fns), declared, deletable) ELSE
     LET definable == IF isGlobal THEN CanDeclareGlobalVar(exists.s, varEnv, name) ELSE Ok(exists.s, True) IN
     IF IsAbrupt(definable) THEN definable
     ELSE IF Val(definable) = False THEN HoistFunctions(definable.s, lex, varEnv, Tail(fns), declared, deletable) ELSE
     LET created == CASE name \in declared -> Ok(definable.s, Empty)
                       [] isGlobal -> CreateGlobalVarBinding(definable.s, varEnv, name, deletable)
                       [] OTHER -> BindEvalName(definable.s, varEnv, name, Undefined, FALSE)
     IN IF IsAbrupt(created) THEN created
        ELSE HoistFunctions(HoldEnvs([created.s EXCEPT !.hoisted = @ \cup {<<varEnv, Head(fns).site>>}]),
                            lex, varEnv, Tail(fns), declared \cup {name}, deletable)
\* ScriptEvaluation (§16.1.6).
ScriptEvaluation(s, script) ==
  LET i == GlobalDeclarationInstantiation(s, ScriptContext(s), script) IN
  IF IsAbrupt(i) THEN i
  ELSE IF ~Has(script.ScriptBody) THEN Ok(i.s, Undefined)
  ELSE LET r == EvaluateStatementList(i.s, ScriptContext(i.s), script.ScriptBody.StatementList) IN
       IF ~IsAbrupt(r) /\ Val(r) = Empty THEN Ok(r.s, Undefined) ELSE r
\* Runs scripts in order until one throws, running the jobs each one queues after it.
RunScripts(s, scripts) ==
  IF scripts = <<>> THEN Ok(s, Undefined)
  ELSE LET r == ScriptEvaluation(s, Head(scripts)) IN
       IF IsAbrupt(r) THEN r ELSE
       LET j == RunJobs(r.s) IN
       IF IsAbrupt(j) THEN j ELSE RunScripts(j.s, Tail(scripts))
\* A thrown value's constructor name and string, as code units, for the runner to report.
DescribeThrown(s, v) ==
  LET ctor == IF IsObject(v) THEN Get(s, v, SV("constructor")) ELSE Ok(s, Undefined)
      name == IF ~IsAbrupt(ctor) /\ IsObject(Val(ctor)) THEN Get(ctor.s, Val(ctor), SV("name")) ELSE Ok(s, Undefined)
      text == IF IsAbrupt(name) THEN ToStr(s, v) ELSE ToStr(name.s, v)
  IN [name |-> IF ~IsAbrupt(name) /\ IsString(Val(name)) THEN Val(name).value ELSE <<>>,
      message |-> IF ~IsAbrupt(text) /\ IsString(Val(text)) THEN Val(text).value ELSE <<>>]
\* The result of running the harness scripts in a new realm with the host's parses, for RunFrom.
HarnessResult(scripts, parses) == RunScripts([InitialState EXCEPT !.parses = parses], scripts)
\* Runs a test's scripts, or with RunModuleFrom its module, after a harness result: [ok, name,
\* message, out] with the strings as code units. When the harness threw, so does the test.
\* directory is the test's, where the host loads modules from, canSuspend whether the agent can
\* suspend, and parses the host's parses.
RunFrom(harness, scripts, directory, canSuspend, parses) ==
  TestResult(IF IsAbrupt(harness) THEN harness
             ELSE RunScripts([harness.s EXCEPT !.parses = parses, !.directory = directory, !.canSuspend = canSuspend],
                             scripts))
RunModuleFrom(harness, specifier, directory, canSuspend, parses) ==
  TestResult(IF IsAbrupt(harness) THEN harness
             ELSE RunModule([harness.s EXCEPT !.parses = parses, !.directory = directory, !.canSuspend = canSuspend],
                            specifier))
TestResult(r) ==
  LET thrown == IF r.c.type = "throw" THEN DescribeThrown(r.s, r.c.value) ELSE [name |-> <<>>, message |-> <<>>]
  IN [ok |-> ~IsAbrupt(r), name |-> thrown.name, message |-> thrown.message, out |-> r.s.out]
\* Keyed collections (§24.1 to §24.4) and weak references (§26.1, §26.2). A [[MapData]] list
\* holds [key, value] records and a [[SetData]] list holds values, in insertion order, with a
\* deleted element replaced by Empty, so iteration during mutation sees what the spec says. The
\* weak collections can't be iterated, so a WeakMap holds a function from key to value and a
\* WeakSet a set. Nothing is ever collected, so FinalizationRegistry cleanup never runs.
\* RequireInternalSlot for the slot that objects of a class have.
HasClass(s, v, class) == IsObject(v) /\ O(s, v).class = class
\* CanonicalizeKeyedCollectionKey (§24.5.1).
CanonicalizeKeyedCollectionKey(key) == IF IsNumber(key) /\ key.value = NegZero THEN Num(PosZero) ELSE key
\* The index of the first element of list that isn't empty and is SameValueZero to v, or 0. On a
\* [[SetData]] list this is SetDataIndex (§24.2.1.4).
KeyIndex(list, v) == KeyIndexFrom(list, v, 1)
KeyIndexFrom(list, v, i) ==
  IF i > Len(list) THEN 0
  ELSE IF list[i] # Empty /\ SameValueZero(list[i], v) THEN i
  ELSE KeyIndexFrom(list, v, i + 1)
\* SetDataHas (§24.2.1.3).
SetDataHas(list, v) == KeyIndex(list, v) # 0
\* SetDataSize (§24.2.1.5), and the size of a [[MapData]] list.
LiveCount(list) == Len(SelectSeq(list, LAMBDA e : e # Empty))
\* The keys of a [[MapData]] list, with Empty for a deleted entry.
MapKeys(entries) == [i \in DOMAIN entries |-> IF entries[i] = Empty THEN Empty ELSE entries[i].key]
MapData(s, m) == O(s, m).slots.mapData
SetMapData(s, m, entries) == SetO(s, m, [O(s, m) EXCEPT !.slots.mapData = entries])
SetData(s, set) == O(s, set).slots.setData
SetSetData(s, set, list) == SetO(s, set, [O(s, set) EXCEPT !.slots.setData = list])
\* The loop of the Map, Set, WeakMap, and WeakSet constructors (§24.1.1.1 steps 4 to 6 and
\* AddEntriesFromIterable §24.1.1.2, §24.2.2.1 steps 4 to 8): calls the adder named key on each
\* element of iterable, or on its "0" and "1" properties when isEntries.
AddFromIterable(s, target, iterable, key, isEntries) ==
  IF IsNullish(iterable) THEN Ok(s, target)
  ELSE LET adder == Get(s, target, key) IN IF IsAbrupt(adder) THEN adder
  ELSE IF ~IsCallable(adder.s, Val(adder)) THEN ThrowTypeError(adder.s)
  ELSE LET it == GetIterator(adder.s, iterable, "sync") IN IF IsAbrupt(it) THEN it
  ELSE AddFromIterator(it.s, target, Val(it), Val(adder), isEntries)
AddFromIterator(s, target, it, adder, isEntries) ==
  LET next == IteratorStepValue(s, it) IN IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN Ok(next.s, target)
  ELSE LET item == Val(next).value
           status ==
             IF ~isEntries THEN Call(next.s, adder, target, <<item>>)
             ELSE IF ~IsObject(item) THEN ThrowTypeError(next.s)
             ELSE LET k == Get(next.s, item, SV("0")) IN IF IsAbrupt(k) THEN k
             ELSE LET v == Get(k.s, item, SV("1")) IN IF IsAbrupt(v) THEN v
             ELSE Call(v.s, adder, target, <<Val(k), Val(v)>>)
       IN IF IsAbrupt(status) THEN IteratorClose(status.s, Val(next).iterator, status.c)
          ELSE AddFromIterator(status.s, target, Val(next).iterator, adder, isEntries)
\* GroupBy and AddValueToKeyedGroup (§7.3): the groups as [key, elements] records.
GroupBy(s, items, callback, keyCoercion) ==
  IF IsNullish(items) THEN ThrowTypeError(s)
  ELSE IF ~IsCallable(s, callback) THEN ThrowTypeError(s)
  ELSE LET it == GetIterator(s, items, "sync") IN IF IsAbrupt(it) THEN it
  ELSE GroupFrom(it.s, Val(it), callback, keyCoercion, 0, <<>>)
GroupFrom(s, it, callback, keyCoercion, k, groups) ==
  LET next == IteratorStepValue(s, it) IN IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN Ok(next.s, groups)
  ELSE LET value == Val(next).value
           key == Call(next.s, callback, Undefined, <<value, IntV(k)>>)
           coerced == IF IsAbrupt(key) THEN key
                      ELSE IF keyCoercion = "property" THEN ToPropertyKey(key.s, Val(key))
                      ELSE Ok(key.s, CanonicalizeKeyedCollectionKey(Val(key)))
       IN IF IsAbrupt(coerced) THEN IteratorClose(coerced.s, Val(next).iterator, coerced.c)
          ELSE GroupFrom(coerced.s, Val(next).iterator, callback, keyCoercion, k + 1,
                         AddValueToKeyedGroup(groups, Val(coerced), value))
AddValueToKeyedGroup(groups, key, value) ==
  LET matches == {i \in DOMAIN groups : SameValue(groups[i].key, key)} IN
  IF matches = {} THEN Append(groups, [key |-> key, elements |-> <<value>>])
  ELSE LET i == CHOOSE i \in matches : TRUE IN [groups EXCEPT ![i].elements = Append(@, value)]
\* Map.groupBy (§24.1.2.1): the map's entries, each group's elements as an array.
GroupEntries(s, groups, acc) ==
  IF groups = <<>> THEN [s |-> s, entries |-> acc]
  ELSE LET a == CreateArrayFromList(s, Head(groups).elements) IN
       GroupEntries(a.s, Tail(groups), Append(acc, [key |-> Head(groups).key, value |-> Val(a)]))
\* The forEach loop of Map and Set, which reads the list again at each
\* step, so it visits elements added during the loop.
ForEachFrom(s, o, callback, thisArg, i) ==
  LET isMap == O(s, o).class = "map"
      list == IF isMap THEN MapData(s, o) ELSE SetData(s, o)
  IN IF i > Len(list) THEN Ok(s, Undefined)
     ELSE IF list[i] = Empty THEN ForEachFrom(s, o, callback, thisArg, i + 1)
     ELSE LET r == Call(s, callback, thisArg,
                        IF isMap THEN <<list[i].value, list[i].key, o>> ELSE <<list[i], list[i], o>>)
          IN IF IsAbrupt(r) THEN r ELSE ForEachFrom(r.s, o, callback, thisArg, i + 1)
\* Map (§24.1).
MapBuiltin(s, f, m, this, args, nt) ==
  LET key == Arg(args, 1) IN
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE LET map == OrdinaryCreateFromConstructor(s, nt, "MapPrototype", "map", [mapData |-> <<>>]) IN
              IF IsAbrupt(map) THEN map ELSE AddFromIterable(map.s, Val(map), key, SV("set"), TRUE)
    [] m = "groupBy" ->
         LET groups == GroupBy(s, key, Arg(args, 2), "collection") IN IF IsAbrupt(groups) THEN groups ELSE
         LET g == GroupEntries(groups.s, Val(groups), <<>>)
             a == Alloc(g.s, MakeObject(Intrinsic(g.s, "MapPrototype"), "map", [mapData |-> g.entries]))
         IN Ok(a.s, a.v)
    [] m = "species" -> Ok(s, this)
    [] ~HasClass(s, this, "map") -> ThrowTypeError(s)
    [] OTHER ->
         LET entries == MapData(s, this)
             i == KeyIndex(MapKeys(entries), key)
         IN CASE m = "clear" -> Ok(SetMapData(s, this, [j \in DOMAIN entries |-> Empty]), Undefined)
              [] m = "delete" -> IF i = 0 THEN Ok(s, False) ELSE Ok(SetMapData(s, this, [entries EXCEPT ![i] = Empty]), True)
              [] m \in {"entries", "keys", "values"} ->
                   LET a == Alloc(s, MakeObject(Intrinsic(s, "MapIteratorPrototype"), "mapIterator",
                                                [collection |-> this, index |-> 0,
                                                 kind |-> CASE m = "entries" -> "key+value" [] m = "keys" -> "key" [] OTHER -> "value"]))
                   IN Ok(a.s, a.v)
              [] m = "forEach" -> IF ~IsCallable(s, key) THEN ThrowTypeError(s) ELSE ForEachFrom(s, this, key, Arg(args, 2), 1)
              [] m = "get" -> Ok(s, IF i = 0 THEN Undefined ELSE entries[i].value)
              [] m = "has" -> Ok(s, Bool(i # 0))
              [] m \in {"set", "getOrInsert"} ->
                   LET value == Arg(args, 2) IN
                   IF i # 0 THEN
                     IF m = "set" THEN Ok(SetMapData(s, this, [entries EXCEPT ![i].value = value]), this)
                     ELSE Ok(s, entries[i].value)
                   ELSE Ok(SetMapData(s, this, Append(entries, [key |-> CanonicalizeKeyedCollectionKey(key), value |-> value])),
                           IF m = "set" THEN this ELSE value)
              [] m = "getOrInsertComputed" ->
                   LET callback == Arg(args, 2) IN
                   IF ~IsCallable(s, callback) THEN ThrowTypeError(s)
                   ELSE IF i # 0 THEN Ok(s, entries[i].value)
                   ELSE LET canonical == CanonicalizeKeyedCollectionKey(key)
                            value == Call(s, callback, Undefined, <<canonical>>)
                        IN IF IsAbrupt(value) THEN value
                           ELSE LET now == MapData(value.s, this)
                                    j == KeyIndex(MapKeys(now), canonical)
                                IN Ok(SetMapData(value.s, this,
                                                 IF j # 0 THEN [now EXCEPT ![j].value = Val(value)]
                                                 ELSE Append(now, [key |-> canonical, value |-> Val(value)])),
                                      Val(value))
              [] m = "size" -> Ok(s, IntV(LiveCount(entries)))
\* %MapIteratorPrototype%.next (§24.1.5.2.1) and %SetIteratorPrototype%.next (§24.2.6.2.1), which
\* resume the closures of CreateMapIterator (§24.1.5.1) and CreateSetIterator (§24.2.6.1). The
\* iterator holds its collection, or Undefined once it is done, and the index it has reached.
CollectionIteratorNext(s, this, class) ==
  IF ~HasClass(s, this, class) THEN ThrowTypeError(s)
  ELSE LET slots == O(s, this).slots IN
  IF slots.collection = Undefined THEN CreateIterResultObject(s, Undefined, TRUE)
  ELSE LET isMap == class = "mapIterator"
           list == IF isMap THEN MapData(s, slots.collection) ELSE SetData(s, slots.collection)
           i == NextLiveIndex(list, slots.index)
       IN IF i = 0 THEN CreateIterResultObject(SetO(s, this, [O(s, this) EXCEPT !.slots.collection = Undefined]), Undefined, TRUE)
          ELSE LET s1 == SetO(s, this, [O(s, this) EXCEPT !.slots.index = i])
                   key == IF isMap THEN list[i].key ELSE list[i]
                   value == IF isMap THEN list[i].value ELSE list[i]
               IN CASE slots.kind = "key" -> CreateIterResultObject(s1, key, FALSE)
                    [] slots.kind = "value" -> CreateIterResultObject(s1, value, FALSE)
                    [] OTHER -> LET pair == CreateArrayFromList(s1, <<key, value>>) IN
                                CreateIterResultObject(pair.s, Val(pair), FALSE)
NextLiveIndex(list, i) ==
  IF i >= Len(list) THEN 0 ELSE IF list[i + 1] # Empty THEN i + 1 ELSE NextLiveIndex(list, i + 1)
MapIteratorBuiltin(s, f, m, this, args, nt) == CollectionIteratorNext(s, this, "mapIterator")
SetIteratorBuiltin(s, f, m, this, args, nt) == CollectionIteratorNext(s, this, "setIterator")
\* GetSetRecord (§24.2.1.2), with the size as a Number.
GetSetRecord(s, obj) ==
  IF ~IsObject(obj) THEN ThrowTypeError(s)
  ELSE LET rawSize == Get(s, obj, SV("size")) IN IF IsAbrupt(rawSize) THEN rawSize
  ELSE LET numSize == ToNumber(rawSize.s, Val(rawSize)) IN IF IsAbrupt(numSize) THEN numSize
  ELSE IF NumIsNaN(Val(numSize).value) THEN ThrowTypeError(numSize.s)
  ELSE LET intSize == NumToIntegerOrInfinity(Val(numSize).value) IN
  IF NumLess(intSize, PosZero) THEN ThrowError(numSize.s, "RangeError")
  ELSE LET has == Get(numSize.s, obj, SV("has")) IN IF IsAbrupt(has) THEN has
  ELSE IF ~IsCallable(has.s, Val(has)) THEN ThrowTypeError(has.s)
  ELSE LET keys == Get(has.s, obj, SV("keys")) IN IF IsAbrupt(keys) THEN keys
  ELSE IF ~IsCallable(keys.s, Val(keys)) THEN ThrowTypeError(keys.s)
  ELSE Ok(keys.s, [set |-> obj, size |-> intSize, has |-> Val(has), keys |-> Val(keys)])
\* Whether SetDataSize of a set's [[SetData]] is at most the Set Record's size.
FitsInRecord(list, rec) == ~NumLess(rec.size, NumFromInt(LiveCount(list)))
\* The loops that call rec.has on each element of the set's [[SetData]], reading the list again
\* at each step: intersection collecting into result, isDisjointFrom, and isSubsetOf.
SetHasFrom(s, set, rec, op, i, result) ==
  LET list == SetData(s, set) IN
  IF i > Len(list) THEN Ok(s, IF op = "intersection" THEN result ELSE True)
  ELSE IF list[i] = Empty THEN SetHasFrom(s, set, rec, op, i + 1, result)
  ELSE LET e == list[i]
           r == Call(s, rec.has, rec.set, <<e>>)
       IN IF IsAbrupt(r) THEN r
          ELSE LET inOther == ToBooleanValue(Val(r)) IN
          CASE op = "isDisjointFrom" /\ inOther -> Ok(r.s, False)
            [] op = "isSubsetOf" /\ ~inOther -> Ok(r.s, False)
            [] OTHER -> SetHasFrom(r.s, set, rec, op, i + 1,
                                   IF op = "intersection" /\ inOther /\ ~SetDataHas(result, e)
                                   THEN Append(result, e) ELSE result)
\* The loop of difference over the copy of the set's [[SetData]].
DifferenceHasFrom(s, rec, i, result) ==
  IF i > Len(result) THEN Ok(s, result)
  ELSE IF result[i] = Empty THEN DifferenceHasFrom(s, rec, i + 1, result)
  ELSE LET r == Call(s, rec.has, rec.set, <<result[i]>>) IN
       IF IsAbrupt(r) THEN r
       ELSE DifferenceHasFrom(r.s, rec, i + 1, IF ToBooleanValue(Val(r)) THEN [result EXCEPT ![i] = Empty] ELSE result)
\* The loops over rec's keys: union, intersection, difference, and symmetricDifference build
\* result, and isDisjointFrom and isSupersetOf stop with false when a key is, or isn't, in the
\* set.
SetKeysFrom(s, set, it, op, result) ==
  LET next == IteratorStepValue(s, it) IN IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN Ok(next.s, IF op \in {"isDisjointFrom", "isSupersetOf"} THEN True ELSE result)
  ELSE LET list == SetData(next.s, set)
           key == CanonicalizeKeyedCollectionKey(Val(next).value)
           index == KeyIndex(result, key)
       IN IF (op = "isDisjointFrom" /\ SetDataHas(list, key)) \/ (op = "isSupersetOf" /\ ~SetDataHas(list, key))
          THEN LET c == IteratorClose(next.s, Val(next).iterator, NormalCompletion(Undefined)) IN
               IF IsAbrupt(c) THEN c ELSE Ok(c.s, False)
          ELSE SetKeysFrom(next.s, set, Val(next).iterator, op,
                 CASE op = "union" -> IF index = 0 THEN Append(result, key) ELSE result
                   [] op = "intersection" -> IF SetDataHas(list, key) /\ index = 0 THEN Append(result, key) ELSE result
                   [] op = "difference" -> IF index = 0 THEN result ELSE [result EXCEPT ![index] = Empty]
                   [] op = "symmetricDifference" ->
                        IF SetDataHas(list, key) THEN (IF index = 0 THEN result ELSE [result EXCEPT ![index] = Empty])
                        ELSE IF index = 0 THEN Append(result, key) ELSE result
                   [] OTHER -> result)
\* The set methods that take another set-like object (§24.2.4).
SetOperation(s, this, other, m) ==
  LET rec == GetSetRecord(s, other) IN IF IsAbrupt(rec) THEN rec ELSE
  LET list == SetData(rec.s, this)
      fits == FitsInRecord(list, Val(rec))
      keys == GetIteratorFromMethod(rec.s, Val(rec).set, Val(rec).keys)
      result ==
        CASE m = "difference" /\ fits -> DifferenceHasFrom(rec.s, Val(rec), 1, list)
          [] m \in {"intersection", "isDisjointFrom"} /\ fits -> SetHasFrom(rec.s, this, Val(rec), m, 1, <<>>)
          [] m = "isSubsetOf" -> IF fits THEN SetHasFrom(rec.s, this, Val(rec), m, 1, <<>>) ELSE Ok(rec.s, False)
          [] m = "isSupersetOf" /\ NumLess(NumFromInt(LiveCount(list)), Val(rec).size) -> Ok(rec.s, False)
          [] IsAbrupt(keys) -> keys
          [] OTHER -> SetKeysFrom(keys.s, this, Val(keys), m,
                                  CASE m = "difference" -> list
                                    [] m \in {"union", "symmetricDifference"} -> SetData(keys.s, this)
                                    [] OTHER -> <<>>)
  IN IF IsAbrupt(result) \/ m \in {"isDisjointFrom", "isSubsetOf", "isSupersetOf"} THEN result
     ELSE LET a == Alloc(result.s, MakeObject(Intrinsic(result.s, "SetPrototype"), "set", [setData |-> Val(result)]))
          IN Ok(a.s, a.v)
\* Set (§24.2).
SetBuiltin(s, f, m, this, args, nt) ==
  LET value == Arg(args, 1) IN
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE LET set == OrdinaryCreateFromConstructor(s, nt, "SetPrototype", "set", [setData |-> <<>>]) IN
              IF IsAbrupt(set) THEN set ELSE AddFromIterable(set.s, Val(set), value, SV("add"), FALSE)
    [] m = "species" -> Ok(s, this)
    [] ~HasClass(s, this, "set") -> ThrowTypeError(s)
    [] m \in {"union", "intersection", "difference", "symmetricDifference", "isSubsetOf", "isSupersetOf",
              "isDisjointFrom"} -> SetOperation(s, this, value, m)
    [] OTHER ->
         LET list == SetData(s, this)
             i == KeyIndex(list, value)
         IN CASE m = "add" ->
                   Ok(IF i # 0 THEN s ELSE SetSetData(s, this, Append(list, CanonicalizeKeyedCollectionKey(value))), this)
              [] m = "clear" -> Ok(SetSetData(s, this, [j \in DOMAIN list |-> Empty]), Undefined)
              [] m = "delete" -> IF i = 0 THEN Ok(s, False) ELSE Ok(SetSetData(s, this, [list EXCEPT ![i] = Empty]), True)
              [] m \in {"entries", "values"} ->
                   LET a == Alloc(s, MakeObject(Intrinsic(s, "SetIteratorPrototype"), "setIterator",
                                                [collection |-> this, index |-> 0,
                                                 kind |-> IF m = "entries" THEN "key+value" ELSE "value"]))
                   IN Ok(a.s, a.v)
              [] m = "forEach" -> IF ~IsCallable(s, value) THEN ThrowTypeError(s) ELSE ForEachFrom(s, this, value, Arg(args, 2), 1)
              [] m = "has" -> Ok(s, Bool(i # 0))
              [] m = "size" -> Ok(s, IntV(LiveCount(list)))
\* CanBeHeldWeakly (§9.13).
CanBeHeldWeakly(s, v) == IsObject(v) \/ (IsSymbol(v) /\ KeyForSymbol(s, v) = Undefined)
\* WeakMap (§24.3).
WeakMapBuiltin(s, f, m, this, args, nt) ==
  LET key == Arg(args, 1) IN
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE LET map == OrdinaryCreateFromConstructor(s, nt, "WeakMapPrototype", "weakMap", [weakMapData |-> <<>>]) IN
              IF IsAbrupt(map) THEN map ELSE AddFromIterable(map.s, Val(map), key, SV("set"), TRUE)
    [] ~HasClass(s, this, "weakMap") -> ThrowTypeError(s)
    [] OTHER ->
         LET data == O(s, this).slots.weakMapData
             isHeld == CanBeHeldWeakly(s, key)
             has == isHeld /\ key \in DOMAIN data
             put(s1, v) == SetO(s1, this, [O(s1, this) EXCEPT !.slots.weakMapData = (key :> v) @@ @])
         IN CASE m = "delete" ->
                   IF ~has THEN Ok(s, False)
                   ELSE Ok(SetO(s, this, [O(s, this) EXCEPT !.slots.weakMapData = [k \in DOMAIN data \ {key} |-> data[k]]]), True)
              [] m = "get" -> Ok(s, IF has THEN data[key] ELSE Undefined)
              [] m = "has" -> Ok(s, Bool(has))
              [] ~isHeld -> ThrowTypeError(s)
              [] m = "set" -> Ok(put(s, Arg(args, 2)), this)
              [] m = "getOrInsert" -> IF has THEN Ok(s, data[key]) ELSE Ok(put(s, Arg(args, 2)), Arg(args, 2))
              [] m = "getOrInsertComputed" ->
                   IF ~IsCallable(s, Arg(args, 2)) THEN ThrowTypeError(s)
                   ELSE IF has THEN Ok(s, data[key])
                   ELSE LET v == Call(s, Arg(args, 2), Undefined, <<key>>) IN
                        IF IsAbrupt(v) THEN v ELSE Ok(put(v.s, Val(v)), Val(v))
\* WeakSet (§24.4).
WeakSetBuiltin(s, f, m, this, args, nt) ==
  LET value == Arg(args, 1) IN
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE LET set == OrdinaryCreateFromConstructor(s, nt, "WeakSetPrototype", "weakSet", [weakSetData |-> {}]) IN
              IF IsAbrupt(set) THEN set ELSE AddFromIterable(set.s, Val(set), value, SV("add"), FALSE)
    [] ~HasClass(s, this, "weakSet") -> ThrowTypeError(s)
    [] OTHER ->
         LET data == O(s, this).slots.weakSetData
             isHeld == CanBeHeldWeakly(s, value)
             update(d) == SetO(s, this, [O(s, this) EXCEPT !.slots.weakSetData = d])
         IN CASE m = "add" -> IF ~isHeld THEN ThrowTypeError(s) ELSE Ok(update(data \cup {value}), this)
              [] m = "delete" -> IF isHeld /\ value \in data THEN Ok(update(data \ {value}), True) ELSE Ok(s, False)
              [] m = "has" -> Ok(s, Bool(isHeld /\ value \in data))
\* WeakRef (§26.1). The target is never collected, so AddToKeptObjects has nothing to keep.
WeakRefBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined \/ ~CanBeHeldWeakly(s, Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE OrdinaryCreateFromConstructor(s, nt, "WeakRefPrototype", "weakRef", [weakRefTarget |-> Arg(args, 1)])
    [] m = "deref" -> IF ~HasClass(s, this, "weakRef") THEN ThrowTypeError(s) ELSE Ok(s, O(s, this).slots.weakRefTarget)
\* FinalizationRegistry (§26.2). Each cell is [target, heldValue, unregisterToken], with Empty for
\* no token.
FinalizationRegistryBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1) IN
  CASE m = "constructor" ->
         IF nt = Undefined \/ ~IsCallable(s, a1) THEN ThrowTypeError(s)
         ELSE OrdinaryCreateFromConstructor(s, nt, "FinalizationRegistryPrototype", "finalizationRegistry",
                                            [cleanupCallback |-> a1, cells |-> <<>>])
    [] ~HasClass(s, this, "finalizationRegistry") -> ThrowTypeError(s)
    [] m = "register" ->
         LET token == Arg(args, 3) IN
         IF ~CanBeHeldWeakly(s, a1) \/ SameValue(a1, Arg(args, 2)) THEN ThrowTypeError(s)
         ELSE IF ~CanBeHeldWeakly(s, token) /\ token # Undefined THEN ThrowTypeError(s)
         ELSE Ok(SetO(s, this, [O(s, this) EXCEPT !.slots.cells =
                   Append(@, [target |-> a1, heldValue |-> Arg(args, 2),
                              unregisterToken |-> IF token = Undefined THEN Empty ELSE token])]), Undefined)
    [] m = "unregister" ->
         IF ~CanBeHeldWeakly(s, a1) THEN ThrowTypeError(s)
         ELSE LET cells == O(s, this).slots.cells
                  kept == SelectSeq(cells, LAMBDA c : c.unregisterToken = Empty \/ ~SameValue(c.unregisterToken, a1))
              IN Ok(SetO(s, this, [O(s, this) EXCEPT !.slots.cells = kept]), Bool(Len(kept) # Len(cells)))
\* Explicit resource management: the DisposeCapability operations (§9.1.4), SuppressedError
\* (§20.5.8), DisposableStack (§27.3), and AsyncDisposableStack (§27.4). A resource is [value,
\* kind, method] with kind "sync-dispose" or "async-dispose". The state's disposables holds an
\* environment's resources by its index, and a stack object, of class "disposableStack" or
\* "asyncDisposableStack", holds its own in slots [state, stack] with state "pending" or "disposed".
\* The methods of the two stack prototypes, in the order the spec lists them.
StackProperties(proto, family, disposeName, disposeFunction, disposeKey, tag) ==
  << M(proto, SV("adopt"), family, "adopt", 2),
     M(proto, SV("defer"), family, "defer", 1),
     L(proto, disposeName, disposeFunction, TRUE, FALSE, TRUE),
     G(proto, SV("disposed"), family, "disposed", ""),
     M(proto, SV("move"), family, "move", 0),
     M(proto, SV("use"), family, "use", 1),
     L(proto, disposeKey, disposeFunction, TRUE, FALSE, TRUE),
     V(proto, SymToStringTag, tag, FALSE, FALSE, TRUE) >>
\* The SuppressedError constructor's steps (§20.5.8.1.1), for the prototype of newTarget.
SuppressedErrorConstructor(s, newTarget, error, suppressed, message) ==
  LET o == ErrorConstructor(s, newTarget, "SuppressedErrorPrototype", message, Undefined) IN
  IF IsAbrupt(o) THEN o ELSE
  LET e == CreateMethodProperty(o.s, Val(o), SV("error"), error)
      d == CreateMethodProperty(e.s, Val(o), SV("suppressed"), suppressed)
  IN Ok(d.s, Val(o))
\* The resource AddDisposableResource (§9.1.4.2) adds for value, by CreateDisposableResource
\* (§9.1.4.3), or Empty for a null or undefined value of a using declaration, which adds none.
DisposableResource(s, value, kind) ==
  IF IsNullish(value) THEN Ok(s, IF kind = "sync-dispose" THEN Empty ELSE [value |-> Undefined, kind |-> kind, method |-> Undefined])
  ELSE LET method == GetDisposeMethod(s, value, kind) IN
       IF IsAbrupt(method) THEN method
       ELSE IF Val(method) = Undefined THEN ThrowTypeError(method.s)
       ELSE Ok(method.s, [value |-> value, kind |-> kind, method |-> Val(method)])
\* GetDisposeMethod (§9.1.4.4). An await using of an object with only @@dispose gets a function
\* that calls it and returns a promise for undefined.
GetDisposeMethod(s, value, kind) ==
  IF ~IsObject(value) THEN ThrowTypeError(s)
  ELSE IF kind = "sync-dispose" THEN GetMethod(s, value, SymDispose)
  ELSE LET async == GetMethod(s, value, SymAsyncDispose) IN
       IF IsAbrupt(async) \/ Val(async) # Undefined THEN async
       ELSE LET sync == GetMethod(async.s, value, SymDispose) IN
            IF IsAbrupt(sync) \/ Val(sync) = Undefined THEN sync
            ELSE CreateBuiltinFunction(sync.s, <<"Disposable", "fromSync">>, 0, <<>>, Val(sync))
\* AddDisposableResource (§9.1.4.2) for a binding of environment e, of a declaration of kind
\* "normal", "sync-dispose", or "async-dispose".
AddDisposableResource(s, e, value, kind) ==
  IF kind = "normal" THEN Ok(s, Empty) ELSE
  LET resource == DisposableResource(s, value, kind) IN
  IF IsAbrupt(resource) \/ Val(resource) = Empty THEN resource
  ELSE Ok(HoldEnvs([resource.s EXCEPT !.disposables = (e :> Append(EnvDisposables(resource.s, e), Val(resource))) @@ @]), Empty)
EnvDisposables(s, e) == IF e \in DOMAIN s.disposables THEN s.disposables[e] ELSE <<>>
\* The kind of resource a declaration adds.
DeclarationKind(n) ==
  CASE n.type = "UsingDeclaration" \/ (n.type = "ForDeclaration" /\ n.production = "Using") -> "sync-dispose"
    [] n.type = "AwaitUsingDeclaration" \/ (n.type = "ForDeclaration" /\ n.production = "AwaitUsing") -> "async-dispose"
    [] OTHER -> "normal"
\* Whether a statement list declares resources in the environment it runs in.
HasUsing(list) == \E i \in DOMAIN List(list) : DeclarationKind(List(list)[i]) # "normal"
\* Evaluates the statements of a block, function body, or module, then disposes the resources
\* they add to the environment they run in.
EvaluateDisposing(s, ctx, list) ==
  IF HasUsing(list) THEN DisposeThen(ctx.lex, EvaluateStatementList(s, ctx, list)) ELSE EvaluateStatementList(s, ctx, list)
\* Disposes the resources of environment e once its code completes with r.
DisposeThen(e, r) ==
  IF IsSuspended(r) THEN Pass(r, "DisposeThen", <<e>>) ELSE DisposeResources(EnvDisposables(r.s, e), r)
\* DisposeResources (§9.1.4.6): disposes the resources of stack, last first, into the completion of
\* r. A sync-dispose resource after an async-dispose one with no method awaits first, once.
DisposeResources(stack, r) == DisposeFrom(r.s, stack, Len(stack), FALSE, FALSE, r.c)
DisposeFrom(s, stack, i, needsAwait, hasAwaited, c) ==
  CASE i = 0 /\ needsAwait /\ ~hasAwaited -> DisposedThen(c, Await(s, Undefined))
    [] i = 0 -> Abrupt(s, c)
    [] stack[i].kind = "sync-dispose" /\ needsAwait /\ ~hasAwaited ->
         DisposeAwaitedThen(stack, i, hasAwaited, c, Await(s, Undefined))
    [] stack[i].method = Undefined -> DisposeFrom(s, stack, i - 1, TRUE, hasAwaited, c)
    [] OTHER ->
         LET call == Call(s, stack[i].method, stack[i].value, <<>>)
             isAwaited == stack[i].kind = "async-dispose" /\ ~IsAbrupt(call)
         IN DisposeResultThen(stack, i, needsAwait, hasAwaited \/ isAwaited, c,
                              IF isAwaited THEN Await(call.s, Val(call)) ELSE call)
DisposedThen(c, r) ==
  IF IsSuspended(r) THEN Pass(r, "DisposedThen", <<c>>) ELSE Abrupt(r.s, c)
DisposeAwaitedThen(stack, i, hasAwaited, c, r) ==
  IF IsSuspended(r) THEN Pass(r, "DisposeAwaitedThen", <<stack, i, hasAwaited, c>>) ELSE DisposeFrom(r.s, stack, i, FALSE, hasAwaited, c)
DisposeResultThen(stack, i, needsAwait, hasAwaited, c, r) ==
  IF IsSuspended(r) THEN Pass(r, "DisposeResultThen", <<stack, i, needsAwait, hasAwaited, c>>) ELSE
  IF r.c.type # "throw" THEN DisposeFrom(r.s, stack, i - 1, needsAwait, hasAwaited, c)
  ELSE IF c.type # "throw" THEN DisposeFrom(r.s, stack, i - 1, needsAwait, hasAwaited, r.c)
  ELSE LET error == SuppressedErrorConstructor(r.s, Intrinsic(r.s, "SuppressedError"), r.c.value, c.value, Undefined)
       IN DisposeFrom(error.s, stack, i - 1, needsAwait, hasAwaited, ThrowCompletion(Val(error)))
\* The DisposableStack and AsyncDisposableStack constructors (§27.3.1.1, §27.4.1.1).
NewDisposableStack(s, nt, ctor, class) ==
  IF nt = Undefined THEN ThrowTypeError(s)
  ELSE OrdinaryCreateFromConstructor(s, nt, ctor \o "Prototype", class, [state |-> "pending", stack |-> <<>>])
\* The methods the two stack prototypes share (§27.3.3, §27.4.3), on a stack of the class, whose
\* resources are of the kind.
StackMethod(s, m, ctor, class, kind, this, args) ==
  IF ~IsObject(this) \/ O(s, this).class # class THEN ThrowTypeError(s) ELSE
  LET slots == O(s, this).slots
      Push(state, resource) == SetO(state, this, [O(state, this) EXCEPT !.slots.stack = Append(@, resource)])
  IN CASE m = "disposed" -> Ok(s, Bool(slots.state = "disposed"))
       [] slots.state = "disposed" -> IF m = "dispose" THEN Ok(s, Undefined) ELSE ThrowError(s, "ReferenceError")
       [] m = "dispose" ->
            DisposeResources(slots.stack, Ok(SetO(s, this, [O(s, this) EXCEPT !.slots.state = "disposed"]), Undefined))
       [] m = "use" ->
            LET resource == DisposableResource(s, Arg(args, 1), kind) IN
            IF IsAbrupt(resource) THEN resource
            ELSE Ok(IF Val(resource) = Empty THEN resource.s ELSE Push(resource.s, Val(resource)), Arg(args, 1))
       [] m = "adopt" ->
            IF ~IsCallable(s, Arg(args, 2)) THEN ThrowTypeError(s)
            ELSE LET f == CreateBuiltinFunction(s, <<"Disposable", "adopted">>, 0, <<>>, [value |-> Arg(args, 1), onDispose |-> Arg(args, 2)])
                 IN Ok(Push(f.s, [value |-> Undefined, kind |-> kind, method |-> Val(f)]), Arg(args, 1))
       [] m = "defer" ->
            IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
            ELSE Ok(Push(s, [value |-> Undefined, kind |-> kind, method |-> Arg(args, 1)]), Undefined)
       [] m = "move" ->
            LET moved == OrdinaryCreateFromConstructor(s, Intrinsic(s, ctor), ctor \o "Prototype", class,
                                                       [state |-> "pending", stack |-> slots.stack])
            IN IF IsAbrupt(moved) THEN moved
               ELSE Ok(SetO(moved.s, this, [O(moved.s, this) EXCEPT !.slots = [state |-> "disposed", stack |-> <<>>]]), Val(moved))
DisposableBuiltin(s, f, m, this, args, nt) ==
  CASE m = "SuppressedError" ->
         SuppressedErrorConstructor(s, IF nt = Undefined THEN f ELSE nt, Arg(args, 1), Arg(args, 2), Arg(args, 3))
    [] m = "constructor" -> NewDisposableStack(s, nt, "DisposableStack", "disposableStack")
    \* The closure of DisposableStack.prototype.adopt and AsyncDisposableStack.prototype.adopt.
    [] m = "adopted" -> Call(s, O(s, f).slots.data.onDispose, Undefined, <<O(s, f).slots.data.value>>)
    \* The closure of GetDisposeMethod.
    [] m = "fromSync" ->
         LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
             result == Call(cap.s, O(s, f).slots.data, this, <<>>)
             settled == IF IsAbrupt(result) THEN Call(result.s, Val(cap).reject, Undefined, <<result.c.value>>)
                        ELSE Call(result.s, Val(cap).resolve, Undefined, <<Undefined>>)
         IN Ok(settled.s, Val(cap).promise)
    \* %Iterator.prototype% [ @@dispose ] (§27.1.4.14).
    [] m = "iteratorDispose" ->
         LET return == GetMethod(s, this, SV("return")) IN
         IF IsAbrupt(return) \/ Val(return) = Undefined THEN ResultThen(Undefined, return)
         ELSE ResultThen(Undefined, Call(return.s, Val(return), this, <<>>))
    \* %AsyncIteratorPrototype% [ @@asyncDispose ] (§27.1.3.1), with unwrap, the closure that
    \* fulfills its promise with undefined.
    [] m = "asyncIteratorDispose" ->
         LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
             return == GetMethod(cap.s, this, SV("return"))
             result == IF IsAbrupt(return) \/ Val(return) = Undefined THEN return ELSE Call(return.s, Val(return), this, <<>>)
             wrapper == IF IsAbrupt(result) \/ Val(return) = Undefined THEN result ELSE PromiseResolve(result.s, Intrinsic(result.s, "Promise"), Val(result))
             unwrap == CreateBuiltinFunction(wrapper.s, <<"Disposable", "unwrap">>, 0, <<>>, Empty)
             settled == CASE IsAbrupt(wrapper) -> Call(wrapper.s, Val(cap).reject, Undefined, <<wrapper.c.value>>)
                          [] Val(return) = Undefined -> Call(wrapper.s, Val(cap).resolve, Undefined, <<Undefined>>)
                          [] OTHER -> AddPromiseReactions(unwrap.s, Val(wrapper), Val(unwrap), Undefined, Val(cap))
         IN Ok(settled.s, Val(cap).promise)
    [] m = "unwrap" -> Ok(s, Undefined)
    [] OTHER -> StackMethod(s, m, "DisposableStack", "disposableStack", "sync-dispose", this, args)
AsyncDisposableBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> NewDisposableStack(s, nt, "AsyncDisposableStack", "asyncDisposableStack")
    \* AsyncDisposableStack.prototype.disposeAsync (§27.4.3.3) runs DisposeResources as an async function would.
    [] m = "disposeAsync" ->
         LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
             isStack == IsObject(this) /\ O(cap.s, this).class = "asyncDisposableStack"
             error == ThrowTypeError(cap.s)
             settled ==
               CASE ~isStack -> Call(error.s, Val(cap).reject, Undefined, <<error.c.value>>)
                 [] O(cap.s, this).slots.state = "disposed" -> Call(cap.s, Val(cap).resolve, Undefined, <<Undefined>>)
                 [] OTHER ->
                      AsyncFunctionStep(Val(cap), DisposeResources(O(cap.s, this).slots.stack,
                                                    Ok(SetO(cap.s, this, [O(cap.s, this) EXCEPT !.slots.state = "disposed"]), Undefined)))
         IN Ok(settled.s, Val(cap).promise)
    [] OTHER -> StackMethod(s, m, "AsyncDisposableStack", "asyncDisposableStack", "async-dispose", this, args)
\* The Iterator constructor and Iterator.prototype's helpers (§27.1.3, §27.1.4), %IteratorHelperPrototype%
\* (§27.1.2.1), and %WrapForValidIteratorPrototype% (§27.1.3.2.1.1). engine262 runs a helper as a
\* generator over an abstract closure. Here a helper is an object of class "iteratorHelper" whose
\* slots hold where its closure is: [state, kind, iterated, fn, counter, remaining, inner, size,
\* partial, buffer, finished], with state a generator state, kind the method that made it, iterated
\* the underlying Iterator Record, fn the callback, counter and remaining Numbers, inner flatMap's
\* inner Iterator Record or Empty, size the Number of values chunks and windows yield together,
\* partial whether windows yields a last undersized window, buffer the values so far, and finished
\* whether the last chunk or window is out. Iterator.concat's helper holds [state, kind, items, inner,
\* finished] instead, with items the [method, iterable] pairs it has yet to open and inner the one it
\* is on or Empty. Iterator.zip's and Iterator.zipKeyed's hold [state, kind, iters, open, mode,
\* padding, keys, finished] (§27.1.3.2.2 IteratorZip), with open the indices of the iterators that
\* are not done and keys zipKeyed's keys or Empty. chunks, windows, includes, and join are of the
\* proposals engine262 implements.
\* GetIteratorDirect (§7.4.2).
GetIteratorDirect(s, obj) ==
  LET next == Get(s, obj, SV("next")) IN IF IsAbrupt(next) THEN next ELSE Ok(next.s, JsIterator(obj, Val(next)))
\* GetIteratorFlattenable (§7.4.5), with primitives "reject" or "iterate-strings".
GetIteratorFlattenable(s, obj, primitives) ==
  IF ~IsObject(obj) /\ (primitives = "reject" \/ ~IsString(obj)) THEN ThrowTypeError(s) ELSE
  LET method == GetMethod(s, obj, SymIterator) IN
  IF IsAbrupt(method) THEN method ELSE
  LET iterator == IF Val(method) = Undefined THEN Ok(method.s, obj) ELSE Call(method.s, Val(method), obj, <<>>) IN
  IF IsAbrupt(iterator) THEN iterator
  ELSE IF ~IsObject(Val(iterator)) THEN ThrowTypeError(iterator.s)
  ELSE GetIteratorDirect(iterator.s, Val(iterator))
\* IteratorCloseAll (§7.4.12), which closes the last record first.
IteratorCloseAll(s, records, completion) ==
  IF records = <<>> THEN Abrupt(s, completion) ELSE
  LET closed == IteratorClose(s, records[Len(records)], completion) IN
  IteratorCloseAll(closed.s, SubSeq(records, 1, Len(records) - 1), closed.c)
NewHelper(s, slots) ==
  LET a == Alloc(s, MakeObject(Intrinsic(s, "IteratorHelperPrototype"), "iteratorHelper", slots)) IN Ok(a.s, a.v)
\* Where a helper's closure stops: at a Yield of value, or done.
HelperYield(s, slots, value) == Ok(s, [done |-> FALSE, value |-> value, slots |-> slots])
HelperDone(s, slots) == Ok(s, [done |-> TRUE, value |-> Undefined, slots |-> slots])
\* Runs a helper's closure from where it stopped to its next Yield or its end. A callback that
\* throws closes the underlying iterator.
HelperStep(s, slots) ==
  CASE slots.finished -> HelperDone(s, slots)
    [] slots.kind = "concat" /\ slots.inner = Empty ->
         IF slots.items = <<>> THEN HelperDone(s, slots) ELSE
         LET iter == Call(s, Head(slots.items).method, Head(slots.items).iterable, <<>>) IN
         IF IsAbrupt(iter) THEN iter
         ELSE IF ~IsObject(Val(iter)) THEN ThrowTypeError(iter.s) ELSE
         LET record == GetIteratorDirect(iter.s, Val(iter)) IN
         IF IsAbrupt(record) THEN record ELSE HelperStep(record.s, [slots EXCEPT !.items = Tail(@), !.inner = Val(record)])
    [] slots.kind = "concat" ->
         LET next == IteratorStepValue(s, slots.inner) IN
         CASE IsAbrupt(next) -> next
           [] Val(next).done -> HelperStep(next.s, [slots EXCEPT !.inner = Empty])
           [] OTHER -> HelperYield(next.s, slots, Val(next).value)
    [] slots.kind = "zip" -> IF slots.iters = <<>> THEN HelperDone(s, slots) ELSE ZipStep(s, slots, 1, <<>>)
    [] slots.kind \in {"chunks", "windows"} ->
         LET next == IteratorStepValue(s, slots.iterated)
             full == NumFromInt(Len(slots.buffer)) = slots.size
         IN CASE IsAbrupt(next) -> next
              [] Val(next).done ->
                   IF slots.buffer # <<>> /\ (slots.kind = "chunks" \/ (slots.partial /\ ~full))
                   THEN LET a == CreateArrayFromList(next.s, slots.buffer)
                        IN HelperYield(a.s, [slots EXCEPT !.finished = TRUE], Val(a))
                   ELSE HelperDone(next.s, slots)
              [] OTHER ->
                   LET buffer == Append(IF slots.kind = "windows" /\ full THEN Tail(slots.buffer) ELSE slots.buffer, Val(next).value)
                       stepped == [slots EXCEPT !.iterated = Val(next).iterator,
                                                !.buffer = IF slots.kind = "chunks" /\ NumFromInt(Len(buffer)) = slots.size THEN <<>> ELSE buffer]
                   IN IF NumFromInt(Len(buffer)) = slots.size
                      THEN LET a == CreateArrayFromList(next.s, buffer) IN HelperYield(a.s, stepped, Val(a))
                      ELSE HelperStep(next.s, stepped)
    [] slots.kind = "flatMap" /\ slots.inner # Empty ->
         LET next == IteratorStepValue(s, slots.inner) IN
         CASE IsAbrupt(next) -> IteratorClose(next.s, slots.iterated, next.c)
           [] Val(next).done -> HelperStep(next.s, [slots EXCEPT !.inner = Empty, !.counter = NumAdd(@, OneNum)])
           [] OTHER -> HelperYield(next.s, [slots EXCEPT !.inner = Val(next).iterator], Val(next).value)
    [] slots.kind = "take" /\ slots.remaining = PosZero ->
         LET closed == IteratorClose(s, slots.iterated, Completion("return", Undefined, Empty)) IN
         IF closed.c.type = "throw" THEN closed ELSE HelperDone(closed.s, slots)
    [] slots.kind = "drop" /\ slots.remaining # PosZero ->
         LET next == IteratorNext(s, slots.iterated, <<>>) IN IF IsAbrupt(next) THEN next ELSE
         LET done == IteratorComplete(next.s, Val(next)) IN
         IF IsAbrupt(done) THEN done
         ELSE IF Val(done) THEN HelperDone(done.s, slots)
         ELSE HelperStep(done.s, [slots EXCEPT !.remaining = NumSub(@, OneNum)])
    [] OTHER ->
         LET next == IteratorStepValue(s, slots.iterated) IN
         IF IsAbrupt(next) THEN next
         ELSE IF Val(next).done THEN HelperDone(next.s, slots) ELSE
         LET value == Val(next).value
             stepped == [slots EXCEPT !.iterated = Val(next).iterator,
                                      !.remaining = IF slots.kind = "take" THEN NumSub(@, OneNum) ELSE @]
             counted == [stepped EXCEPT !.counter = NumAdd(@, OneNum)]
         IN IF slots.kind \in {"take", "drop"} THEN HelperYield(next.s, stepped, value) ELSE
            LET called == Call(next.s, slots.fn, Undefined, <<value, Num(slots.counter)>>) IN
            IF IsAbrupt(called) THEN IteratorClose(called.s, slots.iterated, called.c)
            ELSE CASE slots.kind = "map" -> HelperYield(called.s, counted, Val(called))
                   [] slots.kind = "filter" ->
                        IF ToBooleanValue(Val(called)) THEN HelperYield(called.s, counted, value) ELSE HelperStep(called.s, counted)
                   [] OTHER ->
                        LET inner == GetIteratorFlattenable(called.s, Val(called), "reject") IN
                        IF IsAbrupt(inner) THEN IteratorClose(inner.s, slots.iterated, inner.c)
                        ELSE HelperStep(inner.s, [stepped EXCEPT !.inner = Val(inner)])
\* The steps of a lazy helper (§27.1.4.3, .5, .6, .10, .13) before it makes its object: the
\* iterator closes when an argument is invalid.
CreateHelper(s, this, kind, args) ==
  IF ~IsObject(this) THEN ThrowTypeError(s) ELSE
  LET arg == Arg(args, 1)
      record == JsIterator(this, Undefined)
      undersized == Arg(args, 2)
      CloseWith(state, kind2) == LET error == ThrowError(state, kind2) IN IteratorClose(error.s, record, error.c)
      limit == IF kind \in {"take", "drop"} THEN ToNumber(s, arg) ELSE Ok(s, Undefined)
      n == Val(limit).value
  IN CASE kind \in {"map", "filter", "flatMap"} /\ ~IsCallable(s, arg) -> CloseWith(s, "TypeError")
       [] kind \in {"chunks", "windows"} /\ (~IsNumber(arg) \/ ~NumIsIntegral(arg.value)) -> CloseWith(s, "TypeError")
       [] kind \in {"chunks", "windows"} /\ (NumLess(arg.value, OneNum) \/ NumLess(NumFromBigNat(FALSE, BNSub(BNPow2(32), <<1>>), 0), arg.value)) ->
            CloseWith(s, "RangeError")
       [] kind = "windows" /\ undersized # Undefined /\ undersized # SV("only-full") /\ undersized # SV("allow-partial") ->
            CloseWith(s, "TypeError")
       [] IsAbrupt(limit) -> IteratorClose(limit.s, record, limit.c)
       [] kind \in {"take", "drop"} /\ (NumIsNaN(n) \/ (NumIsFinite(n) /\ NumLess(MaxSafeInteger, n)) \/ NumLess(NumToIntegerOrInfinity(n), PosZero)) ->
            CloseWith(limit.s, "RangeError")
       [] OTHER ->
            LET iterated == GetIteratorDirect(limit.s, this) IN
            IF IsAbrupt(iterated) THEN iterated ELSE
            NewHelper(iterated.s, [state |-> "suspendedStart", kind |-> kind, iterated |-> Val(iterated),
                                   fn |-> arg, counter |-> PosZero,
                                   remaining |-> IF kind \in {"take", "drop"} THEN NumToIntegerOrInfinity(n) ELSE PosZero,
                                   inner |-> Empty, size |-> IF IsNumber(arg) THEN arg.value ELSE PosZero,
                                   partial |-> undersized = SV("allow-partial"), buffer |-> <<>>, finished |-> FALSE])
\* Iterator.concat (§27.1.3.2.1) up to the helper it makes, with acc the pairs so far.
IteratorConcatItems(s, items, acc) ==
  IF items = <<>> THEN NewHelper(s, [state |-> "suspendedStart", kind |-> "concat", items |-> acc, inner |-> Empty, finished |-> FALSE])
  ELSE IF ~IsObject(Head(items)) THEN ThrowTypeError(s) ELSE
  LET method == GetMethod(s, Head(items), SymIterator) IN
  CASE IsAbrupt(method) -> method
    [] Val(method) = Undefined -> ThrowTypeError(method.s)
    [] OTHER -> IteratorConcatItems(method.s, Tail(items), Append(acc, [method |-> Val(method), iterable |-> Head(items)]))
\* The options of Iterator.zip and Iterator.zipKeyed (§27.1.3.2.3 steps 1 to 7), as [mode, padding].
ZipOptions(s, iterables, options) ==
  IF ~IsObject(iterables) THEN ThrowTypeError(s) ELSE
  LET object == CASE options = Undefined -> OrdinaryObjectCreate(s, Null)
                  [] IsObject(options) -> Ok(s, options)
                  [] OTHER -> ThrowTypeError(s)
  IN IF IsAbrupt(object) THEN object ELSE
  LET mode == Get(object.s, Val(object), SV("mode")) IN
  IF IsAbrupt(mode) THEN mode
  ELSE IF Val(mode) \notin {Undefined, SV("shortest"), SV("longest"), SV("strict")} THEN ThrowTypeError(mode.s) ELSE
  LET name == CASE Val(mode) = SV("longest") -> "longest" [] Val(mode) = SV("strict") -> "strict" [] OTHER -> "shortest"
      padding == IF name = "longest" THEN Get(mode.s, Val(object), SV("padding")) ELSE Ok(mode.s, Undefined)
  IN CASE IsAbrupt(padding) -> padding
       [] Val(padding) # Undefined /\ ~IsObject(Val(padding)) -> ThrowTypeError(padding.s)
       [] OTHER -> Ok(padding.s, [mode |-> name, padding |-> Val(padding)])
\* Iterator.zip's loop over its iterables (§27.1.3.2.3 step 12), as [keys, iters].
ZipIterables(s, input, iters) ==
  LET next == IteratorStepValue(s, input) IN
  CASE IsAbrupt(next) -> IteratorCloseAll(next.s, iters, next.c)
    [] Val(next).done -> Ok(next.s, [keys |-> Empty, iters |-> iters])
    [] OTHER ->
         LET iter == GetIteratorFlattenable(next.s, Val(next).value, "reject") IN
         IF IsAbrupt(iter) THEN IteratorCloseAll(iter.s, <<input>> \o iters, iter.c)
         ELSE ZipIterables(iter.s, input, Append(iters, Val(iter)))
\* Iterator.zipKeyed's loop over the own keys of its iterables (§27.1.3.2.4 step 12), as [keys, iters].
ZipKeys(s, iterables, keys, picked, iters) ==
  IF keys = <<>> THEN Ok(s, [keys |-> picked, iters |-> iters]) ELSE
  LET desc == GetOwnProperty(s, iterables, Head(keys)) IN
  IF IsAbrupt(desc) THEN IteratorCloseAll(desc.s, iters, desc.c)
  ELSE IF Val(desc) = Absent \/ Val(desc).enumerable # True THEN ZipKeys(desc.s, iterables, Tail(keys), picked, iters) ELSE
  LET value == Get(desc.s, iterables, Head(keys)) IN
  IF IsAbrupt(value) THEN IteratorCloseAll(value.s, iters, value.c)
  ELSE IF Val(value) = Undefined THEN ZipKeys(value.s, iterables, Tail(keys), picked, iters) ELSE
  LET iter == GetIteratorFlattenable(value.s, Val(value), "reject") IN
  IF IsAbrupt(iter) THEN IteratorCloseAll(iter.s, iters, iter.c)
  ELSE ZipKeys(iter.s, iterables, Tail(keys), Append(picked, Head(keys)), Append(iters, Val(iter)))
\* The padding values Iterator.zip takes from the padding iterator it, closing it when it has more.
ZipPadding(s, it, iters, acc) ==
  IF Len(acc) = Len(iters) THEN
    LET closed == IteratorClose(s, it, NormalCompletion(Undefined)) IN
    IF IsAbrupt(closed) THEN IteratorCloseAll(closed.s, iters, closed.c) ELSE Ok(closed.s, acc)
  ELSE LET next == IteratorStepValue(s, it) IN
  CASE IsAbrupt(next) -> IteratorCloseAll(next.s, iters, next.c)
    [] Val(next).done -> Ok(next.s, acc \o [i \in 1..(Len(iters) - Len(acc)) |-> Undefined])
    [] OTHER -> ZipPadding(next.s, it, iters, Append(acc, Val(next).value))
\* The padding values Iterator.zipKeyed reads from the padding object, one for each key.
ZipKeyedPadding(s, padding, keys, iters, acc) ==
  IF Len(acc) = Len(keys) THEN Ok(s, acc) ELSE
  LET value == Get(s, padding, keys[Len(acc) + 1]) IN
  IF IsAbrupt(value) THEN IteratorCloseAll(value.s, iters, value.c)
  ELSE ZipKeyedPadding(value.s, padding, keys, iters, Append(acc, Val(value)))
\* Iterator.zip and Iterator.zipKeyed (§27.1.3.2.3, §27.1.3.2.4) up to the helper they make.
ZipMethod(s, isKeyed, iterables, options) ==
  LET parsed == ZipOptions(s, iterables, options) IN
  IF IsAbrupt(parsed) THEN parsed ELSE
  LET collected ==
        IF isKeyed THEN
          LET keys == OwnPropertyKeys(parsed.s, iterables) IN
          IF IsAbrupt(keys) THEN keys ELSE ZipKeys(keys.s, iterables, Val(keys), <<>>, <<>>)
        ELSE LET input == GetIterator(parsed.s, iterables, "sync") IN
             IF IsAbrupt(input) THEN input ELSE ZipIterables(input.s, Val(input), <<>>)
  IN IF IsAbrupt(collected) THEN collected ELSE
  LET iters == Val(collected).iters
      paddingOption == Val(parsed).padding
      padding == CASE Val(parsed).mode # "longest" -> Ok(collected.s, <<>>)
                   [] paddingOption = Undefined -> Ok(collected.s, [i \in DOMAIN iters |-> Undefined])
                   [] isKeyed -> ZipKeyedPadding(collected.s, paddingOption, Val(collected).keys, iters, <<>>)
                   [] OTHER ->
                        LET it == GetIterator(collected.s, paddingOption, "sync") IN
                        IF IsAbrupt(it) THEN IteratorCloseAll(it.s, iters, it.c) ELSE ZipPadding(it.s, Val(it), iters, <<>>)
  IN IF IsAbrupt(padding) THEN padding
     ELSE NewHelper(padding.s, [state |-> "suspendedStart", kind |-> "zip", iters |-> iters, open |-> [i \in DOMAIN iters |-> i],
                               mode |-> Val(parsed).mode, padding |-> Val(padding), keys |-> Val(collected).keys, finished |-> FALSE])
\* IteratorZip's closure (§27.1.3.2.2 step 3) from iterator i on, with results the values so far.
OpenIterators(slots) == MapSeq(slots.open, LAMBDA i : slots.iters[i])
ZipStep(s, slots, i, results) ==
  IF i > Len(slots.iters) THEN
    LET finished ==
          IF slots.keys = Empty THEN CreateArrayFromList(s, results)
          ELSE LET obj == OrdinaryObjectCreate(s, Null) IN ZipFill(obj.s, Val(obj), slots.keys, results)
    IN HelperYield(finished.s, slots, Val(finished))
  ELSE IF slots.iters[i] = Empty THEN ZipStep(s, slots, i + 1, Append(results, slots.padding[i])) ELSE
  LET next == IteratorStepValue(s, slots.iters[i])
      closed == [slots EXCEPT !.open = Remove(@, i)]
  IN CASE IsAbrupt(next) -> IteratorCloseAll(next.s, OpenIterators(closed), next.c)
       [] ~Val(next).done -> ZipStep(next.s, slots, i + 1, Append(results, Val(next).value))
       [] slots.mode = "shortest" ->
            LET r == IteratorCloseAll(next.s, OpenIterators(closed), Completion("return", Undefined, Empty)) IN
            IF r.c.type = "throw" THEN r ELSE HelperDone(r.s, closed)
       [] slots.mode = "strict" /\ i # 1 -> LET error == ThrowTypeError(next.s) IN IteratorCloseAll(error.s, OpenIterators(closed), error.c)
       [] slots.mode = "strict" -> ZipStrict(next.s, closed, 2)
       [] closed.open = <<>> -> HelperDone(next.s, closed)
       [] OTHER -> ZipStep(next.s, [closed EXCEPT !.iters[i] = Empty], i + 1, Append(results, slots.padding[i]))
\* Strict mode once the first iterator is done: every other iterator k on must be done too.
ZipStrict(s, slots, k) ==
  IF k > Len(slots.iters) THEN HelperDone(s, slots) ELSE
  LET next == IteratorNext(s, slots.iters[k], <<>>)
      done == IF IsAbrupt(next) THEN next ELSE IteratorComplete(next.s, Val(next))
      closed == [slots EXCEPT !.open = Remove(@, k)]
  IN CASE IsAbrupt(done) -> IteratorCloseAll(done.s, OpenIterators(closed), done.c)
       [] Val(done) -> ZipStrict(done.s, closed, k + 1)
       [] OTHER -> LET error == ThrowTypeError(done.s) IN IteratorCloseAll(error.s, OpenIterators(slots), error.c)
ZipFill(s, obj, keys, values) ==
  IF keys = <<>> THEN Ok(s, obj) ELSE
  LET r == CreateDataPropertyOrThrow(s, obj, Head(keys), Head(values)) IN ZipFill(r.s, obj, Tail(keys), Tail(values))
\* The eager methods (§27.1.4.2, .4, .7, .8, .9, .11, .12) once the iterator is direct, from its
\* next value on, with acc what they have so far.
EagerLoop(s, kind, it, fn, counter, acc) ==
  LET next == IteratorStepValue(s, it) IN
  IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN
    CASE kind = "toArray" -> CreateArrayFromList(next.s, acc)
      [] kind = "every" -> Ok(next.s, True)
      [] kind = "some" -> Ok(next.s, False)
      [] OTHER -> Ok(next.s, acc)
  ELSE IF kind = "toArray" THEN EagerLoop(next.s, kind, Val(next).iterator, fn, counter, Append(acc, Val(next).value))
  ELSE LET value == Val(next).value
           called == Call(next.s, fn, Undefined,
                          IF kind = "reduce" THEN <<acc, value, Num(counter)>> ELSE <<value, Num(counter)>>)
           result == IF IsAbrupt(called) THEN Undefined ELSE ToBooleanValue(Val(called))
       IN CASE IsAbrupt(called) -> IteratorClose(called.s, it, called.c)
            [] kind = "every" /\ ~result -> IteratorClose(called.s, it, NormalCompletion(False))
            [] kind = "some" /\ result -> IteratorClose(called.s, it, NormalCompletion(True))
            [] kind = "find" /\ result -> IteratorClose(called.s, it, NormalCompletion(value))
            [] OTHER -> EagerLoop(called.s, kind, Val(next).iterator, fn, NumAdd(counter, OneNum),
                                  IF kind = "reduce" THEN Val(called) ELSE acc)
EagerMethod(s, this, kind, args) ==
  IF ~IsObject(this) THEN ThrowTypeError(s)
  ELSE IF kind # "toArray" /\ ~IsCallable(s, Arg(args, 1)) THEN
    LET error == ThrowTypeError(s) IN IteratorClose(error.s, JsIterator(this, Undefined), error.c)
  ELSE LET it == GetIteratorDirect(s, this) IN
  IF IsAbrupt(it) THEN it
  ELSE IF kind = "reduce" /\ Len(args) < 2 THEN
    LET first == IteratorStepValue(it.s, Val(it)) IN
    IF IsAbrupt(first) THEN first
    ELSE IF Val(first).done THEN ThrowTypeError(first.s)
    ELSE EagerLoop(first.s, kind, Val(first).iterator, Arg(args, 1), OneNum, Val(first).value)
  ELSE EagerLoop(it.s, kind, Val(it), Arg(args, 1), PosZero,
                 CASE kind = "toArray" -> <<>> [] kind = "reduce" -> Arg(args, 2) [] OTHER -> Undefined)
\* Iterator.prototype.includes, which skips skipped values first.
IncludesMethod(s, this, search, skipped) ==
  IF ~IsObject(this) THEN ThrowTypeError(s) ELSE
  LET CloseWith(kind) == LET error == ThrowError(s, kind) IN IteratorClose(error.s, JsIterator(this, Undefined), error.c)
      toSkip == IF skipped = Undefined THEN PosZero ELSE skipped.value
  IN CASE skipped # Undefined /\ (~IsNumber(skipped) \/ (NumIsFinite(skipped.value) /\ ~NumIsIntegral(skipped.value)) \/ NumIsNaN(skipped.value)) ->
            CloseWith("TypeError")
       [] NumLess(toSkip, PosZero) \/ (NumIsFinite(toSkip) /\ NumLess(MaxSafeInteger, toSkip)) -> CloseWith("RangeError")
       [] OTHER -> LET it == GetIteratorDirect(s, this) IN IF IsAbrupt(it) THEN it ELSE IncludesLoop(it.s, Val(it), search, toSkip)
IncludesLoop(s, it, search, toSkip) ==
  LET next == IteratorStepValue(s, it) IN
  CASE IsAbrupt(next) -> next
    [] Val(next).done -> Ok(next.s, False)
    [] NumLess(PosZero, toSkip) -> IncludesLoop(next.s, Val(next).iterator, search, NumSub(toSkip, OneNum))
    [] SameValueZero(Val(next).value, search) -> IteratorClose(next.s, Val(next).iterator, NormalCompletion(True))
    [] OTHER -> IncludesLoop(next.s, Val(next).iterator, search, toSkip)
\* Iterator.prototype.join, which writes undefined and null as empty.
JoinMethod(s, this, separator) ==
  IF ~IsObject(this) THEN ThrowTypeError(s) ELSE
  LET sep == IF separator = Undefined THEN Ok(s, SV(",")) ELSE ToStr(s, separator) IN
  IF IsAbrupt(sep) THEN IteratorClose(sep.s, JsIterator(this, Undefined), sep.c) ELSE
  LET it == GetIteratorDirect(sep.s, this) IN
  IF IsAbrupt(it) THEN it ELSE JoinLoop(it.s, Val(it), Val(sep).value, TRUE, <<>>)
JoinLoop(s, it, sep, isFirst, acc) ==
  LET next == IteratorStepValue(s, it) IN
  IF IsAbrupt(next) THEN next
  ELSE IF Val(next).done THEN Ok(next.s, Str(acc)) ELSE
  LET value == Val(next).value
      str == IF IsNullish(value) THEN Ok(next.s, EmptyStr) ELSE ToStr(next.s, value)
  IN IF IsAbrupt(str) THEN IteratorClose(str.s, it, str.c)
     ELSE JoinLoop(str.s, Val(next).iterator, sep, FALSE, (IF isFirst THEN acc ELSE acc \o sep) \o Val(str).value)
\* %IteratorHelperPrototype%.next and .return (§27.1.2.1.1, §27.1.2.1.2), with GeneratorValidate.
SetHelperSlots(s, this, slots) == SetO(s, this, [O(s, this) EXCEPT !.slots = slots])
HelperNext(s, this) ==
  IF ~IsObject(this) \/ O(s, this).class # "iteratorHelper" THEN ThrowTypeError(s) ELSE
  LET slots == O(s, this).slots IN
  CASE slots.state = "executing" -> ThrowTypeError(s)
    [] slots.state = "completed" -> CreateIterResultObject(s, Undefined, TRUE)
    [] OTHER ->
         LET r == HelperStep(SetHelperSlots(s, this, [slots EXCEPT !.state = "executing"]), slots) IN
         IF IsAbrupt(r) THEN Abrupt(SetHelperSlots(r.s, this, [slots EXCEPT !.state = "completed"]), r.c)
         ELSE CreateIterResultObject(SetHelperSlots(r.s, this, [Val(r).slots EXCEPT !.state = IF Val(r).done THEN "completed" ELSE "suspendedYield"]),
                                     Val(r).value, Val(r).done)
HelperReturn(s, this) ==
  IF ~IsObject(this) \/ O(s, this).class # "iteratorHelper" THEN ThrowTypeError(s) ELSE
  LET slots == O(s, this).slots
      isStart == slots.state = "suspendedStart"
      marked == SetHelperSlots(s, this, [slots EXCEPT !.state = IF isStart THEN "completed" ELSE "executing"])
      completion == IF isStart THEN NormalCompletion(Undefined) ELSE Completion("return", Undefined, Empty)
      closed ==
        CASE slots.kind = "zip" -> IteratorCloseAll(marked, OpenIterators(slots), completion)
          [] slots.kind = "concat" /\ isStart -> Abrupt(marked, completion)
          [] slots.kind = "concat" -> IteratorClose(marked, slots.inner, completion)
          [] isStart -> IteratorClose(marked, slots.iterated, completion)
          [] slots.kind = "flatMap" /\ slots.inner # Empty ->
               LET inner == IteratorClose(marked, slots.inner, completion) IN IteratorClose(inner.s, slots.iterated, inner.c)
          [] slots.finished -> Abrupt(marked, completion)
          [] OTHER -> IteratorClose(marked, slots.iterated, completion)
  IN CASE slots.state = "executing" -> ThrowTypeError(s)
       [] slots.state = "completed" -> CreateIterResultObject(s, Undefined, TRUE)
       [] OTHER ->
            LET done == SetHelperSlots(closed.s, this, [slots EXCEPT !.state = "completed"]) IN
            IF closed.c.type = "throw" THEN Abrupt(done, closed.c) ELSE CreateIterResultObject(done, Undefined, TRUE)
IteratorHelperBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined \/ nt = f THEN ThrowTypeError(s)
         ELSE OrdinaryCreateFromConstructor(s, nt, "IteratorPrototype", "ordinary", [none |-> TRUE])
    \* Iterator.from (§27.1.3.2.1).
    [] m = "from" ->
         LET it == GetIteratorFlattenable(s, Arg(args, 1), "iterate-strings") IN
         IF IsAbrupt(it) THEN it ELSE
         LET has == OrdinaryHasInstance(it.s, Intrinsic(it.s, "Iterator"), Val(it).iterator) IN
         IF IsAbrupt(has) THEN has
         ELSE IF Val(has) = True THEN Ok(has.s, Val(it).iterator)
         ELSE LET a == Alloc(has.s, MakeObject(Intrinsic(has.s, "WrapForValidIteratorPrototype"), "wrapForValidIterator",
                                               [iterated |-> Val(it)]))
              IN Ok(a.s, a.v)
    \* The Iterator.prototype accessors (§27.1.4.1, §27.1.4.14).
    [] m = "getConstructor" -> Ok(s, Intrinsic(s, "Iterator"))
    [] m = "getToStringTag" -> Ok(s, SV("Iterator"))
    [] m \in {"setConstructor", "setToStringTag"} ->
         LET r == SetterThatIgnoresPrototypeProperties(s, this, Intrinsic(s, "IteratorPrototype"),
                                                       IF m = "setConstructor" THEN SV("constructor") ELSE SymToStringTag, Arg(args, 1))
         IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Undefined)
    [] m \in {"chunks", "drop", "filter", "flatMap", "map", "take", "windows"} -> CreateHelper(s, this, m, args)
    [] m = "concat" -> IteratorConcatItems(s, args, <<>>)
    [] m \in {"zip", "zipKeyed"} -> ZipMethod(s, m = "zipKeyed", Arg(args, 1), Arg(args, 2))
    [] m = "includes" -> IncludesMethod(s, this, Arg(args, 1), Arg(args, 2))
    [] m = "join" -> JoinMethod(s, this, Arg(args, 1))
    [] m \in {"every", "find", "forEach", "reduce", "some", "toArray"} -> EagerMethod(s, this, m, args)
    [] m = "helperNext" -> HelperNext(s, this)
    [] m = "helperReturn" -> HelperReturn(s, this)
    \* %WrapForValidIteratorPrototype%.next and .return (§27.1.3.2.1.1.1, §27.1.3.2.1.1.2).
    [] ~IsObject(this) \/ O(s, this).class # "wrapForValidIterator" -> ThrowTypeError(s)
    [] m = "wrapNext" -> Call(s, O(s, this).slots.iterated.next, O(s, this).slots.iterated.iterator, <<>>)
    [] m = "wrapReturn" ->
         LET iterator == O(s, this).slots.iterated.iterator
             return == GetMethod(s, iterator, SV("return"))
         IN IF IsAbrupt(return) THEN return
            ELSE IF Val(return) = Undefined THEN CreateIterResultObject(return.s, Undefined, TRUE)
            ELSE Call(return.s, Val(return), iterator, <<>>)
\* ShadowRealm (proposal-shadowrealm). A ShadowRealm object has class "shadowRealm" and slots
\* [realm], the index of the realm it evaluates code in. A wrapped function exotic object has class
\* "wrapped" and slots [target, realm, constructor], with target the function it wraps and realm the
\* index of the realm that made it.
\* WrappedFunctionCreate: a wrapped function of realm for target.
WrappedFunctionCreate(s, realm, target) ==
  LET a == Alloc(s, MakeObject(Obj(s.realms[realm].intrinsics["FunctionPrototype"]), "wrapped",
                               [target |-> target, realm |-> realm, constructor |-> FALSE]))
      copied == CopyNameAndLength(a.s, a.v, target, <<>>, 0)
  IN IF IsAbrupt(copied) THEN ThrowTypeError(copied.s) ELSE copied
\* GetWrappedValue: a primitive as it is, and a callable object wrapped for realm.
GetWrappedValue(s, realm, v) ==
  IF ~IsObject(v) THEN Ok(s, v)
  ELSE IF ~IsCallable(s, v) THEN ThrowTypeError(s)
  ELSE WrappedFunctionCreate(s, realm, v)
GetWrappedValues(s, realm, values, acc) ==
  IF values = <<>> THEN Ok(s, acc) ELSE
  LET w == GetWrappedValue(s, realm, Head(values)) IN
  IF IsAbrupt(w) THEN w ELSE GetWrappedValues(w.s, realm, Tail(values), Append(acc, Val(w)))
\* OrdinaryWrappedFunctionCall, in the realm of the wrapped function f. The TypeError that stands
\* in for what the target throws is CreateTypeErrorCopy's.
OrdinaryWrappedFunctionCall(s, f, this, args) ==
  LET target == O(s, f).slots.target
      targetRealm == GetFunctionRealm(s, target)
  IN IF IsAbrupt(targetRealm) THEN targetRealm ELSE
     LET wrappedArgs == GetWrappedValues(targetRealm.s, Val(targetRealm), args, <<>>) IN
     IF IsAbrupt(wrappedArgs) THEN wrappedArgs ELSE
     LET wrappedThis == GetWrappedValue(wrappedArgs.s, Val(targetRealm), this) IN
     IF IsAbrupt(wrappedThis) THEN wrappedThis ELSE
     LET r == Call(wrappedThis.s, target, Val(wrappedThis), Val(wrappedArgs)) IN
     IF IsAbrupt(r) THEN ThrowTypeError(r.s) ELSE GetWrappedValue(r.s, O(s, f).slots.realm, Val(r))
\* PerformShadowRealmEval in the realm evalRealm, with GetShadowRealmContext's environments. The
\* host parses the source as an indirect eval in sloppy code, whose early errors are the same.
PerformShadowRealmEval(s, source, evalRealm) ==
  LET key == [goal |-> "eval", source |-> source, strict |-> FALSE, newTarget |-> FALSE,
              superProperty |-> FALSE, superCall |-> FALSE, privateNames |-> {}]
      parsed == s.parses[key]
  IN IF ~parsed.ok THEN ThrowError(s, "SyntaxError")
  ELSE IF ~Has(parsed.node.ScriptBody) THEN Ok(s, Undefined) ELSE
  LET script == parsed.node
      strictEval == script.ScriptBody.strict
      inner == EnterRealm(s, evalRealm)
      lex == NewDeclarativeEnvironment(inner, inner.globalEnv)
      ctx == Context(lex.e, IF strictEval THEN lex.e ELSE inner.globalEnv, NoPrivateEnvironment, Null)
      i == EvalDeclarationInstantiation(lex.s, ctx, script, strictEval)
      r == InCallerRealm(s, IF IsAbrupt(i) THEN i ELSE EvaluateStatementList(i.s, ctx, script.ScriptBody.StatementList))
  IN IF IsAbrupt(r) THEN ThrowTypeError(r.s)
     ELSE GetWrappedValue(r.s, s.realmId, IF Val(r) = Empty THEN Undefined ELSE Val(r))
\* ShadowRealmImportValue: imports the module in evalRealm as import() does there, and settles the
\* promise it returns from the namespace.
ShadowRealmImportValue(s, specifier, exportName, evalRealm) ==
  LET inner == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      loaded == ContinueDynamicImport(HostLoadModule(EnterRealm(inner.s, evalRealm),
                                                     [specifier |-> specifier, attributes |-> NoAttributes]),
                                      Val(inner), "evaluation")
      onFulfilled == CreateBuiltinFunction(EnterRealm(loaded.s, s.realmId), <<"ShadowRealm", "importFulfilled">>, 1, <<>>,
                                           exportName)
      onRejected == CreateBuiltinFunction(onFulfilled.s, <<"ShadowRealm", "importRejected">>, 1, <<>>, Empty)
      cap == NewPromiseCapability(onRejected.s, Intrinsic(onRejected.s, "Promise"))
  IN AddPromiseReactions(cap.s, Val(inner).promise, Val(onFulfilled), Val(onRejected), Val(cap))
IsShadowRealm(s, v) == IsObject(v) /\ O(s, v).class = "shadowRealm"
\* The ShadowRealm constructor, its prototype's methods, and the closures of importValue.
ShadowRealmBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1) IN
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET o == OrdinaryCreateFromConstructor(s, nt, "ShadowRealmPrototype", "shadowRealm", [realm |-> 0]) IN
         IF IsAbrupt(o) THEN o
         ELSE Ok(SetSlots(CreateRealm(o.s).s, Val(o), [realm |-> Len(o.s.realms) + 1]), Val(o))
    [] m = "evaluate" ->
         IF ~IsShadowRealm(s, this) \/ ~IsString(a1) THEN ThrowTypeError(s)
         ELSE PerformShadowRealmEval(s, a1.value, Slots(s, this).realm)
    [] m = "importValue" ->
         IF ~IsShadowRealm(s, this) THEN ThrowTypeError(s) ELSE
         LET specifier == ToStr(s, a1) IN IF IsAbrupt(specifier) THEN specifier
         ELSE IF ~IsString(Arg(args, 2)) THEN ThrowTypeError(specifier.s)
         ELSE ShadowRealmImportValue(specifier.s, Val(specifier).value, Arg(args, 2).value, Slots(s, this).realm)
    [] m = "importFulfilled" ->
         LET name == Str(O(s, f).slots.data)
             has == HasOwnProperty(s, a1, name)
         IN IF IsAbrupt(has) THEN has ELSE IF Val(has) = False THEN ThrowTypeError(has.s) ELSE
            LET value == Get(has.s, a1, name) IN IF IsAbrupt(value) THEN value ELSE GetWrappedValue(value.s, s.realmId, Val(value))
    [] m = "importRejected" -> ThrowTypeError(s)
\* Boolean (§20.3), Symbol (§20.4), the Error objects (§20.5), and BigInt (§21.2). The state's
\* symbolRegistry is the GlobalSymbolRegistry of Symbol.for (§20.4.2.2): [key, symbol] records.
\* Boolean (§20.3).
ThisBooleanValue(s, v) ==
  IF IsBoolean(v) THEN Ok(s, v)
  ELSE IF IsObject(v) /\ O(s, v).class = "boolean" THEN Ok(s, O(s, v).slots.data)
  ELSE ThrowTypeError(s)
BooleanBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN Ok(s, ToBoolean(Arg(args, 1)))
         ELSE OrdinaryCreateFromConstructor(s, nt, "BooleanPrototype", "boolean", [data |-> ToBoolean(Arg(args, 1))])
    [] m = "toString" -> LET b == ThisBooleanValue(s, this) IN IF IsAbrupt(b) THEN b ELSE Ok(b.s, Str(PrimitiveToUnits(Val(b))))
    [] m = "valueOf" -> ThisBooleanValue(s, this)
\* Symbol (§20.4).
ThisSymbolValue(s, v) ==
  IF IsSymbol(v) THEN Ok(s, v)
  ELSE IF IsObject(v) /\ O(s, v).class = "symbol" THEN Ok(s, O(s, v).slots.data)
  ELSE ThrowTypeError(s)
\* SymbolDescriptiveString (§20.4.3.3.1).
SymbolDescriptiveString(s, sym) ==
  Str(N("Symbol(") \o (IF s.syms[sym.id] = Undefined THEN <<>> ELSE s.syms[sym.id].value) \o N(")"))
\* A new unique Symbol with a description, a String or Undefined.
NewSymbol(s, description) == [s |-> [s EXCEPT !.syms = Append(@, description)], v |-> Sym(Len(s.syms) + 1)]
\* KeyForSymbol (§20.4.5.1).
KeyForSymbol(s, sym) ==
  LET found == SelectSeq(s.symbolRegistry, LAMBDA e : e.symbol = sym) IN
  IF found = <<>> THEN Undefined ELSE found[1].key
SymbolBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt # Undefined THEN ThrowTypeError(s)
         ELSE LET d == IF Arg(args, 1) = Undefined THEN Ok(s, Undefined) ELSE ToStr(s, Arg(args, 1)) IN
              IF IsAbrupt(d) THEN d ELSE LET sym == NewSymbol(d.s, Val(d)) IN Ok(sym.s, sym.v)
    [] m = "for" ->
         LET key == ToStr(s, Arg(args, 1)) IN IF IsAbrupt(key) THEN key ELSE
         LET found == SelectSeq(key.s.symbolRegistry, LAMBDA e : e.key = Val(key)) IN
         IF found # <<>> THEN Ok(key.s, found[1].symbol)
         ELSE LET sym == NewSymbol(key.s, Val(key)) IN
              Ok([sym.s EXCEPT !.symbolRegistry = Append(@, [key |-> Val(key), symbol |-> sym.v])], sym.v)
    [] m = "keyFor" -> IF ~IsSymbol(Arg(args, 1)) THEN ThrowTypeError(s) ELSE Ok(s, KeyForSymbol(s, Arg(args, 1)))
    [] m = "toString" ->
         LET v == ThisSymbolValue(s, this) IN IF IsAbrupt(v) THEN v ELSE Ok(v.s, SymbolDescriptiveString(v.s, Val(v)))
    [] m \in {"valueOf", "toPrimitive"} -> ThisSymbolValue(s, this)
    [] m = "description" ->
         LET v == ThisSymbolValue(s, this) IN IF IsAbrupt(v) THEN v ELSE Ok(v.s, v.s.syms[Val(v).id])
\* The Error, NativeError, and AggregateError constructors' steps up to InstallErrorCause
\* (§20.5.1.1, §20.5.6.1.1, §20.5.7.1.1), for the prototype of newTarget or the default.
ErrorConstructor(s, newTarget, protoName, message, options) ==
  LET o == OrdinaryCreateFromConstructor(s, newTarget, protoName, "error", [data |-> Empty]) IN
  IF IsAbrupt(o) THEN o ELSE
  LET msg == IF message = Undefined THEN Ok(o.s, Empty) ELSE ToStr(o.s, message) IN
  IF IsAbrupt(msg) THEN msg ELSE
  LET m == IF Val(msg) = Empty THEN Ok(msg.s, Empty) ELSE CreateMethodProperty(msg.s, Val(o), SV("message"), Val(msg)) IN
  LET c == InstallErrorCause(m.s, Val(o), options) IN
  IF IsAbrupt(c) THEN c ELSE Ok(c.s, Val(o))
\* InstallErrorCause (§20.5.8.1).
InstallErrorCause(s, o, options) ==
  IF ~IsObject(options) THEN Ok(s, Undefined)
  ELSE LET has == HasProperty(s, options, SV("cause")) IN
  IF IsAbrupt(has) \/ Val(has) = False THEN has
  ELSE LET cause == Get(has.s, options, SV("cause")) IN
  IF IsAbrupt(cause) THEN cause ELSE CreateMethodProperty(cause.s, o, SV("cause"), Val(cause))
\* SetterThatIgnoresPrototypeProperties, of the Iterator.prototype accessors (§27.1.4).
SetterThatIgnoresPrototypeProperties(s, this, home, p, v) ==
  IF ~IsObject(this) \/ SameValue(this, home) THEN ThrowTypeError(s)
  ELSE LET desc == GetOwnProperty(s, this, p) IN IF IsAbrupt(desc) THEN desc
  ELSE IF Val(desc) = Absent THEN CreateDataPropertyOrThrow(desc.s, this, p, v)
  ELSE Set(desc.s, this, p, v, TRUE)
ErrorBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> ErrorConstructor(s, IF nt = Undefined THEN f ELSE nt, "ErrorPrototype", Arg(args, 1), Arg(args, 2))
    \* Error.isError and IsError of the proposal.
    [] m = "isError" -> Ok(s, Bool(IsObject(Arg(args, 1)) /\ O(s, Arg(args, 1)).class = "error"))
    \* Error.prototype.toString (§20.5.3.4).
    [] m = "toString" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET name == Get(s, this, SV("name")) IN IF IsAbrupt(name) THEN name ELSE
         LET n == IF Val(name) = Undefined THEN Ok(name.s, SV("Error")) ELSE ToStr(name.s, Val(name)) IN
         IF IsAbrupt(n) THEN n ELSE
         LET msg == Get(n.s, this, SV("message")) IN IF IsAbrupt(msg) THEN msg ELSE
         LET mm == IF Val(msg) = Undefined THEN Ok(msg.s, EmptyStr) ELSE ToStr(msg.s, Val(msg)) IN
         IF IsAbrupt(mm) THEN mm
         ELSE IF Val(n).value = <<>> THEN mm
         ELSE IF Val(mm).value = <<>> THEN Ok(mm.s, Val(n))
         ELSE Ok(mm.s, Str(Val(n).value \o N(": ") \o Val(mm).value))
    \* get and set Error.prototype.stack. The stack is the empty String, which is as
    \* implementation-defined as any.
    [] m = "getStack" ->
         IF ~IsObject(this) THEN ThrowTypeError(s) ELSE Ok(s, IF O(s, this).class = "error" THEN EmptyStr ELSE Undefined)
    [] m = "setStack" ->
         IF ~IsObject(this) \/ ~IsString(Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET r == SetterThatIgnoresPrototypeProperties(s, this, Intrinsic(s, "ErrorPrototype"), SV("stack"), Arg(args, 1)) IN
              IF IsAbrupt(r) THEN r ELSE Ok(r.s, Undefined)
NativeErrorBuiltin(s, f, m, this, args, nt) ==
  ErrorConstructor(s, IF nt = Undefined THEN f ELSE nt, m \o "Prototype", Arg(args, 1), Arg(args, 2))
\* AggregateError (§20.5.7.1.1).
AggregateErrorBuiltin(s, f, m, this, args, nt) ==
  LET o == ErrorConstructor(s, IF nt = Undefined THEN f ELSE nt, "AggregateErrorPrototype", Arg(args, 2), Arg(args, 3)) IN
  IF IsAbrupt(o) THEN o ELSE
  LET it == GetIterator(o.s, Arg(args, 1), "sync") IN IF IsAbrupt(it) THEN it ELSE
  LET errors == IteratorToList(it.s, Val(it), <<>>) IN IF IsAbrupt(errors) THEN errors ELSE
  LET a == CreateArrayFromList(errors.s, Val(errors))
      d == CreateMethodProperty(a.s, Val(o), SV("errors"), Val(a))
  IN Ok(d.s, Val(o))
\* BigInt (§21.2).
ToBigInt(s, v) ==
  LET p == ToPrimitive(s, v, "number") IN IF IsAbrupt(p) THEN p ELSE
  LET x == Val(p) IN
  CASE x.type \in {"undefined", "null", "number", "symbol"} -> ThrowTypeError(p.s)
    [] x.type = "boolean" -> Ok(p.s, BigInt(BigIntFromInt(IF x.value THEN 1 ELSE 0)))
    [] x.type = "bigint" -> p
    [] x.type = "string" ->
         LET n == StringToBigInt(x.value) IN IF n = Undefined THEN ThrowError(p.s, "SyntaxError") ELSE Ok(p.s, n)
ThisBigIntValue(s, v) ==
  IF IsBigInt(v) THEN Ok(s, v)
  ELSE IF IsObject(v) /\ O(s, v).class = "bigint" THEN Ok(s, O(s, v).slots.data)
  ELSE ThrowTypeError(s)
\* a modulo 2^bits as a BigNat, for bits a TLA+ integer.
BigIntModPow2(a, bits) ==
  LET low == BNLowBits(a.mag, bits) IN
  IF ~a.neg \/ low = <<>> THEN low ELSE BNSub(BNPow2(bits), low)
\* BigInt.asIntN (§21.2.2.1) and BigInt.asUintN (§21.2.2.2) for bits an integral Number. A
\* result that keeps a's value needs no power of two, so bits may be as large as ToIndex allows.
\* A negative a with bits of 2^30 or more makes a BigInt too large to represent: a RangeError, as
\* engines throw.
BigIntAsN(s, m, bits, a) ==
  LET isSmall == bits.k = "int"
      length == BNBitLength(a.mag)
  IN IF m = "asIntN" THEN
       IF ~isSmall \/ length < NumToSmallInt(bits) THEN Ok(s, BigInt(a))
       ELSE LET b == NumToSmallInt(bits)
                mod == BigIntModPow2(a, b)
            IN Ok(s, BigInt(IF b > 0 /\ BNTestBit(mod, b - 1) THEN BigIntOf(TRUE, BNSub(BNPow2(b), mod))
                            ELSE BigIntOf(FALSE, mod)))
     ELSE IF ~a.neg /\ (~isSmall \/ length <= NumToSmallInt(bits)) THEN Ok(s, BigInt(a))
     ELSE IF ~isSmall THEN ThrowError(s, "RangeError")
     ELSE Ok(s, BigInt(BigIntOf(FALSE, BigIntModPow2(a, NumToSmallInt(bits)))))
BigIntBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt # Undefined THEN ThrowTypeError(s)
         ELSE LET p == ToPrimitive(s, Arg(args, 1), "number") IN IF IsAbrupt(p) THEN p
         ELSE IF IsNumber(Val(p)) THEN
           IF ~NumIsFinite(Val(p).value) \/ ~NumIsIntegral(Val(p).value) THEN ThrowError(p.s, "RangeError")
           ELSE Ok(p.s, BigInt(IntegralNumberToBigInt(Val(p).value)))
         ELSE ToBigInt(p.s, Val(p))
    [] m \in {"asIntN", "asUintN"} ->
         LET bits == ToIndex(s, Arg(args, 1)) IN IF IsAbrupt(bits) THEN bits ELSE
         LET a == ToBigInt(bits.s, Arg(args, 2)) IN IF IsAbrupt(a) THEN a ELSE
         BigIntAsN(a.s, m, Val(bits).value, Val(a).value)
    [] m = "valueOf" -> ThisBigIntValue(s, this)
    \* toString and, as engine262 has it, toLocaleString.
    [] OTHER ->
         LET b == ThisBigIntValue(s, this) IN IF IsAbrupt(b) THEN b ELSE
         LET r == IF Arg(args, 1) = Undefined THEN Ok(b.s, IntV(10)) ELSE ToIntegerOrInfinity(b.s, Arg(args, 1)) IN
         IF IsAbrupt(r) THEN r
         ELSE IF NumLess(Val(r).value, NumFromInt(2)) \/ NumLess(NumFromInt(36), Val(r).value) THEN ThrowError(r.s, "RangeError")
         ELSE Ok(r.s, Str(BigIntToString(Val(b).value, NumToSmallInt(Val(r).value))))
\* Date (§21.4, §B.2.3). The model is deterministic: its local time zone is UTC, with offset 0 and
\* no daylight saving time, and its clock starts at the epoch and moves forward 1 ms each time it is read.
\* A Date object has class "date" and slots [data], its [[DateValue]] as a Number value.
\* Time values reach 8.64 × 10^15, past the 32-bit TLA+ integers, so they stay Numbers. A finite
\* time value splits exactly into its day and time within the day, which are TLA+ integers, and so
\* are the calendar fields.
\* The current time (§21.4.1.2, SystemUTCEpochMilliseconds), fixed at the epoch.
\* The current time, and the state with the clock moved on (§21.4.2.1 step 2, §21.4.3.1).
SystemTime(s) == NumFromInt(s.clock)
Tick(s) == [s EXCEPT !.clock = @ + 1]
\* x modulo n for an integral Number x and a positive integer n, as a TLA+ integer. The remainder
\* of integral Numbers is exact.
NumModInt(x, n) ==
  LET r == NumToInt(NumRemainder(x, NumFromInt(n))) IN IF r < 0 THEN r + n ELSE r
\* Day and TimeWithinDay (§21.4.1.3) of a finite time value t.
TimeWithinDay(t) == NumModInt(t, MsPerDay)
Day(t) == NumToInt(NumDivide(NumSubtract(t, NumFromInt(TimeWithinDay(t))), NumFromInt(MsPerDay)))
\* DayFromYear (§21.4.1.6) and DaysInYear (§21.4.1.5).
DayFromYear(y) ==
  365 * (y - 1970) + (y - 1969) \div 4 - (y - 1901) \div 100 + (y - 1601) \div 400
IsLeapYear(y) == (y % 4 = 0 /\ y % 100 # 0) \/ y % 400 = 0
\* YearFromTime (§21.4.1.8) of a day: the largest y with DayFromYear(y) <= day. Every 400 years
\* hold 146097 days, which gives a close first guess.
YearFromDay(day) ==
  YearAdjust(1970 + 400 * (day \div 146097) + ((day % 146097) * 400) \div 146097, day)
YearAdjust(y, day) ==
  CASE DayFromYear(y) > day -> YearAdjust(y - 1, day)
    [] DayFromYear(y + 1) <= day -> YearAdjust(y + 1, day)
    [] OTHER -> y
\* The day within the year that month m (0 to 12) starts on (§21.4.1.11), leap being 1 in a leap
\* year and 0 otherwise.
MonthStart(m, leap) ==
  <<0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365>>[m + 1] + (IF m >= 2 THEN leap ELSE 0)
\* The fields of a finite time value t (§21.4.1.3 to §21.4.1.14): YearFromTime, MonthFromTime,
\* DateFromTime, WeekDay, HourFromTime, MinuteFromTime, SecondFromTime, and MillisecondFromTime.
DateFields(t) ==
  LET day == Day(t)
      timeWithinDay == TimeWithinDay(t)
      year == YearFromDay(day)
      leap == IF IsLeapYear(year) THEN 1 ELSE 0
      dayWithinYear == day - DayFromYear(year)
      month == CHOOSE m \in 0..11 : MonthStart(m, leap) <= dayWithinYear /\ dayWithinYear < MonthStart(m + 1, leap)
  IN [year |-> year, month |-> month, date |-> dayWithinYear - MonthStart(month, leap) + 1,
      weekDay |-> (day + 4) % 7, hour |-> timeWithinDay \div MsPerHour,
      minute |-> (timeWithinDay \div MsPerMinute) % 60, second |-> (timeWithinDay \div MsPerSecond) % 60,
      ms |-> timeWithinDay % MsPerSecond, timeWithinDay |-> timeWithinDay]
\* LocalTime (§21.4.1.25) and UTC (§21.4.1.26), with the offset of the UTC time zone, 0.
LocalTime(t) == t
UTC(t) == IF NumIsFinite(t) THEN t ELSE NaN
\* MakeTime (§21.4.1.27).
MakeTime(hour, min, sec, ms) ==
  IF ~(NumIsFinite(hour) /\ NumIsFinite(min) /\ NumIsFinite(sec) /\ NumIsFinite(ms)) THEN NaN
  ELSE NumAdd(NumAdd(NumAdd(NumMultiply(NumToIntegerOrInfinity(hour), NumFromInt(MsPerHour)),
                            NumMultiply(NumToIntegerOrInfinity(min), NumFromInt(MsPerMinute))),
                     NumMultiply(NumToIntegerOrInfinity(sec), NumFromInt(MsPerSecond))),
              NumToIntegerOrInfinity(ms))
\* MakeDay (§21.4.1.28). DayFromYear(ym) is DayFromYear(ym modulo 400) plus 146097 days for each
\* 400 years, so the TLA+ integers stay small for any year.
MakeDay(year, month, date) ==
  IF ~(NumIsFinite(year) /\ NumIsFinite(month) /\ NumIsFinite(date)) THEN NaN
  ELSE
    LET m == NumToIntegerOrInfinity(month)
        mn == NumModInt(m, 12)
        ym == NumAdd(NumToIntegerOrInfinity(year),
                     NumDivide(NumSubtract(m, NumFromInt(mn)), NumFromInt(12)))
    IN IF ~NumIsFinite(ym) THEN NaN
       ELSE
         LET r == NumModInt(ym, 400)
             cycles == NumDivide(NumSubtract(ym, NumFromInt(r)), NumFromInt(400))
             days == NumAdd(NumMultiply(cycles, NumFromInt(146097)),
                            NumFromInt(DayFromYear(r) + MonthStart(mn, IF IsLeapYear(r) THEN 1 ELSE 0)))
         IN IF ~NumIsFinite(NumMultiply(days, NumFromInt(MsPerDay))) THEN NaN
            ELSE NumSubtract(NumAdd(days, NumToIntegerOrInfinity(date)), NumFromInt(1))
\* MakeDate (§21.4.1.29).
MakeDate(day, time) ==
  IF ~(NumIsFinite(day) /\ NumIsFinite(time)) THEN NaN
  ELSE LET tv == NumAdd(NumMultiply(day, NumFromInt(MsPerDay)), time) IN
       IF NumIsFinite(tv) THEN tv ELSE NaN
\* MakeFullYear (§21.4.1.30).
MakeFullYear(year) ==
  IF NumIsNaN(year) THEN NaN
  ELSE LET truncated == NumToIntegerOrInfinity(year) IN
       IF ~NumLess(truncated, PosZero) /\ ~NumLess(NumFromInt(99), truncated)
       THEN NumAdd(NumFromInt(1900), truncated) ELSE truncated
\* TimeClip (§21.4.1.31).
TimeClip(time) ==
  IF ~NumIsFinite(time) THEN NaN
  ELSE IF NumLess(NumMultiply(NumFromInt(100000000), NumFromInt(MsPerDay)), NumAbs(time)) THEN NaN
  ELSE NumToIntegerOrInfinity(time)
\* thisTimeValue: the [[DateValue]] of a Date object.
ThisTimeValue(s, v) ==
  IF IsObject(v) /\ O(s, v).class = "date" THEN Ok(s, O(s, v).slots.data) ELSE ThrowTypeError(s)
SetDateValue(s, v, u) == Ok(SetO(s, v, [O(s, v) EXCEPT !.slots.data = Num(u)]), Num(u))
\* The arguments a Date function converts with ToNumber: the first, which may be missing, and the
\* others up to n that are present.
DateArgs(args, n) == [i \in 1..(IF Len(args) <= 1 THEN 1 ELSE IF Len(args) < n THEN Len(args) ELSE n) |-> Arg(args, i)]
DateToNumbers(s, vs, acc) ==
  IF vs = <<>> THEN Ok(s, acc)
  ELSE LET n == ToNumber(s, Head(vs)) IN
       IF IsAbrupt(n) THEN n ELSE DateToNumbers(n.s, Tail(vs), Append(acc, Val(n)))
\* The time of year, month, date, hours, minutes, seconds, and ms Number values, the first two
\* given, as Date.UTC and the Date constructor compute it.
DateFromComponents(v) ==
  LET Part(i, default) == IF i <= Len(v) THEN v[i].value ELSE NumFromInt(default)
  IN MakeDate(MakeDay(MakeFullYear(v[1].value), Part(2, 0), Part(3, 1)),
              MakeTime(Part(4, 0), Part(5, 0), Part(6, 0), Part(7, 0)))
\* String formats (§21.4.4.41).
PadStart(units, n) == Repeat(48, n - Len(units)) \o units
IntUnits(i) == NumToString(NumFromInt(i))
TwoDigits(i) == PadStart(IntUnits(i), 2)
YearUnits(y) == (IF y < 0 THEN <<45>> ELSE <<>>) \o PadStart(IntUnits(IF y < 0 THEN -y ELSE y), 4)
\* TimeString (§21.4.4.41.1).
TimeString(t) ==
  LET f == DateFields(t) IN
  TwoDigits(f.hour) \o <<58>> \o TwoDigits(f.minute) \o <<58>> \o TwoDigits(f.second) \o N(" GMT")
\* DateString (§21.4.4.41.2).
DateString(t) ==
  LET f == DateFields(t) IN
  DayNames[f.weekDay + 1] \o <<32>> \o MonthNames[f.month + 1] \o <<32>> \o TwoDigits(f.date) \o <<32>> \o
  YearUnits(f.year)
\* TimeZoneString (§21.4.4.41.3): the offset, 0, and no time zone name.
TimeZoneString(tv) == N("+0000")
\* ToDateString (§21.4.4.41.4).
ToDateString(tv) ==
  IF NumIsNaN(tv) THEN N("Invalid Date")
  ELSE LET t == LocalTime(tv) IN DateString(t) \o <<32>> \o TimeString(t) \o TimeZoneString(tv)
\* Date.prototype.toUTCString (§21.4.4.43) of a time value that isn't NaN.
UTCString(tv) ==
  LET f == DateFields(tv) IN
  DayNames[f.weekDay + 1] \o N(", ") \o TwoDigits(f.date) \o <<32>> \o MonthNames[f.month + 1] \o <<32>> \o
  YearUnits(f.year) \o <<32>> \o TimeString(tv)
\* Date.prototype.toISOString (§21.4.4.36) of a finite time value, in the Date Time String Format.
ISOString(tv) ==
  LET f == DateFields(tv)
      year == IF f.year >= 0 /\ f.year <= 9999 THEN PadStart(IntUnits(f.year), 4)
              ELSE (IF f.year < 0 THEN <<45>> ELSE <<43>>) \o PadStart(IntUnits(IF f.year < 0 THEN -f.year ELSE f.year), 6)
  IN year \o <<45>> \o TwoDigits(f.month + 1) \o <<45>> \o TwoDigits(f.date) \o <<84>> \o TwoDigits(f.hour) \o <<58>> \o
     TwoDigits(f.minute) \o <<58>> \o TwoDigits(f.second) \o <<46>> \o PadStart(IntUnits(f.ms), 3) \o <<90>>
\* Parsing (§21.4.3.2). The code unit at i, or 0 past the end.
UnitAt(u, i) == IF i >= 1 /\ i <= Len(u) THEN u[i] ELSE 0
UnitsAt(u, i, n) == [k \in 1..n |-> UnitAt(u, i + k - 1)]
\* The value of the n decimal digits at i, or -1 when they aren't all digits.
DigitsAt(u, i, n) ==
  IF n = 0 THEN 0
  ELSE LET rest == DigitsAt(u, i, n - 1) IN
       IF rest < 0 \/ ~IsDigit(UnitAt(u, i + n - 1)) THEN -1 ELSE rest * 10 + UnitAt(u, i + n - 1) - 48
DigitCount(u, i) == IF IsDigit(UnitAt(u, i)) THEN 1 + DigitCount(u, i + 1) ELSE 0
\* A parsed date: whether it parsed, its fields with a month from 1, the UTC offset in minutes,
\* and whether it is local time.
ParsedDate(ok, y, mo, d, h, mi, sec, ms, offset, local) ==
  [ok |-> ok, y |-> y, mo |-> mo, d |-> d, h |-> h, mi |-> mi, sec |-> sec, ms |-> ms, offset |-> offset, local |-> local]
\* The Date Time String Format (§21.4.1.32): YYYY, YYYY-MM, or YYYY-MM-DD, with an expanded year
\* ±YYYYYY, optionally followed by THH:mm, THH:mm:ss, or THH:mm:ss.sss and then Z or ±HH:mm.
ParseISODate(u) ==
  LET sign == UnitAt(u, 1)
      isExpanded == sign \in {43, 45}
      year == IF isExpanded THEN DigitsAt(u, 2, 6) ELSE DigitsAt(u, 1, 4)
      afterYear == IF isExpanded THEN 8 ELSE 5
      hasMonth == UnitAt(u, afterYear) = 45
      afterMonth == IF hasMonth THEN afterYear + 3 ELSE afterYear
      hasDay == hasMonth /\ UnitAt(u, afterMonth) = 45
      afterDate == IF hasDay THEN afterMonth + 3 ELSE afterMonth
      hasTime == UnitAt(u, afterDate) = 84
      i == afterDate + 1
      hasSeconds == hasTime /\ UnitAt(u, i + 5) = 58
      hasMs == hasSeconds /\ UnitAt(u, i + 8) = 46
      afterTime == CASE hasMs -> i + 12 [] hasSeconds -> i + 8 [] OTHER -> i + 5
      zone == UnitAt(u, afterTime)
      hasOffset == hasTime /\ zone \in {43, 45}
      offset == DigitsAt(u, afterTime + 1, 2) * 60 + DigitsAt(u, afterTime + 4, 2)
      end == CASE ~hasTime -> afterDate [] zone = 90 -> afterTime + 1 [] hasOffset -> afterTime + 6
                [] OTHER -> afterTime
      p == ParsedDate(TRUE, IF sign = 45 THEN -year ELSE year,
                      IF hasMonth THEN DigitsAt(u, afterYear + 1, 2) ELSE 1,
                      IF hasDay THEN DigitsAt(u, afterMonth + 1, 2) ELSE 1,
                      IF hasTime THEN DigitsAt(u, i, 2) ELSE 0,
                      IF hasTime THEN DigitsAt(u, i + 3, 2) ELSE 0,
                      IF hasSeconds THEN DigitsAt(u, i + 6, 2) ELSE 0,
                      IF hasMs THEN DigitsAt(u, i + 9, 3) ELSE 0,
                      IF hasOffset THEN (IF zone = 45 THEN -offset ELSE offset) ELSE 0,
                      hasTime /\ ~hasOffset /\ zone # 90)
      ok == /\ year >= 0 /\ ~(sign = 45 /\ year = 0) /\ Len(u) = end - 1
            /\ p.mo >= 0 /\ p.d >= 0 /\ p.h >= 0 /\ p.mi >= 0 /\ p.sec >= 0 /\ p.ms >= 0
            /\ (hasTime => UnitAt(u, i + 2) = 58)
            /\ (hasOffset => DigitsAt(u, afterTime + 1, 2) \in 0..23 /\ UnitAt(u, afterTime + 3) = 58 /\
                             DigitsAt(u, afterTime + 4, 2) \in 0..59)
  IN [p EXCEPT !.ok = ok]
\* A year of 4 to 6 digits at i, optionally negative, as toString and toUTCString write it:
\* [ok, value, next] with next the position after it.
ParseYearAt(u, i) ==
  LET isNegative == UnitAt(u, i) = 45
      start == IF isNegative THEN i + 1 ELSE i
      n == DigitCount(u, start)
      value == IF n <= 6 THEN DigitsAt(u, start, n) ELSE -1
  IN [ok |-> n >= 4 /\ value >= 0 /\ ~(isNegative /\ value = 0),
      value |-> IF isNegative THEN -value ELSE value, next |-> start + n]
\* The time HH:mm:ss at i of a date that toString or toUTCString wrote, with the year parsed and
\* the month and date at hand; the offset is a GMT±HHMM at the end for toString.
ParseTimeAt(u, i, year, month, date, hasOffset) ==
  LET h == DigitsAt(u, i, 2)
      mi == DigitsAt(u, i + 3, 2)
      sec == DigitsAt(u, i + 6, 2)
      offset == DigitsAt(u, i + 13, 2) * 60 + DigitsAt(u, i + 15, 2)
  IN ParsedDate(/\ year.ok /\ month > 0 /\ date >= 0 /\ h >= 0 /\ mi >= 0 /\ sec >= 0
                /\ UnitAt(u, i - 1) = 32 /\ UnitAt(u, i + 2) = 58 /\ UnitAt(u, i + 5) = 58
                /\ UnitsAt(u, i + 8, 4) = N(" GMT")
                /\ IF hasOffset
                   THEN UnitAt(u, i + 12) \in {43, 45} /\ DigitsAt(u, i + 13, 4) >= 0 /\ Len(u) = i + 16
                   ELSE Len(u) = i + 11,
                year.value, month, date, h, mi, sec, 0,
                CASE ~hasOffset -> 0 [] UnitAt(u, i + 12) = 45 -> -offset [] OTHER -> offset, FALSE)
\* The format of toString: Www Mmm DD YYYY HH:mm:ss GMT±HHMM.
ParseToStringDate(u) ==
  LET year == ParseYearAt(u, 12) IN
  [ParseTimeAt(u, year.next + 1, year, IndexOf(MonthNames, UnitsAt(u, 5, 3)), DigitsAt(u, 9, 2), TRUE) EXCEPT
     !.ok = @ /\ IndexOf(DayNames, UnitsAt(u, 1, 3)) > 0 /\ UnitAt(u, 4) = 32 /\ UnitAt(u, 8) = 32 /\
            UnitAt(u, 11) = 32]
\* The format of toUTCString: Www, DD Mmm YYYY HH:mm:ss GMT.
ParseUTCStringDate(u) ==
  LET year == ParseYearAt(u, 13) IN
  [ParseTimeAt(u, year.next + 1, year, IndexOf(MonthNames, UnitsAt(u, 9, 3)), DigitsAt(u, 6, 2), FALSE) EXCEPT
     !.ok = @ /\ IndexOf(DayNames, UnitsAt(u, 1, 3)) > 0 /\ UnitsAt(u, 4, 2) = N(", ") /\ UnitAt(u, 8) = 32 /\
            UnitAt(u, 12) = 32]
\* The time value of a date string, or NaN when it has none of the formats above or a value out of
\* range. 24:00 is the end of the day, so only with zero minutes, seconds, and milliseconds.
ParseDate(u) ==
  LET iso == ParseISODate(u)
      toString == ParseToStringDate(u)
      p == CASE iso.ok -> iso [] toString.ok -> toString [] OTHER -> ParseUTCStringDate(u)
      leap == IF IsLeapYear(p.y) THEN 1 ELSE 0
  IN IF ~p.ok \/ p.mo < 1 \/ p.mo > 12 \/ p.d < 1 \/ p.d > MonthStart(p.mo, leap) - MonthStart(p.mo - 1, leap) \/
        p.mi > 59 \/ p.sec > 59 \/ p.h > 24 \/ (p.h = 24 /\ (p.mi > 0 \/ p.sec > 0 \/ p.ms > 0))
     THEN NaN
     ELSE LET t == MakeDate(MakeDay(NumFromInt(p.y), NumFromInt(p.mo - 1), NumFromInt(p.d)),
                            MakeTime(NumFromInt(p.h), NumFromInt(p.mi), NumFromInt(p.sec), NumFromInt(p.ms)))
              utc == NumSubtract(t, NumFromInt(p.offset * MsPerMinute))
          IN TimeClip(IF p.local THEN UTC(utc) ELSE utc)
\* The getters (§21.4.4.2 to §21.4.4.19): the field each reads, of the local time or of the time
\* value.
\* The setters (§21.4.4.20 to §21.4.4.26, §21.4.4.28 to §21.4.4.34): the fields their arguments
\* replace, in order. The UTC setters replace those of the time value instead of the local time.
\* A setter converts its first argument and the others present, and then returns NaN for a NaN
\* time value, except setFullYear and setUTCFullYear, which start from +0. The new time keeps the
\* fields no argument replaces: MakeDay of the old year, month, and date is Day(t), and MakeTime of
\* the old hours to milliseconds is TimeWithinDay(t), as the spec's steps use.
DateSet(s, this, fields, args, isUTC) ==
  LET t == ThisTimeValue(s, this) IN IF IsAbrupt(t) THEN t ELSE
  LET n == DateToNumbers(t.s, DateArgs(args, Len(fields)), <<>>) IN IF IsAbrupt(n) THEN n ELSE
  LET tv == Val(t).value IN
  IF NumIsNaN(tv) /\ fields[1] # "year" THEN Ok(n.s, Num(NaN))
  ELSE
    LET f == DateFields(IF NumIsNaN(tv) THEN PosZero ELSE IF isUTC THEN tv ELSE LocalTime(tv))
        Field(k) == LET i == IndexOf(fields, k) IN
                    IF i = 0 \/ i > Len(Val(n)) THEN NumFromInt(f[k]) ELSE Val(n)[i].value
        date == MakeDate(MakeDay(Field("year"), Field("month"), Field("date")),
                         MakeTime(Field("hour"), Field("minute"), Field("second"), Field("ms")))
    IN SetDateValue(n.s, this, TimeClip(IF isUTC THEN date ELSE UTC(date)))
\* The Date constructor (§21.4.2.1).
DateConstructor(s, args, nt) ==
  IF nt = Undefined THEN Ok(Tick(s), Str(ToDateString(SystemTime(s))))
  ELSE
    LET tv ==
          CASE Len(args) = 0 -> Ok(Tick(s), Num(SystemTime(s)))
            [] Len(args) = 1 ->
                 LET value == args[1] IN
                 IF IsObject(value) /\ O(s, value).class = "date" THEN Ok(s, O(s, value).slots.data)
                 ELSE LET v == ToPrimitive(s, value, "none") IN
                      IF IsAbrupt(v) THEN v
                      ELSE LET n == IF IsString(Val(v)) THEN Ok(v.s, Num(ParseDate(Val(v).value))) ELSE ToNumber(v.s, Val(v)) IN
                           IF IsAbrupt(n) THEN n ELSE Ok(n.s, Num(TimeClip(Val(n).value)))
            [] OTHER ->
                 LET v == DateToNumbers(s, DateArgs(args, 7), <<>>) IN
                 IF IsAbrupt(v) THEN v ELSE Ok(v.s, Num(TimeClip(UTC(DateFromComponents(Val(v))))))
    IN IF IsAbrupt(tv) THEN tv
       ELSE OrdinaryCreateFromConstructor(tv.s, nt, "DatePrototype", "date", [data |-> Val(tv)])
DateBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> DateConstructor(s, args, nt)
    \* Date.now (§21.4.3.1), Date.parse (§21.4.3.2), and Date.UTC (§21.4.3.4).
    [] m = "now" -> Ok(Tick(s), Num(SystemTime(s)))
    [] m = "parse" ->
         LET str == ToStr(s, Arg(args, 1)) IN IF IsAbrupt(str) THEN str ELSE Ok(str.s, Num(ParseDate(Val(str).value)))
    [] m = "UTC" ->
         LET v == DateToNumbers(s, DateArgs(args, 7), <<>>) IN
         IF IsAbrupt(v) THEN v ELSE Ok(v.s, Num(TimeClip(DateFromComponents(Val(v)))))
    [] m \in DOMAIN DateGetters \cup DOMAIN DateUTCGetters ->
         LET t == ThisTimeValue(s, this) IN
         IF IsAbrupt(t) \/ NumIsNaN(Val(t).value) THEN t
         ELSE Ok(t.s, IntV(IF m \in DOMAIN DateGetters THEN DateFields(LocalTime(Val(t).value))[DateGetters[m]]
                           ELSE DateFields(Val(t).value)[DateUTCGetters[m]]))
    \* Date.prototype.getTime (§21.4.4.10) and valueOf (§21.4.4.44).
    [] m \in {"getTime", "valueOf"} -> ThisTimeValue(s, this)
    \* Date.prototype.getTimezoneOffset (§21.4.4.11).
    [] m = "getTimezoneOffset" ->
         LET t == ThisTimeValue(s, this) IN
         IF IsAbrupt(t) \/ NumIsNaN(Val(t).value) THEN t
         ELSE Ok(t.s, Num(NumDivide(NumSubtract(Val(t).value, LocalTime(Val(t).value)), NumFromInt(MsPerMinute))))
    [] m \in DOMAIN DateSetters -> DateSet(s, this, DateSetters[m], args, FALSE)
    [] m \in DOMAIN DateUTCSetters -> DateSet(s, this, DateSetters[DateUTCSetters[m]], args, TRUE)
    \* Date.prototype.setTime (§21.4.4.27).
    [] m = "setTime" ->
         LET t == ThisTimeValue(s, this) IN IF IsAbrupt(t) THEN t ELSE
         LET n == ToNumber(t.s, Arg(args, 1)) IN IF IsAbrupt(n) THEN n ELSE SetDateValue(n.s, this, TimeClip(Val(n).value))
    \* Date.prototype.toDateString (§21.4.4.35), toString (§21.4.4.41), toTimeString (§21.4.4.42),
    \* toUTCString (§21.4.4.43), and toLocaleDateString, toLocaleString, and toLocaleTimeString
    \* (§21.4.4.38 to §21.4.4.40), which are toString as engine262 has them.
    [] m \in {"toDateString", "toString", "toTimeString", "toUTCString", "toLocaleDateString", "toLocaleString",
              "toLocaleTimeString"} ->
         LET t == ThisTimeValue(s, this) IN IF IsAbrupt(t) THEN t ELSE
         LET tv == Val(t).value IN
         Ok(t.s, Str(CASE NumIsNaN(tv) -> N("Invalid Date")
                       [] m = "toDateString" -> DateString(LocalTime(tv))
                       [] m = "toTimeString" -> TimeString(LocalTime(tv)) \o TimeZoneString(tv)
                       [] m = "toUTCString" -> UTCString(tv)
                       [] OTHER -> ToDateString(tv)))
    \* Date.prototype.toISOString (§21.4.4.36).
    [] m = "toISOString" ->
         LET t == ThisTimeValue(s, this) IN IF IsAbrupt(t) THEN t
         ELSE IF ~NumIsFinite(Val(t).value) THEN ThrowError(t.s, "RangeError")
         ELSE Ok(t.s, Str(ISOString(Val(t).value)))
    \* Date.prototype.toTemporalInstant (Temporal §14.1.1).
    [] m = "toTemporalInstant" ->
         LET t == ThisTimeValue(s, this) IN IF IsAbrupt(t) THEN t
         ELSE IF ~NumIsFinite(Val(t).value) THEN ThrowError(t.s, "RangeError")
         ELSE CreateTemporalInstant(t.s, TIMul(IntegralNumberToBigInt(Val(t).value), TI(1000000)), Empty)
    \* Date.prototype.toJSON (§21.4.4.37).
    [] m = "toJSON" ->
         LET o == ToObject(s, this) IN IF IsAbrupt(o) THEN o ELSE
         LET tv == ToPrimitive(o.s, Val(o), "number") IN IF IsAbrupt(tv) THEN tv
         ELSE IF IsNumber(Val(tv)) /\ ~NumIsFinite(Val(tv).value) THEN Ok(tv.s, Null)
         ELSE Invoke(tv.s, Val(o), SV("toISOString"), <<>>)
    \* Date.prototype [ @@toPrimitive ] (§21.4.4.45).
    [] m = "toPrimitive" ->
         LET hint == Arg(args, 1) IN
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE IF IsString(hint) /\ hint.value \in {N("string"), N("default")} THEN OrdinaryToPrimitive(s, this, "string")
         ELSE IF IsString(hint) /\ hint.value = N("number") THEN OrdinaryToPrimitive(s, this, "number")
         ELSE ThrowTypeError(s)
    \* Date.prototype.getYear (§B.2.3.1).
    [] m = "getYear" ->
         LET t == ThisTimeValue(s, this) IN
         IF IsAbrupt(t) \/ NumIsNaN(Val(t).value) THEN t
         ELSE Ok(t.s, IntV(DateFields(LocalTime(Val(t).value)).year - 1900))
    \* Date.prototype.setYear (§B.2.3.2).
    [] m = "setYear" ->
         LET t == ThisTimeValue(s, this) IN IF IsAbrupt(t) THEN t ELSE
         LET y == ToNumber(t.s, Arg(args, 1)) IN IF IsAbrupt(y) THEN y ELSE
         LET local == IF NumIsNaN(Val(t).value) THEN PosZero ELSE LocalTime(Val(t).value)
             fields == DateFields(local)
             d == MakeDay(MakeFullYear(Val(y).value), NumFromInt(fields.month), NumFromInt(fields.date))
         IN SetDateValue(y.s, this, TimeClip(UTC(MakeDate(d, NumFromInt(fields.timeWithinDay)))))
\* Pattern semantics (§22.2.2). CompilePattern turns a parsed pattern into a matcher tree that
\* RxMatch runs with explicit continuations. A RegExp Record rer is
\*   [ic, multiline, dotAll, u, v, groups]
\* with groups the pattern's capturing groups. A MatchState is [e, cap]: the endIndex and the
\* captures, each None or <<start, end>>. A matcher returns a MatchState or MatchFailure.
\*
\* A CharSet is [c, strs]: c a tree of the single characters, and strs the strings of other lengths
\* it holds. The kinds of tree are
\*   cps(set), range(lo, hi), ranges(id)  the characters listed, in a range, or of a property
\*   space, lt                            WhiteSpace or LineTerminator, and LineTerminator
\*   all(vi)                              AllCharacters, only those with scf(c) = c when vi
\*   word(cm)                             WordCharacters
\*   union(sets), inter(sets), diff(left, right), fold(inner)
\* with fold MaybeSimpleCaseFolding. cm is [ic, uni], the parts of rer that Canonicalize reads.
\* Binary search for x in a sorted sequence, which holds it.
RxSearch(seq, x, lo, hi) ==
  LET mid == (lo + hi) \div 2 IN
  CASE seq[mid] = x -> mid
    [] seq[mid] < x -> RxSearch(seq, x, mid + 1, hi)
    [] OTHER -> RxSearch(seq, x, lo, mid - 1)
\* Whether c is in the ranges <<lo1, hi1, lo2, hi2, ...>>, by binary search on pairs lo..hi.
RxInRanges(ranges, c) == RxInRangesFrom(ranges, c, 1, Len(ranges) \div 2)
RxInRangesFrom(ranges, c, lo, hi) ==
  LET mid == (lo + hi) \div 2 IN
  CASE lo > hi -> FALSE
    [] c < ranges[2 * mid - 1] -> RxInRangesFrom(ranges, c, lo, mid - 1)
    [] c > ranges[2 * mid] -> RxInRangesFrom(ranges, c, mid + 1, hi)
    [] OTHER -> TRUE
\* scf, the simple or common case folding.
RxScf(c) == IF c \in DOMAIN RxFoldMap THEN RxFoldMap[c] ELSE c
\* Canonicalize (§22.2.2.7.3).
RxCanonicalize(cm, c) ==
  CASE ~cm.ic -> c
    [] cm.uni -> RxScf(c)
    [] OTHER -> IF c \in DOMAIN RxUpperMap THEN RxUpperMap[c] ELSE c
\* The characters that Canonicalize maps to t.
RxPreimage(cm, t) ==
  LET sources == IF cm.uni THEN RxFoldSources ELSE RxUpperSources IN
  (IF t \in DOMAIN sources THEN sources[t] ELSE {}) \cup (IF RxCanonicalize(cm, t) = t THEN {t} ELSE {})
RxScfPreimage(t) == RxPreimage([ic |-> TRUE, uni |-> TRUE], t)
RxIsBasicWord(c) == RxIsDigit(c) \/ RxIsAsciiLetter(c) \/ c = 95
\* Whether the tree t holds the character c.
RxIn(t, c) ==
  CASE t.k = "cps" -> c \in t.set
    [] t.k = "range" -> t.lo <= c /\ c <= t.hi
    [] t.k = "ranges" -> RxInRanges(RegExpPropertyRanges[t.id], c)
    [] t.k = "space" -> RxIsWhiteSpace(c) \/ RxIsLineTerminator(c)
    [] t.k = "lt" -> RxIsLineTerminator(c)
    [] t.k = "all" -> ~t.vi \/ RxScf(c) = c
    [] t.k = "word" -> RxIsBasicWord(c) \/ RxIsBasicWord(RxCanonicalize(t.cm, c))
    [] t.k = "union" -> \E i \in DOMAIN t.sets : RxIn(t.sets[i], c)
    [] t.k = "inter" -> \A i \in DOMAIN t.sets : RxIn(t.sets[i], c)
    [] t.k = "diff" -> RxIn(t.left, c) /\ ~RxIn(t.right, c)
    [] t.k = "fold" -> \E b \in RxScfPreimage(c) : RxIn(t.inner, b)
RxChars(t) == [c |-> t, strs |-> {}]
\* The union of properties of strings, each [chars, strs].
RegExpStringUnion(sets) ==
  [chars |-> UNION {sets[i].chars : i \in DOMAIN sets}, strs |-> UNION {sets[i].strs : i \in DOMAIN sets}]
RxUnion(sets) ==
  [c |-> [k |-> "union", sets |-> [i \in DOMAIN sets |-> sets[i].c]], strs |-> UNION {sets[i].strs : i \in DOMAIN sets}]
RxCm(rer) == [ic |-> rer.ic, uni |-> rer.u \/ rer.v]
\* AllCharacters (§22.2.2.9.3).
RxAllCharacters(rer) == [k |-> "all", vi |-> rer.v /\ rer.ic]
\* CharacterComplement (§22.2.2.9.4).
RxComplement(rer, cs) == RxChars([k |-> "diff", left |-> RxAllCharacters(rer), right |-> cs.c])
\* MaybeSimpleCaseFolding (§22.2.2.9.2).
RxMaybeFold(rer, cs) ==
  IF ~rer.v \/ ~rer.ic THEN cs
  ELSE [c |-> [k |-> "fold", inner |-> cs.c], strs |-> {[i \in DOMAIN str |-> RxScf(str[i])] : str \in cs.strs}]
\* WordCharacters (§22.2.2.9.5).
RxWordCharacters(rer) == RxChars([k |-> "word", cm |-> RxCm(rer)])
\* CompileToCharSet of a CharacterClassEscape (§22.2.2.9).
RxEscapeSet(e, rer) ==
  LET digits == RxChars([k |-> "range", lo |-> 48, hi |-> 57])
      space == RxChars([k |-> "space"])
  IN CASE e.c = 100 -> digits
       [] e.c = 68 -> RxComplement(rer, digits)
       [] e.c = 115 -> space
       [] e.c = 83 -> RxComplement(rer, space)
       [] e.c = 119 -> RxMaybeFold(rer, RxWordCharacters(rer))
       [] e.c = 87 -> RxComplement(rer, RxWordCharacters(rer))
       [] e.c = 112 -> RxPropertySet(e.property, rer)
       [] OTHER -> RxComplement(rer, RxPropertySet(e.property, rer))
RxPropertySet(property, rer) ==
  CASE property.k = "gc" -> RxChars([k |-> "ranges", id |-> property.id])
    [] property.k = "ranges" -> RxMaybeFold(rer, RxChars([k |-> "ranges", id |-> property.id]))
    [] OTHER -> RxMaybeFold(rer, [c |-> [k |-> "cps", set |-> property.set.chars], strs |-> property.set.strs])
\* CompileToCharSet of ClassContents, and of the ranges and operands in it.
RxContentsSet(contents, rer) ==
  LET sets == IF contents.k = "empty" THEN <<>> ELSE [i \in DOMAIN contents.items |-> RxItemSet(contents.items[i], rer)] IN
  CASE contents.k = "empty" -> RxChars(RxNoChars)
    [] contents.k = "intersection" ->
         [c |-> [k |-> "inter", sets |-> [i \in DOMAIN sets |-> sets[i].c]],
          strs |-> {str \in sets[1].strs : \A i \in DOMAIN sets : str \in sets[i].strs}]
    [] contents.k = "subtraction" -> RxSubtract(sets[1], sets, 2)
    [] OTHER -> RxUnion(sets)
RxSubtract(cs, sets, i) ==
  IF i > Len(sets) THEN cs
  ELSE RxSubtract([c |-> [k |-> "diff", left |-> cs.c, right |-> sets[i].c], strs |-> cs.strs \ sets[i].strs], sets, i + 1)
RxItemSet(item, rer) ==
  CASE item.t = "char" -> RxMaybeFold(rer, RxChars([k |-> "cps", set |-> {item.cp}]))
    [] item.t = "range" -> RxMaybeFold(rer, RxChars([k |-> "range", lo |-> item.lo, hi |-> item.hi]))
    [] item.t = "escape" -> RxEscapeSet(item, rer)
    [] item.t = "nested" ->
         IF item.invert THEN RxComplement(rer, RxContentsSet(item.c, rer)) ELSE RxContentsSet(item.c, rer)
    [] OTHER ->
         RxMaybeFold(rer, [c |-> [k |-> "cps", set |-> {item.strs[i][1] : i \in {j \in DOMAIN item.strs : Len(item.strs[j]) = 1}}],
                           strs |-> {item.strs[i] : i \in {j \in DOMAIN item.strs : Len(item.strs[j]) # 1}}])
\* CompilePattern (§22.2.2.2) of a parsed pattern, and CompileSubpattern of its parts. dir is TRUE
\* for forward.
RxCompilePattern(pattern, rer) == RxCompileDisjunction(pattern.d, rer, TRUE)
RxCompileDisjunction(d, rer, dir) ==
  IF Len(d) = 1 THEN RxCompileAlternative(d[1], rer, dir)
  ELSE [t |-> "alt", ms |-> [i \in DOMAIN d |-> RxCompileAlternative(d[i], rer, dir)]]
RxCompileAlternative(terms, rer, dir) ==
  LET ms == [i \in DOMAIN terms |-> RxCompileTerm(terms[i], rer, dir)] IN
  [t |-> "seq", ms |-> IF dir THEN ms ELSE [i \in DOMAIN ms |-> ms[Len(ms) - i + 1]]]
RxCompileTerm(term, rer, dir) ==
  CASE term.t = "^" -> [t |-> "bol", multiline |-> rer.multiline]
    [] term.t = "$" -> [t |-> "eol", multiline |-> rer.multiline]
    [] term.t = "b" -> [t |-> "wb", negated |-> FALSE, cm |-> RxCm(rer)]
    [] term.t = "B" -> [t |-> "wb", negated |-> TRUE, cm |-> RxCm(rer)]
    [] term.t = "look" -> [t |-> "look", positive |-> term.positive, m |-> RxCompileDisjunction(term.d, rer, term.ahead)]
    [] term.q = None -> RxCompileAtom(term.atom, rer, dir)
    [] OTHER ->
         [t |-> "rep", m |-> RxCompileAtom(term.atom, rer, dir), min |-> term.q.min, max |-> term.q.max,
          greedy |-> term.q.greedy, parenIndex |-> term.parenIndex, parenCount |-> term.parenCount]
\* CompileAtom (§22.2.2.7).
RxCompileAtom(atom, rer, dir) ==
  CASE atom.t = "char" -> RxSetMatcher(rer, [k |-> "cps", set |-> {atom.cp}], FALSE, dir)
    [] atom.t = "dot" ->
         RxSetMatcher(rer, IF rer.dotAll THEN RxAllCharacters(rer)
                           ELSE [k |-> "diff", left |-> RxAllCharacters(rer), right |-> [k |-> "lt"]], FALSE, dir)
    [] atom.t = "class" ->
         LET cs == RxContentsSet(atom.c, rer) IN
         IF ~rer.v THEN RxSetMatcher(rer, cs.c, atom.invert, dir)
         ELSE RxCharSetMatcher(rer, IF atom.invert THEN RxComplement(rer, cs) ELSE cs, dir)
    [] atom.t = "escape" -> RxCharSetMatcher(rer, RxEscapeSet(atom, rer), dir)
    [] atom.t = "group" -> [t |-> "group", index |-> atom.index + 1, dir |-> dir, m |-> RxCompileDisjunction(atom.d, rer, dir)]
    [] atom.t = "modifiers" -> RxCompileDisjunction(atom.d, RxUpdateModifiers(rer, atom.add, atom.remove), dir)
    [] atom.t = "backreference" -> [t |-> "back", ns |-> {atom.n}, cm |-> RxCm(rer), dir |-> dir]
    [] atom.t = "look" -> RxCompileTerm(atom, rer, dir)
    [] OTHER ->
         [t |-> "back", ns |-> {i \in DOMAIN rer.groups : rer.groups[i].name = atom.name}, cm |-> RxCm(rer), dir |-> dir]
\* UpdateModifiers (§22.2.2.7.4).
RxUpdateModifiers(rer, add, remove) ==
  [rer EXCEPT !.ic = RxModifier(105, add, remove, @), !.multiline = RxModifier(109, add, remove, @),
              !.dotAll = RxModifier(115, add, remove, @)]
RxModifier(flag, add, remove, value) == IF flag \in add THEN TRUE ELSE IF flag \in remove THEN FALSE ELSE value
\* CharacterSetMatcher (§22.2.2.7.1).
RxSetMatcher(rer, cs, invert, dir) == [t |-> "set", cs |-> cs, invert |-> invert, cm |-> RxCm(rer), dir |-> dir]
\* The matcher of a CharSet that may hold strings: its strings by descending length, then its
\* single characters, then the empty string.
RxCharSetMatcher(rer, cs, dir) ==
  IF cs.strs = {} THEN RxSetMatcher(rer, cs.c, FALSE, dir)
  ELSE [t |-> "strings", singles |-> cs.c, hasEmpty |-> <<>> \in cs.strs, cm |-> RxCm(rer), dir |-> dir,
        byLength |-> RxByLength({Len(str) : str \in cs.strs} \ {0}, cs.strs, RxCm(rer))]
\* The strings of each length, canonicalized, longest first.
RxByLength(lengths, strs, cm) ==
  IF lengths = {} THEN <<>>
  ELSE LET longest == CHOOSE l \in lengths : \A o \in lengths : o <= l IN
       <<<<longest, {RxCanonicalizeString(cm, str) : str \in {s \in strs : Len(s) = longest}}>>>> \o
       RxByLength(lengths \ {longest}, strs, cm)
RxCanonicalizeString(cm, str) == IF cm.ic THEN [i \in DOMAIN str |-> RxCanonicalize(cm, str[i])] ELSE str
\* Runs matcher m on the input env [in, len] from state x with continuation k. A continuation is
\*   done                                the end of a pattern or lookaround
\*   seq(ms, i)                          the rest of a sequence, from its ith matcher
\*   group(index, start, dir)            the end of a capturing group
\*   rep(m, min, max, greedy, start, parenIndex, parenCount)   RepeatMatcher's continuation d
\* each with the continuation next after it.
RxMatch(env, m, x, k) ==
  CASE m.t = "set" ->
         LET index == IF m.dir THEN x.e ELSE x.e - 1 IN
         IF index < 0 \/ index >= env.len THEN MatchFailure
         ELSE IF RxSetFound(m.cs, m.cm, env.in[index + 1]) = m.invert THEN MatchFailure
         ELSE RxContinue(env, k, [x EXCEPT !.e = IF m.dir THEN @ + 1 ELSE @ - 1])
    [] m.t = "seq" -> RxSequence(env, m.ms, 1, x, k)
    [] m.t = "alt" -> RxMatchAlternatives(env, m.ms, 1, x, k)
    [] m.t = "group" -> RxMatch(env, m.m, x, [t |-> "group", index |-> m.index, start |-> x.e, dir |-> m.dir, next |-> k])
    [] m.t = "rep" -> RxRepeatMatcher(env, m.m, m.min, m.max, m.greedy, x, k, m.parenIndex, m.parenCount)
    [] m.t = "bol" ->
         IF x.e = 0 \/ (m.multiline /\ RxIsLineTerminator(env.in[x.e])) THEN RxContinue(env, k, x) ELSE MatchFailure
    [] m.t = "eol" ->
         IF x.e = env.len \/ (m.multiline /\ RxIsLineTerminator(env.in[x.e + 1])) THEN RxContinue(env, k, x) ELSE MatchFailure
    [] m.t = "wb" ->
         IF (RxIsWordChar(env, m.cm, x.e - 1) # RxIsWordChar(env, m.cm, x.e)) # m.negated
         THEN RxContinue(env, k, x) ELSE MatchFailure
    [] m.t = "look" ->
         LET r == RxMatch(env, m.m, x, [t |-> "done"]) IN
         IF m.positive THEN IF r = MatchFailure THEN MatchFailure ELSE RxContinue(env, k, [x EXCEPT !.cap = r.cap])
         ELSE IF r # MatchFailure THEN MatchFailure ELSE RxContinue(env, k, x)
    [] m.t = "back" -> RxBackreference(env, m, x, k)
    [] m.t = "strings" -> RxMatchStrings(env, m, 1, x, k)
RxContinue(env, k, y) ==
  CASE k.t = "done" -> y
    [] k.t = "seq" -> RxSequence(env, k.ms, k.i, y, k.next)
    [] k.t = "group" ->
         RxContinue(env, k.next, [y EXCEPT !.cap[k.index] = IF k.dir THEN <<k.start, y.e>> ELSE <<y.e, k.start>>])
    [] k.t = "rep" ->
         IF k.min = 0 /\ y.e = k.start THEN MatchFailure
         ELSE RxRepeatMatcher(env, k.m, IF k.min = 0 THEN 0 ELSE k.min - 1,
                              IF k.max = RxInfinity THEN RxInfinity ELSE k.max - 1, k.greedy, y, k.next,
                              k.parenIndex, k.parenCount)
\* MatchSequence (§22.2.2.3) of a list of matchers, already in the order they run.
RxSequence(env, ms, i, x, k) ==
  IF i > Len(ms) THEN RxContinue(env, k, x)
  ELSE RxMatch(env, ms[i], x, IF i = Len(ms) THEN k ELSE [t |-> "seq", ms |-> ms, i |-> i + 1, next |-> k])
\* MatchTwoAlternatives (§22.2.2.3) of a list of matchers.
RxMatchAlternatives(env, ms, i, x, k) ==
  IF i > Len(ms) THEN MatchFailure
  ELSE LET r == RxMatch(env, ms[i], x, k) IN IF r # MatchFailure THEN r ELSE RxMatchAlternatives(env, ms, i + 1, x, k)
\* RepeatMatcher (§22.2.2.3.1).
RxRepeatMatcher(env, m, min, max, greedy, x, k, parenIndex, parenCount) ==
  LET d == [t |-> "rep", m |-> m, min |-> min, max |-> max, greedy |-> greedy, start |-> x.e,
            parenIndex |-> parenIndex, parenCount |-> parenCount, next |-> k]
      xr == IF parenCount = 0 THEN x
            ELSE [x EXCEPT !.cap = [i \in DOMAIN @ |-> IF i > parenIndex /\ i <= parenIndex + parenCount THEN None ELSE @[i]]]
  IN CASE max = 0 -> RxContinue(env, k, x)
       [] min # 0 -> RxMatch(env, m, xr, d)
       [] ~greedy -> LET z == RxContinue(env, k, x) IN IF z # MatchFailure THEN z ELSE RxMatch(env, m, xr, d)
       [] OTHER -> LET z == RxMatch(env, m, xr, d) IN IF z # MatchFailure THEN z ELSE RxContinue(env, k, x)
\* Whether CharacterSetMatcher finds a member of A that canonicalizes to the character c does.
RxSetFound(cs, cm, c) == IF ~cm.ic THEN RxIn(cs, c) ELSE \E a \in RxPreimage(cm, RxCanonicalize(cm, c)) : RxIn(cs, a)
\* IsWordChar (§22.2.2.9.2).
RxIsWordChar(env, cm, e) ==
  /\ e # -1 /\ e # env.len
  /\ RxIsBasicWord(env.in[e + 1]) \/ RxIsBasicWord(RxCanonicalize(cm, env.in[e + 1]))
\* BackreferenceMatcher (§22.2.2.7.2), with ns the group numbers the backreference names.
RxBackreference(env, m, x, k) ==
  LET found == {n \in m.ns : x.cap[n] # None} IN
  IF found = {} THEN RxContinue(env, k, x)
  ELSE LET capture == x.cap[CHOOSE n \in found : TRUE]
           len == capture[2] - capture[1]
           f == IF m.dir THEN x.e + len ELSE x.e - len
           g == IF m.dir THEN x.e ELSE f
       IN IF f < 0 \/ f > env.len THEN MatchFailure
          ELSE IF \E i \in 1..len : RxCanonicalize(m.cm, env.in[capture[1] + i]) # RxCanonicalize(m.cm, env.in[g + i])
          THEN MatchFailure
          ELSE RxContinue(env, k, [x EXCEPT !.e = f])
\* The matcher of a CharSet with strings (§22.2.2.7, Atom :: CharacterClass), from its ith length.
RxMatchStrings(env, m, i, x, k) ==
  IF i <= Len(m.byLength) THEN
    LET length == m.byLength[i][1]
      start == IF m.dir THEN x.e ELSE x.e - length
      r == IF start >= 0 /\ start + length <= env.len
                /\ RxCanonicalizeString(m.cm, SubSeq(env.in, start + 1, start + length)) \in m.byLength[i][2]
           THEN RxContinue(env, k, [x EXCEPT !.e = IF m.dir THEN @ + length ELSE @ - length])
           ELSE MatchFailure
    IN IF r # MatchFailure THEN r ELSE RxMatchStrings(env, m, i + 1, x, k)
  ELSE LET singles == RxMatch(env, [t |-> "set", cs |-> m.singles, invert |-> FALSE, cm |-> m.cm, dir |-> m.dir], x, k) IN
       IF singles # MatchFailure \/ ~m.hasEmpty THEN singles ELSE RxContinue(env, k, x)
\* Runs a compiled pattern on input, a list of characters, from index: a MatchState or MatchFailure.
RxRun(matcher, input, index, groupCount) ==
  RxMatch([in |-> input, len |-> Len(input)], matcher, [e |-> index, cap |-> [i \in 1..groupCount |-> None]], [t |-> "done"])
\* Patterns (§22.2.1): a port of engine262's RegExpParser, which parses the pattern's code units and
\* reads a surrogate pair as one code point in Unicode mode. The parser state p is
\*   src     the pattern's code units
\*   pos     the index in src of the next code unit
\*   u, v    whether it parses in UnicodeMode and in UnicodeSetsMode
\*   named   whether it parses with NamedCaptureGroups
\*   captures the number of capturing groups, outside UnicodeMode, when a DecimalEscape is one only
\*           up to it (§B.1.2)
\*   groups  the capturing groups by left parenthesis, each [name, path] with the GroupName as code
\*           units or None, and the path of Disjunction alternatives the group is in
\*   path    the alternatives the parser is in, as <<start of the Disjunction, alternative>> pairs
\*   decs    the numbers of the DecimalEscapes, and refs the GroupNames of \k escapes
\*   err     whether the parser found a Syntax Error
\* Each parse operator returns [p, n]: the state after it and the node it parsed. A parsed character
\* is its CharacterValue (§22.2.1.8). Outside UnicodeMode, it parses the grammar of §B.1.2.
RxIsDigit(c) == c >= 48 /\ c <= 57
RxIsHexDigit(c) == RxIsDigit(c) \/ (c >= 65 /\ c <= 70) \/ (c >= 97 /\ c <= 102)
RxHexValue(c) == IF RxIsDigit(c) THEN c - 48 ELSE IF c >= 97 THEN c - 87 ELSE c - 55
RxIsAsciiLetter(c) == (c >= 65 /\ c <= 90) \/ (c >= 97 /\ c <= 122)
RxIsLead(c) == c >= 55296 /\ c <= 56319
RxIsTrail(c) == c >= 56320 /\ c <= 57343
UTF16SurrogatePairToCodePoint(lead, trail) == (lead - 55296) * 1024 + (trail - 56320) + 65536
RxIsLineTerminator(c) == c \in {10, 13, 8232, 8233}
RxIsWhiteSpace(c) ==
  c \in {9, 11, 12, 32, 160, 65279} \/ RxInRanges(RegExpPropertyRanges[RegExpSpaceSeparatorId], c)
RxIsIDContinue(c) == RxInRanges(RegExpPropertyRanges[RegExpIDContinueId], c)
\* IdentifierStartChar and IdentifierPartChar (§12.7) of a code point.
RxIsIdentifierChar(cp, isStart) ==
  \/ cp = 36 \/ cp = 95
  \/ IF isStart THEN RxInRanges(RegExpPropertyRanges[RegExpIDStartId], cp)
     ELSE cp = 8204 \/ cp = 8205 \/ RxIsIDContinue(cp)
RxUnit(p, k) == IF p.pos + k < Len(p.src) THEN p.src[p.pos + k + 1] ELSE -1
RxAtEnd(p) == p.pos >= Len(p.src)
RxIsAt(p, text) == p.pos + Len(text) <= Len(p.src) /\ SubSeq(p.src, p.pos + 1, p.pos + Len(text)) = text
RxSkip(p, k) == [p EXCEPT !.pos = @ + k]
RxNode(p, n) == [p |-> p, n |-> n]
RxError(p) == [p |-> [p EXCEPT !.err = TRUE], n |-> None]
RxClose(p, text, n) == IF RxIsAt(p, text) THEN RxNode(RxSkip(p, Len(text)), n) ELSE RxError(p)
\* ParsePattern (§22.2.3.4, §B.1.2.9): [ok, pattern], the pattern's Disjunction d and its capturing
\* groups. Outside UnicodeMode, a pattern with a GroupName parses again with NamedCaptureGroups, and
\* one with a DecimalEscape past its capturing groups again with their number.
ParsePattern(units, u, v) ==
  LET first == RxParse(units, u, v, u \/ v, IntLimit)
      groups == first.p.groups
      named == u \/ v \/ \E i \in DOMAIN groups : groups[i].name # None
      d == IF u \/ v \/ first.p.err \/ (~named /\ \A i \in DOMAIN first.p.decs : first.p.decs[i] <= Len(groups))
           THEN first ELSE RxParse(units, FALSE, FALSE, named, Len(groups))
      p == d.p
      names == {p.groups[i].name : i \in DOMAIN p.groups}
  IN IF (u /\ v) \/ p.err \/ ~RxAtEnd(p) THEN [ok |-> FALSE]
     \* The early errors of §22.2.1.1 that need the whole Pattern.
     ELSE IF \E i \in DOMAIN p.decs : p.decs[i] > Len(p.groups) THEN [ok |-> FALSE]
     ELSE IF \E i \in DOMAIN p.refs : p.refs[i] \notin names THEN [ok |-> FALSE]
     ELSE IF \E i, j \in DOMAIN p.groups :
               /\ i < j /\ p.groups[i].name # None /\ p.groups[i].name = p.groups[j].name
               /\ RxMightBothParticipate(p.groups[i].path, p.groups[j].path)
     THEN [ok |-> FALSE]
     ELSE [ok |-> TRUE, pattern |-> [d |-> d.n, groups |-> p.groups]]
RxParse(units, u, v, named, captures) ==
  RxDisjunction([src |-> units, pos |-> 0, u |-> u \/ v, v |-> v, named |-> named, captures |-> captures,
                 groups |-> <<>>, path |-> <<>>, decs |-> <<>>, refs |-> <<>>, err |-> FALSE])
\* MightBothParticipate (§22.2.1.3): two groups can't both participate in a match only when they are
\* in different alternatives of one Disjunction.
RxMightBothParticipate(x, y) ==
  ~\E i \in 1..Len(x) : i <= Len(y) /\ x[i][1] = y[i][1] /\ x[i][2] # y[i][2]
\* Disjunction :: Alternative | Disjunction, as the list of its alternatives.
RxDisjunction(p) == RxAlternatives(p, p.pos, p.path, 1, <<>>)
RxAlternatives(p, start, outer, i, alts) ==
  LET a == RxAlternative([p EXCEPT !.path = Append(outer, <<start, i>>)], <<>>) IN
  IF a.p.err THEN a
  ELSE IF RxIsAt(a.p, N("|")) THEN RxAlternatives(RxSkip(a.p, 1), start, outer, i + 1, Append(alts, a.n))
  ELSE RxNode([a.p EXCEPT !.path = outer], Append(alts, a.n))
\* Alternative :: Term*, as the list of its terms.
RxAlternative(p, terms) ==
  IF RxAtEnd(p) \/ RxUnit(p, 0) \in Range(IF p.u THEN N(")]}|") ELSE N(")|")) THEN RxNode(p, terms)
  ELSE LET t == RxTerm(p) IN IF t.p.err THEN t ELSE RxAlternative(t.p, Append(terms, t.n))
\* Term :: Assertion | Atom Quantifier?, and outside UnicodeMode QuantifiableAssertion Quantifier?,
\* with the capturing groups before and within the Atom.
RxTerm(p) ==
  CASE RxIsAt(p, N("^")) -> RxNode(RxSkip(p, 1), [t |-> "^"])
    [] RxIsAt(p, N("$")) -> RxNode(RxSkip(p, 1), [t |-> "$"])
    [] RxIsAt(p, N("\\b")) -> RxNode(RxSkip(p, 2), [t |-> "b"])
    [] RxIsAt(p, N("\\B")) -> RxNode(RxSkip(p, 2), [t |-> "B"])
    [] RxIsAt(p, N("(?=")) /\ p.u -> RxLookaround(RxSkip(p, 3), TRUE, TRUE)
    [] RxIsAt(p, N("(?!")) /\ p.u -> RxLookaround(RxSkip(p, 3), TRUE, FALSE)
    [] RxIsAt(p, N("(?=")) -> RxQuantified(p, RxLookaround(RxSkip(p, 3), TRUE, TRUE))
    [] RxIsAt(p, N("(?!")) -> RxQuantified(p, RxLookaround(RxSkip(p, 3), TRUE, FALSE))
    [] RxIsAt(p, N("(?<=")) -> RxLookaround(RxSkip(p, 4), FALSE, TRUE)
    [] RxIsAt(p, N("(?<!")) -> RxLookaround(RxSkip(p, 4), FALSE, FALSE)
    [] OTHER -> RxQuantified(p, RxAtom(p))
\* The term of atom a, which starts at p, with the Quantifier after it.
RxQuantified(p, a) ==
  IF a.p.err THEN a ELSE
  LET q == RxQuantifier(a.p) IN IF q.p.err THEN q
  ELSE RxNode(q.p, [t |-> "atom", atom |-> a.n, q |-> q.n, parenIndex |-> Len(p.groups),
                    parenCount |-> Len(q.p.groups) - Len(p.groups)])
RxLookaround(p, ahead, positive) ==
  LET d == RxDisjunction(p) IN
  IF d.p.err THEN d ELSE RxClose(d.p, N(")"), [t |-> "look", ahead |-> ahead, positive |-> positive, d |-> d.n])
\* Quantifier :: QuantifierPrefix ?opt, as [min, max, greedy], or None. An unbounded max, or a bound
\* that no match can reach, is RxInfinity.
RxQuantifier(p) ==
  LET prefix ==
        CASE RxIsAt(p, N("*")) -> RxNode(RxSkip(p, 1), <<0, RxInfinity>>)
          [] RxIsAt(p, N("+")) -> RxNode(RxSkip(p, 1), <<1, RxInfinity>>)
          [] RxIsAt(p, N("?")) -> RxNode(RxSkip(p, 1), <<0, 1>>)
          [] RxIsAt(p, N("{")) /\ (p.u \/ RxIsBracedQuantifier(p)) -> RxBraceQuantifier(RxSkip(p, 1))
          [] OTHER -> RxNode(p, None)
      lazy == RxIsAt(prefix.p, N("?"))
  IN IF prefix.p.err \/ prefix.n = None THEN prefix
     ELSE RxNode(RxSkip(prefix.p, IF lazy THEN 1 ELSE 0),
                 [min |-> prefix.n[1], max |-> prefix.n[2], greedy |-> ~lazy])
RxBraceQuantifier(p) ==
  LET a == RxDecimalDigits(p) IN
  IF a.p.err THEN a
  ELSE IF ~RxIsAt(a.p, N(",")) THEN RxClose(a.p, N("}"), <<RxDigitsValue(a.n), RxDigitsValue(a.n)>>)
  ELSE IF RxIsAt(RxSkip(a.p, 1), N("}")) THEN RxNode(RxSkip(a.p, 2), <<RxDigitsValue(a.n), RxInfinity>>)
  ELSE LET b == RxDecimalDigits(RxSkip(a.p, 1)) IN
       IF b.p.err THEN b
       ELSE IF RxDigitsLess(b.n, a.n) THEN RxError(b.p)
       ELSE RxClose(b.p, N("}"), <<RxDigitsValue(a.n), RxDigitsValue(b.n)>>)
\* Whether a QuantifierPrefix's braces, or an InvalidBracedQuantifier, are at "{".
RxIsBracedQuantifier(p) ==
  LET a == RxDigitsFrom(RxSkip(p, 1), <<>>)
      b == RxDigitsFrom(RxSkip(a.p, 1), <<>>)
  IN a.n # <<>> /\ (RxIsAt(a.p, N("}")) \/ (RxIsAt(a.p, N(",")) /\ RxIsAt(b.p, N("}"))))
RxDecimalDigits(p) == IF RxIsDigit(RxUnit(p, 0)) THEN RxDigitsFrom(p, <<>>) ELSE RxError(p)
RxDigitsFrom(p, digits) ==
  IF RxIsDigit(RxUnit(p, 0)) THEN RxDigitsFrom(RxSkip(p, 1), Append(digits, RxUnit(p, 0)))
  ELSE RxNode(p, digits)
\* The MV of decimal digits, or RxInfinity when it's at least that.
RxDigitsValue(digits) == RxDigitsValueFrom(digits, 1, 0)
RxDigitsValueFrom(digits, i, v) ==
  IF i > Len(digits) THEN v
  ELSE RxDigitsValueFrom(digits, i + 1,
         IF v > (RxInfinity - (digits[i] - 48)) \div 10 THEN RxInfinity ELSE v * 10 + digits[i] - 48)
RxDigitsLess(a, b) ==
  LET x == RxNoLeadingZeros(a)
      y == RxNoLeadingZeros(b)
  IN Len(x) < Len(y) \/ (Len(x) = Len(y) /\ LexLess(x, y))
RxNoLeadingZeros(digits) ==
  IF digits # <<>> /\ Head(digits) = 48 THEN RxNoLeadingZeros(Tail(digits)) ELSE digits
\* Atom (§22.2.1), and outside UnicodeMode ExtendedAtom, whose ExtendedPatternCharacter may be "]",
\* "{", or "}", but not an InvalidBracedQuantifier.
RxAtom(p) ==
  CASE RxIsAt(p, N(".")) -> RxNode(RxSkip(p, 1), [t |-> "dot"])
    [] RxIsAt(p, N("\\")) -> RxAtomEscape(RxSkip(p, 1))
    [] RxIsAt(p, N("(")) -> RxGroup(RxSkip(p, 1))
    [] RxIsAt(p, N("[")) -> RxCharacterClass(p)
    [] ~p.u /\ RxUnit(p, 0) \in Range(N("]{}")) /\ ~(RxIsAt(p, N("{")) /\ RxIsBracedQuantifier(p)) ->
         RxNode(RxSkip(p, 1), [t |-> "char", cp |-> RxUnit(p, 0)])
    [] RxUnit(p, 0) \in RxSyntaxCharacters -> RxError(p)
    [] OTHER -> LET c == RxSourceCharacter(p) IN IF c.p.err THEN c ELSE RxNode(c.p, [t |-> "char", cp |-> c.n])
RxSourceCharacter(p) ==
  CASE RxAtEnd(p) -> RxError(p)
    [] p.u /\ RxIsLead(RxUnit(p, 0)) /\ RxIsTrail(RxUnit(p, 1)) ->
         RxNode(RxSkip(p, 2), UTF16SurrogatePairToCodePoint(RxUnit(p, 0), RxUnit(p, 1)))
    [] OTHER -> RxNode(RxSkip(p, 1), RxUnit(p, 0))
\* ( GroupSpecifier? Disjunction ) and the modifier groups (? Modifiers : Disjunction ), after "(".
RxGroup(p) ==
  IF RxIsAt(p, N("?<")) THEN
    LET name == RxGroupName(RxSkip(p, 1)) IN IF name.p.err THEN name ELSE RxCapturingGroup(name.p, name.n)
  ELSE IF RxIsAt(p, N("?")) THEN
    LET m == RxModifiers(RxSkip(p, 1), <<>>, <<>>, FALSE) IN IF m.p.err THEN m ELSE
    LET d == RxDisjunction(m.p) IN
    IF d.p.err THEN d ELSE RxClose(d.p, N(")"), [t |-> "modifiers", add |-> m.n[1], remove |-> m.n[2], d |-> d.n])
  ELSE RxCapturingGroup(p, None)
RxCapturingGroup(p, name) ==
  LET d == RxDisjunction([p EXCEPT !.groups = Append(@, [name |-> name, path |-> p.path])]) IN
  IF d.p.err THEN d ELSE RxClose(d.p, N(")"), [t |-> "group", index |-> Len(p.groups), d |-> d.n])
\* RegularExpressionModifiers - RegularExpressionModifiers before ":", as the sets of code units
\* to add and to remove.
RxModifiers(p, add, remove, isRemoving) ==
  CASE RxIsAt(p, N(":")) ->
         IF (isRemoving /\ add = <<>> /\ remove = <<>>) \/ Cardinality(Range(add \o remove)) # Len(add \o remove)
         THEN RxError(p) ELSE RxNode(RxSkip(p, 1), <<Range(add), Range(remove)>>)
    [] RxUnit(p, 0) \in Range(N("ims")) /\ isRemoving ->
         RxModifiers(RxSkip(p, 1), add, Append(remove, RxUnit(p, 0)), TRUE)
    [] RxUnit(p, 0) \in Range(N("ims")) -> RxModifiers(RxSkip(p, 1), Append(add, RxUnit(p, 0)), remove, FALSE)
    [] RxIsAt(p, N("-")) /\ ~isRemoving -> RxModifiers(RxSkip(p, 1), add, remove, TRUE)
    [] OTHER -> RxError(p)
\* AtomEscape, after "\". Outside UnicodeMode, a DecimalEscape past the capturing groups is a
\* CharacterEscape.
RxAtomEscape(p) ==
  LET class == RxCharacterClassEscape(p)
      digits == RxDigitsFrom(p, <<>>)
  IN
  CASE RxIsAt(p, N("k")) /\ p.named ->
         LET name == RxGroupName(RxSkip(p, 1)) IN
         IF name.p.err THEN name
         ELSE RxNode([name.p EXCEPT !.refs = Append(@, name.n)], [t |-> "named", name |-> name.n])
    [] class.p.err \/ class.n # None -> class
    [] RxIsDigit(RxUnit(p, 0)) /\ ~RxIsAt(p, N("0")) /\ RxDigitsValue(digits.n) <= p.captures ->
         LET n == RxDigitsValue(digits.n)
         IN RxNode([digits.p EXCEPT !.decs = Append(@, n)], [t |-> "backreference", n |-> n])
    [] OTHER -> LET e == RxCharacterEscape(p) IN IF e.p.err THEN e ELSE RxNode(e.p, [t |-> "char", cp |-> e.n])
\* CharacterEscape, after "\": its CharacterValue. Outside UnicodeMode, by §B.1.2, "\c" before a
\* code unit that isn't a letter is "\" followed by "c", an octal digit starts a
\* LegacyOctalEscapeSequence, and IdentityEscape is any code unit but "c", or "k" with
\* NamedCaptureGroups, so "\x" or "\u" that starts no escape is "x" or "u".
RxCharacterEscape(p) ==
  LET c == RxUnit(p, 0) IN
  CASE c \in Range(N("fnrtv")) ->
         RxNode(RxSkip(p, 1), CASE c = 116 -> 9 [] c = 110 -> 10 [] c = 118 -> 11 [] c = 102 -> 12 [] OTHER -> 13)
    [] RxIsAt(p, N("c")) ->
         IF RxIsAsciiLetter(RxUnit(p, 1)) THEN RxNode(RxSkip(p, 2), RxUnit(p, 1) % 32)
         ELSE IF p.u THEN RxError(p) ELSE RxNode(p, 92)
    [] RxIsAt(p, N("x")) ->
         IF RxIsHexDigit(RxUnit(p, 1)) /\ RxIsHexDigit(RxUnit(p, 2))
         THEN RxNode(RxSkip(p, 3), RxHexValue(RxUnit(p, 1)) * 16 + RxHexValue(RxUnit(p, 2)))
         ELSE IF p.u THEN RxError(p) ELSE RxNode(RxSkip(p, 1), c)
    [] RxIsAt(p, N("u")) ->
         LET e == RxUnicodeEscape(p) IN
         IF e.p.err \/ e.n # None THEN e ELSE IF p.u THEN RxError(p) ELSE RxNode(RxSkip(p, 1), c)
    [] RxAtEnd(p) -> RxError(p)
    [] RxIsAt(p, N("0")) /\ ~RxIsDigit(RxUnit(p, 1)) -> RxNode(RxSkip(p, 1), 0)
    [] p.u -> IF c = 47 \/ c \in RxSyntaxCharacters THEN RxNode(RxSkip(p, 1), c) ELSE RxError(p)
    [] RxIsOctalDigit(c) -> RxLegacyOctal(RxSkip(p, 1), IF c <= 51 THEN 2 ELSE 1, c - 48)
    [] OTHER -> IF p.named /\ c = 107 THEN RxError(p) ELSE RxNode(RxSkip(p, 1), c)
\* LegacyOctalEscapeSequence after its first digit, with up to more digits left: its MV.
RxIsOctalDigit(c) == c >= 48 /\ c <= 55
RxLegacyOctal(p, more, value) ==
  IF more = 0 \/ ~RxIsOctalDigit(RxUnit(p, 0)) THEN RxNode(p, value)
  ELSE RxLegacyOctal(RxSkip(p, 1), more - 1, value * 8 + RxUnit(p, 0) - 48)
\* RegExpUnicodeEscapeSequence at "u": its CharacterValue, or None with p unchanged when there's none.
RxUnicodeEscape(p) ==
  LET q == RxSkip(p, 1)
      r == RxSkip(q, 4)
      lead == RxHex4Value(q)
  IN CASE p.u /\ RxIsAt(q, N("{")) -> RxBracedHex(RxSkip(q, 1), 0, 0)
       [] ~RxIsHex4(q) -> RxNode(p, None)
       [] p.u /\ RxIsLead(lead) /\ RxIsAt(r, N("\\u")) /\ RxIsHex4(RxSkip(r, 2)) /\ RxIsTrail(RxHex4Value(RxSkip(r, 2))) ->
            RxNode(RxSkip(r, 6), UTF16SurrogatePairToCodePoint(lead, RxHex4Value(RxSkip(r, 2))))
       [] OTHER -> RxNode(r, lead)
RxIsHex4(p) == \A i \in 0..3 : RxIsHexDigit(RxUnit(p, i))
RxHex4Value(p) == ((RxHexValue(RxUnit(p, 0)) * 16 + RxHexValue(RxUnit(p, 1))) * 16 + RxHexValue(RxUnit(p, 2))) * 16 + RxHexValue(RxUnit(p, 3))
\* CodePoint :: HexDigits but only if MV of HexDigits ≤ 0x10FFFF, up to "}".
RxBracedHex(p, count, value) ==
  CASE RxIsAt(p, N("}")) -> IF count = 0 THEN RxError(p) ELSE RxNode(RxSkip(p, 1), value)
    [] ~RxIsHexDigit(RxUnit(p, 0)) \/ value * 16 + RxHexValue(RxUnit(p, 0)) > 1114111 -> RxError(p)
    [] OTHER -> RxBracedHex(RxSkip(p, 1), count + 1, value * 16 + RxHexValue(RxUnit(p, 0)))
\* GroupName :: < RegExpIdentifierName >, as the code units of the name.
RxGroupName(p) ==
  LET name == RxIdentifierName(RxSkip(p, 1), <<>>) IN
  CASE ~RxIsAt(p, N("<")) -> RxError(p)
    [] name.p.err -> name
    [] name.n = <<>> -> RxError(name.p)
    [] OTHER -> RxClose(name.p, N(">"), name.n)
RxIdentifierName(p, name) ==
  LET c == RxUnit(p, 0)
      e == RxUnicodeEscape([RxSkip(p, 1) EXCEPT !.u = TRUE])
      pair == UTF16SurrogatePairToCodePoint(c, RxUnit(p, 1))
  IN CASE RxAtEnd(p) -> RxNode(p, name)
       [] RxIsAt(p, N("\\")) ->
            IF e.p.err \/ e.n = None \/ ~RxIsIdentifierChar(e.n, name = <<>>) THEN RxError(p)
            ELSE RxIdentifierName([e.p EXCEPT !.u = p.u], name \o UTF16EncodeCodePoint(e.n))
       [] RxIsLead(c) ->
            IF ~RxIsTrail(RxUnit(p, 1)) \/ ~RxIsIdentifierChar(pair, name = <<>>) THEN RxError(p)
            ELSE RxIdentifierName(RxSkip(p, 2), name \o <<c, RxUnit(p, 1)>>)
       [] RxIsIdentifierChar(c, name = <<>>) -> RxIdentifierName(RxSkip(p, 1), Append(name, c))
       [] OTHER -> RxNode(p, name)
\* CharacterClassEscape at the code unit after "\", or None with p unchanged when there's none. A
\* property escape resolves its property: k is "gc" for a General_Category value on its own, which
\* MaybeSimpleCaseFolding doesn't apply to, "ranges" for another property of code points, and
\* "strings" for a property of strings.
RxCharacterClassEscape(p) ==
  LET c == RxUnit(p, 0) IN
  CASE c \in Range(N("dDsSwW")) -> RxNode(RxSkip(p, 1), [t |-> "escape", c |-> c])
    [] c \in Range(N("pP")) /\ p.u -> RxPropertyEscape(RxSkip(p, 1), c)
    [] OTHER -> RxNode(p, None)
RxPropertyEscape(p, c) ==
  LET name == RxPropertyCharacters(RxSkip(p, 1), <<>>)
      value == RxPropertyCharacters(RxSkip(name.p, 1), <<>>)
  IN CASE ~RxIsAt(p, N("{")) -> RxError(p)
       [] name.p.err -> name
       [] name.n = <<>> -> RxError(name.p)
       [] ~RxIsAt(name.p, N("=")) -> RxPropertyEnd(name.p, c, RxLoneProperty(name.n, p.v, c = 80))
       [] value.p.err -> value
       [] value.n = <<>> -> RxError(value.p)
       [] OTHER -> RxPropertyEnd(value.p, c, RxPropertyValue(name.n, value.n))
RxPropertyCharacters(p, acc) ==
  CASE RxAtEnd(p) -> RxError(p)
    [] RxIsDigit(RxUnit(p, 0)) \/ RxIsAsciiLetter(RxUnit(p, 0)) \/ RxUnit(p, 0) = 95 ->
         RxPropertyCharacters(RxSkip(p, 1), Append(acc, RxUnit(p, 0)))
    [] OTHER -> RxNode(p, acc)
RxPropertyEnd(p, c, property) ==
  IF property = None THEN RxError(p) ELSE RxClose(p, N("}"), [t |-> "escape", c |-> c, property |-> property])
\* The property of UnicodePropertyName = UnicodePropertyValue, or None for a Syntax Error.
RxPropertyValue(name, value) ==
  LET gc == RxLookup(RegExpGeneralCategories, value)
      sc == RxLookup(RegExpScripts, value)
  IN CASE name \in {N("General_Category"), N("gc")} /\ gc # None -> [k |-> "ranges", id |-> gc[2]]
       [] name \in {N("Script"), N("sc")} /\ sc # None -> [k |-> "ranges", id |-> sc[2]]
       [] name \in {N("Script_Extensions"), N("scx")} /\ sc # None -> [k |-> "ranges", id |-> sc[3]]
       [] OTHER -> None
\* The property of LoneUnicodePropertyNameOrValue, or None for a Syntax Error.
RxLoneProperty(name, v, negated) ==
  LET gc == RxLookup(RegExpGeneralCategories, name)
      binary == RxLookup(RegExpBinaryPropertyIds, name)
      strings == RxLookup(RegExpStringPropertySets, name)
  IN CASE gc # None -> [k |-> "gc", id |-> gc[2]]
       [] binary # None -> [k |-> "ranges", id |-> binary[2]]
       [] strings # None /\ v /\ ~negated -> [k |-> "strings", set |-> strings[2]]
       [] OTHER -> None
\* The entry of a table whose first element is key, or None.
RxLookup(table, key) ==
  LET found == SelectSeq(table, LAMBDA entry : entry[1] = key) IN IF found = <<>> THEN None ELSE found[1]
\* CharacterClass :: [ ^? ClassContents ].
RxCharacterClass(p) == RxBracketed(p, "class")
\* A bracketed class at "[": a CharacterClass, or with kind "nested" a NestedClass.
RxBracketed(p, kind) ==
  LET invert == RxIsAt(RxSkip(p, 1), N("^"))
      c == RxClassContents(RxSkip(p, IF invert THEN 2 ELSE 1))
  IN IF c.p.err THEN c
     ELSE IF invert /\ RxContentsMayContainStrings(c.n) THEN RxError(c.p)
     ELSE RxClose(c.p, N("]"), [t |-> kind, invert |-> invert, c |-> c.n])
\* ClassContents: [k |-> "empty"], NonemptyClassRanges as [k |-> "ranges", items], or a
\* ClassSetExpression with k "union", "intersection", or "subtraction".
RxClassContents(p) ==
  CASE RxIsAt(p, N("]")) -> RxNode(p, [k |-> "empty"])
    [] p.v -> RxClassSetExpression(p)
    [] OTHER -> RxClassRanges(p, <<>>)
\* NonemptyClassRanges, as a list of characters, ranges, and class escapes.
RxClassRanges(p, items) ==
  LET a == RxClassAtom(p)
      q == RxSkip(a.p, 1)
      b == RxClassAtom(q)
  IN CASE RxIsAt(p, N("]")) -> RxNode(p, [k |-> "ranges", items |-> items])
       [] RxAtEnd(p) -> RxError(p)
       [] a.p.err -> a
       [] ~RxIsAt(a.p, N("-")) -> RxClassRanges(a.p, Append(items, a.n))
       [] RxIsAt(q, N("]")) -> RxClassRanges(q, items \o <<a.n, [t |-> "char", cp |-> 45]>>)
       [] b.p.err -> b
       \* §B.1.2.8.1: outside UnicodeMode, a class escape at either end is in the union with "-".
       [] (a.n.t = "escape" \/ b.n.t = "escape") /\ ~p.u ->
            RxClassRanges(b.p, items \o <<a.n, [t |-> "char", cp |-> 45], b.n>>)
       [] a.n.t = "escape" \/ b.n.t = "escape" \/ a.n.cp > b.n.cp -> RxError(b.p)
       [] OTHER -> RxClassRanges(b.p, Append(items, [t |-> "range", lo |-> a.n.cp, hi |-> b.n.cp]))
\* ClassAtom: a character, or a class escape.
RxClassAtom(p) ==
  LET q == RxSkip(p, 1)
      class == RxCharacterClassEscape(q)
      e == RxCharacterEscape(q)
      c == RxSourceCharacter(p)
  IN CASE ~RxIsAt(p, N("\\")) -> IF c.p.err THEN c ELSE RxNode(c.p, [t |-> "char", cp |-> c.n])
       [] RxIsAt(q, N("b")) -> RxNode(RxSkip(q, 1), [t |-> "char", cp |-> 8])
       [] p.u /\ RxIsAt(q, N("-")) -> RxNode(RxSkip(q, 1), [t |-> "char", cp |-> 45])
       [] class.p.err \/ class.n # None -> class
       [] ~p.u /\ RxIsAt(q, N("c")) /\ (RxIsDigit(RxUnit(q, 1)) \/ RxUnit(q, 1) = 95) ->
            RxNode(RxSkip(q, 2), [t |-> "char", cp |-> RxUnit(q, 1) % 32])
       [] e.p.err -> e
       [] OTHER -> RxNode(e.p, [t |-> "char", cp |-> e.n])
\* ClassSetExpression :: ClassUnion | ClassIntersection | ClassSubtraction.
RxClassSetExpression(p) ==
  LET left == RxClassSetCharacter(p)
      operand == IF left.n # None THEN RxNode(left.p, [t |-> "char", cp |-> left.n]) ELSE RxClassSetOperand(p)
  IN CASE left.p.err -> left
       [] left.n # None /\ RxIsAt(left.p, N("-")) /\ ~RxIsAt(left.p, N("--")) -> RxClassUnion(p, <<>>)
       [] operand.p.err -> operand
       [] RxIsAt(operand.p, N("&&")) -> RxClassSetOperation(RxSkip(operand.p, 2), "intersection", N("&&"), <<operand.n>>)
       [] RxIsAt(operand.p, N("--")) -> RxClassSetOperation(RxSkip(operand.p, 2), "subtraction", N("--"), <<operand.n>>)
       [] OTHER -> RxClassUnion(operand.p, <<operand.n>>)
\* ClassUnion :: (ClassSetRange | ClassSetOperand)*.
RxClassUnion(p, items) ==
  LET c == RxClassSetCharacter(p)
      d == RxClassSetCharacter(RxSkip(c.p, 1))
      o == RxClassSetOperand(p)
  IN CASE c.p.err -> c
       [] c.n # None /\ RxIsAt(c.p, N("-")) ->
            IF d.p.err THEN d
            ELSE IF d.n = None \/ c.n > d.n THEN RxError(d.p)
            ELSE RxClassUnion(d.p, Append(items, [t |-> "range", lo |-> c.n, hi |-> d.n]))
       [] c.n # None -> RxClassUnion(c.p, Append(items, [t |-> "char", cp |-> c.n]))
       [] ~RxIsAt(p, N("\\")) /\ ~RxIsAt(p, N("[")) -> RxNode(p, [k |-> "union", items |-> items])
       [] o.p.err -> o
       [] OTHER -> RxClassUnion(o.p, Append(items, o.n))
\* ClassIntersection and ClassSubtraction: operands joined by op, "&&" or "--". The second operand of
\* "&&" can't start with "&".
RxClassSetOperation(p, kind, op, items) ==
  LET o == RxClassSetOperand(p) IN
  CASE kind = "intersection" /\ RxIsAt(p, N("&")) -> RxError(p)
    [] o.p.err -> o
    [] RxIsAt(o.p, op) -> RxClassSetOperation(RxSkip(o.p, 2), kind, op, Append(items, o.n))
    [] OTHER -> RxNode(o.p, [k |-> kind, items |-> Append(items, o.n)])
\* ClassSetOperand :: NestedClass | ClassStringDisjunction | ClassSetCharacter.
RxClassSetOperand(p) ==
  LET strings == RxClassStrings(RxSkip(p, 3), <<>>, <<>>)
      class == IF RxIsAt(p, N("\\")) THEN RxCharacterClassEscape(RxSkip(p, 1)) ELSE RxNode(p, None)
      c == RxClassSetCharacter(p)
  IN CASE RxIsAt(p, N("[")) -> RxBracketed(p, "nested")
       [] RxIsAt(p, N("\\q{")) -> IF strings.p.err THEN strings ELSE RxClose(strings.p, N("}"), [t |-> "strings", strs |-> strings.n])
       [] RxIsAt(p, N("\\q")) -> RxError(p)
       [] class.p.err \/ class.n # None -> class
       [] c.p.err -> c
       [] c.n = None -> RxError(p)
       [] OTHER -> RxNode(c.p, [t |-> "char", cp |-> c.n])
\* ClassSetCharacter: its CharacterValue, or None with p unchanged when there's none.
RxClassSetCharacter(p) ==
  LET a == RxUnit(p, 0)
      b == RxUnit(p, 1)
  IN CASE RxAtEnd(p) -> RxError(p)
       [] RxIsAt(p, N("\\b")) -> RxNode(RxSkip(p, 2), 8)
       [] ~(a = b /\ a \in RxClassSetReservedDoublePunctuators) /\ a \notin RxClassSetSyntaxCharacters ->
            RxSourceCharacter(p)
       [] a # 92 -> RxNode(p, None)
       [] b \in RxClassSetReservedPunctuators -> RxNode(RxSkip(p, 2), b)
       [] b \in RxCharacterEscapeStarts -> RxCharacterEscape(RxSkip(p, 1))
       [] OTHER -> RxNode(p, None)
\* ClassStringDisjunctionContents, after "\q{": the list of its ClassStrings, as code points.
RxClassStrings(p, current, strs) ==
  LET c == RxClassSetCharacter(p) IN
  CASE c.p.err -> c
    [] c.n # None -> RxClassStrings(c.p, Append(current, c.n), strs)
    [] RxIsAt(p, N("|")) -> RxClassStrings(RxSkip(p, 1), <<>>, Append(strs, current))
    [] OTHER -> RxNode(p, Append(strs, current))
\* MayContainStrings (§22.2.1.6).
RxContentsMayContainStrings(c) ==
  CASE c.k = "union" -> \E i \in DOMAIN c.items : RxOperandMayContainStrings(c.items[i])
    [] c.k = "intersection" -> \A i \in DOMAIN c.items : RxOperandMayContainStrings(c.items[i])
    [] c.k = "subtraction" -> RxOperandMayContainStrings(c.items[1])
    [] OTHER -> FALSE
RxOperandMayContainStrings(o) ==
  CASE o.t = "nested" -> ~o.invert /\ RxContentsMayContainStrings(o.c)
    [] o.t = "escape" -> o.c = 112 /\ o.property.k = "strings"
    [] o.t = "strings" -> \E i \in DOMAIN o.strs : Len(o.strs[i]) # 1
    [] OTHER -> FALSE
\* Unicode data for RegExp (§22.2), generated by scripts/generate-regexp-unicode.ts from the
\* tables engine262 uses (Unicode 17). Don't edit.
\* The code points of each property, by id, as sorted ranges <<lo1, hi1, lo2, hi2, ...>>.
\* The values and aliases of General_Category, as code units, with their property ids.
\* The values and aliases of Script, with the ids of Script and Script_Extensions.
\* The binary properties and aliases of Table 70, with their property ids.
\* The properties of strings of Table 71 but RGI_Emoji: their code points and longer strings.
\* The binary properties of strings of Table 71, with their sets.
\* scf, the simple or common case folding of CaseFolding.txt, of each code point it changes.
\* Canonicalize without u or v, of each code unit it changes.
\* RegExp objects (§22.2.3 to §22.2.9). A RegExp object has class "regexp" and the slots
\*   source, flags   [[OriginalSource]] and [[OriginalFlags]], as code units
\*   matcher         [[RegExpMatcher]], the compiled pattern
\*   groups          the pattern's capturing groups, each [name, path]
\*   realm, legacy   [[Realm]] and [[LegacyFeaturesEnabled]], from the legacy RegExp features proposal
\* A RegExp String Iterator has class "regexpStringIterator" and the slots r, str, global, unicode,
\* the state of its closure, and done and running, the state of its generator.
\* RegExpAlloc (§22.2.3.2), with the legacy RegExp features proposal's [[Realm]] and [[LegacyFeaturesEnabled]].
RegExpAlloc(s, newTarget) ==
  LET o == OrdinaryCreateFromConstructor(s, newTarget, "RegExpPrototype", "regexp",
                                         [source |-> <<>>, flags |-> <<>>, matcher |-> None, groups |-> <<>>,
                                          realm |-> s.realmId, legacy |-> newTarget = Intrinsic(s, "RegExp")])
  IN IF IsAbrupt(o) THEN o
     ELSE Ok(SetO(o.s, Val(o), PutProp(O(o.s, Val(o)), SV("lastIndex"), DataDesc(Undefined, TRUE, FALSE, FALSE))), Val(o))
\* RegExpInitialize (§22.2.3.3).
RegExpInitialize(s, obj, pattern, flags) ==
  LET p == IF pattern = Undefined THEN Ok(s, EmptyStr) ELSE ToStr(s, pattern) IN IF IsAbrupt(p) THEN p ELSE
  LET f == IF flags = Undefined THEN Ok(p.s, EmptyStr) ELSE ToStr(p.s, flags) IN IF IsAbrupt(f) THEN f ELSE
  LET units == Val(f).value
      parsed == ParsePattern(Val(p).value, 117 \in Range(units), 118 \in Range(units))
  IN IF ~(Range(units) \subseteq Range(N("dgimsuvy"))) \/ Cardinality(Range(units)) # Len(units) THEN ThrowError(f.s, "SyntaxError")
     ELSE IF ~parsed.ok THEN ThrowError(f.s, "SyntaxError")
     ELSE LET rer == [ic |-> 105 \in Range(units), multiline |-> 109 \in Range(units), dotAll |-> 115 \in Range(units),
                      u |-> 117 \in Range(units), v |-> 118 \in Range(units), groups |-> parsed.pattern.groups]
              t == SetO(f.s, obj, [O(f.s, obj) EXCEPT !.slots.source = Val(p).value, !.slots.flags = units,
                                     !.slots.matcher = RxCompilePattern(parsed.pattern, rer), !.slots.groups = parsed.pattern.groups])
              r == Set(t, obj, SV("lastIndex"), IntV(0), TRUE)
          IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, obj)
\* RegExpCreate (§22.2.3.1).
RegExpCreate(s, P, F) ==
  LET o == RegExpAlloc(s, Intrinsic(s, "RegExp")) IN IF IsAbrupt(o) THEN o ELSE RegExpInitialize(o.s, Val(o), P, F)
\* Evaluation of a RegularExpressionLiteral (§13.2.7.3).
RegExpCreateLiteral(s, n) == RegExpCreate(s, Str(n.RegularExpressionBody), Str(n.RegularExpressionFlags))
\* The RegExp constructor (§22.2.4.1).
RegExpConstructor(s, f, pattern, flags, nt) ==
  LET isRegExp == IsRegExp(s, pattern) IN IF IsAbrupt(isRegExp) THEN isRegExp ELSE
  LET newTarget == IF nt = Undefined THEN f ELSE nt
      patternConstructor ==
        IF nt = Undefined /\ Val(isRegExp) = True /\ flags = Undefined THEN Get(isRegExp.s, pattern, SV("constructor"))
        ELSE Ok(isRegExp.s, Undefined)
  IN IF IsAbrupt(patternConstructor) THEN patternConstructor
     ELSE IF nt = Undefined /\ Val(isRegExp) = True /\ flags = Undefined /\ SameValue(newTarget, Val(patternConstructor))
     THEN Ok(patternConstructor.s, pattern)
     ELSE LET s1 == patternConstructor.s
              isMatcher == IsObject(pattern) /\ O(s1, pattern).class = "regexp"
              P == CASE isMatcher -> Ok(s1, Str(O(s1, pattern).slots.source))
                     [] Val(isRegExp) = True -> Get(s1, pattern, SV("source"))
                     [] OTHER -> Ok(s1, pattern)
          IN IF IsAbrupt(P) THEN P ELSE
          LET F == CASE flags # Undefined -> Ok(P.s, flags)
                     [] isMatcher -> Ok(P.s, Str(O(P.s, pattern).slots.flags))
                     [] Val(isRegExp) = True -> Get(P.s, pattern, SV("flags"))
                     [] OTHER -> Ok(P.s, Undefined)
          IN IF IsAbrupt(F) THEN F ELSE
          LET o == RegExpAlloc(F.s, newTarget) IN IF IsAbrupt(o) THEN o ELSE RegExpInitialize(o.s, Val(o), Val(P), Val(F))
IsRegExpObject(s, v) == IsObject(v) /\ O(s, v).class = "regexp"
\* RegExpExec (§22.2.7.1).
RegExpExec(s, R, S) ==
  LET exec == Get(s, R, SV("exec")) IN IF IsAbrupt(exec) THEN exec
  ELSE IF IsCallable(exec.s, Val(exec)) THEN
    LET result == Call(exec.s, Val(exec), R, <<S>>) IN
    IF IsAbrupt(result) THEN result
    ELSE IF ~IsObject(Val(result)) /\ Val(result) # Null THEN ThrowTypeError(result.s)
    ELSE result
  ELSE IF ~IsRegExpObject(exec.s, R) THEN ThrowTypeError(exec.s)
  ELSE RegExpBuiltinExec(exec.s, R, S)
\* The characters of a string as RegExpBuiltinExec matches them: its code points when fullUnicode,
\* with the index in the string where each starts, or else its code units.
RxIsPairSecond(units, j) == j > 1 /\ RxIsTrail(units[j]) /\ RxIsLead(units[j - 1])
RxCodePointAt(units, j) ==
  IF j < Len(units) /\ RxIsLead(units[j]) /\ RxIsTrail(units[j + 1])
  THEN UTF16SurrogatePairToCodePoint(units[j], units[j + 1]) ELSE units[j]
RxInput(units, fullUnicode) ==
  IF ~fullUnicode THEN [chars |-> units, starts |-> <<>>]
  ELSE LET starts == SelectSeq([j \in 1..Len(units) |-> j], LAMBDA j : ~RxIsPairSecond(units, j)) IN
       [chars |-> [i \in DOMAIN starts |-> RxCodePointAt(units, starts[i])], starts |-> [i \in DOMAIN starts |-> starts[i] - 1]]
\* The index into the input of the character that holds the code unit at index i.
RxInputIndex(units, fullUnicode, i) ==
  IF ~fullUnicode THEN i
  ELSE i - Cardinality({j \in 1..(IF i + 1 < Len(units) THEN i + 1 ELSE Len(units)) : RxIsPairSecond(units, j)})
\* GetStringIndex (§22.2.7.4).
GetStringIndex(units, input, fullUnicode, e) ==
  CASE ~fullUnicode -> e
    [] e >= Len(input.chars) -> Len(units)
    [] OTHER -> input.starts[e + 1]
\* AdvanceStringIndex (§22.2.7.3), on an integer index and on a Number.
RxAdvanceIndex(units, index, unicode) ==
  IF ~unicode \/ index + 1 >= Len(units) THEN index + 1
  ELSE IF RxIsLead(units[index + 1]) /\ RxIsTrail(units[index + 2]) THEN index + 2 ELSE index + 1
AdvanceStringIndex(units, index, unicode) ==
  IF ~NumLess(NumAdd(index, OneNum), NumFromInt(Len(units))) THEN NumAdd(index, OneNum)
  ELSE NumFromInt(RxAdvanceIndex(units, NumToSmallInt(index), unicode))
\* RegExpBuiltinExec (§22.2.7.2).
RegExpBuiltinExec(s, R, S) ==
  LET li == Get(s, R, SV("lastIndex")) IN IF IsAbrupt(li) THEN li ELSE
  LET len == ToLength(li.s, Val(li)) IN IF IsAbrupt(len) THEN len ELSE
  LET o == O(len.s, R).slots
      units == S.value
      global == 103 \in Range(o.flags)
      sticky == 121 \in Range(o.flags)
      fullUnicode == 117 \in Range(o.flags) \/ 118 \in Range(o.flags)
      input == RxInput(units, fullUnicode)
      lastIndex == IF ~global /\ ~sticky THEN PosZero ELSE Val(len).value
      found == IF NumLess(NumFromInt(Len(units)), lastIndex) THEN None
               ELSE RxExecFrom(o, units, input, fullUnicode, sticky, NumToSmallInt(lastIndex))
  IN IF found = None THEN
       LET r == IF global \/ sticky THEN Set(len.s, R, SV("lastIndex"), IntV(0), TRUE) ELSE Ok(len.s, Undefined) IN
       IF IsAbrupt(r) THEN r ELSE Ok(r.s, Null)
     ELSE LET e == GetStringIndex(units, input, fullUnicode, found.r.e)
              r == IF global \/ sticky THEN Set(len.s, R, SV("lastIndex"), IntV(e), TRUE) ELSE Ok(len.s, Undefined)
              captures == [i \in DOMAIN found.r.cap |->
                             IF found.r.cap[i] = None THEN None
                             ELSE [start |-> GetStringIndex(units, input, fullUnicode, found.r.cap[i][1]),
                                   end |-> GetStringIndex(units, input, fullUnicode, found.r.cap[i][2])]]
          IN IF IsAbrupt(r) THEN r
             ELSE RxMatchResult(UpdateLegacyRegExpStatics(r.s, R, units, found.index, e, captures), o, S,
                                [start |-> found.index, end |-> e], captures)
\* The legacy RegExp features proposal's static properties of %RegExp%, kept in its data slot as a
\* record of strings, each Empty until a match sets it, or Empty for all of them.
LegacyRegExpStatic(d, m) ==
  CASE d = Empty -> Empty
    [] m = "legacyInput" -> d.input
    [] m = "legacyLastMatch" -> d.lastMatch
    [] m = "legacyLastParen" -> d.lastParen
    [] m = "legacyLeftContext" -> d.leftContext
    [] m = "legacyRightContext" -> d.rightContext
    [] OTHER -> d.parens[LegacyRegExpParens[m]]
\* UpdateLegacyRegExpStaticProperties and InvalidateLegacyRegExpStaticProperties, for a match of R
\* in the current realm from start to end with the given captures.
UpdateLegacyRegExpStatics(s, R, units, start, end, captures) ==
  LET o == O(s, R).slots
      C == Intrinsic(s, "RegExp")
      Capture(i) == IF i > Len(captures) \/ captures[i] = None THEN <<>> ELSE SubSeq(units, captures[i].start + 1, captures[i].end)
  IN IF o.realm # s.realmId THEN s
     ELSE SetO(s, C, [O(s, C) EXCEPT !.slots.data =
                        IF ~o.legacy THEN Empty
                        ELSE [input |-> units, lastMatch |-> SubSeq(units, start + 1, end),
                              lastParen |-> IF captures = <<>> THEN <<>> ELSE Capture(Len(captures)),
                              leftContext |-> SubSeq(units, 1, start), rightContext |-> SubSeq(units, end + 1, Len(units)),
                              parens |-> [i \in 1..9 |-> Capture(i)]]])
\* The first index at or after lastIndex where the pattern matches, with its MatchState, or None.
RxExecFrom(o, units, input, fullUnicode, sticky, lastIndex) ==
  IF lastIndex > Len(units) THEN None ELSE
  LET r == RxRun(o.matcher, input.chars, RxInputIndex(units, fullUnicode, lastIndex), Len(o.groups)) IN
  CASE r # MatchFailure -> [index |-> lastIndex, r |-> r]
    [] sticky -> None
    [] OTHER -> RxExecFrom(o, units, input, fullUnicode, sticky, RxAdvanceIndex(units, lastIndex, fullUnicode))
\* The match array of RegExpBuiltinExec from the Match Records of the match and of each capture.
RxMatchResult(s, o, S, match, captures) ==
  LET values == [i \in DOMAIN captures |-> GetMatchString(S, captures[i])]
      a == CreateArrayFromList(s, <<GetMatchString(S, match)>> \o values)
      hasGroups == \E i \in DOMAIN o.groups : o.groups[i].name # None
      groups == RxGroupsObject(a.s, o, values, hasGroups)
      d == 100 \in Range(o.flags)
      indices == IF d THEN MakeMatchIndicesIndexPairArray(groups.s, o, <<match>> \o captures, hasGroups) ELSE Ok(groups.s, Undefined)
      pairs == <<<<SV("index"), IntV(match.start)>>, <<SV("input"), S>>, <<SV("groups"), Val(groups)>>>> \o
               (IF d THEN <<<<SV("indices"), Val(indices)>>>> ELSE <<>>)
  IN Ok(SetO(indices.s, Val(a), WithDataProps(O(indices.s, Val(a)), pairs)), Val(a))
\* GetMatchString (§22.2.7.5), or undefined for a capture that didn't participate.
GetMatchString(S, match) == IF match = None THEN Undefined ELSE Str(SubSeq(S.value, match.start + 1, match.end))
\* The groups object of a match with the value of each capture, or undefined. A name that more than
\* one group has gets the value of the one that participated.
RxGroupsObject(s, o, values, hasGroups) ==
  IF ~hasGroups THEN Ok(s, Undefined)
  ELSE LET a == Alloc(s, MakeObject(Null, "ordinary", [none |-> TRUE])) IN
       Ok(SetO(a.s, a.v, WithDataProps(O(a.s, a.v), RxGroupEntries(o, values))), a.v)
RxGroupEntries(o, values) ==
  LET named == SelectSeq([i \in DOMAIN o.groups |-> i],
                         LAMBDA i : o.groups[i].name # None /\
                                    ~\E j \in 1..(i - 1) : o.groups[j].name = o.groups[i].name /\ values[j] # Undefined)
  IN [i \in DOMAIN named |-> <<Str(o.groups[named[i]].name), values[named[i]]>>]
\* MakeMatchIndicesIndexPairArray (§22.2.7.8).
MakeMatchIndicesIndexPairArray(s, o, indices, hasGroups) ==
  LET pairs == RxIndexPairs(s, indices, 1, <<>>) IN
  LET a == CreateArrayFromList(pairs.s, Val(pairs)) IN
  LET groups == RxGroupsObject(a.s, o, Tail(Val(pairs)), hasGroups) IN
  Ok(SetO(groups.s, Val(a), WithDataProps(O(groups.s, Val(a)), <<<<SV("groups"), Val(groups)>>>>)), Val(a))
\* GetMatchIndexPair (§22.2.7.7) of each Match Record from the ith, or undefined.
RxIndexPairs(s, indices, i, acc) ==
  IF i > Len(indices) THEN Ok(s, acc)
  ELSE IF indices[i] = None THEN RxIndexPairs(s, indices, i + 1, Append(acc, Undefined))
  ELSE LET pair == CreateArrayFromList(s, <<IntV(indices[i].start), IntV(indices[i].end)>>) IN
       RxIndexPairs(pair.s, indices, i + 1, Append(acc, Val(pair)))
\* RegExpHasFlag (§22.2.6.4.1).
RegExpHasFlag(s, R, cu) ==
  CASE ~IsObject(R) -> ThrowTypeError(s)
    [] IsRegExpObject(s, R) -> Ok(s, Bool(cu \in Range(O(s, R).slots.flags)))
    [] SameValue(R, Intrinsic(s, "RegExpPrototype")) -> Ok(s, Undefined)
    [] OTHER -> ThrowTypeError(s)
\* get RegExp.prototype.flags (§22.2.6.4), from the ith getter on.
RxFlagsFrom(s, R, i, acc) ==
  IF i > Len(RegExpPrototypeFlags) THEN Ok(s, Str(acc))
  ELSE LET v == Get(s, R, RegExpPrototypeFlags[i][1]) IN
       IF IsAbrupt(v) THEN v
       ELSE RxFlagsFrom(v.s, R, i + 1, IF ToBooleanValue(Val(v)) THEN Append(acc, RegExpPrototypeFlags[i][2]) ELSE acc)
\* The flag of each flag getter.
RxFlagOf(m) ==
  CASE m = "hasIndices" -> 100 [] m = "global" -> 103 [] m = "ignoreCase" -> 105 [] m = "multiline" -> 109
    [] m = "dotAll" -> 115 [] m = "unicode" -> 117 [] m = "unicodeSets" -> 118 [] OTHER -> 121
\* EscapeRegExpPattern (§22.2.6.13.1), as engine262 escapes: "/" outside a class and line
\* terminators, from index i of the source.
EscapeRegExpPattern(source) == IF source = <<>> THEN N("(?:)") ELSE RxEscapeFrom(source, 1, FALSE, FALSE, <<>>)
RxEscapeFrom(source, i, inClass, isEscape, acc) ==
  IF i > Len(source) THEN acc ELSE
  LET c == source[i] IN
  CASE c = 92 /\ i < Len(source) /\ RxIsLineTerminator(source[i + 1]) -> RxEscapeFrom(source, i + 1, inClass, isEscape, acc)
    [] c = 92 -> RxEscapeFrom(source, i + 1, inClass, ~isEscape, Append(acc, 92))
    [] c = 47 -> RxEscapeFrom(source, i + 1, inClass, FALSE, acc \o (IF inClass \/ isEscape THEN <<47>> ELSE N("\\/")))
    [] c = 91 -> RxEscapeFrom(source, i + 1, inClass \/ ~isEscape, FALSE, Append(acc, 91))
    [] c = 93 -> RxEscapeFrom(source, i + 1, inClass /\ isEscape, FALSE, Append(acc, 93))
    [] c = 10 -> RxEscapeFrom(source, i + 1, inClass, FALSE, acc \o N("\\n"))
    [] c = 13 -> RxEscapeFrom(source, i + 1, inClass, FALSE, acc \o N("\\r"))
    [] c = 8232 -> RxEscapeFrom(source, i + 1, inClass, FALSE, acc \o N("\\u2028"))
    [] c = 8233 -> RxEscapeFrom(source, i + 1, inClass, FALSE, acc \o N("\\u2029"))
    [] OTHER -> RxEscapeFrom(source, i + 1, inClass, FALSE, Append(acc, c))
\* RegExp.prototype[@@match] (§22.2.6.8) from the nth match on, with global set.
RxMatchAll(s, rx, S, fullUnicode, A, n) ==
  LET result == RegExpExec(s, rx, S) IN IF IsAbrupt(result) THEN result
  ELSE IF Val(result) = Null THEN Ok(result.s, IF n = 0 THEN Null ELSE A)
  ELSE LET matchStr == RxGetString(result.s, Val(result), SV("0")) IN IF IsAbrupt(matchStr) THEN matchStr ELSE
       LET c == CreateDataPropertyOrThrow(matchStr.s, A, Index(NumFromInt(n)), Val(matchStr)) IN
       LET advanced == IF Val(matchStr) = EmptyStr THEN RxAdvanceLastIndex(c.s, rx, S, fullUnicode) ELSE Ok(c.s, Undefined) IN
       IF IsAbrupt(advanced) THEN advanced ELSE RxMatchAll(advanced.s, rx, S, fullUnicode, A, n + 1)
\* ? ToString(? Get(o, k)).
RxGetString(s, o, k) == LET v == Get(s, o, k) IN IF IsAbrupt(v) THEN v ELSE ToStr(v.s, Val(v))
\* Sets lastIndex past an empty match: thisIndex, AdvanceStringIndex, and Set.
RxAdvanceLastIndex(s, rx, S, fullUnicode) ==
  LET li == Get(s, rx, SV("lastIndex")) IN IF IsAbrupt(li) THEN li ELSE
  LET thisIndex == ToLength(li.s, Val(li)) IN IF IsAbrupt(thisIndex) THEN thisIndex
  ELSE Set(thisIndex.s, rx, SV("lastIndex"), Num(AdvanceStringIndex(S.value, Val(thisIndex).value, fullUnicode)), TRUE)
\* The flags of a RegExp object as a string, and whether they make it match code points.
RxFlagsString(s, rx) == RxGetString(s, rx, SV("flags"))
RxFullUnicode(flags) == 117 \in Range(flags.value) \/ 118 \in Range(flags.value)
\* RegExp.prototype[@@replace] (§22.2.6.11): the results of RegExpExec.
RxReplaceResults(s, rx, S, global, fullUnicode, results) ==
  LET result == RegExpExec(s, rx, S) IN IF IsAbrupt(result) THEN result
  ELSE IF Val(result) = Null THEN Ok(result.s, results)
  ELSE IF ~global THEN Ok(result.s, Append(results, Val(result)))
  ELSE LET matchStr == RxGetString(result.s, Val(result), SV("0")) IN IF IsAbrupt(matchStr) THEN matchStr ELSE
       LET advanced == IF Val(matchStr) = EmptyStr THEN RxAdvanceLastIndex(matchStr.s, rx, S, fullUnicode) ELSE Ok(matchStr.s, Undefined) IN
       IF IsAbrupt(advanced) THEN advanced ELSE RxReplaceResults(advanced.s, rx, S, global, fullUnicode, Append(results, Val(result)))
\* The replacements of the results from the ith on, with nextSourcePosition next.
RxReplaceFrom(s, S, replaceValue, functional, results, i, acc, next) ==
  IF i > Len(results) THEN
    Ok(s, Str(IF next >= Len(S.value) THEN acc ELSE acc \o SubSeq(S.value, next + 1, Len(S.value))))
  ELSE
    LET result == results[i] IN
    LET length == LengthOfArrayLike(s, result) IN IF IsAbrupt(length) THEN length ELSE
    LET matched == RxGetString(length.s, result, SV("0")) IN IF IsAbrupt(matched) THEN matched ELSE
    LET index == Get(matched.s, result, SV("index")) IN IF IsAbrupt(index) THEN index ELSE
    LET pos == ToIntegerOrInfinity(index.s, Val(index)) IN IF IsAbrupt(pos) THEN pos ELSE
    LET position == CASE NumLess(Val(pos).value, PosZero) -> 0
                      [] NumLess(NumFromInt(Len(S.value)), Val(pos).value) -> Len(S.value)
                      [] OTHER -> NumToSmallInt(NumAdd(Val(pos).value, PosZero))
        captures == RxResultCaptures(pos.s, result, Val(length).value, 1, <<>>)
    IN IF IsAbrupt(captures) THEN captures ELSE
    LET named == Get(captures.s, result, SV("groups")) IN IF IsAbrupt(named) THEN named ELSE
    LET replacement ==
          IF functional THEN
            LET replValue == Call(named.s, replaceValue, Undefined,
                                  <<Val(matched)>> \o Val(captures) \o <<IntV(position), S>> \o
                                  (IF Val(named) = Undefined THEN <<>> ELSE <<Val(named)>>))
            IN IF IsAbrupt(replValue) THEN replValue ELSE ToStr(replValue.s, Val(replValue))
          ELSE
            LET namedObject == IF Val(named) = Undefined THEN Ok(named.s, Undefined) ELSE ToObject(named.s, Val(named)) IN
            IF IsAbrupt(namedObject) THEN namedObject
            ELSE GetSubstitution(namedObject.s, Val(matched).value, S.value, position, Val(captures), Val(namedObject),
                                 replaceValue.value, <<>>)
    IN IF IsAbrupt(replacement) THEN replacement
       ELSE IF position >= next
       THEN RxReplaceFrom(replacement.s, S, replaceValue, functional, results, i + 1,
                          acc \o SubSeq(S.value, next + 1, position) \o Val(replacement).value, position + Len(Val(matched).value))
       ELSE RxReplaceFrom(replacement.s, S, replaceValue, functional, results, i + 1, acc, next)
\* The captures of a result from the nth, up to resultLength - 1, each a String or undefined.
RxResultCaptures(s, result, resultLength, n, acc) ==
  IF ~NumLess(NumFromInt(n), resultLength) THEN Ok(s, acc)
  ELSE LET capN == Get(s, result, Index(NumFromInt(n))) IN IF IsAbrupt(capN) THEN capN ELSE
       LET value == IF Val(capN) = Undefined THEN capN ELSE ToStr(capN.s, Val(capN)) IN
       IF IsAbrupt(value) THEN value ELSE RxResultCaptures(value.s, result, resultLength, n + 1, Append(acc, Val(value)))
\* RegExp.prototype[@@split] (§22.2.6.14), from q with the last split at p.
RxSplitFrom(s, splitter, S, unicodeMatching, A, lengthA, lim, p, q) ==
  LET size == Len(S.value) IN
  IF q >= size THEN
       LET c == CreateDataProperty(s, A, Index(NumFromInt(lengthA)), Str(SubSeq(S.value, p + 1, size))) IN
       IF IsAbrupt(c) THEN c ELSE Ok(c.s, A)
     ELSE
       LET set == Set(s, splitter, SV("lastIndex"), IntV(q), TRUE) IN IF IsAbrupt(set) THEN set ELSE
       LET z == RegExpExec(set.s, splitter, S) IN IF IsAbrupt(z) THEN z
       ELSE IF Val(z) = Null THEN RxSplitFrom(z.s, splitter, S, unicodeMatching, A, lengthA, lim, p, RxAdvanceIndex(S.value, q, unicodeMatching))
       ELSE LET li == Get(z.s, splitter, SV("lastIndex")) IN IF IsAbrupt(li) THEN li ELSE
            LET el == ToLength(li.s, Val(li)) IN IF IsAbrupt(el) THEN el ELSE
            LET e == IF NumLess(NumFromInt(size), Val(el).value) THEN size ELSE NumToSmallInt(Val(el).value) IN
            IF e = p THEN RxSplitFrom(el.s, splitter, S, unicodeMatching, A, lengthA, lim, p, RxAdvanceIndex(S.value, q, unicodeMatching))
            ELSE LET c == CreateDataProperty(el.s, A, Index(NumFromInt(lengthA)), Str(SubSeq(S.value, p + 1, q))) IN
                 IF IsAbrupt(c) THEN c
                 ELSE IF NumFromInt(lengthA + 1) = lim THEN Ok(c.s, A)
                 ELSE LET n == LengthOfArrayLike(c.s, Val(z)) IN IF IsAbrupt(n) THEN n
                 ELSE RxSplitCaptures(n.s, splitter, S, unicodeMatching, A, lengthA + 1, lim, e, Val(z), Val(n).value, 1)
\* Adds the captures of z from the ith, up to numberOfCaptures, then splits on from e.
RxSplitCaptures(s, splitter, S, unicodeMatching, A, lengthA, lim, e, z, resultLength, i) ==
  IF ~NumLess(NumFromInt(i), resultLength) THEN RxSplitFrom(s, splitter, S, unicodeMatching, A, lengthA, lim, e, e)
  ELSE LET capture == Get(s, z, Index(NumFromInt(i))) IN IF IsAbrupt(capture) THEN capture ELSE
       LET c == CreateDataProperty(capture.s, A, Index(NumFromInt(lengthA)), Val(capture)) IN
       IF IsAbrupt(c) THEN c
       ELSE IF NumFromInt(lengthA + 1) = lim THEN Ok(c.s, A)
       ELSE RxSplitCaptures(c.s, splitter, S, unicodeMatching, A, lengthA + 1, lim, e, z, resultLength, i + 1)
\* CreateRegExpStringIterator (§22.2.9.1).
CreateRegExpStringIterator(s, R, S, global, fullUnicode) ==
  LET a == Alloc(s, MakeObject(Intrinsic(s, "RegExpStringIteratorPrototype"), "regexpStringIterator",
                               [r |-> R, str |-> S, global |-> global, unicode |-> fullUnicode, done |-> FALSE, running |-> FALSE]))
  IN Ok(a.s, a.v)
\* %RegExpStringIteratorPrototype%.next (§22.2.9.2.1): GeneratorResume of the iterator's closure.
RegExpStringIteratorNext(s, it) ==
  IF ~IsObject(it) \/ O(s, it).class # "regexpStringIterator" THEN ThrowTypeError(s) ELSE
  LET o == O(s, it).slots IN
  IF o.running THEN ThrowTypeError(s)
  ELSE IF o.done THEN CreateIterResultObject(s, Undefined, TRUE)
  ELSE LET r == RxIteratorStep(SetO(s, it, [O(s, it) EXCEPT !.slots.running = TRUE]), o) IN
       IF IsAbrupt(r) THEN Abrupt(SetO(r.s, it, [O(r.s, it) EXCEPT !.slots.done = TRUE, !.slots.running = FALSE]), r.c)
       ELSE CreateIterResultObject(SetO(r.s, it, [O(r.s, it) EXCEPT !.slots.done = Val(r) = Null \/ ~o.global, !.slots.running = FALSE]),
                                   IF Val(r) = Null THEN Undefined ELSE Val(r), Val(r) = Null)
\* The closure's steps up to its next Yield: the match, or null when it returns.
RxIteratorStep(s, o) ==
  LET match == RegExpExec(s, o.r, o.str) IN
  IF IsAbrupt(match) \/ Val(match) = Null \/ ~o.global THEN match
  ELSE LET matchStr == RxGetString(match.s, Val(match), SV("0")) IN IF IsAbrupt(matchStr) THEN matchStr ELSE
       LET advanced == IF Val(matchStr) = EmptyStr THEN RxAdvanceLastIndex(matchStr.s, o.r, o.str, o.unicode) ELSE Ok(matchStr.s, Undefined) IN
       IF IsAbrupt(advanced) THEN advanced ELSE Ok(advanced.s, Val(match))
\* RegExp.escape (§22.2.5.1) and EncodeForRegExpEscape (§22.2.5.1.1).
RxHex(n, width) ==
  LET digit(d) == IF d < 10 THEN 48 + d ELSE 87 + d IN
  IF width = 0 THEN <<>> ELSE Append(RxHex(n \div 16, width - 1), digit(n % 16))
RxEscapeCodePoints(cps, i, acc) ==
  IF i > Len(cps) THEN acc ELSE
  LET c == cps[i] IN
  CASE acc = <<>> /\ (RxIsDigit(c) \/ RxIsAsciiLetter(c)) -> RxEscapeCodePoints(cps, i + 1, N("\\x") \o RxHex(c, 2))
    [] OTHER -> RxEscapeCodePoints(cps, i + 1, acc \o EncodeForRegExpEscape(c))
EncodeForRegExpEscape(c) ==
  CASE c = 47 \/ c \in RxSyntaxCharacters -> <<92>> \o UTF16EncodeCodePoint(c)
    [] c \in 9..13 -> <<92, CASE c = 9 -> 116 [] c = 10 -> 110 [] c = 11 -> 118 [] c = 12 -> 102 [] OTHER -> 114>>
    [] c \in Range(N(",-=<>#&!%:;@~'`\"")) \/ RxIsWhiteSpace(c) \/ RxIsLineTerminator(c) \/ (c >= 55296 /\ c <= 57343) ->
         IF c <= 255 THEN N("\\x") \o RxHex(c, 2)
         ELSE FoldLeftSeq([i \in DOMAIN UTF16EncodeCodePoint(c) |-> N("\\u") \o RxHex(UTF16EncodeCodePoint(c)[i], 4)])
    [] OTHER -> UTF16EncodeCodePoint(c)
RegExpBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1)
      a2 == Arg(args, 2)
  IN
  CASE m = "constructor" -> RegExpConstructor(s, f, a1, a2, nt)
    \* get RegExp[@@species] (§22.2.5.2).
    [] m = "species" -> Ok(s, this)
    \* GetLegacyRegExpStaticProperty and SetLegacyRegExpStaticProperty, of the legacy RegExp features proposal.
    [] m \in {"legacyInput", "legacyLastMatch", "legacyLastParen", "legacyLeftContext", "legacyRightContext"} \cup
              DOMAIN LegacyRegExpParens ->
         LET value == LegacyRegExpStatic(O(s, Intrinsic(s, "RegExp")).slots.data, m) IN
         IF ~SameValue(this, Intrinsic(s, "RegExp")) \/ value = Empty THEN ThrowTypeError(s) ELSE Ok(s, Str(value))
    [] m = "legacySetInput" ->
         IF ~SameValue(this, Intrinsic(s, "RegExp")) THEN ThrowTypeError(s) ELSE
         LET v == ToStr(s, a1) IN IF IsAbrupt(v) THEN v ELSE
         LET C == Intrinsic(v.s, "RegExp")
             d == O(v.s, C).slots.data
         IN Ok(SetO(v.s, C, [O(v.s, C) EXCEPT !.slots.data = [(IF d = Empty THEN LegacyRegExpNone ELSE d) EXCEPT !.input = Val(v).value]]),
               Undefined)
    [] m = "escape" -> IF ~IsString(a1) THEN ThrowTypeError(s) ELSE Ok(s, Str(RxEscapeCodePoints(StringToCodePoints(a1.value, 0, <<>>), 1, <<>>)))
    \* RegExp.prototype.exec (§22.2.6.2).
    [] m = "exec" ->
         IF ~IsRegExpObject(s, this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE RegExpBuiltinExec(S.s, this, Val(S))
    \* RegExp.prototype.compile (§B.2.4.1), with the legacy RegExp features proposal's realm and subclass checks.
    [] m = "compile" ->
         IF ~IsRegExpObject(s, this) THEN ThrowTypeError(s)
         ELSE IF O(s, this).slots.realm # s.realmId \/ ~O(s, this).slots.legacy THEN ThrowTypeError(s)
         ELSE IF ~IsRegExpObject(s, a1) THEN RegExpInitialize(s, this, a1, a2)
         ELSE IF a2 # Undefined THEN ThrowTypeError(s)
         ELSE RegExpInitialize(s, this, Str(O(s, a1).slots.source), Str(O(s, a1).slots.flags))
    \* get RegExp.prototype.flags (§22.2.6.4).
    [] m = "flags" -> IF ~IsObject(this) THEN ThrowTypeError(s) ELSE RxFlagsFrom(s, this, 1, <<>>)
    \* get RegExp.prototype.source (§22.2.6.13).
    [] m = "source" ->
         CASE ~IsObject(this) -> ThrowTypeError(s)
           [] IsRegExpObject(s, this) -> Ok(s, Str(EscapeRegExpPattern(O(s, this).slots.source)))
           [] SameValue(this, Intrinsic(s, "RegExpPrototype")) -> Ok(s, SV("(?:)"))
           [] OTHER -> ThrowTypeError(s)
    \* get RegExp.prototype.hasIndices, global, ignoreCase, multiline, dotAll, unicode, unicodeSets,
    \* and sticky (§22.2.6.3 to §22.2.6.18).
    [] m \in {"hasIndices", "global", "ignoreCase", "multiline", "dotAll", "unicode", "unicodeSets", "sticky"} ->
         RegExpHasFlag(s, this, RxFlagOf(m))
    \* RegExp.prototype.test (§22.2.6.16).
    [] m = "test" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE
              LET match == RegExpExec(S.s, this, Val(S)) IN IF IsAbrupt(match) THEN match ELSE Ok(match.s, Bool(Val(match) # Null))
    \* RegExp.prototype.toString (§22.2.6.17).
    [] m = "toString" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET pattern == RxGetString(s, this, SV("source")) IN IF IsAbrupt(pattern) THEN pattern ELSE
              LET flags == RxFlagsString(pattern.s, this) IN IF IsAbrupt(flags) THEN flags
              ELSE Ok(flags.s, Str(<<47>> \o Val(pattern).value \o <<47>> \o Val(flags).value))
    \* RegExp.prototype[@@match] (§22.2.6.8).
    [] m = "match" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE
              LET flags == RxFlagsString(S.s, this) IN IF IsAbrupt(flags) THEN flags
              ELSE IF 103 \notin Range(Val(flags).value) THEN RegExpExec(flags.s, this, Val(S))
              ELSE LET set == Set(flags.s, this, SV("lastIndex"), IntV(0), TRUE) IN IF IsAbrupt(set) THEN set ELSE
                   LET A == ArrayCreate(set.s, 0, Intrinsic(set.s, "ArrayPrototype")) IN
                   RxMatchAll(A.s, this, Val(S), RxFullUnicode(Val(flags)), Val(A), 0)
    \* RegExp.prototype[@@matchAll] (§22.2.6.9).
    [] m = "matchAll" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE
              LET C == SpeciesConstructor(S.s, this, Intrinsic(S.s, "RegExp")) IN IF IsAbrupt(C) THEN C ELSE
              LET flags == RxFlagsString(C.s, this) IN IF IsAbrupt(flags) THEN flags ELSE
              LET matcher == Construct(flags.s, Val(C), <<this, Val(flags)>>, Val(C)) IN IF IsAbrupt(matcher) THEN matcher ELSE
              LET li == Get(matcher.s, this, SV("lastIndex")) IN IF IsAbrupt(li) THEN li ELSE
              LET lastIndex == ToLength(li.s, Val(li)) IN IF IsAbrupt(lastIndex) THEN lastIndex ELSE
              LET set == Set(lastIndex.s, Val(matcher), SV("lastIndex"), Val(lastIndex), TRUE) IN IF IsAbrupt(set) THEN set
              ELSE CreateRegExpStringIterator(set.s, Val(matcher), Val(S), 103 \in Range(Val(flags).value), RxFullUnicode(Val(flags)))
    \* RegExp.prototype[@@replace] (§22.2.6.11).
    [] m = "replace" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE
              LET functional == IsCallable(S.s, a2)
                  replaceValue == IF functional THEN Ok(S.s, a2) ELSE ToStr(S.s, a2)
              IN IF IsAbrupt(replaceValue) THEN replaceValue ELSE
              LET flags == RxFlagsString(replaceValue.s, this) IN IF IsAbrupt(flags) THEN flags ELSE
              LET global == 103 \in Range(Val(flags).value)
                  set == IF global THEN Set(flags.s, this, SV("lastIndex"), IntV(0), TRUE) ELSE Ok(flags.s, Undefined)
              IN IF IsAbrupt(set) THEN set ELSE
              LET results == RxReplaceResults(set.s, this, Val(S), global, RxFullUnicode(Val(flags)), <<>>) IN
              IF IsAbrupt(results) THEN results
              ELSE RxReplaceFrom(results.s, Val(S), Val(replaceValue), functional, Val(results), 1, <<>>, 0)
    \* RegExp.prototype[@@search] (§22.2.6.12).
    [] m = "search" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE
              LET previous == Get(S.s, this, SV("lastIndex")) IN IF IsAbrupt(previous) THEN previous ELSE
              LET reset == IF SameValue(Val(previous), IntV(0)) THEN Ok(previous.s, Undefined)
                           ELSE Set(previous.s, this, SV("lastIndex"), IntV(0), TRUE)
              IN IF IsAbrupt(reset) THEN reset ELSE
              LET result == RegExpExec(reset.s, this, Val(S)) IN IF IsAbrupt(result) THEN result ELSE
              LET current == Get(result.s, this, SV("lastIndex")) IN IF IsAbrupt(current) THEN current ELSE
              LET restore == IF SameValue(Val(current), Val(previous)) THEN Ok(current.s, Undefined)
                             ELSE Set(current.s, this, SV("lastIndex"), Val(previous), TRUE)
              IN IF IsAbrupt(restore) THEN restore
              ELSE IF Val(result) = Null THEN Ok(restore.s, IntV(-1))
              ELSE Get(restore.s, Val(result), SV("index"))
    \* RegExp.prototype[@@split] (§22.2.6.14).
    [] m = "split" ->
         IF ~IsObject(this) THEN ThrowTypeError(s)
         ELSE LET S == ToStr(s, a1) IN IF IsAbrupt(S) THEN S ELSE
              LET C == SpeciesConstructor(S.s, this, Intrinsic(S.s, "RegExp")) IN IF IsAbrupt(C) THEN C ELSE
              LET flags == RxFlagsString(C.s, this) IN IF IsAbrupt(flags) THEN flags ELSE
              LET newFlags == IF 121 \in Range(Val(flags).value) THEN Val(flags) ELSE Str(Append(Val(flags).value, 121))
                  splitter == Construct(flags.s, Val(C), <<this, newFlags>>, Val(C))
              IN IF IsAbrupt(splitter) THEN splitter ELSE
              LET A == ArrayCreate(splitter.s, 0, Intrinsic(splitter.s, "ArrayPrototype")) IN
              LET lim == IF a2 = Undefined THEN Ok(A.s, Num(NumFromBigNat(FALSE, BNSub(BNPow2(32), <<1>>), 0))) ELSE ToUint32(A.s, a2) IN
              IF IsAbrupt(lim) THEN lim
              ELSE IF Val(lim).value = PosZero THEN Ok(lim.s, Val(A))
              ELSE IF Val(S) = EmptyStr THEN
                LET z == RegExpExec(lim.s, Val(splitter), Val(S)) IN IF IsAbrupt(z) THEN z
                ELSE IF Val(z) # Null THEN Ok(z.s, Val(A))
                ELSE LET c == CreateDataProperty(z.s, Val(A), SV("0"), Val(S)) IN IF IsAbrupt(c) THEN c ELSE Ok(c.s, Val(A))
              ELSE RxSplitFrom(lim.s, Val(splitter), Val(S), RxFullUnicode(Val(flags)), Val(A), 0, Val(lim).value, 0, 0)
    [] m = "iteratorNext" -> RegExpStringIteratorNext(s, this)
\* The Atomics object (§25.4) for a single agent. No other agent shares a block, so every
\* operation is atomic as it stands, and only this agent's asynchronous waits wait on a waiter
\* list. The state's canSuspend is AgentCanSuspend().
\* ValidateIntegerTypedArray (§25.4.3.1), with the length as the value, for an access that writes
\* or only reads.
ValidateIntegerTypedArray(s, ta, waitable, isWrite) ==
  LET v == IF isWrite THEN ValidateTypedArrayForWrite(s, ta) ELSE ValidateTypedArray(s, ta) IN
  IF IsAbrupt(v) THEN v
  ELSE LET type == TypedArrayType(s, ta) IN
  IF ~IsUnclampedIntegerElementType(type) /\ ~IsBigIntElementType(type) THEN ThrowTypeError(s)
  ELSE IF waitable /\ type \notin {"int32", "bigint64"} THEN ThrowTypeError(s)
  ELSE v
\* ValidateAtomicAccess (§25.4.3.2): the byte index of requestIndex in the buffer.
ValidateAtomicAccess(s, ta, length, requestIndex) ==
  LET i == ToIndex(s, requestIndex) IN
  IF IsAbrupt(i) THEN i
  ELSE IF ~NumLess(Val(i).value, NumFromInt(length)) THEN ThrowError(i.s, "RangeError")
  ELSE Ok(i.s, NumToSmallInt(Val(i).value) * TypedArraySize(i.s, ta) + O(i.s, ta).slots.byteOffset)
\* ValidateAtomicAccessOnIntegerTypedArray (§25.4.3.3).
ValidateAtomicAccessOnIntegerTypedArray(s, ta, requestIndex, isWrite) ==
  LET v == ValidateIntegerTypedArray(s, ta, FALSE, isWrite) IN
  IF IsAbrupt(v) THEN v ELSE ValidateAtomicAccess(v.s, ta, Val(v), requestIndex)
\* RevalidateAtomicAccess (§25.4.3.4).
RevalidateAtomicAccess(s, ta, byteIndex) ==
  LET v == ValidateTypedArrayBounds(s, ta) IN
  IF IsAbrupt(v) THEN v
  ELSE IF byteIndex + TypedArraySize(s, ta) - 1 >= ArrayBufferByteLength(s, O(s, ta).slots.buffer)
  THEN ThrowError(s, "RangeError")
  ELSE v
\* An Atomics value argument as the TypedArray's content type: a BigInt, or
\* 𝔽(ToIntegerOrInfinity(v)).
AtomicValue(s, ta, v) == IF IsBigIntTypedArray(s, ta) THEN ToBigInt(s, v) ELSE ToIntegerOrInfinity(s, v)
\* The read-modify-write modification functions of add, and, exchange, or, sub, and xor.
AtomicModify(op, type, xBytes, yBytes) ==
  CASE op = "exchange" -> yBytes
    [] op \in {"and", "or", "xor"} ->
         LET bitwise == CASE op = "and" -> "&" [] op = "or" -> "|" [] op = "xor" -> "^"
         IN [i \in DOMAIN xBytes |-> SmallBitwise(bitwise, xBytes[i], yBytes[i], 1)]
    [] OTHER ->
         LET x == RawBytesToNumeric(type, xBytes, LittleEndian)
             y == RawBytesToNumeric(type, yBytes, LittleEndian)
             result == CASE IsBigInt(x) /\ op = "add" -> BigInt(BigIntAdd(x.value, y.value))
                         [] IsBigInt(x) -> BigInt(BigIntSub(x.value, y.value))
                         [] op = "add" -> Num(NumAdd(x.value, y.value))
                         [] OTHER -> Num(NumSub(x.value, y.value))
         IN NumericToRawBytes(type, result, LittleEndian)
\* AtomicReadModifyWrite (§25.4.3.17) with GetModifySetValueInBuffer (§25.1.3.19).
AtomicReadModifyWrite(s, ta, index, value, op) ==
  LET byteIndex == ValidateAtomicAccessOnIntegerTypedArray(s, ta, index, TRUE) IN IF IsAbrupt(byteIndex) THEN byteIndex ELSE
  LET v == AtomicValue(byteIndex.s, ta, value) IN IF IsAbrupt(v) THEN v ELSE
  LET r == RevalidateAtomicAccess(v.s, ta, Val(byteIndex)) IN IF IsAbrupt(r) THEN r ELSE
  LET buffer == O(r.s, ta).slots.buffer
      type == TypedArrayType(r.s, ta)
      read == BufferBytes(r.s, buffer, Val(byteIndex), ElementSize(type))
      modified == AtomicModify(op, type, read, NumericToRawBytes(type, Val(v), LittleEndian))
  IN Ok(SetBufferBytes(r.s, buffer, Val(byteIndex), modified), RawBytesToNumeric(type, read, LittleEndian))
\* DoWait (§25.4.3.14). The state's waiters holds the Waiter Records of the asynchronous waits,
\* [buffer, byteIndex, capability, deadline] in the order they began, with deadline the Number
\* time they time out at or Empty. A synchronous wait suspends the agent until it times out, so
\* it never ends when its timeout is infinite, since no agent is left to notify it.
DoWait(s, mode, ta, index, value, timeout) ==
  LET v == ValidateIntegerTypedArray(s, ta, TRUE, FALSE) IN IF IsAbrupt(v) THEN v ELSE
  LET buffer == O(v.s, ta).slots.buffer IN
  IF ~IsSharedArrayBuffer(v.s, buffer) THEN ThrowTypeError(v.s)
  ELSE LET byteIndex == ValidateAtomicAccess(v.s, ta, Val(v), index) IN IF IsAbrupt(byteIndex) THEN byteIndex ELSE
  LET type == TypedArrayType(byteIndex.s, ta)
      expected == IF type = "bigint64" THEN ToBigInt(byteIndex.s, value) ELSE ToInt32(byteIndex.s, value)
  IN IF IsAbrupt(expected) THEN expected ELSE
     LET t == ToNumber(expected.s, timeout) IN IF IsAbrupt(t) THEN t
     ELSE IF mode = "sync" /\ ~t.s.canSuspend THEN ThrowTypeError(t.s) ELSE
     LET timeoutNumber == Val(t).value
         isInfinite == NumIsNaN(timeoutNumber) \/ timeoutNumber = PosInf
         isZero == timeoutNumber.neg \/ NumIsZero(timeoutNumber)
         deadline == IF isInfinite THEN Empty ELSE NumAdd(SystemTime(t.s), IF isZero THEN PosZero ELSE timeoutNumber)
         cap == IF mode = "sync" THEN Ok(t.s, Empty) ELSE NewPromiseCapability(t.s, Intrinsic(t.s, "Promise"))
         expectedValue == IF type = "bigint64" THEN BigInt(BigIntFromBits64(BigInt64Bits(Val(expected).value)))
                          ELSE Val(expected)
         witness == GetValueFromBuffer(cap.s, buffer, Val(byteIndex), type, LittleEndian)
         result(rs, isAsync, outcome) ==
           IF mode = "sync" THEN Ok(rs, outcome)
           ELSE LET o == OrdinaryObjectCreate(rs, Intrinsic(rs, "ObjectPrototype"))
                IN Ok(SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), <<<<SV("async"), isAsync>>, <<SV("value"), outcome>>>>)),
                      Val(o))
     IN IF expectedValue # witness THEN result(cap.s, False, SV("not-equal"))
        ELSE IF mode = "async" /\ isZero THEN result(cap.s, False, SV("timed-out"))
        ELSE IF mode = "async" THEN
          result([cap.s EXCEPT !.waiters = Append(@, [buffer |-> buffer, byteIndex |-> Val(byteIndex),
                                                      capability |-> Val(cap), deadline |-> deadline])],
                 True, Val(cap).promise)
        ELSE IF isInfinite THEN Unsupported(t.s, N("Unsupported: Atomics.wait with no agent to notify it"))
        ELSE result(PassTime(t.s, deadline), False, SV("timed-out"))
\* The state with the clock moved on to time, when time is later and the clock can hold it.
PassTime(s, time) ==
  IF NumLess(SystemTime(s), time) /\ NumLess(time, NumFromInt(IntLimit))
  THEN [s EXCEPT !.clock = NumToSmallInt(MathCeil(time))]
  ELSE s
\* NotifyWaiter (§25.4.3.12) for each of waiters, which wait in this agent.
ResolveWaiters(s, waiters, outcome) ==
  IF waiters = <<>> THEN s
  ELSE ResolveWaiters(Call(s, Head(waiters).capability.resolve, Undefined, <<outcome>>).s, Tail(waiters), outcome)
\* RemoveWaiters (§25.4.3.10) and NotifyWaiter for the waiters on a location: [s, count] with
\* count how many of them it woke, at most the Number limit.
NotifyWaiters(s, buffer, byteIndex, limit) ==
  LET at == SelectSeq(s.waiters, LAMBDA w : w.buffer = buffer /\ w.byteIndex = byteIndex)
      count == CASE limit.neg -> 0
                 [] NumLess(limit, NumFromInt(Len(at))) -> NumToSmallInt(limit)
                 [] OTHER -> Len(at)
      woken == SubSeq(at, 1, count)
  IN [s |-> ResolveWaiters([s EXCEPT !.waiters = SelectSeq(@, LAMBDA w : w \notin Range(woken))], woken, SV("ok")),
      count |-> count]
\* The job of EnqueueAtomicsWaitAsyncTimeoutJob (§25.4.3.15) that the host runs first once no
\* other job is left: the one for the waiter with the earliest deadline, which began first.
TimeOutWaiter(s) ==
  LET timed == {i \in DOMAIN s.waiters : s.waiters[i].deadline # Empty}
      first == CHOOSE i \in timed : \A j \in timed : NumLess(s.waiters[i].deadline, s.waiters[j].deadline)
                                                    \/ (s.waiters[i].deadline = s.waiters[j].deadline /\ i <= j)
      w == s.waiters[first]
  IN ResolveWaiters(PassTime([s EXCEPT !.waiters = SelectSeq(@, LAMBDA x : x # w)], w.deadline), <<w>>, SV("timed-out"))
\* The Atomics functions (§25.4.4 to §25.4.17).
AtomicsBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1)
      a2 == Arg(args, 2)
      a3 == Arg(args, 3)
  IN
  CASE m = "isLockFree" ->
         LET n == ToIntegerOrInfinity(s, a1) IN IF IsAbrupt(n) THEN n
         ELSE Ok(n.s, Bool(\E size \in {1, 2, 4, 8} : Val(n).value = NumFromInt(size)))
    [] m = "pause" -> Ok(s, Undefined)
    [] m = "compareExchange" ->
         LET byteIndex == ValidateAtomicAccessOnIntegerTypedArray(s, a1, a2, TRUE) IN IF IsAbrupt(byteIndex) THEN byteIndex ELSE
         LET expected == AtomicValue(byteIndex.s, a1, a3) IN IF IsAbrupt(expected) THEN expected ELSE
         LET replacement == AtomicValue(expected.s, a1, Arg(args, 4)) IN IF IsAbrupt(replacement) THEN replacement ELSE
         LET r == RevalidateAtomicAccess(replacement.s, a1, Val(byteIndex)) IN IF IsAbrupt(r) THEN r ELSE
         LET buffer == O(r.s, a1).slots.buffer
             type == TypedArrayType(r.s, a1)
             read == BufferBytes(r.s, buffer, Val(byteIndex), ElementSize(type))
         IN Ok(IF read = NumericToRawBytes(type, Val(expected), LittleEndian)
               THEN SetBufferBytes(r.s, buffer, Val(byteIndex), NumericToRawBytes(type, Val(replacement), LittleEndian))
               ELSE r.s,
               RawBytesToNumeric(type, read, LittleEndian))
    [] m = "load" ->
         LET byteIndex == ValidateAtomicAccessOnIntegerTypedArray(s, a1, a2, FALSE) IN IF IsAbrupt(byteIndex) THEN byteIndex ELSE
         LET r == RevalidateAtomicAccess(byteIndex.s, a1, Val(byteIndex)) IN IF IsAbrupt(r) THEN r
         ELSE Ok(r.s, GetValueFromBuffer(r.s, O(r.s, a1).slots.buffer, Val(byteIndex), TypedArrayType(r.s, a1), LittleEndian))
    [] m = "store" ->
         LET byteIndex == ValidateAtomicAccessOnIntegerTypedArray(s, a1, a2, TRUE) IN IF IsAbrupt(byteIndex) THEN byteIndex ELSE
         LET v == AtomicValue(byteIndex.s, a1, a3) IN IF IsAbrupt(v) THEN v ELSE
         LET r == RevalidateAtomicAccess(v.s, a1, Val(byteIndex)) IN IF IsAbrupt(r) THEN r
         ELSE Ok(SetValueInBuffer(r.s, O(r.s, a1).slots.buffer, Val(byteIndex), TypedArrayType(r.s, a1), Val(v), LittleEndian),
                 Val(v))
    \* Atomics.notify (§25.4.12): the waiter list is empty, so it notifies no agent.
    [] m = "notify" ->
         LET v == ValidateIntegerTypedArray(s, a1, TRUE, FALSE) IN IF IsAbrupt(v) THEN v ELSE
         LET byteIndex == ValidateAtomicAccess(v.s, a1, Val(v), a2) IN IF IsAbrupt(byteIndex) THEN byteIndex ELSE
         LET count == IF a3 = Undefined THEN Ok(byteIndex.s, Num(PosInf)) ELSE ToIntegerOrInfinity(byteIndex.s, a3) IN
         IF IsAbrupt(count) THEN count
         ELSE IF ~IsSharedArrayBuffer(count.s, O(count.s, a1).slots.buffer) THEN Ok(count.s, IntV(0))
         ELSE LET r == NotifyWaiters(count.s, O(count.s, a1).slots.buffer, Val(byteIndex), Val(count).value)
              IN Ok(r.s, IntV(r.count))
    [] m = "wait" -> DoWait(s, "sync", a1, a2, a3, Arg(args, 4))
    [] m = "waitAsync" -> DoWait(s, "async", a1, a2, a3, Arg(args, 4))
    [] OTHER -> AtomicReadModifyWrite(s, a1, a2, a3, m)
\* ArrayBuffer (§25.1) and SharedArrayBuffer (§25.2) objects, and the byte encoding of numbers. A
\* buffer has class "arrayBuffer" and slots:
\*   data      its Data Block (see BlockOf), empty when detached
\*   detached  whether its [[ArrayBufferData]] is null
\*   immutable whether it has [[ArrayBufferIsImmutable]] (proposal-immutable-arraybuffer)
\*   max       its [[ArrayBufferMaxByteLength]], or Empty when it is fixed-length
\*   shared    whether it is a SharedArrayBuffer
\* Its byte length is the length of its block. No host gives a buffer a detach key, so
\* [[ArrayBufferDetachKey]] is always empty and isn't kept. With a single agent no other buffer can
\* hold a SharedArrayBuffer's block, so two buffers share a block exactly when they are the same
\* buffer, and a growable one's block grows with its byte length.
\* The agent's [[LittleEndian]].
\* The largest Data Block this implementation creates. CreateByteDataBlock throws a RangeError
\* for a larger one.
FitsDataBlock(n) == ~NumLess(NumFromInt(MaxByteLength), n)
IntegerMin(x, y) == IF x < y THEN x ELSE y
\* TypedArray element types (Table 71).
ElementSize(type) ==
  CASE type \in {"int8", "uint8", "uint8clamped"} -> 1
    [] type \in {"int16", "uint16", "float16"} -> 2
    [] type \in {"int32", "uint32", "float32"} -> 4
    [] OTHER -> 8
IsBigIntElementType(type) == type \in {"bigint64", "biguint64"}
IsUnclampedIntegerElementType(type) == type \in {"int8", "uint8", "int16", "uint16", "int32", "uint32"}
\* The IEEE 754-2019 binary formats: the significand's precision and the exponent's width.
FloatFormat(type) ==
  CASE type = "float16" -> [precision |-> 11, exponentBits |-> 5]
    [] type = "float32" -> [precision |-> 24, exponentBits |-> 8]
    [] type = "float64" -> [precision |-> 53, exponentBits |-> 11]
\* The bits of the Number x in format f, as a BigNat, rounding ties to even. NaN is the quiet NaN
\* with a clear sign.
FloatBits(x, f) ==
  LET bias == 2 ^ (f.exponentBits - 1) - 1
      fractionBits == f.precision - 1
      exponentOnes == BNShiftLeft(BNFromInt(2 ^ f.exponentBits - 1), fractionBits)
      r == IF x.k \in {"nan", "inf"} \/ NumIsZero(x) THEN x
           ELSE RoundBits(x.neg, NumMag(x), NumExponent(x), FALSE, f.precision, 1 - bias, bias)
      m == NumMag(r)
      top == NumExponent(r) + BNBitLength(m) - 1
      magnitude ==
        CASE r.k = "nan" -> BNAdd(exponentOnes, BNPow2(fractionBits - 1))
          [] r.k = "inf" -> exponentOnes
          [] NumIsZero(r) -> <<>>
          [] top >= 1 - bias ->
               BNAdd(BNShiftLeft(BNFromInt(top + bias), fractionBits),
                     BNSub(BNShift(m, f.precision - BNBitLength(m)), BNPow2(fractionBits)))
          [] OTHER -> BNShift(m, NumExponent(r) - (1 - bias) + fractionBits)
  IN IF r.neg /\ r.k # "nan" THEN BNAdd(magnitude, BNPow2(f.exponentBits + fractionBits)) ELSE magnitude
\* m * 2^k for a k that leaves it an integer.
BNShift(m, k) == IF k >= 0 THEN BNShiftLeft(m, k) ELSE BNShiftRight(m, -k)
\* The Number that the bits encode in format f.
FloatFromBits(bits, f) ==
  LET bias == 2 ^ (f.exponentBits - 1) - 1
      fractionBits == f.precision - 1
      neg == BNTestBit(bits, f.exponentBits + fractionBits)
      biased == BNToInt(BNLowBits(BNShiftRight(bits, fractionBits), f.exponentBits))
      fraction == BNLowBits(bits, fractionBits)
  IN CASE biased = 2 ^ f.exponentBits - 1 -> IF fraction = <<>> THEN MkNum("inf", neg, 0, <<>>, 0) ELSE NaN
       [] biased = 0 -> NumMakeNum(neg, fraction, 1 - bias - fractionBits)
       [] OTHER -> NumMakeNum(neg, BNAdd(fraction, BNPow2(fractionBits)), biased - bias - fractionBits)
\* The n bytes of a BigNat, least significant first, and the BigNat of little-endian bytes.
BigNatBytes(bits, n) == [i \in 1..n |-> BNToInt(BNLowBits(BNShiftRight(bits, 8 * (i - 1)), 8))]
BytesBigNat(bytes) ==
  IF bytes = <<>> THEN <<>> ELSE BNAdd(BNFromInt(Head(bytes)), BNShiftLeft(BytesBigNat(Tail(bytes)), 8))
\* A BigInt modulo 2^64, as the BigNat of its two's complement bits, and the BigInt that 64
\* two's complement bits encode.
BigInt64Bits(b) ==
  LET low == BNLowBits(b.mag, 64) IN IF b.neg /\ low # <<>> THEN BNSub(BNPow2(64), low) ELSE low
BigIntFromBits64(bits) ==
  IF BNTestBit(bits, 63) THEN BigIntOf(TRUE, BNSub(BNPow2(64), bits)) ELSE BigIntOf(FALSE, bits)
\* NumericToRawBytes (§25.1.3.17).
NumericToRawBytes(type, v, isLittleEndian) ==
  LET bytes ==
        CASE type \in {"float16", "float32", "float64"} ->
               BigNatBytes(FloatBits(v.value, FloatFormat(type)), ElementSize(type))
          [] type = "uint8clamped" -> <<NumToUint8Clamp(v.value)>>
          [] type \in {"int8", "uint8"} -> <<NumToUint8(v.value)>>
          [] type \in {"int16", "uint16"} -> LET low == NumToUint16(v.value) IN <<low % 256, low \div 256>>
          [] type \in {"int32", "uint32"} ->
               LET halves == Uint32Halves(v.value)
               IN <<halves[2] % 256, halves[2] \div 256, halves[1] % 256, halves[1] \div 256>>
          [] OTHER -> BigNatBytes(BigInt64Bits(v.value), 8)
  IN IF isLittleEndian THEN bytes ELSE Reverse(bytes)
\* RawBytesToNumeric (§25.1.3.14).
RawBytesToNumeric(type, raw, isLittleEndian) ==
  LET bytes == IF isLittleEndian THEN raw ELSE Reverse(raw)
      halves == IF Len(bytes) = 4 THEN <<bytes[3] + 256 * bytes[4], bytes[1] + 256 * bytes[2]>> ELSE <<>>
  IN CASE type \in {"float16", "float32", "float64"} -> Num(FloatFromBits(BytesBigNat(bytes), FloatFormat(type)))
       [] type \in {"uint8", "uint8clamped"} -> IntV(bytes[1])
       [] type = "int8" -> IntV(IF bytes[1] >= 128 THEN bytes[1] - 256 ELSE bytes[1])
       [] type = "uint16" -> IntV(bytes[1] + 256 * bytes[2])
       [] type = "int16" -> LET u == bytes[1] + 256 * bytes[2] IN IntV(IF u >= 32768 THEN u - 65536 ELSE u)
       [] type = "uint32" -> Num(Uint32FromHalves(halves))
       [] type = "int32" -> IntV(Int32FromHalves(halves))
       [] type = "biguint64" -> BigInt(BigIntOf(FALSE, BytesBigNat(bytes)))
       [] type = "bigint64" -> BigInt(BigIntFromBits64(BytesBigNat(bytes)))
\* Buffers and their Data Blocks.
IsBuffer(s, v, shared) == IsObject(v) /\ O(s, v).class = "arrayBuffer" /\ O(s, v).slots.shared = shared
IsDetachedBuffer(s, b) == O(s, b).slots.detached
IsSharedArrayBuffer(s, b) == O(s, b).slots.shared
IsFixedLengthArrayBuffer(s, b) == O(s, b).slots.max = Empty
IsImmutableBuffer(s, b) == O(s, b).slots.immutable
\* A Data Block of byte values, in pages of BlockPageSize bytes, so that storing a few bytes copies
\* their page and the list of pages rather than the whole block.
BlockOf(bytes) ==
  [size |-> Len(bytes),
   pages |-> [k \in 1..((Len(bytes) + BlockPageSize - 1) \div BlockPageSize) |->
                SubSeq(bytes, (k - 1) * BlockPageSize + 1, IntegerMin(k * BlockPageSize, Len(bytes)))]]
BlockByte(block, byteIndex) == block.pages[byteIndex \div BlockPageSize + 1][(byteIndex % BlockPageSize) + 1]
\* The count bytes of a block from byteIndex.
BlockBytes(block, byteIndex, count) == [i \in 1..count |-> BlockByte(block, byteIndex + i - 1)]
\* A block with bytes stored from byteIndex, one page entry at a time for a few bytes.
BlockStore(block, byteIndex, bytes) ==
  IF Len(bytes) > BlockPageSize
  THEN BlockOf([i \in 1..block.size |->
                  IF i > byteIndex /\ i <= byteIndex + Len(bytes) THEN bytes[i - byteIndex] ELSE BlockByte(block, i - 1)])
  ELSE BlockStoreFrom(block, byteIndex, bytes)
BlockStoreFrom(block, byteIndex, bytes) ==
  IF bytes = <<>> THEN block
  ELSE BlockStoreFrom([block EXCEPT !.pages[byteIndex \div BlockPageSize + 1][(byteIndex % BlockPageSize) + 1] = Head(bytes)],
                      byteIndex + 1, Tail(bytes))
ArrayBufferByteLength(s, b) == O(s, b).slots.data.size
SetBufferData(s, b, bytes) == SetO(s, b, [O(s, b) EXCEPT !.slots.data = BlockOf(bytes)])
\* The count bytes of b's block from byteIndex.
BufferBytes(s, b, byteIndex, count) == BlockBytes(O(s, b).slots.data, byteIndex, count)
\* Stores bytes into b's block from byteIndex.
SetBufferBytes(s, b, byteIndex, bytes) == SetO(s, b, [O(s, b) EXCEPT !.slots.data = BlockStore(@, byteIndex, bytes)])
\* GetValueFromBuffer (§25.1.3.16) and SetValueInBuffer (§25.1.3.18). One agent sees every write
\* to a shared block at once, so a shared block reads and writes as any other.
GetValueFromBuffer(s, b, byteIndex, type, isLittleEndian) ==
  RawBytesToNumeric(type, BufferBytes(s, b, byteIndex, ElementSize(type)), isLittleEndian)
SetValueInBuffer(s, b, byteIndex, type, v, isLittleEndian) ==
  SetBufferBytes(s, b, byteIndex, NumericToRawBytes(type, v, isLittleEndian))
\* AllocateArrayBuffer (§25.1.3.1) and AllocateSharedArrayBuffer (§25.2.2.1), with byteLength a
\* Number and maxByteLength a Number or Empty.
AllocateBuffer(s, ctor, byteLength, maxByteLength, shared) ==
  IF maxByteLength # Empty /\ NumLess(maxByteLength, byteLength) THEN ThrowError(s, "RangeError")
  ELSE LET p == GetPrototypeFromConstructor(s, ctor, IF shared THEN "SharedArrayBufferPrototype" ELSE "ArrayBufferPrototype") IN
  IF IsAbrupt(p) THEN p
  ELSE IF ~FitsDataBlock(byteLength) \/ (maxByteLength # Empty /\ ~FitsDataBlock(maxByteLength))
  THEN ThrowError(p.s, "RangeError")
  ELSE LET a == Alloc(p.s, MakeObject(Val(p), "arrayBuffer",
                        [data |-> BlockOf(Repeat(0, NumToSmallInt(byteLength))), detached |-> FALSE, immutable |-> FALSE, shared |-> shared,
                         max |-> IF maxByteLength = Empty THEN Empty ELSE NumToSmallInt(maxByteLength)]))
       IN Ok(a.s, a.v)
\* AllocateImmutableArrayBuffer, for a Number byteLength and the bytes to copy into its start.
AllocateImmutableArrayBuffer(s, byteLength, bytes) ==
  LET a == AllocateBuffer(s, Intrinsic(s, "ArrayBuffer"), byteLength, Empty, FALSE) IN
  IF IsAbrupt(a) THEN a
  ELSE Ok(SetO(a.s, Val(a), [O(a.s, Val(a)) EXCEPT !.slots.immutable = TRUE, !.slots.data = BlockStore(@, 0, bytes)]),
          Val(a))
CloneArrayBuffer(s, b, byteOffset, length) ==
  LET a == AllocateBuffer(s, Intrinsic(s, "ArrayBuffer"), NumFromInt(length), Empty, FALSE) IN
  IF IsAbrupt(a) THEN a
  ELSE Ok(SetBufferData(a.s, Val(a), BufferBytes(a.s, b, byteOffset, length)), Val(a))
\* DetachArrayBuffer (§25.1.3.5) without a key.
DetachArrayBuffer(s, b) == SetO(s, b, [O(s, b) EXCEPT !.slots.data = BlockOf(<<>>), !.slots.detached = TRUE])
\* GetArrayBufferMaxByteLengthOption (§25.1.3.7): a Number or Empty.
GetArrayBufferMaxByteLengthOption(s, options) ==
  IF ~IsObject(options) THEN Ok(s, Empty)
  ELSE LET m == Get(s, options, SV("maxByteLength")) IN
  IF IsAbrupt(m) THEN m
  ELSE IF Val(m) = Undefined THEN Ok(m.s, Empty)
  ELSE LET i == ToIndex(m.s, Val(m)) IN IF IsAbrupt(i) THEN i ELSE Ok(i.s, Val(i).value)
\* ArrayBuffer ( length [ , options ] ) (§25.1.4.1) and SharedArrayBuffer (§25.2.3.1).
BufferConstructor(s, args, nt, shared) ==
  IF nt = Undefined THEN ThrowTypeError(s)
  ELSE LET length == ToIndex(s, Arg(args, 1)) IN IF IsAbrupt(length) THEN length ELSE
  LET max == GetArrayBufferMaxByteLengthOption(length.s, Arg(args, 2)) IN IF IsAbrupt(max) THEN max
  ELSE AllocateBuffer(max.s, nt, Val(length).value, Val(max), shared)
\* ArrayBufferCopyAndDetach (§25.1.3.3) on an ArrayBuffer, for preserveResizability
\* "preserve-resizability", "fixed-length", or "immutable".
ArrayBufferCopyAndDetach(s, b, newLength, preserveResizability) ==
  LET n == IF newLength = Undefined THEN Ok(s, IntV(ArrayBufferByteLength(s, b))) ELSE ToIndex(s, newLength) IN
  IF IsAbrupt(n) THEN n
  ELSE IF IsDetachedBuffer(n.s, b) \/ IsImmutableBuffer(n.s, b) THEN ThrowTypeError(n.s)
  ELSE LET max == IF preserveResizability = "preserve-resizability" /\ ~IsFixedLengthArrayBuffer(n.s, b)
                  THEN NumFromInt(O(n.s, b).slots.max) ELSE Empty
           new == AllocateBuffer(n.s, Intrinsic(n.s, "ArrayBuffer"), Val(n).value, max, FALSE)
       IN IF IsAbrupt(new) THEN new
          ELSE LET copied == BufferBytes(new.s, b, 0, IntegerMin(ArrayBufferByteLength(new.s, Val(new)),
                                                                  ArrayBufferByteLength(new.s, b)))
                   filled == SetBufferBytes(new.s, Val(new), 0, copied)
               IN Ok(DetachArrayBuffer(IF preserveResizability = "immutable"
                                       THEN SetO(filled, Val(new), [O(filled, Val(new)) EXCEPT !.slots.immutable = TRUE])
                                       ELSE filled, b),
                     Val(new))
\* ArrayBuffer.prototype.slice (§25.1.6.7) and SharedArrayBuffer.prototype.slice (§25.2.5.6).
BufferSlice(s, b, start, end, shared) ==
  IF ~shared /\ IsDetachedBuffer(s, b) THEN ThrowTypeError(s)
  ELSE LET len == ArrayBufferByteLength(s, b)
           first == ToClampedIndex(s, start, len)
       IN IF IsAbrupt(first) THEN first ELSE
          LET final == IF end = Undefined THEN Ok(first.s, len) ELSE ToClampedIndex(first.s, end, len) IN
          IF IsAbrupt(final) THEN final ELSE
          LET newLength == IntegerMax(Val(final) - Val(first), 0)
              ctor == SpeciesConstructor(final.s, b, Intrinsic(final.s, IF shared THEN "SharedArrayBuffer" ELSE "ArrayBuffer"))
          IN IF IsAbrupt(ctor) THEN ctor ELSE
             LET new == Construct(ctor.s, Val(ctor), <<IntV(newLength)>>, Val(ctor)) IN
             IF IsAbrupt(new) THEN new
             ELSE LET t == new.s
                      nb == Val(new)
                  IN IF ~IsBuffer(t, nb, shared) \/ (~shared /\ (IsDetachedBuffer(t, nb) \/ IsImmutableBuffer(t, nb))) \/
                        SameValue(nb, b) \/
                        ArrayBufferByteLength(t, nb) < newLength \/ (~shared /\ IsDetachedBuffer(t, b))
                     THEN ThrowTypeError(t)
                     ELSE LET count == IntegerMin(newLength, ArrayBufferByteLength(t, b) - Val(first))
                          IN Ok(IF count > 0
                                THEN SetBufferBytes(t, nb, 0, BufferBytes(t, b, Val(first), count))
                                ELSE t, nb)
\* ArrayBuffer (§25.1.4 to §25.1.6) and the test262 host's $262.detachArrayBuffer.
ArrayBufferBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1) IN
  CASE m = "constructor" -> BufferConstructor(s, args, nt, FALSE)
    [] m = "isView" -> Ok(s, Bool(IsObject(a1) /\ O(s, a1).class \in {"typedArray", "dataView"}))
    [] m = "species" -> Ok(s, this)
    [] m = "detach" ->
         IF IsBuffer(s, a1, FALSE) /\ ~IsImmutableBuffer(s, a1) THEN Ok(DetachArrayBuffer(s, a1), Undefined) ELSE ThrowTypeError(s)
    [] ~IsBuffer(s, this, FALSE) \/ (m = "resize" /\ IsFixedLengthArrayBuffer(s, this)) -> ThrowTypeError(s)
    [] m = "byteLength" -> Ok(s, IntV(ArrayBufferByteLength(s, this)))
    [] m = "detached" -> Ok(s, Bool(IsDetachedBuffer(s, this)))
    [] m = "immutable" -> Ok(s, Bool(IsImmutableBuffer(s, this)))
    [] m = "maxByteLength" ->
         Ok(s, IntV(IF IsDetachedBuffer(s, this) THEN 0
                    ELSE IF IsFixedLengthArrayBuffer(s, this) THEN ArrayBufferByteLength(s, this)
                    ELSE O(s, this).slots.max))
    [] m = "resizable" -> Ok(s, Bool(~IsFixedLengthArrayBuffer(s, this)))
    \* ArrayBuffer.prototype.resize (§25.1.6.6).
    [] m = "resize" ->
         LET n == ToIndex(s, a1) IN IF IsAbrupt(n) THEN n
         ELSE IF IsDetachedBuffer(n.s, this) THEN ThrowTypeError(n.s)
         ELSE IF NumLess(NumFromInt(O(n.s, this).slots.max), Val(n).value) THEN ThrowError(n.s, "RangeError")
         ELSE LET newLength == NumToSmallInt(Val(n).value)
                  current == ArrayBufferByteLength(n.s, this)
              IN Ok(SetBufferData(n.s, this, IF newLength <= current THEN BufferBytes(n.s, this, 0, newLength)
                                            ELSE BufferBytes(n.s, this, 0, current) \o Repeat(0, newLength - current)),
                    Undefined)
    [] m = "slice" -> BufferSlice(s, this, a1, Arg(args, 2), FALSE)
    \* ArrayBuffer.prototype.sliceToImmutable (proposal-immutable-arraybuffer).
    [] m = "sliceToImmutable" ->
         IF IsDetachedBuffer(s, this) THEN ThrowTypeError(s) ELSE
         LET len == ArrayBufferByteLength(s, this)
             first == ToClampedIndex(s, a1, len)
         IN IF IsAbrupt(first) THEN first ELSE
         LET final == IF Arg(args, 2) = Undefined THEN Ok(first.s, len) ELSE ToClampedIndex(first.s, Arg(args, 2), len) IN
         IF IsAbrupt(final) THEN final
         ELSE IF IsDetachedBuffer(final.s, this) THEN ThrowTypeError(final.s)
         ELSE IF ArrayBufferByteLength(final.s, this) < Val(final) THEN ThrowError(final.s, "RangeError")
         ELSE LET newLength == IntegerMax(Val(final) - Val(first), 0) IN
              AllocateImmutableArrayBuffer(final.s, NumFromInt(newLength),
                                           BufferBytes(final.s, this, Val(first), newLength))
    [] m = "transfer" -> ArrayBufferCopyAndDetach(s, this, a1, "preserve-resizability")
    [] m = "transferToFixedLength" -> ArrayBufferCopyAndDetach(s, this, a1, "fixed-length")
    [] m = "transferToImmutable" -> ArrayBufferCopyAndDetach(s, this, a1, "immutable")
\* SharedArrayBuffer (§25.2.3 to §25.2.5).
SharedArrayBufferBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> BufferConstructor(s, args, nt, TRUE)
    [] m = "species" -> Ok(s, this)
    [] m = "grow" /\ ~(IsObject(this) /\ O(s, this).class = "arrayBuffer" /\ O(s, this).slots.max # Empty) -> ThrowTypeError(s)
    [] ~IsBuffer(s, this, TRUE) -> ThrowTypeError(s)
    [] m = "byteLength" -> Ok(s, IntV(ArrayBufferByteLength(s, this)))
    [] m = "growable" -> Ok(s, Bool(~IsFixedLengthArrayBuffer(s, this)))
    [] m = "maxByteLength" ->
         Ok(s, IntV(IF IsFixedLengthArrayBuffer(s, this) THEN ArrayBufferByteLength(s, this) ELSE O(s, this).slots.max))
    \* SharedArrayBuffer.prototype.grow (§25.2.5.3).
    [] m = "grow" ->
         LET n == ToIndex(s, Arg(args, 1)) IN IF IsAbrupt(n) THEN n ELSE
         LET current == ArrayBufferByteLength(n.s, this) IN
         IF NumSameValueZero(Val(n).value, NumFromInt(current)) THEN Ok(n.s, Undefined)
         ELSE IF NumLess(Val(n).value, NumFromInt(current)) \/ NumLess(NumFromInt(O(n.s, this).slots.max), Val(n).value)
         THEN ThrowError(n.s, "RangeError")
         ELSE Ok(SetBufferData(n.s, this, BufferBytes(n.s, this, 0, current) \o Repeat(0, NumToSmallInt(Val(n).value) - current)), Undefined)
    [] m = "slice" -> BufferSlice(s, this, Arg(args, 1), Arg(args, 2), TRUE)
\* DataView objects (§25.3). A DataView has class "dataView" and slots:
\*   buffer      [[ViewedArrayBuffer]]
\*   byteLength  [[ByteLength]], or Empty for ~auto~
\*   byteOffset  [[ByteOffset]]
\* As for TypedArrays, the DataView With Buffer Witness Records aren't kept.
IsDataView(s, v) == IsObject(v) /\ O(s, v).class = "dataView"
\* IsViewOutOfBounds (§25.3.1.4) and GetViewByteLength (§25.3.1.3).
IsViewOutOfBounds(s, view) ==
  LET o == O(s, view).slots IN
  IF IsDetachedBuffer(s, o.buffer) THEN TRUE
  ELSE LET bufferByteLength == ArrayBufferByteLength(s, o.buffer)
           end == IF o.byteLength = Empty THEN bufferByteLength ELSE o.byteOffset + o.byteLength
       IN o.byteOffset > bufferByteLength \/ end > bufferByteLength
GetViewByteLength(s, view) ==
  LET o == O(s, view).slots IN
  IF o.byteLength # Empty THEN o.byteLength ELSE ArrayBufferByteLength(s, o.buffer) - o.byteOffset
\* The element type of a get or set method, such as "int8" for getInt8.
DataViewType(m) ==
  CASE m \in {"getInt8", "setInt8"} -> "int8" [] m \in {"getUint8", "setUint8"} -> "uint8"
    [] m \in {"getInt16", "setInt16"} -> "int16" [] m \in {"getUint16", "setUint16"} -> "uint16"
    [] m \in {"getInt32", "setInt32"} -> "int32" [] m \in {"getUint32", "setUint32"} -> "uint32"
    [] m \in {"getBigInt64", "setBigInt64"} -> "bigint64" [] m \in {"getBigUint64", "setBigUint64"} -> "biguint64"
    [] m \in {"getFloat16", "setFloat16"} -> "float16" [] m \in {"getFloat32", "setFloat32"} -> "float32"
    [] m \in {"getFloat64", "setFloat64"} -> "float64"
\* The checks GetViewValue (§25.3.1.5) and SetViewValue (§25.3.1.6) make after their conversions:
\* the view's byte index of getIndex, a Number.
ViewIndex(s, view, getIndex, type) ==
  IF IsViewOutOfBounds(s, view) THEN ThrowTypeError(s)
  ELSE IF NumLess(NumFromInt(GetViewByteLength(s, view)), NumAdd(getIndex, NumFromInt(ElementSize(type))))
  THEN ThrowError(s, "RangeError")
  ELSE Ok(s, NumToSmallInt(getIndex) + O(s, view).slots.byteOffset)
GetViewValue(s, view, requestIndex, isLittleEndian, type) ==
  LET getIndex == ToIndex(s, requestIndex) IN IF IsAbrupt(getIndex) THEN getIndex ELSE
  LET i == ViewIndex(getIndex.s, view, Val(getIndex).value, type) IN IF IsAbrupt(i) THEN i
  ELSE Ok(i.s, GetValueFromBuffer(i.s, O(i.s, view).slots.buffer, Val(i), type, ToBooleanValue(isLittleEndian)))
SetViewValue(s, view, requestIndex, isLittleEndian, type, value) ==
  IF IsImmutableBuffer(s, O(s, view).slots.buffer) THEN ThrowTypeError(s) ELSE
  LET getIndex == ToIndex(s, requestIndex) IN IF IsAbrupt(getIndex) THEN getIndex ELSE
  LET n == IF IsBigIntElementType(type) THEN ToBigInt(getIndex.s, value) ELSE ToNumber(getIndex.s, value) IN
  IF IsAbrupt(n) THEN n ELSE
  LET i == ViewIndex(n.s, view, Val(getIndex).value, type) IN IF IsAbrupt(i) THEN i
  ELSE Ok(SetValueInBuffer(i.s, O(i.s, view).slots.buffer, Val(i), type, Val(n), ToBooleanValue(isLittleEndian)), Undefined)
\* DataView ( buffer [ , byteOffset [ , byteLength ] ] ) (§25.3.2.1).
DataViewConstruct(s, buffer, byteOffset, byteLength, nt) ==
  IF nt = Undefined THEN ThrowTypeError(s)
  ELSE IF ~(IsObject(buffer) /\ O(s, buffer).class = "arrayBuffer") THEN ThrowTypeError(s)
  ELSE LET off == ToIndex(s, byteOffset) IN IF IsAbrupt(off) THEN off
  ELSE IF IsDetachedBuffer(off.s, buffer) THEN ThrowTypeError(off.s)
  ELSE IF NumLess(NumFromInt(ArrayBufferByteLength(off.s, buffer)), Val(off).value) THEN ThrowError(off.s, "RangeError")
  ELSE LET offset == NumToSmallInt(Val(off).value)
           bufferByteLength == ArrayBufferByteLength(off.s, buffer)
           viewByteLength ==
             IF byteLength # Undefined THEN ToIndex(off.s, byteLength)
             ELSE Ok(off.s, IF IsFixedLengthArrayBuffer(off.s, buffer) THEN IntV(bufferByteLength - offset) ELSE Empty)
       IN IF IsAbrupt(viewByteLength) THEN viewByteLength
          ELSE IF byteLength # Undefined /\ NumLess(NumFromInt(bufferByteLength - offset), Val(viewByteLength).value)
          THEN ThrowError(viewByteLength.s, "RangeError")
          ELSE LET o == OrdinaryCreateFromConstructor(viewByteLength.s, nt, "DataViewPrototype", "dataView",
                          [buffer |-> buffer, byteOffset |-> offset,
                           byteLength |-> IF Val(viewByteLength) = Empty THEN Empty ELSE NumToSmallInt(Val(viewByteLength).value)])
               IN IF IsAbrupt(o) THEN o
                  ELSE IF IsDetachedBuffer(o.s, buffer) THEN ThrowTypeError(o.s)
                  ELSE IF offset > ArrayBufferByteLength(o.s, buffer) \/
                          (byteLength # Undefined /\ offset + O(o.s, Val(o)).slots.byteLength > ArrayBufferByteLength(o.s, buffer))
                  THEN ThrowError(o.s, "RangeError")
                  ELSE o
\* The DataView constructor and DataView.prototype (§25.3.2 to §25.3.4). A get method's
\* littleEndian defaults to false, as ToBoolean(undefined) is.
DataViewBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" -> DataViewConstruct(s, Arg(args, 1), Arg(args, 2), Arg(args, 3), nt)
    [] ~IsDataView(s, this) -> ThrowTypeError(s)
    [] m = "buffer" -> Ok(s, O(s, this).slots.buffer)
    [] m = "byteLength" -> Ok(s, IntV(IF IsViewOutOfBounds(s, this) THEN 0 ELSE GetViewByteLength(s, this)))
    [] m = "byteOffset" -> Ok(s, IntV(IF IsViewOutOfBounds(s, this) THEN 0 ELSE O(s, this).slots.byteOffset))
    [] m \in DataViewGetters -> GetViewValue(s, this, Arg(args, 1), Arg(args, 2), DataViewType(m))
    [] OTHER -> SetViewValue(s, this, Arg(args, 1), Arg(args, 3), DataViewType(m), Arg(args, 2))
\* TypedArrays (§10.4.5, §23.2). A TypedArray has class "typedArray" and slots:
\*   buffer       [[ViewedArrayBuffer]]
\*   name         [[TypedArrayName]], such as "Int8Array"
\*   byteLength   [[ByteLength]], or Empty for ~auto~
\*   byteOffset   [[ByteOffset]]
\*   arrayLength  [[ArrayLength]], or Empty for ~auto~
\* Its [[ContentType]] follows from its name. With a single agent a buffer's byte length can't
\* change between two reads, so the TypedArray With Buffer Witness Records aren't kept: the
\* operations read the buffer's byte length from the state.
\* The TypedArray constructors (Table 71).
TypedArrayElementType(name) ==
  CASE name = "Int8Array" -> "int8" [] name = "Uint8Array" -> "uint8" [] name = "Uint8ClampedArray" -> "uint8clamped"
    [] name = "Int16Array" -> "int16" [] name = "Uint16Array" -> "uint16" [] name = "Int32Array" -> "int32"
    [] name = "Uint32Array" -> "uint32" [] name = "BigInt64Array" -> "bigint64" [] name = "BigUint64Array" -> "biguint64"
    [] name = "Float16Array" -> "float16" [] name = "Float32Array" -> "float32" [] name = "Float64Array" -> "float64"
TypedArrayNameUnits(name) ==
  CASE name = "Int8Array" -> N("Int8Array") [] name = "Uint8Array" -> N("Uint8Array")
    [] name = "Uint8ClampedArray" -> N("Uint8ClampedArray") [] name = "Int16Array" -> N("Int16Array")
    [] name = "Uint16Array" -> N("Uint16Array") [] name = "Int32Array" -> N("Int32Array")
    [] name = "Uint32Array" -> N("Uint32Array") [] name = "BigInt64Array" -> N("BigInt64Array")
    [] name = "BigUint64Array" -> N("BigUint64Array") [] name = "Float16Array" -> N("Float16Array")
    [] name = "Float32Array" -> N("Float32Array") [] name = "Float64Array" -> N("Float64Array")
IsTypedArray(s, v) == IsObject(v) /\ O(s, v).class = "typedArray"
TypedArrayType(s, ta) == TypedArrayElementType(O(s, ta).slots.name)
TypedArraySize(s, ta) == ElementSize(TypedArrayType(s, ta))
IsBigIntTypedArray(s, ta) == IsBigIntElementType(TypedArrayType(s, ta))
\* IsTypedArrayOutOfBounds (§10.4.5.12).
IsTypedArrayOutOfBounds(s, ta) ==
  LET o == O(s, ta).slots IN
  IF IsDetachedBuffer(s, o.buffer) THEN TRUE
  ELSE LET bufferByteLength == ArrayBufferByteLength(s, o.buffer)
           end == IF o.arrayLength = Empty THEN bufferByteLength
                  ELSE o.byteOffset + o.arrayLength * TypedArraySize(s, ta)
       IN o.byteOffset > bufferByteLength \/ end > bufferByteLength
\* TypedArrayLength (§10.4.5.11) and TypedArrayByteLength (§10.4.5.10).
TypedArrayLength(s, ta) ==
  LET o == O(s, ta).slots IN
  IF o.arrayLength # Empty THEN o.arrayLength
  ELSE (ArrayBufferByteLength(s, o.buffer) - o.byteOffset) \div TypedArraySize(s, ta)
TypedArrayByteLength(s, ta) ==
  IF O(s, ta).slots.byteLength # Empty THEN O(s, ta).slots.byteLength
  ELSE TypedArrayLength(s, ta) * TypedArraySize(s, ta)
\* IsTypedArrayFixedLength (§10.4.5.13).
IsFixedLengthTypedArray(s, ta) ==
  LET o == O(s, ta).slots IN
  o.arrayLength # Empty /\ (IsFixedLengthArrayBuffer(s, o.buffer) \/ IsSharedArrayBuffer(s, o.buffer))
\* IsValidIntegerIndex (§10.4.5.14), for index a Number.
IsValidIntegerIndex(s, ta, index) ==
  /\ ~IsDetachedBuffer(s, O(s, ta).slots.buffer)
  /\ NumIsIntegral(index)
  /\ ~index.neg
  /\ ~IsTypedArrayOutOfBounds(s, ta)
  /\ NumLess(index, NumFromInt(TypedArrayLength(s, ta)))
\* TypedArrayGetElement (§10.4.5.15).
TypedArrayGetElement(s, ta, index) ==
  IF ~IsValidIntegerIndex(s, ta, index) THEN Undefined
  ELSE GetValueFromBuffer(s, O(s, ta).slots.buffer, index.i * TypedArraySize(s, ta) + O(s, ta).slots.byteOffset,
                          TypedArrayType(s, ta), LittleEndian)
\* The last steps of TypedArraySetElement, for a value already a Number or BigInt.
TypedArrayStore(s, ta, index, numeric) ==
  IF ~IsValidIntegerIndex(s, ta, index) THEN s
  ELSE SetValueInBuffer(s, O(s, ta).slots.buffer, index.i * TypedArraySize(s, ta) + O(s, ta).slots.byteOffset,
                        TypedArrayType(s, ta), numeric, LittleEndian)
\* TypedArraySetElement (§10.4.5.16).
TypedArraySetElement(s, ta, index, v) ==
  LET n == IF IsBigIntTypedArray(s, ta) THEN ToBigInt(s, v) ELSE ToNumber(s, v) IN
  IF IsAbrupt(n) THEN n ELSE Ok(TypedArrayStore(n.s, ta, index, Val(n)), Undefined)
\* The TypedArray internal methods (§10.4.5.1 to §10.4.5.8) for a key k that is a canonical numeric
\* string, which CanonicalIndex turns into its Number.
IsTypedArrayKey(k) == IsString(k) /\ CanonicalNumericIndexString(k.value) # Undefined
CanonicalIndex(k) == CanonicalNumericIndexString(k.value).value
TypedArrayGetOwnProperty(s, ta, k) ==
  LET v == TypedArrayGetElement(s, ta, CanonicalIndex(k)) IN
  LET isMutable == ~IsImmutableBuffer(s, O(s, ta).slots.buffer) IN
  IF v = Undefined THEN Absent ELSE DataDesc(v, isMutable, TRUE, isMutable)
TypedArrayDefineOwnProperty(s, ta, k, d) ==
  LET index == CanonicalIndex(k) IN
  IF ~IsValidIntegerIndex(s, ta, index) THEN Ok(s, False)
  ELSE IF IsImmutableBuffer(s, O(s, ta).slots.buffer)
  THEN Ok(s, Bool(IsCompatiblePropertyDescriptor(FALSE, d, TypedArrayGetOwnProperty(s, ta, k))))
  ELSE IF d.configurable = False \/ d.enumerable = False \/ IsAccessorDescriptor(d) \/ d.writable = False THEN Ok(s, False)
  ELSE IF d.value = Absent THEN Ok(s, True)
  ELSE LET r == TypedArraySetElement(s, ta, index, d.value) IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, True)
TypedArraySet(s, ta, k, value, receiver) ==
  LET index == CanonicalIndex(k) IN
  IF IsImmutableBuffer(s, O(s, ta).slots.buffer) THEN Ok(s, False)
  ELSE IF SameValue(ta, receiver) THEN
    LET r == TypedArraySetElement(s, ta, index, value) IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, True)
  ELSE IF ~IsValidIntegerIndex(s, ta, index) THEN Ok(s, True)
  ELSE OrdinarySet(s, ta, k, value, receiver)
TypedArrayOwnPropertyKeys(s, ta) ==
  LET length == IF IsTypedArrayOutOfBounds(s, ta) THEN 0 ELSE TypedArrayLength(s, ta)
      keys == O(s, ta).keys
  IN [i \in 1..length |-> Index(NumFromInt(i - 1))] \o SelectSeq(keys, IsString) \o SelectSeq(keys, IsSymbol)
\* ValidateTypedArray (§23.2.4.4) and ValidateTypedArrayBounds, with the length as the value.
\* ValidateTypedArrayForWrite is ValidateTypedArray with accessMode write, which rejects a view of
\* an immutable buffer (proposal-immutable-arraybuffer).
ValidateTypedArray(s, v) == IF ~IsTypedArray(s, v) THEN ThrowTypeError(s) ELSE ValidateTypedArrayBounds(s, v)
ValidateTypedArrayForWrite(s, v) ==
  IF IsTypedArray(s, v) /\ IsImmutableBuffer(s, O(s, v).slots.buffer) THEN ThrowTypeError(s) ELSE ValidateTypedArray(s, v)
ValidateTypedArrayBounds(s, ta) ==
  IF IsTypedArrayOutOfBounds(s, ta) THEN ThrowTypeError(s) ELSE Ok(s, TypedArrayLength(s, ta))
\* TypedArrayCreateFromConstructor (§23.2.4.1), for a result to read from or to write to.
TypedArrayCreateFromConstructor(s, ctor, argList, isWrite) ==
  LET ta == Construct(s, ctor, argList, ctor) IN IF IsAbrupt(ta) THEN ta ELSE
  LET len == IF isWrite THEN ValidateTypedArrayForWrite(ta.s, Val(ta)) ELSE ValidateTypedArray(ta.s, Val(ta)) IN
  IF IsAbrupt(len) THEN len
  ELSE IF Len(argList) = 1 /\ IsNumber(argList[1]) /\ NumLess(NumFromInt(Val(len)), argList[1].value)
  THEN ThrowTypeError(len.s)
  ELSE Ok(len.s, Val(ta))
\* TypedArrayCreateSameType (§23.2.4.2) and TypedArraySpeciesCreate (§23.2.4.3).
TypedArrayCreateSameType(s, exemplar, length) ==
  TypedArrayCreateFromConstructor(s, Intrinsic(s, O(s, exemplar).slots.name), <<IntV(length)>>, FALSE)
TypedArraySpeciesCreate(s, exemplar, argList, isWrite) ==
  LET c == SpeciesConstructor(s, exemplar, Intrinsic(s, O(s, exemplar).slots.name)) IN IF IsAbrupt(c) THEN c ELSE
  LET r == TypedArrayCreateFromConstructor(c.s, Val(c), argList, isWrite) IN
  IF IsAbrupt(r) THEN r
  ELSE IF IsBigIntTypedArray(r.s, Val(r)) # IsBigIntTypedArray(r.s, exemplar) THEN ThrowTypeError(r.s)
  ELSE r
\* AllocateTypedArray (§23.2.5.1.1), with length a Number, or Empty for none.
AllocateTypedArray(s, name, newTarget, length) ==
  LET p == GetPrototypeFromConstructor(s, newTarget, name \o "Prototype") IN
  IF IsAbrupt(p) THEN p
  ELSE LET a == Alloc(p.s, MakeObject(Val(p), "typedArray",
                        [buffer |-> Undefined, name |-> name, byteLength |-> 0, byteOffset |-> 0, arrayLength |-> 0]))
       IN IF length = Empty THEN Ok(a.s, a.v)
          ELSE LET r == AllocateTypedArrayBuffer(a.s, a.v, length) IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, a.v)
\* Sets a TypedArray's buffer and its view of it.
SetView(s, ta, buffer, byteLength, byteOffset, arrayLength) ==
  SetO(s, ta, [O(s, ta) EXCEPT !.slots.buffer = buffer, !.slots.byteLength = byteLength,
                               !.slots.byteOffset = byteOffset, !.slots.arrayLength = arrayLength])
\* AllocateTypedArrayBuffer (§23.2.5.1.6), with length a Number.
AllocateTypedArrayBuffer(s, ta, length) ==
  LET size == TypedArraySize(s, ta)
      data == AllocateBuffer(s, Intrinsic(s, "ArrayBuffer"), NumMul(NumFromInt(size), length), Empty, FALSE)
  IN IF IsAbrupt(data) THEN data
     ELSE Ok(SetView(data.s, ta, Val(data), size * NumToSmallInt(length), 0, NumToSmallInt(length)), Undefined)
\* Copies count elements from one buffer to another, converting each from one element type to
\* another.
CopyConverted(s, from, fromIndex, fromType, to, toIndex, toType, count) ==
  IF count <= 0 THEN s
  ELSE CopyConverted(SetValueInBuffer(s, to, toIndex, toType, GetValueFromBuffer(s, from, fromIndex, fromType, LittleEndian),
                                      LittleEndian),
                     from, fromIndex + ElementSize(fromType), fromType, to, toIndex + ElementSize(toType), toType, count - 1)
\* InitializeTypedArrayFromTypedArray (§23.2.5.1.2).
InitializeTypedArrayFromTypedArray(s, ta, source) ==
  LET elementType == TypedArrayType(s, ta)
      sourceType == TypedArrayType(s, source)
      sourceSlots == O(s, source).slots
  IN IF IsTypedArrayOutOfBounds(s, source) THEN ThrowTypeError(s)
     ELSE LET length == TypedArrayLength(s, source)
              byteLength == ElementSize(elementType) * length
              data == IF elementType = sourceType
                      THEN CloneArrayBuffer(s, sourceSlots.buffer, sourceSlots.byteOffset, byteLength)
                      ELSE AllocateBuffer(s, Intrinsic(s, "ArrayBuffer"), NumFromInt(byteLength), Empty, FALSE)
          IN IF IsAbrupt(data) THEN data
             ELSE IF IsBigIntElementType(elementType) # IsBigIntElementType(sourceType) THEN ThrowTypeError(data.s)
             ELSE LET filled == IF elementType = sourceType THEN data.s
                                ELSE CopyConverted(data.s, sourceSlots.buffer, sourceSlots.byteOffset, sourceType,
                                                   Val(data), 0, elementType, length)
                  IN Ok(SetView(filled, ta, Val(data), byteLength, 0, length), Undefined)
\* InitializeTypedArrayFromArrayBuffer (§23.2.5.1.3).
InitializeTypedArrayFromArrayBuffer(s, ta, buffer, byteOffset, length) ==
  LET size == TypedArraySize(s, ta)
      off == ToIndex(s, byteOffset)
  IN IF IsAbrupt(off) THEN off
     ELSE IF ~NumIsZero(NumRemainder(Val(off).value, NumFromInt(size))) THEN ThrowError(off.s, "RangeError")
     ELSE LET newLength == IF length = Undefined THEN Ok(off.s, Empty) ELSE ToIndex(off.s, length) IN
     IF IsAbrupt(newLength) THEN newLength
     ELSE IF IsDetachedBuffer(newLength.s, buffer) THEN ThrowTypeError(newLength.s)
     ELSE LET t == newLength.s
              bufferByteLength == ArrayBufferByteLength(t, buffer)
              offset == Val(off).value
          IN IF NumLess(NumFromInt(bufferByteLength), offset) THEN ThrowError(t, "RangeError")
             ELSE IF length = Undefined /\ ~IsFixedLengthArrayBuffer(t, buffer)
             THEN Ok(SetView(t, ta, buffer, Empty, NumToSmallInt(offset), Empty), Undefined)
             ELSE IF length = Undefined THEN
               IF bufferByteLength % size # 0 THEN ThrowError(t, "RangeError")
               ELSE LET byteLength == bufferByteLength - NumToSmallInt(offset)
                    IN Ok(SetView(t, ta, buffer, byteLength, NumToSmallInt(offset), byteLength \div size), Undefined)
             ELSE IF NumLess(NumFromInt(bufferByteLength), Val(newLength).value) \/
                     NumToSmallInt(offset) + NumToSmallInt(Val(newLength).value) * size > bufferByteLength
             THEN ThrowError(t, "RangeError")
             ELSE LET elements == NumToSmallInt(Val(newLength).value)
                  IN Ok(SetView(t, ta, buffer, elements * size, NumToSmallInt(offset), elements), Undefined)
\* InitializeTypedArrayFromElements (§23.2.5.1.5), which InitializeTypedArrayFromList and the
\* array-like case share.
InitializeTypedArrayFromElements(s, ta, source) ==
  LET using == GetMethod(s, source, SymIterator) IN
  IF IsAbrupt(using) THEN using
  ELSE IF Val(using) # Undefined THEN
    LET it == GetIteratorFromMethod(using.s, source, Val(using)) IN IF IsAbrupt(it) THEN it ELSE
    LET list == IteratorToList(it.s, Val(it), <<>>) IN IF IsAbrupt(list) THEN list ELSE
    LET b == AllocateTypedArrayBuffer(list.s, ta, NumFromInt(Len(Val(list)))) IN IF IsAbrupt(b) THEN b
    ELSE TypedArraySetElements(b.s, ta, Val(list), Empty, 0, Len(Val(list)), Undefined, Undefined)
  ELSE LET len == LengthOfArrayLike(using.s, source) IN IF IsAbrupt(len) THEN len ELSE
       LET b == AllocateTypedArrayBuffer(len.s, ta, Val(len).value) IN IF IsAbrupt(b) THEN b
       ELSE TypedArraySetElements(b.s, ta, Empty, source, 0, NumToSmallInt(Val(len).value), Undefined, Undefined)
\* Sets the elements k up to len of ta from the list values, or else from the array-like source,
\* each mapped by mapper unless it is Undefined. SetElementsRun takes at most 2^depth steps nested
\* depth deep, so a long list needs no frame per element.
TypedArraySetElements(s, ta, values, source, k, len, mapper, thisArg) ==
  SetElementsFrom(s, [ta |-> ta, values |-> values, source |-> source, len |-> len, mapper |-> mapper, thisArg |-> thisArg], k, 0)
SetElementsStep(s, loop, k) ==
  IF k >= loop.len THEN Ok(s, loop.ta)
  ELSE LET v == IF loop.values # Empty THEN Ok(s, loop.values[k + 1]) ELSE Get(s, loop.source, Index(NumFromInt(k))) IN
       IF IsAbrupt(v) THEN v ELSE
       LET mapped == IF loop.mapper = Undefined THEN v ELSE Call(v.s, loop.mapper, loop.thisArg, <<Val(v), IntV(k)>>) IN
       IF IsAbrupt(mapped) THEN mapped ELSE
       LET w == TypedArraySetElement(mapped.s, loop.ta, NumFromInt(k), Val(mapped)) IN
       IF IsAbrupt(w) THEN w ELSE [s |-> w.s, c |-> Completion("iterate", k + 1, Empty)]
SetElementsRun(s, loop, k, depth) ==
  IF depth = 0 THEN SetElementsStep(s, loop, k)
  ELSE LET r == SetElementsRun(s, loop, k, depth - 1) IN
       IF r.c.type = "iterate" THEN SetElementsRun(r.s, loop, Val(r), depth - 1) ELSE r
SetElementsFrom(s, loop, k, depth) ==
  LET r == SetElementsRun(s, loop, k, depth) IN
  IF r.c.type = "iterate" THEN SetElementsFrom(r.s, loop, Val(r), depth + 1) ELSE r
\* The TypedArray constructors (§23.2.5.1).
TypedArrayConstruct(s, name, args, nt) ==
  IF nt = Undefined THEN ThrowTypeError(s)
  ELSE IF args = <<>> THEN AllocateTypedArray(s, name, nt, PosZero)
  ELSE IF IsObject(args[1]) THEN
    LET first == args[1]
        obj == AllocateTypedArray(s, name, nt, Empty)
    IN IF IsAbrupt(obj) THEN obj ELSE
       LET r == CASE O(obj.s, first).class = "typedArray" -> InitializeTypedArrayFromTypedArray(obj.s, Val(obj), first)
                  [] O(obj.s, first).class = "arrayBuffer" ->
                       InitializeTypedArrayFromArrayBuffer(obj.s, Val(obj), first, Arg(args, 2), Arg(args, 3))
                  [] OTHER -> InitializeTypedArrayFromElements(obj.s, Val(obj), first)
       IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(obj))
  ELSE LET n == ToIndex(s, args[1]) IN IF IsAbrupt(n) THEN n ELSE AllocateTypedArray(n.s, name, nt, Val(n).value)
\* %TypedArray%.from (§23.2.2.1).
TypedArrayFrom(s, ctor, source, mapper, thisArg) ==
  IF ~IsConstructor(s, ctor) THEN ThrowTypeError(s)
  ELSE IF mapper # Undefined /\ ~IsCallable(s, mapper) THEN ThrowTypeError(s)
  ELSE LET using == GetMethod(s, source, SymIterator) IN
  IF IsAbrupt(using) THEN using
  ELSE IF Val(using) # Undefined THEN
    LET it == GetIteratorFromMethod(using.s, source, Val(using)) IN IF IsAbrupt(it) THEN it ELSE
    LET values == IteratorToList(it.s, Val(it), <<>>) IN IF IsAbrupt(values) THEN values ELSE
    LET target == TypedArrayCreateFromConstructor(values.s, ctor, <<IntV(Len(Val(values)))>>, TRUE) IN
    IF IsAbrupt(target) THEN target
    ELSE TypedArraySetElements(target.s, Val(target), Val(values), Empty, 0, Len(Val(values)), mapper, thisArg)
  ELSE LET arrayLike == ToObject(using.s, source) IN
       LET len == LengthOfArrayLike(arrayLike.s, Val(arrayLike)) IN IF IsAbrupt(len) THEN len ELSE
       LET target == TypedArrayCreateFromConstructor(len.s, ctor, <<Val(len)>>, TRUE) IN
       IF IsAbrupt(target) THEN target
       ELSE TypedArraySetElements(target.s, Val(target), Empty, Val(arrayLike), 0, NumToSmallInt(Val(len).value), mapper, thisArg)
\* SetTypedArrayFromTypedArray (§23.2.3.26.2), with targetOffset a Number.
SetTypedArrayFromTypedArray(s, target, targetOffset, source) ==
  LET targetLength == ValidateTypedArrayBounds(s, target) IN IF IsAbrupt(targetLength) THEN targetLength ELSE
  LET sourceLength == ValidateTypedArrayBounds(targetLength.s, source) IN IF IsAbrupt(sourceLength) THEN sourceLength
  ELSE IF targetOffset = PosInf \/
          NumLess(NumFromInt(Val(targetLength)), NumAdd(NumFromInt(Val(sourceLength)), targetOffset))
  THEN ThrowError(sourceLength.s, "RangeError")
  ELSE IF IsBigIntTypedArray(s, target) # IsBigIntTypedArray(s, source) THEN ThrowTypeError(sourceLength.s)
  ELSE LET t == sourceLength.s
           sourceSlots == O(t, source).slots
           targetSlots == O(t, target).slots
           isSameBuffer == SameValue(sourceSlots.buffer, targetSlots.buffer)
           clone == IF isSameBuffer
                    THEN CloneArrayBuffer(t, sourceSlots.buffer, sourceSlots.byteOffset, TypedArrayByteLength(t, source))
                    ELSE Ok(t, sourceSlots.buffer)
       IN IF IsAbrupt(clone) THEN clone ELSE
          LET sourceIndex == IF isSameBuffer THEN 0 ELSE sourceSlots.byteOffset
              targetSize == TypedArraySize(t, target)
              targetIndex == NumToSmallInt(targetOffset) * targetSize + targetSlots.byteOffset
              count == Val(sourceLength)
          IN Ok(IF TypedArrayType(t, source) = TypedArrayType(t, target)
                THEN SetBufferBytes(clone.s, targetSlots.buffer, targetIndex,
                                    BufferBytes(clone.s, Val(clone), sourceIndex, targetSize * count))
                ELSE CopyConverted(clone.s, Val(clone), sourceIndex, TypedArrayType(t, source),
                                   targetSlots.buffer, targetIndex, TypedArrayType(t, target), count),
                Undefined)
\* SetTypedArrayFromArrayLike (§23.2.3.26.1), with targetOffset a Number.
SetTypedArrayFromArrayLike(s, target, targetOffset, source) ==
  LET targetLength == ValidateTypedArrayBounds(s, target) IN IF IsAbrupt(targetLength) THEN targetLength ELSE
  LET src == ToObject(targetLength.s, source) IN IF IsAbrupt(src) THEN src ELSE
  LET sourceLength == LengthOfArrayLike(src.s, Val(src)) IN IF IsAbrupt(sourceLength) THEN sourceLength
  ELSE IF targetOffset = PosInf \/
          NumLess(NumFromInt(Val(targetLength)), NumAdd(Val(sourceLength).value, targetOffset))
  THEN ThrowError(sourceLength.s, "RangeError")
  ELSE SetFromArrayLike(sourceLength.s, target, NumToSmallInt(targetOffset), Val(src), 0,
                        NumToSmallInt(Val(sourceLength).value))
SetFromArrayLike(s, target, offset, source, k, len) ==
  IF k >= len THEN Ok(s, Undefined)
  ELSE LET v == Get(s, source, Index(NumFromInt(k))) IN IF IsAbrupt(v) THEN v ELSE
       LET w == TypedArraySetElement(v.s, target, NumFromInt(offset + k), Val(v)) IN
       IF IsAbrupt(w) THEN w ELSE SetFromArrayLike(w.s, target, offset, source, k + 1, len)
\* %TypedArray%.prototype.subarray (§23.2.3.30).
TypedArraySubarray(s, ta, start, end) ==
  IF ~IsTypedArray(s, ta) THEN ThrowTypeError(s)
  ELSE LET sourceLength == IF IsTypedArrayOutOfBounds(s, ta) THEN 0 ELSE TypedArrayLength(s, ta)
           first == ToClampedIndex(s, start, sourceLength)
       IN IF IsAbrupt(first) THEN first ELSE
          LET slots == O(first.s, ta).slots
              begin == IntV(slots.byteOffset + Val(first) * TypedArraySize(first.s, ta))
          IN IF slots.arrayLength = Empty /\ end = Undefined
             THEN TypedArraySpeciesCreate(first.s, ta, <<slots.buffer, begin>>, FALSE)
             ELSE LET final == IF end = Undefined THEN Ok(first.s, sourceLength) ELSE ToClampedIndex(first.s, end, sourceLength) IN
                  IF IsAbrupt(final) THEN final
                  ELSE TypedArraySpeciesCreate(final.s, ta, <<slots.buffer, begin, IntV(IntegerMax(Val(final) - Val(first), 0))>>, FALSE)
\* The loops of every, some, forEach, find, findIndex, findLast, and findLastIndex (§23.2.3), which
\* visit k upward or, for findLast and findLastIndex, downward.
TypedArrayVisit(s, ta, len, k, m, callback, thisArg) ==
  IF k >= len \/ k < 0 THEN
    Ok(s, CASE m = "every" -> True [] m = "some" -> False [] m \in {"findIndex", "findLastIndex"} -> IntV(-1)
            [] OTHER -> Undefined)
  ELSE LET v == TypedArrayGetElement(s, ta, NumFromInt(k))
           r == Call(s, callback, thisArg, <<v, IntV(k), ta>>)
       IN IF IsAbrupt(r) THEN r
          ELSE IF m = "every" /\ ~ToBooleanValue(Val(r)) THEN Ok(r.s, False)
          ELSE IF m = "some" /\ ToBooleanValue(Val(r)) THEN Ok(r.s, True)
          ELSE IF m \in {"find", "findLast"} /\ ToBooleanValue(Val(r)) THEN Ok(r.s, v)
          ELSE IF m \in {"findIndex", "findLastIndex"} /\ ToBooleanValue(Val(r)) THEN Ok(r.s, IntV(k))
          ELSE TypedArrayVisit(r.s, ta, len, IF m \in {"findLast", "findLastIndex"} THEN k - 1 ELSE k + 1, m, callback, thisArg)
\* The elements of filter that callback selects.
FilterFrom(s, ta, len, k, callback, thisArg, kept) ==
  IF k >= len THEN Ok(s, kept)
  ELSE LET v == TypedArrayGetElement(s, ta, NumFromInt(k))
           r == Call(s, callback, thisArg, <<v, IntV(k), ta>>)
       IN IF IsAbrupt(r) THEN r
          ELSE FilterFrom(r.s, ta, len, k + 1, callback, thisArg, IF ToBooleanValue(Val(r)) THEN Append(kept, v) ELSE kept)
MapFromTypedArray(s, ta, target, k, len, callback, thisArg) ==
  IF k >= len THEN Ok(s, target)
  ELSE LET v == Call(s, callback, thisArg, <<TypedArrayGetElement(s, ta, NumFromInt(k)), IntV(k), ta>>) IN
       IF IsAbrupt(v) THEN v ELSE
       LET w == TypedArraySetElement(v.s, target, NumFromInt(k), Val(v)) IN
       IF IsAbrupt(w) THEN w ELSE MapFromTypedArray(w.s, ta, target, k + 1, len, callback, thisArg)
ReduceFrom(s, ta, len, k, step, callback, accumulator) ==
  IF k < 0 \/ k >= len THEN Ok(s, accumulator)
  ELSE LET r == Call(s, callback, Undefined, <<accumulator, TypedArrayGetElement(s, ta, NumFromInt(k)), IntV(k), ta>>) IN
       IF IsAbrupt(r) THEN r ELSE ReduceFrom(r.s, ta, len, k + step, step, callback, Val(r))
\* Stores values[k + 1] onwards into ta from index k. StoreRun stores at most 2^depth values nested
\* depth deep, so a long list needs no frame per element.
StoreElements(s, ta, values, k) == StoreFrom(s, ta, values, k, 0)
StoreRun(s, ta, values, k, depth) ==
  CASE k >= Len(values) -> [s |-> s, k |-> k]
    [] depth = 0 -> [s |-> TypedArrayStore(s, ta, NumFromInt(k), values[k + 1]), k |-> k + 1]
    [] OTHER -> LET r == StoreRun(s, ta, values, k, depth - 1) IN StoreRun(r.s, ta, values, r.k, depth - 1)
StoreFrom(s, ta, values, k, depth) ==
  IF k >= Len(values) THEN s
  ELSE LET r == StoreRun(s, ta, values, k, depth) IN StoreFrom(r.s, ta, values, r.k, depth + 1)
TypedArrayElements(s, ta, len) == [i \in 1..len |-> TypedArrayGetElement(s, ta, NumFromInt(i - 1))]
\* The first index from k up, or the last from k down, of an element strictly equal to target,
\* or -1.
StrictIndexFrom(s, ta, target, k, len, step) ==
  IF k < 0 \/ k >= len THEN -1
  ELSE IF IsValidIntegerIndex(s, ta, NumFromInt(k)) /\ IsStrictlyEqual(target, TypedArrayGetElement(s, ta, NumFromInt(k)))
  THEN k
  ELSE StrictIndexFrom(s, ta, target, k + step, len, step)
\* JoinIndexedProperties (§23.1.3.18.1) on a TypedArray, whose elements convert to strings without
\* running code.
JoinElements(s, ta, k, len, separator) ==
  IF k >= len THEN <<>>
  ELSE LET e == TypedArrayGetElement(s, ta, NumFromInt(k))
       IN (IF k > 0 THEN separator ELSE <<>>) \o (IF e = Undefined THEN <<>> ELSE PrimitiveToUnits(e)) \o
          JoinElements(s, ta, k + 1, len, separator)
\* JoinIndexedProperties with the method "toLocaleString", and "," as the list separator.
LocaleJoin(s, ta, k, len, acc) ==
  IF k >= len THEN Ok(s, Str(acc))
  ELSE LET prefix == IF k > 0 THEN acc \o N(",") ELSE acc
           e == TypedArrayGetElement(s, ta, NumFromInt(k))
       IN IF e = Undefined THEN LocaleJoin(s, ta, k + 1, len, prefix)
          ELSE LET r == Invoke(s, e, SV("toLocaleString"), <<>>) IN IF IsAbrupt(r) THEN r ELSE
               LET str == ToStr(r.s, Val(r)) IN IF IsAbrupt(str) THEN str
               ELSE LocaleJoin(str.s, ta, k + 1, len, prefix \o Val(str).value)
\* Copies count bytes one at a time upward, as slice does between two TypedArrays of a type. That
\* copies them all at once unless the target starts within the bytes still to copy.
CopyBytesUp(s, from, fromIndex, to, toIndex, count) ==
  CASE count <= 0 -> s
    [] from # to \/ toIndex <= fromIndex \/ toIndex >= fromIndex + count ->
         SetBufferBytes(s, to, toIndex, BufferBytes(s, from, fromIndex, count))
    [] OTHER -> CopyBytesUp(SetBufferBytes(s, to, toIndex, BufferBytes(s, from, fromIndex, 1)),
                            from, fromIndex + 1, to, toIndex + 1, count - 1)
\* CompareTypedArrayElements (§23.2.4.7), as a Number.
CompareTypedArrayElements(s, x, y, comparator) ==
  IF comparator # Undefined THEN
    LET r == Call(s, comparator, Undefined, <<x, y>>) IN IF IsAbrupt(r) THEN r ELSE
    LET n == ToNumber(r.s, Val(r)) IN IF IsAbrupt(n) THEN n
    ELSE Ok(n.s, IF NumIsNaN(Val(n).value) THEN PosZero ELSE Val(n).value)
  ELSE Ok(s, CASE IsBigInt(x) ->
                    IF BigIntLess(x.value, y.value) THEN NumFromInt(-1)
                    ELSE IF BigIntLess(y.value, x.value) THEN OneNum ELSE PosZero
               [] NumIsNaN(x.value) /\ NumIsNaN(y.value) -> PosZero
               [] NumIsNaN(x.value) -> OneNum
               [] NumIsNaN(y.value) -> NumFromInt(-1)
               [] NumLess(x.value, y.value) -> NumFromInt(-1)
               [] NumLess(y.value, x.value) -> OneNum
               [] x.value = NegZero /\ y.value = PosZero -> NumFromInt(-1)
               [] x.value = PosZero /\ y.value = NegZero -> OneNum
               [] OTHER -> PosZero)
\* The sort of SortIndexedProperties (§23.1.3.30.1): a stable merge sort by
\* CompareTypedArrayElements, which stops at the first abrupt comparison.
SortElements(s, values, comparator) ==
  IF Len(values) <= 1 THEN Ok(s, values)
  ELSE LET half == Len(values) \div 2
           left == SortElements(s, SubSeq(values, 1, half), comparator)
       IN IF IsAbrupt(left) THEN left ELSE
          LET right == SortElements(left.s, SubSeq(values, half + 1, Len(values)), comparator) IN
          IF IsAbrupt(right) THEN right ELSE MergeElements(right.s, Val(left), Val(right), comparator, <<>>)
MergeElements(s, left, right, comparator, acc) ==
  IF left = <<>> THEN Ok(s, acc \o right)
  ELSE IF right = <<>> THEN Ok(s, acc \o left)
  ELSE LET c == CompareTypedArrayElements(s, Head(left), Head(right), comparator) IN
       IF IsAbrupt(c) THEN c
       ELSE IF NumLess(PosZero, Val(c)) THEN MergeElements(c.s, left, Tail(right), comparator, Append(acc, Head(right)))
       ELSE MergeElements(c.s, Tail(left), right, comparator, Append(acc, Head(left)))
\* The %TypedArray%.prototype methods (§23.2.3) that start with ValidateTypedArray, on ta of
\* length len.
TypedArrayMethod(s, ta, len, m, args) ==
  LET a1 == Arg(args, 1)
      a2 == Arg(args, 2)
      a3 == Arg(args, 3)
  IN
  CASE m = "at" ->
         LET k == ToAbsoluteIndex(s, a1, len) IN IF IsAbrupt(k) THEN k
         ELSE Ok(k.s, IF NumLess(Val(k), PosZero) \/ ~NumLess(Val(k), NumFromInt(len)) THEN Undefined
                      ELSE TypedArrayGetElement(k.s, ta, Val(k)))
    [] m = "copyWithin" ->
         LET to == ToClampedIndex(s, a1, len) IN IF IsAbrupt(to) THEN to ELSE
         LET from == ToClampedIndex(to.s, a2, len) IN IF IsAbrupt(from) THEN from ELSE
         LET final == IF a3 = Undefined THEN Ok(from.s, len) ELSE ToClampedIndex(from.s, a3, len) IN
         IF IsAbrupt(final) THEN final
         ELSE IF IntegerMin(Val(final) - Val(from), len - Val(to)) <= 0 THEN Ok(final.s, ta)
         ELSE LET b == ValidateTypedArrayBounds(final.s, ta) IN IF IsAbrupt(b) THEN b ELSE
              LET count == IntegerMin(IntegerMin(Val(final) - Val(from), len - Val(to)),
                                      IntegerMin(Val(b) - Val(from), Val(b) - Val(to)))
                  size == TypedArraySize(b.s, ta)
                  slots == O(b.s, ta).slots
                  fromByte == Val(from) * size + slots.byteOffset
              IN Ok(IF count <= 0 THEN b.s
                    ELSE SetBufferBytes(b.s, slots.buffer, Val(to) * size + slots.byteOffset,
                                        BufferBytes(b.s, slots.buffer, fromByte, count * size)), ta)
    [] m = "entries" -> CreateArrayIterator(s, ta, "key+value")
    [] m = "keys" -> CreateArrayIterator(s, ta, "key")
    [] m = "values" -> CreateArrayIterator(s, ta, "value")
    [] m \in {"every", "some", "forEach", "map", "filter", "reduce", "reduceRight",
              "find", "findIndex", "findLast", "findLastIndex"} /\ ~IsCallable(s, a1) -> ThrowTypeError(s)
    [] m \in {"every", "some", "forEach", "find", "findIndex"} -> TypedArrayVisit(s, ta, len, 0, m, a1, a2)
    [] m \in {"findLast", "findLastIndex"} -> TypedArrayVisit(s, ta, len, len - 1, m, a1, a2)
    [] m = "fill" ->
         LET v == IF IsBigIntTypedArray(s, ta) THEN ToBigInt(s, a1) ELSE ToNumber(s, a1) IN IF IsAbrupt(v) THEN v ELSE
         LET first == ToClampedIndex(v.s, a2, len) IN IF IsAbrupt(first) THEN first ELSE
         LET final == IF a3 = Undefined THEN Ok(first.s, len) ELSE ToClampedIndex(first.s, a3, len) IN
         IF IsAbrupt(final) THEN final ELSE
         LET b == ValidateTypedArrayBounds(final.s, ta) IN IF IsAbrupt(b) THEN b
         ELSE Ok(StoreElements(b.s, ta, [i \in 1..IntegerMin(Val(final), Val(b)) |-> Val(v)], Val(first)), ta)
    [] m = "filter" ->
         LET kept == FilterFrom(s, ta, len, 0, a1, a2, <<>>) IN IF IsAbrupt(kept) THEN kept ELSE
         LET r == TypedArraySpeciesCreate(kept.s, ta, <<IntV(Len(Val(kept)))>>, TRUE) IN IF IsAbrupt(r) THEN r
         ELSE TypedArraySetElements(r.s, Val(r), Val(kept), Empty, 0, Len(Val(kept)), Undefined, Undefined)
    [] m = "includes" ->
         IF len = 0 THEN Ok(s, False)
         ELSE LET k == ToClampedIndex(s, a2, len) IN IF IsAbrupt(k) THEN k
         ELSE Ok(k.s, Bool(\E i \in Val(k)..(len - 1) : SameValueZero(a1, TypedArrayGetElement(k.s, ta, NumFromInt(i)))))
    [] m = "indexOf" ->
         IF len = 0 THEN Ok(s, IntV(-1))
         ELSE LET k == ToClampedIndex(s, a2, len) IN IF IsAbrupt(k) THEN k
         ELSE Ok(k.s, IntV(StrictIndexFrom(k.s, ta, a1, Val(k), len, 1)))
    [] m = "lastIndexOf" ->
         IF len = 0 THEN Ok(s, IntV(-1))
         ELSE LET k == IF Len(args) < 2 THEN Ok(s, NumFromInt(len - 1)) ELSE ToAbsoluteIndex(s, a2, len) IN
         IF IsAbrupt(k) THEN k
         ELSE IF NumLess(Val(k), PosZero) THEN Ok(k.s, IntV(-1))
         ELSE Ok(k.s, IntV(StrictIndexFrom(k.s, ta, a1, IF NumLess(Val(k), NumFromInt(len)) THEN NumToSmallInt(Val(k)) ELSE len - 1,
                                           len, -1)))
    [] m = "join" ->
         LET separator == IF a1 = Undefined THEN Ok(s, SV(",")) ELSE ToStr(s, a1) IN IF IsAbrupt(separator) THEN separator
         ELSE Ok(separator.s, Str(JoinElements(separator.s, ta, 0, len, Val(separator).value)))
    [] m = "map" ->
         LET r == TypedArraySpeciesCreate(s, ta, <<IntV(len)>>, TRUE) IN IF IsAbrupt(r) THEN r
         ELSE MapFromTypedArray(r.s, ta, Val(r), 0, len, a1, a2)
    [] m \in {"reduce", "reduceRight"} ->
         LET step == IF m = "reduce" THEN 1 ELSE -1
             start == IF m = "reduce" THEN 0 ELSE len - 1
         IN IF Len(args) >= 2 THEN ReduceFrom(s, ta, len, start, step, a1, a2)
            ELSE IF len = 0 THEN ThrowTypeError(s)
            ELSE ReduceFrom(s, ta, len, start + step, step, a1, TypedArrayGetElement(s, ta, NumFromInt(start)))
    [] m = "reverse" -> Ok(StoreElements(s, ta, [i \in 1..len |-> TypedArrayGetElement(s, ta, NumFromInt(len - i))], 0), ta)
    [] m = "slice" ->
         LET first == ToClampedIndex(s, a1, len) IN IF IsAbrupt(first) THEN first ELSE
         LET final == IF a2 = Undefined THEN Ok(first.s, len) ELSE ToClampedIndex(first.s, a2, len) IN
         IF IsAbrupt(final) THEN final ELSE
         LET count == IntegerMax(Val(final) - Val(first), 0)
             r == TypedArraySpeciesCreate(final.s, ta, <<IntV(count)>>, TRUE)
         IN IF IsAbrupt(r) \/ count = 0 THEN r ELSE
            LET b == ValidateTypedArrayBounds(r.s, ta) IN IF IsAbrupt(b) THEN b ELSE
            LET end == IntegerMin(Val(final), Val(b))
                size == TypedArraySize(b.s, ta)
                sourceSlots == O(b.s, ta).slots
                targetSlots == O(b.s, Val(r)).slots
            IN Ok(IF TypedArrayType(b.s, ta) = TypedArrayType(b.s, Val(r))
                  THEN CopyBytesUp(b.s, sourceSlots.buffer, Val(first) * size + sourceSlots.byteOffset,
                                   targetSlots.buffer, targetSlots.byteOffset, IntegerMax(end - Val(first), 0) * size)
                  ELSE StoreElements(b.s, Val(r), [i \in 1..IntegerMax(end - Val(first), 0) |->
                                                     TypedArrayGetElement(b.s, ta, NumFromInt(Val(first) + i - 1))], 0),
                  Val(r))
    [] m = "sort" ->
         LET sorted == SortElements(s, TypedArrayElements(s, ta, len), a1) IN IF IsAbrupt(sorted) THEN sorted
         ELSE Ok(StoreElements(sorted.s, ta, Val(sorted), 0), ta)
    [] m = "toSorted" ->
         LET r == TypedArrayCreateSameType(s, ta, len) IN IF IsAbrupt(r) THEN r ELSE
         LET sorted == SortElements(r.s, TypedArrayElements(r.s, ta, len), a1) IN IF IsAbrupt(sorted) THEN sorted
         ELSE Ok(StoreElements(sorted.s, Val(r), Val(sorted), 0), Val(r))
    [] m = "toLocaleString" -> LocaleJoin(s, ta, 0, len, <<>>)
    [] m = "toReversed" ->
         LET r == TypedArrayCreateSameType(s, ta, len) IN IF IsAbrupt(r) THEN r
         ELSE Ok(StoreElements(r.s, Val(r), [i \in 1..len |-> TypedArrayGetElement(r.s, ta, NumFromInt(len - i))], 0), Val(r))
    [] m = "with" ->
         LET index == ToAbsoluteIndex(s, a1, len) IN IF IsAbrupt(index) THEN index ELSE
         LET v == IF IsBigIntTypedArray(s, ta) THEN ToBigInt(index.s, a2) ELSE ToNumber(index.s, a2) IN
         IF IsAbrupt(v) THEN v
         ELSE IF ~IsValidIntegerIndex(v.s, ta, Val(index)) THEN ThrowError(v.s, "RangeError")
         ELSE LET r == TypedArrayCreateSameType(v.s, ta, len) IN IF IsAbrupt(r) THEN r
         ELSE TypedArraySetElements(r.s, Val(r), [i \in 1..len |-> IF i - 1 = NumToSmallInt(Val(index)) THEN Val(v)
                                                         ELSE TypedArrayGetElement(r.s, ta, NumFromInt(i - 1))],
                          Empty, 0, len, Undefined, Undefined)
\* %TypedArray% (§23.2.1 to §23.2.3) and the TypedArray constructors (§23.2.5).
TypedArrayBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1)
      a2 == Arg(args, 2)
  IN
  CASE m = "constructor" -> ThrowTypeError(s)
    [] m \in Range(TypedArrayNames) -> TypedArrayConstruct(s, m, args, nt)
    [] m = "from" -> TypedArrayFrom(s, this, a1, a2, Arg(args, 3))
    \* %TypedArray%.of (§23.2.2.2).
    [] m = "of" ->
         IF ~IsConstructor(s, this) THEN ThrowTypeError(s)
         ELSE LET target == TypedArrayCreateFromConstructor(s, this, <<IntV(Len(args))>>, TRUE) IN
              IF IsAbrupt(target) THEN target
              ELSE TypedArraySetElements(target.s, Val(target), args, Empty, 0, Len(args), Undefined, Undefined)
    [] m = "species" -> Ok(s, this)
    [] m = "toStringTag" -> Ok(s, IF IsTypedArray(s, this) THEN Str(TypedArrayNameUnits(O(s, this).slots.name)) ELSE Undefined)
    [] m \in {"buffer", "byteLength", "byteOffset", "length"} ->
         IF ~IsTypedArray(s, this) THEN ThrowTypeError(s)
         ELSE Ok(s, CASE m = "buffer" -> O(s, this).slots.buffer
                      [] IsTypedArrayOutOfBounds(s, this) -> IntV(0)
                      [] m = "byteLength" -> IntV(TypedArrayByteLength(s, this))
                      [] m = "byteOffset" -> IntV(O(s, this).slots.byteOffset)
                      [] OTHER -> IntV(TypedArrayLength(s, this)))
    \* %TypedArray%.prototype.set (§23.2.3.26).
    [] m = "set" ->
         IF ~IsTypedArray(s, this) \/ IsImmutableBuffer(s, O(s, this).slots.buffer) THEN ThrowTypeError(s)
         ELSE LET offset == ToIntegerOrInfinity(s, a2) IN IF IsAbrupt(offset) THEN offset
         ELSE IF NumLess(Val(offset).value, PosZero) THEN ThrowError(offset.s, "RangeError")
         ELSE IF IsTypedArray(offset.s, a1) THEN SetTypedArrayFromTypedArray(offset.s, this, Val(offset).value, a1)
         ELSE SetTypedArrayFromArrayLike(offset.s, this, Val(offset).value, a1)
    [] m = "subarray" -> TypedArraySubarray(s, this, a1, a2)
    [] m \in {"sort", "toSorted"} /\ a1 # Undefined /\ ~IsCallable(s, a1) -> ThrowTypeError(s)
    [] OTHER ->
         LET len == IF m \in {"copyWithin", "fill", "reverse", "sort"} THEN ValidateTypedArrayForWrite(s, this)
                    ELSE ValidateTypedArray(s, this)
         IN IF IsAbrupt(len) THEN len ELSE TypedArrayMethod(len.s, this, Val(len), m, args)
\* Uint8Array to and from base64 and hex (§23.3). Bytes are integers 0 to 255, and a base64 chunk
\* holds the values 0 to 63 of its characters in the standard alphabet.
\* ValidateUint8Array (§23.3.3.1), for an access that writes or only reads, as
\* proposal-immutable-arraybuffer adds.
ValidateUint8Array(s, ta, isWrite) ==
  IF ~IsTypedArray(s, ta) \/ O(s, ta).slots.name # "Uint8Array" THEN ThrowTypeError(s)
  ELSE IF isWrite /\ IsImmutableBuffer(s, O(s, ta).slots.buffer) THEN ThrowTypeError(s)
  ELSE Ok(s, Empty)
\* GetUint8ArrayBytes (§23.3.3.2).
GetUint8ArrayBytes(s, ta) ==
  LET len == ValidateTypedArrayBounds(s, ta) IN IF IsAbrupt(len) THEN len
  ELSE Ok(len.s, BufferBytes(len.s, O(len.s, ta).slots.buffer, O(len.s, ta).slots.byteOffset, Val(len)))
\* SetUint8ArrayBytes (§23.3.3.3).
SetUint8ArrayBytes(s, into, bytes) == SetBufferBytes(s, O(s, into).slots.buffer, O(s, into).slots.byteOffset, bytes)
\* The alphabet or lastChunkHandling option: the name that allowed maps the option's units to, or
\* fallback when it is undefined.
GetBase64Option(s, options, key, allowed, fallback) ==
  LET value == Get(s, options, key) IN IF IsAbrupt(value) THEN value
  ELSE IF Val(value) = Undefined THEN Ok(value.s, fallback)
  ELSE IF IsString(Val(value)) /\ Val(value).value \in DOMAIN allowed THEN Ok(value.s, allowed[Val(value).value])
  ELSE ThrowTypeError(value.s)
\* The value of a code unit in the standard base64 alphabet, or -1.
Base64Value(u) ==
  CASE u >= 65 /\ u <= 90 -> u - 65
    [] u >= 97 /\ u <= 122 -> u - 71
    [] u >= 48 /\ u <= 57 -> u + 4
    [] u = 43 -> 62
    [] u = 47 -> 63
    [] OTHER -> -1
\* The value of a hex digit, or -1.
HexValue(u) ==
  CASE u >= 48 /\ u <= 57 -> u - 48
    [] u >= 97 /\ u <= 102 -> u - 87
    [] u >= 65 /\ u <= 70 -> u - 55
    [] OTHER -> -1
\* SkipAsciiWhitespace (§23.3.3.4).
SkipAsciiWhitespace(units, index) ==
  IF index < Len(units) /\ units[index + 1] \in {9, 10, 12, 13, 32} THEN SkipAsciiWhitespace(units, index + 1) ELSE index
\* DecodeFullLengthBase64Chunk (§23.3.3.6).
DecodeFullLengthBase64Chunk(chunk) ==
  LET n == ((chunk[1] * 64 + chunk[2]) * 64 + chunk[3]) * 64 + chunk[4]
  IN <<n \div 65536, (n \div 256) % 256, n % 256>>
\* DecodeFinalBase64Chunk (§23.3.3.5): [ok, bytes], with ok FALSE for the SyntaxError.
DecodeFinalBase64Chunk(chunk, throwOnExtraBits) ==
  LET bytes == DecodeFullLengthBase64Chunk(chunk \o Repeat(0, 4 - Len(chunk)))
  IN [ok |-> ~throwOnExtraBits \/ bytes[Len(chunk)] = 0, bytes |-> SubSeq(bytes, 1, Len(chunk) - 1)]
\* The result Record of FromBase64 and FromHex, with error whether it is a SyntaxError.
DecodeResult(read, bytes, error) == [read |-> read, bytes |-> bytes, error |-> error]
\* FromBase64 (§23.3.3.7), with maxLength an integer. Leaving it out is giving one more than the
\* length of units, which no result reaches.
FromBase64(units, alphabet, lastChunkHandling, maxLength) ==
  IF maxLength = 0 THEN DecodeResult(0, <<>>, FALSE)
  ELSE FromBase64From(units, alphabet, lastChunkHandling, maxLength, 0, 0, <<>>, <<>>)
FromBase64From(units, alphabet, lastChunkHandling, maxLength, from, read, bytes, chunk) ==
  LET index == SkipAsciiWhitespace(units, from)
      length == Len(units)
  IN IF index = length THEN
       CASE chunk = <<>> -> DecodeResult(length, bytes, FALSE)
         [] lastChunkHandling = "stop-before-partial" -> DecodeResult(read, bytes, FALSE)
         [] lastChunkHandling = "strict" \/ Len(chunk) = 1 -> DecodeResult(read, bytes, TRUE)
         [] OTHER -> DecodeResult(length, bytes \o DecodeFinalBase64Chunk(chunk, FALSE).bytes, FALSE)
     ELSE LET u == units[index + 1] IN
     IF u = 61 THEN
       IF Len(chunk) < 2 THEN DecodeResult(read, bytes, TRUE) ELSE
       LET padded == SkipAsciiWhitespace(units, index + 1) IN
       IF Len(chunk) = 2 /\ padded = length THEN DecodeResult(read, bytes, lastChunkHandling # "stop-before-partial") ELSE
       LET end == IF Len(chunk) = 2 /\ units[padded + 1] = 61 THEN SkipAsciiWhitespace(units, padded + 1) ELSE padded
           final == DecodeFinalBase64Chunk(chunk, lastChunkHandling = "strict")
       IN IF end < length \/ ~final.ok THEN DecodeResult(read, bytes, TRUE)
          ELSE DecodeResult(length, bytes \o final.bytes, FALSE)
     ELSE LET value == CASE alphabet = "base64url" /\ u \in {43, 47} -> -1
                         [] alphabet = "base64url" /\ u = 45 -> 62
                         [] alphabet = "base64url" /\ u = 95 -> 63
                         [] OTHER -> Base64Value(u)
              remaining == maxLength - Len(bytes)
              next == Append(chunk, value)
              decoded == bytes \o DecodeFullLengthBase64Chunk(next)
     IN CASE value < 0 -> DecodeResult(read, bytes, TRUE)
          [] (remaining = 1 /\ Len(chunk) = 2) \/ (remaining = 2 /\ Len(chunk) = 3) -> DecodeResult(read, bytes, FALSE)
          [] Len(next) < 4 -> FromBase64From(units, alphabet, lastChunkHandling, maxLength, index + 1, read, bytes, next)
          [] Len(decoded) = maxLength -> DecodeResult(index + 1, decoded, FALSE)
          [] OTHER -> FromBase64From(units, alphabet, lastChunkHandling, maxLength, index + 1, index + 1, decoded, <<>>)
\* FromHex (§23.3.3.8), with maxLength an integer.
FromHex(units, maxLength) ==
  IF Len(units) % 2 # 0 THEN DecodeResult(0, <<>>, TRUE) ELSE FromHexFrom(units, maxLength, 0, <<>>)
FromHexFrom(units, maxLength, read, bytes) ==
  IF read >= Len(units) \/ Len(bytes) >= maxLength THEN DecodeResult(read, bytes, FALSE)
  ELSE LET high == HexValue(units[read + 1])
           low == HexValue(units[read + 2])
  IN IF high < 0 \/ low < 0 THEN DecodeResult(read, bytes, TRUE)
     ELSE FromHexFrom(units, maxLength, read + 2, Append(bytes, high * 16 + low))
\* The base64 encoding of section 4 or 5 of RFC 4648, three bytes at a time from index i.
EncodeBase64(bytes, i, digits, omitPadding) ==
  IF i > Len(bytes) THEN <<>> ELSE
  LET left == Len(bytes) - i + 1
      n == (bytes[i] * 256 + (IF left > 1 THEN bytes[i + 1] ELSE 0)) * 256 + (IF left > 2 THEN bytes[i + 2] ELSE 0)
      values == <<n \div 262144, (n \div 4096) % 64, (n \div 64) % 64, n % 64>>
      count == IF left >= 3 THEN 4 ELSE left + 1
  IN [k \in 1..count |-> digits[values[k] + 1]] \o (IF omitPadding THEN <<>> ELSE Repeat(61, 4 - count)) \o
     EncodeBase64(bytes, i + 3, digits, omitPadding)
\* A new Uint8Array of bytes, for fromBase64 and fromHex.
Uint8ArrayOf(s, bytes) ==
  LET ta == AllocateTypedArray(s, "Uint8Array", Intrinsic(s, "Uint8Array"), NumFromInt(Len(bytes))) IN
  IF IsAbrupt(ta) THEN ta ELSE Ok(SetUint8ArrayBytes(ta.s, Val(ta), bytes), Val(ta))
\* The rest of setFromBase64 and setFromHex: writes what result decoded, then throws its error or
\* returns the counts.
SetFromResult(s, into, result) ==
  LET written == SetUint8ArrayBytes(s, into, result.bytes) IN
  IF result.error THEN ThrowError(written, "SyntaxError") ELSE
  LET o == OrdinaryObjectCreate(written, Intrinsic(written, "ObjectPrototype"))
  IN Ok(SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), <<<<SV("read"), IntV(result.read)>>,
                                                          <<SV("written"), IntV(Len(result.bytes))>>>>)),
        Val(o))
\* The alphabet and lastChunkHandling options of fromBase64 and setFromBase64.
GetDecodeOptions(s, options) ==
  LET opts == GetOptionsObject(s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET alphabet == GetBase64Option(opts.s, Val(opts), SV("alphabet"), Base64Alphabets, "base64") IN
  IF IsAbrupt(alphabet) THEN alphabet ELSE
  LET handling == GetBase64Option(alphabet.s, Val(opts), SV("lastChunkHandling"), LastChunkHandlings, "loose")
  IN IF IsAbrupt(handling) THEN handling
     ELSE Ok(handling.s, [alphabet |-> Val(alphabet), lastChunkHandling |-> Val(handling)])
\* Uint8Array.fromBase64, Uint8Array.fromHex, and the Uint8Array.prototype methods (§23.3.1, §23.3.2).
Uint8ArrayBuiltin(s, f, m, this, args, nt) ==
  LET a1 == Arg(args, 1) IN
  CASE m = "fromBase64" ->
         IF ~IsString(a1) THEN ThrowTypeError(s) ELSE
         LET options == GetDecodeOptions(s, Arg(args, 2)) IN IF IsAbrupt(options) THEN options ELSE
         LET result == FromBase64(a1.value, Val(options).alphabet, Val(options).lastChunkHandling, Len(a1.value) + 1)
         IN IF result.error THEN ThrowError(options.s, "SyntaxError") ELSE Uint8ArrayOf(options.s, result.bytes)
    [] m = "fromHex" ->
         IF ~IsString(a1) THEN ThrowTypeError(s) ELSE
         LET result == FromHex(a1.value, Len(a1.value) + 1)
         IN IF result.error THEN ThrowError(s, "SyntaxError") ELSE Uint8ArrayOf(s, result.bytes)
    [] m = "setFromBase64" ->
         LET v == ValidateUint8Array(s, this, TRUE) IN IF IsAbrupt(v) THEN v
         ELSE IF ~IsString(a1) THEN ThrowTypeError(s) ELSE
         LET options == GetDecodeOptions(s, Arg(args, 2)) IN IF IsAbrupt(options) THEN options ELSE
         LET len == ValidateTypedArrayBounds(options.s, this) IN IF IsAbrupt(len) THEN len
         ELSE SetFromResult(len.s, this, FromBase64(a1.value, Val(options).alphabet, Val(options).lastChunkHandling, Val(len)))
    [] m = "setFromHex" ->
         LET v == ValidateUint8Array(s, this, TRUE) IN IF IsAbrupt(v) THEN v
         ELSE IF ~IsString(a1) THEN ThrowTypeError(s) ELSE
         LET len == ValidateTypedArrayBounds(s, this) IN IF IsAbrupt(len) THEN len
         ELSE SetFromResult(len.s, this, FromHex(a1.value, Val(len)))
    [] m = "toBase64" ->
         LET v == ValidateUint8Array(s, this, FALSE) IN IF IsAbrupt(v) THEN v ELSE
         LET opts == GetOptionsObject(s, a1) IN IF IsAbrupt(opts) THEN opts ELSE
         LET alphabet == GetBase64Option(opts.s, Val(opts), SV("alphabet"), Base64Alphabets, "base64") IN
         IF IsAbrupt(alphabet) THEN alphabet ELSE
         LET omitPadding == Get(alphabet.s, Val(opts), SV("omitPadding")) IN IF IsAbrupt(omitPadding) THEN omitPadding ELSE
         LET bytes == GetUint8ArrayBytes(omitPadding.s, this) IN IF IsAbrupt(bytes) THEN bytes
         ELSE Ok(bytes.s, Str(EncodeBase64(Val(bytes), 1, IF Val(alphabet) = "base64" THEN Base64Digits ELSE Base64UrlDigits,
                                           ToBooleanValue(Val(omitPadding)))))
    [] m = "toHex" ->
         LET v == ValidateUint8Array(s, this, FALSE) IN IF IsAbrupt(v) THEN v ELSE
         LET bytes == GetUint8ArrayBytes(s, this) IN IF IsAbrupt(bytes) THEN bytes
         ELSE Ok(bytes.s, Str(FoldLeftSeq([i \in DOMAIN Val(bytes) |->
                                             <<HexDigits[Val(bytes)[i] \div 16 + 1], HexDigits[(Val(bytes)[i] % 16) + 1]>>])))
\* Generators, async functions, and async generators (§27.3 to §27.7). A body suspends at a yield
\* or await with a suspend completion (see Suspend), and its driver keeps the frames to resume it
\* from. A generator object has class "generator" or "asyncGenerator" and slots:
\*   state   "suspendedStart", "suspendedYield", "executing", "draining-queue", or "completed"
\*   frames  where the body resumes once suspended
\*   ctx     the context the body runs in
\*   body    the body node
\*   queue   an async generator's requests, as [completion, capability] records
\*   brand   the [[GeneratorBrand]], Empty for generators that functions make
\* Await (§6.2.3.1): suspends the body on v, which its driver resolves.
Await(s, v) == Suspend(s, "await", v)
AwaitThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "AwaitThen", <<>>) ELSE IF IsAbrupt(r) THEN r ELSE Await(r.s, Val(r))
AwaitIfAsync(kind, r) == IF IsAbrupt(r) \/ kind = "sync" THEN r ELSE Await(r.s, Val(r))
GeneratorSlots(ctx, body) ==
  [state |-> "suspendedStart", frames |-> <<>>, ctx |-> ctx, body |-> body, queue |-> <<>>, brand |-> Empty]
GeneratorState(s, gen) == O(s, gen).slots.state
\* Starts running a generator's body from its first statement.
RunGeneratorBody(s, gen) ==
  LET slots == O(s, gen).slots IN
  EvaluateDisposing(s, [slots.ctx EXCEPT !.gen = gen], slots.body.FunctionStatementList)
\* EvaluateGeneratorBody (§15.5.2): the function's call returns the new generator.
EvaluateGeneratorBody(s, f, ctx, args) ==
  LET i == FunctionDeclarationInstantiation(s, f, ctx, args) IN
  IF IsAbrupt(i) THEN i ELSE
  LET g == OrdinaryCreateFromConstructor(i.s, f, "GeneratorPrototype", "generator", GeneratorSlots(Val(i), O(i.s, f).slots.body)) IN
  IF IsAbrupt(g) THEN g ELSE Abrupt(g.s, Completion("return", Val(g), Empty))
\* Yield (§15.5.5), for `yield` and `yield expr`.
EvaluateYield(s, ctx, n) ==
  IF n.hasStar THEN YieldStarThen(ctx, EvaluateValue(s, ctx, n.AssignmentExpression))
  ELSE YieldThen(ctx, IF Has(n.AssignmentExpression) THEN EvaluateValue(s, ctx, n.AssignmentExpression) ELSE Ok(s, Undefined))
YieldThen(ctx, r) ==
  IF IsSuspended(r) THEN Pass(r, "YieldThen", <<ctx>>) ELSE IF IsAbrupt(r) THEN r ELSE Yield(r.s, ctx, Val(r))
Yield(s, ctx, v) ==
  IF FunctionKindOf(s, ctx) = "asyncGenerator" THEN AsyncYieldThen(ctx, Await(s, v)) ELSE Suspend(s, "yield", v)
AsyncYieldThen(ctx, r) ==
  IF IsSuspended(r) THEN Pass(r, "AsyncYieldThen", <<ctx>>) ELSE IF IsAbrupt(r) THEN r ELSE AsyncGeneratorYield(r.s, ctx, Val(r))
\* The yield* loop (§15.5.5 steps 7-8) for a delegate iterator it, with kind "sync" or "async".
YieldStarThen(ctx, r) ==
  IF IsSuspended(r) THEN Pass(r, "YieldStarThen", <<ctx>>) ELSE
  IF IsAbrupt(r) THEN r ELSE
  LET kind == IF FunctionKindOf(r.s, ctx) = "asyncGenerator" THEN "async" ELSE "sync"
      it == GetIterator(r.s, Val(r), kind)
  IN IF IsAbrupt(it) THEN it ELSE YieldStarLoop(it.s, ctx, kind, Val(it), NormalCompletion(Undefined))
YieldStarLoop(s, ctx, kind, it, received) ==
  CASE received.type = "normal" ->
         YieldStarInnerThen(ctx, kind, it, AwaitIfAsync(kind, Call(s, it.next, it.iterator, <<received.value>>)))
    [] received.type = "throw" ->
         LET throw == GetMethod(s, it.iterator, SV("throw")) IN
         IF IsAbrupt(throw) THEN throw
         ELSE IF Val(throw) # Undefined
         THEN YieldStarInnerThen(ctx, kind, it, AwaitIfAsync(kind, Call(throw.s, Val(throw), it.iterator, <<received.value>>)))
         ELSE YieldStarNoThrowThen(IF kind = "async" THEN AsyncIteratorClose(throw.s, it, NormalCompletion(Empty))
                                   ELSE IteratorClose(throw.s, it, NormalCompletion(Empty)))
    [] OTHER ->
         LET return == GetMethod(s, it.iterator, SV("return")) IN
         IF IsAbrupt(return) THEN return
         ELSE IF Val(return) = Undefined THEN ReturnValueThen(AwaitIfAsync(kind, Ok(return.s, received.value)))
         ELSE YieldStarReturnThen(ctx, kind, it, AwaitIfAsync(kind, Call(return.s, Val(return), it.iterator, <<received.value>>)))
YieldStarNoThrowThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "YieldStarNoThrowThen", <<>>) ELSE IF IsAbrupt(r) THEN r ELSE ThrowTypeError(r.s)
YieldStarInnerThen(ctx, kind, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "YieldStarInnerThen", <<ctx, kind, it>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE LET done == IteratorComplete(r.s, Val(r)) IN
  IF IsAbrupt(done) THEN done
  ELSE IF Val(done) THEN Get(done.s, Val(r), SV("value"))
  ELSE YieldStarYield(done.s, ctx, kind, it, Val(r))
YieldStarReturnThen(ctx, kind, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "YieldStarReturnThen", <<ctx, kind, it>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF ~IsObject(Val(r)) THEN ThrowTypeError(r.s)
  ELSE LET done == IteratorComplete(r.s, Val(r)) IN
  IF IsAbrupt(done) THEN done
  ELSE IF Val(done) THEN ReturnValueThen(Get(done.s, Val(r), SV("value")))
  ELSE YieldStarYield(done.s, ctx, kind, it, Val(r))
\* A sync generator yields the delegate's result object itself (GeneratorYield(innerResult)).
YieldStarYield(s, ctx, kind, it, innerResult) ==
  IF kind = "sync" THEN YieldStarResumeThen(ctx, kind, it, Suspend(s, "yieldDelegate", innerResult))
  ELSE LET v == Get(s, innerResult, SV("value")) IN
       IF IsAbrupt(v) THEN v ELSE YieldStarResumeThen(ctx, kind, it, AsyncGeneratorYield(v.s, ctx, Val(v)))
YieldStarResumeThen(ctx, kind, it, r) ==
  IF IsSuspended(r) THEN Pass(r, "YieldStarResumeThen", <<ctx, kind, it>>) ELSE YieldStarLoop(r.s, ctx, kind, it, r.c)
\* GeneratorValidate (§27.5.3.2), returning the generator's state.
GeneratorValidate(s, gen, brand) ==
  IF ~IsObject(gen) \/ O(s, gen).class # "generator" \/ O(s, gen).slots.brand # brand THEN ThrowTypeError(s)
  ELSE IF GeneratorState(s, gen) = "executing" THEN ThrowTypeError(s)
  ELSE Ok(s, GeneratorState(s, gen))
\* GeneratorResume (§27.5.3.3).
GeneratorResume(s, gen, value, brand) ==
  LET state == GeneratorValidate(s, gen, brand) IN
  IF IsAbrupt(state) THEN state
  ELSE IF Val(state) = "completed" THEN CreateIterResultObject(s, Undefined, TRUE)
  ELSE LET s1 == SetSlots(s, gen, [state |-> "executing"]) IN
       GeneratorStep(gen, IF Val(state) = "suspendedStart" THEN RunGeneratorBody(s1, gen)
                          ELSE ResumeFrames(O(s, gen).slots.frames, Ok(s1, value)))
\* GeneratorResumeAbrupt (§27.5.3.4).
GeneratorResumeAbrupt(s, gen, completion, brand) ==
  LET state == GeneratorValidate(s, gen, brand) IN
  IF IsAbrupt(state) THEN state
  ELSE IF Val(state) \in {"suspendedStart", "completed"} THEN
    LET s1 == SetSlots(s, gen, [state |-> "completed"]) IN
    IF completion.type = "return" THEN CreateIterResultObject(s1, completion.value, TRUE) ELSE Abrupt(s1, completion)
  ELSE GeneratorStep(gen, ResumeFrames(O(s, gen).slots.frames, Abrupt(SetSlots(s, gen, [state |-> "executing"]), completion)))
\* How the generator's body stopped: at a yield, or for good (GeneratorStart step 4 and
\* GeneratorYield).
GeneratorStep(gen, r) ==
  IF IsSuspended(r) THEN
    LET s1 == HoldEnvs(SetSlots(r.s, gen, [state |-> "suspendedYield", frames |-> r.c.frames])) IN
    IF r.c.target = "yieldDelegate" THEN Ok(s1, r.c.value) ELSE CreateIterResultObject(s1, r.c.value, FALSE)
  ELSE LET s1 == SetSlots(r.s, gen, [state |-> "completed", frames |-> <<>>]) IN
       CASE r.c.type = "normal" -> CreateIterResultObject(s1, Undefined, TRUE)
         [] r.c.type = "return" -> CreateIterResultObject(s1, r.c.value, TRUE)
         [] OTHER -> Abrupt(s1, r.c)
\* %GeneratorPrototype% (§27.5.1).
GeneratorBuiltin(s, f, m, this, args, nt) ==
  CASE m = "next" -> GeneratorResume(s, this, Arg(args, 1), Empty)
    [] m = "return" -> GeneratorResumeAbrupt(s, this, Completion("return", Arg(args, 1), Empty), Empty)
    [] m = "throw" -> GeneratorResumeAbrupt(s, this, ThrowCompletion(Arg(args, 1)), Empty)
    [] m = "asyncIterator" -> Ok(s, this)
    [] m \in {"generator", "asyncGenerator", "async"} -> CreateDynamicFunction(s, f, nt, m, args)
\* The driver of an async function or async generator body that suspended or completed with r,
\* for owner [kind |-> "async", capability] or [kind |-> "asyncGenerator", generator].
ActivationStep(owner, r) ==
  IF owner.kind = "async" THEN AsyncFunctionStep(owner.capability, r) ELSE AsyncGeneratorStep(owner.generator, r)
\* The rest of Await (§6.2.3.1) once the body suspends: resumes it when the promise for v settles.
PerformAwait(s, owner, frames, v) ==
  LET p == PromiseResolve(s, Intrinsic(s, "Promise"), v) IN
  IF IsAbrupt(p) THEN ActivationStep(owner, ResumeFrames(frames, p))
  ELSE LET data == [owner |-> owner, frames |-> frames]
           onFulfilled == CreateBuiltinFunction(p.s, <<"Await", "fulfilled">>, 1, <<>>, data)
           onRejected == CreateBuiltinFunction(onFulfilled.s, <<"Await", "rejected">>, 1, <<>>, data)
       IN Ok(AddPromiseReactions(onRejected.s, Val(p), Val(onFulfilled), Val(onRejected), Empty).s, Undefined)
\* The closures Await passes to then, which resume the body with the settled value.
AwaitBuiltin(s, f, m, this, args, nt) ==
  LET data == O(s, f).slots.data
      r == ActivationStep(data.owner, ResumeFrames(data.frames, IF m = "fulfilled" THEN Ok(s, Arg(args, 1))
                                                              ELSE ThrowValue(s, Arg(args, 1))))
  IN Ok(r.s, Undefined)
\* EvaluateAsyncFunctionBody and EvaluateAsyncConciseBody (§15.8.4, §15.9.4) with
\* AsyncFunctionStart (§27.7.5.1).
EvaluateAsyncFunctionBody(s, f, ctx, args) ==
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      i == FunctionDeclarationInstantiation(cap.s, f, ctx, args)
      body == O(s, f).slots.body
      started ==
        IF IsAbrupt(i) THEN Call(i.s, Val(cap).reject, Undefined, <<i.c.value>>)
        ELSE AsyncFunctionStep(Val(cap), IF body.type = "AsyncBody" THEN EvaluateDisposing(i.s, Val(i), body.FunctionStatementList)
                                          ELSE ReturnValueThen(EvaluateValue(i.s, Val(i), ConciseExpression(body))))
  IN Abrupt(started.s, Completion("return", Val(cap).promise, Empty))
\* AsyncBlockStart (§27.7.5.2) from where the body stopped.
AsyncFunctionStep(cap, r) ==
  IF IsSuspended(r) THEN PerformAwait(r.s, [kind |-> "async", capability |-> cap], r.c.frames, r.c.value)
  ELSE LET settled == CASE r.c.type = "normal" -> Call(r.s, cap.resolve, Undefined, <<Undefined>>)
                        [] r.c.type = "return" -> Call(r.s, cap.resolve, Undefined, <<r.c.value>>)
                        [] OTHER -> Call(r.s, cap.reject, Undefined, <<r.c.value>>)
       IN Ok(settled.s, Undefined)
\* EvaluateAsyncGeneratorBody (§15.6.2) with AsyncGeneratorStart (§27.6.3.3).
EvaluateAsyncGeneratorBody(s, f, ctx, args) ==
  LET i == FunctionDeclarationInstantiation(s, f, ctx, args) IN
  IF IsAbrupt(i) THEN i ELSE
  LET g == OrdinaryCreateFromConstructor(i.s, f, "AsyncGeneratorPrototype", "asyncGenerator",
                                         GeneratorSlots(Val(i), O(i.s, f).slots.body))
  IN IF IsAbrupt(g) THEN g ELSE Abrupt(g.s, Completion("return", Val(g), Empty))
\* AsyncGeneratorValidate (§27.6.3.2).
IsAsyncGenerator(s, gen, brand) ==
  IsObject(gen) /\ O(s, gen).class = "asyncGenerator" /\ O(s, gen).slots.brand = brand
\* AsyncGeneratorCompleteStep (§27.6.3.4), returning the state.
AsyncGeneratorCompleteStep(s, gen, completion, done) ==
  LET next == Head(O(s, gen).slots.queue)
      s1 == SetSlots(s, gen, [queue |-> Tail(O(s, gen).slots.queue)])
  IN IF completion.type = "throw" THEN Call(s1, next.capability.reject, Undefined, <<completion.value>>).s
     ELSE LET result == CreateIterResultObject(s1, completion.value, done) IN
          Call(result.s, next.capability.resolve, Undefined, <<Val(result)>>).s
\* AsyncGeneratorResume (§27.6.3.5).
AsyncGeneratorResume(s, gen, completion) ==
  LET state == GeneratorState(s, gen)
      s1 == SetSlots(s, gen, [state |-> "executing"])
  IN AsyncGeneratorStep(gen, IF state = "suspendedStart" THEN RunGeneratorBody(s1, gen)
                             ELSE ResumeFrames(O(s, gen).slots.frames, Abrupt(s1, completion)))
\* How the async generator's body stopped: at an await, at a yield, which AsyncGeneratorYield
\* already handled, or for good (step 4 of AsyncGeneratorStart).
AsyncGeneratorStep(gen, r) ==
  IF IsSuspended(r) THEN
    IF r.c.target = "await" THEN PerformAwait(r.s, [kind |-> "asyncGenerator", generator |-> gen], r.c.frames, r.c.value)
    ELSE Ok(HoldEnvs(SetSlots(r.s, gen, [frames |-> r.c.frames])), Undefined)
  ELSE LET s1 == SetSlots(r.s, gen, [state |-> "draining-queue", frames |-> <<>>])
           result == CASE r.c.type = "normal" -> NormalCompletion(Undefined)
                       [] r.c.type = "return" -> NormalCompletion(r.c.value)
                       [] OTHER -> r.c
       IN AsyncGeneratorDrainQueue(AsyncGeneratorCompleteStep(s1, gen, result, TRUE), gen)
\* AsyncGeneratorYield (§27.6.3.8) and AsyncGeneratorUnwrapYieldResumption (§27.6.3.7). The
\* generator continues at once with the next request when one waits.
AsyncGeneratorYield(s, ctx, v) ==
  LET gen == ctx.gen
      s1 == AsyncGeneratorCompleteStep(s, gen, NormalCompletion(v), FALSE)
      queue == O(s1, gen).slots.queue
  IN UnwrapYieldResumptionThen(IF queue # <<>> THEN Abrupt(s1, Head(queue).completion)
                               ELSE Suspend(SetSlots(s1, gen, [state |-> "suspendedYield"]), "yield", v))
UnwrapYieldResumptionThen(r) ==
  IF IsSuspended(r) THEN Pass(r, "UnwrapYieldResumptionThen", <<>>) ELSE IF r.c.type # "return" THEN r ELSE ReturnValueThen(Await(r.s, r.c.value))
\* AsyncGeneratorAwaitReturn (§27.6.3.9).
AsyncGeneratorAwaitReturn(s, gen) ==
  LET p == PromiseResolve(s, Intrinsic(s, "Promise"), Head(O(s, gen).slots.queue).completion.value) IN
  IF IsAbrupt(p) THEN AsyncGeneratorDrainQueue(AsyncGeneratorCompleteStep(p.s, gen, p.c, TRUE), gen)
  ELSE LET onFulfilled == CreateBuiltinFunction(p.s, <<"AsyncGenerator", "returnFulfilled">>, 1, <<>>, gen)
           onRejected == CreateBuiltinFunction(onFulfilled.s, <<"AsyncGenerator", "returnRejected">>, 1, <<>>, gen)
       IN Ok(AddPromiseReactions(onRejected.s, Val(p), Val(onFulfilled), Val(onRejected), Empty).s, Undefined)
\* AsyncGeneratorDrainQueue (§27.6.3.10).
AsyncGeneratorDrainQueue(s, gen) ==
  LET queue == O(s, gen).slots.queue IN
  IF queue = <<>> THEN Ok(SetSlots(s, gen, [state |-> "completed"]), Undefined)
  ELSE IF Head(queue).completion.type = "return" THEN AsyncGeneratorAwaitReturn(s, gen)
  ELSE AsyncGeneratorDrainQueue(AsyncGeneratorCompleteStep(s, gen, IF Head(queue).completion.type = "normal"
                                                                   THEN NormalCompletion(Undefined)
                                                                   ELSE Head(queue).completion, TRUE), gen)
\* %AsyncGeneratorPrototype% next, return, and throw (§27.6.1), and the closures of
\* AsyncGeneratorAwaitReturn.
AsyncGeneratorBuiltin(s, f, m, this, args, nt) ==
  IF m \in {"returnFulfilled", "returnRejected"} THEN
    LET gen == O(s, f).slots.data IN
    AsyncGeneratorDrainQueue(AsyncGeneratorCompleteStep(s, gen, IF m = "returnFulfilled" THEN NormalCompletion(Arg(args, 1))
                                                               ELSE ThrowCompletion(Arg(args, 1)), TRUE), gen)
  ELSE
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      c == Val(cap)
      completion == CASE m = "next" -> NormalCompletion(Arg(args, 1))
                      [] m = "return" -> Completion("return", Arg(args, 1), Empty)
                      [] m = "throw" -> ThrowCompletion(Arg(args, 1))
      settled ==
        IF ~IsAsyncGenerator(cap.s, this, Empty) THEN
          LET e == ThrowTypeError(cap.s) IN Call(e.s, c.reject, Undefined, <<e.c.value>>)
        ELSE LET state == GeneratorState(cap.s, this)
                 s1 == IF m = "throw" /\ state = "suspendedStart" THEN SetSlots(cap.s, this, [state |-> "completed"]) ELSE cap.s
                 isDone == state = "completed" \/ (m = "throw" /\ state = "suspendedStart")
             IN IF m = "next" /\ isDone THEN
                  LET result == CreateIterResultObject(s1, Undefined, TRUE) IN Call(result.s, c.resolve, Undefined, <<Val(result)>>)
                ELSE IF m = "throw" /\ isDone THEN Call(s1, c.reject, Undefined, <<completion.value>>)
                ELSE LET s2 == SetSlots(s1, this, [queue |-> Append(O(s1, this).slots.queue,
                                                                              [completion |-> completion, capability |-> c])])
                     IN IF m = "return" /\ state \in {"suspendedStart", "completed"}
                        THEN AsyncGeneratorAwaitReturn(SetSlots(s2, this, [state |-> "draining-queue"]), this)
                        ELSE IF state \in {"suspendedStart", "suspendedYield"} /\ (m # "return" \/ state = "suspendedYield")
                        THEN AsyncGeneratorResume(s2, this, completion)
                        ELSE Ok(s2, Undefined)
  IN Ok(settled.s, c.promise)
\* CreateAsyncFromSyncIterator (§27.1.6.1).
CreateAsyncFromSyncIterator(s, it) ==
  LET a == Alloc(s, MakeObject(Intrinsic(s, "AsyncFromSyncIteratorPrototype"), "asyncFromSync", [sync |-> it]))
      next == Get(a.s, a.v, SV("next"))
  IN Ok(next.s, JsIterator(a.v, Val(next)))
\* Rejects the capability with the thrown value of r, and returns its promise (IfAbruptRejectPromise).
RejectWith(r, cap) == LET c == Call(r.s, cap.reject, Undefined, <<r.c.value>>) IN Ok(c.s, cap.promise)
\* %AsyncFromSyncIteratorPrototype% next, return, and throw (§27.1.6.2), and the closures of
\* AsyncFromSyncIteratorContinuation.
AsyncFromSyncBuiltin(s, f, m, this, args, nt) ==
  CASE m = "unwrap" -> CreateIterResultObject(s, Arg(args, 1), O(s, f).slots.data)
    [] m = "close" -> IteratorClose(s, O(s, f).slots.data, ThrowCompletion(Arg(args, 1)))
    [] OTHER ->
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      c == Val(cap)
      it == O(cap.s, this).slots.sync
  IN IF m = "next" THEN
       LET result == IteratorNext(cap.s, it, IF args = <<>> THEN <<>> ELSE <<args[1]>>) IN
       IF IsAbrupt(result) THEN RejectWith(result, c) ELSE AsyncFromSyncContinuation(result.s, Val(result), c, it, TRUE)
     ELSE
       LET method == GetMethod(cap.s, it.iterator, IF m = "return" THEN SV("return") ELSE SV("throw")) IN
       IF IsAbrupt(method) THEN RejectWith(method, c)
       ELSE IF Val(method) = Undefined THEN
         IF m = "return" THEN
           LET result == CreateIterResultObject(method.s, Arg(args, 1), TRUE)
               resolved == Call(result.s, c.resolve, Undefined, <<Val(result)>>)
           IN Ok(resolved.s, c.promise)
         ELSE LET closed == IteratorClose(method.s, it, NormalCompletion(Empty)) IN
              IF IsAbrupt(closed) THEN RejectWith(closed, c) ELSE RejectWith(ThrowTypeError(closed.s), c)
       ELSE LET result == Call(method.s, Val(method), it.iterator, IF args = <<>> /\ m = "return" THEN <<>> ELSE <<Arg(args, 1)>>) IN
            IF IsAbrupt(result) THEN RejectWith(result, c)
            ELSE IF ~IsObject(Val(result)) THEN RejectWith(ThrowTypeError(result.s), c)
            ELSE AsyncFromSyncContinuation(result.s, Val(result), c, it, m = "throw")
\* AsyncFromSyncIteratorContinuation (§27.1.6.4).
AsyncFromSyncContinuation(s, result, cap, it, closeOnRejection) ==
  LET done == IteratorComplete(s, result) IN
  IF IsAbrupt(done) THEN RejectWith(done, cap) ELSE
  LET value == Get(done.s, result, SV("value")) IN
  IF IsAbrupt(value) THEN RejectWith(value, cap) ELSE
  LET wrapper == PromiseResolve(value.s, Intrinsic(value.s, "Promise"), Val(value))
      closed == IF IsAbrupt(wrapper) /\ ~Val(done) /\ closeOnRejection THEN IteratorClose(wrapper.s, it, wrapper.c) ELSE wrapper
  IN IF IsAbrupt(closed) THEN RejectWith(closed, cap) ELSE
     LET onFulfilled == CreateBuiltinFunction(closed.s, <<"AsyncFromSync", "unwrap">>, 1, <<>>, Val(done))
         onRejected == IF Val(done) \/ ~closeOnRejection THEN [s |-> onFulfilled.s, c |-> NormalCompletion(Undefined)]
                       ELSE CreateBuiltinFunction(onFulfilled.s, <<"AsyncFromSync", "close">>, 1, <<>>, it)
     IN Ok(AddPromiseReactions(onRejected.s, Val(closed), Val(onFulfilled), Val(onRejected), cap).s, cap.promise)
\* An object's prototype property and its prototype's constructor, both read-only (§27.3.3,
\* §27.4.3, §27.7.3). Only a constructor's prototype property is not configurable.
FunctionKindLinks(ctor, proto, isConfigurable) ==
  << L(ctor, SV("prototype"), proto, FALSE, FALSE, isConfigurable), L(proto, SV("constructor"), ctor, FALSE, FALSE, TRUE) >>
\* Promise objects (§27.2) and the job queue. A promise has class "promise" and slots [state,
\* result, fulfillReactions, rejectReactions, isHandled]. A PromiseCapability Record is
\* [promise, resolve, reject], and a PromiseReaction Record [capability, type, handler] with
\* capability or handler Empty when absent. Jobs (§9.5) are [kind |-> "reaction", reaction,
\* argument] or [kind |-> "thenable", promise, thenable, then], run in order once a script ends.
\* State that several closures share lives in the slots of a "cell" object, which no script sees.
AllocCell(s, slots) == Alloc(s, MakeObject(Null, "cell", slots))
Slots(s, v) == O(s, v).slots
SetSlots(s, v, slots) == SetO(s, v, [O(s, v) EXCEPT !.slots = slots @@ @])
IsPromise(s, v) == IsObject(v) /\ O(s, v).class = "promise"
\* CreateResolvingFunctions (§27.2.1.3), returning [s, resolve, reject].
CreateResolvingFunctions(s, promise) ==
  LET cell == AllocCell(s, [promise |-> promise])
      resolve == CreateBuiltinFunction(cell.s, <<"Promise", "resolveFunction">>, 1, <<>>, cell.v)
      reject == CreateBuiltinFunction(resolve.s, <<"Promise", "rejectFunction">>, 1, <<>>, cell.v)
  IN [s |-> reject.s, resolve |-> Val(resolve), reject |-> Val(reject)]
\* The resolve function (§27.2.1.3.2).
ResolvePromiseWith(s, promise, resolution) ==
  IF SameValue(resolution, promise) THEN
    LET e == ThrowTypeError(s) IN Ok(RejectPromise(e.s, promise, e.c.value), Undefined)
  ELSE IF ~IsObject(resolution) THEN Ok(FulfillPromise(s, promise, resolution), Undefined)
  ELSE LET then == Get(s, resolution, SV("then")) IN
  IF IsAbrupt(then) THEN Ok(RejectPromise(then.s, promise, then.c.value), Undefined)
  ELSE IF ~IsCallable(then.s, Val(then)) THEN Ok(FulfillPromise(then.s, promise, resolution), Undefined)
  ELSE Ok(EnqueueJob(then.s, [kind |-> "thenable", promise |-> promise, thenable |-> resolution, then |-> Val(then)]), Undefined)
EnqueueJob(s, job) == [s EXCEPT !.jobs = Append(@, job)]
\* FulfillPromise (§27.2.1.4) and RejectPromise (§27.2.1.7), returning the state.
SettlePromise(s, promise, state, value) ==
  LET reactions == IF state = "fulfilled" THEN Slots(s, promise).fulfillReactions ELSE Slots(s, promise).rejectReactions
      s1 == SetSlots(s, promise, [state |-> state, result |-> value, fulfillReactions |-> <<>>, rejectReactions |-> <<>>])
  IN [s1 EXCEPT !.jobs = @ \o [i \in DOMAIN reactions |-> [kind |-> "reaction", reaction |-> reactions[i], argument |-> value]]]
FulfillPromise(s, promise, value) == SettlePromise(s, promise, "fulfilled", value)
RejectPromise(s, promise, reason) == SettlePromise(s, promise, "rejected", reason)
\* NewPromiseCapability (§27.2.1.5).
NewPromiseCapability(s, c) ==
  IF ~IsConstructor(s, c) THEN ThrowTypeError(s) ELSE
  LET cell == AllocCell(s, [resolve |-> Undefined, reject |-> Undefined])
      executor == CreateBuiltinFunction(cell.s, <<"Promise", "capabilityExecutor">>, 2, <<>>, cell.v)
      promise == Construct(executor.s, c, <<Val(executor)>>, c)
  IN IF IsAbrupt(promise) THEN promise
     ELSE IF ~IsCallable(promise.s, Slots(promise.s, cell.v).resolve) THEN ThrowTypeError(promise.s)
     ELSE IF ~IsCallable(promise.s, Slots(promise.s, cell.v).reject) THEN ThrowTypeError(promise.s)
     ELSE Ok(promise.s, [promise |-> Val(promise), resolve |-> Slots(promise.s, cell.v).resolve,
                         reject |-> Slots(promise.s, cell.v).reject])
\* PromiseResolve (§27.2.4.7.1).
PromiseResolve(s, c, x) ==
  LET ctor == IF IsPromise(s, x) THEN Get(s, x, SV("constructor")) ELSE Ok(s, Undefined) IN
  IF IsAbrupt(ctor) THEN ctor
  ELSE IF IsPromise(s, x) /\ SameValue(Val(ctor), c) THEN Ok(ctor.s, x)
  ELSE LET cap == NewPromiseCapability(ctor.s, c) IN
       IF IsAbrupt(cap) THEN cap ELSE
       LET r == Call(cap.s, Val(cap).resolve, Undefined, <<x>>) IN
       IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(cap).promise)
\* PerformPromiseThen (§27.2.5.4.1) with a capability or Empty.
AddPromiseReactions(s, promise, onFulfilled, onRejected, cap) ==
  LET reaction(type, handler) == [capability |-> cap, type |-> type,
                                  handler |-> IF IsCallable(s, handler) THEN handler ELSE Empty]
      slots == Slots(s, promise)
      s1 == CASE slots.state = "pending" ->
                   SetSlots(s, promise, [fulfillReactions |-> Append(slots.fulfillReactions, reaction("fulfill", onFulfilled)),
                                         rejectReactions |-> Append(slots.rejectReactions, reaction("reject", onRejected))])
              [] slots.state = "fulfilled" ->
                   EnqueueJob(s, [kind |-> "reaction", reaction |-> reaction("fulfill", onFulfilled), argument |-> slots.result])
              [] OTHER ->
                   EnqueueJob(s, [kind |-> "reaction", reaction |-> reaction("reject", onRejected), argument |-> slots.result])
  IN Ok(SetSlots(s1, promise, [isHandled |-> TRUE]), IF cap = Empty THEN Undefined ELSE cap.promise)
\* Runs the queued jobs in order until none are left (NewPromiseReactionJob §27.2.2.1 and
\* NewPromiseResolveThenableJob §27.2.2.2), then the timeout jobs of the waits that can time out.
RunJobs(s) ==
  IF s.jobs = <<>> /\ \A i \in DOMAIN s.waiters : s.waiters[i].deadline = Empty THEN Ok(s, Undefined)
  ELSE IF s.jobs = <<>> THEN RunJobs(TimeOutWaiter(s))
  ELSE LET r == RunJob([s EXCEPT !.jobs = Tail(@)], Head(s.jobs)) IN
       IF IsAbrupt(r) THEN r ELSE RunJobs(r.s)
RunJob(s, job) ==
  IF job.kind = "thenable" THEN
    LET fns == CreateResolvingFunctions(s, job.promise)
        r == Call(fns.s, job.then, job.thenable, <<fns.resolve, fns.reject>>)
    IN IF IsAbrupt(r) THEN Call(r.s, fns.reject, Undefined, <<r.c.value>>) ELSE r
  ELSE
    LET reaction == job.reaction
        result == CASE reaction.handler # Empty -> Call(s, reaction.handler, Undefined, <<job.argument>>)
                    [] reaction.type = "fulfill" -> Ok(s, job.argument)
                    [] OTHER -> ThrowValue(s, job.argument)
    IN IF reaction.capability = Empty THEN Ok(result.s, Undefined)
       ELSE IF IsAbrupt(result) THEN Call(result.s, reaction.capability.reject, Undefined, <<result.c.value>>)
       ELSE Call(result.s, reaction.capability.resolve, Undefined, <<Val(result)>>)
\* GetPromiseResolve (§27.2.4.1.1).
GetPromiseResolve(s, c) ==
  LET r == Get(s, c, SV("resolve")) IN
  IF IsAbrupt(r) THEN r ELSE IF ~IsCallable(r.s, Val(r)) THEN ThrowTypeError(r.s) ELSE r
\* Promise.all, allSettled, any, and race (§27.2.4.1 to §27.2.4.5): kind is "all", "allSettled",
\* "any", or "race".
PromiseCombinator(s, kind, c, iterable) ==
  LET cap == NewPromiseCapability(s, c) IN
  IF IsAbrupt(cap) THEN cap ELSE
  LET resolve == GetPromiseResolve(cap.s, c) IN
  IF IsAbrupt(resolve) THEN RejectWith(resolve, Val(cap)) ELSE
  LET it == GetIterator(resolve.s, iterable, "sync") IN
  IF IsAbrupt(it) THEN RejectWith(it, Val(cap)) ELSE
  LET cell == AllocCell(it.s, [values |-> <<>>, remaining |-> 1])
      r == CombinatorLoop(cell.s, [kind |-> kind, c |-> c, cap |-> Val(cap), resolve |-> Val(resolve), cell |-> cell.v],
                          Val(it), 0)
  IN IF ~IsAbrupt(r) THEN [s |-> r.s, c |-> r.c]
     ELSE RejectWith(IF r.done THEN r ELSE IteratorClose(r.s, Val(it), r.c), Val(cap))
\* The loop of PerformPromiseAll and its siblings, for a combinator [kind, c, cap, resolve, cell],
\* returning [s, c, done] with done whether the iterator finished.
CombinatorLoop(s, comb, it, index) ==
  LET next == IteratorStepValue(s, it) IN
  IF IsAbrupt(next) THEN [s |-> next.s, c |-> next.c, done |-> TRUE]
  ELSE IF Val(next).done THEN
    LET finish == IF comb.kind = "race" THEN Ok(next.s, Undefined) ELSE CombinatorElementDone(next.s, comb) IN
    [s |-> finish.s, c |-> IF IsAbrupt(finish) THEN finish.c ELSE NormalCompletion(comb.cap.promise), done |-> TRUE]
  ELSE
    LET then == CombinatorAdd(next.s, comb, Val(next).value, index) IN
    IF IsAbrupt(then) THEN [s |-> then.s, c |-> then.c, done |-> FALSE]
    ELSE CombinatorLoop(then.s, comb, Val(next).iterator, index + 1)
\* The steps of the loop for one element: resolves value, element index of the result, with the
\* combinator's constructor, and invokes its then with the element's functions.
CombinatorAdd(s, comb, value, index) ==
  LET s1 == IF comb.kind = "race" THEN s
            ELSE SetSlots(s, comb.cell, [values |-> Append(Slots(s, comb.cell).values, Undefined)])
      p == Call(s1, comb.resolve, comb.c, <<value>>)
      called == AllocCell(p.s, [called |-> FALSE])
      data == [comb |-> comb, index |-> index, called |-> called.v]
      onFulfilled == IF comb.kind \in {"all", "allSettled", "allKeyed", "allSettledKeyed"}
                     THEN CreateBuiltinFunction(called.s, <<"Promise", comb.kind \o "Resolve">>, 1, <<>>, data)
                     ELSE Ok(called.s, comb.cap.resolve)
      onRejected == IF comb.kind \in {"allSettled", "any", "allSettledKeyed"}
                    THEN CreateBuiltinFunction(onFulfilled.s, <<"Promise", comb.kind \o "Reject">>, 1, <<>>, data)
                    ELSE Ok(onFulfilled.s, comb.cap.reject)
      counted == IF comb.kind = "race" THEN onRejected.s
                 ELSE SetSlots(onRejected.s, comb.cell, [remaining |-> Slots(onRejected.s, comb.cell).remaining + 1])
  IN IF IsAbrupt(p) THEN p ELSE Invoke(counted, Val(p), SV("then"), <<Val(onFulfilled), Val(onRejected)>>)
\* Promise.allKeyed and Promise.allSettledKeyed of the await-dictionary proposal: kind is
\* "allKeyed" or "allSettledKeyed", and the result has a property for each enumerable own
\* property of promises.
PromiseKeyedCombinator(s, kind, c, promises) ==
  LET cap == NewPromiseCapability(s, c) IN
  IF IsAbrupt(cap) THEN cap ELSE
  LET resolve == GetPromiseResolve(cap.s, c) IN
  IF IsAbrupt(resolve) THEN RejectWith(resolve, Val(cap))
  ELSE IF ~IsObject(promises) THEN RejectWith(ThrowTypeError(resolve.s), Val(cap)) ELSE
  LET keys == OwnPropertyKeys(resolve.s, promises) IN
  IF IsAbrupt(keys) THEN RejectWith(keys, Val(cap)) ELSE
  LET cell == AllocCell(keys.s, [values |-> <<>>, keys |-> <<>>, remaining |-> 1])
      r == KeyedCombinatorLoop(cell.s, [kind |-> kind, c |-> c, cap |-> Val(cap), resolve |-> Val(resolve), cell |-> cell.v],
                               promises, Val(keys), 1)
  IN IF IsAbrupt(r) THEN RejectWith(r, Val(cap)) ELSE r
\* The loop of PerformPromiseAllKeyed from the key keys[i].
KeyedCombinatorLoop(s, comb, promises, keys, i) ==
  IF i > Len(keys) THEN
    LET finish == CombinatorElementDone(s, comb) IN IF IsAbrupt(finish) THEN finish ELSE Ok(finish.s, comb.cap.promise)
  ELSE LET desc == GetOwnProperty(s, promises, keys[i]) IN
  IF IsAbrupt(desc) THEN desc
  ELSE IF Val(desc) = Absent \/ Val(desc).enumerable # True THEN KeyedCombinatorLoop(desc.s, comb, promises, keys, i + 1)
  ELSE LET v == Get(desc.s, promises, keys[i]) IN
  IF IsAbrupt(v) THEN v ELSE
  LET slots == Slots(v.s, comb.cell)
      then == CombinatorAdd(SetSlots(v.s, comb.cell, [keys |-> Append(slots.keys, keys[i])]), comb, Val(v), Len(slots.values))
  IN IF IsAbrupt(then) THEN then ELSE KeyedCombinatorLoop(then.s, comb, promises, keys, i + 1)
\* One element done: when it was the last, settles the combinator's promise with the values.
CombinatorElementDone(s, comb) ==
  LET slots == Slots(s, comb.cell)
      s1 == SetSlots(s, comb.cell, [remaining |-> slots.remaining - 1])
  IN IF slots.remaining > 1 THEN Ok(s1, Undefined)
     ELSE LET values == CreateArrayFromList(s1, slots.values) IN
          IF comb.kind = "any" THEN
            LET error == Alloc(values.s, MakeObject(Intrinsic(values.s, "AggregateErrorPrototype"), "error", [data |-> Empty]))
                d == DefinePropertyOrThrow(error.s, error.v, SV("errors"), DataDesc(Val(values), TRUE, FALSE, TRUE))
            IN Call(d.s, comb.cap.reject, Undefined, <<error.v>>)
          ELSE IF comb.kind \in {"allKeyed", "allSettledKeyed"} THEN
            LET o == OrdinaryObjectCreate(s1, Null)
                result == WithDataProps(O(o.s, Val(o)), [i \in DOMAIN slots.keys |-> <<slots.keys[i], slots.values[i]>>])
            IN Call(SetO(o.s, Val(o), result), comb.cap.resolve, Undefined, <<Val(o)>>)
          ELSE Call(values.s, comb.cap.resolve, Undefined, <<Val(values)>>)
\* SafePerformPromiseAll of the import-defer proposal: a promise for the values of promises, which
\* waits on each with PerformPromiseThen rather than looking up then.
SafePromiseAll(s, promises) ==
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      cell == AllocCell(cap.s, [values |-> Repeat(Undefined, Len(promises)), remaining |-> Len(promises)])
      comb == [kind |-> "all", c |-> Intrinsic(s, "Promise"), cap |-> Val(cap), resolve |-> Undefined, cell |-> cell.v]
  IN IF promises = <<>> THEN LET a == CreateArrayFromList(cap.s, <<>>) IN
                              LET r == Call(a.s, Val(cap).resolve, Undefined, <<Val(a)>>) IN Ok(r.s, Val(cap).promise)
     ELSE Ok(SafePromiseAllFrom(cell.s, comb, promises, 1), Val(cap).promise)
SafePromiseAllFrom(s, comb, promises, i) ==
  IF i > Len(promises) THEN s ELSE
  LET called == AllocCell(s, [called |-> FALSE])
      onFulfilled == CreateBuiltinFunction(called.s, <<"Promise", "allResolve">>, 1, <<>>,
                                           [comb |-> comb, index |-> i - 1, called |-> called.v])
      then == AddPromiseReactions(onFulfilled.s, promises[i], Val(onFulfilled), comb.cap.reject, Empty)
  IN SafePromiseAllFrom(then.s, comb, promises, i + 1)
\* The element functions of the combinators: records the value or reason at the element's index.
CombinatorElement(s, f, m, x) ==
  LET data == Slots(s, f).data
      comb == data.comb
  IN IF Slots(s, data.called).called THEN Ok(s, Undefined) ELSE
     LET s1 == SetSlots(s, data.called, [called |-> TRUE])
         entry ==
           IF comb.kind \in {"allSettled", "allSettledKeyed"} THEN
             LET o == OrdinaryObjectCreate(s1, Intrinsic(s1, "ObjectPrototype")) IN
             Ok(SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)),
                  IF m \in {"allSettledResolve", "allSettledKeyedResolve"} THEN <<<<SV("status"), SV("fulfilled")>>, <<SV("value"), x>>>>
                  ELSE <<<<SV("status"), SV("rejected")>>, <<SV("reason"), x>>>>)), Val(o))
           ELSE Ok(s1, x)
         s2 == SetSlots(entry.s, comb.cell, [values |-> [Slots(entry.s, comb.cell).values EXCEPT ![data.index + 1] = Val(entry)]])
     IN CombinatorElementDone(s2, comb)
\* Promise.prototype.finally (§27.2.5.3).
PromiseFinally(s, promise, onFinally) ==
  IF ~IsObject(promise) THEN ThrowTypeError(s) ELSE
  LET c == SpeciesConstructor(s, promise, Intrinsic(s, "Promise")) IN
  IF IsAbrupt(c) THEN c
  ELSE IF ~IsCallable(c.s, onFinally) THEN Invoke(c.s, promise, SV("then"), <<onFinally, onFinally>>)
  ELSE LET thenFinally == CreateBuiltinFunction(c.s, <<"Promise", "thenFinally">>, 1, <<>>, [onFinally |-> onFinally, c |-> Val(c)])
           catchFinally == CreateBuiltinFunction(thenFinally.s, <<"Promise", "catchFinally">>, 1, <<>>, [onFinally |-> onFinally, c |-> Val(c)])
       IN Invoke(catchFinally.s, promise, SV("then"), <<Val(thenFinally), Val(catchFinally)>>)
\* The thenFinally and catchFinally closures, which pass the value or reason on after onFinally.
FinallyStep(s, f, m, x) ==
  LET data == Slots(s, f).data
      result == Call(s, data.onFinally, Undefined, <<>>)
  IN IF IsAbrupt(result) THEN result ELSE
     LET p == PromiseResolve(result.s, data.c, Val(result)) IN
     IF IsAbrupt(p) THEN p ELSE
     LET then == CreateBuiltinFunction(p.s, <<"Promise", IF m = "thenFinally" THEN "valueThunk" ELSE "thrower">>, 0, <<>>, x) IN
     Invoke(then.s, Val(p), SV("then"), <<Val(then)>>)
PromiseBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE IF ~IsCallable(s, Arg(args, 1)) THEN ThrowTypeError(s)
         ELSE LET p == OrdinaryCreateFromConstructor(s, nt, "PromisePrototype", "promise",
                         [state |-> "pending", result |-> Undefined, fulfillReactions |-> <<>>,
                          rejectReactions |-> <<>>, isHandled |-> FALSE])
              IN IF IsAbrupt(p) THEN p ELSE
              LET fns == CreateResolvingFunctions(p.s, Val(p))
                  r == Call(fns.s, Arg(args, 1), Undefined, <<fns.resolve, fns.reject>>)
              IN IF ~IsAbrupt(r) THEN Ok(r.s, Val(p)) ELSE
                 LET rejected == Call(r.s, fns.reject, Undefined, <<r.c.value>>) IN
                 IF IsAbrupt(rejected) THEN rejected ELSE Ok(rejected.s, Val(p))
    [] m \in {"resolveFunction", "rejectFunction"} ->
         LET cell == Slots(s, f).data
             promise == Slots(s, cell).promise
         IN IF promise = Empty THEN Ok(s, Undefined)
            ELSE LET s1 == SetSlots(s, cell, [promise |-> Empty]) IN
                 IF m = "rejectFunction" THEN Ok(RejectPromise(s1, promise, Arg(args, 1)), Undefined)
                 ELSE ResolvePromiseWith(s1, promise, Arg(args, 1))
    [] m = "capabilityExecutor" ->
         LET cell == Slots(s, f).data IN
         IF Slots(s, cell).resolve # Undefined \/ Slots(s, cell).reject # Undefined THEN ThrowTypeError(s)
         ELSE Ok(SetSlots(s, cell, [resolve |-> Arg(args, 1), reject |-> Arg(args, 2)]), Undefined)
    [] m \in {"all", "allSettled", "any", "race"} -> PromiseCombinator(s, m, this, Arg(args, 1))
    [] m \in {"allKeyed", "allSettledKeyed"} -> PromiseKeyedCombinator(s, m, this, Arg(args, 1))
    [] m \in {"allResolve", "allSettledResolve", "allSettledReject", "anyReject", "allKeyedResolve",
              "allSettledKeyedResolve", "allSettledKeyedReject"} -> CombinatorElement(s, f, m, Arg(args, 1))
    [] m = "reject" ->
         LET cap == NewPromiseCapability(s, this) IN
         IF IsAbrupt(cap) THEN cap ELSE
         LET r == Call(cap.s, Val(cap).reject, Undefined, <<Arg(args, 1)>>) IN
         IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(cap).promise)
    [] m = "resolve" -> IF ~IsObject(this) THEN ThrowTypeError(s) ELSE PromiseResolve(s, this, Arg(args, 1))
    [] m = "withResolvers" ->
         LET cap == NewPromiseCapability(s, this) IN
         IF IsAbrupt(cap) THEN cap ELSE
         LET o == OrdinaryObjectCreate(cap.s, Intrinsic(cap.s, "ObjectPrototype")) IN
         Ok(SetO(o.s, Val(o), WithDataProps(O(o.s, Val(o)), <<<<SV("promise"), Val(cap).promise>>,
                                                               <<SV("resolve"), Val(cap).resolve>>,
                                                               <<SV("reject"), Val(cap).reject>>>>)), Val(o))
    [] m = "try" ->
         IF ~IsObject(this) THEN ThrowTypeError(s) ELSE
         LET status == Call(s, Arg(args, 1), Undefined, Rest(args, 2)) IN
         IF ~IsAbrupt(status) THEN PromiseResolve(status.s, this, Val(status)) ELSE
         LET cap == NewPromiseCapability(status.s, this) IN
         IF IsAbrupt(cap) THEN cap ELSE
         LET r == Call(cap.s, Val(cap).reject, Undefined, <<status.c.value>>) IN
         IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(cap).promise)
    [] m = "species" -> Ok(s, this)
    [] m = "then" ->
         IF ~IsPromise(s, this) THEN ThrowTypeError(s) ELSE
         LET c == SpeciesConstructor(s, this, Intrinsic(s, "Promise")) IN
         IF IsAbrupt(c) THEN c ELSE
         LET cap == NewPromiseCapability(c.s, Val(c)) IN
         IF IsAbrupt(cap) THEN cap ELSE AddPromiseReactions(cap.s, this, Arg(args, 1), Arg(args, 2), Val(cap))
    [] m = "catch" -> Invoke(s, this, SV("then"), <<Undefined, Arg(args, 1)>>)
    [] m = "finally" -> PromiseFinally(s, this, Arg(args, 1))
    [] m \in {"thenFinally", "catchFinally"} -> FinallyStep(s, f, m, Arg(args, 1))
    [] m = "valueThunk" -> Ok(s, Slots(s, f).data)
    [] m = "thrower" -> ThrowValue(s, Slots(s, f).data)
\* eval (§19.2.1) and CreateDynamicFunction (§20.2.1.1.1), which parse source text at run time.
\* TLA+ can't parse, so the host does. The state's parses is the host's parse of each request:
\*   [goal |-> "eval", source, strict, newTarget, superProperty, superCall, privateNames]
\*     for ParseText of a Script with the early errors of PerformEval's step 10
\*   [goal |-> "script", source] for the test262 host's $262.evalScript
\*   [goal |-> kind, params, body] for the parses of CreateDynamicFunction, kind "normal",
\*     "generator", "async", or "asyncGenerator"
\* and each parse to [ok |-> FALSE] for a SyntaxError, or to [ok |-> TRUE, node], with the Script
\* and whether its body ContainsArguments, or the function expression.
\* The private names in scope for a direct eval's parser, by description, which starts with "#".
PrivateNamesIn(env) ==
  IF env = Null THEN {}
  ELSE {env.names[name].description : name \in DOMAIN env.names} \cup PrivateNamesIn(env.outer)
\* $262.evalScript: runs source text as a new script, as the test262 host's INTERPRETING.md says.
EvalScript(s, x) ==
  LET str == ToStr(s, x) IN IF IsAbrupt(str) THEN str ELSE
  LET key == [goal |-> "script", source |-> Val(str).value] IN
  IF ~str.s.parses[key].ok THEN ThrowError(str.s, "SyntaxError")
  ELSE ScriptEvaluation(str.s, str.s.parses[key].node)
\* PerformEval (§19.2.1.1).
PerformEval(s, ctx, x, strictCaller, direct) ==
  IF ~IsString(x) THEN Ok(s, x) ELSE
  LET thisEnv == IF direct THEN E(s, GetThisEnvironment(s, ctx.lex)) ELSE E(s, s.globalEnv)
      inFunction == thisEnv.kind = "function"
      fn == IF inFunction THEN O(s, thisEnv.fn).slots ELSE Empty
      key == [goal |-> "eval", source |-> x.value, strict |-> strictCaller, newTarget |-> inFunction,
              superProperty |-> inFunction /\ HasSuperBinding(s, GetThisEnvironment(s, ctx.lex)),
              superCall |-> inFunction /\ fn.ctorKind = "derived",
              privateNames |-> IF direct THEN PrivateNamesIn(ctx.priv) ELSE {}]
      parsed == s.parses[key]
  IN IF ~parsed.ok THEN ThrowError(s, "SyntaxError")
  ELSE IF ~Has(parsed.node.ScriptBody) THEN Ok(s, Undefined)
  ELSE IF inFunction /\ fn.initializerName # Empty /\ parsed.containsArguments THEN ThrowError(s, "SyntaxError")
  ELSE
  LET script == parsed.node
      strictEval == strictCaller \/ script.ScriptBody.strict
      lex == AllocEnv([s EXCEPT !.evalCount = @ + 1],
                      [kind |-> "declarative", outer |-> IF direct THEN ctx.lex ELSE s.globalEnv, b |-> <<>>,
                       parse |-> s.evalCount + 1])
      var == IF strictEval THEN lex.e ELSE IF direct THEN ctx.var ELSE s.globalEnv
      evalCtx == IF direct THEN Context(lex.e, var, ctx.priv, ctx.fn)
                 ELSE Context(lex.e, var, NoPrivateEnvironment, Null)
      i == EvalDeclarationInstantiation(lex.s, evalCtx, script, strictEval)
  IN IF IsAbrupt(i) THEN i ELSE
     LET r == EvaluateStatementList(i.s, evalCtx, script.ScriptBody.StatementList) IN
     IF ~IsAbrupt(r) /\ Val(r) = Empty THEN Ok(r.s, Undefined) ELSE r
\* EvalDeclarationInstantiation (§19.2.1.3) in the eval context's environments.
EvalDeclarationInstantiation(s, ctx, script, strict) ==
  LET varEnv == ctx.var
      isGlobal == E(s, varEnv).kind = "global"
      varNames == VarDeclaredNames(script)
      varDeclarations == VarScopedDeclarations(script)
      functions == FunctionsToInitialize(varDeclarations)
      functionNames == [i \in DOMAIN functions |-> BoundNames(functions[i])[1]]
      varDeclNames == Dedupe(ConcatMap(SelectSeq(varDeclarations, LAMBDA d : d.type \notin FunctionDeclarationTypes), BoundNames))
      declaredVarNames == SelectSeq(varDeclNames, LAMBDA n : n \notin Range(functionNames))
      globalClash == ~strict /\ isGlobal /\ \E i \in DOMAIN varNames : HasLexicalDeclaration(s, varEnv, varNames[i])
  IN IF globalClash THEN ThrowError(s, "SyntaxError") ELSE
     LET clash == IF strict THEN Ok(s, FALSE) ELSE EvalVarClash(s, E(s, ctx.lex).outer, varEnv, varNames) IN
     IF IsAbrupt(clash) THEN clash ELSE IF Val(clash) THEN ThrowError(clash.s, "SyntaxError") ELSE
     LET fnCheck == IF isGlobal THEN CheckGlobalNames(clash.s, varEnv, Reverse(functionNames), TRUE) ELSE Ok(clash.s, Empty) IN
     IF IsAbrupt(fnCheck) THEN fnCheck ELSE
     LET varCheck == IF isGlobal THEN CheckGlobalNames(fnCheck.s, varEnv, declaredVarNames, FALSE) ELSE Ok(fnCheck.s, Empty) IN
     IF IsAbrupt(varCheck) THEN varCheck ELSE
     LET hoisted == IF strict THEN Ok(varCheck.s, Empty)
                    ELSE HoistFunctions(varCheck.s, ctx.lex, varEnv, HoistableFunctions(script),
                                        Range(functionNames) \cup Range(declaredVarNames), TRUE)
     IN IF IsAbrupt(hoisted) THEN hoisted ELSE
     LET lex == CreateGlobalLexicals(hoisted.s, ctx.lex, LexicallyScopedDeclarations(script)) IN IF IsAbrupt(lex) THEN lex ELSE
     LET fns == CreateEvalFunctions(lex.s, ctx, isGlobal, functions) IN IF IsAbrupt(fns) THEN fns ELSE
     CreateEvalVars(fns.s, varEnv, isGlobal, declaredVarNames)
\* Step 3.d: whether an environment between the eval's and its var environment, other than a
\* with statement's or, by §B.3.4, a catch clause's, binds one of the var names.
EvalVarClash(s, e, varEnv, names) ==
  IF e = varEnv THEN Ok(s, FALSE)
  ELSE IF E(s, e).kind \in {"object", "catch"} THEN EvalVarClash(s, E(s, e).outer, varEnv, names)
  ELSE LET bound == AnyBound(s, e, names) IN
       IF IsAbrupt(bound) \/ Val(bound) THEN bound ELSE EvalVarClash(bound.s, E(s, e).outer, varEnv, names)
AnyBound(s, e, names) ==
  IF names = <<>> THEN Ok(s, FALSE)
  ELSE LET h == HasBinding(s, e, Head(names)) IN
       IF IsAbrupt(h) THEN h ELSE IF Val(h) = True THEN Ok(h.s, TRUE) ELSE AnyBound(h.s, e, Tail(names))
\* Steps 17 and 18: the functions and vars, which eval creates deletable.
CreateEvalFunctions(s, ctx, isGlobal, fns) ==
  IF fns = <<>> THEN Ok(s, Empty)
  ELSE LET fo == InstantiateFunctionObject(s, ctx, Head(fns))
           name == BoundNames(Head(fns))[1]
           r == IF isGlobal THEN CreateGlobalFunctionBinding(fo.s, ctx.var, name, Val(fo), TRUE)
                ELSE BindEvalName(fo.s, ctx.var, name, Val(fo), TRUE)
       IN IF IsAbrupt(r) THEN r ELSE CreateEvalFunctions(r.s, ctx, isGlobal, Tail(fns))
CreateEvalVars(s, varEnv, isGlobal, names) ==
  IF names = <<>> THEN Ok(s, Empty)
  ELSE LET r == IF isGlobal THEN CreateGlobalVarBinding(s, varEnv, Head(names), TRUE)
                ELSE BindEvalName(s, varEnv, Head(names), Undefined, FALSE)
       IN IF IsAbrupt(r) THEN r ELSE CreateEvalVars(r.s, varEnv, isGlobal, Tail(names))
\* A binding in a var environment that isn't global: a new one initialized to value, or for a
\* function, the existing one set to it.
BindEvalName(s, e, name, value, isFunction) ==
  LET h == HasBinding(s, e, name) IN
  IF Val(h) = False THEN
    LET created == CreateMutableBinding(h.s, e, name, TRUE) IN InitializeBinding(created.s, e, name, value)
  ELSE IF isFunction THEN SetMutableBinding(h.s, e, name, value, FALSE)
  ELSE Ok(h.s, Empty)
\* CreateDynamicFunction (§20.2.1.1.1) for kind "normal", "generator", "async", or
\* "asyncGenerator".
CreateDynamicFunction(s, constructor, newTarget, kind, args) ==
  LET nt == IF newTarget = Undefined THEN constructor ELSE newTarget
      params == IF args = <<>> THEN <<>> ELSE SubSeq(args, 1, Len(args) - 1)
      strings == ToStrings(s, params, <<>>)
  IN IF IsAbrupt(strings) THEN strings ELSE
  LET body == ToStr(strings.s, IF args = <<>> THEN EmptyStr ELSE args[Len(args)]) IN
  IF IsAbrupt(body) THEN body ELSE
  LET key == [goal |-> kind, params |-> JoinWithCommas(Val(strings)), body |-> Val(body).value] IN
  LET parsed == body.s.parses[key] IN
  IF ~parsed.ok THEN ThrowError(body.s, "SyntaxError") ELSE
  LET n == parsed.node
      fallback == CASE kind = "normal" -> "FunctionPrototype"
                    [] kind = "generator" -> "GeneratorFunctionPrototype"
                    [] kind = "async" -> "AsyncFunctionPrototype"
                    [] OTHER -> "AsyncGeneratorFunctionPrototype"
      proto == GetPrototypeFromConstructor(body.s, nt, fallback)
  IN IF IsAbrupt(proto) THEN proto ELSE
     LET f == OrdinaryFunctionCreate(proto.s, Val(proto), n.sourceText, n.FormalParameters, FunctionBodyOf(n),
                                     FALSE, proto.s.globalEnv, NoPrivateEnvironment)
         s1 == SetFunctionName(f.s, f.v, SV("anonymous"), <<>>)
     IN Ok(GiveFunctionPrototype(s1, n.type, f.v), f.v)
ToStrings(s, values, acc) ==
  IF values = <<>> THEN Ok(s, acc)
  ELSE LET str == ToStr(s, Head(values)) IN
       IF IsAbrupt(str) THEN str ELSE ToStrings(str.s, Tail(values), Append(acc, Val(str).value))
JoinWithCommas(strings) ==
  IF strings = <<>> THEN <<>>
  ELSE FoldLeftSeq([i \in DOMAIN strings |-> IF i = 1 THEN strings[i] ELSE <<44>> \o strings[i]])
\* Modules (§16.2): Source Text Module Records, JSON, text and bytes modules as Synthetic Module Records
\* (§16.2.1.8), module namespace objects (§10.4.6), import() (§13.3.10), and import.meta
\* (§13.3.12). The state's modules holds the module records by index, and moduleIds maps a realm
\* and the host's name for each module it loaded in that realm to the index. A module record has:
\*   kind              "source", or "synthetic" for a JSON, text or bytes module, whose value is its
\*                     default export
\*   moduleSource      its [[ModuleSource]] object of the source-phase-imports proposal, or Empty
\*   node              a source module's Module parse node
\*   status            "new", "unlinked", "linking", "linked", "evaluating", "evaluating-async", or
\*                     "evaluated"
\*   error             the value its evaluation threw, or Empty
\*   requests          its ModuleRequest Records [specifier, attributes], with attributes a function
\*                     from keys to values, and loaded, which maps each to a module index
\*   phases            [request, phase] for each import or export from, with phase "evaluation",
\*                     "defer", or "source"
\*   env, cycleRoot    indices, 0 when empty
\*   namespace, deferredNamespace, meta, capability   Empty until made
\*   asyncOrder        0 when unset, -1 when done, or the order of its async evaluation
\*   imports, localExports, indirectExports, starExports   its entries (§16.2.1.7)
\* An import entry is [request, isNamespace, isSource, importName, localName], with isDeferred too
\* for a namespace import, a local export entry
\* [exportName, localName], an indirect one [exportName, request, isNamespace, isDeferred, isSource,
\* importName], and a star one [request]. isSource marks a source phase import, which binds its
\* module's source, or the export of one.
ModuleAt(s, m) == s.modules[m]
SetModule(s, m, fields) == [s EXCEPT !.modules[m] = fields @@ @]
Lesser(a, b) == IF a < b THEN a ELSE b
\* StringValue of a ModuleExportName, an ImportedBinding, or a ModuleSpecifier.
StringValueOf(n) == IF n.type = "StringLiteral" THEN n.value ELSE n.name
\* WithClauseToAttributes (§16.2.2.4), as a function from keys to values.
Attributes(clause) ==
  LET entries == IF Has(clause) THEN Range(clause.WithEntries) ELSE {}
  IN [key \in {StringValueOf(e.AttributeKey) : e \in entries} |->
        (CHOOSE e \in entries : StringValueOf(e.AttributeKey) = key).AttributeValue.value]
ModuleRequest(n) ==
  [specifier |-> StringValueOf(IF n.type = "ImportDeclaration" /\ ~Has(n.FromClause) THEN n.ModuleSpecifier ELSE n.FromClause),
   attributes |-> Attributes(n.WithClause)]
\* The phase of each module request, as the import-defer and source-phase-imports proposals add.
ModuleRequestPhases(node) ==
  Dedupe(ConcatMap(ModuleItems(node), LAMBDA item :
    IF item.type = "ImportDeclaration" \/ (item.type = "ExportDeclaration" /\ Has(item.FromClause))
    THEN <<[request |-> ModuleRequest(item), phase |-> IF item.type = "ImportDeclaration" THEN item.Phase ELSE "evaluation"]>>
    ELSE <<>>))
ModuleItems(node) == IF Has(node.ModuleBody) THEN List(node.ModuleBody.ModuleItemList) ELSE <<>>
\* ModuleRequests (§16.2.1.4).
ModuleRequests(node) ==
  Dedupe(ConcatMap(ModuleItems(node), LAMBDA item :
    IF item.type = "ImportDeclaration" \/ (item.type = "ExportDeclaration" /\ Has(item.FromClause))
    THEN <<ModuleRequest(item)>> ELSE <<>>))
\* ImportEntries (§16.2.2.2) and ImportEntriesForModule (§16.2.2.3).
ImportEntries(node) ==
  ConcatMap(ModuleItems(node), LAMBDA item :
    CASE item.type # "ImportDeclaration" -> <<>>
      [] Has(item.ImportClause) -> ImportClauseEntries(item.ImportClause, ModuleRequest(item), item.Phase)
      [] Has(item.ImportedBinding) ->
           <<[request |-> ModuleRequest(item), isNamespace |-> FALSE, isSource |-> TRUE, importName |-> <<>>,
              localName |-> item.ImportedBinding.name]>>
      [] OTHER -> <<>>)
ImportClauseEntries(clause, request, phase) ==
  (IF Has(clause.ImportedDefaultBinding)
   THEN <<[request |-> request, isNamespace |-> FALSE, isSource |-> FALSE, importName |-> N("default"),
           localName |-> clause.ImportedDefaultBinding.ImportedBinding.name]>>
   ELSE <<>>) \o
  (IF Has(clause.NameSpaceImport)
   THEN <<[request |-> request, isNamespace |-> TRUE, isSource |-> FALSE, isDeferred |-> phase = "defer", importName |-> <<>>,
           localName |-> clause.NameSpaceImport.ImportedBinding.name]>>
   ELSE <<>>) \o
  (IF Has(clause.NamedImports)
   THEN MapSeq(List(clause.NamedImports.ImportsList), LAMBDA spec :
          [request |-> request, isNamespace |-> FALSE, isSource |-> FALSE,
           importName |-> StringValueOf(IF Has(spec.ModuleExportName) THEN spec.ModuleExportName ELSE spec.ImportedBinding),
           localName |-> spec.ImportedBinding.name])
   ELSE <<>>)
\* ExportEntries (§16.2.3.4) and ExportEntriesForModule (§16.2.3.5), with form "local" for an
\* entry without a module request, and otherwise "name", "namespace", or "star" for
\* all-but-default.
ExportEntry(exportName, request, form, importName, localName) ==
  [exportName |-> exportName, request |-> request, form |-> form, importName |-> importName, localName |-> localName]
LocalExport(exportName, localName) == ExportEntry(exportName, Empty, "local", <<>>, localName)
ExportEntries(node) ==
  ConcatMap(ModuleItems(node), LAMBDA item : IF item.type = "ExportDeclaration" THEN ExportDeclarationEntries(item) ELSE <<>>)
ExportDeclarationEntries(n) ==
  CASE Has(n.FromClause) ->
         LET request == ModuleRequest(n)
             clause == n.ExportFromClause
         IN CASE clause.type = "NamedExports" ->
                   MapSeq(List(clause.ExportsList), LAMBDA spec :
                     ExportEntry(StringValueOf(spec.exportName), request, "name", StringValueOf(spec.localName), <<>>))
              [] Has(clause.ModuleExportName) -> <<ExportEntry(StringValueOf(clause.ModuleExportName), request, "namespace", <<>>, <<>>)>>
              [] OTHER -> <<ExportEntry(<<>>, request, "star", <<>>, <<>>)>>
    [] Has(n.NamedExports) ->
         MapSeq(List(n.NamedExports.ExportsList), LAMBDA spec : LocalExport(StringValueOf(spec.exportName), StringValueOf(spec.localName)))
    [] Has(n.VariableStatement) -> MapSeq(BoundNames(n.VariableStatement), LAMBDA name : LocalExport(name, name))
    [] Has(n.Declaration) -> MapSeq(BoundNames(n.Declaration), LAMBDA name : LocalExport(name, name))
    [] Has(n.HoistableDeclaration) -> <<LocalExport(N("default"), BoundNames(n.HoistableDeclaration)[1])>>
    [] Has(n.ClassDeclaration) -> <<LocalExport(N("default"), BoundNames(n.ClassDeclaration)[1])>>
    [] OTHER -> <<LocalExport(N("default"), N("*default*"))>>
\* ParseModule (§16.2.1.7.1) once the host parsed node, and CreateDefaultExportSyntheticModule
\* (§16.2.1.8.1) for a synthetic module.
ModuleRecord(kind, node, value, requests, phases, hasTLA, imports, localExports, indirectExports, starExports) ==
  [kind |-> kind, node |-> node, value |-> value, status |-> "new", error |-> Empty, requests |-> requests,
   phases |-> phases, loaded |-> <<>>, env |-> 0, cycleRoot |-> 0, namespace |-> Empty,
   deferredNamespace |-> Empty, meta |-> Empty, capability |-> Empty,
   moduleSource |-> Empty, hasTLA |-> hasTLA, asyncOrder |-> 0, asyncParents |-> <<>>, pendingAsync |-> 0, dfsAncestorIndex |-> 0,
   imports |-> imports, localExports |-> localExports, indirectExports |-> indirectExports, starExports |-> starExports]
SourceTextModule(node) ==
  LET imports == ImportEntries(node)
      importedNames == {e.localName : e \in Range(imports)}
      exports == ExportEntries(node)
      ImportOf(name) == CHOOSE e \in Range(imports) : e.localName = name
  IN ModuleRecord("source", node, Undefined, ModuleRequests(node), ModuleRequestPhases(node), node.hasTopLevelAwait, imports,
       ConcatMap(exports, LAMBDA e :
         IF e.form = "local" /\ e.localName \notin importedNames THEN <<[exportName |-> e.exportName, localName |-> e.localName]>>
         ELSE <<>>),
       ConcatMap(exports, LAMBDA e :
         CASE e.form = "local" /\ e.localName \in importedNames ->
                <<[exportName |-> e.exportName, request |-> ImportOf(e.localName).request,
                   isNamespace |-> ImportOf(e.localName).isNamespace,
                   isDeferred |-> ImportOf(e.localName).isNamespace /\ ImportOf(e.localName).isDeferred,
                   isSource |-> ImportOf(e.localName).isSource, importName |-> ImportOf(e.localName).importName]>>
           [] e.form \in {"name", "namespace"} ->
                <<[exportName |-> e.exportName, request |-> e.request, isNamespace |-> e.form = "namespace", isDeferred |-> FALSE,
                   isSource |-> FALSE, importName |-> e.importName]>>
           [] OTHER -> <<>>),
       ConcatMap(exports, LAMBDA e : IF e.form = "star" THEN <<[request |-> e.request]>> ELSE <<>>))
\* HostLoadImportedModule (§16.2.1.10) for the test262 host, which loads the files beside the
\* test: the module for request, made the first time the host loads it. The state's parses takes
\* [goal |-> "module", directory, specifier, type] to [ok |-> FALSE, error], with error the name
\* of the error to throw, or to [ok |-> TRUE, id, type, node, source], with id the host's name for
\* the module, type the request's type, and source the code units of a JSON or text module or the
\* bytes of a bytes module. A bytes module's value is a Uint8Array over an immutable ArrayBuffer
\* (CreateBytesModule of proposal-import-bytes). The type "source" is test262's '<module source>',
\* a module with no exports whose [[ModuleSource]] inherits from %AbstractModuleSource.prototype%
\* through a host-defined prototype.
HostLoadModule(s, request) ==
  LET key == [goal |-> "module", directory |-> s.directory, specifier |-> request.specifier,
              type |-> IF N("type") \in DOMAIN request.attributes THEN request.attributes[N("type")] ELSE <<>>]
      loaded == s.parses[key]
  IN IF ~loaded.ok THEN ThrowError(s, loaded.error)
  ELSE IF <<s.realmId, loaded.id>> \in DOMAIN s.moduleIds THEN Ok(s, s.moduleIds[<<s.realmId, loaded.id>>])
  ELSE LET value == CASE loaded.type = N("json") -> JSONParse(s, Str(loaded.source), Undefined)
                      [] loaded.type = N("text") -> Ok(s, Str(loaded.source))
                      [] loaded.type = N("bytes") ->
                           LET buffer == AllocateImmutableArrayBuffer(s, NumFromInt(Len(loaded.source)), loaded.source)
                           IN IF IsAbrupt(buffer) THEN buffer
                              ELSE Construct(buffer.s, Intrinsic(buffer.s, "Uint8Array"), <<Val(buffer)>>, Intrinsic(buffer.s, "Uint8Array"))
                      [] OTHER -> Ok(s, Undefined) IN
  IF IsAbrupt(value) THEN value ELSE
  LET proto == Alloc(value.s, MakeObject(Intrinsic(value.s, "AbstractModuleSourcePrototype"), "ordinary", [none |-> TRUE]))
      source == Alloc(proto.s, MakeObject(proto.v, "ordinary", [moduleSourceClassName |-> N("ModuleSource")]))
      synthetic == ModuleRecord("synthetic", None, Val(value), <<>>, <<>>, FALSE, <<>>, <<>>, <<>>, <<>>)
      record == CASE loaded.type = <<>> -> SourceTextModule(loaded.node)
                  [] loaded.type = N("source") -> [synthetic EXCEPT !.moduleSource = source.v]
                  [] OTHER -> synthetic
      s1 == IF loaded.type = N("source") THEN source.s ELSE value.s
      m == Len(s1.modules) + 1
  IN Ok([s1 EXCEPT !.modules = Append(@, record), !.moduleIds = (<<s.realmId, loaded.id>> :> m) @@ @], m)
\* LoadRequestedModules (§16.2.1.6.1.1, §16.2.1.8.4.1), returning the promise. The loading state is
\* [loading, pending, visited, capability], and the host loads each module at once.
LoadRequestedModules(s, m) ==
  IF ModuleAt(s, m).kind = "synthetic" THEN PromiseResolve(s, Intrinsic(s, "Promise"), Undefined) ELSE
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      r == InnerModuleLoading(cap.s, [loading |-> TRUE, pending |-> 1, visited |-> <<>>, capability |-> Val(cap)], m)
  IN Ok(r.s, Val(cap).promise)
\* InnerModuleLoading (§16.2.1.6.1.1.1), returning [s, state].
InnerModuleLoading(s, state, m) ==
  LET rec == ModuleAt(s, m)
      loaded == IF rec.kind = "source" /\ rec.status = "new" /\ m \notin Range(state.visited)
                THEN LoadRequests(s, [state EXCEPT !.visited = Append(@, m), !.pending = @ + Len(rec.requests)], m, rec.requests)
                ELSE [s |-> s, state |-> state]
      left == [loaded.state EXCEPT !.pending = @ - 1]
  IN IF ~loaded.state.loading THEN loaded
     ELSE IF left.pending # 0 THEN [s |-> loaded.s, state |-> left]
     ELSE LET resolved == Call(MarkUnlinked(loaded.s, left.visited), left.capability.resolve, Undefined, <<Undefined>>)
          IN [s |-> resolved.s, state |-> [left EXCEPT !.loading = FALSE]]
LoadRequests(s, state, m, requests) ==
  IF requests = <<>> \/ ~state.loading THEN [s |-> s, state |-> state] ELSE
  LET request == Head(requests)
      next == CASE ~(DOMAIN request.attributes \subseteq {N("type")}) ->
                     LET e == ThrowError(s, "SyntaxError") IN ContinueModuleLoading(e.s, state, e)
                [] request \in DOMAIN ModuleAt(s, m).loaded -> InnerModuleLoading(s, state, ModuleAt(s, m).loaded[request])
                [] OTHER -> FinishLoadingImportedModule(m, request, state, HostLoadModule(s, request))
  IN LoadRequests(next.s, next.state, m, Tail(requests))
MarkUnlinked(s, visited) ==
  IF visited = <<>> THEN s
  ELSE MarkUnlinked(IF ModuleAt(s, Head(visited)).status = "new" THEN SetModule(s, Head(visited), [status |-> "unlinked"]) ELSE s,
                    Tail(visited))
\* FinishLoadingImportedModule (§16.2.1.11) for a static import, with r the host's completion.
FinishLoadingImportedModule(referrer, request, state, r) ==
  ContinueModuleLoading(IF ~IsAbrupt(r) /\ request \notin DOMAIN ModuleAt(r.s, referrer).loaded
                        THEN SetModule(r.s, referrer, [loaded |-> (request :> Val(r)) @@ ModuleAt(r.s, referrer).loaded])
                        ELSE r.s,
                        state, r)
\* ContinueModuleLoading (§16.2.1.6.1.1.2).
ContinueModuleLoading(s, state, r) ==
  IF ~state.loading THEN [s |-> s, state |-> state]
  ELSE IF ~IsAbrupt(r) THEN InnerModuleLoading(s, state, Val(r))
  ELSE LET rejected == Call(s, state.capability.reject, Undefined, <<r.c.value>>)
       IN [s |-> rejected.s, state |-> [state EXCEPT !.loading = FALSE]]
\* GetExportedNames (§16.2.1.7.2.1, §16.2.1.8.4.2), returning [names, set] with set the
\* exportStarSet the search grew.
GetExportedNames(s, m, starSet) ==
  LET rec == ModuleAt(s, m) IN
  CASE rec.kind = "synthetic" -> [names |-> <<N("default")>>, set |-> starSet]
    [] m \in starSet -> [names |-> <<>>, set |-> starSet]
    [] OTHER -> StarExportedNames(s, m, rec.starExports,
                                  MapSeq(rec.localExports, LAMBDA e : e.exportName) \o
                                  MapSeq(rec.indirectExports, LAMBDA e : e.exportName),
                                  starSet \cup {m})
StarExportedNames(s, m, stars, names, starSet) ==
  IF stars = <<>> THEN [names |-> names, set |-> starSet] ELSE
  LET star == GetExportedNames(s, ModuleAt(s, m).loaded[Head(stars).request], starSet)
  IN StarExportedNames(s, m, Tail(stars), AppendNewNames(names, star.names), star.set)
AppendNewNames(names, more) ==
  IF more = <<>> THEN names
  ELSE AppendNewNames(IF Head(more) = N("default") \/ Head(more) \in Range(names) THEN names ELSE Append(names, Head(more)),
                      Tail(more))
\* ResolveExport (§16.2.1.7.2.2, §16.2.1.8.4.3), returning [result, set] with set the resolveSet
\* the search grew. A result is a ResolvedBinding Record [kind |-> "binding", module, name,
\* namespace, deferred, source], with source for the module's source as the binding, or
\* [kind |-> "null"] or [kind |-> "ambiguous"].
Resolved(m, name, isNamespace, isDeferred) ==
  [kind |-> "binding", module |-> m, name |-> name, namespace |-> isNamespace, deferred |-> isDeferred, source |-> FALSE]
ResolveExport(s, m, name, resolveSet) ==
  LET rec == ModuleAt(s, m)
      set == resolveSet \cup {<<m, name>>}
      local == SelectSeq(rec.localExports, LAMBDA e : e.exportName = name)
      indirect == SelectSeq(rec.indirectExports, LAMBDA e : e.exportName = name)
  IN CASE rec.kind = "synthetic" ->
            [result |-> IF name = N("default") THEN Resolved(m, name, FALSE, FALSE) ELSE NoResolution, set |-> resolveSet]
       [] <<m, name>> \in resolveSet -> [result |-> NoResolution, set |-> resolveSet]
       [] local # <<>> -> [result |-> Resolved(m, local[1].localName, FALSE, FALSE), set |-> set]
       [] indirect # <<>> /\ indirect[1].isNamespace ->
            [result |-> Resolved(rec.loaded[indirect[1].request], <<>>, TRUE, indirect[1].isDeferred), set |-> set]
       [] indirect # <<>> /\ indirect[1].isSource ->
            [result |-> [Resolved(rec.loaded[indirect[1].request], <<>>, FALSE, FALSE) EXCEPT !.source = TRUE], set |-> set]
       [] indirect # <<>> -> ResolveExport(s, rec.loaded[indirect[1].request], indirect[1].importName, set)
       [] name = N("default") -> [result |-> NoResolution, set |-> set]
       [] OTHER -> ResolveStarExport(s, m, name, rec.starExports, NoResolution, set)
ResolveStarExport(s, m, name, stars, star, set) ==
  IF stars = <<>> THEN [result |-> star, set |-> set] ELSE
  LET r == ResolveExport(s, ModuleAt(s, m).loaded[Head(stars).request], name, set) IN
  CASE r.result.kind = "ambiguous" -> r
    [] r.result.kind = "null" -> ResolveStarExport(s, m, name, Tail(stars), star, r.set)
    [] star.kind = "null" -> ResolveStarExport(s, m, name, Tail(stars), r.result, r.set)
    [] r.result # star -> [result |-> [kind |-> "ambiguous"], set |-> r.set]
    [] OTHER -> ResolveStarExport(s, m, name, Tail(stars), star, r.set)
\* GetModuleSource of the source-phase-imports proposal.
GetModuleSource(s, m) ==
  IF ModuleAt(s, m).moduleSource = Empty THEN ThrowError(s, "SyntaxError") ELSE Ok(s, ModuleAt(s, m).moduleSource)
IsResolvable(s, m, name) == ResolveExport(s, m, name, {}).result.kind = "binding"
\* GetModuleNamespace (§16.2.1.13) with ModuleNamespaceCreate (§10.4.6.12), for the evaluation phase
\* or, when isDeferred, the defer phase of the import-defer proposal.
GetModuleNamespace(s, m, isDeferred) ==
  LET field == IF isDeferred THEN "deferredNamespace" ELSE "namespace" IN
  IF ModuleAt(s, m)[field] # Empty THEN Ok(s, ModuleAt(s, m)[field]) ELSE
  LET names == SelectSeq(GetExportedNames(s, m, {}).names, LAMBDA name : IsResolvable(s, m, name))
      object == MakeObject(Null, "namespace", [module |-> m, exports |-> SortCodeUnits(Range(names)), deferred |-> isDeferred])
      tag == IF isDeferred THEN SV("Deferred Module") ELSE SV("Module")
      ns == Alloc(s, PutProp([object EXCEPT !.ext = FALSE], SymToStringTag, DataDesc(tag, FALSE, FALSE, FALSE)))
  IN Ok(SetModule(ns.s, m, [name \in {field} |-> ns.v]), ns.v)
SortCodeUnits(names) ==
  IF names = {} THEN <<>>
  ELSE LET first == CHOOSE name \in names : \A other \in names : name = other \/ CodeUnitLess(name, other)
       IN <<first>> \o SortCodeUnits(names \ {first})
\* Module namespace exotic objects (§10.4.6), with slots [module, exports, deferred]. A deferred
\* namespace evaluates its module before it reads the exports, except for a symbol-like key: a
\* symbol, or "then" (IsSymbolLikeNamespaceKey and GetModuleExportsList of import-defer).
IsSymbolLikeNamespaceKey(s, v, k) == IsSymbol(k) \/ (Slots(s, v).deferred /\ k.value = N("then"))
NamespaceExports(s, v) ==
  IF ~Slots(s, v).deferred THEN Ok(s, Range(Slots(s, v).exports)) ELSE
  LET evaluated == EvaluateModuleSync(s, Slots(s, v).module) IN
  IF IsAbrupt(evaluated) THEN evaluated ELSE Ok(evaluated.s, Range(Slots(s, v).exports))
NamespaceHasProperty(s, v, k) ==
  LET exports == NamespaceExports(s, v) IN IF IsAbrupt(exports) THEN exports ELSE Ok(exports.s, Bool(k.value \in Val(exports)))
NamespaceDelete(s, v, k) ==
  LET exports == NamespaceExports(s, v) IN IF IsAbrupt(exports) THEN exports ELSE Ok(exports.s, Bool(k.value \notin Val(exports)))
NamespaceGet(s, v, k) ==
  LET exports == NamespaceExports(s, v) IN
  IF IsAbrupt(exports) THEN exports
  ELSE IF k.value \notin Val(exports) THEN Ok(exports.s, Undefined) ELSE
  LET binding == ResolveExport(exports.s, Slots(s, v).module, k.value, {}).result IN
  IF binding.namespace THEN GetModuleNamespace(exports.s, binding.module, binding.deferred)
  ELSE IF binding.source THEN GetModuleSource(exports.s, binding.module)
  ELSE IF ModuleAt(exports.s, binding.module).env = 0 THEN ThrowError(exports.s, "ReferenceError")
  ELSE GetBindingValue(exports.s, ModuleAt(exports.s, binding.module).env, binding.name, TRUE)
NamespaceGetOwnProperty(s, v, k) ==
  IF IsSymbolLikeNamespaceKey(s, v, k) THEN Ok(s, OrdinaryGetOwnProperty(O(s, v), k)) ELSE
  LET exports == NamespaceExports(s, v) IN
  IF IsAbrupt(exports) THEN exports
  ELSE IF k.value \notin Val(exports) THEN Ok(exports.s, Absent)
  ELSE LET value == NamespaceGet(exports.s, v, k) IN
       IF IsAbrupt(value) THEN value ELSE Ok(value.s, DataDesc(Val(value), TRUE, TRUE, FALSE))
NamespaceDefineOwnProperty(s, v, k, d) ==
  IF IsSymbolLikeNamespaceKey(s, v, k) THEN OrdinaryDefineOwnProperty(s, v, k, d) ELSE
  LET current == NamespaceGetOwnProperty(s, v, k) IN
  CASE IsAbrupt(current) -> current
    [] Val(current) = Absent \/ d.configurable = True \/ d.enumerable = False \/ IsAccessorDescriptor(d) \/
       d.writable = False -> Ok(current.s, False)
    [] d.value # Absent -> Ok(current.s, Bool(SameValue(d.value, Val(current).value)))
    [] OTHER -> Ok(current.s, True)
NamespaceOwnPropertyKeys(s, v) ==
  LET exports == NamespaceExports(s, v)
      names == IF Slots(s, v).deferred THEN SelectSeq(Slots(s, v).exports, LAMBDA name : name # N("then")) ELSE Slots(s, v).exports
  IN IF IsAbrupt(exports) THEN exports ELSE Ok(exports.s, MapSeq(names, Str) \o OwnKeysOf(O(s, v)))
\* EvaluateModuleSync, ReadyForSyncExecution, IsModuleSCCEvaluated, and
\* GatherAsynchronousTransitiveDependencies of the import-defer proposal. ReadyForSyncExecution and
\* GatherAsyncDependencies return [result, seen].
EvaluateModuleSync(s, m) ==
  IF ~ReadyForSyncExecution(s, m, {}).result THEN ThrowTypeError(s) ELSE
  LET promise == ModuleEvaluate(s, m)
      slots == Slots(promise.s, Val(promise))
  IN IF slots.state = "rejected" THEN ThrowValue(SetSlots(promise.s, Val(promise), [isHandled |-> TRUE]), slots.result)
     ELSE Ok(promise.s, Empty)
IsModuleSCCEvaluated(s, m) ==
  ModuleAt(s, IF ModuleAt(s, m).cycleRoot # 0 THEN ModuleAt(s, m).cycleRoot ELSE m).status = "evaluated"
ReadyForSyncExecution(s, m, seen) ==
  LET rec == ModuleAt(s, m) IN
  CASE rec.kind = "synthetic" \/ m \in seen \/ IsModuleSCCEvaluated(s, m) -> [result |-> TRUE, seen |-> seen \cup {m}]
    [] rec.status \in {"evaluating", "evaluating-async"} \/ rec.hasTLA -> [result |-> FALSE, seen |-> seen \cup {m}]
    [] OTHER -> ReadyRequests(s, m, rec.phases, seen \cup {m})
ReadyRequests(s, m, phases, seen) ==
  IF phases = <<>> THEN [result |-> TRUE, seen |-> seen]
  ELSE IF Head(phases).phase = "source" THEN ReadyRequests(s, m, Tail(phases), seen) ELSE
  LET ready == ReadyForSyncExecution(s, ModuleAt(s, m).loaded[Head(phases).request], seen) IN
  IF ready.result THEN ReadyRequests(s, m, Tail(phases), ready.seen) ELSE ready
GatherAsyncDependencies(s, m, seen) ==
  LET rec == ModuleAt(s, m) IN
  CASE m \in seen -> [result |-> <<>>, seen |-> seen]
    [] rec.kind = "synthetic" \/ rec.status = "evaluating" \/ IsModuleSCCEvaluated(s, m) -> [result |-> <<>>, seen |-> seen \cup {m}]
    [] rec.hasTLA -> [result |-> <<m>>, seen |-> seen \cup {m}]
    [] OTHER -> GatherAsyncRequests(s, m, rec.phases, seen \cup {m}, <<>>)
GatherAsyncRequests(s, m, phases, seen, acc) ==
  IF phases = <<>> THEN [result |-> acc, seen |-> seen]
  ELSE IF Head(phases).phase = "source" THEN GatherAsyncRequests(s, m, Tail(phases), seen, acc) ELSE
  LET gathered == GatherAsyncDependencies(s, ModuleAt(s, m).loaded[Head(phases).request], seen)
  IN GatherAsyncRequests(s, m, Tail(phases), gathered.seen, Dedupe(acc \o gathered.result))
\* Link (§16.2.1.6.1.2, §16.2.1.8.4.4). A failed link leaves the modules it was linking unlinked.
ModuleLink(s, m) ==
  IF ModuleAt(s, m).kind = "synthetic" THEN Ok(SyntheticLink(s, m), Empty) ELSE
  LET r == InnerModuleLinking(s, m, <<>>, 0) IN
  IF IsAbrupt(r) THEN Abrupt(SetStatuses(r.s, "linking", [status |-> "unlinked"]), r.c) ELSE Ok(r.s, Empty)
\* The modules with the status from, with fields set. Only the modules on the DFS stack have
\* status "linking" or "evaluating".
SetStatuses(s, from, fields) ==
  LET modules == s.modules IN
  [s EXCEPT !.modules = [m \in DOMAIN modules |->
                           IF modules[m].kind = "source" /\ modules[m].status = from THEN fields @@ modules[m] ELSE modules[m]]]
SyntheticLink(s, m) ==
  LET env == NewModuleEnvironment(s, s.globalEnv, m)
      created == CreateMutableBinding(env.s, env.e, N("default"), FALSE)
  IN SetModule(InitializeBinding(created.s, env.e, N("default"), Undefined).s, m, [env |-> env.e])
\* InnerModuleLinking (§16.2.1.6.1.2.1), returning [stack, index].
InnerModuleLinking(s, m, stack, index) ==
  LET rec == ModuleAt(s, m) IN
  CASE rec.kind = "synthetic" -> Ok(SyntheticLink(s, m), [stack |-> stack, index |-> index])
    [] rec.status \in {"linking", "linked", "evaluating-async", "evaluated"} -> Ok(s, [stack |-> stack, index |-> index])
    [] OTHER ->
         LET r == LinkRequests(SetModule(s, m, [status |-> "linking", dfsAncestorIndex |-> index]), m, rec.requests,
                               Append(stack, m), index + 1)
         IN IF IsAbrupt(r) THEN r ELSE
         LET init == InitializeEnvironment(r.s, m) IN
         IF IsAbrupt(init) THEN init
         ELSE IF ModuleAt(init.s, m).dfsAncestorIndex # index THEN Ok(init.s, Val(r))
         ELSE LET popped == PopComponent(init.s, Val(r).stack, m, FALSE) IN
              Ok(popped.s, [stack |-> popped.stack, index |-> Val(r).index])
LinkRequests(s, m, requests, stack, index) ==
  IF requests = <<>> THEN Ok(s, [stack |-> stack, index |-> index]) ELSE
  LET required == ModuleAt(s, m).loaded[Head(requests)]
      r == InnerModuleLinking(s, required, stack, index)
  IN IF IsAbrupt(r) THEN r
     ELSE LinkRequests(IF ModuleAt(r.s, required).kind = "source" /\ ModuleAt(r.s, required).status = "linking"
                       THEN SetModule(r.s, m, [dfsAncestorIndex |-> Lesser(ModuleAt(r.s, m).dfsAncestorIndex, ModuleAt(r.s, required).dfsAncestorIndex)])
                       ELSE r.s,
                       m, Tail(requests), Val(r).stack, Val(r).index)
\* Pops the stack down to m, the root of a strongly connected component, giving each module its
\* status once linked or evaluated, and, once evaluated, m as its cycle root. Returns [s, stack].
PopComponent(s, stack, m, isEvaluated) ==
  LET top == stack[Len(stack)]
      s1 == IF isEvaluated
            THEN SetModule(s, top, [status |-> IF ModuleAt(s, top).asyncOrder = 0 THEN "evaluated" ELSE "evaluating-async",
                                    cycleRoot |-> m])
            ELSE SetModule(s, top, [status |-> "linked"])
      rest == SubSeq(stack, 1, Len(stack) - 1)
  IN IF top = m THEN [s |-> s1, stack |-> rest] ELSE PopComponent(s1, rest, m, isEvaluated)
\* InitializeEnvironment (§16.2.1.7.3.1).
ModuleContext(env) == Context(env, env, NoPrivateEnvironment, Null)
InitializeEnvironment(s, m) ==
  LET rec == ModuleAt(s, m) IN
  IF \E i \in DOMAIN rec.indirectExports : ~IsResolvable(s, m, rec.indirectExports[i].exportName)
  THEN ThrowError(s, "SyntaxError") ELSE
  LET env == NewModuleEnvironment(s, s.globalEnv, m)
      imported == BindImports(SetModule(env.s, m, [env |-> env.e]), m, env.e, rec.imports)
  IN IF IsAbrupt(imported) THEN imported ELSE
  LET vars == CreateVarBindings(imported.s, env.e, Dedupe(ConcatMap(VarScopedDeclarations(rec.node), BoundNames)), env.e, FALSE, {})
      lexicals == LexicallyScopedDeclarations(rec.node)
  IN Ok(InitializeModuleFunctions(CreateLexicalBindings(vars, env.e, lexicals), ModuleContext(env.e), env.e,
                                  SelectSeq(lexicals, LAMBDA d : d.type \in FunctionDeclarationTypes)),
        Empty)
BindImports(s, m, env, imports) ==
  IF imports = <<>> THEN Ok(s, Empty) ELSE
  LET entry == Head(imports)
      imported == ModuleAt(s, m).loaded[entry.request]
      resolution == ResolveExport(s, imported, entry.importName, {}).result
      isSource == entry.isSource \/ (~entry.isNamespace /\ resolution.source)
      source == GetModuleSource(s, IF entry.isSource THEN imported ELSE resolution.module)
  IN IF ~entry.isSource /\ ~entry.isNamespace /\ resolution.kind # "binding" THEN ThrowError(s, "SyntaxError")
     ELSE IF isSource /\ IsAbrupt(source) THEN source ELSE
     LET bound ==
           IF isSource THEN
             InitializeBinding(CreateImmutableBinding(s, env, entry.localName, TRUE).s, env, entry.localName, Val(source)).s
           ELSE IF entry.isNamespace \/ resolution.namespace THEN
             LET ns == GetModuleNamespace(s, IF entry.isNamespace THEN imported ELSE resolution.module,
                                          IF entry.isNamespace THEN entry.isDeferred ELSE resolution.deferred)
                 created == CreateImmutableBinding(ns.s, env, entry.localName, TRUE)
             IN InitializeBinding(created.s, env, entry.localName, Val(ns)).s
           ELSE CreateImportBinding(s, env, entry.localName, resolution.module, resolution.name)
     IN BindImports(bound, m, env, Tail(imports))
InitializeModuleFunctions(s, ctx, env, fns) ==
  IF fns = <<>> THEN s
  ELSE LET fo == InstantiateFunctionObject(s, ctx, Head(fns)) IN
       InitializeModuleFunctions(InitializeBinding(fo.s, env, BoundNames(Head(fns))[1], Val(fo)).s, ctx, env, Tail(fns))
\* Evaluate (§16.2.1.6.1.3, §16.2.1.8.4.5), returning the promise.
ModuleEvaluate(s, m0) ==
  LET rec0 == ModuleAt(s, m0)
      m == IF rec0.status \in {"evaluating-async", "evaluated"} /\ rec0.cycleRoot # 0 THEN rec0.cycleRoot ELSE m0
  IN IF rec0.kind = "synthetic" THEN
       LET cap == NewPromiseCapability(SyntheticEvaluate(s, m0), Intrinsic(s, "Promise"))
           resolved == Call(cap.s, Val(cap).resolve, Undefined, <<Undefined>>)
       IN Ok(resolved.s, Val(cap).promise)
     ELSE IF ModuleAt(s, m).capability # Empty THEN Ok(s, ModuleAt(s, m).capability.promise) ELSE
     LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
         r == InnerModuleEvaluation(SetModule(cap.s, m, [capability |-> Val(cap)]), m, <<>>, 0)
         settled == CASE IsAbrupt(r) ->
                           Call(SetStatuses(r.s, "evaluating", [status |-> "evaluated", error |-> r.c.value]),
                                Val(cap).reject, Undefined, <<r.c.value>>)
                      [] ModuleAt(r.s, m).status = "evaluated" -> Call(r.s, Val(cap).resolve, Undefined, <<Undefined>>)
                      [] OTHER -> Ok(r.s, Undefined)
     IN Ok(settled.s, Val(cap).promise)
\* The evaluation steps of a JSON module, which set its default export.
SyntheticEvaluate(s, m) == SetMutableBinding(s, ModuleAt(s, m).env, N("default"), ModuleAt(s, m).value, TRUE).s
\* InnerModuleEvaluation (§16.2.1.6.1.3.1), returning [stack, index].
InnerModuleEvaluation(s, m, stack, index) ==
  LET rec == ModuleAt(s, m) IN
  CASE rec.kind = "synthetic" -> Ok(SyntheticEvaluate(s, m), [stack |-> stack, index |-> index])
    [] rec.status \in {"evaluating-async", "evaluated"} ->
         IF rec.error = Empty THEN Ok(s, [stack |-> stack, index |-> index]) ELSE ThrowValue(s, rec.error)
    [] rec.status = "evaluating" -> Ok(s, [stack |-> stack, index |-> index])
    [] OTHER ->
         LET s1 == SetModule(s, m, [status |-> "evaluating", dfsAncestorIndex |-> index, pendingAsync |-> 0])
             r == EvaluateRequests(s1, m, EvaluationList(s1, m, rec.phases, <<>>), Append(stack, m), index + 1)
         IN IF IsAbrupt(r) THEN r ELSE
         LET isAsync == rec.hasTLA \/ ModuleAt(r.s, m).pendingAsync > 0
             ordered == IF isAsync THEN [SetModule(r.s, m, [asyncOrder |-> r.s.asyncCount]) EXCEPT !.asyncCount = @ + 1]
                        ELSE r.s
             executed == CASE ~isAsync -> ExecuteModule(ordered, m)
                           [] ModuleAt(ordered, m).pendingAsync = 0 -> Ok(ExecuteAsyncModule(ordered, m), Empty)
                           [] OTHER -> Ok(ordered, Empty)
         IN IF IsAbrupt(executed) THEN executed
            ELSE IF ModuleAt(executed.s, m).dfsAncestorIndex # index THEN Ok(executed.s, Val(r))
            ELSE LET popped == PopComponent(executed.s, Val(r).stack, m, TRUE) IN
                 Ok(popped.s, [stack |-> popped.stack, index |-> Val(r).index])
\* BuildEvaluationList of the import-defer proposal: the modules a module evaluates first. A
\* deferred request evaluates only the module's asynchronous dependencies, and a source one none.
EvaluationList(s, m, phases, acc) ==
  IF phases = <<>> THEN acc ELSE
  LET required == ModuleAt(s, m).loaded[Head(phases).request]
      more == CASE Head(phases).phase = "source" -> <<>>
                [] Head(phases).phase = "defer" -> GatherAsyncDependencies(s, required, {}).result
                [] OTHER -> <<required>>
  IN EvaluationList(s, m, Tail(phases), Dedupe(acc \o more))
EvaluateRequests(s, m, modules, stack, index) ==
  IF modules = <<>> THEN Ok(s, [stack |-> stack, index |-> index]) ELSE
  LET required == Head(modules)
      r == InnerModuleEvaluation(s, required, stack, index)
      isEvaluating == ModuleAt(r.s, required).status = "evaluating"
      \* The module in the stack, or else the root of its cycle, which evaluated without error.
      target == IF isEvaluating THEN required ELSE ModuleAt(r.s, required).cycleRoot
      lowered == IF isEvaluating
                 THEN SetModule(r.s, m, [dfsAncestorIndex |-> Lesser(ModuleAt(r.s, m).dfsAncestorIndex, ModuleAt(r.s, required).dfsAncestorIndex)])
                 ELSE r.s
      waiting == IF ModuleAt(lowered, target).asyncOrder > 0
                 THEN SetModule(SetModule(lowered, m, [pendingAsync |-> ModuleAt(lowered, m).pendingAsync + 1]),
                                target, [asyncParents |-> Append(ModuleAt(lowered, target).asyncParents, m)])
                 ELSE lowered
  IN CASE IsAbrupt(r) -> r
       [] ModuleAt(r.s, required).kind = "synthetic" -> EvaluateRequests(r.s, m, Tail(modules), Val(r).stack, Val(r).index)
       [] ~isEvaluating /\ ModuleAt(r.s, target).error # Empty -> ThrowValue(r.s, ModuleAt(r.s, target).error)
       [] OTHER -> EvaluateRequests(waiting, m, Tail(modules), Val(r).stack, Val(r).index)
\* ExecuteModule (§16.2.1.7.3.2) for a module without top-level await.
ExecuteModule(s, m) ==
  LET r == EvaluateDisposing(s, ModuleContext(ModuleAt(s, m).env), ModuleItems(ModuleAt(s, m).node)) IN
  IF IsAbrupt(r) THEN r ELSE Ok(r.s, Empty)
\* ExecuteAsyncModule (§16.2.1.6.1.3.2), with ExecuteModule's AsyncBlockStart, returning the state.
ExecuteAsyncModule(s, m) ==
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      onFulfilled == CreateBuiltinFunction(cap.s, <<"Module", "asyncFulfilled">>, 0, <<>>, m)
      onRejected == CreateBuiltinFunction(onFulfilled.s, <<"Module", "asyncRejected">>, 0, <<>>, m)
      then == AddPromiseReactions(onRejected.s, Val(cap).promise, Val(onFulfilled), Val(onRejected), Empty)
  IN AsyncFunctionStep(Val(cap), EvaluateDisposing(then.s, ModuleContext(ModuleAt(s, m).env), ModuleItems(ModuleAt(s, m).node))).s
\* AsyncModuleExecutionFulfilled (§16.2.1.6.1.3.4), returning the state.
AsyncModuleExecutionFulfilled(s, m) ==
  IF ModuleAt(s, m).status = "evaluated" THEN s ELSE
  LET gathered == GatherAvailableAncestors(SettleEvaluated(s, m), m, <<>>)
  IN ExecuteAncestors(gathered.s, SortByAsyncOrder(gathered.s, gathered.list))
\* Marks an async module evaluated, and resolves its top-level capability.
SettleEvaluated(s, m) ==
  LET s1 == SetModule(s, m, [asyncOrder |-> -1, status |-> "evaluated"]) IN
  IF ModuleAt(s1, m).capability = Empty THEN s1 ELSE Call(s1, ModuleAt(s1, m).capability.resolve, Undefined, <<Undefined>>).s
\* GatherAvailableAncestors (§16.2.1.6.1.3.3), returning [s, list].
GatherAvailableAncestors(s, m, list) == GatherFrom(s, ModuleAt(s, m).asyncParents, list)
GatherFrom(s, parents, list) ==
  IF parents = <<>> THEN [s |-> s, list |-> list] ELSE
  LET ancestor == Head(parents)
      s1 == SetModule(s, ancestor, [pendingAsync |-> ModuleAt(s, ancestor).pendingAsync - 1])
      more == CASE ancestor \in Range(list) \/ ModuleAt(s, ModuleAt(s, ancestor).cycleRoot).error # Empty -> [s |-> s, list |-> list]
                [] ModuleAt(s1, ancestor).pendingAsync # 0 -> [s |-> s1, list |-> list]
                [] ModuleAt(s1, ancestor).hasTLA -> [s |-> s1, list |-> Append(list, ancestor)]
                [] OTHER -> GatherAvailableAncestors(s1, ancestor, Append(list, ancestor))
  IN GatherFrom(more.s, Tail(parents), more.list)
SortByAsyncOrder(s, list) ==
  IF list = <<>> THEN <<>>
  ELSE LET first == CHOOSE m \in Range(list) : \A other \in Range(list) : ModuleAt(s, m).asyncOrder <= ModuleAt(s, other).asyncOrder
       IN <<first>> \o SortByAsyncOrder(s, SelectSeq(list, LAMBDA other : other # first))
ExecuteAncestors(s, list) ==
  IF list = <<>> THEN s ELSE
  LET ancestor == Head(list)
      r == ExecuteModule(s, ancestor)
      next == CASE ModuleAt(s, ancestor).status = "evaluated" -> s
                [] ModuleAt(s, ancestor).hasTLA -> ExecuteAsyncModule(s, ancestor)
                [] IsAbrupt(r) -> AsyncModuleExecutionRejected(r.s, ancestor, r.c.value)
                [] OTHER -> SettleEvaluated(r.s, ancestor)
  IN ExecuteAncestors(next, Tail(list))
\* AsyncModuleExecutionRejected (§16.2.1.6.1.3.5), returning the state.
AsyncModuleExecutionRejected(s, m, error) ==
  IF ModuleAt(s, m).status = "evaluated" THEN s ELSE
  LET s1 == SetModule(s, m, [error |-> error, status |-> "evaluated", asyncOrder |-> -1])
      s2 == IF ModuleAt(s1, m).capability = Empty THEN s1 ELSE Call(s1, ModuleAt(s1, m).capability.reject, Undefined, <<error>>).s
  IN RejectAsyncParents(s2, ModuleAt(s2, m).asyncParents, error)
RejectAsyncParents(s, parents, error) ==
  IF parents = <<>> THEN s
  ELSE RejectAsyncParents(AsyncModuleExecutionRejected(s, Head(parents), error), Tail(parents), error)
\* %AbstractModuleSource% of the source-phase-imports proposal, which test262 reaches as
\* $262.AbstractModuleSource. Its @@toStringTag getter returns [[ModuleSourceClassName]].
\* The AbstractModuleSource built-ins, and the closures of ExecuteAsyncModule and ContinueDynamicImport.
ModuleBuiltin(s, f, m, this, args, nt) ==
  LET data == O(s, f).slots.data IN
  CASE m = "abstractModuleSource" -> ThrowTypeError(s)
    [] m = "abstractModuleSourceTag" ->
         Ok(s, IF IsObject(this) /\ "moduleSourceClassName" \in DOMAIN O(s, this).slots
               THEN Str(O(s, this).slots.moduleSourceClassName) ELSE Undefined)
    [] m = "asyncFulfilled" -> Ok(AsyncModuleExecutionFulfilled(s, data), Undefined)
    [] m = "asyncRejected" -> Ok(AsyncModuleExecutionRejected(s, data, Arg(args, 1)), Undefined)
    [] m = "importRejected" -> ResultThen(Undefined, Call(s, data.reject, Undefined, <<Arg(args, 1)>>))
    [] m = "importLoaded" -> LinkAndEvaluate(s, data)
    [] m = "importEvaluated" -> ResolveImport(s, data)
\* EvaluateImportCall (§13.3.10.2). The test262 host resolves a specifier the same way from any
\* script or module, so the referrer drops out.
EvaluateImportCall(s, ctx, n) == ImportSpecifierThen(ctx, n, EvaluateValue(s, ctx, n.AssignmentExpression))
ImportSpecifierThen(ctx, n, r) ==
  IF IsSuspended(r) THEN Pass(r, "ImportSpecifierThen", <<ctx, n>>) ELSE
  IF IsAbrupt(r) THEN r
  ELSE IF Has(n.OptionsExpression) THEN ImportOptionsThen(n.Phase, Val(r), EvaluateValue(r.s, ctx, n.OptionsExpression))
  ELSE StartImport(r.s, n.Phase, Val(r), Undefined)
ImportOptionsThen(phase, specifier, r) ==
  IF IsSuspended(r) THEN Pass(r, "ImportOptionsThen", <<phase, specifier>>) ELSE IF IsAbrupt(r) THEN r ELSE StartImport(r.s, phase, specifier, Val(r))
StartImport(s, phase, specifier, options) ==
  LET cap == NewPromiseCapability(s, Intrinsic(s, "Promise"))
      str == ToStr(cap.s, specifier)
      attributes == ImportAttributesOf(str.s, options)
  IN IF IsAbrupt(str) THEN RejectWith(str, Val(cap))
     ELSE IF IsAbrupt(attributes) THEN RejectWith(attributes, Val(cap))
     ELSE LET continued == ContinueDynamicImport(HostLoadModule(attributes.s, [specifier |-> Val(str).value,
                                                                              attributes |-> Val(attributes)]),
                                                 Val(cap), phase)
          IN Ok(continued.s, Val(cap).promise)
\* Steps 13 and 14 of EvaluateImportCall: the attributes of the options, or a throw completion for
\* the TypeError the promise rejects with.
ImportAttributesOf(s, options) ==
  IF options = Undefined THEN Ok(s, NoAttributes)
  ELSE IF ~IsObject(options) THEN ThrowTypeError(s) ELSE
  LET with == Get(s, options, SV("with")) IN
  IF IsAbrupt(with) \/ Val(with) = Undefined THEN IF IsAbrupt(with) THEN with ELSE Ok(with.s, NoAttributes)
  ELSE IF ~IsObject(Val(with)) THEN ThrowTypeError(with.s) ELSE
  LET entries == EnumerableOwnProperties(with.s, Val(with), "pair")
      pairs == Range(Val(entries))
  IN IF IsAbrupt(entries) THEN entries
     ELSE IF \E pair \in pairs : ~IsString(pair[2]) \/ pair[1].value # N("type") THEN ThrowTypeError(entries.s)
     ELSE Ok(entries.s, [key \in {pair[1].value : pair \in pairs} |-> (CHOOSE pair \in pairs : pair[1].value = key)[2].value])
\* ContinueDynamicImport (§13.3.10.3), returning [s, c]. import.source resolves with the module's
\* [[ModuleSource]] once it loads, or rejects with a SyntaxError if it has none. import.defer, of the import-defer proposal, evaluates only the module's asynchronous
\* dependencies before it resolves with the deferred namespace.
ContinueDynamicImport(r, cap, phase) ==
  IF IsAbrupt(r) THEN Call(r.s, cap.reject, Undefined, <<r.c.value>>)
  ELSE IF phase = "source" THEN
    LET source == GetModuleSource(r.s, Val(r)) IN
    IF IsAbrupt(source) THEN Call(source.s, cap.reject, Undefined, <<source.c.value>>)
    ELSE Call(source.s, cap.resolve, Undefined, <<Val(source)>>)
  ELSE
  LET loading == LoadRequestedModules(r.s, Val(r))
      onRejected == CreateBuiltinFunction(loading.s, <<"Module", "importRejected">>, 1, <<>>, cap)
      linkAndEvaluate == CreateBuiltinFunction(onRejected.s, <<"Module", "importLoaded">>, 0, <<>>,
                                               [module |-> Val(r), capability |-> cap, onRejected |-> Val(onRejected),
                                                isDeferred |-> phase = "defer"])
  IN AddPromiseReactions(linkAndEvaluate.s, Val(loading), Val(linkAndEvaluate), Val(onRejected), Empty)
LinkAndEvaluate(s, data) ==
  LET link == ModuleLink(s, data.module) IN
  IF IsAbrupt(link) THEN ResultThen(Undefined, Call(link.s, data.capability.reject, Undefined, <<link.c.value>>)) ELSE
  LET deps == GatherAsyncDependencies(link.s, data.module, {}).result
      each == EvaluateEach(link.s, deps, <<>>)
      evaluated == IF data.isDeferred THEN SafePromiseAll(each.s, each.promises) ELSE ModuleEvaluate(link.s, data.module)
      onFulfilled == CreateBuiltinFunction(evaluated.s, <<"Module", "importEvaluated">>, 0, <<>>, data)
  IN IF data.isDeferred /\ deps = <<>> THEN ResolveImport(link.s, data)
     ELSE ResultThen(Undefined, AddPromiseReactions(onFulfilled.s, Val(evaluated), Val(onFulfilled), data.onRejected, Empty))
EvaluateEach(s, modules, promises) ==
  IF modules = <<>> THEN [s |-> s, promises |-> promises]
  ELSE LET evaluated == ModuleEvaluate(s, Head(modules)) IN EvaluateEach(evaluated.s, Tail(modules), Append(promises, Val(evaluated)))
ResolveImport(s, data) ==
  LET ns == GetModuleNamespace(s, data.module, data.isDeferred) IN
  ResultThen(Undefined, Call(ns.s, data.capability.resolve, Undefined, <<Val(ns)>>))
\* import.meta (§13.3.12.1), with the host adding no properties. The module is the one whose
\* environment holds the code's.
EvaluateImportMeta(s, ctx, n) ==
  LET m == ActiveModule(s, ctx.lex) IN
  IF ModuleAt(s, m).meta # Empty THEN Ok(s, ModuleAt(s, m).meta) ELSE
  LET meta == OrdinaryObjectCreate(s, Null) IN Ok(SetModule(meta.s, m, [meta |-> Val(meta)]), Val(meta))
ActiveModule(s, e) == IF E(s, e).kind = "module" THEN E(s, e).module ELSE ActiveModule(s, E(s, e).outer)
\* Evaluation of an ExportDeclaration (§16.2.3.7).
EvaluateExportDeclaration(s, ctx, n) ==
  CASE Has(n.VariableStatement) -> EvaluateStatement(s, ctx, n.VariableStatement)
    [] Has(n.Declaration) /\ DecoratorsOf(n) # <<>> ->
         ResultThen(Empty, BindingClassDeclarationEvaluation(s, ctx, n.Declaration, DecoratorsOf(n)))
    [] Has(n.Declaration) -> EvaluateStatement(s, ctx, n.Declaration)
    [] Has(n.ClassDeclaration) ->
         ExportDefaultThen(ctx, Has(n.ClassDeclaration.BindingIdentifier),
                           BindingClassDeclarationEvaluation(s, ctx, n.ClassDeclaration,
                                                             DecoratorsOf(n) \o DecoratorsOf(n.ClassDeclaration)))
    [] Has(n.AssignmentExpression) ->
         ExportDefaultThen(ctx, FALSE, IF IsAnonymousFunctionDefinition(n.AssignmentExpression)
                                       THEN NamedEvaluation(s, ctx, n.AssignmentExpression, SV("default"))
                                       ELSE EvaluateValue(s, ctx, n.AssignmentExpression))
    [] OTHER -> Ok(s, Empty)
\* Binds *default* to the value r gives, unless the class declaration bound its own name.
ExportDefaultThen(ctx, isNamed, r) ==
  IF IsSuspended(r) THEN Pass(r, "ExportDefaultThen", <<ctx, isNamed>>) ELSE
  IF IsAbrupt(r) \/ isNamed THEN ResultThen(Empty, r)
  ELSE ResultThen(Empty, InitializeBinding(r.s, ctx.lex, N("*default*"), Val(r)))
\* Runs a module test after a harness result: loads the module that specifier names, links it,
\* evaluates it, and runs the jobs, throwing what a rejected promise holds.
RunModule(s, specifier) ==
  LET loaded == HostLoadModule(s, [specifier |-> specifier, attributes |-> NoAttributes])
      loading == LoadRequestedModules(loaded.s, Val(loaded))
  IN IF IsAbrupt(loaded) THEN loaded
     ELSE IF Slots(loading.s, Val(loading)).state = "rejected" THEN ThrowValue(loading.s, Slots(loading.s, Val(loading)).result) ELSE
     LET link == ModuleLink(loading.s, Val(loaded)) IN
     IF IsAbrupt(link) THEN link ELSE
     LET evaluated == ModuleEvaluate(link.s, Val(loaded))
         jobs == RunJobs(evaluated.s)
     IN IF IsAbrupt(jobs) THEN jobs
        ELSE IF Slots(jobs.s, Val(evaluated)).state = "rejected" THEN ThrowValue(jobs.s, Slots(jobs.s, Val(evaluated)).result)
        ELSE jobs
\* Temporal's ISO 8601 calendar (§12), time zones (§11), and relative durations (§7.5). An ISO
\* date record is [year, month, day] and an ISO date-time record [date, time], of TLA+ integers.
\* A calendar is "iso8601", the only one engine262 has, and a time zone is [id, offset], its
\* identifier and its offset in minutes: UTC, the only named time zone engine262 has, or an offset
\* time zone. Calendar loops over days, months, and years have closed forms here, which give the
\* loops' results.
ISODaysInMonth(year, month) ==
  CASE month \in {1, 3, 5, 7, 8, 10, 12} -> 31
    [] month \in {4, 6, 9, 11} -> 30
    [] OTHER -> IF IsLeapYear(year) THEN 29 ELSE 28
BalanceISOYearMonth(year, month) == [year |-> year + (month - 1) \div 12, month |-> ((month - 1) % 12) + 1]
\* ISODateToEpochDays, with the day added as is.
ISODateToEpochDays(year, month, day) ==
  LET ym == BalanceISOYearMonth(year, month) IN
  DayFromYear(ym.year) + MonthStart(ym.month - 1, IF IsLeapYear(ym.year) THEN 1 ELSE 0) + day - 1
EpochDays(date) == ISODateToEpochDays(date.year, date.month, date.day)
\* The ISO date a number of days after the epoch.
EpochDaysToISODate(days) ==
  LET year == YearFromDay(days)
      leap == IF IsLeapYear(year) THEN 1 ELSE 0
      dayWithinYear == days - DayFromYear(year)
      month == CHOOSE m \in 0..11 : MonthStart(m, leap) <= dayWithinYear /\ dayWithinYear < MonthStart(m + 1, leap)
  IN [year |-> year, month |-> month + 1, day |-> dayWithinYear - MonthStart(month, leap) + 1]
AddDaysToISODate(date, days) == EpochDaysToISODate(EpochDays(date) + days)
CompareISODate(x, y) == CompareFieldsFrom(<<x.year, x.month, x.day>>, <<y.year, y.month, y.day>>, 1)
CompareISODateTime(x, y) ==
  LET d == CompareISODate(x.date, y.date) IN IF d # 0 THEN d ELSE CompareTimeRecord(x.time, y.time)
\* The epoch nanoseconds limits (nsMaxInstant), and IsWithinEpochNanosecondsInterval.
IsWithinEpochNanosecondsInterval(ns) == ~BigIntLess(TINsMaxInstant, TIAbs(ns))
GetUTCEpochNanoseconds(dt) == TIAdd(TIMul(TI(EpochDays(dt.date)), TINsPerDay), TimeNanoseconds(dt.time))
IsValidISODaysRange(date) == LET days == EpochDays(date) IN days >= -100000000 /\ days <= 100000000
ISODateTimeWithinLimits(dt) ==
  LET days == EpochDays(dt.date) IN
  days >= -100000001 /\ days <= 100000000 /\
  LET ns == GetUTCEpochNanoseconds(dt) IN
  BigIntLess(TISub(TINeg(TINsMaxInstant), TINsPerDay), ns) /\ BigIntLess(ns, TIAdd(TINsMaxInstant, TINsPerDay))
ISODateWithinLimits(date) == ISODateTimeWithinLimits([date |-> date, time |-> NoonTimeRecord])
ISOYearMonthWithinLimits(date) ==
  date.year >= -271821 /\ date.year <= 275760 /\ ~(date.year = -271821 /\ date.month < 4) /\
  ~(date.year = 275760 /\ date.month > 9)
\* BalanceISODateTime of a date-time with nanoseconds added, and the ISO date-time of epoch
\* nanoseconds.
AddNanosecondsToISODateTime(dt, ns) ==
  LET balanced == BalanceTime(TIAdd(TimeNanoseconds(dt.time), ns)) IN
  [date |-> AddDaysToISODate(dt.date, TIToInt(balanced.days)), time |-> balanced.time]
EpochNsToISODateTime(ns) ==
  LET balanced == BalanceTime(ns) IN [date |-> EpochDaysToISODate(TIToInt(balanced.days)), time |-> balanced.time]
\* A year past which every date is out of range, so a larger one need not be a TLA+ integer.
TIYearInRange(year) == ~BigIntLess(TI(1000000), TIAbs(year))
\* An integer clamped to low..high.
TIClamp(a, low, high) == IF BigIntLess(a, TI(low)) THEN low ELSE IF BigIntLess(TI(high), a) THEN high ELSE TIToInt(a)
\* RegulateISODate for a year and BigInt month and day.
RegulateISODate(s, year, month, day, overflow) ==
  IF overflow = N("constrain") THEN
    LET m == TIClamp(month, 1, 12) IN
    Ok(s, [year |-> year, month |-> m, day |-> TIClamp(day, 1, ISODaysInMonth(year, m))])
  ELSE IF BigIntLess(month, TI(1)) \/ BigIntLess(TI(12), month) THEN ThrowError(s, "RangeError")
  ELSE LET m == TIToInt(month) IN
       IF BigIntLess(day, TI(1)) \/ BigIntLess(TI(ISODaysInMonth(year, m)), day) THEN ThrowError(s, "RangeError")
       ELSE Ok(s, [year |-> year, month |-> m, day |-> TIToInt(day)])
\* CalendarDateAdd for a date duration, whose fields share a sign. Past the bounds checked first,
\* every result is out of range.
CalendarDateAdd(s, date, duration, overflow) ==
  LET days == TIAdd(duration[4], TIMul(TI(7), duration[3])) IN
  IF BigIntLess(TI(600000), TIAbs(duration[1])) \/ BigIntLess(TI(7200000), TIAbs(duration[2])) \/
     BigIntLess(TI(250000000), TIAbs(days)) THEN ThrowError(s, "RangeError")
  ELSE LET ym == BalanceISOYearMonth(date.year + TIToInt(duration[1]), date.month + TIToInt(duration[2]))
           regulated == RegulateISODate(s, ym.year, TI(ym.month), TI(date.day), overflow)
       IN IF IsAbrupt(regulated) THEN regulated
          ELSE LET result == AddDaysToISODate(Val(regulated), TIToInt(days)) IN
               IF ISODateWithinLimits(result) THEN Ok(s, result) ELSE ThrowError(s, "RangeError")
\* CompareSurpasses for the ISO calendar, whose month codes order as their months do.
Surpasses(sign, year, month, day, target) ==
  sign * CompareFieldsFrom(<<year, month, day>>, <<target.year, target.month, target.day>>, 1) > 0
\* CalendarDateUntil for the ISO calendar. Each of its loops finds the largest count, in the
\* direction of sign, that doesn't surpass the target; that count is the difference of the
\* fields, or one less when the smaller fields surpass the target's.
CalendarDateUntil(from, to, largestUnit) ==
  LET compared == CompareISODate(from, to) IN
  IF compared = 0 THEN ZeroDateDuration ELSE
  LET sign == -compared
      yearsGuess == to.year - from.year
      years0 == IF Surpasses(sign, from.year + yearsGuess, from.month, from.day, to) THEN yearsGuess - sign ELSE yearsGuess
      years == IF largestUnit = TUYear /\ sign * years0 > 0 THEN years0 ELSE 0
      y0 == from.year + years
      monthsGuess == (to.year * 12 + to.month) - (y0 * 12 + from.month)
      guessed == BalanceISOYearMonth(y0, from.month + monthsGuess)
      months0 == IF Surpasses(sign, guessed.year, guessed.month, from.day, to) THEN monthsGuess - sign ELSE monthsGuess
      months == IF largestUnit <= TUMonth /\ sign * months0 > 0 THEN months0 ELSE 0
      ym == BalanceISOYearMonth(y0, from.month + months)
      regulated == [year |-> ym.year, month |-> ym.month,
                    day |-> IF from.day > ISODaysInMonth(ym.year, ym.month) THEN ISODaysInMonth(ym.year, ym.month) ELSE from.day]
      span == EpochDays(to) - EpochDays(regulated)
      weeks == IF largestUnit = TUWeek THEN sign * ((sign * span) \div 7) ELSE 0
      days == span - 7 * weeks
  IN <<TI(years), TI(months), TI(weeks), TI(IF sign * days < 0 THEN 0 ELSE days)>>
\* ISODayOfWeek, ISODayOfYear, and ISOWeekOfYear (as [week, year]).
ISODayOfWeek(date) == LET w == (EpochDays(date) + 4) % 7 IN IF w = 0 THEN 7 ELSE w
ISODayOfYear(date) == EpochDays(date) - DayFromYear(date.year) + 1
ISOWeekOfYear(date) ==
  LET year == date.year
      dayOfYear == ISODayOfYear(date)
      dayOfWeek == ISODayOfWeek(date)
      week == (dayOfYear + 7 - dayOfWeek + 3) \div 7
      jan1 == ISODayOfWeek([year |-> year, month |-> 1, day |-> 1])
  IN IF week < 1 THEN
       IF jan1 = 5 \/ (jan1 = 6 /\ IsLeapYear(year - 1)) THEN [week |-> 53, year |-> year - 1] ELSE [week |-> 52, year |-> year - 1]
     ELSE IF week = 53 /\ (IF IsLeapYear(year) THEN 366 ELSE 365) - dayOfYear < 4 - dayOfWeek THEN [week |-> 1, year |-> year + 1]
     ELSE [week |-> week, year |-> year]
\* CreateMonthCode and ParseMonthCode (as [month, leap]).
CreateMonthCode(month, leap) == <<77>> \o TwoDigits(month) \o (IF leap THEN <<76>> ELSE <<>>)
IsMonthCode(u) ==
  Len(u) \in {3, 4} /\ u[1] = 77 /\ IsDigit(u[2]) /\ IsDigit(u[3]) /\ (Len(u) = 4 => u[4] = 76) /\
  (u[2] # 48 \/ u[3] # 48 \/ Len(u) = 4)
ParseMonthCode(s, v) ==
  LET p == ToPrimitive(s, v, "string") IN IF IsAbrupt(p) THEN p
  ELSE IF ~IsString(Val(p)) THEN ThrowTypeError(p.s)
  ELSE IF ~IsMonthCode(Val(p).value) THEN ThrowError(p.s, "RangeError")
  ELSE Ok(p.s, [month |-> TPInt(Val(p).value, 2, 3), leap |-> Len(Val(p).value) = 4])
\* PadISOYear, FormatCalendarAnnotation, TemporalDateToString, and FormatISODateTime.
PadISOYear(year) ==
  IF year >= 0 /\ year <= 9999 THEN PadStart(IntUnits(year), 4)
  ELSE (IF year > 0 THEN <<43>> ELSE <<45>>) \o PadStart(IntUnits(IF year < 0 THEN -year ELSE year), 6)
FormatCalendarAnnotation(id, show) ==
  IF show = N("never") \/ (show = N("auto") /\ id = ISO8601) THEN <<>>
  ELSE <<91>> \o (IF show = N("critical") THEN <<33>> ELSE <<>>) \o N("u-ca=") \o id \o <<93>>
ISODateUnits(date) == PadISOYear(date.year) \o <<45>> \o TwoDigits(date.month) \o <<45>> \o TwoDigits(date.day)
TemporalDateToString(date, calendar, show) == ISODateUnits(date) \o FormatCalendarAnnotation(calendar, show)
FormatISODateTime(dt, calendar, precision, show) ==
  ISODateUnits(dt.date) \o <<84>> \o TimeRecordToString(dt.time, precision) \o FormatCalendarAnnotation(calendar, show)
GetTemporalShowCalendarNameOption(s, options) ==
  GetStringOption(s, options, SV("calendarName"), {N("auto"), N("always"), N("never"), N("critical")}, N("auto"))
\* Calendar identifiers: CanonicalizeCalendar, ParseTemporalCalendarString,
\* ToTemporalCalendarIdentifier, and GetTemporalCalendarIdentifierWithISODefault.
CanonicalizeCalendar(s, id) == IF TPLower(id) = ISO8601 THEN Ok(s, ISO8601) ELSE ThrowError(s, "RangeError")
ParseTemporalCalendarString(s, units) ==
  LET r == ParseISODateTime(s, units, "all") IN
  IF ~IsAbrupt(r) THEN Ok(r.s, IF Val(r).calendar = Empty THEN ISO8601 ELSE Val(r).calendar)
  ELSE IF TPFull(units, TPAnnotationValue(units, 1)) THEN Ok(s, units)
  ELSE ThrowError(s, "RangeError")
ToTemporalCalendarIdentifier(s, v) ==
  IF IsObject(v) /\ O(s, v).class \in CalendarClasses THEN Ok(s, O(s, v).slots.calendar)
  ELSE IF ~IsString(v) THEN ThrowTypeError(s)
  ELSE LET id == ParseTemporalCalendarString(s, v.value) IN IF IsAbrupt(id) THEN id ELSE CanonicalizeCalendar(id.s, Val(id))
GetTemporalCalendarIdentifierWithISODefault(s, item) ==
  IF O(s, item).class \in CalendarClasses THEN Ok(s, O(s, item).slots.calendar)
  ELSE LET calendar == Get(s, item, SV("calendar")) IN IF IsAbrupt(calendar) THEN calendar
  ELSE IF Val(calendar) = Undefined THEN Ok(calendar.s, ISO8601)
  ELSE ToTemporalCalendarIdentifier(calendar.s, Val(calendar))
\* Time zones. FormatOffsetTimeZoneIdentifier, ParseTemporalTimeZoneString, and
\* ToTemporalTimeZoneIdentifier.
FormatOffsetTimeZoneIdentifier(minutes, separated) ==
  LET a == IF minutes < 0 THEN -minutes ELSE minutes IN
  (IF minutes >= 0 THEN <<43>> ELSE <<45>>) \o FormatTimeString(a \div 60, a % 60, 0, 0, TPrecisionMinute, separated)
ParseTemporalTimeZoneString(s, units) ==
  IF TPFull(units, TPTimeZoneIdentifier(units, 1)) THEN ParseTimeZoneIdentifier(s, units)
  ELSE LET r == ParseISODateTime(s, units, "all") IN IF IsAbrupt(r) THEN r
  ELSE IF Val(r).tzAnnotation # Empty THEN ParseTimeZoneIdentifier(r.s, Val(r).tzAnnotation)
  ELSE IF Val(r).z THEN ParseTimeZoneIdentifier(r.s, N("UTC"))
  ELSE IF Val(r).offset # Empty THEN ParseTimeZoneIdentifier(r.s, Val(r).offset)
  ELSE ThrowError(r.s, "RangeError")
ToTemporalTimeZoneIdentifier(s, v) ==
  IF IsObject(v) /\ O(s, v).class = "temporalZonedDateTime" THEN Ok(s, O(s, v).slots.timeZone)
  ELSE IF ~IsString(v) THEN ThrowTypeError(s)
  ELSE LET r == ParseTemporalTimeZoneString(s, v.value) IN IF IsAbrupt(r) THEN r
  ELSE IF Val(r).offsetMinutes # Empty THEN
    Ok(r.s, [id |-> FormatOffsetTimeZoneIdentifier(Val(r).offsetMinutes, TRUE), offset |-> Val(r).offsetMinutes])
  ELSE IF TPLower(Val(r).name) = N("utc") THEN Ok(r.s, UTCTimeZone)
  ELSE ThrowError(r.s, "RangeError")
TimeZoneEquals(x, y) == x.id = y.id
\* GetOffsetNanosecondsFor, GetISODateTimeFor, and GetPossibleEpochNanoseconds, which has one
\* result for a time zone with a fixed offset, so GetEpochNanosecondsFor and GetStartOfDay need no
\* disambiguation.
GetOffsetNanosecondsFor(tz) == TIMul(TI(tz.offset), TINsPerMinute)
GetISODateTimeFor(tz, ns) == EpochNsToISODateTime(TIAdd(ns, GetOffsetNanosecondsFor(tz)))
GetEpochNanosecondsFor(s, tz, dt) ==
  LET balanced == AddNanosecondsToISODateTime(dt, TINeg(GetOffsetNanosecondsFor(tz)))
      ns == GetUTCEpochNanoseconds(balanced)
  IN IF (tz # UTCTimeZone /\ ~IsValidISODaysRange(balanced.date)) \/ ~IsWithinEpochNanosecondsInterval(ns)
     THEN ThrowError(s, "RangeError") ELSE Ok(s, ns)
GetStartOfDay(s, tz, date) == GetEpochNanosecondsFor(s, tz, [date |-> date, time |-> MidnightTimeRecord])
\* The epoch nanoseconds of a date-time in a time zone, or as UTC for no time zone (Empty).
EpochNsOf(s, dt, tz) == IF tz = Empty THEN Ok(s, GetUTCEpochNanoseconds(dt)) ELSE GetEpochNanosecondsFor(s, tz, dt)
\* FormatUTCOffsetNanoseconds and FormatDateTimeUTCOffsetRounded.
FormatUTCOffsetNanoseconds(ns) ==
  LET a == TIAbs(ns)
      seconds == TIToInt(BigIntDiv(a, TINsPerSecond))
      sub == TIToInt(BigIntRem(a, TINsPerSecond))
  IN (IF ns.neg THEN <<45>> ELSE <<43>>) \o
     FormatTimeString(seconds \div 3600, (seconds \div 60) % 60, seconds % 60, sub,
                      IF seconds % 60 = 0 /\ sub = 0 THEN TPrecisionMinute ELSE TPrecisionAuto, TRUE)
FormatDateTimeUTCOffsetRounded(ns) ==
  FormatOffsetTimeZoneIdentifier(TIToInt(BigIntDiv(RoundNumberToIncrement(ns, TINsPerMinute, N("halfExpand")), TINsPerMinute)), TRUE)
\* AddEpochNanoseconds.
AddEpochNanoseconds(s, ns, d) ==
  LET r == TIAdd(ns, d) IN IF IsWithinEpochNanosecondsInterval(r) THEN Ok(s, r) ELSE ThrowError(s, "RangeError")
\* InterpretISODateTimeOffset, for an offset behaviour "option", "exact", or "wall" and a match
\* behaviour "match-exactly" or "match-minutes". A time of Empty is the start of the day.
InterpretISODateTimeOffset(s, date, time, offsetBehaviour, offsetNs, tz, offsetOption, matchBehaviour) ==
  IF time = Empty THEN GetStartOfDay(s, tz, date) ELSE
  LET dt == [date |-> date, time |-> time] IN
  IF offsetBehaviour = "wall" \/ (offsetBehaviour = "option" /\ offsetOption = N("ignore")) THEN GetEpochNanosecondsFor(s, tz, dt)
  ELSE IF offsetBehaviour = "exact" \/ (offsetBehaviour = "option" /\ offsetOption = N("use")) THEN
    LET balanced == AddNanosecondsToISODateTime(dt, TINeg(offsetNs))
        ns == GetUTCEpochNanoseconds(balanced)
    IN IF ~IsValidISODaysRange(balanced.date) \/ ~IsWithinEpochNanosecondsInterval(ns) THEN ThrowError(s, "RangeError")
       ELSE Ok(s, ns)
  ELSE IF ~IsValidISODaysRange(date) THEN ThrowError(s, "RangeError")
  ELSE LET candidate == GetEpochNanosecondsFor(s, tz, dt) IN IF IsAbrupt(candidate) THEN candidate ELSE
       LET candidateOffset == TISub(GetUTCEpochNanoseconds(dt), Val(candidate)) IN
       IF candidateOffset = offsetNs \/
          (matchBehaviour = "match-minutes" /\ RoundNumberToIncrement(candidateOffset, TINsPerMinute, N("halfExpand")) = offsetNs) \/
          offsetOption # N("reject")
       THEN candidate ELSE ThrowError(candidate.s, "RangeError")
\* Calendar fields records: the fields below, with Empty for an absent one. Numbers are BigInts,
\* monthCode and offset are units, and timeZone is a time zone.
ConvertCalendarField(s, name, v) ==
  CASE name \in {"month", "day"} ->
         LET n == SnapToInteger(s, v, TRUE) IN
         IF IsAbrupt(n) THEN n ELSE IF BigIntLess(Val(n), TI(1)) THEN ThrowError(n.s, "RangeError") ELSE n
    [] name = "monthCode" ->
         LET p == ParseMonthCode(s, v) IN IF IsAbrupt(p) THEN p ELSE Ok(p.s, CreateMonthCode(Val(p).month, Val(p).leap))
    [] name = "timeZone" -> ToTemporalTimeZoneIdentifier(s, v)
    [] name = "offset" ->
         LET p == ToPrimitive(s, v, "string") IN IF IsAbrupt(p) THEN p
         ELSE IF ~IsString(Val(p)) THEN ThrowTypeError(p.s)
         ELSE LET o == ParseDateTimeUTCOffset(p.s, Val(p).value) IN IF IsAbrupt(o) THEN o ELSE Ok(o.s, Val(p).value)
    [] OTHER -> SnapToInteger(s, v, TRUE)
PrepareFrom(s, item, order, acc, isAny, required) ==
  IF order = <<>> THEN IF required = "partial" /\ ~isAny THEN ThrowTypeError(s) ELSE Ok(s, acc)
  ELSE LET name == CalendarFieldNames[Head(order)]
           v == Get(s, item, CalendarFieldKeys[Head(order)])
       IN IF IsAbrupt(v) THEN v
          ELSE IF Val(v) = Undefined THEN
            IF required = "time-zone" /\ name = "timeZone" THEN ThrowTypeError(v.s)
            ELSE PrepareFrom(v.s, item, Tail(order), acc, isAny, required)
          ELSE LET c == ConvertCalendarField(v.s, name, Val(v)) IN IF IsAbrupt(c) THEN c
          ELSE PrepareFrom(c.s, item, Tail(order), [acc EXCEPT ![name] = Val(c)], TRUE, required)
\* PrepareCalendarFields, for the set of field names to read and required "partial",
\* "time-zone", or "no-required-fields". The fields are read in code unit order.
PrepareCalendarFields(s, item, names, required) ==
  PrepareFrom(s, item, SelectSeq([i \in 1..12 |-> i], LAMBDA i : CalendarFieldNames[i] \in names),
              [n \in Range(CalendarFieldNames) |->
                 IF required # "partial" /\ n \in CalendarTimeFieldNames THEN TI(0) ELSE Empty],
              FALSE, required)
\* CalendarMergeFields for the ISO calendar.
CalendarMergeFields(fields, additional) ==
  [n \in DOMAIN fields |->
     IF additional[n] # Empty THEN additional[n]
     ELSE IF n \in {"month", "monthCode"} /\ (additional.month # Empty \/ additional.monthCode # Empty) THEN Empty
     ELSE fields[n]]
\* ISODateToFields, for type "date", "year-month", or "month-day".
ISODateToFields(date, type) ==
  [EmptyCalendarFields EXCEPT !.monthCode = CreateMonthCode(date.month, FALSE),
                              !.day = IF type \in {"date", "month-day"} THEN TI(date.day) ELSE Empty,
                              !.year = IF type \in {"date", "year-month"} THEN TI(date.year) ELSE Empty]
\* CalendarResolveFields for the ISO calendar: the fields with month set from monthCode.
CalendarResolveFields(s, fields, type) ==
  IF type \in {"date", "year-month"} /\ fields.year = Empty THEN ThrowTypeError(s)
  ELSE IF type \in {"date", "month-day"} /\ fields.day = Empty THEN ThrowTypeError(s)
  ELSE IF fields.month = Empty /\ fields.monthCode = Empty THEN ThrowTypeError(s)
  ELSE IF fields.monthCode = Empty THEN Ok(s, fields)
  ELSE LET number == TPInt(fields.monthCode, 2, 3) IN
       IF Len(fields.monthCode) = 4 \/ number > 12 \/ (fields.month # Empty /\ fields.month # TI(number))
       THEN ThrowError(s, "RangeError") ELSE Ok(s, [fields EXCEPT !.month = TI(number)])
\* CalendarDateFromFields, CalendarYearMonthFromFields, and CalendarMonthDayFromFields.
CalendarDateFromFields(s, fields, overflow) ==
  LET r == CalendarResolveFields(s, fields, "date") IN IF IsAbrupt(r) THEN r
  ELSE IF ~TIYearInRange(Val(r).year) THEN ThrowError(s, "RangeError")
  ELSE LET date == RegulateISODate(s, TIToInt(Val(r).year), Val(r).month, Val(r).day, overflow) IN
       IF IsAbrupt(date) THEN date ELSE IF ISODateWithinLimits(Val(date)) THEN date ELSE ThrowError(s, "RangeError")
CalendarYearMonthFromFields(s, fields, overflow) ==
  LET r == CalendarResolveFields(s, fields, "year-month") IN IF IsAbrupt(r) THEN r
  ELSE IF ~TIYearInRange(Val(r).year) THEN ThrowError(s, "RangeError")
  ELSE LET date == RegulateISODate(s, TIToInt(Val(r).year), Val(r).month, TI(1), overflow) IN
       IF IsAbrupt(date) THEN date ELSE IF ISOYearMonthWithinLimits(Val(date)) THEN date ELSE ThrowError(s, "RangeError")
\* The reference year 1972; a given year counts only for whether it is a leap year, which repeats
\* every 400 years.
CalendarMonthDayFromFields(s, fields, overflow) ==
  LET r == CalendarResolveFields(s, fields, "month-day") IN IF IsAbrupt(r) THEN r ELSE
  LET year == IF Val(r).year = Empty THEN 1972 ELSE TIToInt(TIMod(Val(r).year, TI(400)))
      date == RegulateISODate(s, year, Val(r).month, Val(r).day, overflow)
  IN IF IsAbrupt(date) THEN date ELSE Ok(s, [year |-> 1972, month |-> Val(date).month, day |-> Val(date).day])
\* InterpretTemporalDateTimeFields, as an ISO date-time.
InterpretTemporalDateTimeFields(s, fields, overflow) ==
  LET date == CalendarDateFromFields(s, fields, overflow) IN IF IsAbrupt(date) THEN date ELSE
  LET time == RegulateTime(date.s, <<fields.hour, fields.minute, fields.second, fields.millisecond, fields.microsecond,
                                     fields.nanosecond>>, overflow)
  IN IF IsAbrupt(time) THEN time ELSE Ok(time.s, [date |-> Val(date), time |-> Val(time)])
\* The ISO date-time of a ZonedDateTime, and its slots as a relativeTo record [epochNs, timeZone,
\* calendar].
ZonedDateTimeISODateTime(s, v) == GetISODateTimeFor(O(s, v).slots.timeZone, O(s, v).slots.epochNs)
\* Date durations: DateDurationDays and CreateDateDurationRecord's check.
DateDurationDays(s, date, plain) ==
  LET ymw == <<date[1], date[2], date[3], TI(0)>> IN
  IF DurationSign(ymw) = 0 THEN Ok(s, date[4])
  ELSE LET to == CalendarDateAdd(s, plain.date, ymw, N("constrain")) IN IF IsAbrupt(to) THEN to
  ELSE Ok(to.s, TIAdd(date[4], TI(EpochDays(Val(to)) - EpochDays(plain.date))))
InternalDurationSign(d) == LET ds == DurationSign(d.date) IN IF ds # 0 THEN ds ELSE TISign(d.time)
CheckedDateDuration(s, date) == IF IsValidDateDuration(date) THEN Ok(s, date) ELSE ThrowError(s, "RangeError")
\* ComputeNudgeWindow, as [inner, outer, startNs, endNs, startDuration, endDuration].
ComputeNudgeWindow(s, sign, duration, origin, dt, tz, increment, unit, additionalShift) ==
  LET d == duration.date
      step == TI(increment * sign)
      weeksStart == IF unit = TUWeek THEN CalendarDateAdd(s, dt.date, <<d[1], d[2], TI(0), TI(0)>>, N("constrain")) ELSE Ok(s, Empty)
  IN IF IsAbrupt(weeksStart) THEN weeksStart ELSE
  LET inner == CASE unit = TUYear ->
                      LET years == RoundNumberToIncrement(d[1], TI(increment), N("trunc")) IN
                      IF additionalShift THEN TIAdd(years, step) ELSE years
                 [] unit = TUMonth ->
                      LET months == RoundNumberToIncrement(d[2], TI(increment), N("trunc")) IN
                      IF additionalShift THEN TIAdd(months, step) ELSE months
                 [] unit = TUWeek ->
                      RoundNumberToIncrement(TIAdd(d[3], CalendarDateUntil(Val(weeksStart),
                                                                           AddDaysToISODate(Val(weeksStart), TIToInt(d[4])), TUWeek)[3]),
                                             TI(increment), N("trunc"))
                 [] OTHER -> RoundNumberToIncrement(d[4], TI(increment), N("trunc"))
      outer == TIAdd(inner, step)
      bounded(b) == CASE unit = TUYear -> <<b, TI(0), TI(0), TI(0)>>
                      [] unit = TUMonth -> <<d[1], b, TI(0), TI(0)>>
                      [] unit = TUWeek -> <<d[1], d[2], b, TI(0)>>
                      [] OTHER -> <<d[1], d[2], d[3], b>>
      start == CheckedDateDuration(weeksStart.s, bounded(inner))
  IN IF IsAbrupt(start) THEN start ELSE
  LET end == CheckedDateDuration(start.s, bounded(outer)) IN IF IsAbrupt(end) THEN end ELSE
  LET startDate == IF DurationSign(Val(start)) = 0 THEN Ok(end.s, Empty) ELSE CalendarDateAdd(end.s, dt.date, Val(start), N("constrain")) IN
  IF IsAbrupt(startDate) THEN startDate ELSE
  LET startNs == IF Val(startDate) = Empty THEN Ok(startDate.s, origin)
                 ELSE EpochNsOf(startDate.s, [date |-> Val(startDate), time |-> dt.time], tz) IN
  IF IsAbrupt(startNs) THEN startNs ELSE
  LET endDate == CalendarDateAdd(startNs.s, dt.date, Val(end), N("constrain")) IN IF IsAbrupt(endDate) THEN endDate ELSE
  LET endNs == EpochNsOf(endDate.s, [date |-> Val(endDate), time |-> dt.time], tz) IN IF IsAbrupt(endNs) THEN endNs
  ELSE Ok(endNs.s, [inner |-> inner, outer |-> outer, startNs |-> Val(startNs), endNs |-> Val(endNs),
                    startDuration |-> [date |-> Val(start), time |-> TI(0)],
                    endDuration |-> [date |-> Val(end), time |-> TI(0)]])
\* NudgeToCalendarUnit, as [nudge, total]: a nudge result [duration, nudged, expanded], and the
\* total as a rational [num, den] with den > 0. The progress through the window is
\* (dest − start) / (end − start), so total is (inner × (end − start) + (dest − start) × increment
\* × sign) / (end − start).
NudgeToCalendarUnit(s, sign, duration, origin, dest, dt, tz, increment, unit, mode) ==
  LET first == ComputeNudgeWindow(s, sign, duration, origin, dt, tz, increment, unit, FALSE) IN
  IF IsAbrupt(first) THEN first ELSE
  LET contains(w) == IF sign = 1 THEN ~BigIntLess(dest, w.startNs) /\ ~BigIntLess(w.endNs, dest)
                     ELSE ~BigIntLess(dest, w.endNs) /\ ~BigIntLess(w.startNs, dest)
      window == IF contains(Val(first)) THEN first
                ELSE ComputeNudgeWindow(first.s, sign, duration, origin, dt, tz, increment, unit, TRUE)
  IN IF IsAbrupt(window) THEN window ELSE
  LET w == Val(window)
      numer == TISub(dest, w.startNs)
      denom == TISub(w.endNs, w.startNs)
      totalNum == TIAdd(TIMul(w.inner, denom), TIMul(numer, TI(increment * sign)))
      progressNum == TIAbs(numer)
      progressDen == TIAbs(denom)
      unsigned == UnsignedRoundingMode(mode, sign < 0)
      half == TICompare(TIMul(progressNum, TI(2)), progressDen)
      isOuter == CASE progressNum = progressDen -> TRUE
                   [] progressNum.mag = <<>> -> FALSE
                   [] unsigned = "zero" -> FALSE
                   [] unsigned = "infinity" -> TRUE
                   [] half < 0 -> FALSE
                   [] half > 0 -> TRUE
                   [] unsigned = "half-zero" -> FALSE
                   [] unsigned = "half-infinity" -> TRUE
                   [] OTHER -> BNIsOdd(BigIntDiv(TIAbs(w.inner), TI(increment)).mag)
  IN Ok(window.s, [nudge |-> [duration |-> IF isOuter THEN w.endDuration ELSE w.startDuration,
                              nudged |-> IF isOuter THEN w.endNs ELSE w.startNs,
                              expanded |-> ~contains(Val(first)) \/ isOuter],
                   total |-> [num |-> IF denom.neg THEN TINeg(totalNum) ELSE totalNum, den |-> progressDen]])
\* NudgeToZonedTime.
NudgeToZonedTime(s, sign, duration, dt, tz, increment, unit, mode) ==
  LET start == CalendarDateAdd(s, dt.date, duration.date, N("constrain")) IN IF IsAbrupt(start) THEN start ELSE
  LET startNs == GetEpochNanosecondsFor(start.s, tz, [date |-> Val(start), time |-> dt.time]) IN IF IsAbrupt(startNs) THEN startNs ELSE
  LET endNs == GetEpochNanosecondsFor(startNs.s, tz, [date |-> AddDaysToISODate(Val(start), sign), time |-> dt.time]) IN
  IF IsAbrupt(endNs) THEN endNs ELSE
  LET length == TIMul(TemporalUnitLength(unit), TI(increment))
      rounded == RoundTimeDurationToIncrement(endNs.s, duration.time, length, mode)
  IN IF IsAbrupt(rounded) THEN rounded ELSE
  LET beyond == TISub(Val(rounded), TISub(Val(endNs), Val(startNs))) IN
  IF TISign(beyond) # -sign THEN
    LET again == RoundTimeDurationToIncrement(rounded.s, beyond, length, mode) IN IF IsAbrupt(again) THEN again
    ELSE Ok(again.s, [duration |-> [date |-> <<duration.date[1], duration.date[2], duration.date[3], TIAdd(duration.date[4], TI(sign))>>,
                                    time |-> Val(again)],
                      nudged |-> TIAdd(Val(again), Val(endNs)), expanded |-> TRUE])
  ELSE Ok(rounded.s, [duration |-> [date |-> duration.date, time |-> Val(rounded)],
                      nudged |-> TIAdd(Val(rounded), Val(startNs)), expanded |-> FALSE])
\* NudgeToDayOrTime.
NudgeToDayOrTime(s, duration, dest, largestUnit, increment, smallestUnit, mode) ==
  LET time == TIAdd(duration.time, TIMul(duration.date[4], TINsPerDay))
      rounded == RoundTimeDurationToIncrement(s, time, TIMul(TemporalUnitLength(smallestUnit), TI(increment)), mode)
  IN IF IsAbrupt(rounded) THEN rounded ELSE
  LET wholeDays == BigIntDiv(time, TINsPerDay)
      roundedWholeDays == BigIntDiv(Val(rounded), TINsPerDay)
      isDate == IsDateUnit(largestUnit)
  IN Ok(rounded.s, [duration |-> [date |-> <<duration.date[1], duration.date[2], duration.date[3],
                                             IF isDate THEN roundedWholeDays ELSE TI(0)>>,
                                  time |-> IF isDate THEN TISub(Val(rounded), TIMul(roundedWholeDays, TINsPerDay)) ELSE Val(rounded)],
                    nudged |-> TIAdd(dest, TISub(Val(rounded), time)),
                    expanded |-> TISign(TISub(roundedWholeDays, wholeDays)) = TISign(time)])
\* BubbleRelativeDuration.
BubbleUnits(largestUnit, startUnit) ==
  (IF startUnit = TUDay /\ largestUnit \in {TUYear, TUMonth} THEN <<TUMonth>> ELSE <<>>) \o
  (IF startUnit = TUDay /\ largestUnit = TUWeek THEN <<TUWeek>> ELSE <<>>) \o
  (IF largestUnit = TUYear THEN <<TUYear>> ELSE <<>>)
BubbleFrom(s, sign, duration, nudged, dt, tz, units) ==
  IF units = <<>> THEN Ok(s, duration) ELSE
  LET d == duration.date
      end == CASE Head(units) = TUYear -> <<TIAdd(d[1], TI(sign)), TI(0), TI(0), TI(0)>>
               [] Head(units) = TUMonth -> <<d[1], TIAdd(d[2], TI(sign)), TI(0), TI(0)>>
               [] OTHER -> <<d[1], d[2], TIAdd(d[3], TI(sign)), TI(0)>>
  IN IF ~IsValidDateDuration(end) THEN ThrowError(s, "RangeError") ELSE
  LET date == CalendarDateAdd(s, dt.date, end, N("constrain")) IN IF IsAbrupt(date) THEN date ELSE
  LET endNs == EpochNsOf(date.s, [date |-> Val(date), time |-> dt.time], tz) IN IF IsAbrupt(endNs) THEN endNs
  ELSE IF TISign(TISub(nudged, Val(endNs))) = -sign THEN Ok(endNs.s, duration)
  ELSE BubbleFrom(endNs.s, sign, [date |-> end, time |-> TI(0)], nudged, dt, tz, Tail(units))
BubbleRelativeDuration(s, sign, duration, nudged, dt, tz, largestUnit, startUnit) ==
  IF LargerOfTwoTemporalUnits(startUnit, largestUnit) = startUnit THEN Ok(s, duration)
  ELSE BubbleFrom(s, sign, duration, nudged, dt, tz, BubbleUnits(largestUnit, startUnit))
\* RoundRelativeDuration and TotalRelativeDuration, for a time zone or Empty.
RoundRelativeDuration(s, duration, origin, dest, dt, tz, largestUnit, increment, smallestUnit, mode) ==
  LET sign == IF InternalDurationSign(duration) < 0 THEN -1 ELSE 1
      nudge == CASE IsCalendarUnit(smallestUnit) \/ (tz # Empty /\ smallestUnit = TUDay) ->
                      LET r == NudgeToCalendarUnit(s, sign, duration, origin, dest, dt, tz, increment, smallestUnit, mode) IN
                      IF IsAbrupt(r) THEN r ELSE Ok(r.s, Val(r).nudge)
                 [] tz # Empty -> NudgeToZonedTime(s, sign, duration, dt, tz, increment, smallestUnit, mode)
                 [] OTHER -> NudgeToDayOrTime(s, duration, dest, largestUnit, increment, smallestUnit, mode)
  IN IF IsAbrupt(nudge) THEN nudge
     ELSE IF Val(nudge).expanded /\ smallestUnit \notin {TUYear, TUWeek} THEN
       BubbleRelativeDuration(nudge.s, sign, Val(nudge).duration, Val(nudge).nudged, dt, tz, largestUnit,
                              LargerOfTwoTemporalUnits(smallestUnit, TUDay))
     ELSE Ok(nudge.s, Val(nudge).duration)
TotalRelativeDuration(s, duration, origin, dest, dt, tz, unit) ==
  IF IsCalendarUnit(unit) \/ (tz # Empty /\ unit = TUDay) THEN
    LET r == NudgeToCalendarUnit(s, IF InternalDurationSign(duration) < 0 THEN -1 ELSE 1, duration, origin, dest, dt, tz,
                                 1, unit, N("trunc"))
    IN IF IsAbrupt(r) THEN r ELSE Ok(r.s, RatioToNumber(Val(r).total.num, Val(r).total.den))
  ELSE Ok(s, RatioToNumber(TIAdd(duration.time, TIMul(duration.date[4], TINsPerDay)), TemporalUnitLength(unit)))
\* DifferenceISODateTime, DifferencePlainDateTimeWithRounding, and DifferencePlainDateTimeWithTotal.
DifferenceISODateTime(x, y, largestUnit) ==
  LET time0 == DifferenceTime(x.time, y.time)
      timeSign == TISign(time0)
      adjust == timeSign = CompareISODate(x.date, y.date)
      time == IF adjust THEN TISub(time0, TIMul(TI(timeSign), TINsPerDay)) ELSE time0
      dateLargestUnit == LargerOfTwoTemporalUnits(TUDay, largestUnit)
      diff == CalendarDateUntil(x.date, IF adjust THEN AddDaysToISODate(y.date, timeSign) ELSE y.date, dateLargestUnit)
  IN IF largestUnit # dateLargestUnit
     THEN [date |-> <<diff[1], diff[2], diff[3], TI(0)>>, time |-> TIAdd(time, TIMul(diff[4], TINsPerDay))]
     ELSE [date |-> diff, time |-> time]
DifferencePlainDateTimeWithRounding(s, from, to, largestUnit, increment, smallestUnit, mode) ==
  IF CompareISODateTime(from, to) = 0 THEN Ok(s, CombineDateAndTimeDuration(ZeroDateDuration, TI(0)))
  ELSE IF ~ISODateTimeWithinLimits(from) \/ ~ISODateTimeWithinLimits(to) THEN ThrowError(s, "RangeError")
  ELSE LET diff == DifferenceISODateTime(from, to, largestUnit) IN
       IF smallestUnit = TUNanosecond /\ increment = 1 THEN Ok(s, diff)
       ELSE RoundRelativeDuration(s, diff, GetUTCEpochNanoseconds(from), GetUTCEpochNanoseconds(to), from, Empty,
                                  largestUnit, increment, smallestUnit, mode)
DifferencePlainDateTimeWithTotal(s, from, to, unit) ==
  IF CompareISODateTime(from, to) = 0 THEN Ok(s, PosZero)
  ELSE IF ~ISODateTimeWithinLimits(from) \/ ~ISODateTimeWithinLimits(to) THEN ThrowError(s, "RangeError")
  ELSE LET diff == DifferenceISODateTime(from, to, unit) IN
       IF unit = TUNanosecond THEN Ok(s, RatioToNumber(diff.time, TI(1)))
       ELSE TotalRelativeDuration(s, diff, GetUTCEpochNanoseconds(from), GetUTCEpochNanoseconds(to), from, Empty, unit)
\* DifferenceZonedDateTime, with its loop over day corrections.
DayCorrectionFrom(s, tz, start, end, to, sign, correction, maxCorrection) ==
  LET intermediate == [date |-> AddDaysToISODate(end.date, correction * sign), time |-> start.time]
      ns == GetEpochNanosecondsFor(s, tz, intermediate)
  IN IF IsAbrupt(ns) THEN ns
     ELSE IF TISign(TISub(to, Val(ns))) # sign \/ correction >= maxCorrection
     THEN Ok(ns.s, [date |-> intermediate.date, time |-> TISub(to, Val(ns))])
     ELSE DayCorrectionFrom(ns.s, tz, start, end, to, sign, correction + 1, maxCorrection)
DifferenceZonedDateTime(s, from, to, tz, largestUnit) ==
  IF from = to THEN Ok(s, CombineDateAndTimeDuration(ZeroDateDuration, TI(0))) ELSE
  LET start == GetISODateTimeFor(tz, from)
      end == GetISODateTimeFor(tz, to)
      sign == IF BigIntLess(to, from) THEN 1 ELSE -1
  IN IF CompareISODate(start.date, end.date) = 0 THEN Ok(s, CombineDateAndTimeDuration(ZeroDateDuration, TISub(to, from)))
     ELSE LET found == DayCorrectionFrom(s, tz, start, end, to, sign,
                                         IF TISign(DifferenceTime(start.time, end.time)) = sign THEN 1 ELSE 0,
                                         IF sign = -1 THEN 2 ELSE 1)
          IN IF IsAbrupt(found) THEN found
             ELSE Ok(found.s, CombineDateAndTimeDuration(
                                CalendarDateUntil(start.date, Val(found).date, LargerOfTwoTemporalUnits(largestUnit, TUDay)),
                                Val(found).time))
DifferenceEpochNanoseconds(s, from, to, increment, smallestUnit, mode) ==
  LET r == RoundTimeDuration(s, TISub(to, from), increment, smallestUnit, mode) IN
  IF IsAbrupt(r) THEN r ELSE Ok(r.s, CombineDateAndTimeDuration(ZeroDateDuration, Val(r)))
DifferenceZonedDateTimeWithRounding(s, from, to, tz, largestUnit, increment, smallestUnit, mode) ==
  IF IsTimeUnit(largestUnit) THEN DifferenceEpochNanoseconds(s, from, to, increment, smallestUnit, mode) ELSE
  LET diff == DifferenceZonedDateTime(s, from, to, tz, largestUnit) IN IF IsAbrupt(diff) THEN diff
  ELSE IF smallestUnit = TUNanosecond /\ increment = 1 THEN diff
  ELSE RoundRelativeDuration(diff.s, Val(diff), from, to, GetISODateTimeFor(tz, from), tz, largestUnit, increment, smallestUnit, mode)
DifferenceZonedDateTimeWithTotal(s, from, to, tz, unit) ==
  IF IsTimeUnit(unit) THEN Ok(s, RatioToNumber(TISub(to, from), TemporalUnitLength(unit))) ELSE
  LET diff == DifferenceZonedDateTime(s, from, to, tz, unit) IN IF IsAbrupt(diff) THEN diff
  ELSE TotalRelativeDuration(diff.s, Val(diff), from, to, GetISODateTimeFor(tz, from), tz, unit)
\* AddZonedDateTime.
AddZonedDateTime(s, ns, tz, duration, overflow) ==
  IF DurationSign(duration.date) = 0 THEN AddEpochNanoseconds(s, ns, duration.time) ELSE
  LET dt == GetISODateTimeFor(tz, ns)
      added == CalendarDateAdd(s, dt.date, duration.date, overflow)
  IN IF IsAbrupt(added) THEN added
     ELSE IF ~ISODateTimeWithinLimits([date |-> Val(added), time |-> dt.time]) THEN ThrowError(added.s, "RangeError")
     ELSE LET intermediate == GetEpochNanosecondsFor(added.s, tz, [date |-> Val(added), time |-> dt.time]) IN
          IF IsAbrupt(intermediate) THEN intermediate ELSE AddEpochNanoseconds(intermediate.s, Val(intermediate), duration.time)
\* The start and end of Temporal.Duration.prototype.round and total relative to a PlainDate
\* (steps 22 and 13), as [from, to] date-times.
RelativePlainTarget(s, d, plain) ==
  LET internal == ToInternalDurationRecordWith24HourDays(d)
      target == AddTime(MidnightTimeRecord, internal.time)
      date == CheckedDateDuration(s, <<internal.date[1], internal.date[2], internal.date[3], target.days>>)
  IN IF IsAbrupt(date) THEN date ELSE
  LET targetDate == CalendarDateAdd(s, plain.date, Val(date), N("constrain")) IN IF IsAbrupt(targetDate) THEN targetDate
  ELSE Ok(targetDate.s, [from |-> [date |-> plain.date, time |-> MidnightTimeRecord],
                         to |-> [date |-> Val(targetDate), time |-> target.time]])
\* GetTemporalRelativeToOption, as a relativeTo record [plain, zoned]: a [date, calendar] record
\* or a ZonedDateTime's slots.
RelativeToFrom(s, date, time, calendar, tz, offsetBehaviour, offsetString, matchBehaviour) ==
  IF tz = Empty THEN
    IF ISODateWithinLimits(date) THEN Ok(s, [plain |-> [date |-> date, calendar |-> calendar], zoned |-> Empty])
    ELSE ThrowError(s, "RangeError")
  ELSE LET offsetNs == IF offsetBehaviour = "option" THEN Val(ParseDateTimeUTCOffset(s, offsetString)) ELSE TI(0)
           ns == InterpretISODateTimeOffset(s, date, time, offsetBehaviour, offsetNs, tz, N("reject"), matchBehaviour)
       IN IF IsAbrupt(ns) THEN ns
          ELSE Ok(ns.s, [plain |-> Empty, zoned |-> [epochNs |-> Val(ns), timeZone |-> tz, calendar |-> calendar]])
GetTemporalRelativeToOption(s, options) ==
  LET value == Get(s, options, SV("relativeTo")) IN IF IsAbrupt(value) THEN value
  ELSE IF Val(value) = Undefined THEN Ok(value.s, NoRelativeTo) ELSE
  LET v == Val(value)
      s1 == value.s
  IN IF IsObject(v) THEN
       LET o == O(s1, v) IN
       CASE o.class = "temporalZonedDateTime" -> Ok(s1, [plain |-> Empty, zoned |-> o.slots])
         [] o.class = "temporalDate" -> Ok(s1, [plain |-> o.slots, zoned |-> Empty])
         [] o.class = "temporalDateTime" ->
              Ok(s1, [plain |-> [date |-> o.slots.dateTime.date, calendar |-> o.slots.calendar], zoned |-> Empty])
         [] OTHER ->
              LET calendar == GetTemporalCalendarIdentifierWithISODefault(s1, v) IN IF IsAbrupt(calendar) THEN calendar ELSE
              LET fields == PrepareCalendarFields(calendar.s, v, DateFieldNames \cup CalendarTimeFieldNames \cup {"offset", "timeZone"},
                                                  "no-required-fields") IN
              IF IsAbrupt(fields) THEN fields ELSE
              LET result == InterpretTemporalDateTimeFields(fields.s, Val(fields), N("constrain")) IN IF IsAbrupt(result) THEN result
              ELSE RelativeToFrom(result.s, Val(result).date, Val(result).time, Val(calendar), Val(fields).timeZone,
                                  IF Val(fields).offset = Empty THEN "wall" ELSE "option", Val(fields).offset, "match-exactly")
     ELSE IF ~IsString(v) THEN ThrowTypeError(s1)
     ELSE LET parsed == ParseISODateTime(s1, v.value, "any-date-time") IN IF IsAbrupt(parsed) THEN parsed ELSE
          LET r == Val(parsed)
              tz == IF r.tzAnnotation = Empty THEN Ok(parsed.s, Empty) ELSE ToTemporalTimeZoneIdentifier(parsed.s, Str(r.tzAnnotation))
          IN IF IsAbrupt(tz) THEN tz ELSE
          LET calendar == CanonicalizeCalendar(tz.s, IF r.calendar = Empty THEN ISO8601 ELSE r.calendar) IN
          IF IsAbrupt(calendar) THEN calendar
          ELSE RelativeToFrom(calendar.s, [year |-> r.year, month |-> r.month, day |-> r.day], r.time, Val(calendar), Val(tz),
                              CASE r.z -> "exact" [] r.offset = Empty -> "wall" [] OTHER -> "option", r.offset,
                              IF r.offset # Empty /\ Len(r.offset) > 6 THEN "match-exactly" ELSE "match-minutes")
\* Temporal's ISO 8601 and RFC 9557 string grammar (Temporal §13.33), parsed as engine262's
\* DateParser does: by backtracking over code units. A parser takes the units u and the index p of
\* the next unit and gives TPFail or TPOk(the index after the match, the parse node).
TPOk(p, v) == [ok |-> TRUE, p |-> p, v |-> v]
\* r matches all of u.
TPFull(u, r) == r.ok /\ r.p = Len(u) + 1
TPAt(u, p) == IF p >= 1 /\ p <= Len(u) THEN u[p] ELSE -1
TPDigit(u, p) == IsDigit(TPAt(u, p))
\* The value of the decimal digits u[a..b].
TPInt(u, a, b) == IF a > b THEN 0 ELSE TPInt(u, a, b - 1) * 10 + u[b] - 48
\* The index after the run of at most max digits starting at p.
TPDigitsEnd(u, p, max) == IF max > 0 /\ TPDigit(u, p) THEN TPDigitsEnd(u, p + 1, max - 1) ELSE p
TPLower(u) == [i \in DOMAIN u |-> IF u[i] >= 65 /\ u[i] <= 90 THEN u[i] + 32 ELSE u[i]]
TPAlpha(c) == (c >= 65 /\ c <= 90) \/ (c >= 97 /\ c <= 122)
\* Two digits from the first set of tens followed by any digit in the matching range, as the
\* regular expressions of DateMonth, DateDay, Hour, Minute, and Second do.
TPTwoDigits(u, p, ranges) ==
  IF \E r \in ranges : TPAt(u, p) = r[1] /\ TPAt(u, p + 1) >= r[2] /\ TPAt(u, p + 1) <= r[3]
  THEN TPOk(p + 2, TPInt(u, p, p + 1)) ELSE TPFail
\* DateMonth, 01 to 12; DateDay, 01 to 31; Hour, 00 to 23; and Minute and Second, 00 to 59.
TPDateMonth(u, p) == TPTwoDigits(u, p, {<<48, 49, 57>>, <<49, 48, 50>>})
TPDateDay(u, p) == TPTwoDigits(u, p, {<<48, 49, 57>>, <<49, 48, 57>>, <<50, 48, 57>>, <<51, 48, 49>>})
TPHour(u, p) == TPTwoDigits(u, p, {<<48, 48, 57>>, <<49, 48, 57>>, <<50, 48, 51>>})
TPMinute(u, p) == TPTwoDigits(u, p, {<<d, 48, 57>> : d \in 48..53})
\* DateYear: four digits, or a sign and six digits other than -000000.
TPDateYear(u, p) ==
  IF TPDigitsEnd(u, p, 4) = p + 4 THEN TPOk(p + 4, TPInt(u, p, p + 3))
  ELSE IF TPAt(u, p) \in {43, 45} /\ TPDigitsEnd(u, p + 1, 6) = p + 7 THEN
    LET n == TPInt(u, p + 1, p + 6) IN
    IF TPAt(u, p) = 45 /\ n = 0 THEN TPFail ELSE TPOk(p + 7, IF TPAt(u, p) = 45 THEN -n ELSE n)
  ELSE TPFail
\* IsValidMonthDay and IsValidDate (ECMA-262 PR 3759).
TPValidMonthDay(month, day) == ~((day = 31 /\ month \in {2, 4, 6, 9, 11}) \/ (month = 2 /\ day = 30))
TPValidDate(d) == TPValidMonthDay(d.month, d.day) /\ ~(d.month = 2 /\ d.day = 29 /\ ~IsLeapYear(d.year))
\* Date: DateYear, DateMonth, and DateDay, separated by "-" in the extended format.
TPDate(u, p) ==
  LET year == TPDateYear(u, p) IN IF ~year.ok THEN TPFail ELSE
  LET extended == TPAt(u, year.p) = 45
      month == TPDateMonth(u, IF extended THEN year.p + 1 ELSE year.p)
  IN IF ~month.ok \/ (extended /\ TPAt(u, month.p) # 45) THEN TPFail ELSE
  LET day == TPDateDay(u, IF extended THEN month.p + 1 ELSE month.p) IN IF ~day.ok THEN TPFail ELSE
  LET d == [year |-> year.v, month |-> month.v, day |-> day.v] IN
  IF TPValidDate(d) THEN TPOk(day.p, d) ELSE TPFail
\* DateSpecYearMonth and DateSpecMonthDay.
TPDateSpecYearMonth(u, p) ==
  LET year == TPDateYear(u, p) IN IF ~year.ok THEN TPFail ELSE
  LET month == TPDateMonth(u, IF TPAt(u, year.p) = 45 THEN year.p + 1 ELSE year.p) IN
  IF ~month.ok THEN TPFail ELSE TPOk(month.p, [year |-> year.v, month |-> month.v, day |-> Empty])
TPDateSpecMonthDay(u, p) ==
  LET month == TPDateMonth(u, IF TPAt(u, p) = 45 /\ TPAt(u, p + 1) = 45 THEN p + 2 ELSE p) IN
  IF ~month.ok THEN TPFail ELSE
  LET day == TPDateDay(u, IF TPAt(u, month.p) = 45 THEN month.p + 1 ELSE month.p) IN
  IF ~day.ok \/ ~TPValidMonthDay(month.v, day.v) THEN TPFail
  ELSE TPOk(day.p, [year |-> Empty, month |-> month.v, day |-> day.v])
\* TemporalDecimalFraction: "." or "," and one to nine digits, with Empty for none.
TPFraction(u, p) ==
  IF TPAt(u, p) \notin {44, 46} THEN TPOk(p, Empty)
  ELSE LET end == TPDigitsEnd(u, p + 1, 9) IN
       IF end = p + 1 THEN TPFail ELSE TPOk(end, SubSeq(u, p + 1, end - 1))
\* Time: Hour, then Minute, then Second (which may be 60) and a fraction, separated by ":" in the
\* extended format. Absent parts are Empty.
TPTime(u, p) ==
  LET hour == TPHour(u, p) IN IF ~hour.ok THEN TPFail ELSE
  LET node == [hour |-> hour.v, minute |-> Empty, second |-> Empty, fraction |-> Empty] IN
  IF TPAt(u, hour.p) \notin {58, 48, 49, 50, 51, 52, 53} THEN TPOk(hour.p, node) ELSE
  LET extended == TPAt(u, hour.p) = 58
      minute == TPMinute(u, IF extended THEN hour.p + 1 ELSE hour.p)
  IN IF ~minute.ok THEN TPFail
     ELSE IF TPAt(u, minute.p) \notin (IF extended THEN {58} ELSE {}) \cup 48..54
     THEN TPOk(minute.p, [node EXCEPT !.minute = minute.v])
     ELSE IF extended /\ TPAt(u, minute.p) # 58 THEN TPFail ELSE
  LET at == IF extended THEN minute.p + 1 ELSE minute.p
      second == IF TPAt(u, at) = 54 /\ TPAt(u, at + 1) = 48 THEN TPOk(at + 2, 60) ELSE TPMinute(u, at)
  IN IF ~second.ok THEN TPFail ELSE
  LET fraction == TPFraction(u, second.p) IN IF ~fraction.ok THEN TPFail ELSE
  TPOk(fraction.p, [hour |-> hour.v, minute |-> minute.v, second |-> second.v, fraction |-> fraction.v])
\* UTCOffset[SubMinutePrecision]: a sign and an Hour, then Minute, then (with sub-minute
\* precision) Second and a fraction. The node keeps its source text.
TPOffsetNode(u, from, to, hour, minute, second, fraction) ==
  [sign |-> IF u[from] = 45 THEN -1 ELSE 1, hour |-> hour, minute |-> minute, second |-> second,
   fraction |-> fraction, text |-> SubSeq(u, from, to - 1)]
TPUTCOffset(u, p, subMinute) ==
  IF TPAt(u, p) \notin {43, 45} THEN TPFail ELSE
  LET hour == TPHour(u, p + 1) IN IF ~hour.ok THEN TPFail
  ELSE IF TPAt(u, hour.p) \notin {58} \cup 48..54 THEN TPOk(hour.p, TPOffsetNode(u, p, hour.p, hour.v, 0, 0, Empty)) ELSE
  LET extended == TPAt(u, hour.p) = 58
      minute == TPMinute(u, IF extended THEN hour.p + 1 ELSE hour.p)
  IN IF ~minute.ok THEN TPFail
     ELSE IF ~subMinute \/ TPAt(u, minute.p) \notin {58} \cup 48..54
     THEN TPOk(minute.p, TPOffsetNode(u, p, minute.p, hour.v, minute.v, 0, Empty))
     ELSE IF extended /\ TPAt(u, minute.p) # 58 THEN TPFail ELSE
  LET second == TPMinute(u, IF extended THEN minute.p + 1 ELSE minute.p) IN IF ~second.ok THEN TPFail ELSE
  LET fraction == TPFraction(u, second.p) IN IF ~fraction.ok THEN TPFail ELSE
  TPOk(fraction.p, TPOffsetNode(u, p, fraction.p, hour.v, minute.v, second.v, fraction.v))
\* DateTimeUTCOffset[Z]: the UTC designator Z (when allowed) or an offset, as [z, offset].
TPDateTimeOffset(u, p, z) ==
  IF z /\ TPAt(u, p) \in {90, 122} THEN TPOk(p + 1, [z |-> TRUE, offset |-> Empty])
  ELSE LET o == TPUTCOffset(u, p, TRUE) IN
       IF o.ok THEN TPOk(o.p, [z |-> FALSE, offset |-> o.v]) ELSE TPFail
\* DateTime[Z, TimeRequired]: a Date, then a separator, a Time, and an optional offset.
TPDateTime(u, p, z, timeRequired) ==
  LET date == TPDate(u, p) IN IF ~date.ok THEN TPFail
  ELSE IF TPAt(u, date.p) \notin {32, 84, 116} THEN
    IF timeRequired THEN TPFail ELSE TPOk(date.p, [date |-> date.v, time |-> Empty, offset |-> TPNoOffset])
  ELSE LET time == TPTime(u, date.p + 1) IN IF ~time.ok THEN TPFail
  ELSE IF TPAt(u, time.p) \notin {90, 122, 43, 45} THEN TPOk(time.p, [date |-> date.v, time |-> time.v, offset |-> TPNoOffset])
  ELSE LET offset == TPDateTimeOffset(u, time.p, z) IN
       IF offset.ok THEN TPOk(offset.p, [date |-> date.v, time |-> time.v, offset |-> offset.v]) ELSE TPFail
\* TimeZoneIANAName: components of [._a-zA-Z][._a-zA-Z0-9+-]* separated by "/".
TPNameStart(c) == c \in {46, 95} \/ TPAlpha(c)
TPNamePart(c) == TPNameStart(c) \/ IsDigit(c) \/ c \in {43, 45}
TPNameEnd(u, p) == IF TPNamePart(TPAt(u, p)) THEN TPNameEnd(u, p + 1) ELSE p
TPIANAName(u, p) ==
  IF ~TPNameStart(TPAt(u, p)) THEN TPFail
  ELSE LET end == TPNameEnd(u, p + 1) IN
       IF TPAt(u, end) = 47 THEN TPIANAName(u, end + 1) ELSE TPOk(end, Empty)
\* TimeZoneIdentifier: an offset without sub-minute precision, or an IANA name, as [offset, name,
\* text] with Empty for the absent one.
TPTimeZoneIdentifier(u, p) ==
  IF TPAt(u, p) \in {43, 45} THEN
    LET o == TPUTCOffset(u, p, FALSE) IN
    IF o.ok THEN TPOk(o.p, [offset |-> o.v, name |-> Empty, text |-> SubSeq(u, p, o.p - 1)]) ELSE TPFail
  ELSE LET n == TPIANAName(u, p) IN
       IF n.ok THEN TPOk(n.p, [offset |-> Empty, name |-> SubSeq(u, p, n.p - 1), text |-> SubSeq(u, p, n.p - 1)])
       ELSE TPFail
\* TimeZoneAnnotation: "[", an optional critical flag "!", a TimeZoneIdentifier, and "]".
TPTimeZoneAnnotation(u, p) ==
  IF TPAt(u, p) # 91 THEN TPFail ELSE
  LET critical == TPAt(u, p + 1) = 33
      id == TPTimeZoneIdentifier(u, IF critical THEN p + 2 ELSE p + 1)
  IN IF ~id.ok \/ TPAt(u, id.p) # 93 THEN TPFail ELSE TPOk(id.p + 1, [critical |-> critical, id |-> id.v])
\* Annotations: one or more "[" "!"? AnnotationKey "=" AnnotationValue "]", as [critical, key, value].
TPKeyStart(c) == (c >= 97 /\ c <= 122) \/ c = 95
TPKeyEnd(u, p) == IF TPKeyStart(TPAt(u, p)) \/ TPDigit(u, p) \/ TPAt(u, p) = 45 THEN TPKeyEnd(u, p + 1) ELSE p
TPAlnumEnd(u, p) == IF TPAlpha(TPAt(u, p)) \/ TPDigit(u, p) THEN TPAlnumEnd(u, p + 1) ELSE p
TPAnnotationValue(u, p) ==
  LET end == TPAlnumEnd(u, p) IN
  IF end = p THEN TPFail ELSE IF TPAt(u, end) = 45 THEN TPAnnotationValue(u, end + 1) ELSE TPOk(end, Empty)
TPAnnotations(u, p, acc) ==
  IF TPAt(u, p) # 91 THEN IF acc = <<>> THEN TPFail ELSE TPOk(p, acc) ELSE
  LET critical == TPAt(u, p + 1) = 33
      keyAt == IF critical THEN p + 2 ELSE p + 1
      keyEnd == IF TPKeyStart(TPAt(u, keyAt)) THEN TPKeyEnd(u, keyAt + 1) ELSE keyAt
      value == TPAnnotationValue(u, keyEnd + 1)
  IN IF keyEnd = keyAt \/ TPAt(u, keyEnd) # 61 \/ ~value.ok \/ TPAt(u, value.p) # 93 THEN TPFail
     ELSE TPAnnotations(u, value.p + 1, Append(acc, [critical |-> critical, key |-> SubSeq(u, keyAt, keyEnd - 1),
                                                     value |-> SubSeq(u, keyEnd + 1, value.p - 1)]))
\* The optional time zone annotation and annotations after a date or time at p, as a goal node
\* [kind, dateTime, tz, annotations, ambiguous] when they parse.
TPAnnotated(u, p, kind, dateTime, tzRequired) ==
  LET tz == TPTimeZoneAnnotation(u, p) IN
  IF tzRequired /\ ~tz.ok THEN TPFail ELSE
  LET afterTz == IF tz.ok THEN tz.p ELSE p
      annotations == IF TPAt(u, afterTz) = 91 THEN TPAnnotations(u, afterTz, <<>>) ELSE TPOk(afterTz, <<>>)
  IN IF ~annotations.ok THEN TPFail
     ELSE TPOk(annotations.p, [kind |-> kind, dateTime |-> dateTime, tz |-> IF tz.ok THEN tz.v ELSE Empty,
                               annotations |-> annotations.v, ambiguous |-> FALSE])
\* AnnotatedDateTime[Zoned, TimeRequired].
TPAnnotatedDateTime(u, p, zoned, timeRequired) ==
  LET dt == TPDateTime(u, p, zoned, timeRequired) IN
  IF dt.ok THEN TPAnnotated(u, dt.p, "dateTime", dt.v, zoned) ELSE TPFail
\* AnnotatedTime: an optional "T", a Time, and an optional offset without Z. Its early error is
\* the time and offset also parsing as a DateSpecMonthDay or DateSpecYearMonth.
TPAnnotatedTime(u, p) ==
  LET time == TPTime(u, IF TPAt(u, p) \in {84, 116} THEN p + 1 ELSE p) IN IF ~time.ok THEN TPFail ELSE
  LET offset == IF TPAt(u, time.p) \in {43, 45} THEN TPDateTimeOffset(u, time.p, FALSE) ELSE TPOk(time.p, TPNoOffset) IN
  IF ~offset.ok THEN TPFail ELSE
  LET text == SubSeq(u, p, offset.p - 1)
      r == TPAnnotated(u, offset.p, "time", [date |-> Empty, time |-> time.v, offset |-> offset.v], FALSE)
  IN IF ~r.ok THEN TPFail
     ELSE TPOk(r.p, [r.v EXCEPT !.ambiguous = TPFull(text, TPDateSpecMonthDay(text, 1)) \/
                                               TPFull(text, TPDateSpecYearMonth(text, 1))])
\* AnnotatedYearMonth and AnnotatedMonthDay.
TPAnnotatedSpec(u, kind) ==
  LET spec == IF kind = "yearMonth" THEN TPDateSpecYearMonth(u, 1) ELSE TPDateSpecMonthDay(u, 1) IN
  IF spec.ok THEN TPAnnotated(u, spec.p, kind, [date |-> spec.v, time |-> Empty, offset |-> TPNoOffset], FALSE)
  ELSE TPFail
\* TemporalInstantString: a Date, separator, Time, and a required offset or Z.
TPInstantString(u) ==
  LET date == TPDate(u, 1) IN IF ~date.ok \/ TPAt(u, date.p) \notin {32, 84, 116} THEN TPFail ELSE
  LET time == TPTime(u, date.p + 1) IN IF ~time.ok THEN TPFail ELSE
  LET offset == TPDateTimeOffset(u, time.p, TRUE) IN
  IF offset.ok THEN TPAnnotated(u, offset.p, "dateTime", [date |-> date.v, time |-> time.v, offset |-> offset.v], FALSE)
  ELSE TPFail
\* A goal symbol of ParseISODateTime, parsing all of u. A goal whose first alternative parses all
\* of u keeps it, as engine262's try does, even when it has an early error.
TPGoal(u, goal) ==
  CASE goal = "zoned" -> TPAnnotatedDateTime(u, 1, TRUE, FALSE)
    [] goal = "plain" -> TPAnnotatedDateTime(u, 1, FALSE, FALSE)
    [] goal = "instant" -> TPInstantString(u)
    [] goal = "time" ->
         LET t == TPAnnotatedTime(u, 1) IN IF TPFull(u, t) THEN t ELSE TPAnnotatedDateTime(u, 1, FALSE, TRUE)
    [] goal \in {"yearMonth", "monthDay"} ->
         LET t == TPAnnotatedSpec(u, goal) IN IF TPFull(u, t) THEN t ELSE TPAnnotatedDateTime(u, 1, FALSE, FALSE)
\* The goals of each allowed format of ParseISODateTime.
TPGoals(format) ==
  CASE format = "all" -> <<"zoned", "plain", "instant", "time", "monthDay", "yearMonth">>
    [] format = "any-date-time" -> <<"zoned", "plain">>
    [] format = "zoned-date-time" -> <<"zoned">>
    [] format = "plain-date-time" -> <<"plain">>
    [] format = "instant" -> <<"instant">>
    [] format = "time" -> <<"time">>
    [] format = "year-month" -> <<"yearMonth">>
    [] format = "month-day" -> <<"monthDay">>
\* The node of the first goal that parses all of u without an early error, or Empty.
TPFirstGoal(u, goals) ==
  IF goals = <<>> THEN Empty
  ELSE LET r == TPGoal(u, Head(goals)) IN
       IF TPFull(u, r) /\ ~r.v.ambiguous THEN r.v ELSE TPFirstGoal(u, Tail(goals))
\* The calendar of the annotations, as [ok, calendar] with Empty for none, or [ok |-> FALSE] when a
\* critical annotation can't be used (ParseISODateTime step 4).
TPCalendarAnnotation(annotations, i, calendar, critical) ==
  IF i > Len(annotations) THEN [ok |-> TRUE, calendar |-> calendar]
  ELSE LET a == annotations[i] IN
    IF a.key = N("u-ca") THEN
      IF calendar = Empty THEN TPCalendarAnnotation(annotations, i + 1, a.value, a.critical)
      ELSE IF a.critical \/ critical THEN [ok |-> FALSE]
      ELSE TPCalendarAnnotation(annotations, i + 1, calendar, critical)
    ELSE IF a.critical THEN [ok |-> FALSE]
    ELSE TPCalendarAnnotation(annotations, i + 1, calendar, critical)
\* The sub-second parts of a fraction's digits, as [ms, us, ns].
TPSubSecond(fraction) ==
  LET digits == IF fraction = Empty THEN Repeat(48, 9) ELSE SubSeq(fraction \o Repeat(48, 9), 1, 9) IN
  [ms |-> TPInt(digits, 1, 3), us |-> TPInt(digits, 4, 6), ns |-> TPInt(digits, 7, 9)]
\* ParseISODateTime (Temporal §13.33.1): the ISO Date-Time Parse Record [year, month, day, time,
\* z, offset, tzAnnotation, calendar] of units, with Empty for an absent year (a month-day string
\* without one), time (start of day), offset string, time zone annotation, or calendar. A string
\* that doesn't parse throws a RangeError.
ParseISODateTime(s, units, format) ==
  LET node == TPFirstGoal(units, TPGoals(format)) IN
  IF node = Empty THEN ThrowError(s, "RangeError") ELSE
  LET calendar == TPCalendarAnnotation(node.annotations, 1, Empty, FALSE) IN
  IF ~calendar.ok THEN ThrowError(s, "RangeError")
  ELSE IF node.kind \in {"yearMonth", "monthDay"} /\ calendar.calendar # Empty /\
          TPLower(calendar.calendar) # N("iso8601") THEN ThrowError(s, "RangeError")
  ELSE LET date == node.dateTime.date
           time == node.dateTime.time
           sub == TPSubSecond(IF time = Empty THEN Empty ELSE time.fraction)
           offset == node.dateTime.offset
       IN Ok(s, [year |-> IF date = Empty THEN 0 ELSE date.year,
                 month |-> IF date = Empty THEN 1 ELSE date.month,
                 day |-> IF date = Empty \/ date.day = Empty THEN 1 ELSE date.day,
                 time |-> IF time = Empty THEN Empty
                          ELSE [hour |-> time.hour, minute |-> IF time.minute = Empty THEN 0 ELSE time.minute,
                                second |-> CASE time.second = Empty -> 0 [] time.second = 60 -> 59 [] OTHER -> time.second,
                                millisecond |-> sub.ms, microsecond |-> sub.us, nanosecond |-> sub.ns],
                 z |-> offset.z,
                 offset |-> IF offset.offset = Empty THEN Empty ELSE offset.offset.text,
                 tzAnnotation |-> IF node.tz = Empty THEN Empty ELSE node.tz.id.text,
                 calendar |-> calendar.calendar])
\* ParseDateTimeUTCOffset (§21.4.1.33.2): the offset in nanoseconds of an offset string, as a BigInt,
\* or a RangeError.
ParseDateTimeUTCOffset(s, units) ==
  LET o == TPUTCOffset(units, 1, TRUE) IN
  IF ~TPFull(units, o) THEN ThrowError(s, "RangeError")
  ELSE Ok(s, TIMul(TI(o.v.sign), TIAdd(TIMul(TI((o.v.hour * 60 + o.v.minute) * 60 + o.v.second), TINsPerSecond),
                                       TI(LET sub == TPSubSecond(o.v.fraction) IN sub.ms * 1000000 + sub.us * 1000 + sub.ns))))
\* ParseTimeZoneIdentifier (Temporal §13.33.4): [name, offsetMinutes] with Empty for the absent one.
ParseTimeZoneIdentifier(s, units) ==
  LET r == TPTimeZoneIdentifier(units, 1) IN
  IF ~TPFull(units, r) THEN ThrowError(s, "RangeError")
  ELSE IF r.v.name # Empty THEN Ok(s, [name |-> r.v.name, offsetMinutes |-> Empty])
  ELSE Ok(s, [name |-> Empty, offsetMinutes |-> r.v.offset.sign * (r.v.offset.hour * 60 + r.v.offset.minute)])
\* The groups of a TemporalDurationString, each [found, p, digits, fraction] for the digits before
\* one of the designators and the fraction digits (Empty for none) when the group allows one.
TPDurationGroup(u, p, designator, allowFraction) ==
  LET end == TPDigitsEnd(u, p, Len(u))
      fraction == IF allowFraction /\ end > p THEN TPFraction(u, end) ELSE TPOk(end, Empty)
      at == IF fraction.ok THEN fraction.p ELSE end
  IN IF end > p /\ fraction.ok /\ TPAt(u, at) \in designator
     THEN [found |-> TRUE, p |-> at + 1, digits |-> SubSeq(u, p, end - 1), fraction |-> fraction.v]
     ELSE [found |-> FALSE, p |-> p, digits |-> <<>>, fraction |-> Empty]
\* TemporalDurationString, as engine262's regular expression matches it (case-insensitively), as
\* [sign, years, months, weeks, days, hours, minutes, seconds] groups, or TPFail.
TPDurationString(u) ==
  LET signed == TPAt(u, 1) \in {43, 45}
      p == IF signed THEN 2 ELSE 1
  IN IF TPAt(u, p) \notin {80, 112} THEN TPFail ELSE
  LET years == TPDurationGroup(u, p + 1, {89, 121}, FALSE)
      months == TPDurationGroup(u, years.p, {77, 109}, FALSE)
      weeks == TPDurationGroup(u, months.p, {87, 119}, FALSE)
      days == TPDurationGroup(u, weeks.p, {68, 100}, FALSE)
      hasTime == TPAt(u, days.p) \in {84, 116}
      hours == TPDurationGroup(u, days.p + 1, {72, 104}, TRUE)
      minutes == TPDurationGroup(u, hours.p, {77, 109}, TRUE)
      seconds == TPDurationGroup(u, minutes.p, {83, 115}, TRUE)
      end == IF hasTime THEN seconds.p ELSE days.p
      anyTime == hasTime /\ (hours.found \/ minutes.found \/ seconds.found)
  IN IF end # Len(u) + 1 \/ (hasTime /\ ~anyTime) \/
        (hasTime /\ hours.fraction # Empty /\ (minutes.found \/ seconds.found)) \/
        (hasTime /\ minutes.fraction # Empty /\ seconds.found) \/
        ~(years.found \/ months.found \/ weeks.found \/ days.found \/ anyTime) THEN TPFail
     ELSE TPOk(end, [sign |-> IF TPAt(u, 1) = 45 THEN -1 ELSE 1, years |-> years, months |-> months,
                     weeks |-> weeks, days |-> days,
                     hours |-> IF hasTime THEN hours ELSE TPDurationGroup(<<>>, 1, {}, FALSE),
                     minutes |-> IF hasTime THEN minutes ELSE TPDurationGroup(<<>>, 1, {}, FALSE),
                     seconds |-> IF hasTime THEN seconds ELSE TPDurationGroup(<<>>, 1, {}, FALSE)])
\* The mathematical value of a group's digits as SnapToInteger reads them, through a Number, which
\* is infinite for too many digits.
TPGroupNumber(g) == PrimitiveToNumber(Str(g.digits)).value
TPGroupValue(g) == IntegralNumberToBigInt(TPGroupNumber(g))
\* A fraction's digits as nanoseconds of its unit, 0 to 999999999.
TPFractionNs(fraction) == LET sub == TPSubSecond(fraction) IN sub.ms * 1000000 + sub.us * 1000 + sub.ns
\* ParseTemporalDurationString (Temporal §7.5.25): the duration's ten fields as BigInts. The
\* fraction of the smallest unit present spreads exactly over the smaller units.
ParseTemporalDurationString(s, units) ==
  LET r == TPDurationString(units) IN
  IF ~r.ok \/ \E g \in {"years", "months", "weeks", "days", "hours", "minutes", "seconds"} : ~NumIsFinite(TPGroupNumber(r.v[g]))
  THEN ThrowError(s, "RangeError") ELSE
  LET d == r.v
      fractionUnit == CASE d.hours.fraction # Empty -> 3600
                        [] d.minutes.fraction # Empty -> 60
                        [] OTHER -> 1
      fraction == CASE d.hours.fraction # Empty -> d.hours.fraction
                    [] d.minutes.fraction # Empty -> d.minutes.fraction
                    [] OTHER -> d.seconds.fraction
      \* The fraction in nanoseconds.
      rest == TIMul(TI(TPFractionNs(fraction)), TI(fractionUnit))
      minutes == IF d.hours.fraction # Empty THEN TIFloorDiv(rest, TINsPerMinute) ELSE TPGroupValue(d.minutes)
      afterMinutes == IF d.hours.fraction # Empty THEN TIMod(rest, TINsPerMinute) ELSE rest
      seconds == IF d.hours.fraction # Empty \/ d.minutes.fraction # Empty THEN TIFloorDiv(afterMinutes, TINsPerSecond)
                 ELSE TPGroupValue(d.seconds)
      subSecond == TIToInt(TIMod(afterMinutes, TINsPerSecond))
      sign == TI(d.sign)
  IN Ok(s, << TIMul(sign, TPGroupValue(d.years)), TIMul(sign, TPGroupValue(d.months)),
              TIMul(sign, TPGroupValue(d.weeks)), TIMul(sign, TPGroupValue(d.days)),
              TIMul(sign, TPGroupValue(d.hours)), TIMul(sign, minutes), TIMul(sign, seconds),
              TI(d.sign * (subSecond \div 1000000)), TI(d.sign * ((subSecond \div 1000) % 1000)),
              TI(d.sign * (subSecond % 1000)) >>)
\* The Temporal types (Temporal §3 to §10) and Temporal.Now, on the ISO calendar and the fixed-offset
\* time zones of 89-temporal-dates.
\* A Temporal.PlainDate has class "temporalDate" and slots [date, calendar].
CreateTemporalDate(s, date, calendar, newTarget) ==
  IF ~ISODateWithinLimits(date) THEN ThrowError(s, "RangeError")
  ELSE OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalPlainDate") ELSE newTarget,
                                     "TemporalPlainDatePrototype", "temporalDate", [date |-> date, calendar |-> calendar])
\* The overflow option of options, read for its effects only.
ReadOverflowOption(s, options) ==
  LET opts == GetOptionsObject(s, options) IN IF IsAbrupt(opts) THEN opts ELSE GetTemporalOverflowOption(opts.s, Val(opts))
\* ToTemporalDate, as [date, calendar].
ToTemporalDateRecord(s, item, options) ==
  IF IsObject(item) THEN
    LET o == O(s, item) IN
    IF o.class \in {"temporalDate", "temporalDateTime", "temporalZonedDateTime"} THEN
      LET read == ReadOverflowOption(s, options) IN IF IsAbrupt(read) THEN read
      ELSE Ok(read.s, [date |-> CASE o.class = "temporalDate" -> o.slots.date
                                  [] o.class = "temporalDateTime" -> o.slots.dateTime.date
                                  [] OTHER -> ZonedDateTimeISODateTime(s, item).date,
                       calendar |-> o.slots.calendar])
    ELSE LET calendar == GetTemporalCalendarIdentifierWithISODefault(s, item) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET fields == PrepareCalendarFields(calendar.s, item, DateFieldNames, "no-required-fields") IN IF IsAbrupt(fields) THEN fields ELSE
         LET opts == GetOptionsObject(fields.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
         LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
         LET date == CalendarDateFromFields(overflow.s, Val(fields), Val(overflow)) IN
         IF IsAbrupt(date) THEN date ELSE Ok(date.s, [date |-> Val(date), calendar |-> Val(calendar)])
  ELSE IF ~IsString(item) THEN ThrowTypeError(s)
  ELSE LET parsed == ParseISODateTime(s, item.value, "plain-date-time") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET calendar == CanonicalizeCalendar(parsed.s, IF Val(parsed).calendar = Empty THEN ISO8601 ELSE Val(parsed).calendar) IN
       IF IsAbrupt(calendar) THEN calendar ELSE
       LET read == ReadOverflowOption(calendar.s, options) IN IF IsAbrupt(read) THEN read ELSE
       LET date == [year |-> Val(parsed).year, month |-> Val(parsed).month, day |-> Val(parsed).day] IN
       IF ISODateWithinLimits(date) THEN Ok(read.s, [date |-> date, calendar |-> Val(calendar)]) ELSE ThrowError(read.s, "RangeError")
\* The fields a calendar date record (CalendarISOToDate) gives the getters of PlainDate and kin.
CalendarDateGetter(s, date, m) ==
  CASE m = "era" \/ m = "eraYear" -> Ok(s, Undefined)
    [] m = "year" -> Ok(s, IntV(date.year))
    [] m = "month" -> Ok(s, IntV(date.month))
    [] m = "monthCode" -> Ok(s, Str(CreateMonthCode(date.month, FALSE)))
    [] m = "day" -> Ok(s, IntV(date.day))
    [] m = "dayOfWeek" -> Ok(s, IntV(ISODayOfWeek(date)))
    [] m = "dayOfYear" -> Ok(s, IntV(ISODayOfYear(date)))
    [] m = "weekOfYear" -> Ok(s, IntV(ISOWeekOfYear(date).week))
    [] m = "yearOfWeek" -> Ok(s, IntV(ISOWeekOfYear(date).year))
    [] m = "daysInWeek" -> Ok(s, IntV(7))
    [] m = "daysInMonth" -> Ok(s, IntV(ISODaysInMonth(date.year, date.month)))
    [] m = "daysInYear" -> Ok(s, IntV(IF IsLeapYear(date.year) THEN 366 ELSE 365))
    [] m = "monthsInYear" -> Ok(s, IntV(12))
    [] m = "inLeapYear" -> Ok(s, Bool(IsLeapYear(date.year)))
\* DifferenceTemporalPlainDate.
DifferenceTemporalPlainDate(s, operation, plain, other, options) ==
  LET o == ToTemporalDateRecord(s, other, Undefined) IN IF IsAbrupt(o) THEN o
  ELSE IF Val(o).calendar # plain.calendar THEN ThrowError(o.s, "RangeError") ELSE
  LET opts == GetOptionsObject(o.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET settings == GetDifferenceSettings(opts.s, operation, Val(opts), "date", {}, TUDay, TUDay) IN IF IsAbrupt(settings) THEN settings
  ELSE IF CompareISODate(plain.date, Val(o).date) = 0 THEN CreateTemporalDuration(settings.s, ZeroDurationFields, Empty) ELSE
  LET st == Val(settings)
      from == [date |-> plain.date, time |-> MidnightTimeRecord]
      to == [date |-> Val(o).date, time |-> MidnightTimeRecord]
      diff == CombineDateAndTimeDuration(CalendarDateUntil(plain.date, Val(o).date, st.largestUnit), TI(0))
      rounded == IF st.smallestUnit = TUDay /\ st.roundingIncrement = 1 THEN Ok(settings.s, diff)
                 ELSE RoundRelativeDuration(settings.s, diff, GetUTCEpochNanoseconds(from), GetUTCEpochNanoseconds(to), from, Empty,
                                            st.largestUnit, st.roundingIncrement, st.smallestUnit, st.roundingMode)
  IN IF IsAbrupt(rounded) THEN rounded ELSE
  LET f == DurationFieldsFromInternal(Val(rounded), TUDay) IN
  CreateTemporalDuration(rounded.s, IF operation = "since" THEN NegatedDurationFields(f) ELSE f, Empty)
\* AddDurationToDate.
AddDurationToDate(s, operation, plain, durationLike, options) ==
  LET d == ToTemporalDurationFields(s, durationLike) IN IF IsAbrupt(d) THEN d ELSE
  LET internal == ToInternalDurationRecordWith24HourDays(IF operation = "subtract" THEN NegatedDurationFields(Val(d)) ELSE Val(d))
      dateDuration == <<internal.date[1], internal.date[2], internal.date[3], BigIntDiv(internal.time, TINsPerDay)>>
      opts == GetOptionsObject(d.s, options)
  IN IF IsAbrupt(opts) THEN opts ELSE
  LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
  LET result == CalendarDateAdd(overflow.s, plain.date, dateDuration, Val(overflow)) IN
  IF IsAbrupt(result) THEN result ELSE CreateTemporalDate(result.s, Val(result), plain.calendar, Empty)
\* ToTimeRecordOrMidnight.
ToTimeRecordOrMidnight(s, item) == IF item = Undefined THEN Ok(s, MidnightTimeRecord) ELSE ToTemporalTimeRecord(s, item, Undefined)
PlainDateBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET year == SnapToInteger(s, Arg(args, 1), TRUE) IN IF IsAbrupt(year) THEN year ELSE
         LET month == SnapToInteger(year.s, Arg(args, 2), TRUE) IN IF IsAbrupt(month) THEN month ELSE
         LET day == SnapToInteger(month.s, Arg(args, 3), TRUE) IN IF IsAbrupt(day) THEN day ELSE
         LET calendarArg == IF Arg(args, 4) = Undefined THEN Str(ISO8601) ELSE Arg(args, 4) IN
         IF ~IsString(calendarArg) THEN ThrowTypeError(day.s) ELSE
         LET calendar == CanonicalizeCalendar(day.s, calendarArg.value) IN IF IsAbrupt(calendar) THEN calendar
         ELSE IF ~TIYearInRange(Val(year)) THEN ThrowError(calendar.s, "RangeError") ELSE
         LET date == RegulateISODate(calendar.s, TIToInt(Val(year)), Val(month), Val(day), N("reject")) IN
         IF IsAbrupt(date) THEN date ELSE CreateTemporalDate(date.s, Val(date), Val(calendar), nt)
    [] m = "from" ->
         LET r == ToTemporalDateRecord(s, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(r) THEN r ELSE CreateTemporalDate(r.s, Val(r).date, Val(r).calendar, Empty)
    [] m = "compare" ->
         LET x == ToTemporalDateRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalDateRecord(x.s, Arg(args, 2), Undefined) IN IF IsAbrupt(y) THEN y
         ELSE Ok(y.s, IntV(CompareISODate(Val(x).date, Val(y).date)))
    [] ~HasClass(s, this, "temporalDate") -> ThrowTypeError(s)
    [] OTHER ->
         LET plain == O(s, this).slots
             date == plain.date
         IN CASE m \in CalendarDateGetters -> CalendarDateGetter(s, date, m)
              [] m = "calendarId" -> Ok(s, Str(plain.calendar))
              [] m = "toPlainYearMonth" ->
                   LET ym == CalendarYearMonthFromFields(s, ISODateToFields(date, "date"), N("constrain")) IN
                   IF IsAbrupt(ym) THEN ym ELSE CreateTemporalYearMonth(ym.s, Val(ym), plain.calendar, Empty)
              [] m = "toPlainMonthDay" ->
                   LET md == CalendarMonthDayFromFields(s, ISODateToFields(date, "date"), N("constrain")) IN
                   IF IsAbrupt(md) THEN md ELSE CreateTemporalMonthDay(md.s, Val(md), plain.calendar, Empty)
              [] m \in {"add", "subtract"} -> AddDurationToDate(s, m, plain, Arg(args, 1), Arg(args, 2))
              [] m = "with" ->
                   LET isPartial == IsPartialTemporalObject(s, Arg(args, 1)) IN IF IsAbrupt(isPartial) THEN isPartial
                   ELSE IF ~Val(isPartial) THEN ThrowTypeError(isPartial.s) ELSE
                   LET partial == PrepareCalendarFields(isPartial.s, Arg(args, 1), DateFieldNames, "partial") IN
                   IF IsAbrupt(partial) THEN partial ELSE
                   LET fields == CalendarMergeFields(ISODateToFields(date, "date"), Val(partial))
                       opts == GetOptionsObject(partial.s, Arg(args, 2))
                   IN IF IsAbrupt(opts) THEN opts ELSE
                   LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
                   LET r == CalendarDateFromFields(overflow.s, fields, Val(overflow)) IN
                   IF IsAbrupt(r) THEN r ELSE CreateTemporalDate(r.s, Val(r), plain.calendar, Empty)
              [] m = "withCalendar" ->
                   LET calendar == ToTemporalCalendarIdentifier(s, Arg(args, 1)) IN
                   IF IsAbrupt(calendar) THEN calendar ELSE CreateTemporalDate(calendar.s, date, Val(calendar), Empty)
              [] m \in {"until", "since"} -> DifferenceTemporalPlainDate(s, m, plain, Arg(args, 1), Arg(args, 2))
              [] m = "equals" ->
                   LET other == ToTemporalDateRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(other) THEN other
                   ELSE Ok(other.s, Bool(CompareISODate(date, Val(other).date) = 0 /\ plain.calendar = Val(other).calendar))
              [] m = "toPlainDateTime" ->
                   LET time == ToTimeRecordOrMidnight(s, Arg(args, 1)) IN IF IsAbrupt(time) THEN time
                   ELSE CreateTemporalDateTime(time.s, [date |-> date, time |-> Val(time)], plain.calendar, Empty)
              [] m = "toZonedDateTime" -> PlainDateToZonedDateTime(s, plain, Arg(args, 1))
              [] m = "toString" ->
                   LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                   LET show == GetTemporalShowCalendarNameOption(opts.s, Val(opts)) IN IF IsAbrupt(show) THEN show
                   ELSE Ok(show.s, Str(TemporalDateToString(date, plain.calendar, Val(show))))
              [] m \in {"toLocaleString", "toJSON"} -> Ok(s, Str(TemporalDateToString(date, plain.calendar, N("auto"))))
              [] m = "valueOf" -> ThrowTypeError(s)
\* Temporal.PlainDate.prototype.toZonedDateTime.
PlainDateToZonedDateTime(s, plain, item) ==
  LET timeZoneLike == IF IsObject(item) THEN Get(s, item, SV("timeZone")) ELSE Ok(s, Undefined) IN
  IF IsAbrupt(timeZoneLike) THEN timeZoneLike ELSE
  LET tz == ToTemporalTimeZoneIdentifier(timeZoneLike.s, IF Val(timeZoneLike) = Undefined THEN item ELSE Val(timeZoneLike)) IN
  IF IsAbrupt(tz) THEN tz ELSE
  LET temporalTime == IF IsObject(item) /\ Val(timeZoneLike) # Undefined THEN Get(tz.s, item, SV("plainTime")) ELSE Ok(tz.s, Undefined) IN
  IF IsAbrupt(temporalTime) THEN temporalTime ELSE
  LET ns == IF Val(temporalTime) = Undefined THEN GetStartOfDay(temporalTime.s, Val(tz), plain.date)
            ELSE LET time == ToTemporalTimeRecord(temporalTime.s, Val(temporalTime), Undefined) IN IF IsAbrupt(time) THEN time ELSE
                 LET dt == [date |-> plain.date, time |-> Val(time)] IN
                 IF ~ISODateTimeWithinLimits(dt) THEN ThrowError(time.s, "RangeError") ELSE GetEpochNanosecondsFor(time.s, Val(tz), dt)
  IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), Val(tz), plain.calendar, Empty)
\* PlainDateTime (Temporal §5). A Temporal.PlainDateTime has class "temporalDateTime" and slots
\* [dateTime, calendar].
CreateTemporalDateTime(s, dt, calendar, newTarget) ==
  IF ~ISODateTimeWithinLimits(dt) THEN ThrowError(s, "RangeError")
  ELSE OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalPlainDateTime") ELSE newTarget,
                                     "TemporalPlainDateTimePrototype", "temporalDateTime", [dateTime |-> dt, calendar |-> calendar])
\* ToTemporalDateTime, as [dateTime, calendar].
ToTemporalDateTimeRecord(s, item, options) ==
  IF IsObject(item) THEN
    LET o == O(s, item) IN
    IF o.class \in {"temporalDate", "temporalDateTime", "temporalZonedDateTime"} THEN
      LET read == ReadOverflowOption(s, options) IN IF IsAbrupt(read) THEN read
      ELSE Ok(read.s, [dateTime |-> CASE o.class = "temporalDateTime" -> o.slots.dateTime
                                      [] o.class = "temporalDate" -> [date |-> o.slots.date, time |-> MidnightTimeRecord]
                                      [] OTHER -> ZonedDateTimeISODateTime(s, item),
                       calendar |-> o.slots.calendar])
    ELSE LET calendar == GetTemporalCalendarIdentifierWithISODefault(s, item) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET fields == PrepareCalendarFields(calendar.s, item, DateFieldNames \cup CalendarTimeFieldNames, "no-required-fields") IN
         IF IsAbrupt(fields) THEN fields ELSE
         LET opts == GetOptionsObject(fields.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
         LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
         LET dt == InterpretTemporalDateTimeFields(overflow.s, Val(fields), Val(overflow)) IN IF IsAbrupt(dt) THEN dt
         ELSE IF ISODateTimeWithinLimits(Val(dt)) THEN Ok(dt.s, [dateTime |-> Val(dt), calendar |-> Val(calendar)])
         ELSE ThrowError(dt.s, "RangeError")
  ELSE IF ~IsString(item) THEN ThrowTypeError(s)
  ELSE LET parsed == ParseISODateTime(s, item.value, "plain-date-time") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET r == Val(parsed)
           calendar == CanonicalizeCalendar(parsed.s, IF r.calendar = Empty THEN ISO8601 ELSE r.calendar)
       IN IF IsAbrupt(calendar) THEN calendar ELSE
       LET read == ReadOverflowOption(calendar.s, options) IN IF IsAbrupt(read) THEN read ELSE
       LET dt == [date |-> [year |-> r.year, month |-> r.month, day |-> r.day],
                  time |-> IF r.time = Empty THEN MidnightTimeRecord ELSE r.time]
       IN IF ISODateTimeWithinLimits(dt) THEN Ok(read.s, [dateTime |-> dt, calendar |-> Val(calendar)]) ELSE ThrowError(read.s, "RangeError")
\* RoundISODateTime.
RoundISODateTime(dt, increment, unit, mode) ==
  LET rounded == RoundTime(dt.time, increment, unit, mode) IN
  [date |-> AddDaysToISODate(dt.date, TIToInt(rounded.days)), time |-> rounded.time]
\* The fields of a date-time, for CalendarMergeFields.
ISODateTimeToFields(dt) ==
  [ISODateToFields(dt.date, "date") EXCEPT !.hour = TI(dt.time.hour), !.minute = TI(dt.time.minute),
                                           !.second = TI(dt.time.second), !.millisecond = TI(dt.time.millisecond),
                                           !.microsecond = TI(dt.time.microsecond), !.nanosecond = TI(dt.time.nanosecond)]
\* The negation of a duration's fields for "since".
SinceFields(operation, f) == IF operation = "since" THEN NegatedDurationFields(f) ELSE f
\* DifferenceTemporalPlainDateTime and AddDurationToDateTime.
DifferenceTemporalPlainDateTime(s, operation, plain, other, options) ==
  LET o == ToTemporalDateTimeRecord(s, other, Undefined) IN IF IsAbrupt(o) THEN o
  ELSE IF Val(o).calendar # plain.calendar THEN ThrowError(o.s, "RangeError") ELSE
  LET opts == GetOptionsObject(o.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET settings == GetDifferenceSettings(opts.s, operation, Val(opts), "datetime", {}, TUNanosecond, TUDay) IN
  IF IsAbrupt(settings) THEN settings
  ELSE IF CompareISODateTime(plain.dateTime, Val(o).dateTime) = 0 THEN CreateTemporalDuration(settings.s, ZeroDurationFields, Empty) ELSE
  LET st == Val(settings)
      diff == DifferencePlainDateTimeWithRounding(settings.s, plain.dateTime, Val(o).dateTime, st.largestUnit,
                                                  st.roundingIncrement, st.smallestUnit, st.roundingMode)
  IN IF IsAbrupt(diff) THEN diff
     ELSE CreateTemporalDuration(diff.s, SinceFields(operation, DurationFieldsFromInternal(Val(diff), st.largestUnit)), Empty)
AddDurationToDateTime(s, operation, plain, durationLike, options) ==
  LET d == ToTemporalDurationFields(s, durationLike) IN IF IsAbrupt(d) THEN d ELSE
  LET opts == GetOptionsObject(d.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
  LET internal == ToInternalDurationRecordWith24HourDays(IF operation = "subtract" THEN NegatedDurationFields(Val(d)) ELSE Val(d))
      timeResult == AddTime(plain.dateTime.time, internal.time)
      dateDuration == CheckedDateDuration(overflow.s, <<internal.date[1], internal.date[2], internal.date[3], timeResult.days>>)
  IN IF IsAbrupt(dateDuration) THEN dateDuration ELSE
  LET added == CalendarDateAdd(dateDuration.s, plain.dateTime.date, Val(dateDuration), Val(overflow)) IN IF IsAbrupt(added) THEN added
  ELSE CreateTemporalDateTime(added.s, [date |-> Val(added), time |-> timeResult.time], plain.calendar, Empty)
\* The smallestUnit and roundingIncrement of round on PlainDateTime and ZonedDateTime: a time unit
\* or day, and an increment that divides the next larger unit (or is 1 for day).
IsValidDayOrTimeRounding(unit, increment) ==
  IsValidUnitValue(unit, "time", {TUDay}) /\
  IsValidRoundingIncrement(increment, TI(IF unit = TUDay THEN 1 ELSE MaximumRoundingIncrement(unit)), unit = TUDay)
\* The roundTo options of round on PlainDateTime and ZonedDateTime: [increment, mode, unit].
GetDayOrTimeRoundingOptions(s, roundToArg) ==
  LET roundTo == StringOrOptionsObject(s, roundToArg, SV("smallestUnit")) IN IF IsAbrupt(roundTo) THEN roundTo ELSE
  LET increment == GetRoundingIncrementOption(roundTo.s, Val(roundTo)) IN IF IsAbrupt(increment) THEN increment ELSE
  LET mode == GetRoundingModeOption(increment.s, Val(roundTo), N("halfExpand")) IN IF IsAbrupt(mode) THEN mode ELSE
  LET unit == GetTemporalUnitValuedOption(mode.s, Val(roundTo), SV("smallestUnit"), TRUE) IN IF IsAbrupt(unit) THEN unit
  ELSE IF ~IsValidDayOrTimeRounding(Val(unit), Val(increment)) THEN ThrowError(unit.s, "RangeError")
  ELSE Ok(unit.s, [increment |-> Val(increment), mode |-> Val(mode), unit |-> Val(unit)])
\* The options of toString on PlainTime's kin after showCalendar: [digits, mode, unit], with
\* GetTemporalFractionalSecondDigitsOption, GetRoundingModeOption, and the smallestUnit.
GetTimeStringOptions(s, options) ==
  LET digits == GetTemporalFractionalSecondDigitsOption(s, options) IN IF IsAbrupt(digits) THEN digits ELSE
  LET mode == GetRoundingModeOption(digits.s, options, N("trunc")) IN IF IsAbrupt(mode) THEN mode ELSE
  LET unit == GetTemporalUnitValuedOption(mode.s, options, SV("smallestUnit"), FALSE) IN IF IsAbrupt(unit) THEN unit
  ELSE Ok(unit.s, [digits |-> Val(digits), mode |-> Val(mode), unit |-> Val(unit)])
IsValidStringUnit(unit) == IsValidUnitValue(unit, "time", {}) /\ unit # TUHour
PlainDateTimeBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET year == SnapToInteger(s, Arg(args, 1), TRUE) IN IF IsAbrupt(year) THEN year ELSE
         LET month == SnapToInteger(year.s, Arg(args, 2), TRUE) IN IF IsAbrupt(month) THEN month ELSE
         LET day == SnapToInteger(month.s, Arg(args, 3), TRUE) IN IF IsAbrupt(day) THEN day ELSE
         LET time == SnapArgs(day.s, args, 4, 9, TRUE, <<>>) IN IF IsAbrupt(time) THEN time ELSE
         LET calendarArg == IF Arg(args, 10) = Undefined THEN Str(ISO8601) ELSE Arg(args, 10) IN
         IF ~IsString(calendarArg) THEN ThrowTypeError(time.s) ELSE
         LET calendar == CanonicalizeCalendar(time.s, calendarArg.value) IN IF IsAbrupt(calendar) THEN calendar
         ELSE IF ~TIYearInRange(Val(year)) THEN ThrowError(calendar.s, "RangeError") ELSE
         LET date == RegulateISODate(calendar.s, TIToInt(Val(year)), Val(month), Val(day), N("reject")) IN IF IsAbrupt(date) THEN date ELSE
         LET t == RegulateTime(date.s, Val(time), N("reject")) IN IF IsAbrupt(t) THEN t
         ELSE CreateTemporalDateTime(t.s, [date |-> Val(date), time |-> Val(t)], Val(calendar), nt)
    [] m = "from" ->
         LET r == ToTemporalDateTimeRecord(s, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(r) THEN r ELSE CreateTemporalDateTime(r.s, Val(r).dateTime, Val(r).calendar, Empty)
    [] m = "compare" ->
         LET x == ToTemporalDateTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalDateTimeRecord(x.s, Arg(args, 2), Undefined) IN IF IsAbrupt(y) THEN y
         ELSE Ok(y.s, IntV(CompareISODateTime(Val(x).dateTime, Val(y).dateTime)))
    [] ~HasClass(s, this, "temporalDateTime") -> ThrowTypeError(s)
    [] OTHER ->
         LET plain == O(s, this).slots
             dt == plain.dateTime
         IN CASE m \in CalendarDateGetters -> CalendarDateGetter(s, dt.date, m)
              [] m \in {"hour", "minute", "second", "millisecond", "microsecond", "nanosecond"} -> Ok(s, IntV(dt.time[m]))
              [] m = "calendarId" -> Ok(s, Str(plain.calendar))
              [] m = "with" ->
                   LET isPartial == IsPartialTemporalObject(s, Arg(args, 1)) IN IF IsAbrupt(isPartial) THEN isPartial
                   ELSE IF ~Val(isPartial) THEN ThrowTypeError(isPartial.s) ELSE
                   LET partial == PrepareCalendarFields(isPartial.s, Arg(args, 1), DateFieldNames \cup CalendarTimeFieldNames, "partial") IN
                   IF IsAbrupt(partial) THEN partial ELSE
                   LET opts == GetOptionsObject(partial.s, Arg(args, 2)) IN IF IsAbrupt(opts) THEN opts ELSE
                   LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
                   LET r == InterpretTemporalDateTimeFields(overflow.s, CalendarMergeFields(ISODateTimeToFields(dt), Val(partial)), Val(overflow)) IN
                   IF IsAbrupt(r) THEN r ELSE CreateTemporalDateTime(r.s, Val(r), plain.calendar, Empty)
              [] m = "withPlainTime" ->
                   LET time == ToTimeRecordOrMidnight(s, Arg(args, 1)) IN IF IsAbrupt(time) THEN time
                   ELSE CreateTemporalDateTime(time.s, [date |-> dt.date, time |-> Val(time)], plain.calendar, Empty)
              [] m = "withCalendar" ->
                   LET calendar == ToTemporalCalendarIdentifier(s, Arg(args, 1)) IN
                   IF IsAbrupt(calendar) THEN calendar ELSE CreateTemporalDateTime(calendar.s, dt, Val(calendar), Empty)
              [] m \in {"add", "subtract"} -> AddDurationToDateTime(s, m, plain, Arg(args, 1), Arg(args, 2))
              [] m \in {"until", "since"} -> DifferenceTemporalPlainDateTime(s, m, plain, Arg(args, 1), Arg(args, 2))
              [] m = "round" ->
                   LET r == GetDayOrTimeRoundingOptions(s, Arg(args, 1)) IN IF IsAbrupt(r) THEN r
                   ELSE CreateTemporalDateTime(r.s, RoundISODateTime(dt, Val(r).increment, Val(r).unit, Val(r).mode), plain.calendar, Empty)
              [] m = "equals" ->
                   LET other == ToTemporalDateTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(other) THEN other
                   ELSE Ok(other.s, Bool(CompareISODateTime(dt, Val(other).dateTime) = 0 /\ plain.calendar = Val(other).calendar))
              [] m = "toString" ->
                   LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                   LET show == GetTemporalShowCalendarNameOption(opts.s, Val(opts)) IN IF IsAbrupt(show) THEN show ELSE
                   LET o == GetTimeStringOptions(show.s, Val(opts)) IN IF IsAbrupt(o) THEN o
                   ELSE IF ~IsValidStringUnit(Val(o).unit) THEN ThrowError(o.s, "RangeError") ELSE
                   LET precision == ToSecondsStringPrecisionRecord(Val(o).unit, Val(o).digits)
                       result == RoundISODateTime(dt, precision.increment, precision.unit, Val(o).mode)
                   IN IF ~ISODateTimeWithinLimits(result) THEN ThrowError(o.s, "RangeError")
                      ELSE Ok(o.s, Str(FormatISODateTime(result, plain.calendar, precision.precision, Val(show))))
              [] m \in {"toLocaleString", "toJSON"} -> Ok(s, Str(FormatISODateTime(dt, plain.calendar, TPrecisionAuto, N("auto"))))
              [] m = "valueOf" -> ThrowTypeError(s)
              [] m = "toZonedDateTime" ->
                   LET tz == ToTemporalTimeZoneIdentifier(s, Arg(args, 1)) IN IF IsAbrupt(tz) THEN tz ELSE
                   LET opts == GetOptionsObject(tz.s, Arg(args, 2)) IN IF IsAbrupt(opts) THEN opts ELSE
                   LET disambiguation == GetTemporalDisambiguationOption(opts.s, Val(opts)) IN IF IsAbrupt(disambiguation) THEN disambiguation ELSE
                   LET ns == GetEpochNanosecondsFor(disambiguation.s, Val(tz), dt) IN
                   IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), Val(tz), plain.calendar, Empty)
              [] m = "toPlainDate" -> CreateTemporalDate(s, dt.date, plain.calendar, Empty)
              [] m = "toPlainTime" -> CreateTemporalTime(s, dt.time, Empty)
\* ZonedDateTime (Temporal §6). A Temporal.ZonedDateTime has class "temporalZonedDateTime" and
\* slots [epochNs, timeZone, calendar].
CreateTemporalZonedDateTime(s, ns, tz, calendar, newTarget) ==
  OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalZonedDateTime") ELSE newTarget,
                                "TemporalZonedDateTimePrototype", "temporalZonedDateTime",
                                [epochNs |-> ns, timeZone |-> tz, calendar |-> calendar])
ZonedFromSlots(s, z) == CreateTemporalZonedDateTime(s, z.epochNs, z.timeZone, z.calendar, Empty)
\* GetTemporalDisambiguationOption, GetTemporalOffsetOption, GetTemporalShowOffsetOption, and
\* GetTemporalShowTimeZoneNameOption.
GetTemporalDisambiguationOption(s, options) ==
  GetStringOption(s, options, SV("disambiguation"), {N("compatible"), N("earlier"), N("later"), N("reject")}, N("compatible"))
GetTemporalOffsetOption(s, options, fallback) ==
  GetStringOption(s, options, SV("offset"), {N("prefer"), N("use"), N("ignore"), N("reject")}, fallback)
GetTemporalShowOffsetOption(s, options) == GetStringOption(s, options, SV("offset"), {N("auto"), N("never")}, N("auto"))
GetTemporalShowTimeZoneNameOption(s, options) ==
  GetStringOption(s, options, SV("timeZoneName"), {N("auto"), N("never"), N("critical")}, N("auto"))
\* The options ToTemporalZonedDateTime reads: [disambiguation, offset, overflow].
GetZonedOptions(s, options, offsetFallback) ==
  LET opts == GetOptionsObject(s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET disambiguation == GetTemporalDisambiguationOption(opts.s, Val(opts)) IN IF IsAbrupt(disambiguation) THEN disambiguation ELSE
  LET offset == GetTemporalOffsetOption(disambiguation.s, Val(opts), offsetFallback) IN IF IsAbrupt(offset) THEN offset ELSE
  LET overflow == GetTemporalOverflowOption(offset.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow
  ELSE Ok(overflow.s, [offset |-> Val(offset), overflow |-> Val(overflow)])
\* ToTemporalZonedDateTime, as the slots of a ZonedDateTime.
ToTemporalZonedDateTimeRecord(s, item, options) ==
  IF IsObject(item) THEN
    IF O(s, item).class = "temporalZonedDateTime" THEN
      LET read == GetZonedOptions(s, options, N("reject")) IN IF IsAbrupt(read) THEN read ELSE Ok(read.s, O(s, item).slots)
    ELSE LET calendar == GetTemporalCalendarIdentifierWithISODefault(s, item) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET fields == PrepareCalendarFields(calendar.s, item, DateFieldNames \cup CalendarTimeFieldNames \cup {"offset", "timeZone"},
                                             "time-zone") IN
         IF IsAbrupt(fields) THEN fields ELSE
         LET o == GetZonedOptions(fields.s, options, N("reject")) IN IF IsAbrupt(o) THEN o ELSE
         LET dt == InterpretTemporalDateTimeFields(o.s, Val(fields), Val(o).overflow) IN IF IsAbrupt(dt) THEN dt ELSE
         LET offsetString == Val(fields).offset
             ns == InterpretISODateTimeOffset(dt.s, Val(dt).date, Val(dt).time, IF offsetString = Empty THEN "wall" ELSE "option",
                                              IF offsetString = Empty THEN TI(0) ELSE Val(ParseDateTimeUTCOffset(dt.s, offsetString)),
                                              Val(fields).timeZone, Val(o).offset, "match-exactly")
         IN IF IsAbrupt(ns) THEN ns ELSE Ok(ns.s, [epochNs |-> Val(ns), timeZone |-> Val(fields).timeZone, calendar |-> Val(calendar)])
  ELSE IF ~IsString(item) THEN ThrowTypeError(s)
  ELSE LET parsed == ParseISODateTime(s, item.value, "zoned-date-time") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET r == Val(parsed)
           tz == ToTemporalTimeZoneIdentifier(parsed.s, Str(r.tzAnnotation))
       IN IF IsAbrupt(tz) THEN tz ELSE
       LET calendar == CanonicalizeCalendar(tz.s, IF r.calendar = Empty THEN ISO8601 ELSE r.calendar) IN IF IsAbrupt(calendar) THEN calendar ELSE
       LET o == GetZonedOptions(calendar.s, options, N("reject")) IN IF IsAbrupt(o) THEN o ELSE
       LET behaviour == CASE r.z -> "exact" [] r.offset = Empty -> "wall" [] OTHER -> "option"
           ns == InterpretISODateTimeOffset(o.s, [year |-> r.year, month |-> r.month, day |-> r.day], r.time, behaviour,
                                            IF behaviour = "option" THEN Val(ParseDateTimeUTCOffset(o.s, r.offset)) ELSE TI(0),
                                            Val(tz), Val(o).offset, IF r.offset # Empty /\ Len(r.offset) > 6 THEN "match-exactly" ELSE "match-minutes")
       IN IF IsAbrupt(ns) THEN ns ELSE Ok(ns.s, [epochNs |-> Val(ns), timeZone |-> Val(tz), calendar |-> Val(calendar)])
\* RoundEpochNanoseconds: RoundNumberToIncrementAsIfPositive.
RoundEpochNanoseconds(ns, increment, unit, mode) ==
  LET length == TIMul(TI(increment), TemporalUnitLength(unit))
      lower == TIFloorDiv(ns, length)
      remainder == TISub(ns, TIMul(lower, length))
      unsigned == UnsignedRoundingMode(mode, FALSE)
      half == TICompare(TIMul(remainder, TI(2)), length)
      rounded == CASE remainder.mag = <<>> -> lower
                   [] unsigned = "zero" -> lower
                   [] unsigned = "infinity" -> TIAdd(lower, TI(1))
                   [] half < 0 -> lower
                   [] half > 0 -> TIAdd(lower, TI(1))
                   [] unsigned = "half-zero" -> lower
                   [] unsigned = "half-infinity" -> TIAdd(lower, TI(1))
                   [] BNIsOdd(lower.mag) -> TIAdd(lower, TI(1))
                   [] OTHER -> lower
  IN TIMul(rounded, length)
\* TemporalZonedDateTimeToString.
TemporalZonedDateTimeToString(z, precision, showCalendar, showTimeZone, showOffset, increment, unit, mode) ==
  LET ns == RoundEpochNanoseconds(z.epochNs, increment, unit, mode) IN
  FormatISODateTime(GetISODateTimeFor(z.timeZone, ns), ISO8601, precision, N("never")) \o
  (IF showOffset = N("never") THEN <<>> ELSE FormatDateTimeUTCOffsetRounded(GetOffsetNanosecondsFor(z.timeZone))) \o
  (IF showTimeZone = N("never") THEN <<>> ELSE <<91>> \o (IF showTimeZone = N("critical") THEN <<33>> ELSE <<>>) \o z.timeZone.id \o <<93>>) \o
  FormatCalendarAnnotation(z.calendar, showCalendar)
\* DifferenceTemporalZonedDateTime and AddDurationToZonedDateTime.
DifferenceTemporalZonedDateTime(s, operation, z, other, options) ==
  LET o == ToTemporalZonedDateTimeRecord(s, other, Undefined) IN IF IsAbrupt(o) THEN o
  ELSE IF Val(o).calendar # z.calendar THEN ThrowError(o.s, "RangeError") ELSE
  LET opts == GetOptionsObject(o.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET settings == GetDifferenceSettings(opts.s, operation, Val(opts), "datetime", {}, TUNanosecond, TUHour) IN
  IF IsAbrupt(settings) THEN settings ELSE
  LET st == Val(settings) IN
  IF IsTimeUnit(st.largestUnit) THEN
    LET diff == DifferenceEpochNanoseconds(settings.s, z.epochNs, Val(o).epochNs, st.roundingIncrement, st.smallestUnit, st.roundingMode) IN
    IF IsAbrupt(diff) THEN diff
    ELSE CreateTemporalDuration(diff.s, SinceFields(operation, DurationFieldsFromInternal(Val(diff), st.largestUnit)), Empty)
  ELSE IF ~TimeZoneEquals(z.timeZone, Val(o).timeZone) THEN ThrowError(settings.s, "RangeError")
  ELSE IF z.epochNs = Val(o).epochNs THEN CreateTemporalDuration(settings.s, ZeroDurationFields, Empty)
  ELSE LET diff == DifferenceZonedDateTimeWithRounding(settings.s, z.epochNs, Val(o).epochNs, z.timeZone, st.largestUnit,
                                                       st.roundingIncrement, st.smallestUnit, st.roundingMode) IN
       IF IsAbrupt(diff) THEN diff
       ELSE CreateTemporalDuration(diff.s, SinceFields(operation, DurationFieldsFromInternal(Val(diff), TUHour)), Empty)
AddDurationToZonedDateTime(s, operation, z, durationLike, options) ==
  LET d == ToTemporalDurationFields(s, durationLike) IN IF IsAbrupt(d) THEN d ELSE
  LET opts == GetOptionsObject(d.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
  LET ns == AddZonedDateTime(overflow.s, z.epochNs, z.timeZone,
                             ToInternalDurationRecord(IF operation = "subtract" THEN NegatedDurationFields(Val(d)) ELSE Val(d)),
                             Val(overflow))
  IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), z.timeZone, z.calendar, Empty)
\* A Number of the BigInt n.
TINumber(n) == Num(BigIntToNumber(n))
\* Temporal.ZonedDateTime.prototype.round.
RoundZonedDateTime(s, z, roundToArg) ==
  LET r == GetDayOrTimeRoundingOptions(s, roundToArg) IN IF IsAbrupt(r) THEN r ELSE
  LET o == Val(r)
      dt == GetISODateTimeFor(z.timeZone, z.epochNs)
  IN IF o.unit = TUNanosecond /\ o.increment = 1 THEN ZonedFromSlots(r.s, z)
     ELSE IF o.unit = TUDay THEN
       LET start == GetStartOfDay(r.s, z.timeZone, dt.date) IN IF IsAbrupt(start) THEN start ELSE
       LET end == GetStartOfDay(start.s, z.timeZone, AddDaysToISODate(dt.date, 1)) IN IF IsAbrupt(end) THEN end ELSE
       LET ns == IF BigIntLess(z.epochNs, Val(end)) THEN z.epochNs ELSE TISub(Val(end), TI(1))
           rounded == RoundTimeDurationToIncrement(end.s, TISub(ns, Val(start)), TISub(Val(end), Val(start)), o.mode)
       IN IF IsAbrupt(rounded) THEN rounded
          ELSE CreateTemporalZonedDateTime(rounded.s, TIAdd(Val(rounded), Val(start)), z.timeZone, z.calendar, Empty)
     ELSE LET result == RoundISODateTime(dt, o.increment, o.unit, o.mode)
              ns == InterpretISODateTimeOffset(r.s, result.date, result.time, "option", GetOffsetNanosecondsFor(z.timeZone),
                                               z.timeZone, N("prefer"), "match-exactly")
          IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), z.timeZone, z.calendar, Empty)
\* Temporal.ZonedDateTime.prototype.with.
WithZonedDateTime(s, z, item, options) ==
  LET isPartial == IsPartialTemporalObject(s, item) IN IF IsAbrupt(isPartial) THEN isPartial
  ELSE IF ~Val(isPartial) THEN ThrowTypeError(isPartial.s) ELSE
  LET partial == PrepareCalendarFields(isPartial.s, item, DateFieldNames \cup CalendarTimeFieldNames \cup {"offset"}, "partial") IN
  IF IsAbrupt(partial) THEN partial ELSE
  LET dt == GetISODateTimeFor(z.timeZone, z.epochNs)
      fields == CalendarMergeFields([ISODateTimeToFields(dt) EXCEPT !.offset = FormatUTCOffsetNanoseconds(GetOffsetNanosecondsFor(z.timeZone))],
                                    Val(partial))
      o == GetZonedOptions(partial.s, options, N("prefer"))
  IN IF IsAbrupt(o) THEN o ELSE
  LET result == InterpretTemporalDateTimeFields(o.s, fields, Val(o).overflow) IN IF IsAbrupt(result) THEN result ELSE
  LET ns == InterpretISODateTimeOffset(result.s, Val(result).date, Val(result).time, "option",
                                       Val(ParseDateTimeUTCOffset(result.s, fields.offset)), z.timeZone, Val(o).offset, "match-exactly")
  IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), z.timeZone, z.calendar, Empty)
\* The time zone of a ZonedDateTime constructor's argument.
ZonedConstructorTimeZone(s, v) ==
  IF ~IsString(v) THEN ThrowTypeError(s)
  ELSE LET r == ParseTimeZoneIdentifier(s, v.value) IN IF IsAbrupt(r) THEN r
  ELSE IF Val(r).offsetMinutes # Empty THEN
    Ok(r.s, [id |-> FormatOffsetTimeZoneIdentifier(Val(r).offsetMinutes, TRUE), offset |-> Val(r).offsetMinutes])
  ELSE IF TPLower(Val(r).name) = N("utc") THEN Ok(r.s, UTCTimeZone)
  ELSE ThrowError(r.s, "RangeError")
\* The epoch nanoseconds a constructor or fromEpochNanoseconds argument gives.
ToEpochNanoseconds(s, v) ==
  LET b == ToBigInt(s, v) IN IF IsAbrupt(b) THEN b
  ELSE IF IsWithinEpochNanosecondsInterval(Val(b).value) THEN Ok(b.s, Val(b).value) ELSE ThrowError(b.s, "RangeError")
ZonedDateTimeBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET ns == ToEpochNanoseconds(s, Arg(args, 1)) IN IF IsAbrupt(ns) THEN ns ELSE
         LET tz == ZonedConstructorTimeZone(ns.s, Arg(args, 2)) IN IF IsAbrupt(tz) THEN tz ELSE
         LET calendarArg == IF Arg(args, 3) = Undefined THEN Str(ISO8601) ELSE Arg(args, 3) IN
         IF ~IsString(calendarArg) THEN ThrowTypeError(tz.s) ELSE
         LET calendar == CanonicalizeCalendar(tz.s, calendarArg.value) IN IF IsAbrupt(calendar) THEN calendar
         ELSE CreateTemporalZonedDateTime(calendar.s, Val(ns), Val(tz), Val(calendar), nt)
    [] m = "from" ->
         LET z == ToTemporalZonedDateTimeRecord(s, Arg(args, 1), Arg(args, 2)) IN IF IsAbrupt(z) THEN z ELSE ZonedFromSlots(z.s, Val(z))
    [] m = "compare" ->
         LET x == ToTemporalZonedDateTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalZonedDateTimeRecord(x.s, Arg(args, 2), Undefined) IN IF IsAbrupt(y) THEN y
         ELSE Ok(y.s, IntV(TICompare(Val(x).epochNs, Val(y).epochNs)))
    [] ~HasClass(s, this, "temporalZonedDateTime") -> ThrowTypeError(s)
    [] OTHER ->
         LET z == O(s, this).slots
             dt == GetISODateTimeFor(z.timeZone, z.epochNs)
         IN CASE m \in CalendarDateGetters -> CalendarDateGetter(s, dt.date, m)
              [] m \in {"hour", "minute", "second", "millisecond", "microsecond", "nanosecond"} -> Ok(s, IntV(dt.time[m]))
              [] m = "calendarId" -> Ok(s, Str(z.calendar))
              [] m = "timeZoneId" -> Ok(s, Str(z.timeZone.id))
              [] m = "hoursInDay" ->
                   LET today == GetStartOfDay(s, z.timeZone, dt.date) IN IF IsAbrupt(today) THEN today ELSE
                   LET tomorrow == GetStartOfDay(today.s, z.timeZone, AddDaysToISODate(dt.date, 1)) IN IF IsAbrupt(tomorrow) THEN tomorrow
                   ELSE Ok(tomorrow.s, Num(RatioToNumber(TISub(Val(tomorrow), Val(today)), TINsPerHour)))
              [] m = "epochMilliseconds" -> Ok(s, TINumber(TIFloorDiv(z.epochNs, TI(1000000))))
              [] m = "epochNanoseconds" -> Ok(s, BigInt(z.epochNs))
              [] m = "offsetNanoseconds" -> Ok(s, TINumber(GetOffsetNanosecondsFor(z.timeZone)))
              [] m = "offset" -> Ok(s, Str(FormatUTCOffsetNanoseconds(GetOffsetNanosecondsFor(z.timeZone))))
              [] m = "with" -> WithZonedDateTime(s, z, Arg(args, 1), Arg(args, 2))
              [] m = "withPlainTime" ->
                   LET ns == IF Arg(args, 1) = Undefined THEN GetStartOfDay(s, z.timeZone, dt.date)
                             ELSE LET time == ToTemporalTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(time) THEN time
                                  ELSE GetEpochNanosecondsFor(time.s, z.timeZone, [date |-> dt.date, time |-> Val(time)])
                   IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), z.timeZone, z.calendar, Empty)
              [] m = "withTimeZone" ->
                   LET tz == ToTemporalTimeZoneIdentifier(s, Arg(args, 1)) IN
                   IF IsAbrupt(tz) THEN tz ELSE CreateTemporalZonedDateTime(tz.s, z.epochNs, Val(tz), z.calendar, Empty)
              [] m = "withCalendar" ->
                   LET calendar == ToTemporalCalendarIdentifier(s, Arg(args, 1)) IN
                   IF IsAbrupt(calendar) THEN calendar ELSE CreateTemporalZonedDateTime(calendar.s, z.epochNs, z.timeZone, Val(calendar), Empty)
              [] m \in {"add", "subtract"} -> AddDurationToZonedDateTime(s, m, z, Arg(args, 1), Arg(args, 2))
              [] m \in {"until", "since"} -> DifferenceTemporalZonedDateTime(s, m, z, Arg(args, 1), Arg(args, 2))
              [] m = "round" -> RoundZonedDateTime(s, z, Arg(args, 1))
              [] m = "equals" ->
                   LET other == ToTemporalZonedDateTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(other) THEN other
                   ELSE Ok(other.s, Bool(z.epochNs = Val(other).epochNs /\ TimeZoneEquals(z.timeZone, Val(other).timeZone) /\
                                         z.calendar = Val(other).calendar))
              [] m = "toString" ->
                   LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                   LET show == GetTemporalShowCalendarNameOption(opts.s, Val(opts)) IN IF IsAbrupt(show) THEN show ELSE
                   LET digits == GetTemporalFractionalSecondDigitsOption(show.s, Val(opts)) IN IF IsAbrupt(digits) THEN digits ELSE
                   LET showOffset == GetTemporalShowOffsetOption(digits.s, Val(opts)) IN IF IsAbrupt(showOffset) THEN showOffset ELSE
                   LET mode == GetRoundingModeOption(showOffset.s, Val(opts), N("trunc")) IN IF IsAbrupt(mode) THEN mode ELSE
                   LET unit == GetTemporalUnitValuedOption(mode.s, Val(opts), SV("smallestUnit"), FALSE) IN IF IsAbrupt(unit) THEN unit ELSE
                   LET showTimeZone == GetTemporalShowTimeZoneNameOption(unit.s, Val(opts)) IN IF IsAbrupt(showTimeZone) THEN showTimeZone
                   ELSE IF ~IsValidStringUnit(Val(unit)) THEN ThrowError(showTimeZone.s, "RangeError") ELSE
                   LET precision == ToSecondsStringPrecisionRecord(Val(unit), Val(digits)) IN
                   Ok(showTimeZone.s, Str(TemporalZonedDateTimeToString(z, precision.precision, Val(show), Val(showTimeZone), Val(showOffset),
                                                                        precision.increment, precision.unit, Val(mode))))
              [] m \in {"toLocaleString", "toJSON"} ->
                   Ok(s, Str(TemporalZonedDateTimeToString(z, TPrecisionAuto, N("auto"), N("auto"), N("auto"), 1, TUNanosecond, N("trunc"))))
              [] m = "valueOf" -> ThrowTypeError(s)
              [] m = "startOfDay" ->
                   LET ns == GetStartOfDay(s, z.timeZone, dt.date) IN
                   IF IsAbrupt(ns) THEN ns ELSE CreateTemporalZonedDateTime(ns.s, Val(ns), z.timeZone, z.calendar, Empty)
              [] m = "getTimeZoneTransition" ->
                   LET param == StringOrOptionsObject(s, Arg(args, 1), SV("direction")) IN IF IsAbrupt(param) THEN param ELSE
                   LET direction == GetStringOption(param.s, Val(param), SV("direction"), {N("next"), N("previous")}, Empty) IN
                   IF IsAbrupt(direction) THEN direction
                   ELSE IF Val(direction) = Empty THEN ThrowError(direction.s, "RangeError")
                   ELSE Ok(direction.s, Null)
              [] m = "toInstant" -> CreateTemporalInstant(s, z.epochNs, Empty)
              [] m = "toPlainDate" -> CreateTemporalDate(s, dt.date, z.calendar, Empty)
              [] m = "toPlainTime" -> CreateTemporalTime(s, dt.time, Empty)
              [] m = "toPlainDateTime" -> CreateTemporalDateTime(s, dt, z.calendar, Empty)
\* Instant (Temporal §8). A Temporal.Instant has class "temporalInstant" and slots [epochNs].
CreateTemporalInstant(s, ns, newTarget) ==
  OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalInstant") ELSE newTarget,
                                "TemporalInstantPrototype", "temporalInstant", [epochNs |-> ns])
\* ToTemporalInstant, as epoch nanoseconds.
ToTemporalInstantNs(s, item) ==
  IF IsObject(item) /\ O(s, item).class \in {"temporalInstant", "temporalZonedDateTime"} THEN Ok(s, O(s, item).slots.epochNs) ELSE
  LET p == IF IsObject(item) THEN ToPrimitive(s, item, "string") ELSE Ok(s, item) IN IF IsAbrupt(p) THEN p
  ELSE IF ~IsString(Val(p)) THEN ThrowTypeError(p.s)
  ELSE LET parsed == ParseISODateTime(p.s, Val(p).value, "instant") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET r == Val(parsed)
           offsetNs == IF r.z THEN TI(0) ELSE Val(ParseDateTimeUTCOffset(parsed.s, r.offset))
           balanced == AddNanosecondsToISODateTime([date |-> [year |-> r.year, month |-> r.month, day |-> r.day], time |-> r.time],
                                                   TINeg(offsetNs))
           ns == GetUTCEpochNanoseconds(balanced)
       IN IF ~IsValidISODaysRange(balanced.date) \/ ~IsWithinEpochNanosecondsInterval(ns) THEN ThrowError(parsed.s, "RangeError")
          ELSE Ok(parsed.s, ns)
\* TemporalInstantToString, for a time zone or Empty.
TemporalInstantToString(ns, tz, precision) ==
  FormatISODateTime(GetISODateTimeFor(IF tz = Empty THEN UTCTimeZone ELSE tz, ns), ISO8601, precision, N("never")) \o
  (IF tz = Empty THEN <<90>> ELSE FormatDateTimeUTCOffsetRounded(GetOffsetNanosecondsFor(tz)))
\* DifferenceTemporalInstant and AddDurationToInstant.
DifferenceTemporalInstant(s, operation, ns, other, options) ==
  LET o == ToTemporalInstantNs(s, other) IN IF IsAbrupt(o) THEN o ELSE
  LET opts == GetOptionsObject(o.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET settings == GetDifferenceSettings(opts.s, operation, Val(opts), "time", {}, TUNanosecond, TUSecond) IN
  IF IsAbrupt(settings) THEN settings ELSE
  LET st == Val(settings)
      diff == DifferenceEpochNanoseconds(settings.s, ns, Val(o), st.roundingIncrement, st.smallestUnit, st.roundingMode)
  IN IF IsAbrupt(diff) THEN diff
     ELSE CreateTemporalDuration(diff.s, SinceFields(operation, DurationFieldsFromInternal(Val(diff), st.largestUnit)), Empty)
AddDurationToInstant(s, operation, ns, durationLike) ==
  LET d == ToTemporalDurationFields(s, durationLike) IN IF IsAbrupt(d) THEN d ELSE
  LET duration == IF operation = "subtract" THEN NegatedDurationFields(Val(d)) ELSE Val(d) IN
  IF IsDateUnit(DefaultTemporalLargestUnit(duration)) THEN ThrowError(d.s, "RangeError") ELSE
  LET r == AddEpochNanoseconds(d.s, ns, ToInternalDurationRecordWith24HourDays(duration).time) IN
  IF IsAbrupt(r) THEN r ELSE CreateTemporalInstant(r.s, Val(r), Empty)
InstantBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET ns == ToEpochNanoseconds(s, Arg(args, 1)) IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalInstant(ns.s, Val(ns), nt)
    [] m = "from" -> LET ns == ToTemporalInstantNs(s, Arg(args, 1)) IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalInstant(ns.s, Val(ns), Empty)
    [] m = "fromEpochMilliseconds" ->
         LET ms == SnapToInteger(s, Arg(args, 1), FALSE) IN IF IsAbrupt(ms) THEN ms
         ELSE IF BigIntLess(BigIntDiv(TINsMaxInstant, TI(1000000)), TIAbs(Val(ms))) THEN ThrowError(ms.s, "RangeError")
         ELSE CreateTemporalInstant(ms.s, TIMul(Val(ms), TI(1000000)), Empty)
    [] m = "fromEpochNanoseconds" ->
         LET ns == ToEpochNanoseconds(s, Arg(args, 1)) IN IF IsAbrupt(ns) THEN ns ELSE CreateTemporalInstant(ns.s, Val(ns), Empty)
    [] m = "compare" ->
         LET x == ToTemporalInstantNs(s, Arg(args, 1)) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalInstantNs(x.s, Arg(args, 2)) IN IF IsAbrupt(y) THEN y ELSE Ok(y.s, IntV(TICompare(Val(x), Val(y))))
    [] ~HasClass(s, this, "temporalInstant") -> ThrowTypeError(s)
    [] OTHER ->
         LET ns == O(s, this).slots.epochNs IN
         CASE m = "epochMilliseconds" -> Ok(s, TINumber(TIFloorDiv(ns, TI(1000000))))
           [] m = "epochNanoseconds" -> Ok(s, BigInt(ns))
           [] m \in {"add", "subtract"} -> AddDurationToInstant(s, m, ns, Arg(args, 1))
           [] m \in {"until", "since"} -> DifferenceTemporalInstant(s, m, ns, Arg(args, 1), Arg(args, 2))
           [] m = "round" ->
                LET roundTo == StringOrOptionsObject(s, Arg(args, 1), SV("smallestUnit")) IN IF IsAbrupt(roundTo) THEN roundTo ELSE
                LET increment == GetRoundingIncrementOption(roundTo.s, Val(roundTo)) IN IF IsAbrupt(increment) THEN increment ELSE
                LET mode == GetRoundingModeOption(increment.s, Val(roundTo), N("halfExpand")) IN IF IsAbrupt(mode) THEN mode ELSE
                LET unit == GetTemporalUnitValuedOption(mode.s, Val(roundTo), SV("smallestUnit"), TRUE) IN IF IsAbrupt(unit) THEN unit
                ELSE IF ~IsValidUnitValue(Val(unit), "time", {}) \/
                        ~IsValidRoundingIncrement(Val(increment), BigIntDiv(TINsPerDay, TemporalUnitLength(Val(unit))), TRUE)
                THEN ThrowError(unit.s, "RangeError")
                ELSE CreateTemporalInstant(unit.s, RoundEpochNanoseconds(ns, Val(increment), Val(unit), Val(mode)), Empty)
           [] m = "equals" ->
                LET other == ToTemporalInstantNs(s, Arg(args, 1)) IN IF IsAbrupt(other) THEN other ELSE Ok(other.s, Bool(ns = Val(other)))
           [] m = "toString" ->
                LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET o == GetTimeStringOptions(opts.s, Val(opts)) IN IF IsAbrupt(o) THEN o ELSE
                LET tzLike == Get(o.s, Val(opts), SV("timeZone")) IN IF IsAbrupt(tzLike) THEN tzLike
                ELSE IF ~IsValidStringUnit(Val(o).unit) THEN ThrowError(tzLike.s, "RangeError") ELSE
                LET tz == IF Val(tzLike) = Undefined THEN Ok(tzLike.s, Empty) ELSE ToTemporalTimeZoneIdentifier(tzLike.s, Val(tzLike)) IN
                IF IsAbrupt(tz) THEN tz ELSE
                LET precision == ToSecondsStringPrecisionRecord(Val(o).unit, Val(o).digits) IN
                Ok(tz.s, Str(TemporalInstantToString(RoundEpochNanoseconds(ns, precision.increment, precision.unit, Val(o).mode),
                                                     Val(tz), precision.precision)))
           [] m \in {"toLocaleString", "toJSON"} -> Ok(s, Str(TemporalInstantToString(ns, Empty, TPrecisionAuto)))
           [] m = "valueOf" -> ThrowTypeError(s)
           [] m = "toZonedDateTimeISO" ->
                LET tz == ToTemporalTimeZoneIdentifier(s, Arg(args, 1)) IN
                IF IsAbrupt(tz) THEN tz ELSE CreateTemporalZonedDateTime(tz.s, ns, Val(tz), ISO8601, Empty)
\* PlainYearMonth (Temporal §9). A Temporal.PlainYearMonth has class "temporalYearMonth" and slots
\* [date, calendar], with a reference day.
CreateTemporalYearMonth(s, date, calendar, newTarget) ==
  IF ~ISOYearMonthWithinLimits(date) THEN ThrowError(s, "RangeError")
  ELSE OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalPlainYearMonth") ELSE newTarget,
                                     "TemporalPlainYearMonthPrototype", "temporalYearMonth", [date |-> date, calendar |-> calendar])
\* ToTemporalYearMonth, as [date, calendar].
ToTemporalYearMonthRecord(s, item, options) ==
  IF IsObject(item) THEN
    IF O(s, item).class = "temporalYearMonth" THEN
      LET read == ReadOverflowOption(s, options) IN IF IsAbrupt(read) THEN read ELSE Ok(read.s, O(s, item).slots)
    ELSE LET calendar == GetTemporalCalendarIdentifierWithISODefault(s, item) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET fields == PrepareCalendarFields(calendar.s, item, YearMonthFieldNames, "no-required-fields") IN IF IsAbrupt(fields) THEN fields ELSE
         LET opts == GetOptionsObject(fields.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
         LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
         LET date == CalendarYearMonthFromFields(overflow.s, Val(fields), Val(overflow)) IN
         IF IsAbrupt(date) THEN date ELSE Ok(date.s, [date |-> Val(date), calendar |-> Val(calendar)])
  ELSE IF ~IsString(item) THEN ThrowTypeError(s)
  ELSE LET parsed == ParseISODateTime(s, item.value, "year-month") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET r == Val(parsed)
           calendar == CanonicalizeCalendar(parsed.s, IF r.calendar = Empty THEN ISO8601 ELSE r.calendar)
       IN IF IsAbrupt(calendar) THEN calendar ELSE
       LET read == ReadOverflowOption(calendar.s, options) IN IF IsAbrupt(read) THEN read
       ELSE IF ~ISOYearMonthWithinLimits([year |-> r.year, month |-> r.month, day |-> r.day]) THEN ThrowError(read.s, "RangeError")
       ELSE LET date == CalendarYearMonthFromFields(read.s, ISODateToFields([year |-> r.year, month |-> r.month, day |-> r.day], "year-month"),
                                                    N("constrain")) IN
            IF IsAbrupt(date) THEN date ELSE Ok(date.s, [date |-> Val(date), calendar |-> Val(calendar)])
\* TemporalYearMonthToString and TemporalMonthDayToString.
TemporalYearMonthToString(ym, show) ==
  PadISOYear(ym.date.year) \o <<45>> \o TwoDigits(ym.date.month) \o
  (IF show \in {N("always"), N("critical")} \/ ym.calendar # ISO8601 THEN <<45>> \o TwoDigits(ym.date.day) ELSE <<>>) \o
  FormatCalendarAnnotation(ym.calendar, show)
TemporalMonthDayToString(md, show) ==
  (IF show \in {N("always"), N("critical")} \/ md.calendar # ISO8601 THEN PadISOYear(md.date.year) \o <<45>> ELSE <<>>) \o
  TwoDigits(md.date.month) \o <<45>> \o TwoDigits(md.date.day) \o FormatCalendarAnnotation(md.calendar, show)
\* The first day of a year-month, as CalendarDateFromFields gives it.
YearMonthFirstDay(s, date) == CalendarDateFromFields(s, [ISODateToFields(date, "year-month") EXCEPT !.day = TI(1)], N("constrain"))
\* DifferenceTemporalPlainYearMonth and AddDurationToYearMonth.
DifferenceTemporalPlainYearMonth(s, operation, ym, other, options) ==
  LET o == ToTemporalYearMonthRecord(s, other, Undefined) IN IF IsAbrupt(o) THEN o
  ELSE IF Val(o).calendar # ym.calendar THEN ThrowError(o.s, "RangeError") ELSE
  LET opts == GetOptionsObject(o.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET settings == GetDifferenceSettings(opts.s, operation, Val(opts), "date", {TUWeek, TUDay}, TUMonth, TUYear) IN
  IF IsAbrupt(settings) THEN settings
  ELSE IF CompareISODate(ym.date, Val(o).date) = 0 THEN CreateTemporalDuration(settings.s, ZeroDurationFields, Empty) ELSE
  LET thisDate == YearMonthFirstDay(settings.s, ym.date) IN IF IsAbrupt(thisDate) THEN thisDate ELSE
  LET otherDate == YearMonthFirstDay(thisDate.s, Val(o).date) IN IF IsAbrupt(otherDate) THEN otherDate ELSE
  LET st == Val(settings)
      until == CalendarDateUntil(Val(thisDate), Val(otherDate), st.largestUnit)
      duration == CombineDateAndTimeDuration(<<until[1], until[2], TI(0), TI(0)>>, TI(0))
      from == [date |-> Val(thisDate), time |-> MidnightTimeRecord]
      rounded == IF st.smallestUnit = TUMonth /\ st.roundingIncrement = 1 THEN Ok(otherDate.s, duration)
                 ELSE RoundRelativeDuration(otherDate.s, duration, GetUTCEpochNanoseconds(from),
                                            GetUTCEpochNanoseconds([date |-> Val(otherDate), time |-> MidnightTimeRecord]), from, Empty,
                                            st.largestUnit, st.roundingIncrement, st.smallestUnit, st.roundingMode)
  IN IF IsAbrupt(rounded) THEN rounded
     ELSE CreateTemporalDuration(rounded.s, SinceFields(operation, DurationFieldsFromInternal(Val(rounded), TUDay)), Empty)
AddDurationToYearMonth(s, operation, ym, durationLike, options) ==
  LET d == ToTemporalDurationFields(s, durationLike) IN IF IsAbrupt(d) THEN d ELSE
  LET internal == ToInternalDurationRecord(IF operation = "subtract" THEN NegatedDurationFields(Val(d)) ELSE Val(d))
      opts == GetOptionsObject(d.s, options)
  IN IF IsAbrupt(opts) THEN opts ELSE
  LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow
  ELSE IF internal.date[3].mag # <<>> \/ internal.date[4].mag # <<>> \/ internal.time.mag # <<>> THEN ThrowError(overflow.s, "RangeError") ELSE
  LET date == YearMonthFirstDay(overflow.s, ym.date) IN IF IsAbrupt(date) THEN date ELSE
  LET added == CalendarDateAdd(date.s, Val(date), internal.date, Val(overflow)) IN IF IsAbrupt(added) THEN added ELSE
  LET result == CalendarYearMonthFromFields(added.s, ISODateToFields(Val(added), "year-month"), Val(overflow)) IN
  IF IsAbrupt(result) THEN result ELSE CreateTemporalYearMonth(result.s, Val(result), ym.calendar, Empty)
\* The getters of PlainYearMonth.
\* The with of PlainYearMonth and PlainMonthDay: the merged fields of a partial object.
MergedPartialFields(s, fields, item, names) ==
  LET isPartial == IsPartialTemporalObject(s, item) IN IF IsAbrupt(isPartial) THEN isPartial
  ELSE IF ~Val(isPartial) THEN ThrowTypeError(isPartial.s) ELSE
  LET partial == PrepareCalendarFields(isPartial.s, item, names, "partial") IN
  IF IsAbrupt(partial) THEN partial ELSE Ok(partial.s, CalendarMergeFields(fields, Val(partial)))
\* The toPlainDate of PlainYearMonth and PlainMonthDay: the date of the fields merged with the
\* named fields of an object.
MergedPlainDate(s, fields, item, names, calendar) ==
  IF ~IsObject(item) THEN ThrowTypeError(s) ELSE
  LET input == PrepareCalendarFields(s, item, names, "no-required-fields") IN IF IsAbrupt(input) THEN input ELSE
  LET date == CalendarDateFromFields(input.s, CalendarMergeFields(fields, Val(input)), N("constrain")) IN
  IF IsAbrupt(date) THEN date ELSE CreateTemporalDate(date.s, Val(date), calendar, Empty)
PlainYearMonthBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET year == SnapToInteger(s, Arg(args, 1), TRUE) IN IF IsAbrupt(year) THEN year ELSE
         LET month == SnapToInteger(year.s, Arg(args, 2), TRUE) IN IF IsAbrupt(month) THEN month ELSE
         LET calendarArg == IF Arg(args, 3) = Undefined THEN Str(ISO8601) ELSE Arg(args, 3) IN
         IF ~IsString(calendarArg) THEN ThrowTypeError(month.s) ELSE
         LET calendar == CanonicalizeCalendar(month.s, calendarArg.value) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET day == IF Arg(args, 4) = Undefined THEN Ok(calendar.s, TI(1)) ELSE SnapToInteger(calendar.s, Arg(args, 4), TRUE) IN
         IF IsAbrupt(day) THEN day
         ELSE IF ~TIYearInRange(Val(year)) THEN ThrowError(day.s, "RangeError") ELSE
         LET date == RegulateISODate(day.s, TIToInt(Val(year)), Val(month), Val(day), N("reject")) IN
         IF IsAbrupt(date) THEN date ELSE CreateTemporalYearMonth(date.s, Val(date), Val(calendar), nt)
    [] m = "from" ->
         LET r == ToTemporalYearMonthRecord(s, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(r) THEN r ELSE CreateTemporalYearMonth(r.s, Val(r).date, Val(r).calendar, Empty)
    [] m = "compare" ->
         LET x == ToTemporalYearMonthRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalYearMonthRecord(x.s, Arg(args, 2), Undefined) IN IF IsAbrupt(y) THEN y
         ELSE Ok(y.s, IntV(CompareISODate(Val(x).date, Val(y).date)))
    [] ~HasClass(s, this, "temporalYearMonth") -> ThrowTypeError(s)
    [] OTHER ->
         LET ym == O(s, this).slots IN
         CASE m \in YearMonthGetters -> CalendarDateGetter(s, ym.date, m)
           [] m = "calendarId" -> Ok(s, Str(ym.calendar))
           [] m = "with" ->
                LET fields == MergedPartialFields(s, ISODateToFields(ym.date, "year-month"), Arg(args, 1), YearMonthFieldNames) IN
                IF IsAbrupt(fields) THEN fields ELSE
                LET opts == GetOptionsObject(fields.s, Arg(args, 2)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
                LET date == CalendarYearMonthFromFields(overflow.s, Val(fields), Val(overflow)) IN
                IF IsAbrupt(date) THEN date ELSE CreateTemporalYearMonth(date.s, Val(date), ym.calendar, Empty)
           [] m \in {"add", "subtract"} -> AddDurationToYearMonth(s, m, ym, Arg(args, 1), Arg(args, 2))
           [] m \in {"until", "since"} -> DifferenceTemporalPlainYearMonth(s, m, ym, Arg(args, 1), Arg(args, 2))
           [] m = "equals" ->
                LET other == ToTemporalYearMonthRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(other) THEN other
                ELSE Ok(other.s, Bool(CompareISODate(ym.date, Val(other).date) = 0 /\ ym.calendar = Val(other).calendar))
           [] m = "toString" ->
                LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET show == GetTemporalShowCalendarNameOption(opts.s, Val(opts)) IN IF IsAbrupt(show) THEN show
                ELSE Ok(show.s, Str(TemporalYearMonthToString(ym, Val(show))))
           [] m \in {"toLocaleString", "toJSON"} -> Ok(s, Str(TemporalYearMonthToString(ym, N("auto"))))
           [] m = "valueOf" -> ThrowTypeError(s)
           [] m = "toPlainDate" -> MergedPlainDate(s, ISODateToFields(ym.date, "year-month"), Arg(args, 1), {"day"}, ym.calendar)
\* PlainMonthDay (Temporal §10). A Temporal.PlainMonthDay has class "temporalMonthDay" and slots
\* [date, calendar], with a reference year.
CreateTemporalMonthDay(s, date, calendar, newTarget) ==
  IF ~ISODateWithinLimits(date) THEN ThrowError(s, "RangeError")
  ELSE OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalPlainMonthDay") ELSE newTarget,
                                     "TemporalPlainMonthDayPrototype", "temporalMonthDay", [date |-> date, calendar |-> calendar])
\* ToTemporalMonthDay, as [date, calendar].
ToTemporalMonthDayRecord(s, item, options) ==
  IF IsObject(item) THEN
    IF O(s, item).class = "temporalMonthDay" THEN
      LET read == ReadOverflowOption(s, options) IN IF IsAbrupt(read) THEN read ELSE Ok(read.s, O(s, item).slots)
    ELSE LET calendar == GetTemporalCalendarIdentifierWithISODefault(s, item) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET fields == PrepareCalendarFields(calendar.s, item, DateFieldNames, "no-required-fields") IN IF IsAbrupt(fields) THEN fields ELSE
         LET opts == GetOptionsObject(fields.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
         LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
         LET date == CalendarMonthDayFromFields(overflow.s, Val(fields), Val(overflow)) IN
         IF IsAbrupt(date) THEN date ELSE Ok(date.s, [date |-> Val(date), calendar |-> Val(calendar)])
  ELSE IF ~IsString(item) THEN ThrowTypeError(s)
  ELSE LET parsed == ParseISODateTime(s, item.value, "month-day") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET r == Val(parsed)
           calendar == CanonicalizeCalendar(parsed.s, IF r.calendar = Empty THEN ISO8601 ELSE r.calendar)
       IN IF IsAbrupt(calendar) THEN calendar ELSE
       LET read == ReadOverflowOption(calendar.s, options) IN IF IsAbrupt(read) THEN read
       ELSE Ok(read.s, [date |-> [year |-> 1972, month |-> r.month, day |-> r.day], calendar |-> Val(calendar)])
PlainMonthDayBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s) ELSE
         LET month == SnapToInteger(s, Arg(args, 1), TRUE) IN IF IsAbrupt(month) THEN month ELSE
         LET day == SnapToInteger(month.s, Arg(args, 2), TRUE) IN IF IsAbrupt(day) THEN day ELSE
         LET calendarArg == IF Arg(args, 3) = Undefined THEN Str(ISO8601) ELSE Arg(args, 3) IN
         IF ~IsString(calendarArg) THEN ThrowTypeError(day.s) ELSE
         LET calendar == CanonicalizeCalendar(day.s, calendarArg.value) IN IF IsAbrupt(calendar) THEN calendar ELSE
         LET year == IF Arg(args, 4) = Undefined THEN Ok(calendar.s, TI(1972)) ELSE SnapToInteger(calendar.s, Arg(args, 4), TRUE) IN
         IF IsAbrupt(year) THEN year
         ELSE IF ~TIYearInRange(Val(year)) THEN ThrowError(year.s, "RangeError") ELSE
         LET date == RegulateISODate(year.s, TIToInt(Val(year)), Val(month), Val(day), N("reject")) IN
         IF IsAbrupt(date) THEN date ELSE CreateTemporalMonthDay(date.s, Val(date), Val(calendar), nt)
    [] m = "from" ->
         LET r == ToTemporalMonthDayRecord(s, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(r) THEN r ELSE CreateTemporalMonthDay(r.s, Val(r).date, Val(r).calendar, Empty)
    [] ~HasClass(s, this, "temporalMonthDay") -> ThrowTypeError(s)
    [] OTHER ->
         LET md == O(s, this).slots IN
         CASE m \in {"monthCode", "day"} -> CalendarDateGetter(s, md.date, m)
           [] m = "calendarId" -> Ok(s, Str(md.calendar))
           [] m = "with" ->
                LET fields == MergedPartialFields(s, ISODateToFields(md.date, "month-day"), Arg(args, 1), DateFieldNames) IN
                IF IsAbrupt(fields) THEN fields ELSE
                LET opts == GetOptionsObject(fields.s, Arg(args, 2)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
                LET date == CalendarMonthDayFromFields(overflow.s, Val(fields), Val(overflow)) IN
                IF IsAbrupt(date) THEN date ELSE CreateTemporalMonthDay(date.s, Val(date), md.calendar, Empty)
           [] m = "equals" ->
                LET other == ToTemporalMonthDayRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(other) THEN other
                ELSE Ok(other.s, Bool(CompareISODate(md.date, Val(other).date) = 0 /\ md.calendar = Val(other).calendar))
           [] m = "toString" ->
                LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET show == GetTemporalShowCalendarNameOption(opts.s, Val(opts)) IN IF IsAbrupt(show) THEN show
                ELSE Ok(show.s, Str(TemporalMonthDayToString(md, Val(show))))
           [] m \in {"toLocaleString", "toJSON"} -> Ok(s, Str(TemporalMonthDayToString(md, N("auto"))))
           [] m = "valueOf" -> ThrowTypeError(s)
           [] m = "toPlainDate" -> MergedPlainDate(s, ISODateToFields(md.date, "month-day"), Arg(args, 1), {"year"}, md.calendar)
\* Temporal.Now (Temporal §2). The system time zone is UTC, and the system time is the clock Date
\* reads, in milliseconds.
SystemUTCEpochNanoseconds(s) == TIMul(TI(s.clock), TI(1000000))
SystemDateTime(s, tzLike) ==
  LET tz == IF tzLike = Undefined THEN Ok(s, UTCTimeZone) ELSE ToTemporalTimeZoneIdentifier(s, tzLike) IN
  IF IsAbrupt(tz) THEN tz ELSE Ok(Tick(tz.s), GetISODateTimeFor(Val(tz), SystemUTCEpochNanoseconds(tz.s)))
TemporalNowBuiltin(s, f, m, this, args, nt) ==
  CASE m = "timeZoneId" -> Ok(s, Str(UTCTimeZone.id))
    [] m = "instant" -> CreateTemporalInstant(Tick(s), SystemUTCEpochNanoseconds(s), Empty)
    [] m = "zonedDateTimeISO" ->
         LET tz == IF Arg(args, 1) = Undefined THEN Ok(s, UTCTimeZone) ELSE ToTemporalTimeZoneIdentifier(s, Arg(args, 1)) IN
         IF IsAbrupt(tz) THEN tz ELSE CreateTemporalZonedDateTime(Tick(tz.s), SystemUTCEpochNanoseconds(tz.s), Val(tz), ISO8601, Empty)
    [] OTHER ->
         LET dt == SystemDateTime(s, Arg(args, 1)) IN
         IF IsAbrupt(dt) THEN dt
         ELSE CASE m = "plainDateTimeISO" -> CreateTemporalDateTime(dt.s, Val(dt), ISO8601, Empty)
                [] m = "plainDateISO" -> CreateTemporalDate(dt.s, Val(dt).date, ISO8601, Empty)
                [] m = "plainTimeISO" -> CreateTemporalTime(dt.s, Val(dt).time, Empty)
\* Temporal (Stage 3 proposal), as engine262 implements it: the ISO 8601 calendar only, and the
\* UTC and offset time zones only. Mathematical integers that can pass the 32-bit TLA+ integers
\* (durations, time durations, and epoch nanoseconds) are BigInt records (§6.1.6.2); calendar
\* fields, times of day, and rounding increments are TLA+ integers.
\* A Temporal.Duration has class "temporalDuration" and slots [fields], its ten fields as BigInts.
\* A Temporal.PlainTime has class "temporalTime" and slots [time], a time record.
\* Integer arithmetic on BigInt records.
TI(n) == BigIntFromInt(n)
TIAdd(a, b) == BigIntAdd(a, b)
TISub(a, b) == BigIntSub(a, b)
TIMul(a, b) == BigIntMul(a, b)
TINeg(a) == BigIntNeg(a)
TIAbs(a) == BigIntOf(FALSE, a.mag)
TISign(a) == IF a.mag = <<>> THEN 0 ELSE IF a.neg THEN -1 ELSE 1
TICompare(a, b) == IF a = b THEN 0 ELSE IF BigIntLess(a, b) THEN -1 ELSE 1
\* Floor division and modulo by a positive b.
TIFloorDiv(a, b) ==
  LET q == BigIntDiv(a, b) IN IF a.neg /\ BigIntRem(a, b).mag # <<>> THEN TISub(q, TI(1)) ELSE q
TIMod(a, b) == TISub(a, TIMul(TIFloorDiv(a, b), b))
TIToInt(a) == IF a.neg THEN -BNToInt(a.mag) ELSE BNToInt(a.mag)
\* ℝ(𝔽(a)): a rounded to a Number.
TIFloat(a) == IntegralNumberToBigInt(BigIntToNumber(a))
TIUnits(a) == BigIntToString(a, 10)
\* maxTimeDuration, 2^53 × 10^9 − 1.
IsTimeDuration(d) == ~BigIntLess(TIMaxTimeDuration, TIAbs(d))
\* The Temporal units (Table 21) as 1 (year) to 10 (nanosecond), so a smaller code is a larger
\* unit, with TUAuto for "auto" and TUNoUnit for an absent option.
IsDateUnit(u) == u >= TUYear /\ u <= TUDay
IsTimeUnit(u) == u >= TUHour /\ u <= TUNanosecond
IsCalendarUnit(u) == u >= TUYear /\ u <= TUWeek
LargerOfTwoTemporalUnits(x, y) == IF x < y THEN x ELSE y
\* TemporalUnitLength, in nanoseconds, of a time unit or day.
TemporalUnitLength(u) ==
  CASE u = TUDay -> TINsPerDay
    [] u = TUHour -> TINsPerHour
    [] u = TUMinute -> TINsPerMinute
    [] u = TUSecond -> TINsPerSecond
    [] u = TUMillisecond -> TI(1000000)
    [] u = TUMicrosecond -> TI(1000)
    [] OTHER -> TI(1)
\* MaximumTemporalDurationRoundingIncrement, with 0 for no maximum.
MaximumRoundingIncrement(u) ==
  CASE u = TUHour -> 24
    [] u \in {TUMinute, TUSecond} -> 60
    [] u >= TUMillisecond -> 1000
    [] OTHER -> 0
\* ValidateTemporalUnitValue, as a test: value is absent, one of extra, or a unit of the group.
IsValidUnitValue(value, group, extra) ==
  value = TUNoUnit \/ value \in extra \/
  (IsDateUnit(value) /\ group \in {"date", "datetime"}) \/ (IsTimeUnit(value) /\ group \in {"time", "datetime"})
\* ValidateTemporalRoundingIncrement, as a test, for a BigInt dividend.
IsValidRoundingIncrement(increment, dividend, inclusive) ==
  LET maximum == IF inclusive THEN dividend ELSE TISub(dividend, TI(1)) IN
  ~BigIntLess(maximum, TI(increment)) /\ BigIntRem(dividend, TI(increment)).mag = <<>>
\* GetOptionsObject: undefined gives a new object with a null prototype.
GetOptionsObject(s, options) ==
  CASE options = Undefined -> OrdinaryObjectCreate(s, Null)
    [] IsObject(options) -> Ok(s, options)
    [] OTHER -> ThrowTypeError(s)
\* A string-valued option (GetOption with a list of values): fallback when it is undefined, and
\* otherwise the units of its string, which must be one of allowed.
GetStringOption(s, options, key, allowed, fallback) ==
  LET value == Get(s, options, key) IN IF IsAbrupt(value) THEN value
  ELSE IF Val(value) = Undefined THEN Ok(value.s, fallback)
  ELSE LET str == ToStr(value.s, Val(value)) IN IF IsAbrupt(str) THEN str
  ELSE IF Val(str).value \in allowed THEN Ok(str.s, Val(str).value) ELSE ThrowError(str.s, "RangeError")
\* GetTemporalOverflowOption and GetRoundingModeOption.
GetTemporalOverflowOption(s, options) ==
  GetStringOption(s, options, SV("overflow"), {N("constrain"), N("reject")}, N("constrain"))
GetRoundingModeOption(s, options, fallback) == GetStringOption(s, options, SV("roundingMode"), RoundingModes, fallback)
\* SnapToInteger with "reject" or, when truncate, "truncate": the BigInt a finite integral Number
\* denotes, or a RangeError.
SnapToInteger(s, v, truncate) ==
  LET n == ToNumber(s, v) IN IF IsAbrupt(n) THEN n ELSE
  LET x == Val(n).value
      t == IF truncate THEN NumToIntegerOrInfinity(x) ELSE x
  IN IF ~NumIsFinite(x) \/ ~NumIsIntegral(t) THEN ThrowError(n.s, "RangeError") ELSE Ok(n.s, IntegralNumberToBigInt(t))
\* SnapToInteger on args[i] to args[n] in turn, with 0 for an undefined one.
SnapArgs(s, args, i, n, truncate, acc) ==
  IF i > n THEN Ok(s, acc)
  ELSE IF Arg(args, i) = Undefined THEN SnapArgs(s, args, i + 1, n, truncate, Append(acc, TI(0)))
  ELSE LET v == SnapToInteger(s, Arg(args, i), truncate) IN IF IsAbrupt(v) THEN v
  ELSE SnapArgs(v.s, args, i + 1, n, truncate, Append(acc, Val(v)))
\* GetRoundingIncrementOption: an integer from 1 to 10^9.
GetRoundingIncrementOption(s, options) ==
  LET value == Get(s, options, SV("roundingIncrement")) IN IF IsAbrupt(value) THEN value
  ELSE IF Val(value) = Undefined THEN Ok(value.s, 1)
  ELSE LET i == SnapToInteger(value.s, Val(value), TRUE) IN IF IsAbrupt(i) THEN i
  ELSE IF BigIntLess(Val(i), TI(1)) \/ BigIntLess(TI(1000000000), Val(i)) THEN ThrowError(i.s, "RangeError")
  ELSE Ok(i.s, TIToInt(Val(i)))
\* GetTemporalUnitValuedOption: a unit code, TUAuto, or TUNoUnit when the option is absent and
\* not required.
GetTemporalUnitValuedOption(s, options, key, required) ==
  LET value == Get(s, options, key) IN IF IsAbrupt(value) THEN value
  ELSE IF Val(value) = Undefined THEN IF required THEN ThrowError(value.s, "RangeError") ELSE Ok(value.s, TUNoUnit)
  ELSE LET str == ToStr(value.s, Val(value)) IN IF IsAbrupt(str) THEN str
  ELSE LET u == Val(str).value
           matches == {i \in 1..10 : TemporalUnitNames[i] = u \/ TemporalUnitPlurals[i] = u}
       IN IF u = N("auto") THEN Ok(str.s, TUAuto)
          ELSE IF matches = {} THEN ThrowError(str.s, "RangeError")
          ELSE Ok(str.s, CHOOSE i \in matches : TRUE)
\* The precisions of time strings: a number of digits, or these.
\* GetTemporalFractionalSecondDigitsOption: 0 to 9, or TPrecisionAuto.
GetTemporalFractionalSecondDigitsOption(s, options) ==
  LET value == Get(s, options, SV("fractionalSecondDigits")) IN IF IsAbrupt(value) THEN value
  ELSE IF Val(value) = Undefined THEN Ok(value.s, TPrecisionAuto)
  ELSE IF ~IsNumber(Val(value)) THEN
    LET str == ToStr(value.s, Val(value)) IN IF IsAbrupt(str) THEN str
    ELSE IF Val(str).value = N("auto") THEN Ok(str.s, TPrecisionAuto) ELSE ThrowError(str.s, "RangeError")
  ELSE LET x == Val(value).value IN
       IF ~NumIsFinite(x) THEN ThrowError(value.s, "RangeError")
       ELSE LET digits == MathFloor(x) IN
            IF NumLessThan(digits, NumFromInt(0)) \/ NumLessThan(NumFromInt(9), digits) THEN ThrowError(value.s, "RangeError")
            ELSE Ok(value.s, NumToInt(digits))
\* ToSecondsStringPrecisionRecord, as [precision, unit, increment].
ToSecondsStringPrecisionRecord(smallestUnit, digits) ==
  CASE smallestUnit = TUMinute -> [precision |-> TPrecisionMinute, unit |-> TUMinute, increment |-> 1]
    [] smallestUnit = TUSecond -> [precision |-> 0, unit |-> TUSecond, increment |-> 1]
    [] smallestUnit = TUMillisecond -> [precision |-> 3, unit |-> TUMillisecond, increment |-> 1]
    [] smallestUnit = TUMicrosecond -> [precision |-> 6, unit |-> TUMicrosecond, increment |-> 1]
    [] smallestUnit = TUNanosecond -> [precision |-> 9, unit |-> TUNanosecond, increment |-> 1]
    [] digits = TPrecisionAuto -> [precision |-> TPrecisionAuto, unit |-> TUNanosecond, increment |-> 1]
    [] digits = 0 -> [precision |-> 0, unit |-> TUSecond, increment |-> 1]
    [] digits <= 3 -> [precision |-> digits, unit |-> TUMillisecond, increment |-> 10 ^ (3 - digits)]
    [] digits <= 6 -> [precision |-> digits, unit |-> TUMicrosecond, increment |-> 10 ^ (6 - digits)]
    [] OTHER -> [precision |-> digits, unit |-> TUNanosecond, increment |-> 10 ^ (9 - digits)]
\* NegateRoundingMode and GetUnsignedRoundingMode.
NegateRoundingMode(mode) ==
  CASE mode = N("ceil") -> N("floor")
    [] mode = N("floor") -> N("ceil")
    [] mode = N("halfCeil") -> N("halfFloor")
    [] mode = N("halfFloor") -> N("halfCeil")
    [] OTHER -> mode
UnsignedRoundingMode(mode, negative) ==
  CASE mode = N("ceil") -> IF negative THEN "zero" ELSE "infinity"
    [] mode = N("floor") -> IF negative THEN "infinity" ELSE "zero"
    [] mode = N("expand") -> "infinity"
    [] mode = N("trunc") -> "zero"
    [] mode = N("halfCeil") -> IF negative THEN "half-zero" ELSE "half-infinity"
    [] mode = N("halfFloor") -> IF negative THEN "half-infinity" ELSE "half-zero"
    [] mode = N("halfExpand") -> "half-infinity"
    [] mode = N("halfTrunc") -> "half-zero"
    [] OTHER -> "half-even"
\* n / d rounded to an integer by a rounding mode, for BigInts n and d > 0: the quotient step of
\* RoundNumberToIncrement with ApplyUnsignedRoundingMode, exactly.
RoundQuotient(n, d, mode) ==
  LET lower == BigIntDiv(TIAbs(n), d)
      remainder == BigIntRem(TIAbs(n), d)
      upper == TIAdd(lower, TI(1))
      unsigned == UnsignedRoundingMode(mode, n.neg)
      half == TICompare(TIMul(remainder, TI(2)), d)
      rounded == CASE remainder.mag = <<>> -> lower
                   [] unsigned = "zero" -> lower
                   [] unsigned = "infinity" -> upper
                   [] half < 0 -> lower
                   [] half > 0 -> upper
                   [] unsigned = "half-zero" -> lower
                   [] unsigned = "half-infinity" -> upper
                   [] BNIsOdd(lower.mag) -> upper
                   [] OTHER -> lower
  IN IF n.neg THEN TINeg(rounded) ELSE rounded
\* RoundNumberToIncrement of the rational n / d, for an integer increment.
RoundRatioToIncrement(n, d, increment, mode) == TIMul(RoundQuotient(n, TIMul(d, TI(increment)), mode), TI(increment))
\* The Number nearest the rational n / d, for d > 0.
RatioToNumber(n, d) == IF n.mag = <<>> THEN PosZero ELSE RoundRatio(n.neg, n.mag, d.mag, 0)
\* Time records: [hour, minute, second, millisecond, microsecond, nanosecond] of TLA+ integers.
\* Operations that can overflow a day give [days, time], with days a BigInt.
TimeFields(t) == <<t.hour, t.minute, t.second, t.millisecond, t.microsecond, t.nanosecond>>
TimeFromFields(f) ==
  [hour |-> f[1], minute |-> f[2], second |-> f[3], millisecond |-> f[4], microsecond |-> f[5], nanosecond |-> f[6]]
SubSecondNanoseconds(t) == t.millisecond * 1000000 + t.microsecond * 1000 + t.nanosecond
\* The nanoseconds since midnight of a time record.
TimeNanoseconds(t) ==
  TIAdd(TIMul(TI((t.hour * 60 + t.minute) * 60 + t.second), TINsPerSecond), TI(SubSecondNanoseconds(t)))
\* BalanceTime of a number of nanoseconds since midnight, as [days, time].
BalanceTime(ns) ==
  LET rest == TIMod(ns, TINsPerDay)
      seconds == TIToInt(BigIntDiv(rest, TINsPerSecond))
      sub == TIToInt(BigIntRem(rest, TINsPerSecond))
  IN [days |-> TIFloorDiv(ns, TINsPerDay),
      time |-> [hour |-> seconds \div 3600, minute |-> (seconds \div 60) % 60, second |-> seconds % 60,
                millisecond |-> sub \div 1000000, microsecond |-> (sub \div 1000) % 1000, nanosecond |-> sub % 1000]]
\* RegulateTime for BigInt fields: "constrain" clamps them, and "reject" throws a RangeError for one
\* out of range, as CreateTimeRecord does.
IsValidTimeFields(f) == \A i \in 1..6 : ~f[i].neg /\ ~BigIntLess(TI(TimeLimits[i]), f[i])
RegulateTime(s, f, overflow) ==
  IF overflow = N("reject") /\ ~IsValidTimeFields(f) THEN ThrowError(s, "RangeError")
  ELSE Ok(s, TimeFromFields([i \in 1..6 |-> CASE f[i].neg -> 0
                                               [] BigIntLess(TI(TimeLimits[i]), f[i]) -> TimeLimits[i]
                                               [] OTHER -> TIToInt(f[i])]))
\* Compares integer sequences of equal length lexicographically.
CompareFieldsFrom(x, y, i) ==
  CASE i > Len(x) -> 0
    [] x[i] > y[i] -> 1
    [] x[i] < y[i] -> -1
    [] OTHER -> CompareFieldsFrom(x, y, i + 1)
CompareTimeRecord(x, y) == CompareFieldsFrom(TimeFields(x), TimeFields(y), 1)
\* DifferenceTime and AddTime.
DifferenceTime(from, to) == TISub(TimeNanoseconds(to), TimeNanoseconds(from))
AddTime(t, timeDuration) == BalanceTime(TIAdd(TimeNanoseconds(t), timeDuration))
\* RoundTime, as [days, time]. The quantity is the time's parts from unit down, which for a
\* balanced time is its nanoseconds modulo the next larger unit.
RoundTime(t, increment, unit, mode) ==
  LET total == TimeNanoseconds(t)
      quantity == IF unit <= TUHour THEN total ELSE TIMod(total, TemporalUnitLength(unit - 1))
  IN BalanceTime(TIAdd(TISub(total, quantity),
                      TIMul(RoundRatioToIncrement(quantity, TemporalUnitLength(unit), increment, mode), TemporalUnitLength(unit))))
\* RoundNumberToIncrement of an integer quantity.
RoundNumberToIncrement(quantity, increment, mode) == TIMul(RoundQuotient(quantity, increment, mode), increment)
\* FormatFractionalSeconds and FormatTimeString.
TrailingZerosStart(units, i) == IF i > 0 /\ units[i] = 48 THEN TrailingZerosStart(units, i - 1) ELSE i
FormatFractionalSeconds(sub, precision) ==
  LET digits == PadStart(IntUnits(sub), 9) IN
  CASE precision = TPrecisionAuto -> IF sub = 0 THEN <<>> ELSE <<46>> \o SubSeq(digits, 1, TrailingZerosStart(digits, 9))
    [] precision = 0 -> <<>>
    [] OTHER -> <<46>> \o SubSeq(digits, 1, precision)
FormatTimeString(hour, minute, second, sub, precision, separated) ==
  LET separator == IF separated THEN <<58>> ELSE <<>> IN
  TwoDigits(hour) \o separator \o TwoDigits(minute) \o
  (IF precision = TPrecisionMinute THEN <<>> ELSE separator \o TwoDigits(second) \o FormatFractionalSeconds(sub, precision))
TimeRecordToString(t, precision) ==
  FormatTimeString(t.hour, t.minute, t.second, SubSecondNanoseconds(t), precision, TRUE)
\* IsPartialTemporalObject.
IsPartialTemporalObject(s, v) ==
  IF ~IsObject(v) \/ O(s, v).class \in TemporalClasses THEN Ok(s, FALSE)
  ELSE LET calendar == Get(s, v, SV("calendar")) IN IF IsAbrupt(calendar) THEN calendar
  ELSE IF Val(calendar) # Undefined THEN Ok(calendar.s, FALSE)
  ELSE LET timeZone == Get(calendar.s, v, SV("timeZone")) IN IF IsAbrupt(timeZone) THEN timeZone
  ELSE Ok(timeZone.s, Val(timeZone) = Undefined)
\* An options argument that may be a string: a new object with a null prototype whose key is the
\* string, or GetOptionsObject (Temporal.Duration.prototype.round step 4 and its kin).
StringOrOptionsObject(s, options, key) ==
  IF options = Undefined THEN ThrowTypeError(s)
  ELSE IF IsString(options) THEN
    LET o == OrdinaryObjectCreate(s, Null) IN
    LET r == CreateDataPropertyOrThrow(o.s, Val(o), key, options) IN Ok(r.s, Val(o))
  ELSE GetOptionsObject(s, options)
\* GetDifferenceSettings, as [smallestUnit, largestUnit, roundingMode, roundingIncrement].
GetDifferenceSettings(s, operation, options, group, disallowed, fallbackSmallestUnit, smallestLargestDefaultUnit) ==
  LET largestOption == GetTemporalUnitValuedOption(s, options, SV("largestUnit"), FALSE) IN
  IF IsAbrupt(largestOption) THEN largestOption ELSE
  LET increment == GetRoundingIncrementOption(largestOption.s, options) IN IF IsAbrupt(increment) THEN increment ELSE
  LET mode == GetRoundingModeOption(increment.s, options, N("trunc")) IN IF IsAbrupt(mode) THEN mode ELSE
  LET smallestOption == GetTemporalUnitValuedOption(mode.s, options, SV("smallestUnit"), FALSE) IN
  IF IsAbrupt(smallestOption) THEN smallestOption ELSE
  LET s1 == smallestOption.s
      largest0 == IF Val(largestOption) = TUNoUnit THEN TUAuto ELSE Val(largestOption)
      smallest == IF Val(smallestOption) = TUNoUnit THEN fallbackSmallestUnit ELSE Val(smallestOption)
      largest == IF largest0 = TUAuto THEN LargerOfTwoTemporalUnits(smallestLargestDefaultUnit, smallest) ELSE largest0
      maximum == MaximumRoundingIncrement(smallest)
  IN IF ~IsValidUnitValue(Val(largestOption), group, {TUAuto}) \/ largest0 \in disallowed \/
        ~IsValidUnitValue(Val(smallestOption), group, {}) \/ smallest \in disallowed \/
        LargerOfTwoTemporalUnits(largest, smallest) # largest \/
        (maximum # 0 /\ ~IsValidRoundingIncrement(Val(increment), TI(maximum), FALSE))
     THEN ThrowError(s1, "RangeError")
     ELSE Ok(s1, [smallestUnit |-> smallest, largestUnit |-> largest, roundingIncrement |-> Val(increment),
                  roundingMode |-> IF operation = "since" THEN NegateRoundingMode(Val(mode)) ELSE Val(mode)])
\* Durations (Temporal §7). Their fields are years, months, weeks, days, hours, minutes, seconds,
\* milliseconds, microseconds, and nanoseconds, in that order.
DurationFieldsOf(s, v) == O(s, v).slots.fields
\* DurationSign and DefaultTemporalLargestUnit.
FirstNonzeroFrom(f, i) == IF i > Len(f) \/ f[i].mag # <<>> THEN i ELSE FirstNonzeroFrom(f, i + 1)
DurationSign(f) == LET i == FirstNonzeroFrom(f, 1) IN IF i > Len(f) THEN 0 ELSE TISign(f[i])
DefaultTemporalLargestUnit(f) == LET i == FirstNonzeroFrom(f, 1) IN IF i > 10 THEN TUNanosecond ELSE i
\* TimeDurationFromComponents, without its range check.
TimeDurationOf(hours, minutes, seconds, ms, us, ns) ==
  TIAdd(TIAdd(TIMul(TIAdd(TIMul(TIAdd(TIMul(hours, TI(60)), minutes), TI(60)), seconds), TINsPerSecond),
              TIMul(ms, TI(1000000))),
        TIAdd(TIMul(us, TI(1000)), ns))
\* IsValidDuration.
IsValidDuration(f) ==
  LET signs == {TISign(f[i]) : i \in 1..10} IN
  ~({-1, 1} \subseteq signs) /\ \A i \in 1..3 : BigIntLess(TIAbs(f[i]), TwoPow32) /\
  IsTimeDuration(TIAdd(TIMul(f[4], TINsPerDay),
                       TimeDurationOf(f[5], f[6], f[7], TIFloat(f[8]), TIFloat(f[9]), TIFloat(f[10]))))
\* CreateTemporalDuration, with Empty for no newTarget.
CreateTemporalDuration(s, f, newTarget) ==
  IF ~IsValidDuration(f) THEN ThrowError(s, "RangeError")
  ELSE OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalDuration") ELSE newTarget,
                                     "TemporalDurationPrototype", "temporalDuration",
                                     [fields |-> [i \in 1..10 |-> TIFloat(f[i])]])
NegatedDurationFields(f) == [i \in 1..10 |-> TINeg(f[i])]
\* Internal duration records [date, time]: the first four fields, and a time duration.
ToInternalDurationRecord(f) == [date |-> SubSeq(f, 1, 4), time |-> TimeDurationOf(f[5], f[6], f[7], f[8], f[9], f[10])]
ToInternalDurationRecordWith24HourDays(f) ==
  [date |-> <<f[1], f[2], f[3], TI(0)>>,
   time |-> TIAdd(TimeDurationOf(f[5], f[6], f[7], f[8], f[9], f[10]), TIMul(f[4], TINsPerDay))]
CombineDateAndTimeDuration(date, time) == [date |-> date, time |-> time]
IsValidDateDuration(date) == IsValidDuration(date \o <<TI(0), TI(0), TI(0), TI(0), TI(0), TI(0)>>)
\* The fields TemporalDurationFromInternal gives: the time duration spread over largestUnit (day
\* for a date unit) and the smaller units.
DurationFieldsFromInternal(internal, largestUnit) ==
  LET sign == TI(TISign(internal.time))
      ns == TIAbs(internal.time)
      first == IF largestUnit <= TUDay THEN TUDay ELSE largestUnit
      part(u) == CASE u < first -> TI(0)
                   [] u = first -> BigIntDiv(ns, TemporalUnitLength(u))
                   [] OTHER -> BigIntDiv(TIMod(ns, TemporalUnitLength(u - 1)), TemporalUnitLength(u))
  IN <<internal.date[1], internal.date[2], internal.date[3], TIAdd(internal.date[4], TIMul(part(TUDay), sign))>> \o
     [i \in 1..6 |-> TIMul(part(TUDay + i), sign)]
TemporalDurationFromInternal(s, internal, largestUnit) ==
  CreateTemporalDuration(s, DurationFieldsFromInternal(internal, largestUnit), Empty)
\* RoundTimeDurationToIncrement and RoundTimeDuration.
RoundTimeDurationToIncrement(s, d, increment, mode) ==
  LET rounded == RoundNumberToIncrement(d, increment, mode) IN
  IF IsTimeDuration(rounded) THEN Ok(s, rounded) ELSE ThrowError(s, "RangeError")
RoundTimeDuration(s, d, increment, unit, mode) ==
  RoundTimeDurationToIncrement(s, d, TIMul(TemporalUnitLength(unit), TI(increment)), mode)
\* ToPartialDurationRecord: the fields, with Empty for an undefined one, read in alphabetical order.
PartialDurationFrom(s, item, order, acc) ==
  IF order = <<>> THEN IF \A i \in 1..10 : acc[i] = Empty THEN ThrowTypeError(s) ELSE Ok(s, acc)
  ELSE LET i == Head(order)
           v == Get(s, item, DurationFieldKeys[i])
       IN IF IsAbrupt(v) THEN v
          ELSE IF Val(v) = Undefined THEN PartialDurationFrom(v.s, item, Tail(order), acc)
          ELSE LET n == SnapToInteger(v.s, Val(v), FALSE) IN IF IsAbrupt(n) THEN n
          ELSE PartialDurationFrom(n.s, item, Tail(order), [acc EXCEPT ![i] = Val(n)])
ToPartialDurationRecord(s, item) ==
  IF ~IsObject(item) THEN ThrowTypeError(s) ELSE PartialDurationFrom(s, item, DurationFieldOrder, [i \in 1..10 |-> Empty])
\* ToTemporalDuration, as the fields of the duration, checked as CreateTemporalDuration does.
ToTemporalDurationFields(s, item) ==
  LET f == IF IsObject(item) /\ O(s, item).class = "temporalDuration" THEN Ok(s, DurationFieldsOf(s, item))
           ELSE IF IsString(item) THEN ParseTemporalDurationString(s, item.value)
           ELSE IF ~IsObject(item) THEN ThrowTypeError(s)
           ELSE LET partial == ToPartialDurationRecord(s, item) IN IF IsAbrupt(partial) THEN partial
                ELSE Ok(partial.s, [i \in 1..10 |-> IF Val(partial)[i] = Empty THEN TI(0) ELSE Val(partial)[i]])
  IN IF IsAbrupt(f) THEN f ELSE IF IsValidDuration(Val(f)) THEN Ok(f.s, [i \in 1..10 |-> TIFloat(Val(f)[i])])
     ELSE ThrowError(f.s, "RangeError")
\* TemporalDurationToString.
DurationPart(f, i) == IF f[i].mag = <<>> THEN <<>> ELSE TIUnits(TIAbs(f[i])) \o <<DurationDesignators[i]>>
TemporalDurationToString(f, precision) ==
  LET datePart == DurationPart(f, 1) \o DurationPart(f, 2) \o DurationPart(f, 3) \o DurationPart(f, 4)
      secondsDuration == TimeDurationOf(TI(0), TI(0), f[7], f[8], f[9], f[10])
      timePart == DurationPart(f, 5) \o DurationPart(f, 6) \o
                  (IF secondsDuration.mag # <<>> \/ DefaultTemporalLargestUnit(f) >= TUSecond \/ precision # TPrecisionAuto
                   THEN TIUnits(BigIntDiv(TIAbs(secondsDuration), TINsPerSecond)) \o
                        FormatFractionalSeconds(TIToInt(BigIntRem(TIAbs(secondsDuration), TINsPerSecond)), precision) \o <<83>>
                   ELSE <<>>)
  IN (IF DurationSign(f) < 0 THEN <<45>> ELSE <<>>) \o <<80>> \o datePart \o
     (IF timePart = <<>> THEN <<>> ELSE <<84>> \o timePart)
\* AddDurations, as the fields of the sum.
AddDurations(s, operation, f, other) ==
  LET o == ToTemporalDurationFields(s, other) IN IF IsAbrupt(o) THEN o ELSE
  LET y == IF operation = "subtract" THEN NegatedDurationFields(Val(o)) ELSE Val(o)
      largest == LargerOfTwoTemporalUnits(DefaultTemporalLargestUnit(f), DefaultTemporalLargestUnit(y))
      time == TIAdd(ToInternalDurationRecordWith24HourDays(f).time, ToInternalDurationRecordWith24HourDays(y).time)
  IN IF IsCalendarUnit(largest) \/ ~IsTimeDuration(time) THEN ThrowError(o.s, "RangeError")
     ELSE TemporalDurationFromInternal(o.s, CombineDateAndTimeDuration(ZeroDateDuration, time), largest)
\* PlainTime (Temporal §4).
CreateTemporalTime(s, t, newTarget) ==
  OrdinaryCreateFromConstructor(s, IF newTarget = Empty THEN Intrinsic(s, "TemporalPlainTime") ELSE newTarget,
                                "TemporalPlainTimePrototype", "temporalTime", [time |-> t])
\* ToPartialTimeRecord: hour, minute, second, millisecond, microsecond, and nanosecond as BigInts,
\* read in alphabetical order, with 0 (when complete) or Empty for an undefined one.
PartialTimeFrom(s, item, order, acc, isAny) ==
  IF order = <<>> THEN IF isAny THEN Ok(s, acc) ELSE ThrowTypeError(s)
  ELSE LET i == Head(order)
           v == Get(s, item, TimeFieldKeys[i])
       IN IF IsAbrupt(v) THEN v
          ELSE IF Val(v) = Undefined THEN PartialTimeFrom(v.s, item, Tail(order), acc, isAny)
          ELSE LET n == SnapToInteger(v.s, Val(v), TRUE) IN IF IsAbrupt(n) THEN n
          ELSE PartialTimeFrom(n.s, item, Tail(order), [acc EXCEPT ![i] = Val(n)], TRUE)
ToPartialTimeRecord(s, item, complete) ==
  PartialTimeFrom(s, item, <<1, 5, 4, 2, 6, 3>>, [i \in 1..6 |-> IF complete THEN TI(0) ELSE Empty], FALSE)
\* The time of day of a Temporal object that has one.
TemporalTimeOfObject(s, v) ==
  LET o == O(s, v) IN
  CASE o.class = "temporalTime" -> o.slots.time
    [] o.class = "temporalDateTime" -> o.slots.dateTime.time
    [] o.class = "temporalZonedDateTime" -> ZonedDateTimeISODateTime(s, v).time
\* ToTemporalTime, as the time record.
ToTemporalTimeRecord(s, item, options) ==
  IF IsObject(item) THEN
    IF O(s, item).class \in {"temporalTime", "temporalDateTime", "temporalZonedDateTime"} THEN
      LET opts == GetOptionsObject(s, options) IN IF IsAbrupt(opts) THEN opts ELSE
      LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow
      ELSE Ok(overflow.s, TemporalTimeOfObject(s, item))
    ELSE LET partial == ToPartialTimeRecord(s, item, TRUE) IN IF IsAbrupt(partial) THEN partial ELSE
         LET opts == GetOptionsObject(partial.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
         LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow
         ELSE RegulateTime(overflow.s, Val(partial), Val(overflow))
  ELSE IF ~IsString(item) THEN ThrowTypeError(s)
  ELSE LET parsed == ParseISODateTime(s, item.value, "time") IN IF IsAbrupt(parsed) THEN parsed ELSE
       LET opts == GetOptionsObject(parsed.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
       LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow
       ELSE Ok(overflow.s, Val(parsed).time)
\* DifferenceTemporalPlainTime.
DifferenceTemporalPlainTime(s, operation, t, other, options) ==
  LET o == ToTemporalTimeRecord(s, other, Undefined) IN IF IsAbrupt(o) THEN o ELSE
  LET opts == GetOptionsObject(o.s, options) IN IF IsAbrupt(opts) THEN opts ELSE
  LET settings == GetDifferenceSettings(opts.s, operation, Val(opts), "time", {}, TUNanosecond, TUHour) IN
  IF IsAbrupt(settings) THEN settings ELSE
  LET st == Val(settings)
      rounded == RoundTimeDuration(settings.s, DifferenceTime(t, Val(o)), st.roundingIncrement, st.smallestUnit, st.roundingMode)
      f == DurationFieldsFromInternal(CombineDateAndTimeDuration(ZeroDateDuration, Val(rounded)), st.largestUnit)
  IN CreateTemporalDuration(rounded.s, IF operation = "since" THEN NegatedDurationFields(f) ELSE f, Empty)
PlainTimeBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE LET fields == SnapArgs(s, args, 1, 6, TRUE, <<>>) IN IF IsAbrupt(fields) THEN fields ELSE
              LET t == RegulateTime(fields.s, Val(fields), N("reject")) IN IF IsAbrupt(t) THEN t
              ELSE CreateTemporalTime(t.s, Val(t), nt)
    [] m = "from" ->
         LET t == ToTemporalTimeRecord(s, Arg(args, 1), Arg(args, 2)) IN
         IF IsAbrupt(t) THEN t ELSE CreateTemporalTime(t.s, Val(t), Empty)
    [] m = "compare" ->
         LET x == ToTemporalTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalTimeRecord(x.s, Arg(args, 2), Undefined) IN IF IsAbrupt(y) THEN y
         ELSE Ok(y.s, IntV(CompareTimeRecord(Val(x), Val(y))))
    [] ~HasClass(s, this, "temporalTime") -> ThrowTypeError(s)
    [] OTHER ->
         LET t == O(s, this).slots.time IN
         CASE m = "hour" -> Ok(s, IntV(t.hour))
           [] m = "minute" -> Ok(s, IntV(t.minute))
           [] m = "second" -> Ok(s, IntV(t.second))
           [] m = "millisecond" -> Ok(s, IntV(t.millisecond))
           [] m = "microsecond" -> Ok(s, IntV(t.microsecond))
           [] m = "nanosecond" -> Ok(s, IntV(t.nanosecond))
           [] m \in {"add", "subtract"} ->
                LET d == ToTemporalDurationFields(s, Arg(args, 1)) IN IF IsAbrupt(d) THEN d ELSE
                LET duration == IF m = "subtract" THEN NegatedDurationFields(Val(d)) ELSE Val(d) IN
                CreateTemporalTime(d.s, AddTime(t, ToInternalDurationRecord(duration).time).time, Empty)
           [] m = "with" ->
                LET isPartial == IsPartialTemporalObject(s, Arg(args, 1)) IN IF IsAbrupt(isPartial) THEN isPartial
                ELSE IF ~Val(isPartial) THEN ThrowTypeError(isPartial.s) ELSE
                LET partial == ToPartialTimeRecord(isPartial.s, Arg(args, 1), FALSE) IN IF IsAbrupt(partial) THEN partial ELSE
                LET opts == GetOptionsObject(partial.s, Arg(args, 2)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET overflow == GetTemporalOverflowOption(opts.s, Val(opts)) IN IF IsAbrupt(overflow) THEN overflow ELSE
                LET fields == [i \in 1..6 |-> IF Val(partial)[i] = Empty THEN TI(TimeFields(t)[i]) ELSE Val(partial)[i]]
                    r == RegulateTime(overflow.s, fields, Val(overflow))
                IN IF IsAbrupt(r) THEN r ELSE CreateTemporalTime(r.s, Val(r), Empty)
           [] m \in {"until", "since"} -> DifferenceTemporalPlainTime(s, m, t, Arg(args, 1), Arg(args, 2))
           [] m = "round" ->
                LET roundTo == StringOrOptionsObject(s, Arg(args, 1), SV("smallestUnit")) IN IF IsAbrupt(roundTo) THEN roundTo ELSE
                LET increment == GetRoundingIncrementOption(roundTo.s, Val(roundTo)) IN IF IsAbrupt(increment) THEN increment ELSE
                LET mode == GetRoundingModeOption(increment.s, Val(roundTo), N("halfExpand")) IN IF IsAbrupt(mode) THEN mode ELSE
                LET unit == GetTemporalUnitValuedOption(mode.s, Val(roundTo), SV("smallestUnit"), TRUE) IN IF IsAbrupt(unit) THEN unit
                ELSE IF ~IsValidUnitValue(Val(unit), "time", {}) \/
                        ~IsValidRoundingIncrement(Val(increment), TI(MaximumRoundingIncrement(Val(unit))), FALSE)
                THEN ThrowError(unit.s, "RangeError")
                ELSE CreateTemporalTime(unit.s, RoundTime(t, Val(increment), Val(unit), Val(mode)).time, Empty)
           [] m = "equals" ->
                LET other == ToTemporalTimeRecord(s, Arg(args, 1), Undefined) IN IF IsAbrupt(other) THEN other
                ELSE Ok(other.s, Bool(CompareTimeRecord(t, Val(other)) = 0))
           [] m = "toString" ->
                LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                LET digits == GetTemporalFractionalSecondDigitsOption(opts.s, Val(opts)) IN IF IsAbrupt(digits) THEN digits ELSE
                LET mode == GetRoundingModeOption(digits.s, Val(opts), N("trunc")) IN IF IsAbrupt(mode) THEN mode ELSE
                LET unit == GetTemporalUnitValuedOption(mode.s, Val(opts), SV("smallestUnit"), FALSE) IN IF IsAbrupt(unit) THEN unit
                ELSE IF ~IsValidUnitValue(Val(unit), "time", {}) \/ Val(unit) = TUHour THEN ThrowError(unit.s, "RangeError")
                ELSE LET precision == ToSecondsStringPrecisionRecord(Val(unit), Val(digits)) IN
                     Ok(unit.s, Str(TimeRecordToString(RoundTime(t, precision.increment, precision.unit, Val(mode)).time,
                                                       precision.precision)))
           [] m \in {"toLocaleString", "toJSON"} -> Ok(s, Str(TimeRecordToString(t, TPrecisionAuto)))
           [] m = "valueOf" -> ThrowTypeError(s)
\* The relativeTo option of Temporal.Duration's round, total, and compare, as [plain, zoned]:
\* a PlainDate or a ZonedDateTime object, or Empty.
DurationBuiltin(s, f, m, this, args, nt) ==
  CASE m = "constructor" ->
         IF nt = Undefined THEN ThrowTypeError(s)
         ELSE LET fields == SnapArgs(s, args, 1, 10, FALSE, <<>>) IN
              IF IsAbrupt(fields) THEN fields ELSE CreateTemporalDuration(fields.s, Val(fields), nt)
    [] m = "from" ->
         LET d == ToTemporalDurationFields(s, Arg(args, 1)) IN IF IsAbrupt(d) THEN d ELSE CreateTemporalDuration(d.s, Val(d), Empty)
    [] m = "compare" ->
         LET x == ToTemporalDurationFields(s, Arg(args, 1)) IN IF IsAbrupt(x) THEN x ELSE
         LET y == ToTemporalDurationFields(x.s, Arg(args, 2)) IN IF IsAbrupt(y) THEN y ELSE
         LET opts == GetOptionsObject(y.s, Arg(args, 3)) IN IF IsAbrupt(opts) THEN opts ELSE
         LET relativeTo == GetTemporalRelativeToOption(opts.s, Val(opts)) IN IF IsAbrupt(relativeTo) THEN relativeTo
         ELSE IF Val(x) = Val(y) THEN Ok(relativeTo.s, IntV(0))
         ELSE CompareDurations(relativeTo.s, Val(x), Val(y), Val(relativeTo))
    [] ~HasClass(s, this, "temporalDuration") -> ThrowTypeError(s)
    [] OTHER ->
         LET d == DurationFieldsOf(s, this)
             fieldIndex == CASE m = "years" -> 1 [] m = "months" -> 2 [] m = "weeks" -> 3 [] m = "days" -> 4
                             [] m = "hours" -> 5 [] m = "minutes" -> 6 [] m = "seconds" -> 7 [] m = "milliseconds" -> 8
                             [] m = "microseconds" -> 9 [] m = "nanoseconds" -> 10 [] OTHER -> 0
         IN CASE fieldIndex # 0 -> Ok(s, Num(BigIntToNumber(d[fieldIndex])))
              [] m = "sign" -> Ok(s, IntV(DurationSign(d)))
              [] m = "blank" -> Ok(s, Bool(DurationSign(d) = 0))
              [] m = "with" ->
                   LET partial == ToPartialDurationRecord(s, Arg(args, 1)) IN IF IsAbrupt(partial) THEN partial
                   ELSE CreateTemporalDuration(partial.s, [i \in 1..10 |-> IF Val(partial)[i] = Empty THEN d[i] ELSE Val(partial)[i]], Empty)
              [] m = "negated" -> CreateTemporalDuration(s, NegatedDurationFields(d), Empty)
              [] m = "abs" -> CreateTemporalDuration(s, [i \in 1..10 |-> TIAbs(d[i])], Empty)
              [] m \in {"add", "subtract"} -> AddDurations(s, m, d, Arg(args, 1))
              [] m = "round" -> DurationRound(s, d, Arg(args, 1))
              [] m = "total" -> DurationTotal(s, d, Arg(args, 1))
              [] m = "toString" ->
                   LET opts == GetOptionsObject(s, Arg(args, 1)) IN IF IsAbrupt(opts) THEN opts ELSE
                   LET digits == GetTemporalFractionalSecondDigitsOption(opts.s, Val(opts)) IN IF IsAbrupt(digits) THEN digits ELSE
                   LET mode == GetRoundingModeOption(digits.s, Val(opts), N("trunc")) IN IF IsAbrupt(mode) THEN mode ELSE
                   LET unit == GetTemporalUnitValuedOption(mode.s, Val(opts), SV("smallestUnit"), FALSE) IN IF IsAbrupt(unit) THEN unit
                   ELSE IF ~IsValidUnitValue(Val(unit), "time", {}) \/ Val(unit) \in {TUHour, TUMinute} THEN ThrowError(unit.s, "RangeError")
                   ELSE LET precision == ToSecondsStringPrecisionRecord(Val(unit), Val(digits)) IN
                        IF precision.unit = TUNanosecond /\ precision.increment = 1 THEN Ok(unit.s, Str(TemporalDurationToString(d, precision.precision)))
                        ELSE LET internal == ToInternalDurationRecord(d)
                                 time == RoundTimeDuration(unit.s, internal.time, precision.increment, precision.unit, Val(mode))
                             IN IF IsAbrupt(time) THEN time ELSE
                             LET rounded == DurationFieldsFromInternal(CombineDateAndTimeDuration(internal.date, Val(time)),
                                                                       LargerOfTwoTemporalUnits(DefaultTemporalLargestUnit(d), TUSecond))
                             IN IF ~IsValidDuration(rounded) THEN ThrowError(time.s, "RangeError")
                                ELSE Ok(time.s, Str(TemporalDurationToString([i \in 1..10 |-> TIFloat(rounded[i])], precision.precision)))
              [] m \in {"toJSON", "toLocaleString"} -> Ok(s, Str(TemporalDurationToString(d, TPrecisionAuto)))
              [] m = "valueOf" -> ThrowTypeError(s)
\* Temporal.Duration.compare after its fields differ (steps 6 to 13).
CompareDurations(s, x, y, relativeTo) ==
  LET xLargest == DefaultTemporalLargestUnit(x)
      yLargest == DefaultTemporalLargestUnit(y)
      xInternal == ToInternalDurationRecord(x)
      yInternal == ToInternalDurationRecord(y)
  IN IF relativeTo.zoned # Empty /\ (IsDateUnit(xLargest) \/ IsDateUnit(yLargest)) THEN
       LET z == relativeTo.zoned
           xAfter == AddZonedDateTime(s, z.epochNs, z.timeZone, xInternal, N("constrain")) IN
       IF IsAbrupt(xAfter) THEN xAfter ELSE
       LET yAfter == AddZonedDateTime(xAfter.s, z.epochNs, z.timeZone, yInternal, N("constrain")) IN
       IF IsAbrupt(yAfter) THEN yAfter ELSE Ok(yAfter.s, IntV(TICompare(Val(xAfter), Val(yAfter))))
     ELSE LET isCalendar == IsCalendarUnit(xLargest) \/ IsCalendarUnit(yLargest) IN
       IF isCalendar /\ relativeTo.plain = Empty THEN ThrowError(s, "RangeError") ELSE
       LET xDays == IF isCalendar THEN DateDurationDays(s, xInternal.date, relativeTo.plain) ELSE Ok(s, x[4]) IN
       IF IsAbrupt(xDays) THEN xDays ELSE
       LET yDays == IF isCalendar THEN DateDurationDays(xDays.s, yInternal.date, relativeTo.plain) ELSE Ok(xDays.s, y[4]) IN
       IF IsAbrupt(yDays) THEN yDays ELSE
       LET xTime == TIAdd(xInternal.time, TIMul(Val(xDays), TINsPerDay))
           yTime == TIAdd(yInternal.time, TIMul(Val(yDays), TINsPerDay))
       IN IF ~IsTimeDuration(xTime) \/ ~IsTimeDuration(yTime) THEN ThrowError(yDays.s, "RangeError")
          ELSE Ok(yDays.s, IntV(TICompare(xTime, yTime)))
\* Temporal.Duration.prototype.round.
DurationRound(s, d, roundToArg) ==
  LET roundTo == StringOrOptionsObject(s, roundToArg, SV("smallestUnit")) IN IF IsAbrupt(roundTo) THEN roundTo ELSE
  LET largestOption == GetTemporalUnitValuedOption(roundTo.s, Val(roundTo), SV("largestUnit"), FALSE) IN
  IF IsAbrupt(largestOption) THEN largestOption ELSE
  LET relativeTo == GetTemporalRelativeToOption(largestOption.s, Val(roundTo)) IN IF IsAbrupt(relativeTo) THEN relativeTo ELSE
  LET increment == GetRoundingIncrementOption(relativeTo.s, Val(roundTo)) IN IF IsAbrupt(increment) THEN increment ELSE
  LET mode == GetRoundingModeOption(increment.s, Val(roundTo), N("halfExpand")) IN IF IsAbrupt(mode) THEN mode ELSE
  LET smallestOption == GetTemporalUnitValuedOption(mode.s, Val(roundTo), SV("smallestUnit"), FALSE) IN
  IF IsAbrupt(smallestOption) THEN smallestOption ELSE
  LET s1 == smallestOption.s
      smallest == IF Val(smallestOption) = TUNoUnit THEN TUNanosecond ELSE Val(smallestOption)
      existingLargest == DefaultTemporalLargestUnit(d)
      defaultLargest == LargerOfTwoTemporalUnits(existingLargest, smallest)
      largest == IF Val(largestOption) \in {TUNoUnit, TUAuto} THEN defaultLargest ELSE Val(largestOption)
      maximum == MaximumRoundingIncrement(smallest)
      inc == Val(increment)
      rm == Val(mode)
      rel == Val(relativeTo)
  IN IF Val(smallestOption) = TUAuto \/ (Val(smallestOption) = TUNoUnit /\ Val(largestOption) = TUNoUnit) \/
        LargerOfTwoTemporalUnits(largest, smallest) # largest \/
        (maximum # 0 /\ ~IsValidRoundingIncrement(inc, TI(maximum), FALSE)) \/
        (inc > 1 /\ largest # smallest /\ IsDateUnit(smallest))
     THEN ThrowError(s1, "RangeError")
     ELSE IF rel.zoned # Empty THEN
       LET z == rel.zoned
           internal == ToInternalDurationRecord(d)
           target == AddZonedDateTime(s1, z.epochNs, z.timeZone, internal, N("constrain"))
       IN IF IsAbrupt(target) THEN target ELSE
       LET r == DifferenceZonedDateTimeWithRounding(target.s, z.epochNs, Val(target), z.timeZone,
                                                    largest, inc, smallest, rm)
       IN IF IsAbrupt(r) THEN r ELSE TemporalDurationFromInternal(r.s, Val(r), IF IsDateUnit(largest) THEN TUHour ELSE largest)
     ELSE IF rel.plain # Empty THEN
       LET target == RelativePlainTarget(s1, d, rel.plain) IN IF IsAbrupt(target) THEN target ELSE
       LET r == DifferencePlainDateTimeWithRounding(target.s, Val(target).from, Val(target).to, largest, inc, smallest, rm)
       IN IF IsAbrupt(r) THEN r ELSE TemporalDurationFromInternal(r.s, Val(r), largest)
     ELSE IF IsCalendarUnit(existingLargest) \/ IsCalendarUnit(largest) THEN ThrowError(s1, "RangeError")
     ELSE LET internal == ToInternalDurationRecordWith24HourDays(d) IN
       IF smallest = TUDay THEN
         LET days == RoundRatioToIncrement(internal.time, TINsPerDay, inc, rm)
             date == <<TI(0), TI(0), TI(0), days>>
         IN IF ~IsValidDateDuration(date) THEN ThrowError(s1, "RangeError")
            ELSE TemporalDurationFromInternal(s1, CombineDateAndTimeDuration(date, TI(0)), largest)
       ELSE LET time == RoundTimeDuration(s1, internal.time, inc, smallest, rm) IN IF IsAbrupt(time) THEN time
            ELSE TemporalDurationFromInternal(time.s, CombineDateAndTimeDuration(ZeroDateDuration, Val(time)), largest)
\* Temporal.Duration.prototype.total.
DurationTotal(s, d, totalOfArg) ==
  LET totalOf == StringOrOptionsObject(s, totalOfArg, SV("unit")) IN IF IsAbrupt(totalOf) THEN totalOf ELSE
  LET relativeTo == GetTemporalRelativeToOption(totalOf.s, Val(totalOf)) IN IF IsAbrupt(relativeTo) THEN relativeTo ELSE
  LET unitOption == GetTemporalUnitValuedOption(relativeTo.s, Val(totalOf), SV("unit"), TRUE) IN
  IF IsAbrupt(unitOption) THEN unitOption ELSE
  LET s1 == unitOption.s
      unit == Val(unitOption)
      rel == Val(relativeTo)
      total == IF unit = TUAuto THEN ThrowError(s1, "RangeError")
               ELSE IF rel.zoned # Empty THEN
                 LET z == rel.zoned
                     target == AddZonedDateTime(s1, z.epochNs, z.timeZone, ToInternalDurationRecord(d), N("constrain"))
                 IN IF IsAbrupt(target) THEN target
                    ELSE DifferenceZonedDateTimeWithTotal(target.s, z.epochNs, Val(target), z.timeZone, unit)
               ELSE IF rel.plain # Empty THEN
                 LET target == RelativePlainTarget(s1, d, rel.plain) IN IF IsAbrupt(target) THEN target
                 ELSE DifferencePlainDateTimeWithTotal(target.s, Val(target).from, Val(target).to, unit)
               ELSE IF IsCalendarUnit(DefaultTemporalLargestUnit(d)) \/ IsCalendarUnit(unit) THEN ThrowError(s1, "RangeError")
               ELSE Ok(s1, RatioToNumber(ToInternalDurationRecordWith24HourDays(d).time, TemporalUnitLength(unit)))
  IN IF IsAbrupt(total) THEN total ELSE Ok(total.s, Num(Val(total)))
\* Features the port doesn't have yet. Each throws a string that names it, which a test reports.
Unsupported(s, what) == ThrowValue(s, Str(what))
CallBuiltin(s, f, id, this, args, nt) ==
  CASE id[1] = "Function" -> FunctionBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Global" -> GlobalBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Iterator" -> IteratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "ForInIterator" -> ForInIteratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Class" -> ClassBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Number" -> NumberBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "NumberGlobal" -> NumberGlobalBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Math" -> MathBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "URI" -> URIBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "JSON" -> JSONBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "String" -> StringBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "StringIterator" -> StringIteratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Array" -> ArrayBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "ArrayIterator" -> ArrayIteratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Proxy" -> ProxyBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Reflect" -> ReflectBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Object" -> ObjectBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Map" -> MapBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "MapIterator" -> MapIteratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "SetIterator" -> SetIteratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Set" -> SetBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "WeakMap" -> WeakMapBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "WeakSet" -> WeakSetBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "WeakRef" -> WeakRefBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "FinalizationRegistry" -> FinalizationRegistryBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Disposable" -> DisposableBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "AsyncDisposable" -> AsyncDisposableBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "IteratorHelper" -> IteratorHelperBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "ShadowRealm" -> ShadowRealmBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Boolean" -> BooleanBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Symbol" -> SymbolBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Error" -> ErrorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "NativeError" -> NativeErrorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "AggregateError" -> AggregateErrorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "BigInt" -> BigIntBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Date" -> DateBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "RegExp" -> RegExpBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Atomics" -> AtomicsBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "ArrayBuffer" -> ArrayBufferBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "SharedArrayBuffer" -> SharedArrayBufferBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "DataView" -> DataViewBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "TypedArray" -> TypedArrayBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Uint8Array" -> Uint8ArrayBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Generator" -> GeneratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Await" -> AwaitBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "AsyncGenerator" -> AsyncGeneratorBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "AsyncFromSync" -> AsyncFromSyncBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Promise" -> PromiseBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Module" -> ModuleBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "PlainDate" -> PlainDateBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "PlainDateTime" -> PlainDateTimeBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "ZonedDateTime" -> ZonedDateTimeBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Instant" -> InstantBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "PlainYearMonth" -> PlainYearMonthBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "PlainMonthDay" -> PlainMonthDayBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "TemporalNow" -> TemporalNowBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "PlainTime" -> PlainTimeBuiltin(s, f, id[2], this, args, nt)
    [] id[1] = "Duration" -> DurationBuiltin(s, f, id[2], this, args, nt)
    [] OTHER -> Unsupported(s, N("Unsupported: built-in"))
ResumeFrame(frame, r) ==
  CASE frame.step = "TailCallRunThen" -> TailCallRunThen(frame.args[1], r)
    [] frame.step = "GetValueThen" -> GetValueThen(r)
    [] frame.step = "LogicalThen" -> LogicalThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "ConditionalThen" -> ConditionalThen(frame.args[1], frame.args[2], r)
    [] frame.step = "CommaThen" -> CommaThen(frame.args[1], frame.args[2], r)
    [] frame.step = "ArrayLiteralThen" -> ArrayLiteralThen(frame.args[1], r)
    [] frame.step = "ArraySpreadThen" -> ArraySpreadThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
    [] frame.step = "ArrayElementThen" -> ArrayElementThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
    [] frame.step = "ResultThen" -> ResultThen(frame.args[1], r)
    [] frame.step = "PropertyListThen" -> PropertyListThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "ToPropertyKeyThen" -> ToPropertyKeyThen(r)
    [] frame.step = "CreateDataThen" -> CreateDataThen(frame.args[1], frame.args[2], r)
    [] frame.step = "CopyDataThen" -> CopyDataThen(frame.args[1], r)
    [] frame.step = "PropertyKeyThen" -> PropertyKeyThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "ProtoSetterThen" -> ProtoSetterThen(frame.args[1], r)
    [] frame.step = "TemplateThen" -> TemplateThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
    [] frame.step = "MemberBaseThen" -> MemberBaseThen(frame.args[1], frame.args[2], r)
    [] frame.step = "MemberKeyThen" -> MemberKeyThen(frame.args[1], frame.args[2], r)
    [] frame.step = "SuperKeyThen" -> SuperKeyThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "CallCalleeThen" -> CallCalleeThen(frame.args[1], frame.args[2], r)
    [] frame.step = "DirectEvalThen" -> DirectEvalThen(frame.args[1], frame.args[2], r)
    [] frame.step = "CallArgumentsThen" -> CallArgumentsThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "ArgumentSpreadThen" -> ArgumentSpreadThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "ArgumentThen" -> ArgumentThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "TagThen" -> TagThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "NewCalleeThen" -> NewCalleeThen(frame.args[1], frame.args[2], r)
    [] frame.step = "NewArgumentsThen" -> NewArgumentsThen(frame.args[1], r)
    [] frame.step = "OptionalBaseThen" -> OptionalBaseThen(frame.args[1], frame.args[2], r)
    [] frame.step = "ChainInnerThen" -> ChainInnerThen(frame.args[1], frame.args[2], r)
    [] frame.step = "UpdateThen" -> UpdateThen(frame.args[1], r)
    [] frame.step = "UnaryThen" -> UnaryThen(frame.args[1], r)
    [] frame.step = "TypeofThen" -> TypeofThen(r)
    [] frame.step = "DeleteThen" -> DeleteThen(r)
    [] frame.step = "BinaryLeftThen" -> BinaryLeftThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "BinaryRightThen" -> BinaryRightThen(frame.args[1], frame.args[2], r)
    [] frame.step = "PrivateInThen" -> PrivateInThen(frame.args[1], frame.args[2], r)
    [] frame.step = "RelationalLeftThen" -> RelationalLeftThen(frame.args[1], frame.args[2], r)
    [] frame.step = "RelationalRightThen" -> RelationalRightThen(frame.args[1], frame.args[2], r)
    [] frame.step = "EqualityLeftThen" -> EqualityLeftThen(frame.args[1], frame.args[2], r)
    [] frame.step = "EqualityRightThen" -> EqualityRightThen(frame.args[1], frame.args[2], r)
    [] frame.step = "DestructuringValueThen" -> DestructuringValueThen(frame.args[1], frame.args[2], r)
    [] frame.step = "AssignmentTargetThen" -> AssignmentTargetThen(frame.args[1], frame.args[2], r)
    [] frame.step = "PutValueThen" -> PutValueThen(frame.args[1], r)
    [] frame.step = "CompoundThen" -> CompoundThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "StatementThen" -> StatementThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "UpdateEmptyThen" -> UpdateEmptyThen(frame.args[1], r)
    [] frame.step = "IfThen" -> IfThen(frame.args[1], frame.args[2], r)
    [] frame.step = "ReturnThen" -> ReturnThen(frame.args[1], r)
    [] frame.step = "ReturnValueThen" -> ReturnValueThen(r)
    [] frame.step = "ThrowThen" -> ThrowThen(r)
    [] frame.step = "WithThen" -> WithThen(frame.args[1], frame.args[2], r)
    [] frame.step = "VariableListThen" -> VariableListThen(frame.args[1], frame.args[2], r)
    [] frame.step = "PatternInitializerThen" -> PatternInitializerThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "BindingListThen" -> BindingListThen(frame.args[1], frame.args[2], frame.args[3], r)
    [] frame.step = "InitializeThen" -> InitializeThen(frame.args[1], frame.args[2], r)
    [] frame.step = "LabelThen" -> LabelThen(frame.args[1], r)
    [] frame.step = "BreakTargetThen" -> BreakTargetThen(r)
    [] frame.step = "LoopRunThen" -> LoopRunThen(frame.args[1], frame.args[2], r)
    [] frame.step = "LoopFromThen" -> LoopFromThen(frame.args[1], frame.args[2], r)
    [] frame.step = "DoWhileBodyThen" -> DoWhileBodyThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
    [] frame.step = "DoWhileTestThen" -> DoWhileTestThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
    [] frame.step = "WhileTestThen" -> WhileTestThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
    [] frame.step = "WhileBodyThen" -> WhileBodyThen(frame.args[1], frame.args[2], frame.args[3], frame.args[4], r)
