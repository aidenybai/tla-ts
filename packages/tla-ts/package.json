{
  "name": "tla-ts",
  "version": "0.0.3",
  "description": "A TLA+ interpreter and model checker in TypeScript, 2× faster than TLC",
  "keywords": [
    "formal verification",
    "model checker",
    "tla",
    "tla+",
    "tlaplus",
    "tlc"
  ],
  "homepage": "https://github.com/aidenybai/tla-ts#readme",
  "bugs": {
    "url": "https://github.com/aidenybai/tla-ts/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Bai",
    "email": "aiden@million.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidenybai/tla-ts.git"
  },
  "bin": {
    "tla-ts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_ENV=production vp pack",
    "dev": "NODE_ENV=development vp pack --watch",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "nr build",
    "bench": "pnpm build && bun scripts/run.ts benchmark",
    "bench:corpus": "pnpm build && bun scripts/run.ts benchmark-corpus",
    "bench:prove": "pnpm build && bun scripts/run.ts prove-benchmark",
    "conformance": "bun scripts/run.ts conformance",
    "conformance:fetch": "bun scripts/run.ts fetch-corpora",
    "conformance:fingerprint": "bun scripts/run.ts fingerprint-conformance",
    "conformance:isabelle": "bun scripts/run.ts isabelle-conformance",
    "conformance:isabelle-encode": "bun scripts/run.ts isabelle-encode-conformance",
    "conformance:sany": "bun scripts/run.ts proof-conformance",
    "conformance:ptl": "bun scripts/run.ts ptl-conformance",
    "conformance:smt": "bun scripts/run.ts smt-conformance",
    "conformance:record": "bun scripts/run.ts record-tlc",
    "conformance:record-sany": "bun scripts/run.ts record-sany",
    "conformance:record-proofs": "bun scripts/run.ts record-proofs",
    "conformance:record-tlapm": "bun scripts/run.ts record-tlapm",
    "conformance:smt-encode": "bun scripts/run.ts smt-encode-conformance",
    "conformance:prove": "pnpm build && bun scripts/run.ts prove-conformance",
    "conformance:tlapm": "bun scripts/run.ts tlapm-conformance",
    "conformance:zenon": "bun scripts/run.ts zenon-conformance",
    "publint": "publint",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22",
    "publint": "^0.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "latest"
  }
}
