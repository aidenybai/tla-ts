{
  "name": "@tla-ts/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @tla-ts/website#dev",
    "build": "vp run tla-ts#build",
    "test": "pnpm --filter tla-ts test",
    "publint": "vp run tla-ts#publint",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "pnpm run build && pnpm --filter tla-ts --filter @tla-ts/website typecheck",
    "changeset": "nr build && changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@antfu/ni": "^27.0.1",
    "@changesets/changelog-git": "^0.2.0",
    "@changesets/cli": "^2.30.0",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.12.1"
}
